-- js-phrases.rofl — the phrase of every JS-model relation that has one, and
-- the noun of every node kind that has one. Read by `rofl-render`, which
-- parses and never evaluates; loaded by nothing else. A hole is `<noun>` in
-- argument order or `<i:noun>` for argument i; `<i=0>` and `<i=_>` pick a
-- template by the shape of the call and render nothing.
edb(phrase).
edb(kind_noun).
edb(sig).

-- what the scanner seeds, in the code
phrase(ast_node, "<node> is of kind <kind> in file <file> at line <line>").
phrase(ast_node, "<0:node> is of kind <1:kind> <2=_> <3=_>").
phrase(ast_node, "<0:node> is of kind <1:kind> in file <2:file> <3=_>").
phrase(ast_child, "the <1:child> of <0:node> is <3:node> <2=0>").
phrase(ast_child, "<3:node> is among the <1:child> of <0:node> <2=_>").
phrase(ast_child, "<3:node> is the <2:index>-th of the <1:child> of <0:node>").
phrase(ast_attr, "the attribute <1:attribute> of <0:node> is <2:literal>").
phrase(ast_name, "<node> is named <name>").
phrase(ast_value, "<node> is written as <text>").
phrase(ast_within, "<node> is within <node>").
phrase(ast_in, "<node> is in file <file>").
phrase(key_name, "<node> spells <key>").


-- nouns for node kinds, and for the fact sets that name a family of kinds
kind_noun(identifier, "identifier").
kind_noun(variable_declarator, "declarator").
kind_noun(variable_declaration, "declaration").
kind_noun(template_literal, "template").
kind_noun(object_expression, "object literal").
kind_noun(array_expression, "array literal").
kind_noun(class_declaration, "class").
kind_noun(class_expression, "class").
kind_noun(function_declaration, "function").
kind_noun(function_expression, "function").
kind_noun(arrow_function_expression, "function").
kind_noun(object_method, "object method").
kind_noun(class_method, "method").
kind_noun(class_private_method, "private method").
kind_noun(class_private_property, "private field").
kind_noun(class_property, "field").
kind_noun(class_accessor_property, "field").
kind_noun(call_expression, "call").
kind_noun(optional_call_expression, "call").
kind_noun(new_expression, "new").
kind_noun(member_expression, "member access").
kind_noun(optional_member_expression, "member access").
kind_noun(assignment_expression, "assignment").
kind_noun(sequence_expression, "sequence").
kind_noun(conditional_expression, "conditional").
kind_noun(logical_expression, "logical").
kind_noun(await_expression, "await").
kind_noun(yield_expression, "yield").
kind_noun(static_block, "static block").
kind_noun(this_expression, "this").
kind_noun(super, "super").
kind_noun(try_statement, "try").
kind_noun(catch_clause, "catch").
kind_noun(for_of_statement, "for-of").
kind_noun(import_declaration, "import").
kind_noun(export_named_declaration, "named export").
kind_noun(export_all_declaration, "export-all").
kind_noun(program, "program").
kind_noun(spread_element, "spread").
kind_noun(rest_element, "rest").
kind_noun(block_statement, "block").
kind_noun(for_statement, "for").
kind_noun(return_statement, "return").
kind_noun(throw_statement, "throw").
kind_noun(parenthesized_expression, "wrapper").
kind_noun(tsas_expression, "wrapper").
kind_noun(tsnon_null_expression, "wrapper").
kind_noun(string_literal, "literal").
kind_noun(numeric_literal, "literal").
kind_noun(boolean_literal, "literal").
kind_noun(big_int_literal, "literal").
kind_noun(object_property, "property").
kind_noun(object_pattern, "object pattern").
kind_noun(array_pattern, "array pattern").
kind_noun(private_name, "private name").
kind_noun(decorator, "decorator").
kind_noun(value_transparent, "wrapper").
kind_noun(literal_kind, "literal").
kind_noun(node_value_kind, "value site").
kind_noun(member_kind_v, "member access").
kind_noun(class_field_kind, "field").
kind_noun(private_member_kind, "private member").
kind_noun(this_binds_kind, "this-binder").
kind_noun(fn_kind_v, "function").
kind_noun(block_scope_kind, "block scope").
kind_noun(call_like_v, "call").

-- signatures: the head phrase is the name, each argument is `[marker] noun Var`
-- in the relation's own order; a name that differs from the relation is a
-- proposed rename. Scanner relations keep their phrases above: their index
-- variants need the fixed holes.
sig(ident, "reads(identifier N, name Name)").
sig(ident_in, "reads(identifier E, name Name, in file File)").
sig(decl_binds, "binds(declarator D, name Name)").
sig(decl_reads, "reads(declarator D, name Name)").
sig(var_flow, "flows_to(name From, name To)").
sig(var_reaches, "reaches(name From, name To)").
sig(may_be_lit, "may_be_the_literal(node E, literal V)").
sig(may_be_node, "may_be_the_node(node E, node N)").
sig(interpolated, "is_interpolated(template T)").
sig(binder, "binds(declarator D, name Name, to node Init, in file File)").
sig(binder_at_top, "is_at_the_top(declarator D)").
sig(binder_region, "the_region(of declarator D, is node R)").
sig(binds_name, "introduces(declarator D, name Name, in file File)").
sig(scoped_binder, "is_scoped(declarator D, in file File)").
sig(lexical_binder, "is_lexical(declarator D)").
sig(lexical_decl, "is_lexical(declaration V)").
sig(scope_node, "is_a_scope(node R)").
sig(encloses_s, "encloses(scope R, declarator D)").
sig(closer_s, "is_outranked_for(scope R, declarator D)").
sig(nearest_s, "is_the_nearest_scope_of(scope R, declarator D)").
sig(shadowed_by, "is_shadowed_by(declarator Outer, declarator Inner, on name Name)").
sig(shadowed_by_param, "is_shadowed_by(declarator Outer, function F, on name Name)").
sig(hidden_at, "is_hidden_from(node E, declarator D)").
sig(tdz_cand, "is_a_dead_zone_candidate_of(node E, declarator D)").
sig(tdz_deferred, "is_deferred_for(node E, declarator D)").
sig(tdz_at, "is_in_the_dead_zone_of(node E, declarator D)").
sig(assigns, "is_assigned(name Name, node Src, in file File)").
sig(spread_arg, "has_a_spread(call C, at index I)").
sig(after_spread, "is_past_a_spread(call C, at index I)").
sig(arg_at, "passes(call C, node A:2, at index I:1)").
sig(destructures, "destructures(declarator D, name Local, from key Key, in file File)").
sig(destructures_at, "destructures(declarator D, name Local, at index Index, in file File)").
sig(pattern_takes, "takes_the_key(object pattern P, key Key)").
sig(rest_in_pattern, "holds_a_rest(declarator D, node R, in file File)").
sig(rest_binds, "binds(declarator D, name Local:2, through the rest node R:1, in file File:3)").
sig(param_of, "takes(function F, name Name:2, at index I:1)").
sig(param_default, "defaults(function F, name Name, to node Init)").
sig(param_hidden, "hides(function F, name Name, at node U)").
sig(param_use, "uses(function F, name Name, at node U)").
sig(elem_at, "the_element(of node X, index I, is node E)").
sig(iter_elem, "has_an_element(node X, node E)").
sig(valued, "is_valued(node E)").
sig(prototype_of, "the_prototype(of node E, is name P)").
sig(kind_prototype, "has_prototype(kind K, name P)").
sig(builtin_prototype, "is_a_builtin_prototype(name P)").
sig(plain_assign, "is_plain(assignment E)").
sig(obj_like, "is_object_like(node O)").
sig(member_value, "the_member(of node O, key Key, holds node V)").
sig(own_key, "owns_the_key(class CD, key Key)").
sig(member_node_v, "is_a_member_access(node N)").
sig(selects, "selects(member access N, key Key)").
sig(class_member_static, "the_static_member(of class CD, key Key, is node V)").
sig(class_member_proto, "the_instance_member(of class CD, key Key, is node V)").
sig(member_plain, "the_plain_member(of node O, key Key, is node V)").
sig(class_receiver, "denotes_a_class(node E)").
sig(class_named, "is_named(class CD, name Name, in file File)").
sig(class_method_of, "has_the_method(class CD, method M)").
sig(this_over, "is_over(this-binder F, this T)").
sig(this_nearer, "is_outdone_for(this-binder F, this T)").
sig(this_host, "hosts(node H, this T)").

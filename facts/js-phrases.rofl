sig(unknown_because, "is_unknown(kind K:1, in layer L:2, of language Lang:0, because reason R:3)").
sig(irreducible_unknown, "is_irreducibly_unknown(kind K:1, in layer L:2, of language Lang:0)").
sig(our_unknown, "is_our_unknown(kind K:1, in layer L:2, of language Lang:0)").
sig(shape_kind, "has_a_shape_axis(kind K:1, in layer Lay:2, of language Lang:0)").
sig(converges, "has_two_verifiers(rule Rule:1, language A:2, language B:3, in layer L:0)").

-- effects: the lattice, then what runs where

sig(rules_answer, "the_rules_answer(of site S, is path T)").
sig(rules_has_answer, "has_a_rules_answer(site S)").
sig(rules_verdict, "the_rules_verdict(of site S, is path T)").
sig(resolve_divergence, "is_resolved_differently(site S, by rules to path ByRules, by host to path ByHost, in environment Env)").
sig(resolve_agreement, "is_resolved_alike(site S, to path V, in environment Env)").
sig(compared, "is_compared(site S, in environment Env)").
sig(uncompared, "is_uncompared(site S, in environment Env)").
sig(env_divergent_site, "diverges_between_environments(site S)").
sig(answer_without_mechanism, "is_answered_without_a_mechanism(site S, in environment Env)").
sig(resolve_silent, "is_unreported(site S, in environment Env)").
sig(env_unobserved, "is_unobserved(environment Env)").
sig(env_undeclared, "is_an_undeclared_environment(environment Env)").
sig(model_site_known, "is_known_to_the_model(site S)").
sig(site_unseen_by_model, "is_unseen_by_the_model(site S)").
sig(host_saw, "is_seen_by_the_host(site I)").
sig(site_unseen_by_host, "is_unseen_by_the_host(site I)").
sig(checked_site_kind, "is_checked_at(kind K, site S)").
sig(mechanism_seen, "is_a_seen_mechanism(mechanism M)").
sig(mechanism_undeclared, "is_an_undeclared_mechanism(mechanism M)").
sig(mechanism_unexercised, "is_an_unexercised_mechanism(mechanism M)").

-- vocabulary: what the rules themselves name
sig(body_lit, "is_a_body_literal(term L)").
sig(lit_rel, "the_relation(of term L, is relation Rel)").
sig(kind_slot, "has_a_kind_slot_in_rules(relation Rel, at index I)").
sig(kind_named_by_rule, "is_named_by_a_rule(kind K)").
sig(rule_opinion_unlisted, "is_named_by_a_rule_yet_unlisted(kind K:1, in language Lang:0)").

-- model, the shaped arity: a name used with two arities carries one signature per arity,
-- and the signature with the shape column reads the same words with `with shape S`
sig(claim, "is_claimed(kind K:2, with shape S:3, in layer Lay:4, of language Lang:1, under ledger What:0, with reason R:5)").
sig(handled, "is_handled(kind K:1, with shape S:2, in layer Lay:3, of language Lang:0, with reason R:4)").
sig(ignored, "is_ignored(kind K:1, with shape S:2, in layer Lay:3, of language Lang:0, with reason R:4)").
sig(unknown_because, "is_unknown(kind K:1, with shape S:2, in layer Lay:3, of language Lang:0, because reason R:4)").
sig(verdict, "the_verdict(of kind K:1, with shape S:2, in layer Lay:3, for language Lang:0, is verdict V:4)").
sig(reason, "the_reason(of kind K:1, with shape S:2, in layer Lay:3, for language Lang:0, is reason R:4)").
sig(bad_reason, "the_bad_reason(of kind K:1, with shape S:2, in layer Lay:3, for language Lang:0, is reason R:4)").
sig(double_claimed, "is_double_claimed(kind K:1, with shape S:2, in layer Lay:3, of language Lang:0)").
sig(orphan, "is_orphaned(kind K:2, with shape S:3, in layer Lay:4, of language Lang:1, under ledger What:0)").
sig(cell, "is_a_cell(kind K:1, with shape S:2, in layer Lay:3, of language Lang:0)").
sig(orphan_claim, "is_an_orphan_claim(kind K:1, with shape S:2, in layer Lay:3, of language Lang:0)").
sig(orphan_reason, "is_an_orphan_reason(kind K:1, with shape S:2, in layer Lay:3, of language Lang:0)").
sig(irreducible_unknown, "is_irreducibly_unknown(kind K:1, with shape S:2, in layer Lay:3, of language Lang:0)").
sig(our_unknown, "is_our_unknown(kind K:1, with shape S:2, in layer Lay:3, of language Lang:0)").
sig(shape_of, "has_the_shape(kind K:1, shape S:2, in language Lang:0)").
sig(shape_in, "is_a_shape_in(shape S, layer Lay)").

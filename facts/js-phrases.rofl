kind_noun(class_property, "class property").
kind_noun(class_accessor_property, "accessor property").
kind_noun(call_expression, "call expression").
kind_noun(optional_call_expression, "optional call expression").
kind_noun(new_expression, "new").
kind_noun(member_expression, "member expression").
kind_noun(optional_member_expression, "optional member expression").
kind_noun(assignment_expression, "assignment").
kind_noun(sequence_expression, "sequence").

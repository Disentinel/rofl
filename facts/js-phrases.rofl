-- The 93 relations the nine structures could not place, written by hand.
-- What they needed was nouns the propagation cannot reach (kind, layer,
-- language, effect, runtime, shape, verdict, reason), two arguments under
-- one marker (`the join of A and B`, `lost between From and To`), and one
-- structure the name never says: a pair, `S has two Xs A and B`, which the
-- body says instead (the same relation twice, and A != B).

-- controlflow
sig(abrupt_at, "is_abrupt(node B, at field F, from index I)").
sig(suspend_at, "suspends(node B, at field F, from index I)").

-- ambient
sig(amb_short_at, "falls_short(effect N:2, of effect label L:0, at host H:1)").
sig(amb_covers_at, "is_covered(effect label L, at host H, by effect N)").
sig(amb_covers_at_low, "has_a_lower_cover(effect label L, at host H, than effect N)").
sig(ambient_effect, "has_the_ambient_effect(spec Spec, effect E:2, at key Key:1)").
sig(eff_of_label, "the_effect(of effect label L, at host H, is effect N)").
sig(eff_here, "has_the_effect(node E, effect label L, at host H)").
sig(host_atom_two_names, "has_two_host_effects(host A, effect X, effect Y)").
sig(surface_two_origins, "has_two_origins(surface S, origin A, origin B)").

-- resolve
sig(arrival, "arrives(site S, at step K, in path P)").
sig(answer_ambiguous, "has_two_answers(site S, in environment Env, node A, node B)").
sig(answer_without_trace, "resolves_without_a_trace(site S, in environment Env, to node P)").
sig(env_divergence, "diverges(site S, in environment A, with verdict VA, from environment B, with verdict VB)").
sig(site_key_ambiguous, "has_two_model_keys(site S, key I, key J)").

-- attrs
sig(attr_blind_guard, "is_a_blind_guard(attribute K, at field F, of kind Kind)").
sig(attr_guard_kind, "guards_the_attribute(rule R, attribute K, on term S, as kind Kind)").
sig(attr_guard_slot, "tests_the_attribute(rule R, attribute K, on term S, under field F)").
sig(attr_guard_slot_pos, "tests_the_attribute_positively(rule R, attribute K, on term S, under field F)").
sig(attr_pos_slot_gap, "is_a_positive_slot_gap(attribute K, at field F, of kind Kind)").
sig(attr_slot_gap, "is_a_slot_gap(attribute K, at field F, of kind Kind)").
sig(attr_slot_gap_ok_unseen, "is_excused_unseen(attribute K, at field F, of kind Kind)").

-- model: the cell (kind, layer, language) and what is claimed of it
sig(cell, "is_a_cell(kind K:1, in layer L:2, of language Lang:0)").
sig(double_cell, "is_a_double_cell(kind K:1, in layer Lay:2, of language Lang:0)").
sig(lost_cell, "is_a_lost_cell(kind K:1, in layer Lay:2, of language Lang:0)").

sig(shape_kind, "has_a_shape_axis(kind K:1, in layer Lay:2, of language Lang:0)").
sig(converges, "has_two_verifiers(rule Rule:1, language A:2, language B:3, in layer L:0)").

-- effects: the lattice, then what runs where
sig(eff_row, "covers(effect A, effect label L, at host H)").

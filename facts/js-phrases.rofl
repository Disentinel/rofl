sig(coarser_claim, "has_a_coarser_claim(kind K:1, reason R:3, in layer Lay:2, of language Lang:0)").
sig(orphan, "is_orphaned(kind K:2, in layer L:3, of language Lang:1, under ledger What:0)").
sig(orphan_claim, "is_an_orphan_claim(kind K:1, in layer L:2, of language Lang:0)").
sig(orphan_reason, "is_an_orphan_reason(kind K:1, in layer L:2, of language Lang:0)").
sig(orphan_shape, "is_an_orphan_shape(shape S:2, of kind K:1, in language Lang:0)").
sig(verdict, "the_verdict(of kind K:1, in layer L:2, for language Lang:0, is verdict V:3)").

kind_noun(export_specifier, "export specifier").
kind_noun(if_statement, "if").
kind_noun(import_attribute, "import attribute").
kind_noun(import_default_specifier, "default import").
kind_noun(import_expression, "dynamic import").
kind_noun(import_namespace_specifier, "namespace import").
kind_noun(import_specifier, "import specifier").
kind_noun(labeled_statement, "label").
kind_noun(meta_property, "meta property").
kind_noun(unary_expression, "unary expression").
kind_noun(update_expression, "update expression").
kind_noun(reg_exp_literal, "regex literal").
kind_noun(tagged_template_expression, "tagged template").
kind_noun(value_transparent, "wrapper").

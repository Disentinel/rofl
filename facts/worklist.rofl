-- facts/worklist.rofl — THE PLAN. Order, state, and which cells each item owns.
--
-- Everything else about the queue is derived (rules/worklist.rofl). This file
-- carries only what no model can compute: what we intend to do next, and in
-- which order. Seeded 2026-09-04 from a measurement rather than from memory —
-- 108 open cells across three layers, dumped by loading every fact pack into
-- one world, which is a world no test had built before.
--
-- READ THE QUEUE, DO NOT READ THIS FILE:
--     ? next_work[audit](W)          what to take
--     ? unqueued[audit](K, S, L)     work the plan is silent about
--     ? queue_stale[audit](W, K, L)  an item pointing at a shut cell
--     ? false_done[audit](W, K, L)   a claim of completion the model denies

claim_kind(queued).

-- ===========================================================================
-- 1 — THE MATRIX ITSELF IS WRONG ABOUT A PARTIAL CELL. Before more cells are
-- filled, because it decides at what granularity they are filled at all.
work(w_mod_partial_cell,
     "DONE 2026-09-04: the modules layer gained a specifier refinement, the three false stale_reason rows are gone").
work_order(w_mod_partial_cell, 1).
work_state(w_mod_partial_cell, done).
work_spawned(w_mod_partial_cell, f_a_cell_can_be_ticked_and_partial_and_the_matrix_calls_that_a_stale_excuse).
work_spawned(w_cg_member_family, f_runtime_dependent_is_a_verdict_about_a_shape_and_both_its_sites_are_decidable).
-- ...and three more the catch-all split found, none of them foreseen.
work_spawned(w_cg_member_family, f_a_catch_all_shape_is_a_bucket_of_verdicts).
work_spawned(w_cg_member_family, f_a_may_set_over_branches_is_an_over_approximation_the_oracle_cannot_see).
work_spawned(w_cg_member_family, f_two_reason_relations_over_one_fact_have_now_bitten_twice).

-- ===========================================================================
-- 2 — THE CALL GRAPH'S BIGGEST RESIDUE. Six of the nine edges the execution
-- oracle still catches us missing live in these eleven shapes of ONE kind.
-- BLOCKED, and the blocker was found by a question rather than by the plan:
-- `o[k]()` refuses even when k is a const in the same file or a literal passed
-- at the only call site, and the shape carries `runtime_dependent` — the one
-- reason nobody is ever expected to work on. Both are constant propagation,
-- which is dataflow. See
-- f_runtime_dependent_is_a_verdict_about_a_shape_and_both_its_sites_are_decidable.
-- NOTHING WORKABLE LEFT, and NOT `done` — the queue refused that. Marking it
-- done while it still claimed the blocked template-key cell raised
-- `false_done[audit]` immediately, and the audit is right: an item that owns an
-- open cell has not finished, whatever was accomplished around it. The correct
-- state is the same one `w_cg_optional_member` is already in — open, with
-- `nothing_workable[audit]` naming it — because the two template-key cells are
-- siblings blocked on the same scanner contract. That distinction is the whole
-- reason `nothing_workable` has two causes wanting opposite responses.
work(w_cg_member_family,
     "the catch-all split into eight named object positions, six modelled; only the blocked template key is left").
work_order(w_cg_member_family, 4).
-- DONE 2026-09-08. The last cell this item owned was the TEMPLATE KEY, blocked
-- on the scanner's contract; the contract moved, the cell closed, and an item
-- with no claims left is finished rather than offerable. The queue said so
-- itself within one run: with the claim retired and the state still `open`,
-- `next_work[audit]` handed this item out as the head of the queue with
-- nothing in it — which is the second of the two causes `nothing_workable`
-- was written to tell apart, arriving as a live row instead of a comment.
work_state(w_cg_member_family, done).
work_needs(w_cg_member_family, w_df_value_core).

-- WHAT THE SPLIT HANDED ON. `s_member_on_other` was one cell reading `not_yet`
-- and it held four different answers; naming them turned two of the four into
-- claims on OTHER items, which is the queue doing what it is for. Neither is
-- member-expression work and neither would ever have surfaced as its own row
-- while the bucket existed.
claim(queued, js, member_expression, s_member_on_await,    callgraph, w_df_control_forms).
-- retired 2026-09-08: the cell is now irreducible, not queued.
-- retired 2026-09-08: the cell is now irreducible, not queued.

-- 3 — the same family through the optional-chaining kind. Held apart because
-- `a?.b()` has a SHORT-CIRCUIT the plain form does not, which is a control-flow
-- fact wearing a call-graph shape.
-- NOTHING WORKABLE LEFT, and the queue says so rather than offering it: the
-- literal-key cell is ticked and the template-key one is blocked on the
-- scanner's contract. The item stays open because the cell is open; it is not
-- done and it is not offerable, and those are different states.
work(w_cg_optional_member, "optional_member_expression: only the template key is left, and it waits on the scanner").
work_order(w_cg_optional_member, 5).
-- DONE 2026-09-08, with its sibling and for the same reason: its note said
-- `only the template key is left, and it waits on the scanner`, and the
-- scanner stopped making it wait.
work_state(w_cg_optional_member, done).
work_needs(w_cg_optional_member, w_df_value_core).

-- 4 — the one miss that is not a callee shape at all: `new Box(1)` is a
-- transfer site of a different node kind, which the callee-shape axis cannot
-- see by construction.
work(w_cg_new_expression, "DONE 2026-09-04: the constructor edge, through a second role of the kind on the refinement column").
work_order(w_cg_new_expression, 6).
work_state(w_cg_new_expression, done).

-- 5 — syntactic wrappers around a callee. Mechanical: unwrap and ask again.
-- Grouped because one rule shape closes all five, which is the test of whether
-- they really are one thing.
work(w_cg_syntactic_wrappers, "(f)(), f as T (), f!(), (a, f)(), c ? f : g () — unwrap the callee and recurse").
work_order(w_cg_syntactic_wrappers, 7).
work_state(w_cg_syntactic_wrappers, done).
claim(queued, js, tsas_expression,          s_ts_as,         callgraph, w_cg_syntactic_wrappers).
claim(queued, js, tsnon_null_expression,    s_non_null,      callgraph, w_cg_syntactic_wrappers).
claim(queued, js, sequence_expression,      s_sequence,      callgraph, w_cg_syntactic_wrappers).
claim(queued, js, conditional_expression,   s_conditional,   callgraph, w_cg_syntactic_wrappers).

-- 6 — `f()()` needs to know what f RETURNS, so it is blocked on the dataflow
-- layer having return values at all. Ordered after the call graph's own work
-- and before dataflow only to say that the dependency runs the other way.
-- DONE 2026-09-04, and neither cell went the way the note predicted. `s_super`
-- is the CALL `super()`, not a return value: it reaches the nearest ancestor's
-- explicit constructor, and V8 was measured first because `super()` SKIPS a
-- synthesised frame while `new C()` CREATES one — two constructions that reach
-- a constructor and disagree about the caller. `s_dynamic_import` turned out to
-- be unreachable rather than unmodelled: this parser emits `import_expression`
-- and never a callee of kind `import`, so it is waived like
-- `s_parenthesized`. The residue that remains is `no_source_target` — a
-- `super()` whose whole chain declares no constructor — and it is theirs, not
-- ours.
work(w_cg_call_result, "DONE 2026-09-04: super() reaches the nearest ancestor's constructor; the dynamic-import shape is unreachable and waived").
work_order(w_cg_call_result, 8).
work_state(w_cg_call_result, done).
work_needs(w_cg_call_result, w_df_function_forms).
claim(queued, js, super,                    s_super,       callgraph, w_cg_call_result).
claim(queued, js, import,                   s_dynamic_import, callgraph, w_cg_call_result).
work_spawned(w_cg_call_result, f_body_order_changes_the_answer_and_whynot_cannot_see_it).
work_spawned(w_cg_call_result, f_a_synthesised_constructor_has_a_frame_and_no_node).
work_spawned(w_cg_call_result, f_the_corpus_had_no_class_that_inherited_anything).

-- 20 — THE KERNEL DEFECT THE ABOVE FOUND, entered so the dependency is a row.
-- Ordered last for the same reason as the leak item: it is a language question
-- and the owner schedules it.
work(w_body_order_is_load_bearing, "DONE 2026-09-05: evalOrder defers a negated literal until its variables are bound; the two spellings are one program again").
work_order(w_body_order_is_load_bearing, 20).
work_state(w_body_order_is_load_bearing, done).
work_spawned(w_body_order_is_load_bearing, f_a_static_call_through_the_class_name_is_invisible_to_the_census).
work_spawned(w_body_order_is_load_bearing, f_the_safe_flag_is_a_strategy_not_a_verdict).
work_spawned(w_body_order_is_load_bearing, f_body_order_changes_the_answer_and_whynot_cannot_see_it).

-- ===========================================================================
-- REORDERED 2026-09-04. The dataflow items moved AHEAD of the call-graph
-- residue, and not out of preference: `work_needs` now records that three
-- call-graph items cannot start without them, so leaving dataflow at the back
-- meant the queue would hand out an item and then refuse it. The order follows
-- the dependency the model already carries.
--
-- THE DATAFLOW LAYER IS A STUB and it is the layer with the cheapest oracle —
-- run the program. Four cells are ticked: call arguments, assignment, the
-- declarator initialiser. Everything a value can actually BE is open.
work(w_df_value_core, "DONE 2026-09-04: literals, identifiers, objects, arrays, member lookup, object properties and `this`").
work_order(w_df_value_core, 2).
work_state(w_df_value_core, done).

-- 8 — parameters and returns. NOTE, because it is the argument for doing this
-- next: `param_bind` already exists in rules/js-callgraph.rofl, where tier 3
-- built argument-to-parameter flow to resolve a callback. That is a DATAFLOW
-- fact living in the call-graph pack, and this item is where it belongs.
work(w_df_function_forms, "DONE 2026-09-04: arguments into parameters, return values, construction. param_bind still duplicates half of this in the callgraph pack").
work_order(w_df_function_forms, 3).
work_state(w_df_function_forms, done).

-- 9 — value movement through control constructs. This is the item that will
-- ask for the control-flow layer, which is why that one sits right after it.
-- DONE 2026-09-04, four cells of five. Two of them - `conditional_expression`
-- and `sequence_expression` - needed NO RULE: they were modelled when the value
-- core landed and nobody ticked them, so the matrix under-reported its own
-- coverage for a day with every gate green. `await` is transparent, `for-of`
-- binds its variable to what the source hands out, and the fifth cell went to
-- an item of its own rather than being ticked half-true.
work(w_df_control_forms, "DONE 2026-09-04: await transparent, for-of over an array and over a generator; conditional and sequence were already modelled and unticked").
work_order(w_df_control_forms, 9).
work_state(w_df_control_forms, done).
claim(queued, js, await_expression,          none, dataflow, w_df_control_forms).
claim(queued, js, conditional_expression,    none, dataflow, w_df_control_forms).
claim(queued, js, for_of_statement,          none, dataflow, w_df_control_forms).
claim(queued, js, sequence_expression,       none, dataflow, w_df_control_forms).
claim(queued, js, member_expression, s_member_on_await, callgraph, w_df_control_forms).
work_spawned(w_df_control_forms, f_a_value_can_travel_back_up_a_generator_and_nothing_here_says_so).
work_spawned(w_df_control_forms, f_a_fixture_name_collision_is_not_a_measurement).
work_spawned(w_df_control_forms, f_nothing_watches_unrecorded_coverage_below_the_call_graph).
work_spawned(w_df_control_forms, f_a_generators_first_resume_is_attributed_to_a_builtin_frame).
work_spawned(w_df_control_forms, f_an_unawaited_async_entry_point_looked_like_over_approximation).

-- 21 - THE FIFTH CELL, handed on rather than ticked half-true. The value of a
-- `yield` EXPRESSION is whatever the consumer passes to `.next(v)`: a value
-- travelling in the opposite direction from every other edge in the dataflow
-- layer. It needs a term for the generator protocol, and that term also covers
-- `gen.next(v)` as a call site, `yield*` delegation and a generator's own
-- return value - which is why it is an item and not a rule.
-- DONE 2026-09-05. Measured against V8 before a rule existed, and the fixture
-- came first because the corpus had no `.next(v)` at all: UNSOUND went 0 -> 2
-- with the two sites added, and back to 0 with the rules. THE FILE-SCOPED
-- BINDER BIT AGAIN, twice in one iteration - `const g` in two consumers, and a
-- `const f` inside a generator colliding with three parameters named `f`. The
-- new rule did not create that defect; it gave an old blindness something to
-- carry, which is how a yield expression having a value at all made three
-- false edges appear.
-- BOTH CLAIMS ARE GONE rather than kept: the dataflow cell is `handled`, and
-- the call-graph one was SPLIT — `(yield 'go')(3)` is `s_yield_result` now, so
-- the unrefined cell the claim named no longer exists and `orphan[audit]` said
-- so in one run.
work(w_df_generator_protocol, "DONE 2026-09-05: what a generator RECEIVES - next(v) into the yield, through a delegation, and inner's return").
work_order(w_df_generator_protocol, 21).
work_state(w_df_generator_protocol, done).

-- ===========================================================================
-- 10 — THE THIRD LAYER, WHICH DOES NOT EXIST YET. `layer(controlflow).` is one
-- fact and the programme's central claim is that it lights up every place the
-- model then needs describing. It claims no cell BECAUSE THERE ARE NONE UNTIL
-- IT RUNS, which is the honest shape of this item and the reason it is ordered
-- after the layer that will demand it.
-- DONE 2026-09-04, and the claim held literally. `layer(controlflow).` opened
-- FIFTY cells and put FORTY-FIVE of them on `unqueued[audit]` before the facts
-- file had a second line — measured, not argued, and recorded at the top of
-- facts/js-controlflow.rofl. What the layer answers is six kinds by two
-- mechanisms; what it waives is `await` and `yield`, which transfer control and
-- come BACK; what it leaves open is `return`, which needs statement order.
work(w_controlflow_layer, "DONE 2026-09-04: layer(controlflow) is one fact, it opened 50 cells, and six kinds are answered by two mechanisms").
work_order(w_controlflow_layer, 10).
work_state(w_controlflow_layer, done).
work_spawned(w_controlflow_layer, f_one_fact_opened_fifty_cells_and_the_claim_was_never_run).
work_spawned(w_controlflow_layer, f_over_approximation_had_two_causes_wearing_one_label).
work_spawned(w_controlflow_layer, f_no_world_that_could_fail_the_leak_audit_had_ever_been_asked).
work_spawned(w_controlflow_layer, f_the_plan_had_no_check_that_its_order_is_an_order).

-- 22 — WHAT THE THIRD LAYER LEFT OPEN, and closed on 2026-09-06. Everything
-- after a `return` in the same statement list is unreachable; this layer had no
-- term for ORDER, though `ast_child(B, F, I, S)` had carried the index since the
-- scanner was written and nothing had ever read it.
--
-- THE ITEM'S OWN WITNESS WAS WRONG, and finding that out was most of the work.
-- The note here used to name `after` in test/fixtures/js-call/alpha.mjs. The
-- first measurement of the closing work counted statements sitting after an
-- abrupt transfer in the same list across the whole corpus and got ZERO — so
-- the item had nothing to be tested against, and `after` is silent for a
-- DIFFERENT reason: it follows a call to `thrower`, which always throws. That
-- is propagation across a call edge, and w_exn_propagation owns it. Confirmed
-- afterwards by construction: a synthetic `usePast` calling a never-returning
-- function leaves the callee uncovered by every rule of this layer.
-- A gap attributed to whichever item happened to be open is a guess, and it
-- survives until closing the item forces it to be measured.
work(w_cf_abrupt_transfer, "DONE 2026-09-06: r_abrupt reads the sibling index; 4 kinds modelled, witness re-attributed to w_exn_propagation").
work_order(w_cf_abrupt_transfer, 22).
work_state(w_cf_abrupt_transfer, done).
work_spawned(w_cf_abrupt_transfer, f_a_gap_is_attributed_to_whichever_item_is_open).
work_spawned(w_cf_abrupt_transfer, f_the_weaker_consumer_cannot_check_the_stronger_relation).
-- THE CLAIMS STAY ON A DONE ITEM ON PURPOSE. They record which cells this item
-- closed, and `false_done[audit]` then guards that every one of them really IS
-- closed — deleting them would remove a live gate to tidy up a finished row.
claim(queued, js, return_statement,   none, controlflow, w_cf_abrupt_transfer).
claim(queued, js, throw_statement,    none, controlflow, w_cf_abrupt_transfer).
claim(queued, js, break_statement,    none, controlflow, w_cf_abrupt_transfer).
claim(queued, js, continue_statement, none, controlflow, w_cf_abrupt_transfer).

-- 40 — WHAT ITEM 22 COULD NOT LOOK AT, and the four shapes are its own mutant
-- set rather than an argument. `r_abrupt` reads SIBLINGS, so an abrupt transfer
-- that completes an enclosing region is invisible to it: a `return` inside a
-- nested block, a `return` in BOTH arms of an `if`, a `return` under a label.
-- All three were built and all three came back BLIND — the callee after them
-- stayed out of `may_not_run` while `after_abrupt` stood still at 2.
-- This is completion analysis (does this statement complete normally?), which
-- is one recursive relation over statement kinds and NOT a fifth mechanism: the
-- mechanism table already says `abrupt`, and the missing part is the closure.
work(w_cf_completion, "abrupt transfer only reaches siblings: a return in a nested block, in both if arms, or under a label completes the enclosing region and no rule sees it").
work_order(w_cf_completion, 40).
work_state(w_cf_completion, open).
work_needs(w_cf_completion, w_cf_abrupt_transfer).

-- 41 — NO COST GATE OUTSIDE THE CALL GRAPH. test/js-fixpoint-cost.test.ts loads
-- four rule packs and NOT rules/js-controlflow.rofl, so two iterations of rules
-- — `abrupt_at`, `after_abrupt`, a transitive closure and an entry surface —
-- have been added to a layer no cost number watches. Every figure reported for
-- those two iterations was about the shared CORPUS. Widening that test is the
-- wrong fix: the call-graph fixpoint is what it was built to watch and mixing
-- layers in would blur the signal it has. A SECOND number is what is missing.
work(w_cost_gate_per_layer, "the fixpoint cost gate watches the call graph only; the control-flow and era layers have no cost number at all").
work_order(w_cost_gate_per_layer, 41).
work_state(w_cost_gate_per_layer, open).
work_spawned(w_cost_gate_per_layer, f_the_cost_gate_cannot_see_the_layer_i_kept_attributing_to_it).
work_spawned(w_cost_gate_per_layer, f_an_instruments_world_is_part_of_its_claim).

-- 42 — AN ATTRIBUTE THE SCANNER EMITS AND NO RULE READS. Four design notes in
-- four items said a fact was missing that was already on the store, and the
-- shape is always the same: the note was written while looking at the RULES,
-- and the store is a different artifact produced by a scanner nobody is reading
-- at that moment. `ast_attr(M, kind, "get")` was the fourth — the same key was
-- consumed for `"constructor"` and for nothing else.
--
-- The census already knows which relations the rules read. An audit over
-- ATTRIBUTE KEYS AND VALUES the scanner emits that no rule consumes would have
-- named `kind` (three of four values), `static` before 2026-09-05, and the
-- sibling index. Same schema move CLAUDE.md names — derive the check once from
-- the rules rather than noticing it per case — and the third instance of that
-- schema this session.
work(w_unconsumed_attribute, "an attribute key the scanner emits that no rule reads: four design notes lost to facts already on the store").
work_order(w_unconsumed_attribute, 42).
work_state(w_unconsumed_attribute, open).
work_spawned(w_unconsumed_attribute, f_the_accessor_attribute_was_read_for_constructor_and_never_for_get).

-- 43 — A MUTANT COSTS A WHOLE WORLD, and test/js-controlflow.test.ts now holds
-- TWENTY-THREE of them. Each one rebuilds the corpus fixpoint from scratch
-- (~16 s at the corpus's current size), so that one file takes about nine
-- minutes and grows linearly with every item this loop closes. The owner's
-- standing instruction is that iteration speed must RISE; this is the one
-- number in the loop that is falling, and it is falling for a good reason —
-- the mutant sets are what makes the gates measurable — which is exactly why
-- it needs an answer other than writing fewer mutants.
--
-- The construction cannot be shared BETWEEN mutants, because the mutation is
-- the point. What can be shared is everything a mutant does not touch: a
-- mutation of `facts/js-kinds.rofl` cannot change the AST facts, and those are
-- most of the fixpoint. Whether the kernel can accept a store and re-evaluate
-- only what a changed rule reaches is a KERNEL question, not a test one.
-- MEASURED AND MOSTLY CLOSED 2026-09-07, and the cause was not the mutants.
-- `r.load()` re-evaluates, so a world built from nine loads ran the fixpoint
-- NINE TIMES: scan 69 ms, assert 150 ms, seven fact loads 4.9 s, one rules load
-- 11.5 s, and `evaluate()` 0 ms — the zero being the tell. One load of
-- everything, with the AST facts asserted AFTER the rules, is 41% cheaper with
-- byte-identical answers over fifteen relations. Two files, 9 min -> 6m55s and
-- ~9 min -> 4m44s.
--
-- AND THE KERNEL QUESTION IS ANSWERED, 2026-09-07, with a NO that is worth
-- more than the capability would have been. The kernel is ALREADY incremental:
-- `planReuse` fingerprints every derived relation's dependency cone, and
-- re-evaluating an unchanged store costs 203 ms against a 15 900 ms scratch
-- fixpoint. What it costs when a RULE changes is the canonical witness.
-- Deleting one rule of `may_be_node` holds the schedule and leaves 176 of 245
-- fingerprints unchanged; step (4) then cuts 176 to 74, because nothing
-- re-derived may read anything reused — a reused premise is complete from the
-- first firing and the canonical witness is the first firing in canonical
-- order. With that closure the in-place path is 21.4 s against a 15.6 s scratch
-- build, a LOSS. Without it, 5.2 s to apply and 4.7 s to restore — 9.9 s
-- against 15.6, so 1.6x and not 3x — with facts and support byte-identical, 52
-- of 65 141 witnesses naming a different equally-true derivation, and THE BASE
-- NOT RETURNING TO ITSELF after the restore. That last part disqualifies it: a
-- harness whose base drifts measures every later mutant against a different
-- world. A strata-aware closure recovers nothing (74 either way — this model is
-- essentially one stratum), and a rule that is the ONLY one of its relation is
-- worse still: the relation leaves the stratum table, the schedule token moves,
-- and reuse is globally off, 0 of 244.
--
-- WHAT DID PAY WAS THE LANE NOBODY TRIED. `node --test` defaults to
-- `availableParallelism() - 1`, which is 3 of 4 cores here, and the suite burns
-- 43 minutes of CPU: 862 s at three lanes, 707 s at four, same 1109/1101/8.
-- One line, no semantics touched, -18%.
work(w_mutant_costs_a_world, "DONE 2026-09-07: the nine-load waste is fixed, the kernel's incrementality EXISTS and is not worth its price - 1.6x on a base that no longer restores to itself; the suite took the fourth core instead").
work_order(w_mutant_costs_a_world, 43).
work_state(w_mutant_costs_a_world, done).
work_spawned(w_mutant_costs_a_world, f_a_worlds_cost_is_the_fixpoint_and_a_file_is_a_core).
work_spawned(w_mutant_costs_a_world, f_nine_loads_ran_the_fixpoint_nine_times).
work_spawned(w_mutant_costs_a_world, f_the_kernel_was_already_incremental_and_the_witness_is_what_it_costs).
work_spawned(w_mutant_costs_a_world, f_a_reflection_list_written_by_hand_missed_the_relation_the_kernel_grew).
work_spawned(w_mutant_costs_a_world, f_the_default_was_one_core_short_and_nobody_had_tried_the_flag).

-- ===========================================================================
-- THE SWEEPS. Everything above is judgement; the residue is arithmetic — kinds
-- that cannot participate in a layer at all and close as waivers with a reason.
-- Each is a BUCKET WITH AN OWNER, which is what stops `unqueued` from being
-- both empty and a lie. A sweep marked done while its layer still has open
-- cells puts them straight back on the unqueued list.
-- DONE 2026-09-05, and the ratio is worse for the word `residue` than the
-- control-flow sweep's was: EIGHTEEN cells, and only FOUR were residue.
-- Measured, not classified by shape — the boundary was swept by putting every
-- declared expression kind in callee position one at a time.
--   3 were ALREADY MODELLED and the matrix under-reported them: logical
--     (2 edges, a correct may-set), assignment (1) and `(new C())()` (1).
--   2 close by the LANGUAGE rather than by work: `(true)()` is never callable.
--   2 are not call sites at all: a return, a class declaration.
--  11 were not residue and went to items — six to the module boundary the call
--     graph does not cross, three to the calls that have no call site, one to
--     scope and one to the generator protocol.
work(w_cg_sweep,  "DONE 2026-09-05: 18 cells, 4 residue, 3 already modelled, 11 handed to items").
work_order(w_cg_sweep, 11).
work_state(w_cg_sweep, done).
work_sweeps(w_cg_sweep, callgraph).
work_spawned(w_cg_sweep, f_the_callee_catch_all_had_no_audit_for_three_days).
work_spawned(w_cg_sweep, f_the_call_graph_stops_at_the_module_boundary).

-- DONE 2026-09-05, and the interesting number is ZERO NEW ITEMS. Twelve cells:
-- one already modelled and never recorded (a boolean IS a value and always
-- was), one unreachable under this parser, one blocked on the scanner contract,
-- and NINE that went to items the two earlier sweeps had already created. The
-- control-flow sweep spawned four items, the call-graph sweep two, this one
-- none - the first measured deceleration in this queue.
work(w_df_sweep,  "DONE 2026-09-05: 12 cells, 1 already modelled, 2 closed with a reason, 9 to items that existed").
work_order(w_df_sweep, 12).
work_state(w_df_sweep, done).
work_sweeps(w_df_sweep, dataflow).

-- DONE 2026-09-05, the last of the four. 39 cells: 34 residue, 2 already
-- modelled and never recorded (the specifier text is a string literal, every
-- binding is an identifier), 1 unreachable under this parser, and 2 to a new
-- item. Plus TWO CELLS FROM OUTSIDE THE BUCKET corrected on the way - a waiver
-- whose own comment described undone work, which is open work counted as
-- settled and which no audit can see.
work(w_mod_sweep, "DONE 2026-09-05: 39 cells, 34 residue, 2 already modelled, and a false waiver corrected beside them").
work_order(w_mod_sweep, 13).
work_state(w_mod_sweep, done).
work_sweeps(w_mod_sweep, modules).

-- ...and the fourth sweep, which the third layer created the moment it was
-- declared. Its residue is the largest of the four because most kinds transfer
-- no control at all — an identifier, a literal, a property — and that is
-- arithmetic rather than judgement, which is exactly what a sweep is for.
-- DONE 2026-09-05, and the number is the argument against calling a sweep
-- arithmetic: FORTY cells, TWENTY-EIGHT genuine residue, TWELVE not. A default
-- would have said `not_yet` about all forty and been wrong about twenty-eight;
-- a blanket waiver would have been wrong about twelve. The twelve fall into
-- four questions and each got an item of its own rather than a bucket.
work(w_cf_sweep, "DONE 2026-09-05: 40 cells, 28 waived with a reason, 12 that were not residue split into four items").
work_order(w_cf_sweep, 23).
work_state(w_cf_sweep, done).
work_sweeps(w_cf_sweep, controlflow).
work_spawned(w_cf_sweep, f_the_vocabulary_was_a_model_of_the_corpus_not_of_the_language).
work_spawned(w_cf_sweep, f_a_sweep_is_where_the_residue_stops_being_residue).

-- 24 — A BODY IS A CONTROL REGION, and the walk is done as of 2026-09-06.
-- `may_not_run` asks whether a function's own call sites are guarded and stops
-- there; whether the CALLER runs is the transitive question.
--
-- THIS NOTE USED TO SAY the walk was declared absent because guessing at entry
-- points would answer something nobody asked. The measurement replaced that
-- with a fact: the entry-free formulation is UNSTRATIFIED and the kernel
-- refuses it — `round 5 settled nothing while dead_fn, live_call remained`. An
-- entry point is not a convenience, it is what turns a cycle through negation
-- into a positive least fixpoint. And it need not be guessed, because a
-- module's export surface is its entry surface.
--
-- THE CORPUS HAD NO WITNESS EITHER, measured before anything was written: all
-- seven functions `may_not_run` named were LEAVES, so the transitive closure
-- added exactly zero names. `dormant`/`sleeper`/`useDormant` are the chain that
-- makes the difference visible. Second item running whose fixture had to come
-- before its rule.
work(w_cf_reachability, "DONE 2026-09-06: entry surface = export surface; r_reachability answers all five function forms").
work_order(w_cf_reachability, 24).
work_state(w_cf_reachability, done).
work_spawned(w_cf_reachability, f_the_entry_point_is_what_makes_the_question_stratified).
work_spawned(w_cf_reachability, f_the_denominator_was_empty_so_the_probe_could_not_fail).
claim(queued, js, function_declaration,      none, controlflow, w_cf_reachability).
claim(queued, js, function_expression,       none, controlflow, w_cf_reachability).
claim(queued, js, arrow_function_expression, none, controlflow, w_cf_reachability).
claim(queued, js, class_method,              none, controlflow, w_cf_reachability).
claim(queued, js, object_method,             none, controlflow, w_cf_reachability).

-- 25 — THE EXCEPTION PATH, and it is the owner's observation that put it here:
-- an exception IS control flow. The TRANSFER is modelled — `try`, `catch` and
-- the handler arm are in rules/js-controlflow.rofl — and two halves are not.
-- A call may leave by THROWING rather than returning, which no rule says; and
-- `throw e` moves a value into whichever `catch` receives it, which travels
-- along the exception path rather than along the syntax and is the first
-- dataflow edge here that does.
-- CLOSED 2026-09-06, and it took back a witness that had been given away. When
-- w_cf_abrupt_transfer closed, `useTry -> after` was re-attributed to
-- w_exn_propagation (28, the TRANSITIVE half) because `after` follows a call
-- that throws. Measured here: `thrower`'s own body carries the throw, with no
-- handler and no return, so nothing propagates anywhere — it is THIS item's
-- half, a call that leaves by throwing, and the transitive item was one step
-- too far. Ninth attribution corrected by measurement this session and the
-- first to correct one of my own corrections.
--
-- BOTH HALVES NEEDED A FIXTURE. The corpus held one function that cannot
-- return normally and one catch clause with a parameter that only voided it.
work(w_exception_flow, "DONE 2026-09-06: r_call_is_an_exit + r_exception_value; 4 cells, and `after` explained at last").
work_order(w_exception_flow, 25).
work_state(w_exception_flow, done).
work_spawned(w_exception_flow, f_a_call_that_exits_stops_at_the_function_boundary).
work_spawned(w_exception_flow, f_a_fixture_can_blind_a_mutant_and_a_count_cannot_tell).
work_spawned(w_exception_flow, f_the_arm_written_from_the_language_not_from_the_store).
claim(queued, js, call_expression,  none, controlflow, w_exception_flow).
claim(queued, js, super,            none, controlflow, w_exception_flow).
claim(queued, js, throw_statement,  none, dataflow,    w_exception_flow).
claim(queued, js, catch_clause,     none, dataflow,    w_exception_flow).

-- 26 — A GETTER IS A CALL WEARING A READ'S SYNTAX, and the LAST cell at the
-- control-flow layer. The note said it needs the value layer to know which
-- properties are accessors, "which it does not record". Measured: the scanner
-- emits `ast_attr(M, kind, "get"|"set")` for every method, and `own_ctor` in
-- rules/js-dataflow.rofl already reads that same attribute for `"constructor"`.
-- The fact was on the store; nothing had asked. FOURTH design note in four
-- items to lose to one probe, and the third time this session the answer was a
-- fact nobody consumed.
--
-- THE CORPUS HELD ZERO ACCESSORS — the `kind` tally across all three files was
-- `method` and `constructor` and nothing else — so the fixture came first for
-- the fourth item running.
work(w_cf_accessor, "DONE 2026-09-06: r_accessor; a read that runs a getter, and an exit when the getter throws").
work_order(w_cf_accessor, 26).
work_state(w_cf_accessor, done).
work_spawned(w_cf_accessor, f_the_accessor_attribute_was_read_for_constructor_and_never_for_get).
work_spawned(w_cf_accessor, f_an_instruments_world_is_part_of_its_claim).
claim(queued, js, member_expression, none, controlflow, w_cf_accessor).
-- The optional twin is NOT claimed: its cell is already ticked for the
-- short-circuit, and a kind-level cell cannot carry two verdicts. See the note
-- in facts/js-controlflow.rofl — `queue_stale[audit]` said so on the first run.

-- 27 — THE FRAME, decided 2026-09-06. `vocabulary_gap[audit]` stood at
-- seventeen on an honest checkout, and the item's own note called it a DECISION
-- rather than a chore. Measured, the seventeen are not one list but THREE, and
-- treating them as one is what made it look like seventeen waivers:
--
--   3  NOT CONSTRUCTS   file, program, comment_line — the scanner's own roots
--                       and trivia. No layer can have an opinion; twelve cells
--                       describing the SCANNER is noise in a matrix about JS.
--   4  REAL AND ANSWERED binary_expression, unary_expression, class_body,
--                       template_element — sixteen cells, all waived with a
--                       reason about the LANGUAGE rather than about our effort.
--   10 DEFERRED         the TypeScript type nodes, forty cells that no rule can
--                       close because what a type MEANS here is item 31's
--                       question. `frame_deferred(K, W)` names the owner.
--
-- `binary_expression` was already LOAD-BEARING before it was declared: the era
-- layer carries `kind_baseline` and an `attr_needs` row for `**` on a kind the
-- vocabulary did not contain. That is the sharpest thing this audit has caught.
work(w_vocabulary_frame, "DONE 2026-09-06: 3 not constructs, 4 declared and answered, 10 deferred to w_type_surface; the audit is at zero").
work_order(w_vocabulary_frame, 27).
work_state(w_vocabulary_frame, done).
work_spawned(w_vocabulary_frame, f_the_vocabulary_was_a_model_of_the_corpus_not_of_the_language).
work_spawned(w_vocabulary_frame, f_a_gate_with_nowhere_to_record_the_decision_stays_red).

-- 14 — RAISED BY THE WORK IT CAME OUT OF, and deliberately not done in it.
-- `new C()` and the name `C` both reach the class node, so the model does not
-- tell an instance from its class: it would accept `inst.staticOne()` and
-- `C.instanceOne()`. The corpus contains no site that could show the
-- difference, so splitting them today is a distinction no gate can see — which
-- is exactly the shape this session has been bitten by twice. It needs a
-- fixture case first, and then it is small.
-- DONE 2026-09-05. The fixture came first, as the item demanded: two false
-- edges named in the over-approximation list before a rule existed, and gone
-- after. `ast_attr(M, static, ...)` had been on the store since the scanner was
-- written and nothing read it. The third face needed no rule at all - `super`
-- already had a value and the corpus simply had no site for it.
-- ONE LIMITATION DECLARED rather than hidden: the receiver's role is decided
-- SYNTACTICALLY, so `const A = Vat; A.tapped()` reads as an instance and loses
-- the static. Recorded as f_the_receiver_role_is_syntactic_and_an_alias_loses_it.
work(w_df_instance_vs_class, "DONE 2026-09-05: the receiver decides which half of a class it sees; super needed no rule").
work_order(w_df_instance_vs_class, 14).
work_state(w_df_instance_vs_class, done).
work_spawned(w_df_instance_vs_class, f_the_receiver_role_is_syntactic_and_an_alias_loses_it).
-- THE THIRD FACE OF THE SAME CONFUSION, folded in by the dataflow sweep rather
-- than given an item of its own: `super` has no value, so `super.m` cannot be
-- looked up through `member_value` even though `super_of[flow]` is right there.
-- The call graph resolves `super()` by a dedicated rule that does not go
-- through the value layer at all. All three are one question — what a
-- class-shaped node DENOTES — and they want one fixture.


-- ===========================================================================
-- FOUR BLOCKERS RETIRED 2026-09-08, AND THE CAUSE WAS OURS ALL ALONG. They
-- read `cell_blocked(..., scanner_contract)` under a note that ended `it moves
-- when the scanner's contract moves`, and nobody had measured how far the
-- contract was from moving. Measured: over 223 files and 422 482 nodes, with
-- babel's `extra` scratch declared out, the scalars-only contract excluded
-- EXACTLY ONE property in the whole language — `TemplateElement.value`, whose
-- members are all scalars. One general rule in the scanner (a nested object of
-- scalars is flattened) and the four cells opened; no rule was needed at the
-- call graph at all, because `selects[flow]` already reads a computed key
-- through `may_be_lit`.
--
-- THE SHAPE OF THE MISTAKE IS THE ONE THIS REPOSITORY KEEPS RECORDING: a
-- blocker was attributed to the first component looked at, written down
-- accurately, and then read as a constraint rather than as a setting. It
-- survived three sessions because the sentence was TRUE.

-- ===========================================================================
-- 15-18 — THE ENVIRONMENT LAYER'S OWN RESIDUE, added 2026-09-04 when
-- rules/js-env.rofl landed. The layer answers three of the owner's four
-- questions on the syntax axis; each item below is one of the things it
-- cannot do yet, and each is entered because the work found it rather than
-- because it was foreseen.

-- 15. THE ONE THING THE HOST HAS TO DO. A file the scanner REFUSES contributes
-- no facts at all, so `valid[audit]` neither accepts nor refuses it: a corpus
-- can lose a file silently and every count stays plausible. No rule can derive
-- the absence of everything, so this moves only when the scanner reports its
-- own failures. It is ordered first of the four because every other answer
-- this layer gives is conditional on it.
-- DONE 2026-09-05, and the positive control overturned the premise on the way.
-- The item said a refused file is lost SILENTLY; scanning a corpus with one
-- unparseable file reported `scanned 2`, exit 0, and wrote a fact file for the
-- broken one carrying `src_parse_error`. The capability EXISTED - in
-- scanners/js.ts, with a test asserting it by name - and had never reached
-- scanners/js_ast.ts, which is the scanner every rule in the language model
-- reads. Nothing reads `src_parse_error` either. The name proposed here,
-- `scan_failed`, was dropped for `ast_parse_error`: a second name for a thing
-- that already has one is a table that can disagree with itself.
work(w_env_scan_failed, "DONE 2026-09-05: ast_parse_error from the scanner, and a refused file is invalid in every environment").
work_order(w_env_scan_failed, 15).
work_state(w_env_scan_failed, done).
work_spawned(w_env_scan_failed, f_the_refusal_was_a_fact_in_the_other_scanner_already).
work_spawned(w_env_scan_failed, f_a_refused_file_is_absent_not_invalid).

-- 16. POSITION. `await` at the top level of a module is ES2022 and the same
-- word inside an async function is ES2017, and they are THE SAME NODE KIND.
-- The era table gates on a kind and on one scalar attribute, so it reports the
-- older era for both and test/js-env.test.ts pins that wrong answer. The fix
-- is a third gate shape keyed on an ANCESTOR rather than on the node —
-- `ast_within` is already there — and it is the first place this layer needs
-- to know where a node is rather than what it is.
-- DONE 2026-09-05. A third gate table, `outside_attr_needs(Lang, Kind, Key,
-- Value, Feature)`: a node of Kind with NO ancestor carrying Key=Value needs
-- Feature. It reads `ast_attr(F, async, true)`, which the scanner emits for
-- every function form, so it needs no kind class and no new contract - the same
-- move `attr_needs` made when it read the operator instead of inventing a table.
-- The blind-spot test that PINNED the wrong answer became the acceptance, with
-- a mutant that removes the ancestor test and watches every await become
-- top-level. AND THE WORK FOUND A LIVE DEFECT BESIDE IT, measured on the honest
-- tree: `feature_undeclared[audit]` read `kind_needs` alone while three tables
-- feed it, so a typo in `attr_needs` was silent while taking `invalid` 8 -> 9.
work(w_env_positional_features, "DONE 2026-09-05: outside_attr_needs gates on what is NOT around a node; the era vocabulary audits read all three tables").
work_order(w_env_positional_features, 16).
work_state(w_env_positional_features, done).
work_spawned(w_env_positional_features, f_the_feature_vocabulary_audit_read_one_of_three_tables).

-- 17. THE API SURFACE. `fs.cp` and `Array.prototype.at` are the half of the
-- question that syntax cannot answer, and unlike the syntax half it needs
-- GENERATED packs — measured in Disentinel/grafema, whose hand-written
-- `lang-defs` package declared an `extends` field its loader never read and
-- had no consumer at all, while the effects database it actually shipped is
-- split by RUNTIME and has no version axis whatsoever. It also brings the one
-- question left unanswered here: a remedy for an API is a SUBSTITUTION
-- (`replaced_by/2`) where a remedy for syntax is a transform, and this model
-- has no term for a transform.
-- DONE 2026-09-08, and the deliverable is an ANSWER rather than an edge.
-- scanners/ts_lib.ts reads TypeScript`s own `lib.es*.d.ts` — 130 members of
-- eight prototypes, each dated by the earliest lib file that declares it — into
-- facts/js-lib-surface.rofl, and rules/js-env-api.rofl joins that to
-- `stdlib_member[audit]`. `[1,2,3].at(0)` is now known to be invalid under es5,
-- es2015, es2016 and es2020 and valid under ts5; `'a'.replaceAll` invalid up to
-- es2020; `1n.toString()` invalid below es2020. Three methods, three years,
-- discriminated — which is the half of the environment question this item`s own
-- note called `what syntax cannot answer`.
--
-- ITS FOUR CELLS DID NOT BECOME `handled` AND THAT IS THE HONEST OUTCOME: the
-- call transfers into a function with no source, so `no_source_target` — the
-- model`s own IRREDUCIBLE atom — is what they carry now. They leave the work
-- queue because nobody can do anything more, not because somebody decided not
-- to look.
--
-- `replaced_by/2` IS THE HALF NOT DONE. The item`s note asks for a remedy as a
-- SUBSTITUTION, and nothing here supplies one: the surface says WHEN a method
-- appeared and never what to use instead. That needs a second table TypeScript
-- does not keep, so it is a new item rather than a loose end.
work(w_env_api_surface, "DONE 2026-09-08: the API surface generated from TypeScript`s lib.es*.d.ts, joined to the call graph`s residue and gated by year").
work_order(w_env_api_surface, 17).
work_state(w_env_api_surface, done).

-- 18. THE FORM THE OWNER ASKED FOR. `unsupported[node18](Site, Feature)`
-- instead of an environment column, blocked by one measured defect and by
-- nothing else. The diff is the head of three rules. It waits on the leak
-- audit learning to see a variable ledger on the RIGHT of a crossing, which is
-- a KERNEL question and is deliberately held in the backlog — so this item is
-- `work_needs`-blocked rather than merely unstarted, and the queue will not
-- offer it until that is true.
work(w_env_ledger_form, "move the verdict into the environment's own ledger: unsupported[node18](Site, Feature)").
work_order(w_env_ledger_form, 18).
work_state(w_env_ledger_form, open).
work_needs(w_env_ledger_form, w_leak_variable_on_the_right).
work_spawned(w_env_ledger_form, f_a_derived_per_environment_conclusion_has_no_green_form).

-- ...and the kernel item it waits on, entered so that `needs_unknown[audit]`
-- stays empty and the dependency is a row rather than a sentence in a comment.
-- It is ordered LAST because it is the owner's to schedule, not mine: seven
-- tests are already red on it and he has said to hold it.
work(w_leak_variable_on_the_right, "leak[audit] cannot see a variable ledger on the RIGHT of a crossing; collects covers only the left").
work_order(w_leak_variable_on_the_right, 19).
work_state(w_leak_variable_on_the_right, open).
work_spawned(w_leak_variable_on_the_right, f_the_leak_audit_now_fires_on_a_ledger_polymorphic_head).
work_spawned(w_leak_variable_on_the_right, f_a_hold_written_as_an_ordinal_expires_when_the_queue_grows).

-- HELD BY THE OWNER, 2026-09-05, and stated as a row because the ordinal above
-- stopped meaning it. Order 19 was chosen when 19 was LAST; the queue is now 38
-- items long and the plan began offering this one as ordinary work. Vadim's
-- words: «Нет, давай полиморфную голову пока подержим в бэклоге».
held(w_leak_variable_on_the_right, vadim).

-- ===========================================================================
-- 28-32 — THE FIVE LAYERS THE SWEEP DID NOT REACH, entered 2026-09-05 at the
-- owner's instruction (exceptions, scope, types, alias, effects). They are
-- ITEMS, not layers. `layer(L)` is one fact and it costs 64 cells at today's
-- vocabulary, so declaring five of them would open 320 cells in one commit and
-- pre-commit the answer to the question each item exists to ask. An item can
-- decide to become a layer; a layer cannot decide to become an item.
--
-- THREE OF THE FIVE OWN NO CELL, and that is the honest report rather than an
-- omission: the matrix indexes (kind x layer), so a gap that lives in the RULES
-- rather than in a kind has nowhere to appear. Recorded as
-- f_a_blindness_can_have_no_cell.

-- 28. EXCEPTIONS, THE TRANSITIVE HALF. Item 25 is the local edge: a value from
-- `throw` to the `catch` that receives it, and a call that leaves by throwing.
-- What no rule says is what PROPAGATES: `f` calls `g` which throws, `f` has no
-- handler, so `f` throws too. That is a transitive closure over the call graph
-- with the handlers as its stopping condition, and this queue has already split
-- a transitive question out of its local one once, for exactly this reason
-- (w_cf_reachability out of `may_not_run`). It owns no cell: every kind it
-- touches is claimed by item 25 or by w_cf_abrupt_transfer, because propagation
-- is a property of the EDGE and cells are indexed by node kind.
--
-- CLOSED 2026-09-06, and it is the FIRST ITEM IN FIVE THAT NEEDED NO NEW
-- FIXTURE. Measured before a line was written: seven throw sites, six not
-- caught by a try in their own function, and the closure adds exactly four
-- names — `nestedThrow -> useNested -> main`, `topThrowWithReturn ->
-- useWithReturn`, `Fuse -> Lit`. The corpus grew that chain by accident while
-- three earlier items wrote their own witnesses, which is the first time this
-- session the queue's own note was simply right.
--
-- AND IT ANSWERED THE FRONTIER ITEM 25 HANDED IT. `catch_from_call[flow]` was
-- declared as a deferral with this item as owner; `caught_value` now names the
-- value `useTry`'s `catch (e)` receives from `thrower`. What is left is a THIRD
-- class the split did not have — `catch_from_host[flow]`, a handler whose block
-- calls only functions that cannot throw, so the value can come only from the
-- host. Owned by w_env_api_surface, and the audit stays exact rather than
-- absorbing it.
work(w_exn_propagation, "DONE 2026-09-06: may_throw and thrown_by close over the call graph; the catch_from_call frontier is answered").
work_order(w_exn_propagation, 28).
work_state(w_exn_propagation, done).
work_needs(w_exn_propagation, w_exception_flow).
work_spawned(w_exn_propagation, f_a_frontier_with_an_owner_pays_out_when_the_owner_lands).

-- 29. SCOPE, AND IT HAS ALREADY COST US ONCE. `binder[flow]` is FILE-scoped by
-- construction: one name, one binding, per file. Shadowing, block scope, the
-- temporal dead zone and parameter scope are all invisible, and this is not
-- hypothetical - a `const chosen` renamed to `f` in a for-of head collided with
-- three parameters named `f` in the same fixture and took `ambiguous_call` from
-- 4 to 14 in one edit. The blindness is declared tier 1 in
-- docs/modelling-a-language.md and no gate can see it: under the four layers we
-- have, `block_statement x dataflow` reads `waived / a_a_statement_carries_no_value`,
-- which is TRUE of values and FALSE of bindings. A scope layer would reopen a
-- waived cell and nothing audits for that.
-- CLOSED 2026-09-07 for the FUNCTION half, and the measurement that opened it
-- is the finding. `ambiguous_call[audit]` stood at eight and not one of the
-- eight was scope: two `pick|pick` are two object methods, two `alef|bet` are a
-- correct for-of may-set. The item's own story had no witness — because the
-- corpus had been BENT AROUND the defect. Five fixture renames in seven
-- iterations of this loop were made specifically to dodge the file-scoped
-- binder, so the one live collision (`const c` = Crate in one function, Cask in
-- another) derived nothing wrong only because the two classes shared no method
-- name. One method closed that gap and the audit went 8 -> 12.
--
-- `binder_region` / `sees_binder` give a use the binders whose REGION contains
-- it — the enclosing function, or the file for a module-level binder. Five
-- mutants, five killed, each on a named row; two needed fixtures of their own
-- (a literal binder colliding across functions, and a closure reading an outer
-- const, which is what tells `contains` from `is`).
work(w_scope_binding, "DONE 2026-09-07: a use sees the binders whose region contains it, and `this` is bound by the nearest enclosing non-arrow function; shadowing is w_scope_shadowing").
work_order(w_scope_binding, 29).
work_state(w_scope_binding, done).
work_spawned(w_scope_binding, f_a_blindness_can_have_no_cell).
work_spawned(w_scope_binding, f_the_corpus_was_bent_around_the_defect_until_it_could_not_be_seen).
work_spawned(w_scope_binding, f_a_declared_over_approximation_is_a_defect_with_a_comment_on_it).

-- 44 — SHADOWING, THE HALF THAT IS LEFT. Two binders of one name where one
-- region CONTAINS the other are both visible at a use inside the inner one, and
-- nothing prefers the nearer. Block scope, the temporal dead zone and parameter
-- scope are all in here. The direction is the safe one — an extra candidate in
-- a may-set — and it needs block regions plus a nearest-wins rule, which is a
-- different shape from the containment rule that closed the function half.
work(w_scope_shadowing, "an inner binder does not hide an outer one: block regions, nearest-wins, the TDZ and parameter scope").
work_order(w_scope_shadowing, 44).
work_state(w_scope_shadowing, open).
work_needs(w_scope_shadowing, w_scope_binding).

work(w_mutant_anchor_decay, "DONE 2026-09-07: the plant is computed from `takeable(W)` ordered by `work_order`, so it names the CURRENT head and the LAST takeable item and expires never - five re-aimings were what it cost to stop writing the anchor by hand").
work_order(w_mutant_anchor_decay, 45).
work_state(w_mutant_anchor_decay, done).
work_spawned(w_mutant_anchor_decay, f_a_mutant_anchored_to_an_item_name_expires_when_the_item_closes).
work_spawned(w_mutant_anchor_decay, f_the_anchor_was_authored_text_and_the_thing_it_named_was_a_query).


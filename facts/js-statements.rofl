-- js-statements.rofl — THE CONSTRUCTS THE VOCABULARY HAD NEVER NAMED.
--
-- MEASURED 2026-09-05, and it is why this file exists rather than a few rows
-- appended somewhere: one probe file holding the ordinary control constructs
-- emitted 51 node kinds and THIRTY of them were undeclared. The matrix had four
-- layers, 229 cells and every audit at zero, while `try`, `catch`, `throw`,
-- `switch`, `while`, `for`, `break` and `continue` were not in it at all.
--
-- `unaccounted[audit]` compares DECLARED kinds against layers, so an undeclared
-- kind is not a hole in the matrix — it is outside the frame. The instrument
-- that can see it is `vocabulary_gap[audit]` in rules/js-model.rofl, added the
-- same day: a kind the CORPUS produces that the vocabulary does not declare.
-- Its count is the honest frontier of the whole model.
--
-- WHAT IS DECLARED HERE and what is not, decided rather than swept in: the
-- control constructs, because the control-flow layer claims to know about
-- control and cannot be silent about `try`. What is left outside is the
-- structural and type-shaped residue — `program`, `file`, `comment_line`,
-- `template_element`, the `ts*` type nodes — and it stays in
-- `vocabulary_gap[audit]` with a queue item rather than being declared to make
-- a number go to zero.

-- BRANCHING AND LOOPING
node_kind(js, while_statement).
node_kind(js, do_while_statement).
node_kind(js, for_statement).
node_kind(js, for_in_statement).
node_kind(js, switch_statement).
node_kind(js, switch_case).

-- ABRUPT TRANSFERS
node_kind(js, throw_statement).
node_kind(js, break_statement).
node_kind(js, continue_statement).

-- THE EXCEPTION MACHINERY. `try_statement` and `catch_clause` are the reason
-- this file was written at all: an exception is control flow, and a layer that
-- knows what a branch is and not what a throw is knows half of it.
node_kind(js, try_statement).
node_kind(js, catch_clause).

-- STRUCTURE THE CONTROL LAYER HAS TO WALK. A block is where statement ORDER
-- lives, and order is what `abrupt` needs; an expression statement and a
-- variable declaration are the two ways a call reaches a block.
node_kind(js, block_statement).
node_kind(js, expression_statement).
node_kind(js, variable_declaration).

-- ===========================================================================
-- AND THE VERDICTS THEY OPENED. Fourteen kinds times four layers is fifty-six
-- cells, and this is the sweep for them: mostly waivers with a reason, and two
-- rows that are not.

-- ---------------------------------------------------------------------------
-- CALLGRAPH. A statement is neither a callee nor a transfer site — the call
-- inside one is a `call_expression`, which the layer already answers for.
ignored(js, while_statement,       callgraph, a_a_statement_is_not_a_callee).
ignored(js, do_while_statement,    callgraph, a_a_statement_is_not_a_callee).
ignored(js, for_statement,         callgraph, a_a_statement_is_not_a_callee).
ignored(js, for_in_statement,      callgraph, a_a_statement_is_not_a_callee).
ignored(js, switch_statement,      callgraph, a_a_statement_is_not_a_callee).
ignored(js, switch_case,           callgraph, a_a_statement_is_not_a_callee).
ignored(js, throw_statement,       callgraph, a_a_statement_is_not_a_callee).
ignored(js, break_statement,       callgraph, a_a_statement_is_not_a_callee).
ignored(js, continue_statement,    callgraph, a_a_statement_is_not_a_callee).
ignored(js, try_statement,         callgraph, a_a_statement_is_not_a_callee).
ignored(js, catch_clause,          callgraph, a_a_statement_is_not_a_callee).
ignored(js, block_statement,       callgraph, a_a_statement_is_not_a_callee).
ignored(js, expression_statement,  callgraph, a_a_statement_is_not_a_callee).
ignored(js, variable_declaration,  callgraph, a_a_statement_is_not_a_callee).

-- ---------------------------------------------------------------------------
-- DATAFLOW. A statement carries no value — with ONE exception that is not a
-- waiver at all and is the reason this block is written out rather than
-- generated: `catch (e)` BINDS a variable, and `e` is the thrown value. That is
-- a real dataflow edge nothing models, and it travels along the exception path
-- rather than along the syntax, which is why it belongs with the exception work
-- and not here.
ignored(js, while_statement,       dataflow, a_a_statement_carries_no_value).
ignored(js, do_while_statement,    dataflow, a_a_statement_carries_no_value).
ignored(js, for_statement,         dataflow, a_a_statement_carries_no_value).
ignored(js, for_in_statement,      dataflow, a_a_statement_carries_no_value).
ignored(js, switch_statement,      dataflow, a_a_statement_carries_no_value).
ignored(js, switch_case,           dataflow, a_a_statement_carries_no_value).
ignored(js, break_statement,       dataflow, a_a_statement_carries_no_value).
ignored(js, continue_statement,    dataflow, a_a_statement_carries_no_value).
ignored(js, try_statement,         dataflow, a_a_statement_carries_no_value).
ignored(js, block_statement,       dataflow, a_a_statement_carries_no_value).
ignored(js, expression_statement,  dataflow, a_a_statement_carries_no_value).
ignored(js, variable_declaration,  dataflow, a_the_declarator_carries_it).
-- `throw e` moves a value from the throw site to whichever `catch` receives it,
-- and until 2026-09-06 no rule here connected the two. `caught_value[flow]`
-- does, and it is the first edge in this layer that travels along the EXCEPTION
-- PATH rather than along the syntax — every other rule reads a binder, an
-- argument position or a member key, while a catch parameter is bound by
-- something that happens elsewhere in the block. The value that crosses a CALL
-- edge is named as a frontier (`catch_from_call[flow]`) with w_exn_propagation
-- as its owner, so the audit beside it can stay at zero honestly.
handled(js, throw_statement, dataflow, r_exception_value).
handled(js, catch_clause,    dataflow, r_exception_value).

-- ---------------------------------------------------------------------------
-- MODULES. None of them can appear in a module graph.
ignored(js, while_statement,       modules, a_not_a_module_construct).
ignored(js, do_while_statement,    modules, a_not_a_module_construct).
ignored(js, for_statement,         modules, a_not_a_module_construct).
ignored(js, for_in_statement,      modules, a_not_a_module_construct).
ignored(js, switch_statement,      modules, a_not_a_module_construct).
ignored(js, switch_case,           modules, a_not_a_module_construct).
ignored(js, throw_statement,       modules, a_not_a_module_construct).
ignored(js, break_statement,       modules, a_not_a_module_construct).
ignored(js, continue_statement,    modules, a_not_a_module_construct).
ignored(js, try_statement,         modules, a_not_a_module_construct).
ignored(js, catch_clause,          modules, a_not_a_module_construct).
ignored(js, block_statement,       modules, a_not_a_module_construct).
ignored(js, expression_statement,  modules, a_not_a_module_construct).
ignored(js, variable_declaration,  modules, a_not_a_module_construct).

-- ---------------------------------------------------------------------------
-- CONTROLFLOW. This is the layer they were declared FOR, so most of them are
-- answered rather than waived.
handled(js, while_statement,    controlflow, r_guard_arm).
handled(js, for_statement,      controlflow, r_guard_arm).
handled(js, for_in_statement,   controlflow, r_guard_arm).
handled(js, switch_statement,   controlflow, r_guard_arm).
handled(js, switch_case,        controlflow, r_guard_arm).
handled(js, try_statement,      controlflow, r_guard_arm).
handled(js, catch_clause,       controlflow, r_guard_arm).
-- ...one waived on a fact about the language rather than about our effort: a
-- `do` body runs BEFORE the test, so it guards nothing.
ignored(js, do_while_statement, controlflow, a_body_that_always_runs_guards_nothing).
-- ...three structural containers, which carry the positions the layer reads and
-- transfer nothing themselves.
ignored(js, block_statement,      controlflow, a_a_container_transfers_nothing).
ignored(js, expression_statement, controlflow, a_a_container_transfers_nothing).
ignored(js, variable_declaration, controlflow, a_a_container_transfers_nothing).
-- ...and three abrupt transfers, answered on 2026-09-06 by `r_abrupt`: each
-- makes the statements AFTER it in the same statement list unreachable.
-- THE WITNESS THIS COMMENT USED TO NAME WAS THE WRONG ONE. It said `after` in
-- test/fixtures/js-call/alpha.mjs, and the measurement that opened this work
-- found ZERO statements in the whole corpus sitting after an abrupt transfer —
-- `after` is silent because `thrower` always throws, which is exception
-- PROPAGATION across a call edge (w_exn_propagation) and not statement order at
-- all. `useAbrupt`/`neverReached` were added as the real witness.
handled(js, throw_statement,    controlflow, r_abrupt).
handled(js, break_statement,    controlflow, r_abrupt).
handled(js, continue_statement, controlflow, r_abrupt).

-- ===========================================================================
-- LABELLED CONTROL, 2026-09-08 — queue item w_labelled_control. One kind, four
-- cells, and the interesting one is the third.
--
-- MEASURED FIRST, on a fixture built because the corpus held ZERO labels:
-- `after_abrupt[code]` named `pastBreak` and `pastContinue` — the siblings of
-- the break in its OWN statement list, which a plain `break` kills too — and
-- did not name `pastLabelledBreak`, `pastLabelledContinue` or
-- `pastLabelledBlock`. THE MODEL WAS READING A LABELLED BREAK AS AN ORDINARY
-- ONE. `r_labelled_boundary` reads the LABEL rather than the keyword and walks
-- from the reference to the `labeled_statement` that carries the same name,
-- which is why `beyondPlainBreak` — after an unlabelled break — stays out.
handled(js, labeled_statement, controlflow, r_labelled_boundary).

-- ...AND THE OTHER THREE LAYERS WERE ASKED RATHER THAN ASSUMED. Over the
-- corpus, with the fixture in it, every `labeled_statement` node appears in
-- ZERO rows of `site[code]` (the call graph's own denominator: a call site or a
-- transfer site) and zero of `resolves[code]` on either side, ZERO of
-- `valued[flow]` (`may_be_lit` or `may_be_node`, the value layer's answer to
-- "does this node carry a value"), and ZERO of `import_site[code]`,
-- `site_kind[code]` and `binding[code]`. AN EMPTY INTERSECTION IS A FACT ABOUT
-- THE QUERY until something proves the query can return rows, so each of those
-- five carries a positive control in the same run: EVERY `call_expression` node
-- is a site (406 of 406 on 2026-09-08), identifiers are valued (938), and every
-- `import_declaration` is an import site with a shape (8 of 8). The first three
-- are asserted in test/js-controlflow.test.ts; the modules pair was measured in
-- a world built by hand, because test/js-corpus-world.ts does not load
-- rules/js-modules.rofl and those relations are not in that world at all.
ignored(js, labeled_statement, callgraph, a_a_statement_is_not_a_callee).
ignored(js, labeled_statement, dataflow,  a_a_statement_carries_no_value).
ignored(js, labeled_statement, modules,   a_not_a_module_construct).

-- ===========================================================================
-- THE INERT STATEMENTS, 2026-09-08 — queue item w_inert_statements. Its own
-- note says "three statements no layer is likely to have an opinion about", and
-- LIKELY is a guess: eight of the twelve cells are closed below because a
-- fixture put the construct in the corpus and a query returned a row or failed
-- to. The other four are `with_statement`, which no scan in this repository can
-- produce — see facts/worklist.rofl for the measurement and what would move it.
--
-- AND THE CONTROL-FLOW LAYER DOES HAVE AN OPINION, which is why these two rows
-- are not the arithmetic the item's note expected. Measured over the corpus:
-- of four `empty_statement` nodes, THREE are `guarded[code]`, TWO are a
-- `guard_arm[code]` (a loop body written `while (total < 0) ;` and the
-- consequent of an `if`) and ONE is `after_abrupt[code]`; of two
-- `debugger_statement` nodes, one is guarded and one is after an abrupt
-- transfer. So an inert statement OCCUPIES conditional positions perfectly
-- well. What it does not do is CREATE one — neither kind is in
-- `transfer_mechanism`, and `;` is the only statement in the language the
-- scanner emits with ZERO `ast_child` rows, so there is nothing inside it for a
-- guard to skip and nothing after it inside itself. Occupying a guarded
-- position and transferring control are different claims, and only the second
-- is what this layer's cells ask about.
ignored(js, empty_statement,    controlflow, a_no_control_transfer).
-- `debugger` is the one statement whose effect is IMPLEMENTATION-DEFINED: the
-- spec permits a breakpoint and requires nothing. Either way it completes
-- normally with the same continuation, which is what separates it from the
-- suspensions — an `await` is control LEAVING, and this is control stopping in
-- place. Waived on the language rather than on our effort, the same shape as
-- `do_while_statement` above.
ignored(js, debugger_statement, controlflow, a_no_control_transfer).

-- ...and the same three queries as the label, with the same positive controls:
-- four `empty_statement` and two `debugger_statement` nodes, ZERO rows in
-- `site[code]`, `resolves[code]`, `valued[flow]`, `import_site[code]`,
-- `site_kind[code]` and `binding[code]`.
ignored(js, empty_statement,    callgraph, a_a_statement_is_not_a_callee).
ignored(js, debugger_statement, callgraph, a_a_statement_is_not_a_callee).
ignored(js, empty_statement,    dataflow,  a_a_statement_carries_no_value).
ignored(js, debugger_statement, dataflow,  a_a_statement_carries_no_value).
ignored(js, empty_statement,    modules,   a_not_a_module_construct).
ignored(js, debugger_statement, modules,   a_not_a_module_construct).

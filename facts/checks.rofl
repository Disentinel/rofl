check_opt("agg_datastrat_tick", ticks, 2).
check_opt("agg_datastrat_tick", explain, 1).
proves_work("agg_datastrat_tick", w_agg_data_strat).

-- the budget cuts between two layers: every value there is the sheet's, no cell above the wall has one
check_world("agg_datastrat_budget").
check_file("agg_datastrat_budget", "examples/checks/agg-datastrat-sheet.rofl").
check_file("agg_datastrat_budget", "examples/checks/agg-datastrat-expect.rofl").

proves_work("agg_datastrat_budget", w_agg_data_strat).

-- a base fact retracted from such a world: the world is evaluated again and is the world without the fact
check_world("agg_datastrat_retract").
check_file("agg_datastrat_retract", "examples/checks/agg-datastrat-sheet.rofl").
check_file("agg_datastrat_retract", "examples/checks/agg-datastrat-retract-check.rofl").

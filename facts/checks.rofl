check_file("agg_datastrat_why", "examples/checks/agg-datastrat-sheet.rofl").
check_file("agg_datastrat_why", "examples/checks/agg-datastrat-why-check.rofl").
check_opt("agg_datastrat_why", together, 1).
check_opt("agg_datastrat_why", explain, 1).
proves_work("agg_datastrat_why", w_agg_data_strat).

-- a running balance, three ticks deep: the cells are stratified again every tick, and a rule stages what one holds
check_world("agg_datastrat_tick").
check_file("agg_datastrat_tick", "examples/checks/agg-datastrat-tick.rofl").
check_file("agg_datastrat_tick", "examples/checks/agg-datastrat-tick-check.rofl").

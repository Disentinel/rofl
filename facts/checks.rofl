-- the cells a rule seals for what another aggregate of it reached
check_world("agg_incr_chain").
check_file("agg_incr_chain", "examples/checks/agg-incr-chain.rofl").
check_opt("agg_incr_chain", together, 1).
check_opt("agg_incr_chain", retract, "ac_q(2)").
proves_work("agg_incr_chain", w_agg_incremental_ready).

-- the cells a rule seals for the groups its first aggregate has a value for

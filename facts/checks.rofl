check_opt("agg_incr_tagc", retract, "ic_e(a, c)").
proves("agg_incr_tagc", agg, tag_counting, incremental_ready).

-- a join lattice keeps the history of the schedule that read its contributions: evaluated again, flags and firing ids recorded

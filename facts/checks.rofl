check_opt("agg_incr_join", retract, "ij_e(b, c)").
proves("agg_incr_join", agg, join_lattice, incremental_ready).

-- a widening depends on the order of its iterations: strategy full
check_world("agg_incr_widen").
check_file("agg_incr_widen", "examples/checks/agg-incr-widen.rofl").
check_opt("agg_incr_widen", together, 1).
check_opt("agg_incr_widen", retract, "iw_step(h, 1)").
proves("agg_incr_widen", agg, widening, incremental_ready).

-- a subsumptive relation is judged against every value it was given: the keys the fact reached, the front and the values dominated, derived again

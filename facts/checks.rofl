-- facts/checks.rofl — WORLDS THE TREE CANNOT BE WALKED TO.
--
-- `scripts/goldens.ts` finds every world under examples/ and rules/ by walking
-- directories. A world that needs a TICK COUNT or a BUDGET, or whose whole
-- point is to be REFUSED, has no directory shape to be found by, so it is
-- declared here.
--
-- This is where a test whose subject is host behaviour stops being a
-- TypeScript string literal and becomes a world two engines can be held to.

edb(check_world).
edb(check_file).
edb(check_opt).
edb(check_refuses).

-- A REFUSAL IS EXPECTED ONLY WHERE IT IS DECLARED. A world that refuses a file
-- it is not declared to refuse fails `npm test` and `npm run bless` alike: a
-- stray `);` in facts/findings.rofl was blessed as `finding 1044 -> 0` and then
-- read green, because the golden had pinned the refusal as the answer.
check_refuses("refused", "refused.rofl").
check_refuses("async_refused", "async-refused.rofl").
check_refuses("not_as_a_name", "not-as-a-name.rofl").
check_refuses("unstratifiable", "unstratifiable.rofl").
check_refuses("premise_arity", "premise-arity.rofl").
-- The dense form of ring 1 is written for examples/ring1/dense.ts, not for the
-- loader; the directory world has refused it since it was first blessed.
check_refuses("ring1", "l1.dense.rofl").
-- a literal of 2^60 is past the term (w_agg_overflow_holes); a fixture carries
-- its expected refusal on its first line instead (`-- expect-refusal: <text>`)
check_refuses("agg_int_range", "agg-int-range-literal.rofl").

check_world("refused").
check_file("refused", "examples/checks/refused.rofl").

check_world("destructor_hole").
check_file("destructor_hole", "examples/checks/destructor-hole.rofl").

-- The same world advanced three ticks: `rofl-load --ticks N` takes it, so both
-- engines answer.
check_world("sensors_t3").
check_file("sensors_t3", "examples/sensors.rofl").
check_opt("sensors_t3", ticks, 3).

-- A WALL, ON BOTH ENGINES. `rofl-load` grew `--budget` for this: it always
-- had `Session::fresh(budget)` and hard-coded the number, so a world that runs
-- out was checked by one engine.
check_world("budget_wall").
check_file("budget_wall", "examples/checks/budget-wall.rofl").
check_opt("budget_wall", budget, 50).
-- ONE ENGINE, AND THE REASON IS A CONTRACT QUESTION RATHER THAN A DEFECT. The
-- two hosts attribute the wall differently: this one evaluates on every `load`
-- and names which one ran out -- `hole($load(1), budget_exhausted)`,
-- `hole($load(2), ...)` -- while `rofl-load` loads every file and evaluates
-- once, recording `hole($adhoc, budget_exhausted)`. Same wall, same reason atom,
-- different attribution. Whether a load evaluates is a decision about the host
-- contract and not something to patch under a green bar.
check_opt("budget_wall", one_engine, ts).

-- ================================================ DEMOS THAT ARE NOT GOLDENS
-- `npm run test:hosts` hashes each demo's output, because 21 of 23 demos call
-- `why`, `whynot`, `excise`, `retract`, `fromSnapshot` or `tickAdvance` — the
-- half of the system a `.rofl` world cannot reach. Two answer about something
-- other than the tree and say so here rather than being chased with a wider
-- mask.
edb(demo_unhashable).
demo_unhashable("npc", "prints a benchmark table whose columns carry no units, so a timing and a row count are indistinguishable line by line").
demo_unhashable("slop", "measures itself against a headless LibreOffice and answers about whatever is installed").

-- THE FOUR OPERATORS NO DEMO REACHED. `%` had no user anywhere in the tree;
-- `str_pre`, `str_seg` and `str_segs` are used by four to eight rule packs and
-- by nothing a golden could see. Now both engines answer for them.
check_world("operators").
check_file("operators", "examples/checks/operators.rofl").

-- ===================================== THE DECISION PACK, ACTUALLY ASSEMBLED
-- `rules/decisions/production-readiness.rofl` and `examples/atlas-launch/`
-- were BOTH golden worlds and neither answered anything: the walk over
-- rules/ loads a pack beside the facts of its own name -- there are none --
-- and the walk over examples/ loads a directory's `.rofl` files and no rules.
-- So the pack sat with `undefined_premise[audit]` at 10 and the fixture sat
-- with no rule to read it, and both were green. A world is the two halves
-- together, and this is the only place that can say so.
check_world("readiness_atlas").
check_file("readiness_atlas", "rules/inquiry/ontology.rofl").
check_file("readiness_atlas", "rules/inquiry/terminology.rofl").
check_file("readiness_atlas", "rules/inquiry/epistemic.rofl").
check_file("readiness_atlas", "rules/inquiry/obligations.rofl").
check_file("readiness_atlas", "rules/inquiry/intents.rofl").
check_file("readiness_atlas", "rules/inquiry/perspectives.rofl").
check_file("readiness_atlas", "rules/policies/evidence.rofl").
check_file("readiness_atlas", "rules/policies/authority.rofl").
check_file("readiness_atlas", "rules/decisions/production-readiness.rofl").
check_file("readiness_atlas", "examples/atlas-launch/frame.rofl").
check_file("readiness_atlas", "examples/atlas-launch/context.rofl").
check_file("readiness_atlas", "examples/atlas-launch/evidence.rofl").

-- AND THE SAME PACK POINTED AT THIS TREE. examples/rofl-release/ is the release
-- question asked in the language it is about; the verdict is a golden, so it
-- moves when the tree does and the move is a diff.
check_world("readiness_rofl").
check_file("readiness_rofl", "rules/inquiry/ontology.rofl").
check_file("readiness_rofl", "rules/inquiry/terminology.rofl").
check_file("readiness_rofl", "rules/inquiry/epistemic.rofl").
check_file("readiness_rofl", "rules/inquiry/obligations.rofl").
check_file("readiness_rofl", "rules/inquiry/intents.rofl").
check_file("readiness_rofl", "rules/inquiry/perspectives.rofl").
check_file("readiness_rofl", "rules/policies/evidence.rofl").
check_file("readiness_rofl", "rules/policies/authority.rofl").
check_file("readiness_rofl", "rules/decisions/production-readiness.rofl").
check_file("readiness_rofl", "rules/decisions/public-release.rofl").
check_file("readiness_rofl", "examples/rofl-release/frame.rofl").
check_file("readiness_rofl", "examples/rofl-release/context.rofl").
check_file("readiness_rofl", "examples/rofl-release/evidence.rofl").

-- THE QUEUE WITH ITS SECOND VOLUME. rules_worklist pairs rules/worklist.rofl
-- with facts/worklist.rofl by name; facts/refactoring.rofl shares the
-- vocabulary and has no rules file of its own, so the world that reads both
-- is declared here.
check_world("refactoring_queue").
check_file("refactoring_queue", "facts/worklist.rofl").
check_file("refactoring_queue", "facts/refactoring.rofl").
check_file("refactoring_queue", "rules/worklist.rofl").

-- THE WORD `not` ON BOTH SIDES OF THE GRAMMAR. Free as an argument, reserved as
-- a relation name, and the two hosts disagreed about both halves until
-- 2026-09-12. Each is a one-file world because the second one must be REFUSED
-- and a refusal is not something a directory of examples can carry.
check_world("keyword_atom").
check_file("keyword_atom", "examples/checks/keyword-atom.rofl").

check_world("not_as_a_name").
check_file("not_as_a_name", "examples/checks/not-as-a-name.rofl").

-- THE SPECIFICATION, WHICH WAS IN NO WORLD AT ALL. `rules_spec-coverage` was
-- already golden and already green, and it held ZERO duties: the walker pairs
-- `rules/X.rofl` with `facts/X.rofl` by name, the specification is
-- `facts/spec.rofl`, and so every verdict in that pack was a negation over an
-- empty relation. The two books the verdicts are computed FROM cannot be
-- walked to by a world made of files -- which check exists in the tree, and
-- which citation still resolves -- so `scanners/spec.ts --write` writes them
-- down and `--check` refuses a stale copy.
check_world("spec_coverage").
check_file("spec_coverage", "rules/spec-coverage.rofl").
check_file("spec_coverage", "facts/spec.rofl").
check_file("spec_coverage", "facts/spec-census.rofl").

-- TWO THINGS WRITTEN DOWN SO THE LOADER CAN REFUSE THEM. A `prohibited` duty
-- has one mechanical form -- do the forbidden thing and require a no -- and
-- eleven of them had no check at all until 2026-09-12. `async_refused` is the
-- same form standing behind a LIMIT rather than a prohibition since
-- 2026-09-16: `@async` stopped being reserved syntax when the effects executor
-- stopped being planned, and the refusal is the whole of what LIMITS.md still
-- promises about it.
check_world("async_refused").
check_file("async_refused", "examples/checks/async-refused.rofl").

check_world("unstratifiable").
check_file("unstratifiable", "examples/checks/unstratifiable.rofl").

-- PROVENANCE, JOINED RATHER THAN PRINTED. The third prohibition a world can
-- carry: `Provenance as a log string` is refuted by joining a firing's rule
-- column against the program, which is something no string supports.
check_world("provenance_relational").
check_file("provenance_relational", "examples/checks/provenance-relational.rofl").

-- AN ARITY IN A PREMISE, which both engines read past until 2026-09-12. The
-- gate was built from crashes and a premise cannot crash a reader, so a
-- two-column `derived_by` loaded clean and matched nothing for ever.
check_world("premise_arity").
check_file("premise_arity", "examples/checks/premise-arity.rofl").

-- THE AGGREGATES LEDGER WITH THE REGISTRY AND THE FINDINGS BESIDE IT
-- (docs/aggregates.md, "Closing a cell"). A proof world for facts/agg.rofl is
-- declared here with `proves(World, agg, K, L)`, `proves_work(World, Item)`,
-- and for a strata cell `proves_refusal` or `proves_recursion`.
registry_file(checks).
check_world("agg_proofs").
check_file("agg_proofs", "facts/checks.rofl").
check_file("agg_proofs", "facts/findings.rofl").
check_file("agg_proofs", "facts/agg.rofl").
check_file("agg_proofs", "rules/agg.rofl").

-- A FACT THAT IS GIVEN AND ALSO DERIVED KEEPS ITS `derived_by` ROW ACROSS A
-- SECOND EVALUATION. Two files because the TypeScript host evaluates on every
-- load; the second file reads provenance and raises `provenance_lost` when the
-- row is gone. It is the defect the regenerated corpus showed on rules_agg,
-- and it lives in examples/checks/, which the corpus loads as the world
-- `checks`, so the Rust loop holds it too (tests/session.rs evaluates every
-- case twice). f_clear_derived_left_this_ticks_firings_on_the_facts_it_kept
check_world("agg_rederived_provenance").
check_file("agg_rederived_provenance", "examples/checks/agg-rederived-1-given.rofl").
check_file("agg_rederived_provenance", "examples/checks/agg-rederived-2-read.rofl").
proves_work("agg_rederived_provenance", w_agg_baseline).
proves_work("agg_rederived_provenance", w_agg_session_tests).

-- THE PLANTED FAULTS AGAINST THE ENGINE SOURCE AND THE LEDGER. The census is
-- written by `scripts/agg_breaks.ts --census --write` and `npm test` fails
-- when it is stale; the check raises an alarm for a switch break with no
-- `brk!` site, a site no break names, and a world `handled` closes a cell with
-- that no planted fault turns red. scripts/agg_mutants.ts plants each.
check_world("agg_breaks_census").
check_file("agg_breaks_census", "examples/checks/agg-breaks-census.rofl").
check_file("agg_breaks_census", "examples/checks/agg-breaks-census-check.rofl").
proves_work("agg_breaks_census", w_agg_fast_loop).

-- THE PROSE THAT SAID THERE IS NO AGGREGATION. A world cannot read a document,
-- so scripts/agg_prose.ts writes down, for each path w_agg_reconcile_docs owns
-- as a `contradiction_site`, every block that still says so and whether it
-- points at docs/aggregates.md; `npm test` fails when the census is stale, and
-- the check is red for a claim with no pointer. The same world holds the retire
-- column: the census says, for each workaround_site, whether the text that stood
-- in for an aggregate is still in the file (a workaround_marker of facts/agg.rofl),
-- and the check is red while one stands that the ledger does not keep.
check_world("agg_prose").
check_file("agg_prose", "examples/checks/agg-prose-census.rofl").
check_file("agg_prose", "examples/checks/agg-prose-check.rofl").
proves_work("agg_prose", w_agg_reconcile_docs).
proves_work("agg_prose", w_agg_retire_workarounds).
proves("agg_prose", agg, count, retire).
proves("agg_prose", agg, sum, retire).
proves("agg_prose", agg, min_max_strat, retire).
proves("agg_prose", agg, threshold, retire).
proves("agg_prose", agg, order_lattice, retire).
proves("agg_prose", agg, join_lattice, retire).
proves("agg_prose", agg, tag_idempotent, retire).
proves("agg_prose", agg, tag_counting, retire).
proves("agg_prose", agg, holistic, retire).

-- =============================================== THE AGGREGATE PROOF WORLDS
-- One world per cell of facts/agg.rofl that w_agg_cell_store and
-- w_agg_body_strat close, named `agg_<kind>_<column>`, each bound to its cell
-- by `proves` (docs/aggregates.md, "Closing a cell"). Every one is loaded
-- together (`check_opt(W, together, 1)`: its files load before it is
-- evaluated once, a fixture offered alone) and answered by both engines,
-- which reach one hash (w_agg_ts). A file whose first line is
-- `-- expect-refusal: <text>` must be refused with that text, by both.


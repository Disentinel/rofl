-- facts/agg.rofl — THE AGGREGATES PROGRAMME: rows, columns, verdicts, and the
-- work that owns every open cell. Design: docs/aggregates.md. Decision:
-- f_aggregation_is_one_cell_engine_with_two_syntaxes. Rules: rules/agg.rofl.
-- Seeded 2026-09-28 with every cell `not_yet` except the ones that do not
-- apply, each waived with a reason from a closed list.
--
-- READ THE QUEUE, DO NOT READ THIS FILE:
--     npm run repl -- facts/agg.rofl rules/agg.rofl
--     ? next_work[audit](W)                    what to take
--     ? owner[audit](agg, K, S, L, W)          whose cell this is
--     ? open_cell[audit](agg, K, S, L)         what is not done
--     ? unqueued[audit](agg, K, S, L)          work nobody owns (an alarm)
--     ? blocked[audit](W)                      what waits, on `work_needs`
--     ? verdict[audit](agg, K, L, V)           the matrix
--
-- ADDING TO IT. A row is `agg_kind(K).` plus `algebra_class(K, C).`; a column
-- is `obligation(L).`. `npm test` then goes red on `unqueued` for every cell
-- nobody owns, and the cells are owned with `claim(queued, agg, K, none, L, W)`
-- or waived with `ignored(agg, K, L, Reason)`. A column one item carries for
-- every row is `work_sweeps(W, L)`.
--
-- CLOSING A CELL is `handled(agg, K, L, "world")`, and the registry in
-- facts/checks.rofl must say `proves("world", agg, K, L)`; an item that owns
-- no cell closes by `work_proof(W, "world")` and `proves_work`. Taking a cell
-- off the queue as out_of_scope or budget_exhausted needs
-- `decided_not_work(agg, K, L, Finding)`. docs/aggregates.md says why.

-- ===========================================================================
-- ROWS — the aggregate kinds. The substrate is a row of its own because its
-- obligations (the witness record, the ⊕ that must not wrap, the tick staging)
-- are owned before any kind can use them.
agg_kind(cell).
agg_kind(count).
agg_kind(sum).
agg_kind(min_max_strat).
agg_kind(threshold).
agg_kind(order_lattice).
agg_kind(join_lattice).
agg_kind(widening).
agg_kind(tag_idempotent).
agg_kind(tag_counting).
agg_kind(holistic).
agg_kind(subsumption).
agg_kind(sugar).
agg_kind(empty_group).

agg_kind_note(cell, "the one cell engine: key -> value merged by ⊕, members, heights, PremRef::Cell naming an immutable sealed record that holds its seals, canonical order").
agg_kind_note(count, "`N is count(R : body)` — invertible, stratified, dedup by the projection tuple, Group witness").
agg_kind_note(sum, "`S is sum(V ; K : body)` — the projection key is mandatory, invertible, stratified, Group witness").
agg_kind_note(min_max_strat, "`M is min(V : body)`, max, and the boolean or / and (the idempotent total order on {false < true}) in a rule body — stratified, Best witness").
agg_kind_note(threshold, "`at_least(N, X : body)` — monotone, allowed in recursion, Quorum witness of exactly N members").
agg_kind_note(order_lattice, "`lattice dist(A, C, min D)`, max, or, and — recursive over a total order, Best witness").
agg_kind_note(join_lattice, "`lattice reach(X, union S)` — set union, interval hull, bitset or; recursive, Cover witness").
agg_kind_note(widening, "a join lattice of infinite height with a declared widening, forced after N improvements; Widened witness, the marker a hole").
agg_kind_note(tag_idempotent, "a semiring tag in the kernel whose ⊕ is idempotent (boolean, tropical): the cell keyed by the whole head, ⊗ through the body, recursion allowed").
agg_kind_note(tag_counting, "a semiring tag in the kernel whose ⊕ is not idempotent (counting, the support count): the cell keyed by the whole head, stratified, refused inside recursion").
agg_kind_note(holistic, "quantile, median, rank — stratified, dedup, the group recomputed; Group witness").
agg_kind_note(subsumption, "Souffle-style `p(A, B, D1) <= p(A, B, D2) :- D2 < D1.` — partial orders without a join, antichain cells, Pareto; Antichain witness").
agg_kind_note(sugar, "sentence form: at least / at most / exactly N, every, avg; lowered before the kernel sees it. avg is sum over count with a declared rounding and no row for an empty group (never a division by zero); every is count-equality over a domain bound from outside; at most / exactly N are non-monotone and refused inside recursion").
agg_kind_note(empty_group, "count/sum of a group with no members is 0 only when the group key is bound from outside: a negative claim, stratified only, witnessed by Sealed alone; min/max give no row").

-- why empty_group is a row of its own: docs/aggregates.md, "The matrix"

-- ===========================================================================
-- COLUMNS — what a kind owes before it is done.
obligation(syntax).
obligation(reflect).
obligation(strata).
obligation(safety).
obligation(eval_rust).
obligation(eval_ts).
obligation(witness).
obligation(why).
obligation(wfs).
obligation(ticks).
obligation(holes).
obligation(parity).
obligation(phrase).
obligation(incremental_ready).
obligation(demo).
obligation(retire).
obligation(shrug).

obligation_note(syntax, "the Rust parser (rofl_parse.rs), the TS parser and the ring 1 grammar all read it").
obligation_note(reflect, "rules as data: encode, canon, reify; the rule id identical in TS and Rust").
obligation_note(strata, "the aggregate premise is a dependency edge; peel_rounds, rules/strata.rofl, the recursion gate by algebra flag").
obligation_note(safety, "safety.rofl: the range-restriction slot kind, the projection key for non-idempotent kinds, monotone consumers of a recursive cell, one algebra per predicate; recompiled from src/kernel-dense.ts and re-signed into ROFL_KERNEL_HASH").
obligation_note(eval_rust, "rust/rofl evaluates it: plan_body, solve_body, the insert algorithm, fired once after its input round closes (its inner relations kept out of trigger_rels, never re-fired by semi-naive); record_prem (engine.rs:1054) no longer assumes prems[i] <-> body[i] once a premise is a variable-length Group").
obligation_note(eval_ts, "the TS engine evaluates it, best-effort at small scale").
obligation_note(witness, "the cell witness kind and its invariants: canonical at seal time, final-value premises only, well-founded by height, full storage").
obligation_note(why, "render_why and whynot explore it: PremRef::Cell, Sealed, digest display").
obligation_note(wfs, "the well-founded mode policy, first: refuse, with a diagnostic both engines agree on").
obligation_note(ticks, "@next staging of a cell value, retain_ticks pruning of its provenance").
obligation_note(holes, "overflow writes a hole and never wraps; a budget cut is a hole, not a smaller value; widening markers are holes").
obligation_note(parity, "TS and Rust canonical_state agree, pinned by facts/goldens.rofl").
obligation_note(phrase, "the sentence form reads and writes it").
obligation_note(incremental_ready, "stable contribution ids, algebra flags in the cell record, value-at-use premises: the next engine can maintain it").
obligation_note(demo, "an acceptance demo from the catalogue proves it by rofl alarms").
obligation_note(retire, "the workaround in the tree it replaces is gone").
obligation_note(shrug, "the answer model (docs/aggregates.md, Shrugs, as built): a literal holds, is unentailed, or is shrug(Target, Reason, Meta) with a reason shrug.rofl declares; the kind reading a shrug is a shrug inherited from its roots unless decided under every completion of the unknowns, each such decision documented; the rows are kernel data rules read").

-- ===========================================================================
-- THE ALGEBRA of each kind; it decides which world closes its strata cell
-- (rules/agg.rofl: `strata_without_refusal`, `strata_without_recursion`).
algebra_class(cell, none).
algebra_class(count, invertible).
algebra_class(sum, invertible).
algebra_class(min_max_strat, idempotent_order).
algebra_class(threshold, threshold).
algebra_class(order_lattice, idempotent_order).
algebra_class(join_lattice, idempotent_join).
algebra_class(widening, idempotent_join).
algebra_class(tag_idempotent, idempotent_semiring).
algebra_class(tag_counting, counting_semiring).
algebra_class(holistic, holistic).
algebra_class(subsumption, partial_order).
algebra_class(sugar, none).
algebra_class(empty_group, none).
-- the body form of min, max, or and and reads a closed relation; recursion
-- over the same algebra is order_lattice's declaration (rules/agg.rofl)
stratified_form(min_max_strat).

algebra_note(idempotent_order, "min, max, or, and: recursion yes, no dedup, Best witness").
algebra_note(idempotent_join, "set union, interval hull, bitset or: recursion yes, declared widening if the height is infinite, Cover witness").
algebra_note(invertible, "count, sum: stratified only, dedup by the projection tuple, Group witness, subtract on retraction").
algebra_note(holistic, "quantile, median, rank: stratified, dedup, recompute the group").
algebra_note(threshold, "at_least: monotone, recursion yes, Quorum witness of exactly N").
algebra_note(idempotent_semiring, "a tag whose ⊕ is idempotent (boolean, tropical): recursion yes").
algebra_note(counting_semiring, "a tag whose ⊕ is not idempotent (counting): stratified only").
algebra_note(partial_order, "subsumption: antichain cells, no join, Antichain witness").
algebra_note(none, "not an algebra: the substrate, or a row that lowers onto other rows").

-- ===========================================================================
-- WAIVERS. Each reason is scoped to its cells by `waiver_applies` in
-- rules/agg.rofl; a waiver outside its scope is `bad_waiver`.
ignored(agg, cell, syntax, no_surface).
ignored(agg, cell, phrase, no_surface).
ignored(agg, cell, retire, no_workaround).

ignored(agg, empty_group, syntax, no_own_syntax).
ignored(agg, empty_group, reflect, no_own_syntax).
ignored(agg, empty_group, retire, no_workaround).

ignored(agg, sugar, syntax, sentence_form_only).
ignored(agg, sugar, reflect, lowers_to_core).
ignored(agg, sugar, strata, lowers_to_core).
ignored(agg, sugar, witness, lowers_to_core).
ignored(agg, sugar, wfs, lowers_to_core).
ignored(agg, sugar, ticks, lowers_to_core).
ignored(agg, sugar, incremental_ready, lowers_to_core).
ignored(agg, sugar, retire, no_workaround).

ignored(agg, widening, retire, no_workaround).
ignored(agg, subsumption, retire, no_workaround).


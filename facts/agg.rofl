contradiction_site(w_agg_retire_workarounds, "examples/wtf/README.md", "v0 has no aggregation").
contradiction_site(w_agg_retire_workarounds, "examples/wtf/wtf.rofl", "the count is a fold; the walk is a key").
contradiction_site(w_agg_retire_workarounds, "examples/huh/README.md", "ranking is host-side sorting").

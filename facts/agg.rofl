-- ===========================================================================
-- THE WORK. Features before tests: the proof world of every cell belongs to
-- the item that owns the cell, and closing the cell names it.

-- the loop, and the substrate: the two things everything else waits on
work(w_agg_baseline, "regenerate facts/port-corpus (scripts/port_corpus.ts), which 4 lib tests and 2 tests/program.rs read, so the Rust loop can see a regression; done only with a work_proof world").
work_state(w_agg_baseline, done).
work_proof(w_agg_baseline, "agg_rederived_provenance").
work_spawned(w_agg_baseline, f_the_rust_tests_read_an_ungenerated_corpus_and_a_stale_one_alike).

work(w_agg_session_tests, "diagnose the 6 tests/session.rs failures (cause unknown); gates no feature, features come first; done only with a work_proof world").
work_state(w_agg_session_tests, done).
work_proof(w_agg_session_tests, "agg_rederived_provenance").
work_spawned(w_agg_session_tests, f_clear_derived_left_this_ticks_firings_on_the_facts_it_kept).

work(w_agg_fast_loop, "the loop in seconds and no check weaker: every planted fault of scripts/agg_breaks.ts a run-time switch in one `--features breaks` build, or a kernel or file edit loaded in place, run in parallel beside a no-break control; npm test and the ledger mutants over a worker pool; the `fast` cargo profile; runs selected by item, world, cell, file or git change; build.rs reads the tree it builds; done only with a work_proof world").
work_state(w_agg_fast_loop, done).
work_proof(w_agg_fast_loop, "agg_breaks_census").
work_spawned(w_agg_fast_loop, f_a_planted_fault_is_a_switch_in_one_build).
work_spawned(w_agg_fast_loop, f_a_build_script_compiled_in_one_tree_watched_that_tree).

work(w_agg_cell_store, "store.rs: cell identity (predicate, key), contributions with stable ids, value and height, PremRef::Cell(key, v_used) and PremRef::Sealed, canonical order; the insert algorithm").
work_state(w_agg_cell_store, done).
work_spawned(w_agg_cell_store, f_an_aggregate_premise_is_one_cell_premise).
work_spawned(w_agg_cell_store, f_cells_are_reflected_as_five_kernel_relations).

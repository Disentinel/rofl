contradiction_site(w_agg_reconcile_docs, "rules/worklist.rofl", "leverage is a boolean because the kernel has no aggregation").
contradiction_site(w_agg_retire_workarounds, "rules/js-dataflow.rofl", "seq_later: a maximum as the absence of a later element (and docs/js rendered from it)").
contradiction_site(w_agg_retire_workarounds, "examples/slop/README.md", "SUM is a chain because v0 has no aggregation").

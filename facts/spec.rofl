duty[readme](r_collects, guaranteed, "facts/deviations.rofl", "deviation(r_collects,").
duty[readme](r_stratum_in_kernel_source, guaranteed, "facts/deviations.rofl", "deviation(r_stratum_in_kernel_source,").
duty[readme](r_perspective_registration, guaranteed, "facts/deviations.rofl", "deviation(r_perspective_registration,").

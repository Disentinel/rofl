-- ======================================================= README.md [readme] ===
-- The deviation register START.md 128 demands. Twelve bullets; every one of
-- them is a sentence of the contract the kernel does NOT keep as written, and
-- six name the sentence they replace. This ledger is why `superseded` exists:
-- an obligation nobody owes any more is not an obligation with no test.

duty[readme](r_vocabulary_additions, guaranteed, "README.md", 237, "Vocabulary additions.").
duty[readme](r_conclusion_tense, guaranteed, "README.md", 243, "conclusion_tense").
duty[readme](r_flows_to, guaranteed, "README.md", 258, "the transitive closure of").
duty[readme](r_collects, guaranteed, "README.md", 275, "the collection graph").
duty[readme](r_stratum_in_kernel_source, guaranteed, "README.md", 299, "appear in kernel source").
duty[readme](r_perspective_registration, guaranteed, "README.md", 306, "Perspective registration.").
duty[readme](r_variable_perspectives, guaranteed, "README.md", 312, "Variable perspectives.").
duty[readme](r_moded_relations, guaranteed, "README.md", 323, "Moded (demand) relations.").
duty[readme](r_timeless_kernel_facts, guaranteed, "README.md", 332, "Timeless kernel facts.").
duty[readme](r_facts_into_reserved, guaranteed, "README.md", 339, "Facts may be asserted into reserved relations.").
duty[readme](r_edb_for_reserved, guaranteed, "README.md", 344, "for reserved relations.").
duty[readme](r_unstratifiable_is_budgeted, guaranteed, "README.md", 349, "Unstratifiable rejection is budget-mediated").
duty[readme](r_rounds_replace_strata, guaranteed, "README.md", 358, "Rounds replace the stratum table").

-- ======================================================= boot.rofl [boot] ===
-- The meta-kernel's own required results, stated in a comment block at the
-- foot of the file it governs. Seven assertions; START.md's Appendix A had
-- four, and the three added since are the interesting half.

duty[boot](b_malformed_empty, guaranteed, "boot.rofl", 154, "malformed[audit](R)").
duty[boot](b_breach_empty, guaranteed, "boot.rofl", 154, "breach[audit](R)").
duty[boot](b_leak_empty, guaranteed, "boot.rofl", 155, "leak[audit](A,B)").
duty[boot](b_forged_empty, guaranteed, "boot.rofl", 155, "forged[audit](F)").
duty[boot](b_unmoded_empty, guaranteed, "boot.rofl", 156, "unmoded[audit](R)").
duty[boot](b_collected_declared_only, guaranteed, "boot.rofl", 157, "collected[audit](X)").
duty[boot](b_undefined_premise_empty, guaranteed, "boot.rofl", 158, "undefined_premise[audit](R, Rel)").
duty[boot](b_whynot_finite, guaranteed, "boot.rofl", 159, "whynot flows_to(red, blue)").
duty[boot](b_stratifiable_by_loading, guaranteed, "boot.rofl", 163, "answered by the file LOADING AT ALL").

-- TWO REQUIRED RESULTS WERE WITHDRAWN, not merely re-anchored, and the
-- difference is the reason this ledger exists. `? unstratified(X) -> empty`
-- and `whynot unstratified(reach) -> finite demonstration via dep/reach` are
-- not sentences that moved: the ten rules that answered them left boot.rofl
-- when the evaluator started peeling its schedule off the decoded rules, and
-- the relation they were about does not exist. Re-anchoring either of them to
-- the paragraph that explains their removal would have made the model say the
-- obligation still stands and is still cited, which is the flattering lie the
-- `unfounded` audit exists to catch — so both were deleted and replaced:
--   `b_stratifiable_by_loading` is what answers the first question now (a
--   program whose peel stalls is refused before a query is possible, so the
--   file loading IS the answer), and
--   `b_whynot_finite` keeps its id and its meaning — a finite failure
--   demonstration through a RECURSIVE relation — asked of `flows_to`, the
--   transitive closure boot.rofl still carries.
-- `b_forged_empty` and `b_unmoded_empty` are new for a duller reason: the
-- required-results list always ran those audits and never listed them.


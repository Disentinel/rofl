cited_check[map](c_asserted_who_and_when, "test/asserted-tick.test.ts", "two authors of the same fact keep who and when together").

cited_check[map](c_persp_var_same_ledger, "test/persp-var.test.ts", "a rule that reads and writes the SAME ledger variable is not a leak").
cited_check[map](c_flow_closure, "test/flow-closure.test.ts", "the closure ADDS the walk and does not swallow the direct crossing").
cited_check[map](c_collects_narrow, "test/flow-closure.test.ts", "the declaration licenses the gather and does NOT license the named walk").
cited_check[map](c_collects_askable, "test/flow-closure.test.ts", "the licence can be ASKED about: `why` names the declaration and its author").

cited_check[map](c_firing_counts_once, "test/firing-signature.test.ts", "a demand-backed derivation counts once, as its range-restricted twin does").
cited_check[map](c_firing_two_stay_two, "test/firing-signature.test.ts", "two derivations that differ only in bound values stay two").
cited_check[map](c_shuffled_arrival_cost, "test/index-arrival.test.ts", "shuffled arrival costs about what ascending arrival costs").
cited_check[map](c_arith_zero_divisor, "test/arith-hole.test.ts", "a zero divisor is its own reason, and the other rows still derive").
cited_check[map](c_wf_three_values, "test/well-founded.test.ts", "three values in ONE store: true, false, and undefined are all distinguishable").
cited_check[map](c_wf_budget_no_unknown, "test/well-founded.test.ts", "a run cut short is a hole, and claims no unknowns at all").
cited_check[map](c_wf_stratum_untouched, "test/well-founded.test.ts", "stratum is not computed under the alternation, and the peel still answers").
cited_check[map](c_wf_demand_refused, "test/well-founded.test.ts", "a demand-backed relation is refused rather than silently assumed").

cited_check[map](c_text_reviewable, "test/text-check.test.ts", "every tracked source file is reviewable text").

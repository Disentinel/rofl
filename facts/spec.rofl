-- facts/spec.rofl — the kernel's obligations, as facts.
--
-- Six documents, six ledgers. A ledger is a book with a nameable list of
-- writers (docs/choosing-perspectives.md), and these six qualify for the
-- reason that discipline gives: contradictory entries coexist in them
-- LEGALLY and neither is an error. `duty[limits](l_frozen_never_gc, ...)`
-- says provenance is never collected; `duty[decided](d_retain_ticks, ...)`
-- says a window may drop it. Both sentences are really in the tree. Filing
-- them in one book would make the pair a defect to be resolved; filing them
-- in two makes it an amendment to be recorded, which is what it is.
--
-- The librarian is the transcriber, not the author, so `authority` is not
-- what keeps this honest — every ledger has the same single writer. What
-- keeps it honest is that a duty carries its citation in the same fact and
-- `scanners/spec.ts` reads the cited line: an entry nobody can trace to a
-- line surfaces as `unfounded[coverage]`. Discipline: rules/spec-coverage.rofl.

authority(main, librarian).
authority(spec, librarian).
authority(limits, librarian).
authority(boot, librarian).
authority(readme, librarian).
authority(decided, librarian).
authority(perf, librarian).
authority(wfs, librarian).
authority(map, librarian).
authority(checks, census).

-- @who librarian

-- ======================================================= START.md [spec] ===
-- The contract. Kinds: `guaranteed` (the kernel must do this), `prohibited`
-- (§7, each voids acceptance), `acceptance` (§5, a criterion with a test
-- named in the spec itself), `done` (§6, a deliverable).

duty[spec](s_semantics_as_data, guaranteed, "START.md", 7, "live in the graph as data").
duty[spec](s_zero_deps, guaranteed, "START.md", 5, "zero runtime dependencies").
duty[spec](s_two_runtimes, guaranteed, "START.md", 5, "runs under Bun or Node").

duty[spec](s_budgets_are_semantics, guaranteed, "START.md", 13, "budgets are part of the semantics, not a safety net").
duty[spec](s_structured_terms, guaranteed, "START.md", 36, "are required").
duty[spec](s_document_no_occurs_check, done, "START.md", 36, "document the omission").
duty[spec](s_whynot_is_abduction, guaranteed, "START.md", 49, "it names the unbound premise").

duty[spec](s_grammar_temporal, guaranteed, "START.md", 26, "temporal   :=").
duty[spec](s_appendix_dep_edges, guaranteed, "START.md", 160, "dep(A, B)          :- concludes(R, A), premise_pos(R, B).").
duty[spec](s_appendix_leak, guaranteed, "START.md", 180, "leak[audit](A, B)     :- flow(A, B), not sees(B, A), not bridge_decl(R, A, B).").
duty[spec](s_vocabulary_closed, guaranteed, "START.md", 55, "This list is closed").
duty[spec](s_reserved_rejected_at_load, guaranteed, "START.md", 69, "is rejected at load with a diagnostic").

duty[spec](s_main_is_named, guaranteed, "START.md", 76, "which is *named*, not implied").
duty[spec](s_reads_only_what_it_sees, guaranteed, "START.md", 76, "may only match facts in perspectives it").
duty[spec](s_no_silent_crossing, guaranteed, "START.md", 76, "no silent crossing").
duty[spec](s_sees_computed_by_boot, guaranteed, "START.md", 76, "computed by boot rules, not by the kernel").

duty[spec](s_no_stratification_checker, guaranteed, "START.md", 79, "The kernel does not contain a stratification checker").
duty[spec](s_strata_read_from_facts, guaranteed, "START.md", 79, "read from derived facts").
duty[spec](s_reject_unstratified, guaranteed, "START.md", 79, "reject the program with the reach-trace as diagnostic").

duty[spec](s_init_at_tick_zero, guaranteed, "START.md", 82, "facts exist at tick 0 only").
duty[spec](s_persistence_is_a_rule, guaranteed, "START.md", 82, "Persistence is not a storage property").
duty[spec](s_async_reserved_rejected, prohibited, "START.md", 82, "reserved syntax").

duty[spec](s_determinism, guaranteed, "START.md", 85, "regardless of insertion order").
duty[spec](s_canonical_order, guaranteed, "START.md", 85, "lexicographic order of their canonical serialization").

duty[spec](s_provenance_per_firing, guaranteed, "START.md", 88, "On every successful rule firing the kernel emits").
duty[spec](s_witness_is_first_canonical, guaranteed, "START.md", 88, "first derivation in canonical order").
duty[spec](s_excise_not_from_witness, guaranteed, "START.md", 88, "must NOT be computed from witnesses").

duty[spec](s_budget_emits_hole, guaranteed, "START.md", 91, "returns the partial result marked partial").
duty[spec](s_never_hang, prohibited, "START.md", 91, "a kernel that hangs instead of emitting").

duty[spec](s_report_loc_overrun, done, "START.md", 107, "report it rather than pushing through").
duty[spec](s_rules_are_subgraphs, guaranteed, "START.md", 109, "every rule is stored as a subgraph").
duty[spec](s_evaluator_reads_store, guaranteed, "START.md", 109, "the evaluator reads rules only from the store").

-- §5, the phase acceptance criteria. These are the obligations the spec
-- itself paired with a test, and they are here as the POSITIVE CONTROL for
-- the coverage rules: a model in which nothing comes out covered would be
-- as useless as one in which everything does.
duty[spec](s_a_transitive_closure, acceptance, "START.md", 115, "transitive-closure program derives correct closure").
duty[spec](s_a_structured_term_test, acceptance, "START.md", 115, "structured-term test (list append via terms) passes").

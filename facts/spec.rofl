-- facts/spec.rofl — the kernel's obligations, as facts.
--
-- Six documents, six ledgers. A ledger is a book with a nameable list of
-- writers (docs/choosing-perspectives.md), and these six qualify for the
-- reason that discipline gives: contradictory entries coexist in them
-- LEGALLY and neither is an error. `duty[limits](l_frozen_never_gc, ...)`
-- says provenance is never collected; `duty[decided](d_retain_ticks, ...)`
-- says a window may drop it. Both sentences are really in the tree. Filing
-- them in one book would make the pair a defect to be resolved; filing them
-- in two makes it an amendment to be recorded, which is what it is.
--
-- The librarian is the transcriber, not the author, so `authority` is not
-- what keeps this honest — every ledger has the same single writer. What
-- keeps it honest is that a duty carries its citation in the same fact and
-- `scanners/spec.ts` reads the cited line: an entry nobody can trace to a
-- line surfaces as `unfounded[coverage]`. Discipline: rules/spec-coverage.rofl.

authority(main, librarian).
authority(spec, librarian).
authority(limits, librarian).
authority(boot, librarian).
authority(readme, librarian).
authority(decided, librarian).
authority(perf, librarian).
authority(wfs, librarian).
authority(map, librarian).
authority(checks, census).

-- @who librarian

-- ======================================================= START.md [spec] ===
-- The contract. Kinds: `guaranteed` (the kernel must do this), `prohibited`
-- (§7, each voids acceptance), `acceptance` (§5, a criterion with a test
-- named in the spec itself), `done` (§6, a deliverable).

duty[spec](s_semantics_as_data, guaranteed, "START.md", "live in the graph as data").
duty[spec](s_zero_deps, guaranteed, "START.md", "zero runtime dependencies").
duty[spec](s_two_runtimes, guaranteed, "START.md", "runs under Bun or Node").

duty[spec](s_budgets_are_semantics, guaranteed, "START.md", "budgets are part of the semantics, not a safety net").
duty[spec](s_structured_terms, guaranteed, "START.md", "are required").
duty[spec](s_document_no_occurs_check, done, "START.md", "document the omission").
duty[spec](s_whynot_is_abduction, guaranteed, "START.md", "it names the unbound premise").

duty[spec](s_grammar_temporal, guaranteed, "START.md", "temporal   :=").
duty[spec](s_appendix_dep_edges, guaranteed, "START.md", "dep(A, B)          :- concludes(R, A), premise_pos(R, B).").
duty[spec](s_appendix_leak, guaranteed, "START.md", "leak[audit](A, B)     :- flow(A, B), not sees(B, A), not bridge_decl(R, A, B).").
duty[spec](s_vocabulary_closed, guaranteed, "START.md", "This list is closed").
duty[spec](s_reserved_rejected_at_load, guaranteed, "START.md", "is rejected at load with a diagnostic").

duty[spec](s_main_is_named, guaranteed, "START.md", "which is *named*, not implied").
duty[spec](s_reads_only_what_it_sees, guaranteed, "START.md", "may only match facts in perspectives it").
duty[spec](s_no_silent_crossing, guaranteed, "START.md", "no silent crossing").
duty[spec](s_sees_computed_by_boot, guaranteed, "START.md", "computed by boot rules, not by the kernel").

duty[spec](s_no_stratification_checker, guaranteed, "START.md", "The kernel does not contain a stratification checker").
duty[spec](s_strata_read_from_facts, guaranteed, "START.md", "read from derived facts").
duty[spec](s_reject_unstratified, guaranteed, "START.md", "reject the program with the reach-trace as diagnostic").

duty[spec](s_init_at_tick_zero, guaranteed, "START.md", "facts exist at tick 0 only").
duty[spec](s_persistence_is_a_rule, guaranteed, "START.md", "Persistence is not a storage property").
duty[spec](s_async_reserved_rejected, prohibited, "START.md", "reserved syntax").

duty[spec](s_determinism, guaranteed, "START.md", "regardless of insertion order").
duty[spec](s_canonical_order, guaranteed, "START.md", "lexicographic order of their canonical serialization").

duty[spec](s_provenance_per_firing, guaranteed, "START.md", "On every successful rule firing the kernel emits").
duty[spec](s_witness_is_first_canonical, guaranteed, "START.md", "first derivation in canonical order").
duty[spec](s_excise_not_from_witness, guaranteed, "START.md", "must NOT be computed from witnesses").

duty[spec](s_budget_emits_hole, guaranteed, "START.md", "returns the partial result marked partial").
duty[spec](s_never_hang, prohibited, "START.md", "a kernel that hangs instead of emitting").

duty[spec](s_report_loc_overrun, done, "START.md", "report it rather than pushing through").
duty[spec](s_rules_are_subgraphs, guaranteed, "START.md", "every rule is stored as a subgraph").
duty[spec](s_evaluator_reads_store, guaranteed, "START.md", "the evaluator reads rules only from the store").

-- §5, the phase acceptance criteria. These are the obligations the spec
-- itself paired with a test, and they are here as the POSITIVE CONTROL for
-- the coverage rules: a model in which nothing comes out covered would be
-- as useless as one in which everything does.
duty[spec](s_a_transitive_closure, acceptance, "START.md", "transitive-closure program derives correct closure").
duty[spec](s_a_structured_term_test, acceptance, "START.md", "structured-term test (list append via terms) passes").
duty[spec](s_a_naive_eq_seminaive, acceptance, "START.md", "differential test: naive").
duty[spec](s_a_why_tree, acceptance, "START.md", "returns a derivation tree ending in EDB facts").
duty[spec](s_a_perspective_isolation, acceptance, "START.md", "a rule reading a perspective it cannot see matches nothing").
duty[spec](s_a_stratum_order, acceptance, "START.md", "negation executes in stratum order").
duty[spec](s_a_kernel_grep, acceptance, "START.md", "no relation name outside").
duty[spec](s_a_runtime_rule, acceptance, "START.md", "starts deriving without restart or reload").
duty[spec](s_a_malformed_sibling, acceptance, "START.md", "is condemned by its sibling rule").
duty[spec](s_a_round_trip, acceptance, "START.md", "round-trip test from").
duty[spec](s_a_counter, acceptance, "START.md", "counter.rofl runs").
duty[spec](s_a_replay_shuffled, acceptance, "START.md", "bit-identical states across 100 runs with shuffled insertion order").
duty[spec](s_a_busy_beaver, acceptance, "START.md", "executes a 3-state busy beaver to halt under budget").
duty[spec](s_a_diverging_hole, acceptance, "START.md", "a diverging variant yields").
duty[spec](s_a_boot_audits_empty, acceptance, "START.md", "all four audit queries return empty").
duty[spec](s_a_sensors_scenario, acceptance, "START.md", "full scenario passes").

-- §6, definition of done.
duty[spec](s_done_ci_green, done, "START.md", "criteria green in CI").
duty[spec](s_done_readme, done, "START.md", "a paragraph on every place where you deviated").
duty[spec](s_done_limits, done, "START.md", "honestly listing what v0 does not do").

-- §7, the prohibited shortcuts. Each voids acceptance.
duty[spec](s7_no_hardcoded_boot, prohibited, "START.md", "Hardcoding any boot.rofl rule").
duty[spec](s7_no_clause_objects, prohibited, "START.md", "Evaluator reading parsed clause objects").
duty[spec](s7_no_log_provenance, prohibited, "START.md", "Provenance as a log string").
duty[spec](s7_no_witness_excise, prohibited, "START.md", "Excise computed from stored witnesses").
duty[spec](s7_no_nondeterministic_iteration, prohibited, "START.md", "Nondeterministic iteration").
duty[spec](s7_no_silent_overrun, prohibited, "START.md", "Silently completing a budgeted query past its budget").
duty[spec](s7_no_skipping_reject_path, prohibited, "START.md", "Skipping the stratification reject path").
duty[spec](s7_no_pretend_async, prohibited, "START.md", "as implemented instead of explicitly rejected").

-- §8, out of scope.
duty[spec](s8_out_of_scope, prohibited, "START.md", "aggregation, GPU anything, persistence layers, optimization passes, syntax sugar").

-- ====================================================== LIMITS.md [limits] ===

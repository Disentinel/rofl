duty[spec](s7_no_skipping_reject_path, prohibited, "START.md", 139, "Skipping the stratification reject path").
duty[spec](s7_no_pretend_async, prohibited, "START.md", 140, "as implemented instead of explicitly rejected").

-- §8, out of scope.
duty[spec](s8_out_of_scope, prohibited, "START.md", 144, "aggregation, GPU anything, persistence layers, optimization passes, syntax sugar").

-- ====================================================== LIMITS.md [limits] ===
-- What v0 deliberately does NOT do. Nineteen bullets; four of them state
-- several separately-checkable claims and are split here, because one named
-- test against a twenty-line bullet would mark the whole bullet covered and
-- that is exactly the generosity this model exists to avoid.

duty[limits](l_no_async, limit, "LIMITS.md", 6, "No `@async`").
duty[limits](l_no_incremental_maintenance, limit, "LIMITS.md", 9, "No delta is ever propagated into a").
duty[limits](l_reuse_fingerprint, limit, "LIMITS.md", 14, "The derived layer is reused per relation, under an exact fingerprint").

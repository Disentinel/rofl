duty[readme](r_optimizations_exist, guaranteed, "facts/deviations.rofl", "deviation(r_optimizations_exist,").
duty[readme](r_vocabulary_additions, guaranteed, "facts/deviations.rofl", "deviation(r_vocabulary_additions,").

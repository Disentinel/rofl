-- several separately-checkable claims and are split here, because one named
-- test against a twenty-line bullet would mark the whole bullet covered and
-- that is exactly the generosity this model exists to avoid.

duty[limits](l_no_async, limit, "LIMITS.md", "No `@async`").
duty[limits](l_no_incremental_maintenance, limit, "LIMITS.md", "No delta is ever propagated into a").
duty[limits](l_reuse_fingerprint, limit, "LIMITS.md", "The derived layer is reused per relation, under an exact fingerprint").
duty[limits](l_reuse_a_no_read_reused, limit, "LIMITS.md", "may not read one it reuses").
duty[limits](l_reuse_b_stratum_gate, limit, "LIMITS.md", "SCHEDULE is an input to every derivation").
duty[limits](l_reuse_c_tick_boundary, limit, "LIMITS.md", "evaluation reuses nothing").
duty[limits](l_reuse_switchable, limit, "LIMITS.md", "Reuse can be switched off").
duty[limits](l_no_multi_fact_abduction, limit, "LIMITS.md", "Every level of `whynot` is single-step").
duty[limits](l_whynot_recurses, limit, "LIMITS.md", "It does now recurse *into* each failing premise").
duty[limits](l_no_occurs_check, limit, "LIMITS.md", "No occurs-check").
duty[limits](l_no_persistence, limit, "LIMITS.md", "No persistence beyond store serialization").
duty[limits](l_partial_strata, limit, "LIMITS.md", "Stratum inference is data-driven and can be partial").
duty[limits](l_unchecked_without_boot, limit, "LIMITS.md", "negation is").
duty[limits](l_demand_premise_order, limit, "LIMITS.md", "Rules that are not range-restricted").
duty[limits](l_demand_depth_512, limit, "LIMITS.md", "Recursion depth through demand rules is capped at").
duty[limits](l_demand_no_enumeration, limit, "LIMITS.md", "with all arguments unbound cannot").
duty[limits](l_queries_are_god_view, limit, "LIMITS.md", "Queries are god-view").
duty[limits](l_budget_counts_firings, limit, "LIMITS.md", "Budgets count distinct firings + demand nodes").
duty[limits](l_no_floats_no_bignums, limit, "LIMITS.md", "No floats, no bignums").
duty[limits](l_zero_divisor_fails, limit, "LIMITS.md", "division/modulo by zero simply fails the builtin premise").
duty[limits](l_comparisons_need_ground_ints, limit, "LIMITS.md", "builtins require ground integer operands").
duty[limits](l_reflection_in_main, limit, "LIMITS.md", "Reflection facts live in").
duty[limits](l_asserted_by_needs_who, limit, "LIMITS.md", "assert provides a").
duty[limits](l_retraction_leaves_no_trail, limit, "LIMITS.md", "a retraction removes the trail rows outright").
duty[limits](l_init_after_zero_inert, limit, "LIMITS.md", "after tick 0 is inert").
duty[limits](l_next_not_assertable, limit, "LIMITS.md", "are not assertable directly").
duty[limits](l_frozen_never_collected, limit, "LIMITS.md", "Frozen provenance is never garbage-collected").
duty[limits](l_undefined_is_a_dictionary, limit, "LIMITS.md", "a dictionary check, not a coverage check").
duty[limits](l_undefined_silent_on_negation, limit, "LIMITS.md", "nothing about negated").
duty[limits](l_undefined_silenced_by_one_fact, limit, "LIMITS.md", "one stray fact of the right name silences the audit").
duty[limits](l_no_aggregation, limit, "LIMITS.md", "No aggregation, no optimization passes, no syntax sugar, no GPU anything").

-- DECIDED 2026-09-10, after the two library surfaces were compared for the
-- first time: ten of the port's fourteen public methods have no counterpart
-- here, and the residency family is the half of that which is deliberate.
duty[limits](l_no_residency_in_js, limit, "LIMITS.md", "No residency in the JavaScript host").


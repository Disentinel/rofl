-- facts/surface-lint.rofl — THE REGISTER OF THE SURFACE LINT: the columns that name another file, and
-- the cross-file joins the JS model still keeps. Rules: examples/surface/surface.rofl. Design:
-- docs/surface-split.md, item 3.
--
-- The seeds. A column that holds a node or a path of ANOTHER file by construction: module resolution
-- (a site and the file it names) and the call edge (a site and the callee's node). Everything else that
-- is foreign-capable is derived from these through the rules' own heads.
xl_seed(module_target, 2).
xl_seed(resolved_import, 2).
xl_seed(ts_resolved, 2).
xl_seed(resolves, 2).
xl_seed(calls, 2).

-- The [surface] columns that hand over a node of ANOTHER file than the row's key (rules/js-surface.rofl): what a
-- module offers, a return's, an argument's, a thrown or a sent value, the value of an escaping node and of its
-- members, a function's callees. A key column is the key's own file and is not seeded: a mirror puts the rows of a
-- foreign key back into their relation, which is what makes a mirrored relation readable at a foreign key.
xl_seed(sx_export_node, 3).
xl_seed(sx_export_val, 3).
xl_seed(sx_default, 2).
xl_seed(sx_cjs, 2).
xl_seed(sx_module, 2).
xl_seed(sx_ret_node, 2).
xl_seed(sx_ret_pnode, 2).
xl_seed(sx_arg_node, 3).
xl_seed(sx_next, 2).
xl_seed(sx_thrown, 2).
xl_seed(sx_node, 2).
xl_seed(sx_member, 3).
xl_seed(sx_mplain, 3).
xl_seed(sx_mstatic, 3).
xl_seed(sx_mproto, 3).
xl_seed(sx_eff_calls, 2).
xl_seed(sx_elem, 3).
xl_seed(sx_yields, 2).
xl_seed(sx_ctor, 2).
xl_seed(sx_ctor_of, 2).
xl_seed(sx_accessor, 3).
xl_seed(sx_eff_reaches, 2).
xl_seed(sx_field_runs, 4).
xl_seed(sx_keyed_runs, 2).
xl_seed(sx_drop_runs, 2).
xl_seed(sx_sub_inst, 2).

-- THE REGISTER, after the rewrite (rules/js-surface.rofl; the baseline of 2026-10-05 had 214 rows `awaiting_rewrite`,
-- all gone with their joins). What stays is read at a foreign-capable column the rule only MATCHES: the row the
-- premise needs is in the volume of the file it names, and scripts/surface_split.ts checks that it is there.

-- A member's own attribute. `member_value`'s third column is foreign only for a value another file WROTE onto the
-- object (`sx_mwrite`), and a written value is an expression: it has no `static` and no `get`/`set` kind, so the
-- attribute these read is the declaring file's own method or field.
xl_ok(accessor_as, ast_attr, "a member's own attribute: a value written from another file carries no kind").
xl_ok(accessor_recv, accessor_obj, "the receiver may be an object of another file, as accessor_read read it through accessor_of before it was split").
xl_ok(class_member_proto, static, "a member's own mark: a value written from another file carries no static flag").
xl_ok(class_member_proto, class_method, "a member's own kind: a value written from another file is no method of the class").
xl_ok(class_member_static, static, "a member's own mark: a value written from another file carries no static flag").

-- The key is matched, not read: `nearest_fn(F, C)` is the enclosing function of the volume's own site C, and the
-- rule only asks whether another file's callee G reaches back to it (`eff_reaches(G, F)`, mirrored for G).
xl_ok(eff_here, nearest_fn, "the site's own enclosing function, matched against the mirrored eff_reaches of the callee").
-- A Map field's order (rules/js-dataflow.rofl 7c) asks the same of its own method M: does a call between a delete and a
-- read reach M back (`eff_reaches(G, M)`, mirrored for G), and was M's instance or a function that runs it handed to code
-- outside the model. M, its instance and those functions are the volume's own nodes, matched; where another file hands
-- one on, it left the file, and `sx_esc` says so in the arm beside.
xl_ok(keyed_noisy, keyed_again, "the read's own method, matched against the mirrored eff_reaches of the callee").
-- A get's presence (section 7c) reads the removals of its own collection in its own file only (`keyed_drop` matches the
-- file); where the collection left the file (`sx_esc`), a call between that reaches another file loses the entry.
xl_ok(keyed_drop, keyed_made, "the collection's own new node, matched, and the removal in the same file").
xl_ok(keyed_lost, keyed_made, "the collection's own new node, matched against what was handed out").
xl_ok(keyed_leaves, at, "the test that a callee is NOT of the read's file: true alike in the volume and the whole").
xl_ok(keyed_lost, nearest_v, "the function around a removal of the same file, matched").
-- How often the method runs, for an `await` between: its known calls and their callers in the volume. A call from another
-- file means the function or its instance left the file (`sx_esc`, read by keyed_handed), and that alone makes it many.
xl_ok(keyed_called_at, keyed_once_need, "the volume's own function, matched against its calls; a caller in another file means sx_esc").
xl_ok(keyed_unknown_call, keyed_once_need, "the volume's own function, matched; a caller in another file means sx_esc").
xl_ok(keyed_overlap, keyed_once_need, "the volume's own function, matched; a caller in another file means sx_esc").
xl_ok(keyed_many, keyed_caller, "the enclosing function of the volume's own call of the function, matched; a caller in another file means sx_esc").
xl_ok(keyed_overlap, keyed_caller, "the enclosing function of the volume's own call of the function, matched; a caller in another file means sx_esc").
-- Presence through a call that puts for certain (`keyed_sure`) follows only a callee of the call's own file
-- (`keyed_local_call` matches the file): a function of another file reaches the collection only where it left its file,
-- and there `keyed_lost` holds. The callee, the collection it fills and the put are then the volume's own nodes.
xl_ok(keyed_local_call, at, "the test that a callee IS of the call's file: true alike in the volume and the whole").
xl_ok(keyed_one_target, async, "a callee of the call's own file (keyed_local_call)").
xl_ok(keyed_one_target, generator, "a callee of the call's own file (keyed_local_call)").
xl_ok(keyed_one_target, private_method, "a callee of the call's own file (keyed_local_call)").
xl_ok(keyed_one_target, class_method_of, "a callee of the call's own file (keyed_local_call)").
xl_ok(keyed_sure_at, keyed_sure, "a callee of the call's own file (keyed_one_target)").
xl_ok(keyed_fill_call, keyed_sure, "a callee of the call's own file (keyed_one_target)").
xl_ok(keyed_ctor_put, keyed_sure, "a callee of the call's own file (keyed_one_target)").
xl_ok(keyed_sure, keyed_g_drops, "the collection a function of its own file fills (keyed_hop_fn)").
xl_ok(keyed_fill_call, keyed_call, "the collection a function of the read's file fills, matched against the read").
xl_ok(keyed_fill_call, keyed_read_site, "the collection a function of the read's file fills, matched against the read").
xl_ok(keyed_ctor_put, keyed_call, "the collection a function of the read's file fills, matched against the read").
xl_ok(keyed_ctor_put, keyed_born, "the collection a function of the read's file fills, matched against the read").
xl_ok(keyed_ctor_put, keyed_shared, "the collection a function of the read's file fills, matched against the read").
xl_ok(keyed_fill, keyed_key, "a put of a function of the read's file").
xl_ok(keyed_fill_ctor, keyed_key, "a put of a function of the read's file").
xl_ok(keyed_g_drops, nearest_v, "the function around a removal of the collection's own file, matched against the mirrored eff_reaches").
xl_ok(keyed_lost_ctor, ast_child, "the read's own method, bound by its body").
xl_ok(keyed_lost_ctor, keyed_made, "the collection's own new node, matched against what was handed out").
xl_ok(keyed_heal_at, keyed_key, "a put of a function of the read's file").
xl_ok(keyed_heal_at, keyed_read_site, "the collection a function of the read's file fills, matched against the read").
xl_ok(keyed_heal_broken, keyed_heal_fn, "the read's own function, matched").
-- What an object literal lacks is read only where the literal and the read share a file (`member_unset` matches the
-- file): the negation over another file's keys would close a cycle with the flow that carries the object.
xl_ok(member_unset, ast_node, "the test that the literal IS of the read's file: true alike in the volume and the whole").
xl_ok(member_unset, obj_open_own, "a literal of the read's own file (the ast_node file match)").
xl_ok(member_unset, obj_own_key, "a literal of the read's own file (the ast_node file match)").
-- eff_reaches is foreign-capable at both ends (the rings of js-effects): a runner of a method is matched against the
-- method's own class and file, and one in another file means the instance or function left it (`sx_esc`).
-- A write onto an object (rules/js-dataflow.rofl): a field's constructor is read in the class's file and published
-- with it (`sx_field_sure`, `sx_field_runs`); a `const` literal's writes are read where the literal and the read share
-- a file.
xl_ok(member_const_read, member_const_set, "a literal of the read's own file (member_unset matches the file)").
xl_ok(member_ctor_late, member_read_fn, "the read's own function, matched against the mirrored eff_reaches of what runs before the write").
-- What a call may run is asked backwards along the call graph (keyed_runs_m, keyed_drop_runs, keyed_runs_out), and a
-- function of another file brings its answer with it (sx_keyed_runs, sx_drop_runs, sx_runs_out).
xl_ok(keyed_handed, keyed_hand_need, "the volume's own instance or function, matched; one another file hands on is sx_esc").
xl_ok(keyed_crosses, at, "the test that a callee is NOT of the caller's file: true alike in the volume and the whole").
xl_ok(keyed_crosses, keyed_crosses, "a callee of another file makes the caller cross by the arm beside, so its own answer adds nothing").
xl_ok(keyed_leaves, keyed_crosses, "a callee of the read's own file (the ast_node file match)").
xl_ok(keyed_dsure_at, keyed_dsure, "a callee of the call's own file (keyed_one_target)").
xl_ok(keyed_vsure_out, keyed_dsure, "a callee of the call's own file (keyed_one_target)").
xl_ok(keyed_vsure_out, keyed_dsure_key, "a removal of the collection's own file (keyed_drop matches the file)").
xl_ok(keyed_vsure_out, keyed_read_site, "the collection a function of the read's file empties, matched against the read").
xl_ok(keyed_vdrop_may, nearest_v, "the function around a removal of the collection's own file, matched").
-- `this` in a parent's method may be a subclass's instance: the subclass's file tells the parent's (`sx_sub_inst`), each
-- file forwarding it one `extends` up, and the parent's file reads its own methods.
xl_ok(sub_inst, super_of, "a parent of another file forwards the instance itself, through sx_sub_inst").
xl_ok(may_be_node, class_method_of, "the parent's own methods, in its volume: sub_inst arrives there through sx_sub_inst").
xl_ok(may_be_node, class_field_this, "the parent's own fields, in its volume: sub_inst arrives there through sx_sub_inst").

-- A generator's own volume: `next_send(G, V)` reaches G's file through the mirror of `sx_next`, and these read G's
-- own yields and delegations there; a volume holding another file's G reads no row and owes none.
xl_ok(may_be_node, nearest_v, "the generator's own yields, in its volume: next_send(G, _) arrives there through sx_next").
xl_ok(next_send, delegates, "the generator's own delegation, in its volume: next_send(G, _) arrives there through sx_next").

-- The arm for the volume's own argument; another file's array element spread into the call is named by `sx_name`.
xl_ok(passes_function, ast_name, "the volume's own argument; the arm beside it reads sx_name for another file's element").
xl_ok(written_arg, argument_at, "the point of it: an argument of another file is no step of the call and is left out").
xl_ok(passes_function, fn_node, "the argument written at the call (written_arg: ast_child of the call), a node of the call's own file").
xl_ok(passes_function, fn_name, "the argument written at the call (written_arg: ast_child of the call), a node of the call's own file").
xl_ok(passes_function, member_node_v, "the argument written at the call (written_arg: ast_child of the call), a node of the call's own file").
xl_ok(passes_function, selects, "the argument written at the call (written_arg: ast_child of the call), a node of the call's own file").
xl_ok(sx_name, ast_name, "the publication: the array's own volume names its element; another volume holds no name of it").

-- Object.assign (w_js_object_assign): the library member is recognised in the file that reads it. `const assign = Object.assign`
-- exported and called from another file is not seen as a merge by the importing volume (declared); the common shape, the
-- member or the module read in the calling file, is.
xl_ok(merge_call, merge_fn, "the library member is a node of the file that reads it; an alias exported to another file is not recognised there (declared)").
xl_ok(cl_api, http_client, "a library's specifier is the same string in every file: the table of its members is read by the string, not by a node").
xl_ok(cl_how, http_client, "a library's specifier is the same string in every file: the table of its members is read by the string, not by a node").
xl_ok(ex_app, express_module, "a library's specifier is the same string in every file: the table of its members is read by the string, not by a node").
xl_ok(contract_call, contract_fn, "the library member is a node of the file that reads it; an alias exported to another file is not recognised there (declared)").
xl_ok(coroutine_of, runs_coroutine, "a library's package is the same string in every file: its contract is read by the string, not by a node").
xl_ok(may_be_node, returns_argument, "a library's package is the same string in every file: its contract is read by the string, not by a node").
xl_ok(may_be_lit, returns_argument, "a library's package is the same string in every file: its contract is read by the string, not by a node").
xl_ok(ex_router_fn, express_module, "a library's specifier is the same string in every file: the table of its members is read by the string, not by a node").

finding(f_self_authored_benchmarks_circular, pitfall).
recorded(f_self_authored_benchmarks_circular, "2026-08-28").
finding_note(f_self_authored_benchmarks_circular,
  "Vadim's verdict: self-designed tests are worthless as evidence - the author of the traps is the author of the trap-catchers; benchmark validity requires externally authored ground truth with published degradation curves; the pilot is demoted to harness-smoke status; adopted external suites: lost_in_conversation (Claude 3 Haiku degradation published, open harness with recap/snowball controls), tau2-bench (pass^k), Vending-Bench class for grant scale").
addressed_by(f_self_authored_benchmarks_circular, "docs/dogfood/2026-08-28-pilot.md").

finding(f_staleness_needs_kernel_load, pitfall).
recorded(f_staleness_needs_kernel_load, "2026-08-28").
finding_note(f_staleness_needs_kernel_load,
  "epistemic.rofl depends on stale_evidence whose defining rule lived in an OPTIONAL policy file; a harness loading only the kernel silently ran with freshness off - caught by pilot ground truth (all six engine-arm misses were the stale trap); freshness now loads with the kernel").
addressed_by(f_staleness_needs_kernel_load, "runtime/report.ts").

finding(f_pilot_toy_scale_ties, insight).
recorded(f_pilot_toy_scale_ties, "2026-08-28").
finding_note(f_pilot_toy_scale_ties,
  "registered prediction FAILED both ways at toy scale (K=8, 14 memos): haiku-4.5 baseline with a rubric scored 48/48 in-head, and the engine arm's 42/48 was entirely a harness bug; after the fix both arms are perfect - the measurable edge must come from scale and horizon, confirming the long-horizon protocol; bonus: engine misses were replayed to 48/48 at zero model cost (determinism dividend)").
addressed_by(f_pilot_toy_scale_ties, "bench/pilot.ts").


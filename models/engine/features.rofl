-- models/engine/features.rofl — THE FEATURES OF THE ENGINE, found by the form of its code. The taxonomy is
-- Grafema's (_ai/research/feature-taxonomy.md), the one rules/features.rofl applies to src/api.ts:
--
--   ENTRY_POINT  a name the outside may say, at the place the code tells it from the others: a test of a value
--                against a string (`"why" => ...`, `a == "--kept"`, `Some("view")`) in a dispatcher.
--   BEHAVIOR     the code that runs because the name was said: the region the test guards, and every region
--                elsewhere guarded by a test of a value the first one chose. The choice travels as a constant: a
--                variant (`"sum" => AggOp::Sum`, matched again in the fold), `true` in a field a flag sets, `Some`.
--   FEATURE      entry points that share a behaviour: one capability, said in several ways.
--   CONTRACT     the names said inside the behaviour of another.
--
-- It reads the Rust model over the roles (models/lang/rust: names, calls, flow) and nothing of the parser.
-- A dispatcher is tied to its modality by hand, as a part is tied to its modules; one the table does not hold is
-- unplaced_dispatch[audit], so a new way in turns up instead of going unseen.

-- ===================================================================== THE WAYS IN
-- modality(Dispatcher, Kind): verb, flag, op (of rofl serve), builtin, aggregate, declaration, marker, auth
-- (how an adapter signs in), says (the reasons the engine names in an answer: the out side of a contract).
modality("bin::rofl::run", verb).
modality("bin::rofl::load::parse", flag).
modality("bin::rofl::seed::parse_args", flag).
modality("bin::rofl::serve::Server::handle", op).
modality("bin::rofl::serve::Server::op_change", op).
modality("bin::rofl::serve::Server::op_world", op).
modality("bin::rofl::serve::Server::op_read", op).
modality("rofl::engine::eval_str_op", builtin).
modality("rofl::engine::eval_arith", builtin).
modality("rofl::ring1_preds::by_name", builtin).
modality("rofl::cell::AggOp::from_name", aggregate).
modality("rofl::cell::IvFn::from_name", aggregate).
modality("rofl::structure::check_decl", declaration).
modality("rofl::reflect::Temporal::from_marker", marker).
modality("rofl::net::declared", auth).
modality("rofl::net::credential", auth).
modality("rofl::engine::agg_refusal_text", says).
modality("rofl::engine::Eval::hole_meta", says).
modality("rofl::engine::Eval::refuse_lattices", says).
modality("rofl::md::nb::tally", says).
modality("rofl::md::nb::verdict_of", says).
modality("rofl::md::nb::exit_of", says).

extern_crate("rofl", "rust/rofl/src/lib.rs").
crate_name("rust/rofl/src/lib.rs", "rofl").
crate_name("rust/rofl/src/bin/rofl/main.rs", "bin::rofl").

-- ===================================================================== TESTS OF A VALUE
-- the parts of a condition that must all hold, or any of which may: `a && b`, `a || b`
cond_part(G, G) :- executes_if[value](_, G, truthy).
cond_part(G, X) :- cond_part(G, Y), logical[value](Y, _, X, _).
cond_part(G, X) :- cond_part(G, Y), logical[value](Y, _, _, X).
-- pat_test(N, P, X): N runs when the pattern P takes the value X: a match arm, a `let` in a condition, `matches!`
pat_test(N, P, X) :- executes_if[value](N, P, matches), assign[value](_, P, X).
pat_test(N, P, X) :- executes_if[value](N, G, truthy), cond_part(G, T), assign[value](T, P, X).
-- the alternatives of a pattern, and what stands inside its constructors of the standard library and its tuples
alt_part(P, P)  :- pat_test(_, P, _).
alt_part(P, X)  :- alt_part(P, Y), binary[value](Y, "|", X, _).
alt_part(P, X)  :- alt_part(P, Y), binary[value](Y, "|", _, X).
deep_part(P, X) :- alt_part(P, X).
deep_part(P, X) :- deep_part(P, Y), pattern_elem[value](Y, _, X), not crate_pat[rust](Y).
deep_part(P, X) :- deep_part(P, Y), binary[value](Y, "|", X, _).
deep_part(P, X) :- deep_part(P, Y), binary[value](Y, "|", _, X).

-- ===================================================================== ENTRY_POINT
str_test(N, S) :- pat_test(N, P, _), deep_part(P, X), literal[value](X, S), string is type_of(S).
str_test(N, S) :- executes_if[value](N, G, truthy), cond_part(G, T), binary[value](T, "==", _, R), literal[value](R, S), string is type_of(S).
str_test(N, S) :- executes_if[value](N, G, truthy), cond_part(G, T), binary[value](T, "==", L, _), literal[value](L, S), string is type_of(S).
dispatcher(F, D) :- fn_q[rust](F, D), modality(D, _).
arm(D, Name, N)  :- str_test(N, Name), in_fn[rust](F, N), dispatcher(F, D).
entry(D, Name)   :- arm(D, Name, _).
entry_kind(D, Name, K) :- entry(D, Name), modality(D, K).

tests_n(F, N) :- fn_item[rust](F), not test_fn[rust](F), N is count(X, S : str_test(X, S), in_fn[rust](F, X)), N >= 5.
unplaced_dispatch[audit](D, N) :- tests_n(F, N), fn_q[rust](F, D), not modality(D, _).
dangling_modality[audit](D)    :- modality(D, _), not entry(D, _).

-- ===================================================================== THE CHOICE CARRIED AS A VALUE
-- tests(N, X, T): N runs when the value at X is the constant T
tests(N, X, v(V)) :- pat_test(N, P, X), deep_part(P, Y), denotes[rust](Y, V), variant_of[rust](V, _).
tests(N, X, v(V)) :- pat_test(N, P, X), deep_part(P, Y), crate_ctor[rust](Y, V), variant_of[rust](V, _).
tests(N, X, c(W)) :- pat_test(N, P, X), alt_part(P, Y), std_ctor[rust](Y, W).
tests(N, X, c(W)) :- pat_test(N, P, X), alt_part(P, Y), destructs[value](Y, C), std_ctor[rust](C, W).
tests(N, X, b(B)) :- pat_test(N, P, X), alt_part(P, Y), const[rust](Y, b(B)).
tests(N, X, s(S)) :- pat_test(N, P, X), deep_part(P, Y), const[rust](Y, s(S)).
tests(N, X, b(true))  :- executes_if[value](N, G, truthy), cond_part(G, X).
tests(N, X, b(false)) :- executes_if[value](N, G, truthy), cond_part(G, U), unary[value](U, "!", X).
tests(N, X, b(false)) :- executes_if[value](N, X, falsy).
tests(N, X, T) :- executes_if[value](N, G, truthy), cond_part(G, E), binary[value](E, "==", X, R), const[rust](R, T).
tests(N, X, T) :- executes_if[value](N, G, truthy), cond_part(G, E), binary[value](E, "==", R, X), const[rust](R, T).
edb(asks_ctor).
asks_ctor("is_some", "Some"). asks_ctor("is_none", "None").
tests(N, X, c(W)) :- executes_if[value](N, G, truthy), cond_part(G, C), callee[value](C, M), member[value](M, X, A), asks_ctor(A, W).
-- a value an entry gave, whatever it is: the body of a loop over it runs, and what `!x.is_empty()` guards
tests(N, X, val) :- executes_if[value](N, X, next).
tests(N, X, val) :- executes_if[value](N, G, truthy), cond_part(G, U), unary[value](U, "!", C), callee[value](C, M), member[value](M, X, "is_empty").

-- THE REGIONS OF AN ENTRY: the code its test guards, and the code guarded by a test of a constant written there
sel(D, Name, N) :- arm(D, Name, N).
sel(D, Name, N) :- tag(X, T, D, Name), tests(N, X, T), T != val.
sel(D, Name, N) :- tag(X, val, D, Name), tests(N, X, val), not foreign(X).
-- what of a region can choose or do: its constants, its calls, its assignments; each under every guard around it
guarded(N) :- executes_if[value](N, _, _).
acts(X) :- const[rust](X, _).
acts(X) :- mark[value](X, call).
acts(X) :- assign[value](X, _, _), not decl[value](X, _).
within(X, N) :- acts(X), inside[tree](N, X), guarded(N).
within(X, X) :- guarded(X), acts(X).

-- a constant written in a region travels unchanged; a variant, a string and a given value also through the
-- containers of the standard library
tag(X, T, D, Name)    :- sel(D, Name, N), within(X, N), const[rust](X, T).
tag(Y, T, D, Name)    :- tag(X, T, D, Name), copy[rust](X, Y).
tag(Y, v(V), D, Name) :- tag(X, v(V), D, Name), wrap[rust](X, Y).
tag(Y, s(S), D, Name) :- tag(X, s(S), D, Name), wrap[rust](X, Y).
tag(Y, val, D, Name)  :- tag(X, val, D, Name), wrap[rust](X, Y).
-- a value an arm gives that is no constant: what it assigns to a place outside, what it puts into a container
is_const(X) :- const[rust](X, _).
gives_val(V, D, Name) :- arm(D, Name, N), within(A, N), assign[value](A, _, V), not is_const(V).
gives_val(A, D, Name) :- arm(D, Name, N), within(C, N), std_call[rust](C, _, M), std_method(M, in), nth[tree](C, _, A), not is_const(A).
tag(V, val, D, Name) :- gives_val(V, D, Name).
-- A PLACE ONLY ENTRIES FILL. A value given says its entry was said only where nothing else writes the place: the
-- arguments of the process hold what `ask` put first and everything the caller typed, and a loop over them runs
-- either way. foreign(X): a value that began outside every arm may be at X. What an arm gives is the arm's,
-- wherever it took it from; a container made empty brings nothing.
edb(std_fresh).
std_fresh("new"). std_fresh("default"). std_fresh("with_capacity").
fresh(C) :- callee[value](C, M), member[value](M, _, Name), std_fresh(Name), not resolved[rust](C).
fed(Y) :- copy[rust](_, Y).
fed(Y) :- wrap[rust](_, Y).
given(V) :- gives_val(V, _, _).
from(X) :- copy[rust](X, _).
from(X) :- wrap[rust](X, _).
foreign(X) :- from(X), not fed(X), not is_const(X), not fresh(X), not given(X).
foreign(Y) :- foreign(X), copy[rust](X, Y), not given(Y).
foreign(Y) :- foreign(X), wrap[rust](X, Y), not given(Y).
-- THE NAME SAID, BUILT INTO A STRING: `format!("--{cmd}")` in the arm that tested `cmd` for the name is that string
src_local(X, B) :- ref[value](X, _), denotes[rust](X, B), local[rust](B).
src_local(C, B) :- callee[value](C, M), member[value](M, R, Name), rs_same_value(Name), src_local(R, B).
tested_local(N, B) :- pat_test(N, _, X), src_local(X, B).
tag(M, s(V), D, Name) :- arm(D, Name, N), within(M, N), callee[value](M, F), ref[value](F, "format!"), nth[tree](M, 0, L),
                         literal[value](L, Text), denotes[rust](L, B), tested_local(N, B), 2 is str_segs(Text, "{"),
                         Pre is str_pre(Text, "{"), Suf is str_seg(Text, "}", 1), V is concat(Pre, concat(Name, Suf)).

-- ===================================================================== BEHAVIOR
region(N) :- sel(_, _, N).
-- a region another name of the same dispatcher chose and this one did not: said `ask`, the code under `Why` waits
-- for another word
excluded(D, Name, N) :- sel(D, Other, N), entry(D, Name), Other != Name, not sel(D, Name, N).
barred(D, Name, C)   :- excluded(D, Name, N), within(C, N), mark[value](C, call).
-- THE FUNCTIONS AN ENTRY DOES: those the calls of its regions enter, and every function they reach, less the barred.
-- Only a call written in a region can be barred, so the rest of the calls are one graph for every entry, walked and
-- not stored; an entry's own part is where it enters that graph: from its regions, and from the calls in a region
-- of a function it does.
regional(C) :- sel(_, _, N), within(C, N), mark[value](C, call).
graph plain_call(F, G) closure plain_reach.
plain_call(F, G) :- in_fn[rust](F, C), mark[value](C, call), not regional(C), ran[rust](C, G), fn_item[rust](G), not test_fn[rust](G).
enters(D, Name, G) :- sel(D, Name, N), within(C, N), mark[value](C, call), not barred(D, Name, C), ran[rust](C, G), fn_item[rust](G), not test_fn[rust](G).
enters(D, Name, G) :- does_fn(D, Name, H), in_fn[rust](H, C), regional(C), not barred(D, Name, C), ran[rust](C, G), fn_item[rust](G), not test_fn[rust](G).
does_fn(D, Name, G) :- enters(D, Name, G).
does_fn(D, Name, H) :- enters(D, Name, G), plain_reach(G, H).
does(D, Name, HQ)   :- does_fn(D, Name, H), fn_q[rust](H, HQ).
does_n(D, Name, N)  :- entry(D, Name), N is count(H : does(D, Name, H)).

-- THE SITES OF AN ENTRY: the lines of its regions
span(N, File, A, B) :- region(N), at[tree](N, File, A), ends[tree](N, B).
span(N, File, A, A) :- region(N), at[tree](N, File, A), not ends[tree](N, _).
site(D, Name, File, A, B) :- sel(D, Name, N), span(N, File, A, B).
sites_n(D, Name, N) :- entry(D, Name), N is count(File, A : site(D, Name, File, A, _)).
-- and the functions a region is written in, beyond the dispatcher: where the choice is read again
far_site(D, Name, FQ) :- sel(D, Name, N), in_fn[rust](F, N), fn_q[rust](F, FQ), FQ != D.

-- where a value the entry gave is read
reads(D, Name, FQ) :- tag(X, val, D, Name), in_fn[rust](F, X), fn_q[rust](F, FQ), FQ != D.

-- AN ENTRY NOTHING HERE EXPLAINS: its arm calls nothing, writes no constant another place tests, gives no value read elsewhere
explained(D, Name) :- does(D, Name, _).
explained(D, Name) :- far_site(D, Name, _).
explained(D, Name) :- reads(D, Name, _).
by_value[audit](D, Name) :- entry(D, Name), not explained(D, Name).

-- ===================================================================== FEATURE
differs(D, A, B) :- does(D, A, H), entry(D, B), not does(D, B, H).
same_feature(D, A, B) :- entry(D, A), entry(D, B), A < B, does(D, A, _), does(D, B, _),
                         not differs(D, A, B), not differs(D, B, A).

-- ===================================================================== CONTRACT
-- the inputs of an entry: the entries of another dispatcher its behaviour reaches
takes(D, Name, D2, K) :- does(D, Name, D2), modality(D2, K), D2 != D.

-- ===================================================================== EFFECTS
-- effect_call(Path, Name, Kind): a function of the standard library that touches the world, and how
effect_call("std::fs", "read_to_string", fs_read).
effect_call("std::fs", "read", fs_read).
effect_call("std::fs", "read_dir", fs_read).
effect_call("std::fs", "metadata", fs_read).
effect_call("std::fs::File", "open", fs_read).
effect_call("std::fs", "write", fs_write).
effect_call("std::fs", "create_dir_all", fs_write).
effect_call("std::fs", "rename", fs_write).
effect_call("std::fs::OpenOptions", "new", fs_write).
effect_call("std::fs::File", "create", fs_write).
effect_call("std::fs", "remove_file", fs_delete).
effect_call("std::fs", "remove_dir_all", fs_delete).
effect_call("std::env", "var", env_read).
effect_call("std::env", "var_os", env_read).
effect_call("std::env", "current_dir", env_read).
effect_call("std::env", "current_exe", env_read).
effect_call("std::env", "temp_dir", env_read).
effect_call("std::process", "exit", exit).
effect_call("std::process::Command", "new", exec).
effect_call("std::net::TcpListener", "bind", listen).
effect_call("std::thread", "spawn", thread).
effect_call("std::thread", "scope", thread).
effect_call("std::io", "stdin", stdin).
effect_call("std::time::Instant", "now", clock).
effect_call("std::time::SystemTime", "now", clock).

effect_at(C, K) :- callee[value](C, Fn), member[value](Fn, P, N), effect_call(Q, N, K), path_text[rust](P, Q).
effect(F, K)    :- effect_at(C, K), in_fn[rust](F, C).
effect_by(D, Name, K, H) :- does_fn(D, Name, H), effect(H, K).
effect_of(D, Name, K)    :- effect_by(D, Name, K, _).
entry_effect(D, Name, K, N) :- effect_of(D, Name, K), N is count(H : effect_by(D, Name, K, H)).

-- ===================================================================== WHOSE CODE
-- how many entries of a dispatcher a function serves: most of them is the machinery under that way in
entries_of(D, M) :- modality(D, _), M is count(X : entry(D, X), does(D, X, _)).
serves_n(D, H, N) :- modality(D, _), does(D, _, H), N is count(X : does(D, X, H)).
common(D, H) :- serves_n(D, H, N), entries_of(D, M), N * 2 > M.
-- the engine under the verbs (a third is Grafema's bound for cross-cutting code; here four verbs are one arm, so the half)
wide(H) :- common("bin::rofl::run", H).
own(D, Name, H) :- does(D, Name, H), not common(D, H).

-- ===================================================================== THE COUNTS
entries_n(K, N)  :- modality(_, K), N is count(D, X : entry_kind(D, X, K)).
by_value_n(K, N) :- modality(_, K), N is count(D, X : by_value[audit](D, X), entry_kind(D, X, K)).
wide_n(N) :- N is count(H : wide(H)).
own_n(D, Name, N) :- entry(D, Name), N is count(H : own(D, Name, H)).
regions_n(D, Name, N) :- entry(D, Name), N is count(R : sel(D, Name, R)).

-- models/engine/plan.rofl — THE JOIN ORDER PLANNED FROM THE PROFILE, EVERY ORDER COSTED AND THE CHEAPEST KEPT
-- (docs/cli.md, *The plan as facts*). Load it beside the rule files and the profile of the world it plans, in a world
-- of its own (scripts/refine.ts does). Its answer is `plan[fixpointplan](R, At, Order)`, the fact the engine obeys;
-- the world it is for is then run with those facts and the profile's `width` judges them.
--
-- The hypothesis. The cost of an order is the partial solutions each premise is solved from, summed (the engine's
-- `width[profile]`). A premise placed after a set S multiplies the partial solutions by its fanout, the engine's own
-- law: its rows over the distinct values of the columns S binds, a declared function whose key is bound one, a
-- premise sharing nothing its rows, a premise holding nothing zero. The fanout is the added premise's own, so the cost
-- is of the path and every order is costed; the independence estimate folded over a set (a shortest path over the
-- subsets under a lattice min) was the hypothesis before and lost to the greedy order where the data is skewed.
-- Sets are bitmasks: premise K (written position, from 1) is bit 2^(K-1); an order is a number in base 9.
--
-- What it plans: a rule of two to seven premises, every one a positive literal (no negation, builtin or aggregate: a
-- fact on those would hold up only under conditions this pack does not model), none of the profile pack's or this
-- one's, nor one that reads the profile. At is 0 (the firing over the whole store) and, for a recursive rule, each written position of the head's
-- relation among the premises, which the engine fires on the news and solves first.

-- ------------------------------------------------------------------------------------------------ the rules planned
pl_mixed(R) :- premise_lit(R, _, $not(_)).
pl_mixed(R) :- premise_lit(R, _, $builtin(_, _)).
pl_mixed(R) :- premise_lit(R, _, $agg(_, _, _, _, _)).
-- the rules that are not the world's: the kernel's (safety.rofl comes reflected as program(R, safety); the engine
-- obeys no plan there, and the pack over its 213 rules cost a small world four times its time), the two packs' and
-- any that read the profile, and whatever reads what they conclude or concludes what they read
pl_own(R) :- program[profile](R, safety).
pl_own(R) :- pf_head[profile](R, _, fixpointplan).
pl_own(R) :- pf_own[profile](R).
pl_own(R) :- premise_lit(R, _, $lit(_, profile, _, _)).
pl_own(R) :- pl_own(R2), concludes(R2, Rel), premise_lit(R, _, $lit(Rel, main, _, _)).
pl_own(R) :- pl_own(R2), premise_lit(R2, _, $lit(Rel, main, _, _)), concludes(R, Rel).
pl_rule(R, N) :- pf_npos[profile](R, N), N >= 2, N <= 7, not pl_mixed(R), not pf_own[profile](R), not pl_own(R).

pl_bit(1, 1).
pl_bit(K, B) :- pl_bit(J, A), J < 8, K is J + 1, B is A * 2.
-- every subset of the premises, as a bitmask, each set reached by adding one premise it lacks
pl_full(R, F) :- pl_rule(R, N), pl_bit(N, B), F is B * 2 - 1.
pl_set(R, 0)  :- pl_rule(R, _).
pl_set(R, S)  :- pl_out(R, T, K), pl_bit(K, B), S is T + B.
pl_in(R, S, K)  :- pl_set(R, S), pl_rule(R, N), pl_bit(K, B), K <= N, Q is S / B, M is Q mod 2, M = 1.
pl_out(R, S, K) :- pl_set(R, S), pl_rule(R, N), pl_bit(K, B), K <= N, Q is S / B, M is Q mod 2, M = 0.

-- -------------------------------------------------------------------------------------------------- the estimate
-- a constant in a column: the premise's rows are those that hold it (`selects` of the census), the fewest where it
-- writes several; the column's average over its distinct values was tried and missed the skew (identifier among the
-- kinds of a node is most of the rows, try_statement one)
pl_arity(R, K, A)       :- pf_lit[profile](R, K, _, _, _), A is count(J : pf_slot[profile](R, K, J, _)).
pl_varslot(R, K, J)     :- pf_slot[profile](R, K, J, $var(_)).
pl_const(R, K, J)       :- pf_slot[profile](R, K, J, _), not pl_varslot(R, K, J).
pl_sel(R, K, N)         :- pl_const(R, K, J), pf_slot[profile](R, K, J, A), pf_lit[profile](R, K, Rel, B, _), selects[profile](Rel, B, J, A, N).
pl_rows(R, delta, K, N) :- pl_sel(R, K, _), N is min(X : pl_sel(R, K, X)).
pl_rows(R, delta, K, N) :- pf_lit[profile](R, K, Rel, B, _), rows[profile](Rel, B, N), not pl_sel(R, K, _).
-- THE TWO PHASES OF A FIRING. At 0 the rule fires once over the whole store, at its activation, when the store
-- holds the base facts and what the rules fired whole before it concluded (`activation` is that sequence; a closure
-- is the kernel's and holds from the start); every other relation it reads is empty there, its news reach the rule
-- later, premise by premise, at the delta positions, and the order that starts from an empty premise reads nothing.
-- The engine's own planner sees it by the live sizes at that moment; the census is of the finished store, so the
-- full phase reads `base` of a premise not yet live. The delta phase, a recursive rule fired on the news of one
-- premise, reads the store as it fills: `rows`.
pl_phase(R, full)       :- pl_rule(R, _).
pl_phase(R, delta)      :- pl_rule(R, _).
-- live at R's firing: base facts held, or a closure, or a rule concluding it fired whole before AND concluded
-- something then, which it did only where every premise of its own was live at its firing (a rule fired before with
-- nothing to read concluded nothing). An alias is its source read again (`alias this(T) is mark(T, this)`, lowered
-- to a rule the engine never fires), so it is live where its source is, in the book the premise names. The count
-- is over the rules fired earlier, so it is stratified by the data (activation strictly decreasing), not by the program
pl_src(Rel, Rel2)       :- structure_decl(Rel, _, alias), pf_head[profile](R2, Rel, _), pf_lit[profile](R2, _, Rel2, _, _).
pl_need(R, Rel, B)      :- pf_lit[profile](R, _, Rel, B, _).
pl_need(R, Rel2, B)     :- pl_need(R, Rel, B), pl_src(Rel, Rel2).
pl_rl(R, Rel, B)        :- pl_need(R, Rel, B), base[profile](Rel, B, N), N > 0.
pl_rl(R, Rel, B)        :- pl_need(R, Rel, B), structure_closure(_, Rel).
pl_rl(R, Rel, B)        :- pl_need(R, Rel, B), pf_head[profile](R2, Rel, B), activation[profile](R2, I2), activation[profile](R, I), I2 < I, pl_prod(R2).
pl_rl(R, Rel, B)        :- pl_need(R, Rel, B), pl_src(Rel, Rel2), pl_rl(R, Rel2, B).
pl_live(R, K)           :- pf_lit[profile](R, K, Rel, B, _), pl_rl(R, Rel, B).
pl_nlive(R2, N)         :- activation[profile](R2, _), N is count(K : pl_live(R2, K)).
pl_prod(R2)             :- pl_nlive(R2, N), pf_npos[profile](R2, N).
pl_rows(R, full, K, N)  :- pl_rows(R, delta, K, N), pl_live(R, K).
pl_rows(R, full, K, N)  :- pl_rows(R, delta, K, N0), not pl_live(R, K), pf_lit[profile](R, K, Rel, B, _), base[profile](Rel, B, Bn), N is min(N0, Bn).
-- the firing at 0 is costed in both phases: the full phase decides, and where it cannot (every order that starts
-- from an empty premise costs one), the delta phase does, since a reader of a closure fires whole again on every
-- round its edges move (engine.rs, fire_in_round_from) and a rule's whole firing is not the only one at 0
pl_atp(R, 0, full)      :- pl_rule(R, _).
pl_atp(R, 0, delta)     :- pl_rule(R, _).
pl_atp(R, At, delta)    :- pl_start(R, At, _), At != 0.
pl_prim(R, 0, full)     :- pl_rule(R, _).
pl_prim(R, At, delta)   :- pl_start(R, At, _), At != 0.

-- THE FANOUT OF A PREMISE K PLACED AFTER THE SET S, the engine's own law (joinplan.rs, delta_stat): its rows over
-- the distinct values of the columns S binds, taken together (the census has them one by one: their product, capped
-- at the rows), never under one; a declared `function` whose key S binds answers one row a binding; a premise sharing
-- nothing with S multiplies by its rows; a premise holding nothing ends the count. It is a function of (S, K), so
-- every order through S shares it.
pl_bound(R, S, V)       :- pl_in(R, S, K), pf_var[profile](R, K, _, V).
pl_hold(R, S, K, J)     :- pl_out(R, S, K), pf_var[profile](R, K, J, V), pl_bound(R, S, V).
pl_holds(R, S, K)       :- pl_hold(R, S, K, _).
pl_dd(R, S, K, 0, 1)    :- pl_out(R, S, K).
pl_dd(R, S, K, J, D)    :- pl_dd(R, S, K, J0, D0), J is J0 + 1, pl_arity(R, K, A), J <= A, pl_hold(R, S, K, J), pf_lit[profile](R, K, Rel, B, _), distinct[profile](Rel, B, J, Dj), D1 is D0 * Dj, D is min(D1, 1000000000000).
pl_dd(R, S, K, J, D)    :- pl_dd(R, S, K, J0, D), J is J0 + 1, pl_arity(R, K, A), J <= A, not pl_hold(R, S, K, J).
pl_div(R, S, K, D)      :- pl_dd(R, S, K, A, D), pl_arity(R, K, A).
pl_keymiss(R, S, K)     :- pf_lit[profile](R, K, Rel, _, _), structure_decl(Rel, _, function), pl_varslot(R, K, J), not structure_role(Rel, J, to), not pl_hold(R, S, K, J).
pl_keyed(R, S, K)       :- pl_out(R, S, K), pf_lit[profile](R, K, Rel, _, _), structure_decl(Rel, _, function), not pl_keymiss(R, S, K).
pl_fan(R, P, S, K, 0)   :- pl_out(R, S, K), pl_phase(R, P), pl_rows(R, P, K, 0).
pl_fan(R, P, S, K, 1)   :- pl_keyed(R, S, K), pl_phase(R, P), pl_rows(R, P, K, N), N > 0.
pl_fan(R, P, S, K, N)   :- pl_out(R, S, K), pl_phase(R, P), pl_rows(R, P, K, N), N > 0, not pl_holds(R, S, K).
pl_fan(R, P, S, K, F)   :- pl_holds(R, S, K), not pl_keyed(R, S, K), pl_phase(R, P), pl_rows(R, P, K, N), N > 0, pl_div(R, S, K, D), D1 is min(D, N), F1 is N / D1, F is max(F1, 1).

-- ------------------------------------------------------------------------------------------------------ the plan
-- EVERY ORDER, as a sequence: S the premises placed, L how many, Code the order itself (position K at place L is the
-- digit K x 9^L, so the first placed is the lowest digit), E the partial solutions after the last placed, C the cost
-- so far, the partial solutions each placed premise was solved from, summed (the engine's `width`). The fanout is
-- the added premise's own and so of the path, which a shortest path over sets cannot carry (the estimate folded over
-- a set, dividing by the most distinct of a shared variable, was tried and lost to the greedy order where the data
-- is skewed: f_a_rules_whole_firing_sees_the_store_at_its_activation_not_the_census and the findings before it); a
-- rule of up to seven premises has 13 699 prefixes at most, and the reference world 1 400 such rules.
-- Where an order starts: nothing placed, or the news premise alone, solved from one partial solution.
pl_start(R, 0, 0)  :- pl_rule(R, _).
pl_start(R, K, B)  :- pl_rule(R, _), recursive[profile](R), pf_head[profile](R, Rel, Bk), pf_lit[profile](R, K, Rel, Bk, _), pl_bit(K, B).
pl_pow(0, 1).
pl_pow(L1, P1) :- pl_pow(L, P), L < 8, L1 is L + 1, P1 is P * 9.
pl_sq(R, 0, P, 0, 0, 0, 1, 0)   :- pl_atp(R, 0, P).
pl_sq(R, At, delta, B, 1, At, N, 1) :- pl_start(R, At, B), At != 0, pl_rows(R, delta, At, N).
-- the estimate saturates at 10^15: a product of eight relations of the reference world leaves i64, and a shrug
-- there (arith_overflow) made every plan a shrug; a cost past 10^15 is beyond any budget, and costs compare the same
pl_step(R, At, P, S, E, K, S1, L1, Code1, C1) :- pl_sq(R, At, P, S, L, Code, E, C), pl_out(R, S, K), pl_bit(K, B), S1 is S + B, L1 is L + 1, pl_pow(L, P9), Code1 is Code + K * P9, C1 is C + E.
pl_sq(R, At, P, S1, L1, Code1, E1, C1) :- pl_step(R, At, P, S, E, K, S1, L1, Code1, C1), pl_fan(R, P, S, K, F), E <= 1000000000, E0 is E * F, E1 is min(E0, 1000000000000000).
pl_sq(R, At, P, S1, L1, Code1, 1000000000000000, C1) :- pl_step(R, At, P, S, E, K, S1, L1, Code1, C1), pl_fan(R, P, S, K, F), E > 1000000000, F > 0.
pl_sq(R, At, P, S1, L1, Code1, 0, C1) :- pl_step(R, At, P, S, E, K, S1, L1, Code1, C1), pl_fan(R, P, S, K, 0), E > 1000000000.
pl_sqf(R, At, P, Code, C) :- pl_sq(R, At, P, F, _, Code, _, C), pl_full(R, F).
-- the cheapest order in the deciding phase, the cheapest in the delta phase among those, the lowest code among ties
pl_cmin(R, At, C)     :- pl_prim(R, At, P), pl_sqf(R, At, P, _, _), C is min(X : pl_sqf(R, At, P, _, X)).
pl_tie(R, At, Code, C2) :- pl_cmin(R, At, C), pl_prim(R, At, P), pl_sqf(R, At, P, Code, C), pl_sqf(R, At, delta, Code, C2).
pl_cmin2(R, At, C2)   :- pl_tie(R, At, _, _), C2 is min(X : pl_tie(R, At, _, X)).
pl_pick(R, At, Code)  :- pl_cmin2(R, At, C2), Code is min(X : pl_tie(R, At, X, C2)).
pl_want(R, At, Code) :- pl_pick(R, At, Code).
pl_want(R, At, C0)   :- pl_want(R, At, C), C > 0, C0 is C / 9.
pl_dec(R, At, 0, $nil) :- pl_want(R, At, 0).
pl_dec(R, At, C, $cons(K, L)) :- pl_want(R, At, C), C > 0, K is C mod 9, C0 is C / 9, pl_dec(R, At, C0, L).

plan[fixpointplan](R, At, L) :- pl_pick(R, At, Code), pl_dec(R, At, Code, L).
-- the cost the plan forecasts, to set beside the width the profile measures under it (summed over the premises)
plan_cost[fixpointplan](R, At, C) :- pl_cmin(R, At, C), pl_pick(R, At, _).

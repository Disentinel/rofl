-- models/engine/intent.rofl — WHAT A CHANGE MEANT AGAINST WHAT IT DID. The intent is said before the work, in the
-- words the feature diff (feature-diff.rofl) answers in; what moved and was not meant is a side effect, what was
-- meant and did not move is unmet.
--
--   meant_entry(P, Kind, Name)     P is to change what this entry does
--   meant_new(P, Kind, Name)       P is to add this entry
--   meant_effect(P, Name, Effect)  the entry is to touch the world in this way from now on
--   meant_engine(P)                P is to rewrite the engine under the entries
--
-- A change with no intent said means to leave the engine as it is.
edb(meant_entry).
edb(meant_new).
edb(meant_effect).
edb(meant_engine).

did_entry(P, K, Name)     :- sharp(P, K, _, Name, _).
did_new(P, K, Name)       :- came(P, K, _, Name), K != says.
did_effect(P, K, Name, E) :- effect_came(P, D, Name, E), pr(P, _, A, _), entry_at[snap](A, D, Name, K).
did_engine(P)             :- rewrote_shared(P, _).
-- under an entry: code only some entries reach, written
did_under(P, K, Name)     :- rewrote_own(P, D, Name, _), pr(P, _, A, _), entry_at[snap](A, D, Name, K).

meant(P, K, Name) :- meant_entry(P, K, Name).
meant(P, K, Name) :- meant_new(P, K, Name).
side(P, entry(K, Name))     :- did_entry(P, K, Name), not meant(P, K, Name).
side(P, new(K, Name))       :- did_new(P, K, Name), not meant_new(P, K, Name).
side(P, effect(K, Name, E)) :- did_effect(P, K, Name, E), not meant_effect(P, Name, E).
side(P, engine)             :- did_engine(P), not meant_engine(P).
-- an entry not meant whose own code was written: weaker than its lines, wider
side_under(P, K, Name)      :- did_under(P, K, Name), not meant(P, K, Name), not did_entry(P, K, Name).

moved_for(P, K, Name) :- did_entry(P, K, Name).
moved_for(P, K, Name) :- did_under(P, K, Name).
moved_for(P, K, Name) :- did_new(P, K, Name).
unmet(P, entry(K, Name))     :- meant_entry(P, K, Name), not moved_for(P, K, Name).
unmet(P, new(K, Name))       :- meant_new(P, K, Name), not did_new(P, K, Name).
unmet(P, effect(Name, E))    :- meant_effect(P, Name, E), not had_effect(P, Name, E).
had_effect(P, Name, E)       :- pr(P, _, A, _), effect_at[snap](A, _, Name, E).
unmet(P, engine)             :- meant_engine(P), not did_engine(P).

side_n(P, N)       :- pr(P, _, _, _), N is count(X : side(P, X)).
side_under_n(P, N) :- pr(P, _, _, _), N is count(K, Name : side_under(P, K, Name)).
unmet_n(P, N)      :- pr(P, _, _, _), N is count(X : unmet(P, X)).

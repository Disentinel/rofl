-- models/engine/memory.rofl — WHAT THE STORE HOLDS AFTER AN EVALUATION, FORECAST FROM THE FORM OF THE RULES AND THE PROFILE.
-- Load it beside models/engine/profile.rofl, the rule files and the profile of a world, as sols.rofl is loaded.
--
-- The hypothesis. Every solution that added something, a row or a witness (`conc` less `again`), is one witness: a
-- node of 20 bytes (rule, tick, where its premises start, how many, the next witness of the fact; store.rs `WitNode`)
-- and one `PremRef` of 4 bytes for each premise the rule has (8 until 2026-11-03, f_a_premise_is_named_in_four_bytes). A row is a record of 12 bytes (`FactRec`) and its
-- arguments, 4 bytes each. So the witnesses are a function of the rules' widths and premise counts, not of the data's
-- spelling, and a narrower layout is a saving the forecast can price before anything is built.

mem_wit(R, W, P) :- conc[profile](R, C), again[profile](R, A), pf_npos[profile](R, P), W is C - A, W > 0.
mem_wit(R, W, P) :- conc[profile](R, C), not again[profile](R, _), pf_npos[profile](R, P), W = C, W > 0.
memory(witness_nodes, T) :- S is sum(W ; R : mem_wit(R, W, _)), T is S * 20.
mem_prems(R, B) :- mem_wit(R, W, P), B is W * P * 4.
memory(witness_prems, T) :- T is sum(B ; R : mem_prems(R, B)).
memory(witnesses, N) :- N is sum(W ; R : mem_wit(R, W, _)).

-- THE PATTERN INDEXES. A premise asks its relation by the columns bound when it is reached: a constant, or a variable
-- a premise solved before it bound (sols.rofl `so_bound`). Each distinct (relation, book, columns) the run asks is
-- an index over all the relation's rows, an id and a link of 4 bytes each and a slot of 4 (store.rs `PatIndex`).
-- What it buys is the scans it spares: the partial rows that asked through it (`width_at`). A pattern asked by fewer
-- partial rows than a scan would cost to build it is held for nothing: the relation read whole that many times reads
-- no more than building it did.
mem_bit(1, 1).
mem_bit(J, B) :- mem_bit(I, A), I < 16, J is I + 1, B is A * 2.
mem_varslot(R, K, J) :- pf_slot[profile](R, K, J, $var(_)).
mem_bound_col(R, At, K, J) :- so_at(R, At, _, K, _), pf_slot[profile](R, K, J, _), not mem_varslot(R, K, J).
mem_bound_col(R, At, K, J) :- so_bound(R, At, K, V), pf_var[profile](R, K, J, V).
mem_mask(R, At, K, M) :- mem_bound_col(R, At, K, _), M is sum(B ; J : mem_bound_col(R, At, K, J), mem_bit(J, B)).
mem_asks(Rel, Bk, M, R, At, K, W) :- mem_mask(R, At, K, M), pf_lit[profile](R, K, Rel, Bk, _), width_at[profile](R, At, K, W), W > 0.
mem_pattern(Rel, Bk, M, N, W) :- mem_asks(Rel, Bk, M, _, _, _, _), rows[profile](Rel, Bk, N), N >= 16,
  W is sum(X ; R, At, K : mem_asks(Rel, Bk, M, R, At, K, X)).
memory(pattern_indexes, T) :- S is sum(N ; Rel, Bk, M : mem_pattern(Rel, Bk, M, N, _)), T is S * 12.
memory(patterns, C) :- C is count(Rel, Bk, M : mem_pattern(Rel, Bk, M, _, _)).
-- held for nothing: a scan per partial row reads the relation W times (W x N rows); the index costs N to build and a
-- probe per partial row. So it pays from the second partial row on, and one asked by at most one is held for nothing
mem_idle(Rel, Bk, M, N, W) :- mem_pattern(Rel, Bk, M, N, W), W <= 1.
memory(idle_pattern_indexes, T) :- S is sum(N ; Rel, Bk, M : mem_idle(Rel, Bk, M, N, _)), T is S * 12.
memory(idle_patterns, C) :- C is count(Rel, Bk, M : mem_idle(Rel, Bk, M, _, _)).

-- WHAT THE HEAP HELD, as the engine counted it (docs/cli.md, *The profile of an evaluation*): at its peak, by part,
-- and at the end. The forecast above is judged by these.
mem_peak(Part, B) :- peak_bytes[profile](Part, B).
mem_end(Part, B) :- bytes[profile](Part, B).
mem_peak_rule(R) :- peak_rule[profile](R).

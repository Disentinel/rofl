ties_to(T, type, X)   :- tie(T, type, X), rs_type[rs](X, _, _, _).
ties_to(T, fn, X)     :- tie(T, fn, X), rs_fn[rs](X, _, _, _, _, _).
ties_to(T, module, X) :- tie(T, module, X), rs_mod[rs](X, _).
dangling_tie[audit](T, K, X) :- tie(T, K, X), not ties_to(T, K, X).

-- the functions a term is: tied to directly, or the functions of a tied module or the methods of a tied type
term_fn(T, F) :- tie(T, fn, F), rs_known(F).
term_fn(T, F) :- tie(T, module, M), fn_mod(F, M).
term_fn(T, F) :- tie(T, type, X), rs_method[rs](F, X, _).

-- which words of the glossary a verb of the binary reaches, and through how many of their functions
verb_term(V, T, N) :- verb(V), term(T, _, _), N is count(F : reaches(V, F), term_fn(T, F)), N > 0.

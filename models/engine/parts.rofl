fn_part(F, P) :- fn_mod(F, M), module_in(M, P).

-- a module the scan found and no part holds: the map has a hole
unplaced_module[audit](M) :- rs_mod[rs](M, _), not placed(M).
placed(M) :- module_in(M, _).

-- WHO CALLS WHOM, part to part: the calls between functions, counted. Only calls the code names surely (by path or
-- by a known type): a call found by its name alone could be any of the crate's methods so named.
sure(F, G) :- calls(F, G, path).
sure(F, G) :- calls(F, G, typed).
part_calls(A, B, N) :- part(A, _, _), part(B, _, _), A != B, N is count(F, G : sure(F, G), fn_part(F, A), fn_part(G, B)), N > 0.
part_size(P, L) :- part(P, _, _), L is sum(S ; F : fn_part(F, P), fn_size(F, S)).

-- ===================================================================== THE GLOSSARY
-- term(T, Word, What), and tie(T, Kind, Id): where the term lives in the code (Kind: type, fn, module)
term(world,        "мир",                 "хранилище фактов + правила, досчитанные до неподвижной точки").
term(evaluate,     "оценка",              "прогон правил до неподвижной точки").
term(fork,         "форк",                "мир как слой над замороженной базой, факты не копируются").
term(freeze,       "заморозка",           "база, которую делят форки и не пишет никто").
term(addition,     "добавление дельтой",  "новые факты в посчитанный мир, пересчёт только затронутого").
term(retraction,   "удаление дельтой",    "факт уходит из посчитанного мира, уходит то, что на нём стояло").
term(kept_world,   "хранимый мир",        "посчитанный мир на диске, ответ без пересчёта").
term(image,        "образ",               "хранимый мир одним двоичным файлом").
term(volume_kept,  "том ①",               "хранимый мир как отображаемые в память арены").
term(volume_corpus,"том ②",               "факты одного файла корпуса").
term(cool,         "охлаждение",          "факты тома ② на диск по книгам, кроме surface").
term(reheat,       "разогрев",            "охлаждённый том обратно в мир").
term(witness,      "свидетель",           "какое правило из каких посылок вывело факт").
term(seal,         "запечатывание",       "sealed(provenance): свидетелей не хранить").
term(cell,         "ячейка",              "одно значение агрегата на ключ").
term(tag,          "полукольцо",          "вес на факте: ⊗ вдоль доказательства, ⊕ между доказательствами").
term(stratum,      "страта",              "слой отношений, досчитанный раньше, чем его читают через not").
term(wall,         "стена",               "бюджет шагов, память, диск: где оценка останавливается и говорит об этом").
term(hole,         "дыра",                "hole(что, почему): недосчитанное, названное").
term(shrug,        "пожатие плечами",     "третий ответ: не знаю, по такой-то причине").
term(journal,      "журнал",              "что миру сказали и когда").
term(book,         "книга",               "раздел хранилища [x]: кто это утверждает").
term(reflection,   "рефлексия",           "правила лежат в хранилище как факты").
term(tree,         "дерево",              "объявленное дерево: предки без хранения строк").


-- models/engine/parts.rofl — THE ENGINE AS A PERSON NAMES IT: its parts and the words of the glossary, each tied to
-- the code that is it (models/engine/code.rofl reads the code). The ties are hand-written and checked: a tie to a
-- function, type or module the scan no longer finds is `dangling_tie[audit]`, so a rename turns this file red
-- instead of silently wrong.

-- ===================================================================== THE PARTS
-- part(P, Name, What): a part of the engine, and in one line what it is for
part(cli,         "командная строка", "глаголы rofl load|ask|why|whynot|excise|render|nb, разбор флагов").
part(kept,        "хранимые миры",    "мир на диске между вопросами, правка файла дельтой").
part(serve,       "serve",            "долгий процесс: JSON-запросы, много миров-сессий").
part(session,     "сессия",           "мир как объект: load, assert, evaluate, fork, cool, reheat").
part(parser,      "парсер",           "текст ROFL в правила и факты").
part(notebook,    "блокнот",          "Markdown .rofl.md, предложения вместо Datalog").
part(reflection,  "рефлексия",        "правила как факты, программы ядра boot и safety").
part(evaluator,   "вычислитель",      "полунаивная неподвижная точка, слои, соединения, стены").
part(incremental, "дельты",           "добавить или убрать факты в посчитанном мире").
part(provenance,  "свидетели",        "почему: доказательства фактов").
part(aggregates,  "агрегаты",         "ячейки, решётки, полукольца").
part(structures,  "структуры",        "function, tree closure, alias: хранить компактнее").
part(store,       "хранилище",        "факты по книгам, термы, арены памяти").
part(persistence, "форматы на диске", "образ, том, снимок, журнал").
part(adapters,    "адаптеры",         "внешние сервисы: exec, MCP, OpenAPI, вход, Roflenox").
part(ring1,       "ring1",            "сгенерированный токенизатор").
part(harness,     "стенд",            "вшитые поломки для проверок, корпус сверки").


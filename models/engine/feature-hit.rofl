-- models/engine/feature-hit.rofl — WHERE A CHANGE WROTE: the functions whose lines it changed, the lines it changed
-- outside every function, and the entries in whose own sites (models/engine/features.rofl) it wrote, which is
-- nearer than a function the entry merely reaches. Read beside the features of the tree after the change and
-- changed[diff](File, Line), the lines of the diff.
edb(changed).
fn_span(F, File, A, B) :- fn_item[rust](F), at[tree](F, File, A), ends[tree](F, B).
fn_line(F, File, L) :- changed[diff](File, L), fn_span(F, File, A, B), L >= A, L <= B.
in_some_fn(File, L) :- fn_line(_, File, L).
touched_lines(FQ, K) :- fn_q[rust](F, FQ), not test_fn[rust](F), K is count(File, L : fn_line(F, File, L)), K > 0.
outside_lines(File, K) :- changed[diff](File, _), K is count(L : changed[diff](File, L), not in_some_fn(File, L)), K > 0.
hit_line(D, Name, File, L) :- changed[diff](File, L), site(D, Name, File, A, B), L >= A, L <= B.
hit(D, Name, K) :- entry(D, Name), K is count(File, L : hit_line(D, Name, File, L)), K > 0.

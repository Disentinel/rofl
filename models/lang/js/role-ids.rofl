is_a(N, program, tree) :- program[tree](N, _).
is_a(N, nth, tree) :- nth[tree](N, _, _).
is_a(N, strict, tree) :- strict[tree](N).
is_a(N, precedes, tree) :- precedes[tree](N, _).
is_a(N, ref, value) :- ref[value](N, _).  is_a(N, ref, type) :- ref[type](N, _).
is_a(N, binds, value) :- binds[value](N, _).  is_a(N, binds, type) :- binds[type](N, _).
is_a(N, key, value) :- key[value](N, _).  is_a(N, key, type) :- key[type](N, _).
is_a(N, key_expr, value) :- key_expr[value](N, _).  is_a(N, key_expr, type) :- key_expr[type](N, _).
is_a(N, literal, value) :- literal[value](N, _).  is_a(N, literal, type) :- literal[type](N, _).
is_a(N, template_part, value) :- template_part[value](N, _, _).  is_a(N, template_part, type) :- template_part[type](N, _, _).
is_a(N, callee, value) :- callee[value](N, _).  is_a(N, callee, type) :- callee[type](N, _).
is_a(N, tagged, value) :- tagged[value](N, _, _).  is_a(N, tagged, type) :- tagged[type](N, _, _).
is_a(N, spread_args, value) :- spread_args[value](N, _, _).  is_a(N, spread_args, type) :- spread_args[type](N, _, _).
is_a(N, body, value) :- body[value](N, _).  is_a(N, body, type) :- body[type](N, _).
is_a(N, param, value) :- param[value](N, _, _).  is_a(N, param, type) :- param[type](N, _, _).
is_a(N, rest_params, value) :- rest_params[value](N, _, _).  is_a(N, rest_params, type) :- rest_params[type](N, _, _).
is_a(N, constructs, value) :- constructs[value](N, _).  is_a(N, constructs, type) :- constructs[type](N, _).
is_a(N, getter, value) :- getter[value](N, _).  is_a(N, getter, type) :- getter[type](N, _).
is_a(N, setter, value) :- setter[value](N, _).  is_a(N, setter, type) :- setter[type](N, _).
is_a(N, returns, value) :- returns[value](N, _).  is_a(N, returns, type) :- returns[type](N, _).
is_a(N, yields, value) :- yields[value](N, _).  is_a(N, yields, type) :- yields[type](N, _).
is_a(N, delegates, value) :- delegates[value](N, _).  is_a(N, delegates, type) :- delegates[type](N, _).
is_a(N, awaits, value) :- awaits[value](N, _).  is_a(N, awaits, type) :- awaits[type](N, _).
is_a(N, member, value) :- member[value](N, _, _).  is_a(N, member, type) :- member[type](N, _, _).
is_a(N, member_expr, value) :- member_expr[value](N, _, _).  is_a(N, member_expr, type) :- member_expr[type](N, _, _).
is_a(N, assign, value) :- assign[value](N, _, _).  is_a(N, assign, type) :- assign[type](N, _, _).
is_a(N, decl, value) :- decl[value](N, _).  is_a(N, decl, type) :- decl[type](N, _).
is_a(N, target, value) :- target[value](N, _).  is_a(N, target, type) :- target[type](N, _).
is_a(N, gives, value) :- gives[value](N, _).  is_a(N, gives, type) :- gives[type](N, _).
is_a(N, pattern_prop, value) :- pattern_prop[value](N, _, _).  is_a(N, pattern_prop, type) :- pattern_prop[type](N, _, _).
is_a(N, pattern_elem, value) :- pattern_elem[value](N, _, _).  is_a(N, pattern_elem, type) :- pattern_elem[type](N, _, _).
is_a(N, rest_props, value) :- rest_props[value](N, _).  is_a(N, rest_props, type) :- rest_props[type](N, _).
is_a(N, rest_elems, value) :- rest_elems[value](N, _, _).  is_a(N, rest_elems, type) :- rest_elems[type](N, _, _).
is_a(N, has, value) :- has[value](N, _).  is_a(N, has, type) :- has[type](N, _).
is_a(N, value, value) :- value[value](N, _).  is_a(N, value, type) :- value[type](N, _).
is_a(N, extends, value) :- extends[value](N, _).  is_a(N, extends, type) :- extends[type](N, _).
is_a(N, static_block, value) :- static_block[value](N, _).  is_a(N, static_block, type) :- static_block[type](N, _).
is_a(N, decorated, value) :- decorated[value](N, _).  is_a(N, decorated, type) :- decorated[type](N, _).
is_a(N, spread_props, value) :- spread_props[value](N, _, _).  is_a(N, spread_props, type) :- spread_props[type](N, _, _).
is_a(N, spread_elems, value) :- spread_elems[value](N, _, _).  is_a(N, spread_elems, type) :- spread_elems[type](N, _, _).
is_a(N, passes, value) :- passes[value](N, _).  is_a(N, passes, type) :- passes[type](N, _).
is_a(N, binary, value) :- binary[value](N, _, _, _).  is_a(N, binary, type) :- binary[type](N, _, _, _).
is_a(N, unary, value) :- unary[value](N, _, _).  is_a(N, unary, type) :- unary[type](N, _, _).
is_a(N, logical, value) :- logical[value](N, _, _, _).  is_a(N, logical, type) :- logical[type](N, _, _, _).
is_a(N, executes_if, value) :- executes_if[value](N, _, _).  is_a(N, executes_if, type) :- executes_if[type](N, _, _).
is_a(N, executes_when, value) :- executes_when[value](N, _, _).  is_a(N, executes_when, type) :- executes_when[type](N, _, _).
is_a(N, repeats, value) :- repeats[value](N, _).  is_a(N, repeats, type) :- repeats[type](N, _).
is_a(N, iterates, value) :- iterates[value](N, _, _).  is_a(N, iterates, type) :- iterates[type](N, _, _).
is_a(N, enumerates, value) :- enumerates[value](N, _, _).  is_a(N, enumerates, type) :- enumerates[type](N, _, _).
is_a(N, exits, value) :- exits[value](N, _).  is_a(N, exits, type) :- exits[type](N, _).
is_a(N, throws, value) :- throws[value](N, _).  is_a(N, throws, type) :- throws[type](N, _).
is_a(N, tries, value) :- tries[value](N, _).  is_a(N, tries, type) :- tries[type](N, _).
is_a(N, label, value) :- label[value](N, _).  is_a(N, label, type) :- label[type](N, _).
is_a(N, namespace, value) :- namespace[value](N, _).  is_a(N, namespace, type) :- namespace[type](N, _).
is_a(N, module_ref, value) :- module_ref[value](N, _).  is_a(N, module_ref, type) :- module_ref[type](N, _).
is_a(N, declared, value) :- declared[value](N, _).  is_a(N, declared, type) :- declared[type](N, _).
is_a(N, implements, value) :- implements[value](N, _).  is_a(N, implements, type) :- implements[type](N, _).
is_a(N, bound, value) :- bound[value](N, _).  is_a(N, bound, type) :- bound[type](N, _).
is_a(N, M, value) :- mark[value](N, M).  is_a(N, M, type) :- mark[type](N, M).

role_node(N) :- is_a(N, _, _).
roles_of(N, G, M) :- role_node(N), role_group(G), M is sum(B ; B : is_a(N, R, W), role_bit(G, W, R, B)).
edb(role_group).
role_group(1). role_group(2). role_group(3). role_group(4).

-- its name, the first a node has of: what it binds, reads, keys, reaches as a member, or its literal value
-- (a function's own this and arguments are not its name)
binds_name(N, V) :- binds[value](N, V), V != "this", V != "arguments".
named(N, V) :- binds_name(N, V).
named(N, V) :- binds[type](N, V), not binds_name(N, _).
named(N, V) :- ref[value](N, V), not binds_name(N, _).
named(N, V) :- ref[type](N, V), not ref[value](N, _), not binds_name(N, _).
named(N, V) :- key[value](N, V), not ref[value](N, _), not binds_name(N, _).
named(N, V) :- member[value](N, _, V), not key[value](N, _).
named(N, V) :- literal[value](N, V), not member[value](N, _, _), not key[value](N, _).

-- the role parent: the nearest ancestor that plays a role
up(C, A) :- parent[tree](A, C).
role_up(C, A) :- up(C, A), role_node(A).
role_up(C, A) :- up(C, X), not role_node(X), role_up(X, A).
role_parent(C, P) :- role_node(C), role_up(C, P).
-- the role tree, declared so: one parent each, and an id is minted only walking down it
role_tree(P, C) :- role_parent(C, P).
tree role_tree(P, C) closure role_below.

-- the children in source order
order(C, R) :- role_parent(C, P), pos[tree](C, O), R is count(D : role_parent(D, P), pos[tree](D, OD), OD < O).
kids(P, K) :- role_node(P), K is count(C : role_parent(C, P)).

-- a node alone (its roles and name), then its shape: the node and its children's shapes in order, a
-- function or a class cut to the node alone, so an edit inside a body leaves the shapes around it
what(N, H) :- roles_of(N, 1, M1), roles_of(N, 2, M2), roles_of(N, 3, M3), roles_of(N, 4, M4),
              H1 is hash(shape, M1), H2 is hash(H1, M2), H3 is hash(H2, M3), H is hash(H3, M4).
alone(N, H) :- what(N, H0), named(N, V), H is hash(H0, V).
alone(N, H) :- what(N, H), not named(N, _).
cut(N) :- body[value](N, _).
cut(N) :- mark[value](N, class).
fold(N, 0, H) :- alone(N, H).
fold(N, R1, H) :- fold(N, R, H0), role_parent(C, N), order(C, R), part(C, X), H is hash(H0, X), R1 is R + 1.
shape(N, H) :- kids(N, K), fold(N, K, H).
part(C, X) :- cut(C), alone(C, X).
part(C, X) :- not cut(C), shape(C, X).

-- the step: a named node by itself alone, an unnamed one by its shape; equal steps under one parent counted
id_step(C, S) :- named(C, _), alone(C, S).
id_step(C, S) :- not named(C, _), shape(C, S).
nth_equal(C, K) :- role_parent(C, P), id_step(C, S), pos[tree](C, O),
                   K is count(D : role_parent(D, P), id_step(D, S), pos[tree](D, OD), OD < O).

rid(P, P) :- program[tree](P, _).
rid(C, Id) :- rid(P, PI), role_tree(P, C), id_step(C, S), nth_equal(C, K), H is hash(PI, S), Id is hash(H, K).

-- two nodes of a file under one id: the ids are not yet a name
rid_shared[audit](Id, A, B) :- rid(A, Id), rid(B, Id), A != B.

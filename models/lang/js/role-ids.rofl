-- role-ids.rofl — an id for every node that plays a role, from the roles alone, so that two parsers
-- that give a file the same roles give its nodes the same ids.
--
-- Reads only [tree], [value] and [type] (and pos[tree], where a node starts in the source); nothing
-- of a parser. The program is named by its file's volume; every other node by its role parent's id
-- and its step: its name when it has one, else its shape (its roles, its name and its children's
-- shapes in source order, cut at a body), and how many earlier siblings share that step. Neither a
-- line nor a position goes into an id, so code added above a node leaves it.
--
--   rid(N, Id)   the role id of node N

-- what a node is: every role whose subject it is, in each world, and every mark; 4 sets of at most 40, each
-- one bit per role, summed (40 bits, so a sum stays exact in either engine)
edb(role_bit).
role_bit(1, tree, program, 1).
role_bit(1, tree, nth, 2).
role_bit(1, tree, strict, 4).
role_bit(1, tree, precedes, 8).
role_bit(1, value, ref, 16).
role_bit(1, value, binds, 32).
role_bit(1, value, key, 64).
role_bit(1, value, key_expr, 128).
role_bit(1, value, literal, 256).
role_bit(1, value, template_part, 512).
role_bit(1, value, callee, 1024).
role_bit(1, value, tagged, 2048).
role_bit(1, value, spread_args, 4096).
role_bit(1, value, body, 8192).
role_bit(1, value, param, 16384).
role_bit(1, value, rest_params, 32768).
role_bit(1, value, constructs, 65536).
role_bit(1, value, getter, 131072).
role_bit(1, value, setter, 262144).
role_bit(1, value, returns, 524288).
role_bit(1, value, yields, 1048576).

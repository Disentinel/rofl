-- models/lang/js/rules/js-surface.rofl — WHAT A FILE OFFERS THE OTHERS (exports, what a call hands a function, the
-- nodes that leave their file), as relations of [flow] like any other. There is no book of what crosses files: the
-- engine finds that from the rules' keys and reads another file's fact as a lemma where a rule reads it
-- (f_surface_is_replaced_by_lemmas_by_keys). A call of a function whose return is its own parameter takes that call's
-- argument (`sx_ret_param`), not every caller's.

-- ---------------------------------------------------------------- what escapes
sx_esc[flow](N) :- exports_name[code](N, _, _).
sx_esc[flow](N) :- exports_default[code](N, _).
sx_esc[flow](N) :- cjs_exports[flow](_, N).
sx_esc[flow](N) :- sx_module[flow](_, N).
sx_esc[flow](N) :- sx_arg_node[flow](_, _, N).
sx_esc[flow](N) :- sx_ret_node[flow](_, N).
sx_esc[flow](N) :- sx_ret_pnode[flow](_, N).
sx_esc[flow](N) :- sx_gen_ret[flow](_, N).
sx_esc[flow](N) :- next_send[flow](_, N).
sx_esc[flow](F) :- sx_cb[flow](F, _).
sx_esc[flow](A) :- sx_rest_elem[flow](_, _, A).
sx_esc[flow](I) :- sx_sub_inst[flow](_, I).
sx_esc[flow](I) :- sx_esc[flow](C), inst_of[flow](I, C).
sx_esc[flow](C) :- sx_esc[flow](I), inst_of[flow](I, C).
sx_esc[flow](C) :- sx_esc[flow](I), isa[flow](I, C).
-- ... and what an escaping node holds
sx_esc[flow](M) :- sx_esc[flow](N), node_of[flow](N, M).
sx_esc[flow](V) :- sx_esc[flow](O), member_value[flow](O, _, V).
sx_esc[flow](E) :- sx_esc[flow](A), array_elem[flow](A, _, E).
sx_esc[flow](V) :- sx_esc[flow](X), keyed_put[flow](X, _, V).
sx_esc[flow](V) :- sx_esc[flow](G), thrown_by[flow](G, V).
sx_esc[flow](E) :- sx_esc[flow](G), yields[flow](G, E).

-- ---------------------------------------------------------------- an escaping node's facts, and their mirrors
sx_node[flow](N, M)       :- sx_esc[flow](N), may_be[flow](N, node, M).
sx_lit[flow](N, V)        :- sx_esc[flow](N), may_be[flow](N, lit, V).
sx_elem[flow](A, I, E)    :- sx_esc[flow](A), array_elem[flow](A, I, E).
sx_name[flow](E, Name)    :- sx_elem[flow](_, _, E), ref[value](E, Name).
sx_fn[flow](F)            :- sx_esc[flow](F), fn_node[code](F).
sx_fn_name[flow](F, A)    :- sx_esc[flow](F), fn_name[code](F, A).
sx_sub_inst[flow](C, I) :- sx_esc[flow](C), sub_inst[flow](C, I).
sx_drops_any[flow](F) :- sx_esc[flow](F), drops_any[code](F).
sx_dwalked[flow](H)    :- sx_drops_any[flow](F), dcall[code](F, H).
sx_dwalked[flow](H)    :- sx_dwalked[flow](F), dcall[code](F, H).
sx_dcall[flow](F, H)   :- sx_drops_any[flow](F), dcall[code](F, H).
sx_dcall[flow](F, H)   :- sx_dwalked[flow](F), dcall[code](F, H).

may_be[flow](N, node, M)      :- sx_node[flow](N, M).
may_be[flow](N, lit, V)       :- sx_lit[flow](N, V).
-- `fn_node`, `fn_name` and `in_fn` are syntax and are negated below the flow, so a function read as a VALUE, which may be
-- another file's, is asked in [flow]: `fn_value`, `fn_label`, `fn_nested`.
view fn_value(A).
fn_value[flow](F)             :- fn_node[code](F).
fn_value[flow](F)             :- sx_fn[flow](F).
fn_label[flow](F, A)          :- fn_name[code](F, A).
fn_label[flow](F, A)          :- sx_fn_name[flow](F, A).
fn_nested[flow](F)            :- fn_node[code](F), in_fn[code](F).
dcall[code](F, H)             :- sx_dcall[flow](F, H).

-- ---------------------------------------------------------------- exports, by the module's path
sx_export_lit[flow](File, Name, V)  :- exports_value[code](X, Name, File), lit_of[flow](X, V).
sx_module[flow](File, P)            :- corpus_file[code](File), module_object[flow](P, File).
-- ---------------------------------------------------------------- what a call hands its callee
sx_arg_lit[flow](F, I, V)  :- resolves[code](C, F), arg_at[flow](C, I, A), lit_of[flow](A, V).
sx_arg_node[flow](F, I, N) :- resolves[code](C, F), arg_at[flow](C, I, A), node_of[flow](A, N).
view sx_called(A).
sx_called[flow](F)         :- resolves[code](_, F).
-- how many arguments a call hands over, where it is known (no spread): a parameter past them is `undefined`
view arg_given(A).
arg_given[code](C)     :- argument_at[code](C, _, _).
arg_count[code](C, 0)  :- callee[value](C, _), not arg_given[code](C).
arg_count[code](C, N)  :- argument_at[code](C, I, _), N is I + 1, not argument_at[code](C, N, _),

                          not call_spreads[code](C).
sx_arg_short[flow](F, N) :- resolves[code](C, F), arg_count[code](C, N).
may_be[flow](U, lit, undefined) :- sx_arg_short[flow](F, N), param_of[flow](F, I, Name), I >= N,
                                   param_use[flow](F, Name, U).
sx_reached[flow](F)        :- resolves[code](C, F), not guarded[code](C).
sx_reach[flow](F)          :- resolves[code](C, F), not guarded[code](C), not in_fn[code](C).
sx_reach[flow](F)          :- reachable[code](G), nearest_v[flow](G, C), resolves[code](C, F), not guarded[code](C).
sx_rest_elem[flow](R, K, A) :- param_rest[code](F, J, R, _), resolves[code](C, F), arg_at[flow](C, I, A),
                                  I >= J, K is I - J.
-- a function handed to an external call is called back by code the corpus cannot see
sx_cb[flow](F, Spec)       :- external_value[flow](X, Spec), node_of[flow](G, X),
                                 callee[value](C, G), call_like[code](C),
                                 nth[tree](C, _, A), not spread_args[value](C, _, A), node_of[flow](A, F), fn_value[flow](F).

array_elem[flow](R, K, A) :- sx_rest_elem[flow](R, K, A).

-- ---------------------------------------------------------------- what a call gets back
-- A return that is the function's own parameter, read as nothing else: a plain identifier parameter, never assigned,
-- not redeclared where it is read. Its value at a call is that call's argument; the other returns are the summary.
param_assigned[flow](F, Name) :- assign_param[flow](A, F), assigned[code](A, _, Name, _, _).
-- A generator's call is a generator object (models/lang/js/rules/js-dataflow.rofl, `gen_of`): its `return` is what `yield*` gets, not
-- what the call is.
call_returns[flow](F, E) :- returns[flow](F, E), not generator[value](F).
param_read[flow](F, I, E) :- param_use[flow](F, Name, E), param_of[flow](F, I, Name),
                             param[value](F, I, P), parent[tree](F, P), binds[value](P, _),
                             not param_assigned[flow](F, Name), not sees_binder[code](E, _).
ret_param[flow](F, I, E) :- call_returns[flow](F, E), param_read[flow](F, I, E).
ret_plain[flow](F, E) :- call_returns[flow](F, E), not ret_param[flow](F, _, E).

sx_ret_node[flow](F, N)  :- ret_plain[flow](F, E), node_of[flow](E, N).
sx_ret_lit[flow](F, V)   :- ret_plain[flow](F, E), lit_of[flow](E, V).
sx_ret_pnode[flow](F, N) :- ret_param[flow](F, _, E), node_of[flow](E, N).
sx_ret_plit[flow](F, V)  :- ret_param[flow](F, _, E), lit_of[flow](E, V).
sx_ret_param[flow](F, I) :- ret_param[flow](F, I, _).
-- the summary a call applies: what the function returns of its own, and which of its inputs it returns; an input of
-- an enclosing function is returned as the values it holds
sx_ret_own[flow](F, node, N) :- call_returns[flow](F, E), own_node[flow](E, N).
sx_ret_own[flow](F, lit, V)  :- call_returns[flow](F, E), may_be[flow](E, lit, V).
sx_ret_own[flow](F, node, N) :- call_returns[flow](F, E), may_be[flow](E, input, S), input_of[flow](S, G), G != F,
                                   input_node[flow](S, N).
sx_ret_own[flow](F, lit, V)  :- call_returns[flow](F, E), may_be[flow](E, input, S), input_of[flow](S, G), G != F,
                                   input_lit[flow](S, V).
sx_ret_input[flow](F, I)     :- call_returns[flow](F, E), may_be[flow](E, input, S), input_param[flow](S, F, I).
sx_ret_field[flow](F, Key)   :- call_returns[flow](F, E), may_be[flow](E, input, field(F, Key)).
sx_ret_pfield[flow](F, I, Key) :- call_returns[flow](F, E), may_be[flow](E, input, pfield(S, Key)), input_param[flow](S, F, I).
pfield_of[flow](pfield(S, K), G) :- pkey[flow](S, K), input_param[flow](S, G, _).
sx_ret_own[flow](F, node, N) :- call_returns[flow](F, E), may_be[flow](E, input, T), pfield_of[flow](T, G), G != F, input_node[flow](T, N).
sx_ret_own[flow](F, lit, V)  :- call_returns[flow](F, E), may_be[flow](E, input, T), pfield_of[flow](T, G), G != F, input_lit[flow](T, V).
sx_ret_hop[flow](F, K, M2)   :- call_returns[flow](F, E), may_be[flow](E, input, hop(F, K, M2)).
sx_ret_inst[flow](F)         :- sx_ret_field[flow](F, _).
sx_ret_inst[flow](F)         :- sx_ret_hop[flow](F, _, _).
sx_ret_self[flow](F)         :- call_returns[flow](F, E), may_be[flow](E, input, S), input_this[flow](S, F).
sx_ret_this[flow](F, I)      :- call_returns[flow](F, E), may_be[flow](E, input, S), input_this[flow](S, F),
                                   input_node[flow](S, I).
-- a function that may end without a value: its body may complete normally (`completes_abruptly` names those that
-- cannot), or a `return` has no argument. Its call is `undefined` there; a constructor's `new` is the instance.
falls_off[code](F) :- body[value](F, B), not returns[value](F, B), not completes_abruptly[code](B).
falls_off[code](F) :- exits[value](R, return), not returns[value](R, _), nearest_v[flow](F, R).
sx_ret_undef[flow](F) :- falls_off[code](F), not generator[value](F), not ctor_method[code](F).
may_be[flow](C, lit, undefined) :- call_site[code](C, _), resolves[code](C, F), sx_ret_undef[flow](F).
sx_gen_ret[flow](F, N)   :- returns[flow](F, E), generator[value](F), node_of[flow](E, N).
sx_gen_rlit[flow](F, V)  :- returns[flow](F, E), generator[value](F), lit_of[flow](E, V).

-- ---------------------------------------------------------------- what a call writes
-- `o[k] = v` with k and v the function's own parameters (`on(name, handler)`): at a call, THAT call's value under
-- THAT call's key, not every value under every key.
store_pkey[flow](F, J, I, A) :- assign[value](A, L, V), plain_assign[flow](A), computed_key[code](L, Q),
                                param_read[flow](F, J, Q), param_read[flow](F, I, V).
store_sym[flow](A) :- store_pkey[flow](_, _, _, A).
sx_store_pkey[flow](F, J, I, O) :- store_pkey[flow](F, J, I, A), assign[value](A, L, _),
                                      object_of[code](L, Obj), node_of[flow](Obj, O).
sx_mwrite[flow](O, K, A) :- sx_store_pkey[flow](F, J, I, O), resolves[code](C, F),
                               arg_at[flow](C, J, B), lit_of[flow](B, K), arg_at[flow](C, I, A).

-- every value the function's returns may be, whoever called it: the iterator protocol and `yield*` read this
ret_node_any[flow](F, N) :- sx_ret_node[flow](F, N).
ret_node_any[flow](F, N) :- sx_ret_pnode[flow](F, N).
ret_node_any[flow](F, N) :- sx_gen_ret[flow](F, N).

imports(flow, code).

imports(code, flow).

imports(audit, flow).

-- babel-roles.rofl — THE BABEL CONVERTER: the raw tree of scanners/js_ast.ts in [ast_babel] becomes the roles of
-- roles.rofl in [value] (w_l2_roles). It reads one node and its neighbours and nothing further, so a file's roles are
-- the same alone and in a world (npm run test:roles). It writes [value], [type] and the shared [tree]. Where a kind maps one to one it is a row of a table and one rule
-- reads the table; the rest are rules. A negation here reads only a table or the raw tree, never a role.
--
-- Babel's own words stay here: no rule of the model reads [ast_babel]. A kind of the tree that stands in no role is
-- written down with its reason (`no_role`), and `kind_without_role[audit]` is a kind that has neither.

edb(node). edb(line). edb(start). edb(child). edb(attr). edb(file).
imports(ast_babel, main). imports(ast_babel, value). imports(ast_babel, type). imports(ast_babel, tree).
imports(value, ast_babel). imports(type, ast_babel). imports(tree, ast_babel).
imports(value, tree). imports(audit, ast_babel).

-- =====================================================================================================================
-- PLACE

program[tree](P, File)  :- node[ast_babel](P, program, File).
parent[tree](P, C)      :- child[ast_babel](P, _, _, C), node[ast_babel](P, K, _), K != file.
-- the place of every node, so the raw tree need not stay beside the roles; Babel's File node above the Program
-- dissolves: the file is named by program and at, and stands as itself in the fs_* facts of the host
at[tree](N, File, Line)  :- node[ast_babel](N, K, File), K != file, line[ast_babel](N, Line).
pos[tree](N, O)          :- node[ast_babel](N, K, _), K != file, start[ast_babel](N, O).

-- the exports of a module are an object, and the program is it
namespace[value](P, P)   :- node[ast_babel](P, program, _).

-- =====================================================================================================================
-- MARKS

edb(kind_mark).
kind_mark[ast_babel](call_expression, call).            kind_mark[ast_babel](optional_call_expression, call).
kind_mark[ast_babel](import_expression, call).
kind_mark[ast_babel](new_expression, construct).
kind_mark[ast_babel](this_expression, this).            kind_mark[ast_babel](super, super).
kind_mark[ast_babel](object_expression, object).        kind_mark[ast_babel](tsenum_declaration, object).
kind_mark[ast_babel](array_expression, array).
kind_mark[ast_babel](class_declaration, class).         kind_mark[ast_babel](class_expression, class).
kind_mark[ast_babel](template_literal, template).
kind_mark[ast_babel](class_private_property, private).  kind_mark[ast_babel](class_private_method, private).
kind_mark[ast_babel](tsdeclare_function, ambient).      kind_mark[ast_babel](tsdeclare_method, ambient).
kind_mark[ast_babel](program, scope).                   kind_mark[ast_babel](block_statement, scope).
kind_mark[ast_babel](static_block, scope).              kind_mark[ast_babel](catch_clause, scope).
kind_mark[ast_babel](for_statement, scope).             kind_mark[ast_babel](for_in_statement, scope).
kind_mark[ast_babel](for_of_statement, scope).          kind_mark[ast_babel](switch_statement, scope).
kind_mark[ast_babel](tsmodule_block, scope).
kind_mark[ast_babel](function_declaration, scope).      kind_mark[ast_babel](function_expression, scope).
kind_mark[ast_babel](arrow_function_expression, scope). kind_mark[ast_babel](object_method, scope).
kind_mark[ast_babel](class_method, scope).              kind_mark[ast_babel](class_private_method, scope).
mark[value](N, M) :- kind_mark[ast_babel](K, M), node[ast_babel](N, K, _).

edb(attr_mark).
attr_mark[ast_babel](async, true, async).
attr_mark[ast_babel](generator, true, generator).
attr_mark[ast_babel](static, true, static).
attr_mark[ast_babel](declare, true, ambient).
mark[value](N, M) :- attr_mark[ast_babel](A, V, M), attr[ast_babel](N, A, V).

edb(optional_kind).
optional_kind[ast_babel](optional_member_expression). optional_kind[ast_babel](optional_call_expression).
mark[value](N, optional) :- optional_kind[ast_babel](K), node[ast_babel](N, K, _), attr[ast_babel](N, optional, true).

mark[value](M, new_target)  :- node[ast_babel](M, meta_property, _), child[ast_babel](M, meta, 0, C),
                               attr[ast_babel](C, name, "new").
mark[value](M, import_meta) :- node[ast_babel](M, meta_property, _), child[ast_babel](M, meta, 0, C),
                               attr[ast_babel](C, name, "import").
mark[value](N, private)     :- member_kind[ast_babel](K), node[ast_babel](N, K, _), child[ast_babel](N, property, 0, P),
                               node[ast_babel](P, private_name, _).

-- =====================================================================================================================
-- THE ORDER OF EVALUATION: nth
--
-- A sequence field gives its members from Offset on; a step field one child at its position. A call is its callee
-- (step 0), then its arguments (steps 1..n). Three wrappers are stepped through: the statement around an expression,
-- the label around a statement (the label goes onto the statement) and the spread around a value (the spread is a
-- role of the parent).

edb(seq_field).
seq_field[ast_babel](program, body, 0).                 seq_field[ast_babel](block_statement, body, 0).
seq_field[ast_babel](static_block, body, 0).            seq_field[ast_babel](tsmodule_block, body, 0).
seq_field[ast_babel](switch_case, consequent, 0).       seq_field[ast_babel](sequence_expression, expressions, 0).
seq_field[ast_babel](array_expression, elements, 0).    seq_field[ast_babel](object_expression, properties, 0).
seq_field[ast_babel](call_expression, arguments, 0).    seq_field[ast_babel](optional_call_expression, arguments, 0).
seq_field[ast_babel](new_expression, arguments, 0).     seq_field[ast_babel](variable_declaration, declarations, 0).
seq_field[ast_babel](template_literal, expressions, 0).

edb(step_field).
step_field[ast_babel](member_expression, object, 0).    step_field[ast_babel](optional_member_expression, object, 0).
step_field[ast_babel](binary_expression, left, 0).      step_field[ast_babel](binary_expression, right, 1).
step_field[ast_babel](logical_expression, left, 0).
step_field[ast_babel](assignment_expression, left, 0).
step_field[ast_babel](unary_expression, argument, 0).   step_field[ast_babel](update_expression, argument, 0).
step_field[ast_babel](await_expression, argument, 0).   step_field[ast_babel](yield_expression, argument, 0).
step_field[ast_babel](return_statement, argument, 0).   step_field[ast_babel](throw_statement, argument, 0).
step_field[ast_babel](conditional_expression, test, 0). step_field[ast_babel](if_statement, test, 0).
step_field[ast_babel](while_statement, test, 0).
step_field[ast_babel](do_while_statement, body, 0).     step_field[ast_babel](do_while_statement, test, 1).
step_field[ast_babel](for_statement, init, 0).          step_field[ast_babel](for_statement, test, 1).
step_field[ast_babel](for_in_statement, right, 0).      step_field[ast_babel](for_of_statement, right, 0).
step_field[ast_babel](switch_statement, discriminant, 0).
step_field[ast_babel](variable_declarator, init, 0).    step_field[ast_babel](variable_declarator, id, 1).
step_field[ast_babel](class_declaration, super_class, 0). step_field[ast_babel](class_expression, super_class, 0).
step_field[ast_babel](export_default_declaration, declaration, 0).
step_field[ast_babel](export_named_declaration, declaration, 0).
step_field[ast_babel](catch_clause, body, 0).
step_field[ast_babel](try_statement, finalizer, 1).
step_field[ast_babel](import_expression, source, 0).    step_field[ast_babel](import_expression, options, 1).
step_field[ast_babel](tsexport_assignment, expression, 0).
step_field[ast_babel](parenthesized_expression, expression, 0). step_field[ast_babel](tsas_expression, expression, 0).
step_field[ast_babel](tssatisfies_expression, expression, 0).  step_field[ast_babel](tsnon_null_expression, expression, 0).
step_field[ast_babel](tstype_assertion, expression, 0).        step_field[ast_babel](tsinstantiation_expression, expression, 0).

edb(steps_through).
steps_through[ast_babel](expression_statement, expression).
steps_through[ast_babel](labeled_statement, body).
steps_through[ast_babel](spread_element, argument).

b_slot[ast_babel](Seq, I, S) :- seq_field[ast_babel](K, F, Off), node[ast_babel](Seq, K, _),
                                child[ast_babel](Seq, F, J, S), I is J + Off.
b_slot[ast_babel](Seq, I, S) :- step_field[ast_babel](K, F, I), node[ast_babel](Seq, K, _), child[ast_babel](Seq, F, 0, S).
-- the property of `o[k]`, the computed key and the value of a property in an object literal
b_slot[ast_babel](M, 1, E)   :- member_kind[ast_babel](K), node[ast_babel](M, K, _), attr[ast_babel](M, computed, true),
                                child[ast_babel](M, property, 0, E).
b_slot[ast_babel](P, 0, E)   :- b_literal_prop[ast_babel](P), attr[ast_babel](P, computed, true),
                                child[ast_babel](P, key, 0, E).
b_slot[ast_babel](P, 1, V)   :- b_literal_prop[ast_babel](P), attr[ast_babel](P, computed, true),
                                child[ast_babel](P, value, 0, V).
b_slot[ast_babel](P, 0, V)   :- b_literal_prop[ast_babel](P), attr[ast_babel](P, computed, false),
                                child[ast_babel](P, value, 0, V).
-- an assignment that is not logical evaluates its value unconditionally
b_slot[ast_babel](A, 1, R)   :- node[ast_babel](A, assignment_expression, _), attr[ast_babel](A, operator, "="),
                                child[ast_babel](A, right, 0, R).
b_slot[ast_babel](A, 1, R)   :- node[ast_babel](A, assignment_expression, _), attr[ast_babel](A, operator, Op),
                                compound_op[ast_babel](Op, _), child[ast_babel](A, right, 0, R).
-- the tests of a switch, after its discriminant and in their order
b_slot[ast_babel](Sw, J, T)  :- child[ast_babel](Sw, cases, I, C), child[ast_babel](C, test, 0, T), J is I + 1.
-- try without a handler runs its block as a step
b_slot[ast_babel](T, 0, B)   :- child[ast_babel](T, block, 0, B), not child[ast_babel](T, handler, 0, _).
-- a loop with no test runs its body every time
b_slot[ast_babel](L, 2, B)   :- node[ast_babel](L, for_statement, _), child[ast_babel](L, body, 0, B),
                                not child[ast_babel](L, test, 0, _).

b_literal_prop[ast_babel](P) :- node[ast_babel](O, object_expression, _), child[ast_babel](O, properties, _, P),
                                node[ast_babel](P, object_property, _).

-- a child as the model sees it: through the wrappers
-- b_through(S, X): the wrapper S stands for X; a child that is no wrapper stands for itself
b_through[ast_babel](S, X) :- node[ast_babel](S, K, _), steps_through[ast_babel](K, F), child[ast_babel](S, F, 0, X),
                              node[ast_babel](X, KX, _), not steps_through[ast_babel](KX, _).
b_through[ast_babel](S, X) :- node[ast_babel](S, K, _), steps_through[ast_babel](K, F), child[ast_babel](S, F, 0, Y),
                              b_through[ast_babel](Y, X).

nth[tree](Seq, I, S) :- b_slot[ast_babel](Seq, I, S), node[ast_babel](S, K, _), not steps_through[ast_babel](K, _).
nth[tree](Seq, I, X) :- b_slot[ast_babel](Seq, I, S), b_through[ast_babel](S, X).
-- every sequence of the value world executes in the order of its positions
strict[tree](Seq) :- b_slot[ast_babel](Seq, _, _).
-- beside a spread the order is more than the positions: the spread runs an iterator or getters between them, so
-- what is spread and its neighbour are said in order (A and B the spread's argument, or the plain element)
edb(spread_seq).
spread_seq[ast_babel](call_expression, arguments).  spread_seq[ast_babel](optional_call_expression, arguments).
spread_seq[ast_babel](new_expression, arguments).   spread_seq[ast_babel](array_expression, elements).
spread_seq[ast_babel](object_expression, properties).
b_spread_pos[ast_babel](S, I, X, plain)  :- spread_seq[ast_babel](K, F), node[ast_babel](S, K, _), child[ast_babel](S, F, I, X),
                                            node[ast_babel](X, KX, _), KX != spread_element.
b_spread_pos[ast_babel](S, I, X, spread) :- spread_seq[ast_babel](K, F), node[ast_babel](S, K, _), child[ast_babel](S, F, I, E),
                                            node[ast_babel](E, spread_element, _), child[ast_babel](E, argument, 0, X).
precedes[tree](A, B) :- b_spread_pos[ast_babel](S, I, A, spread), J is I + 1, b_spread_pos[ast_babel](S, J, B, _).
precedes[tree](A, B) :- b_spread_pos[ast_babel](S, I, A, plain), J is I + 1, b_spread_pos[ast_babel](S, J, B, spread).

-- =====================================================================================================================
-- CONTROL

edb(cond_field).
cond_field[ast_babel](if_statement, consequent, test, truthy).
cond_field[ast_babel](if_statement, alternate, test, falsy).
cond_field[ast_babel](conditional_expression, consequent, test, truthy).
cond_field[ast_babel](conditional_expression, alternate, test, falsy).
cond_field[ast_babel](while_statement, body, test, truthy).
cond_field[ast_babel](for_statement, body, test, truthy).
cond_field[ast_babel](for_statement, update, test, truthy).
cond_field[ast_babel](for_of_statement, body, right, next).
cond_field[ast_babel](for_of_statement, left, right, next).
cond_field[ast_babel](for_in_statement, body, right, next).
cond_field[ast_babel](for_in_statement, left, right, next).
cond_field[ast_babel](try_statement, handler, block, thrown).
cond_field[ast_babel](logical_expression, right, left, by_operator).
cond_field[ast_babel](assignment_expression, right, left, by_operator).

edb(logical_how).
logical_how[ast_babel]("&&", truthy).  logical_how[ast_babel]("||", falsy).  logical_how[ast_babel]("??", nullish).
logical_how[ast_babel]("&&=", truthy). logical_how[ast_babel]("||=", falsy). logical_how[ast_babel]("??=", nullish).

b_branch[ast_babel](S, N, G, How) :- cond_field[ast_babel](K, F, GF, How), How != by_operator, node[ast_babel](S, K, _),
                                     child[ast_babel](S, F, 0, N), child[ast_babel](S, GF, 0, G).
b_branch[ast_babel](S, N, G, How) :- cond_field[ast_babel](K, F, GF, by_operator), node[ast_babel](S, K, _),
                                     attr[ast_babel](S, operator, Op), logical_how[ast_babel](Op, How),
                                     child[ast_babel](S, F, 0, N), child[ast_babel](S, GF, 0, G).
executes_if[value](N, G, How) :- b_branch[ast_babel](_, N, G, How), node[ast_babel](N, K, _), not steps_through[ast_babel](K, _).
executes_if[value](X, G, How) :- b_branch[ast_babel](_, N, G, How), b_through[ast_babel](N, X).
-- the tail of `?.` runs when what it reads is defined
executes_if[value](N, O, defined) :- mark[value](N, optional), child[ast_babel](N, object, 0, O).
executes_if[value](N, O, defined) :- mark[value](N, optional), child[ast_babel](N, callee, 0, O).
-- a case runs when its test matches
executes_if[value](C, T, matches) :- node[ast_babel](C, switch_case, _), child[ast_babel](C, test, 0, T).

edb(loop_kind).
loop_kind[ast_babel](for_statement). loop_kind[ast_babel](for_in_statement). loop_kind[ast_babel](for_of_statement).
loop_kind[ast_babel](while_statement). loop_kind[ast_babel](do_while_statement).
repeats[value](S, B)    :- loop_kind[ast_babel](K), node[ast_babel](S, K, _), child[ast_babel](S, body, 0, B),
                           node[ast_babel](B, KB, _), not steps_through[ast_babel](KB, _).
repeats[value](S, X)    :- loop_kind[ast_babel](K), node[ast_babel](S, K, _), child[ast_babel](S, body, 0, B),
                           b_through[ast_babel](B, X).
iterates[value](S, L, R)   :- node[ast_babel](S, for_of_statement, _), child[ast_babel](S, left, 0, L),
                              child[ast_babel](S, right, 0, R).
enumerates[value](S, L, R) :- node[ast_babel](S, for_in_statement, _), child[ast_babel](S, left, 0, L),
                              child[ast_babel](S, right, 0, R).

edb(exit_kind).
exit_kind[ast_babel](return_statement, return). exit_kind[ast_babel](break_statement, break).
exit_kind[ast_babel](continue_statement, continue). exit_kind[ast_babel](throw_statement, throw).
exits[value](J, How)   :- exit_kind[ast_babel](K, How), node[ast_babel](J, K, _).
throws[value](T, V)    :- node[ast_babel](T, throw_statement, _), child[ast_babel](T, argument, 0, V).
tries[value](T, B)     :- child[ast_babel](T, block, 0, B), child[ast_babel](T, handler, 0, _).

label[value](X, Name)  :- node[ast_babel](L, labeled_statement, _), child[ast_babel](L, label, 0, I),
                          attr[ast_babel](I, name, Name), child[ast_babel](L, body, 0, X),
                          node[ast_babel](X, K, _), not steps_through[ast_babel](K, _).
label[value](X, Name)  :- node[ast_babel](L, labeled_statement, _), child[ast_babel](L, label, 0, I),
                          attr[ast_babel](I, name, Name), child[ast_babel](L, body, 0, B), b_through[ast_babel](B, X).
label[value](J, Name)  :- exit_kind[ast_babel](K, _), node[ast_babel](J, K, _), child[ast_babel](J, label, 0, I),
                          attr[ast_babel](I, name, Name).

-- what runs after an await runs later: every later step of each sequence the suspension is inside, up to
-- its function
b_up[ast_babel](A, A)  :- node[ast_babel](A, await_expression, _).
b_up[ast_babel](A, S)  :- b_up[ast_babel](A, X), nth[tree](S, _, X).
-- the callee is no step of its call; it is evaluated before the arguments, and so before the call
b_up[ast_babel](A, C)  :- b_up[ast_babel](A, X), callee[value](C, X).
b_up[ast_babel](A, C)  :- b_up[ast_babel](A, X), tagged[value](C, X, _).
b_up[ast_babel](A, S)  :- b_up[ast_babel](A, X), executes_if[value](X, _, _), parent[tree](S, X).
executes_when[value](Next, A, microtask) :- b_up[ast_babel](A, S), nth[tree](Seq, I, S), nth[tree](Seq, J, Next), J > I.
executes_when[value](Arg, A, microtask)  :- b_up[ast_babel](A, N), callee[value](C, N), nth[tree](C, _, Arg).

-- =====================================================================================================================
-- FUNCTIONS

edb(fn_kind).
fn_kind[ast_babel](function_declaration). fn_kind[ast_babel](function_expression). fn_kind[ast_babel](arrow_function_expression).
fn_kind[ast_babel](object_method). fn_kind[ast_babel](class_method). fn_kind[ast_babel](class_private_method).
fn_kind[ast_babel](tsdeclare_function). fn_kind[ast_babel](tsdeclare_method).

edb(this_binder).
this_binder[ast_babel](function_declaration). this_binder[ast_babel](function_expression). this_binder[ast_babel](object_method).
this_binder[ast_babel](class_method). this_binder[ast_babel](class_private_method).

body[value](F, B)  :- fn_kind[ast_babel](K), node[ast_babel](F, K, _), child[ast_babel](F, body, 0, B).
binds[value](F, "this")      :- this_binder[ast_babel](K), node[ast_babel](F, K, _).
binds[value](F, "arguments") :- this_binder[ast_babel](K), node[ast_babel](F, K, _).
-- an arrow whose body is an expression returns it
returns[value](F, E) :- node[ast_babel](F, arrow_function_expression, _), child[ast_babel](F, body, 0, E),
                        node[ast_babel](E, K, _), K != block_statement.
returns[value](R, E) :- node[ast_babel](R, return_statement, _), child[ast_babel](R, argument, 0, E).
yields[value](Y, E)    :- node[ast_babel](Y, yield_expression, _), attr[ast_babel](Y, delegate, false),
                          child[ast_babel](Y, argument, 0, E).
delegates[value](Y, E) :- node[ast_babel](Y, yield_expression, _), attr[ast_babel](Y, delegate, true),
                          child[ast_babel](Y, argument, 0, E).
awaits[value](A, X)    :- node[ast_babel](A, await_expression, _), child[ast_babel](A, argument, 0, X).

-- a parameter is what stands in its slot, through a default and through a TS parameter property
edb(param_kind).
param_kind[ast_babel](tsmethod_signature). param_kind[ast_babel](tsfunction_type). param_kind[ast_babel](tsconstructor_type).
param_kind[ast_babel](tscall_signature_declaration). param_kind[ast_babel](tsconstruct_signature_declaration).
b_fn[ast_babel](F)     :- fn_kind[ast_babel](K), node[ast_babel](F, K, _).
b_param[ast_babel](F, I, X) :- b_fn[ast_babel](F), child[ast_babel](F, params, I, X).
b_param[ast_babel](F, I, X) :- param_kind[ast_babel](K), node[ast_babel](F, K, _), child[ast_babel](F, params, I, X).
b_param[ast_babel](F, 0, X) :- node[ast_babel](F, tsindex_signature, _), child[ast_babel](F, parameters, 0, X).
b_param[ast_babel](F, I, Y) :- b_param[ast_babel](F, I, X), node[ast_babel](X, assignment_pattern, _),
                               child[ast_babel](X, left, 0, Y).
b_param[ast_babel](F, I, Y) :- b_param[ast_babel](F, I, X), node[ast_babel](X, tsparameter_property, _),
                               child[ast_babel](X, parameter, 0, Y).
edb(target_kind).
target_kind[ast_babel](identifier). target_kind[ast_babel](object_pattern). target_kind[ast_babel](array_pattern). target_kind[ast_babel](member_expression).
param[value](F, I, X)       :- b_param[ast_babel](F, I, X), b_fn[ast_babel](F), node[ast_babel](X, K, _), target_kind[ast_babel](K).
param[type](F, I, X)        :- b_param[ast_babel](F, I, X), b_tplace[ast_babel](F), node[ast_babel](X, K, _), target_kind[ast_babel](K).
rest_params[value](F, I, A) :- b_param[ast_babel](F, I, X), b_fn[ast_babel](F), node[ast_babel](X, rest_element, _),
                               child[ast_babel](X, argument, 0, A).
decl[value](X, param) :- param[value](_, _, X).
decl[value](X, param) :- rest_params[value](_, _, X).

edb(method_kind).
method_kind[ast_babel](object_method). method_kind[ast_babel](class_method). method_kind[ast_babel](class_private_method). method_kind[ast_babel](tsdeclare_method).
getter[value](M, M)     :- method_kind[ast_babel](K), node[ast_babel](M, K, _), attr[ast_babel](M, kind, "get").
setter[value](M, M)     :- method_kind[ast_babel](K), node[ast_babel](M, K, _), attr[ast_babel](M, kind, "set").
constructs[value](C, M) :- b_member[ast_babel](C, M), attr[ast_babel](M, kind, "constructor").

-- =====================================================================================================================
-- NAMES
--
-- An identifier is a name read (`ref`), a name introduced (`binds`), or a name its parent's role carries (a key, a
-- property, a label). Where it introduces one is decided by where its pattern starts: a declaration, a parameter, a
-- catch, an import. The same pattern on the left of `=` writes names that exist.

edb(bind_root).
bind_root[ast_babel](variable_declarator, id, value).    bind_root[ast_babel](catch_clause, param, value).
bind_root[ast_babel](function_declaration, id, value).   bind_root[ast_babel](function_expression, id, value).
bind_root[ast_babel](tsdeclare_function, id, value).
bind_root[ast_babel](class_declaration, id, value).      bind_root[ast_babel](class_declaration, id, type).
bind_root[ast_babel](class_expression, id, value).       bind_root[ast_babel](class_expression, id, type).
bind_root[ast_babel](import_specifier, local, type).     bind_root[ast_babel](import_default_specifier, local, type).
bind_root[ast_babel](import_namespace_specifier, local, type).
bind_root[ast_babel](tsinterface_declaration, id, type). bind_root[ast_babel](tstype_alias_declaration, id, type).
bind_root[ast_babel](tsenum_declaration, id, value).     bind_root[ast_babel](tsenum_declaration, id, type).
bind_root[ast_babel](tsmodule_declaration, id, value).   bind_root[ast_babel](tsmodule_declaration, id, type).
bind_root[ast_babel](tstype_parameter, name, type).

b_bind[ast_babel](X, Sort) :- bind_root[ast_babel](K, F, Sort), node[ast_babel](P, K, _), child[ast_babel](P, F, 0, X).
b_bind[ast_babel](X, value) :- node[ast_babel](D, import_declaration, _), attr[ast_babel](D, import_kind, "value"),
                               child[ast_babel](D, specifiers, _, S), not attr[ast_babel](S, import_kind, "type"),
                               child[ast_babel](S, local, 0, X).
b_bind[ast_babel](X, value) :- param[value](_, _, X).
b_bind[ast_babel](X, value) :- rest_params[value](_, _, X).
b_bind[ast_babel](Y, Sort)  :- b_bind[ast_babel](X, Sort), node[ast_babel](X, K, _), pattern_down[ast_babel](K, F),
                               child[ast_babel](X, F, _, Y).

edb(pattern_down).
pattern_down[ast_babel](object_pattern, properties). pattern_down[ast_babel](object_property, value). pattern_down[ast_babel](array_pattern, elements).
pattern_down[ast_babel](rest_element, argument).     pattern_down[ast_babel](assignment_pattern, left).

b_write[ast_babel](X) :- node[ast_babel](A, assignment_expression, _), child[ast_babel](A, left, 0, X).
b_write[ast_babel](X) :- node[ast_babel](S, K, _), loop_left[ast_babel](K), child[ast_babel](S, left, 0, X).
b_write[ast_babel](Y) :- b_write[ast_babel](X), node[ast_babel](X, K, _), pattern_down[ast_babel](K, F),
                         child[ast_babel](X, F, _, Y).
edb(loop_left).
loop_left[ast_babel](for_of_statement). loop_left[ast_babel](for_in_statement).

binds[value](X, Name) :- b_bind[ast_babel](X, value), node[ast_babel](X, identifier, _),
                         attr[ast_babel](X, name, Name).
binds[type](X, Name)  :- b_bind[ast_babel](X, type), node[ast_babel](X, identifier, _),
                               attr[ast_babel](X, name, Name).
ref[value](X, Name)  :- b_write[ast_babel](X), node[ast_babel](X, identifier, _),
                               attr[ast_babel](X, name, Name).

-- the fields where an identifier is a value read
edb(ref_field).
ref_field[ast_babel](call_expression, callee).        ref_field[ast_babel](call_expression, arguments).
ref_field[ast_babel](optional_call_expression, callee). ref_field[ast_babel](optional_call_expression, arguments).
ref_field[ast_babel](new_expression, callee).         ref_field[ast_babel](new_expression, arguments).
ref_field[ast_babel](member_expression, object).      ref_field[ast_babel](optional_member_expression, object).
ref_field[ast_babel](binary_expression, left).        ref_field[ast_babel](binary_expression, right).
ref_field[ast_babel](logical_expression, left).       ref_field[ast_babel](logical_expression, right).
ref_field[ast_babel](assignment_expression, right).
ref_field[ast_babel](unary_expression, argument).     ref_field[ast_babel](update_expression, argument).
ref_field[ast_babel](await_expression, argument).     ref_field[ast_babel](yield_expression, argument).
ref_field[ast_babel](spread_element, argument).
ref_field[ast_babel](return_statement, argument).     ref_field[ast_babel](throw_statement, argument).
ref_field[ast_babel](conditional_expression, test).   ref_field[ast_babel](conditional_expression, consequent).
ref_field[ast_babel](conditional_expression, alternate).
ref_field[ast_babel](if_statement, test).             ref_field[ast_babel](while_statement, test).
ref_field[ast_babel](do_while_statement, test).
ref_field[ast_babel](for_statement, init).            ref_field[ast_babel](for_statement, test).
ref_field[ast_babel](for_statement, update).
ref_field[ast_babel](for_in_statement, right).        ref_field[ast_babel](for_of_statement, right).
ref_field[ast_babel](switch_statement, discriminant). ref_field[ast_babel](switch_case, test).
ref_field[ast_babel](expression_statement, expression). ref_field[ast_babel](sequence_expression, expressions).
ref_field[ast_babel](array_expression, elements).
ref_field[ast_babel](assignment_pattern, right).
ref_field[ast_babel](variable_declarator, init).
ref_field[ast_babel](arrow_function_expression, body).
ref_field[ast_babel](template_literal, expressions).
ref_field[ast_babel](tagged_template_expression, tag).
ref_field[ast_babel](class_declaration, super_class). ref_field[ast_babel](class_expression, super_class).
ref_field[ast_babel](class_property, value).          ref_field[ast_babel](class_private_property, value).
ref_field[ast_babel](class_accessor_property, value).
ref_field[ast_babel](export_default_declaration, declaration).
ref_field[ast_babel](tsas_expression, expression).    ref_field[ast_babel](tssatisfies_expression, expression).
ref_field[ast_babel](tsnon_null_expression, expression). ref_field[ast_babel](tstype_assertion, expression).
ref_field[ast_babel](tsinstantiation_expression, expression). ref_field[ast_babel](parenthesized_expression, expression).
ref_field[ast_babel](decorator, expression).
ref_field[ast_babel](import_expression, source).      ref_field[ast_babel](import_expression, options).
ref_field[ast_babel](tsexport_assignment, expression).
ref_field[ast_babel](tsenum_member, initializer).
ref_field[ast_babel](tstype_query, expr_name).
ref_field[ast_babel](jsxexpression_container, expression). ref_field[ast_babel](jsxspread_attribute, argument).

ref[value](X, Name) :- ref_field[ast_babel](K, F), node[ast_babel](P, K, _), child[ast_babel](P, F, _, X), node[ast_babel](X, identifier, _),
                              attr[ast_babel](X, name, Name).
ref[value](X, Name) :- member_kind[ast_babel](K), node[ast_babel](P, K, _), attr[ast_babel](P, computed, true),
                              child[ast_babel](P, property, _, X), node[ast_babel](X, identifier, _), attr[ast_babel](X, name, Name).
ref[value](X, Name) :- attr[ast_babel](P, computed, true), child[ast_babel](P, key, _, X), node[ast_babel](X, identifier, _),
                              attr[ast_babel](X, name, Name).
ref[value](X, Name) :- b_literal_prop[ast_babel](P), child[ast_babel](P, value, _, X), node[ast_babel](X, identifier, _),
                              attr[ast_babel](X, name, Name).
ref[value](X, Name) :- b_local_export[ast_babel](S), child[ast_babel](S, local, _, X), node[ast_babel](X, identifier, _),
                              attr[ast_babel](X, name, Name).

-- the fields where an identifier is a type read; a keyword type is a name the library binds
edb(type_ref_field).
type_ref_field[ast_babel](tstype_reference, type_name). type_ref_field[ast_babel](tsclass_implements, expression).
type_ref_field[ast_babel](tsinterface_heritage, expression). type_ref_field[ast_babel](tsqualified_name, left).
ref[type](X, Name) :- type_ref_field[ast_babel](K, F), node[ast_babel](P, K, _), child[ast_babel](P, F, _, X), node[ast_babel](X, identifier, _),
                             attr[ast_babel](X, name, Name).

edb(keyword_type).
keyword_type[ast_babel](tsstring_keyword, "string").   keyword_type[ast_babel](tsnumber_keyword, "number").
keyword_type[ast_babel](tsboolean_keyword, "boolean"). keyword_type[ast_babel](tsany_keyword, "any").
keyword_type[ast_babel](tsunknown_keyword, "unknown"). keyword_type[ast_babel](tsvoid_keyword, "void").
keyword_type[ast_babel](tsundefined_keyword, "undefined"). keyword_type[ast_babel](tsnull_keyword, "null").
keyword_type[ast_babel](tsnever_keyword, "never").     keyword_type[ast_babel](tsobject_keyword, "object").
keyword_type[ast_babel](tsbigint_keyword, "bigint").   keyword_type[ast_babel](tssymbol_keyword, "symbol").
keyword_type[ast_babel](tsthis_type, "this").          keyword_type[ast_babel](tsintrinsic_keyword, "intrinsic").
keyword_type[ast_babel](tsarray_type, "Array").
ref[type](T, Name) :- keyword_type[ast_babel](K, Name), node[ast_babel](T, K, _).

-- the fields where an identifier is a name its parent's role carries
edb(name_field).
name_field[ast_babel](member_expression, property).   name_field[ast_babel](optional_member_expression, property).
name_field[ast_babel](object_property, key).          name_field[ast_babel](object_method, key).
name_field[ast_babel](class_method, key).             name_field[ast_babel](class_property, key).
name_field[ast_babel](class_accessor_property, key).  name_field[ast_babel](tsdeclare_method, key).
name_field[ast_babel](tsproperty_signature, key).     name_field[ast_babel](tsmethod_signature, key).
name_field[ast_babel](tsenum_member, id).             name_field[ast_babel](private_name, id).
name_field[ast_babel](import_specifier, imported).    name_field[ast_babel](export_specifier, exported).
name_field[ast_babel](export_specifier, local).       name_field[ast_babel](export_namespace_specifier, exported).
name_field[ast_babel](export_default_specifier, exported).
name_field[ast_babel](meta_property, meta).           name_field[ast_babel](meta_property, property).
name_field[ast_babel](labeled_statement, label).      name_field[ast_babel](break_statement, label).
name_field[ast_babel](continue_statement, label).
name_field[ast_babel](tsqualified_name, right).
-- the name of a parameter in a signature of the type world labels it; nothing reads it as a binding
name_field[ast_babel](tsindex_signature, parameters).  name_field[ast_babel](tsmethod_signature, params).
name_field[ast_babel](tsfunction_type, params).        name_field[ast_babel](tsconstructor_type, params).
name_field[ast_babel](tscall_signature_declaration, params). name_field[ast_babel](tsconstruct_signature_declaration, params).

-- =====================================================================================================================
-- KEYS, MEMBERS, LITERALS

b_key[ast_babel](M, Name) :- child[ast_babel](M, key, 0, K), attr[ast_babel](M, computed, false),
                       attr[ast_babel](K, name, Name).
b_key[ast_babel](M, V)    :- child[ast_babel](M, key, 0, K), attr[ast_babel](M, computed, false),
                       node[ast_babel](K, KK, _), key_literal[ast_babel](KK), attr[ast_babel](K, value, V).
b_key[ast_babel](M, Name) :- child[ast_babel](M, key, 0, K), node[ast_babel](K, private_name, _),
                       child[ast_babel](K, id, 0, I), attr[ast_babel](I, name, Name).
b_key[ast_babel](M, Name) :- node[ast_babel](M, tsenum_member, _), child[ast_babel](M, id, 0, I),
                       attr[ast_babel](I, name, Name).
key[value](M, Name) :- b_key[ast_babel](M, Name), node[ast_babel](M, K, _), not type_member[ast_babel](K).
key[type](M, Name)  :- b_key[ast_babel](M, Name), node[ast_babel](M, K, _), type_member[ast_babel](K).
key_expr[value](M, E) :- child[ast_babel](M, key, 0, E), attr[ast_babel](M, computed, true),
                         node[ast_babel](M, K, _), not type_member[ast_babel](K).
key_expr[type](M, E)  :- child[ast_babel](M, key, 0, E), attr[ast_babel](M, computed, true),
                         node[ast_babel](M, K, _), type_member[ast_babel](K).
edb(key_literal).
key_literal[ast_babel](string_literal). key_literal[ast_babel](numeric_literal).

edb(member_kind).
member_kind[ast_babel](member_expression). member_kind[ast_babel](optional_member_expression).
member[value](N, O, Name) :- member_kind[ast_babel](K), node[ast_babel](N, K, _), attr[ast_babel](N, computed, false),
                             child[ast_babel](N, object, 0, O), child[ast_babel](N, property, 0, P),
                             attr[ast_babel](P, name, Name).
member[value](N, O, Name) :- member_kind[ast_babel](K), node[ast_babel](N, K, _), child[ast_babel](N, object, 0, O),
                             child[ast_babel](N, property, 0, P), node[ast_babel](P, private_name, _),
                             child[ast_babel](P, id, 0, I), attr[ast_babel](I, name, Name).
member_expr[value](N, O, E) :- member_kind[ast_babel](K), node[ast_babel](N, K, _), attr[ast_babel](N, computed, true),
                               child[ast_babel](N, object, 0, O), child[ast_babel](N, property, 0, E).

edb(literal_kind).
literal_kind[ast_babel](string_literal). literal_kind[ast_babel](numeric_literal). literal_kind[ast_babel](boolean_literal).
literal_kind[ast_babel](big_int_literal).
literal[value](N, V)    :- literal_kind[ast_babel](K), node[ast_babel](N, K, _), attr[ast_babel](N, value, V),
                           not b_type_literal[ast_babel](N).
literal[type](N, V)     :- b_type_literal[ast_babel](N), attr[ast_babel](N, value, V).
b_type_literal[ast_babel](N) :- node[ast_babel](T, tsliteral_type, _), child[ast_babel](T, literal, 0, N).
literal[value](N, null) :- node[ast_babel](N, null_literal, _).
literal[value](Q, V)    :- node[ast_babel](T, template_literal, _), child[ast_babel](T, quasis, _, Q),
                           attr[ast_babel](Q, value_cooked, V).
-- a template with no substitution is a literal: its first part is its last
literal[value](T, V)    :- node[ast_babel](T, template_literal, _), child[ast_babel](T, quasis, 0, Q),
                           attr[ast_babel](Q, tail, true), attr[ast_babel](Q, value_cooked, V).
template_part[value](T, J, Q) :- node[ast_babel](T, template_literal, _), child[ast_babel](T, quasis, I, Q),
                                 J is I + I.
template_part[value](T, J, E) :- node[ast_babel](T, template_literal, _), child[ast_babel](T, expressions, I, E),
                                 J is I + I + 1.

-- =====================================================================================================================
-- CALLS

edb(callee_kind).
callee_kind[ast_babel](call_expression). callee_kind[ast_babel](optional_call_expression). callee_kind[ast_babel](new_expression).
callee[value](C, N) :- callee_kind[ast_babel](K), node[ast_babel](C, K, _), child[ast_babel](C, callee, 0, N).
tagged[value](C, Tag, Q) :- node[ast_babel](C, tagged_template_expression, _), child[ast_babel](C, tag, 0, Tag),
                            child[ast_babel](C, quasi, 0, Q).
spread_args[value](C, I, X) :- callee_kind[ast_babel](K), node[ast_babel](C, K, _), child[ast_babel](C, arguments, I, S),
                               node[ast_babel](S, spread_element, _), child[ast_babel](S, argument, 0, X).

-- =====================================================================================================================
-- OBJECTS, ARRAYS, CLASSES

-- members: of an object literal, of a class through its body, of an interface, a type literal and an enum
b_member[ast_babel](O, M) :- node[ast_babel](O, object_expression, _), child[ast_babel](O, properties, _, M),
                             node[ast_babel](M, K, _), K != spread_element.
b_member[ast_babel](C, M) :- mark[value](C, class), child[ast_babel](C, body, 0, B), child[ast_babel](B, body, _, M),
                             node[ast_babel](M, K, _), K != static_block.
b_member[ast_babel](E, M) :- node[ast_babel](E, tsenum_declaration, _), child[ast_babel](E, body, 0, B),
                             child[ast_babel](B, members, _, M).
has[value](O, M) :- b_member[ast_babel](O, M).
has[type](I, M)  :- node[ast_babel](I, tsinterface_declaration, _), child[ast_babel](I, body, 0, B),
                    child[ast_babel](B, body, _, M).
has[type](T, M)  :- node[ast_babel](T, tstype_literal, _), child[ast_babel](T, members, _, M).

edb(value_kind).
value_kind[ast_babel](class_property). value_kind[ast_babel](class_private_property). value_kind[ast_babel](class_accessor_property).
value[value](M, V) :- b_literal_prop[ast_babel](M), child[ast_babel](M, value, 0, V).
value[value](M, V) :- value_kind[ast_babel](K), node[ast_babel](M, K, _), child[ast_babel](M, value, 0, V).
value[value](M, V) :- node[ast_babel](M, tsenum_member, _), child[ast_babel](M, initializer, 0, V).

extends[value](C, E)      :- mark[value](C, class), child[ast_babel](C, super_class, 0, E).
extends[type](I, H)       :- node[ast_babel](I, tsinterface_declaration, _), child[ast_babel](I, extends, _, H).
static_block[value](C, B) :- mark[value](C, class), child[ast_babel](C, body, 0, CB), child[ast_babel](CB, body, _, B),
                             node[ast_babel](B, static_block, _).
decorated[value](X, D)    :- child[ast_babel](X, decorators, _, Dec), child[ast_babel](Dec, expression, 0, D).
spread_props[value](O, I, X) :- node[ast_babel](O, object_expression, _), child[ast_babel](O, properties, I, S),
                                node[ast_babel](S, spread_element, _), child[ast_babel](S, argument, 0, X).
spread_elems[value](A, I, X) :- node[ast_babel](A, array_expression, _), child[ast_babel](A, elements, I, S),
                                node[ast_babel](S, spread_element, _), child[ast_babel](S, argument, 0, X).

-- `constructor(private x)` declares the member x and puts the parameter into it
b_param_member[ast_babel](C, T, X) :- constructs[value](C, F), child[ast_babel](F, params, _, T),
                                      node[ast_babel](T, tsparameter_property, _), b_param[ast_babel](F, _, X),
                                      node[ast_babel](X, identifier, _), child[ast_babel](T, parameter, 0, Y),
                                      b_param_inner[ast_babel](Y, X).
b_param_inner[ast_babel](X, X) :- node[ast_babel](T, tsparameter_property, _), child[ast_babel](T, parameter, 0, X),
                                  node[ast_babel](X, identifier, _).
b_param_inner[ast_babel](Y, X) :- node[ast_babel](T, tsparameter_property, _), child[ast_babel](T, parameter, 0, Y),
                                  node[ast_babel](Y, assignment_pattern, _), child[ast_babel](Y, left, 0, X).
has[value](C, T)       :- b_param_member[ast_babel](C, T, _).
key[value](T, Name)    :- b_param_member[ast_babel](_, T, X), attr[ast_babel](X, name, Name).
assign[value](T, T, X) :- b_param_member[ast_babel](_, T, X).

-- =====================================================================================================================
-- CONDUITS AND OPERATORS

edb(passes_kind).
passes_kind[ast_babel](parenthesized_expression). passes_kind[ast_babel](tsas_expression). passes_kind[ast_babel](tssatisfies_expression).
passes_kind[ast_babel](tsnon_null_expression). passes_kind[ast_babel](tstype_assertion). passes_kind[ast_babel](tsinstantiation_expression).
passes[value](E, X) :- passes_kind[ast_babel](K), node[ast_babel](E, K, _), child[ast_babel](E, expression, 0, X).

binary[value](N, Op, L, R)  :- node[ast_babel](N, binary_expression, _), attr[ast_babel](N, operator, Op),
                               child[ast_babel](N, left, 0, L), child[ast_babel](N, right, 0, R).
unary[value](N, Op, X)      :- node[ast_babel](N, unary_expression, _), attr[ast_babel](N, operator, Op),
                               child[ast_babel](N, argument, 0, X).
logical[value](N, Op, L, R) :- node[ast_babel](N, logical_expression, _), attr[ast_babel](N, operator, Op),
                               child[ast_babel](N, left, 0, L), child[ast_babel](N, right, 0, R).

-- `a = b` puts b into a and gives b; `a += b` is a + b put into a; `a ??= b` is a ?? b with b put into a
edb(compound_op).
compound_op[ast_babel]("+=", "+"). compound_op[ast_babel]("-=", "-"). compound_op[ast_babel]("*=", "*"). compound_op[ast_babel]("/=", "/").
compound_op[ast_babel]("%=", "%"). compound_op[ast_babel]("**=", "**"). compound_op[ast_babel]("<<=", "<<"). compound_op[ast_babel](">>=", ">>").
compound_op[ast_babel](">>>=", ">>>"). compound_op[ast_babel]("&=", "&"). compound_op[ast_babel]("|=", "|"). compound_op[ast_babel]("^=", "^").
edb(logical_assign).
logical_assign[ast_babel]("&&=", "&&"). logical_assign[ast_babel]("||=", "||"). logical_assign[ast_babel]("??=", "??").

b_assign_parts[ast_babel](A, Op, L, R) :- node[ast_babel](A, assignment_expression, _),
                                          attr[ast_babel](A, operator, Op),
                                          child[ast_babel](A, left, 0, L), child[ast_babel](A, right, 0, R).
assign[value](A, L, R)       :- b_assign_parts[ast_babel](A, "=", L, R).
gives[value](A, R)           :- b_assign_parts[ast_babel](A, "=", _, R).
binary[value](A, B, L, R)    :- b_assign_parts[ast_babel](A, Op, L, R), compound_op[ast_babel](Op, B).
assign[value](A, L, A)       :- b_assign_parts[ast_babel](A, Op, L, _), compound_op[ast_babel](Op, _).
logical[value](A, B, L, R)   :- b_assign_parts[ast_babel](A, Op, L, R), logical_assign[ast_babel](Op, B).
assign[value](A, L, R)       :- b_assign_parts[ast_babel](A, Op, L, R), logical_assign[ast_babel](Op, _).
assign[value](P, L, R)       :- node[ast_babel](P, assignment_pattern, _), child[ast_babel](P, left, 0, L),
                                child[ast_babel](P, right, 0, R).

-- `++x` is x + 1 put into x and gives the result; `x++` gives the old x
unary[value](U, Op, X)  :- node[ast_babel](U, update_expression, _), attr[ast_babel](U, operator, Op),
                           child[ast_babel](U, argument, 0, X).
assign[value](U, X, U)  :- node[ast_babel](U, update_expression, _), child[ast_babel](U, argument, 0, X).
gives[value](U, X)      :- node[ast_babel](U, update_expression, _), attr[ast_babel](U, prefix, false),
                           child[ast_babel](U, argument, 0, X).

gives[value](S, X) :- node[ast_babel](S, sequence_expression, _), I is max(J : child[ast_babel](S, expressions, J, _)),
                      child[ast_babel](S, expressions, I, X).

-- =====================================================================================================================
-- DECLARATIONS AND PATTERNS

decl[value](D, Kind)   :- node[ast_babel](V, variable_declaration, _), attr[ast_babel](V, kind, W),
                          var_kind[ast_babel](W, Kind), child[ast_babel](V, declarations, _, D).
edb(var_kind).
var_kind[ast_babel]("var", var). var_kind[ast_babel]("let", let). var_kind[ast_babel]("const", const). var_kind[ast_babel]("using", using).
var_kind[ast_babel]("await using", await_using).
assign[value](D, T, I) :- node[ast_babel](D, variable_declarator, _), child[ast_babel](D, id, 0, T),
                          child[ast_babel](D, init, 0, I).
target[value](D, T)    :- node[ast_babel](D, variable_declarator, _), child[ast_babel](D, id, 0, T),
                          not child[ast_babel](D, init, 0, _).

edb(decl_kind).
decl_kind[ast_babel](function_declaration, function). decl_kind[ast_babel](tsdeclare_function, function).
decl_kind[ast_babel](class_declaration, class).       decl_kind[ast_babel](tsenum_declaration, enum).
decl_kind[ast_babel](tsmodule_declaration, namespace).
decl_kind[ast_babel](import_specifier, import).       decl_kind[ast_babel](import_default_specifier, import).
decl_kind[ast_babel](import_namespace_specifier, import).
decl[value](D, Kind)   :- decl_kind[ast_babel](K, Kind), node[ast_babel](D, K, _).
-- a named function or class expression introduces its name in its own scope
decl[value](D, function) :- node[ast_babel](D, function_expression, _), child[ast_babel](D, id, 0, _).
decl[value](D, class)    :- node[ast_babel](D, class_expression, _), child[ast_babel](D, id, 0, _).
decl[value](P, catch)    :- node[ast_babel](C, catch_clause, _), child[ast_babel](C, param, 0, P).

edb(target_field).
target_field[ast_babel](function_declaration, id). target_field[ast_babel](function_expression, id). target_field[ast_babel](tsdeclare_function, id).
target_field[ast_babel](class_declaration, id).    target_field[ast_babel](class_expression, id).
target_field[ast_babel](tsenum_declaration, id).   target_field[ast_babel](tsmodule_declaration, id).
target_field[ast_babel](import_specifier, local).  target_field[ast_babel](import_default_specifier, local).
target_field[ast_babel](import_namespace_specifier, local).
target[value](D, T) :- target_field[ast_babel](K, F), node[ast_babel](D, K, _), child[ast_babel](D, F, 0, T).

-- a pattern hands its parts to its targets; a default on a target is an assign of its own
b_tgt[ast_babel](V, V) :- b_pat_kid[ast_babel](V), node[ast_babel](V, K, _), K != assignment_pattern.
b_tgt[ast_babel](V, T) :- b_pat_kid[ast_babel](V), node[ast_babel](V, assignment_pattern, _),
                          child[ast_babel](V, left, 0, T).
b_pat_kid[ast_babel](V) :- node[ast_babel](P, object_pattern, _), child[ast_babel](P, properties, _, Q),
                           child[ast_babel](Q, value, 0, V).
b_pat_kid[ast_babel](V) :- node[ast_babel](P, array_pattern, _), child[ast_babel](P, elements, _, V).

pattern_prop[value](P, Name, T) :- node[ast_babel](P, object_pattern, _), child[ast_babel](P, properties, _, Q),
                                   key[value](Q, Name), child[ast_babel](Q, value, 0, V), b_tgt[ast_babel](V, T).
pattern_elem[value](P, I, T)    :- node[ast_babel](P, array_pattern, _), child[ast_babel](P, elements, I, V),
                                   node[ast_babel](V, K, _), K != rest_element, b_tgt[ast_babel](V, T).
rest_props[value](P, T)         :- node[ast_babel](P, object_pattern, _), child[ast_babel](P, properties, _, R),
                                   node[ast_babel](R, rest_element, _), child[ast_babel](R, argument, 0, T).
rest_elems[value](P, I, T)      :- node[ast_babel](P, array_pattern, _), child[ast_babel](P, elements, I, R),
                                   node[ast_babel](R, rest_element, _), child[ast_babel](R, argument, 0, T).

-- =====================================================================================================================
-- MODULES: an import destructures the namespace of the module it names; an export is a member of this one's

edb(source_kind).
source_kind[ast_babel](import_declaration). source_kind[ast_babel](export_named_declaration). source_kind[ast_babel](export_all_declaration).
module_ref[value](Src, Spec) :- source_kind[ast_babel](K), node[ast_babel](D, K, _), child[ast_babel](D, source, 0, Src),
                                attr[ast_babel](Src, value, Spec).
module_ref[value](I, Spec)   :- node[ast_babel](I, import_expression, _), child[ast_babel](I, source, 0, Src),
                                node[ast_babel](Src, string_literal, _), attr[ast_babel](Src, value, Spec).

b_import_key[ast_babel](S, Name) :- node[ast_babel](S, import_specifier, _), child[ast_babel](S, imported, 0, I),
                                    attr[ast_babel](I, name, Name).
b_import_key[ast_babel](S, Name) :- node[ast_babel](S, import_specifier, _), child[ast_babel](S, imported, 0, I),
                                    node[ast_babel](I, string_literal, _), attr[ast_babel](I, value, Name).
b_import_key[ast_babel](S, "default") :- node[ast_babel](S, import_default_specifier, _).
pattern_prop[value](D, Name, L) :- node[ast_babel](D, import_declaration, _), child[ast_babel](D, specifiers, _, S),
                                   b_import_key[ast_babel](S, Name), child[ast_babel](S, local, 0, L).
assign[value](D, D, Src)        :- node[ast_babel](D, import_declaration, _), child[ast_babel](D, specifiers, _, S),
                                   b_import_key[ast_babel](S, _), child[ast_babel](D, source, 0, Src).
assign[value](S, L, Src)        :- node[ast_babel](D, import_declaration, _), child[ast_babel](D, specifiers, _, S),
                                   node[ast_babel](S, import_namespace_specifier, _), child[ast_babel](S, local, 0, L),
                                   child[ast_babel](D, source, 0, Src).

b_ns[ast_babel](X, Ns) :- namespace[value](P, Ns), child[ast_babel](P, body, _, X).
b_ns[ast_babel](X, Ns) :- namespace[value](M, Ns), child[ast_babel](Ns, body, _, X).
namespace[value](M, B) :- node[ast_babel](M, tsmodule_declaration, _), child[ast_babel](M, body, 0, B),
                          node[ast_babel](B, tsmodule_block, _).

b_export_name[ast_babel](S, Name) :- child[ast_babel](S, exported, 0, I), attr[ast_babel](I, name, Name).
b_export_name[ast_babel](S, Name) :- child[ast_babel](S, exported, 0, I), node[ast_babel](I, string_literal, _),
                                     attr[ast_babel](I, value, Name).
b_local_export[ast_babel](S) :- node[ast_babel](E, export_named_declaration, _), child[ast_babel](E, specifiers, _, S),
                                node[ast_babel](S, export_specifier, _), not child[ast_babel](E, source, 0, _).
b_reexport[ast_babel](E, S)  :- node[ast_babel](E, export_named_declaration, _), child[ast_babel](E, specifiers, _, S),
                                node[ast_babel](S, export_specifier, _), child[ast_babel](E, source, 0, _).

-- export { a as b }
-- the member is the specifier, and for `* as ns` its name, the one node every parser has there
b_spec_member[ast_babel](S, S) :- node[ast_babel](S, export_specifier, _).
b_spec_member[ast_babel](S, M) :- node[ast_babel](S, export_namespace_specifier, _), child[ast_babel](S, exported, 0, M).
has[value](Ns, M)  :- b_ns[ast_babel](E, Ns), node[ast_babel](E, export_named_declaration, _),
                      child[ast_babel](E, specifiers, _, S), b_spec_member[ast_babel](S, M).
key[value](M, N)   :- b_export_name[ast_babel](S, N), b_spec_member[ast_babel](S, M).
value[value](S, L) :- b_local_export[ast_babel](S), child[ast_babel](S, local, 0, L).
-- export { a as b } from 'm': the member is destructured from m
pattern_prop[value](E, Name, S) :- b_reexport[ast_babel](E, S), child[ast_babel](S, local, 0, L),
                                   attr[ast_babel](L, name, Name).
assign[value](E, E, Src)        :- b_reexport[ast_babel](E, _), child[ast_babel](E, source, 0, Src).
-- export * as ns from 'm'
value[value](M, Src) :- node[ast_babel](E, export_named_declaration, _), child[ast_babel](E, specifiers, _, S),
                        node[ast_babel](S, export_namespace_specifier, _), child[ast_babel](S, exported, 0, M),
                        child[ast_babel](E, source, 0, Src).
-- export const a = 1, export function f, export class C: the binding is the member, its value itself
b_export_binding[ast_babel](Ns, X) :- b_ns[ast_babel](E, Ns), node[ast_babel](E, export_named_declaration, _),
                                      child[ast_babel](E, declaration, 0, V), child[ast_babel](V, declarations, _, D),
                                      child[ast_babel](D, id, 0, X), node[ast_babel](X, identifier, _).
b_export_binding[ast_babel](Ns, X) :- b_ns[ast_babel](E, Ns), node[ast_babel](E, export_named_declaration, _),
                                      child[ast_babel](E, declaration, 0, V), child[ast_babel](V, id, 0, X).
has[value](Ns, X)     :- b_export_binding[ast_babel](Ns, X).
key[value](X, Name)   :- b_export_binding[ast_babel](_, X), attr[ast_babel](X, name, Name).
value[value](X, X)    :- b_export_binding[ast_babel](_, X).
-- export default x
has[value](Ns, E)     :- b_ns[ast_babel](E, Ns), node[ast_babel](E, export_default_declaration, _).
key[value](E, "default") :- node[ast_babel](E, export_default_declaration, _).
value[value](E, X)    :- node[ast_babel](E, export_default_declaration, _), child[ast_babel](E, declaration, 0, X).
-- export * from 'm'
spread_props[value](Ns, I, Src) :- namespace[value](P, Ns), child[ast_babel](P, body, I, E),
                                   node[ast_babel](E, export_all_declaration, _), child[ast_babel](E, source, 0, Src).
-- TS export = x
assign[value](E, Ns, X) :- b_ns[ast_babel](E, Ns), node[ast_babel](E, tsexport_assignment, _),
                           child[ast_babel](E, expression, 0, X).

-- =====================================================================================================================
-- TYPES

-- Types are a world of their own, [type], with the same roles. The two bridges into [value] are declared and
-- implements; nothing else here writes [value] from a type.

-- the places that are themselves in the type world: the members of an interface or a type literal, and the
-- signatures whose parameters are types
edb(type_member).
type_member[ast_babel](tsproperty_signature). type_member[ast_babel](tsmethod_signature). type_member[ast_babel](tsindex_signature).
type_member[ast_babel](tscall_signature_declaration). type_member[ast_babel](tsconstruct_signature_declaration).
b_tplace[ast_babel](X) :- type_member[ast_babel](K), node[ast_babel](X, K, _).
b_tplace[ast_babel](X) :- param_kind[ast_babel](K), node[ast_babel](X, K, _).
b_tplace[ast_babel](P) :- b_tplace[ast_babel](F), b_param[ast_babel](F, _, P).

b_annotated[ast_babel](X, T) :- child[ast_babel](X, F, 0, A), annotation_field[ast_babel](F),
                                node[ast_babel](A, tstype_annotation, _), child[ast_babel](A, type_annotation, 0, T).
b_annotated[ast_babel](X, T) :- direct_type[ast_babel](K), node[ast_babel](X, K, _), child[ast_babel](X, type_annotation, 0, T).
declared[value](X, T) :- b_annotated[ast_babel](X, T), not b_tplace[ast_babel](X).
declared[type](X, T)  :- b_annotated[ast_babel](X, T), b_tplace[ast_babel](X).
edb(annotation_field).
annotation_field[ast_babel](type_annotation). annotation_field[ast_babel](return_type).
edb(direct_type).
direct_type[ast_babel](tsas_expression). direct_type[ast_babel](tstype_assertion).
-- f<T>(), new C<T>(): the type arguments of a call in the value world are declared at the call
declared[value](C, A) :- callee_kind[ast_babel](K), node[ast_babel](C, K, _), child[ast_babel](C, type_arguments, 0, D),
                         child[ast_babel](D, params, _, A).
implements[value](C, T) :- mark[value](C, class), child[ast_babel](C, implements, _, T).

-- type A = T: the name gets its type as a binding gets its value
assign[type](A, A, T) :- node[ast_babel](A, tstype_alias_declaration, _), child[ast_babel](A, type_annotation, 0, T).

-- a type named, and a generic applied: Array<T> is a call in the type world, the callee named by callee and the arguments its steps
edb(type_app).
type_app[ast_babel](tstype_reference, type_name). type_app[ast_babel](tsinterface_heritage, expression). type_app[ast_babel](tsclass_implements, expression).
b_app_args[ast_babel](T, I, A) :- type_app[ast_babel](K, _), node[ast_babel](T, K, _), child[ast_babel](T, type_arguments, 0, D),
                                  child[ast_babel](D, params, I, A).
passes[type](T, N)  :- type_app[ast_babel](K, F), node[ast_babel](T, K, _), child[ast_babel](T, F, 0, N),
                       not child[ast_babel](T, type_arguments, 0, _).
mark[type](T, call) :- b_app_args[ast_babel](T, _, _).
callee[type](T, N)  :- b_app_args[ast_babel](T, _, _), node[ast_babel](T, K, _), type_app[ast_babel](K, F), child[ast_babel](T, F, 0, N).
nth[tree](T, I, A)  :- b_app_args[ast_babel](T, I, A).
-- T[] is Array<T>
mark[type](T, call) :- node[ast_babel](T, tsarray_type, _).
nth[tree](T, 0, E)  :- node[ast_babel](T, tsarray_type, _), child[ast_babel](T, element_type, 0, E).

-- <T extends U = D>: a parameter of the type world, its bound and its default
param[type](X, I, P) :- child[ast_babel](X, type_parameters, 0, D),
                        node[ast_babel](D, tstype_parameter_declaration, _), child[ast_babel](D, params, I, P).
bound[type](P, U)    :- node[ast_babel](P, tstype_parameter, _), child[ast_babel](P, constraint, 0, U).
assign[type](P, P, D) :- node[ast_babel](P, tstype_parameter, _), child[ast_babel](P, default, 0, D).

-- A | B, A & B; keyof T, typeof x
edb(type_op).
type_op[ast_babel](tsunion_type, "|"). type_op[ast_babel](tsintersection_type, "&").
binary[type](T, Op, L, R) :- type_op[ast_babel](K, Op), node[ast_babel](T, K, _), child[ast_babel](T, types, I, L),
                             J is I + 1, child[ast_babel](T, types, J, R).
nth[tree](T, I, P)        :- type_op[ast_babel](K, _), node[ast_babel](T, K, _), child[ast_babel](T, types, I, P).
unary[type](T, Op, X)     :- node[ast_babel](T, tstype_operator, _), attr[ast_babel](T, operator, Op),
                             child[ast_babel](T, type_annotation, 0, X).
unary[type](T, "typeof", X) :- node[ast_babel](T, tstype_query, _), child[ast_babel](T, expr_name, 0, X).

-- T['k'], A.B; 'a' as a type; [A, B]; (T)
member[type](N, O, Key)  :- node[ast_babel](N, tsindexed_access_type, _), child[ast_babel](N, object_type, 0, O),
                            child[ast_babel](N, index_type, 0, I), b_type_literal_of[ast_babel](I, Key).
member_expr[type](N, O, I) :- node[ast_babel](N, tsindexed_access_type, _), child[ast_babel](N, object_type, 0, O),
                              child[ast_babel](N, index_type, 0, I), not b_type_literal_of[ast_babel](I, _).
b_type_literal_of[ast_babel](T, V) :- child[ast_babel](T, literal, 0, L), b_type_literal[ast_babel](L),
                                      attr[ast_babel](L, value, V).
member[type](N, L, Name) :- node[ast_babel](N, tsqualified_name, _), child[ast_babel](N, left, 0, L),
                            child[ast_babel](N, right, 0, R), attr[ast_babel](R, name, Name).
passes[type](T, L)       :- node[ast_babel](T, tsliteral_type, _), child[ast_babel](T, literal, 0, L).
mark[type](T, array)     :- node[ast_babel](T, tstuple_type, _).
nth[tree](T, I, E)       :- node[ast_babel](T, tstuple_type, _), child[ast_babel](T, element_types, I, E).
passes[type](T, X)       :- node[ast_babel](T, tsparenthesized_type, _), child[ast_babel](T, type_annotation, 0, X).
mark[type](T, object)    :- node[ast_babel](T, tsinterface_declaration, _).
mark[type](T, object)    :- node[ast_babel](T, tstype_literal, _).

-- T extends U ? X : Y, the ternary of the type world; infer R introduces R inside it
nth[tree](T, 0, C)              :- node[ast_babel](T, tsconditional_type, _), child[ast_babel](T, check_type, 0, C).
nth[tree](T, 1, E)              :- node[ast_babel](T, tsconditional_type, _), child[ast_babel](T, extends_type, 0, E).
executes_if[type](X, E, matches) :- node[ast_babel](T, tsconditional_type, _), child[ast_babel](T, extends_type, 0, E),
                                    child[ast_babel](T, true_type, 0, X).
executes_if[type](Y, E, falsy)   :- node[ast_babel](T, tsconditional_type, _), child[ast_babel](T, extends_type, 0, E),
                                    child[ast_babel](T, false_type, 0, Y).
passes[type](I, P)              :- node[ast_babel](I, tsinfer_type, _), child[ast_babel](I, type_parameter, 0, P).
decl[type](P, infer)            :- node[ast_babel](I, tsinfer_type, _), child[ast_babel](I, type_parameter, 0, P).

-- =====================================================================================================================
-- THE KINDS THAT STAND IN NO ROLE, each with its reason

edb(no_role).
no_role[ast_babel](file, "dissolved: the file is named by program and at, and is itself in the fs_* facts").
no_role[ast_babel](expression_statement, "stepped through: the expression is the step").
no_role[ast_babel](labeled_statement, "stepped through: the label is on the statement").
no_role[ast_babel](spread_element, "stepped through: the spread is a role of the parent").
no_role[ast_babel](rest_element, "dissolved: rest_params, rest_props or rest_elems of its parent").
no_role[ast_babel](export_namespace_specifier, "dissolved: its exported name is the member").
no_role[ast_babel](export_all_declaration, "dissolved: spread_props of the namespace from its source").
no_role[ast_babel](class_body, "dissolved: its members are has of the class").
no_role[ast_babel](tsinterface_body, "dissolved: its members are has of the interface").
no_role[ast_babel](tsenum_body, "dissolved: its members are has of the enum").
no_role[ast_babel](tstype_annotation, "dissolved: the type is declared at the annotated place").
no_role[ast_babel](tstype_parameter_declaration, "dissolved: its parameters are param[type] of the declaration").
no_role[ast_babel](tstype_parameter_instantiation, "dissolved: its arguments are steps of the application").
no_role[ast_babel](decorator, "dissolved: decorated(X, D) reads its expression").
no_role[ast_babel](private_name, "dissolved: the name is key or member, the mark private").
no_role[ast_babel](comment_line, "not code").
no_role[ast_babel](comment_block, "not code").
no_role[ast_babel](directive, "no role yet: the model does not read directives").
no_role[ast_babel](directive_literal, "no role yet: the model does not read directives").
no_role[ast_babel](reg_exp_literal, "no role yet: a regular expression is an object with a pattern").
no_role[ast_babel](tsmapped_type, "no role yet").
no_role[ast_babel](tstype_predicate, "no role yet: a type predicate is an operation (narrows)").
no_role[ast_babel](tsimport_type, "no role yet").
no_role[ast_babel](tstemplate_literal_type, "no role yet").
no_role[ast_babel](tsoptional_type, "no role yet").
no_role[ast_babel](tsrest_type, "no role yet").
no_role[ast_babel](tsnamed_tuple_member, "no role yet").
no_role[ast_babel](jsxelement, "no role yet: JSX").
no_role[ast_babel](jsxopening_element, "no role yet: JSX").
no_role[ast_babel](jsxclosing_element, "no role yet: JSX").
no_role[ast_babel](jsxattribute, "no role yet: JSX").
no_role[ast_babel](jsxidentifier, "no role yet: JSX").
no_role[ast_babel](jsxtext, "no role yet: JSX").
no_role[ast_babel](jsxexpression_container, "no role yet: JSX").
no_role[ast_babel](jsxfragment, "no role yet: JSX").
no_role[ast_babel](jsxopening_fragment, "no role yet: JSX").
no_role[ast_babel](jsxclosing_fragment, "no role yet: JSX").
no_role[ast_babel](jsxmember_expression, "no role yet: JSX").
no_role[ast_babel](jsxspread_attribute, "no role yet: JSX").
no_role[ast_babel](jsxempty_expression, "no role yet: JSX").

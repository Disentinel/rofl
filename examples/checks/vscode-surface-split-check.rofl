-- examples/checks/vscode-surface-split-check.rofl — vscode_surface_split: the side-effect question over the 14 files of
-- examples/vscode/mini and examples/vscode/split (facts in vscode-split-facts.rofl), every file resident, through the
-- [surface] book (rules/js-surface.rofl). Every answer named; red if one is missing or one more appears. The same facts
-- come out of each file evaluated ALONE with the others' [surface]: scripts/surface_split.ts (npm run test:split) is
-- that gate, and its planted break is the original model with no surface. The files, by node prefix:
--   mini/common/channels.ts n6329e4a1ce5a5737   split/app.ts       n34281c6d11fa17ac   split/guard.ts     n1757fbf66a95b84a
--   mini/node/main.ts       n6ce3b3e159e9764b   split/cb.ts        n4eee02055dfecceb   split/lib.ts       n2cab440d5303505d
--   mini/node/pfs.ts        nd100d8f9c1968a85   split/consumer.ts  n1684850c959c2a12   split/reexports.ts n7260e653f095f551
--   mini/node/server.ts     n34efd0fd49e79fa1   split/each.ts      n303f3c0ccfb1010a   split/store.ts     n346d69f15eaf6d53
--                                               split/errors.ts    n02a978cc9a4fd53e   split/util.ts      nd31751746bbd649e
-- What each extra file is for:
--   a helper merged across callers   util.ts `id(p) { return p }` called from store.ts ('/var/a', '/var/b') and consumer.ts
--                                    (as `ident` through a re-export, '/etc/x'; as `u.id` through a namespace, '/var/c'):
--                                    each call has ITS argument, not the four (`sx_ret_param`); `ensure(dir)`, a sink inside
--                                    a helper, still has every caller's value (one caller here)
--   re-export and `export *`         reexports.ts `export { id as ident } from`, `export * from`
--   namespace, require, default      consumer.ts `import * as u`, `require('./util.js')`; store.ts `import home`
--   a member written from elsewhere  consumer.ts `u.settings.mode = 'slow'` is read by util.ts flush(): 'fast' and 'slow'
--   a callback over another array    cb.ts `each(['/tmp/a1', '/tmp/a2'], p => fs.unlinkSync(p))`; each.ts iterates and calls
--   a throw caught elsewhere         errors.ts fail() throws, guard.ts catches it: caught_value, no catch_from_host
--   a callee placed by its callers   lib.ts helper() is called unguarded only from app.ts: reached, not may_not_run;
--                                    the arrow in cb.ts is called only inside each.ts's loop: may_not_run
--   no value                         lib.ts Registry.open: `new Registry()` of an imported class does not resolve (the
--                                    model's `new` reads a class of the same file); main.ts remove(this.storage.dir)
vsp_want(n1684850c959c2a12_29, fs_mutation, "/etc/x").
vsp_want(n1684850c959c2a12_38, fs_mutation, "/var/log/app").
vsp_want(n1684850c959c2a12_42, fs_mutation, "/tmp/app-cache").
vsp_want(n1684850c959c2a12_52, fs_mutation, "/var/c").
vsp_want(n1684850c959c2a12_63, fs_mutation, "/var/log/app").
vsp_want(n1757fbf66a95b84a_28, fs_mutation, "/tmp/guard").
vsp_want(n2cab440d5303505d_14, fs_mutation, "/tmp/lib").
vsp_want(n303f3c0ccfb1010a_28, fs_mutation, "/tmp/a1").
vsp_want(n303f3c0ccfb1010a_28, fs_mutation, "/tmp/a2").
vsp_want(n346d69f15eaf6d53_15, fs_mutation, "/var/a").
vsp_want(n346d69f15eaf6d53_23, fs_mutation, "/var/b").
vsp_want(n346d69f15eaf6d53_31, fs_mutation, "/home/app").
vsp_want(n34efd0fd49e79fa1_34, listen, 8080).
vsp_want(n34efd0fd49e79fa1_34, listen, n34efd0fd49e79fa1_54).
vsp_want(n34efd0fd49e79fa1_48, listen, 8080).
vsp_want(n34efd0fd49e79fa1_52, listen, n34efd0fd49e79fa1_54).
vsp_want(n4eee02055dfecceb_20, fs_mutation, "/tmp/a1").
vsp_want(n4eee02055dfecceb_20, fs_mutation, "/tmp/a2").
vsp_want(n6ce3b3e159e9764b_102, process, "code").
vsp_want(n6ce3b3e159e9764b_108, process, "git").
vsp_want(n6ce3b3e159e9764b_114, ipc, "vscode:hello").
vsp_want(n6ce3b3e159e9764b_122, request, "https://update.code.visualstudio.com/api/update").
vsp_want(n6ce3b3e159e9764b_81, fs_mutation, "/tmp/settings.json").
vsp_want(n6ce3b3e159e9764b_86, fs_mutation, "/tmp/cache").
vsp_want(nd100d8f9c1968a85_25, fs_mutation, "/tmp/settings.json").
vsp_want(nd100d8f9c1968a85_45, fs_mutation, "/tmp/cache").
vsp_want(nd31751746bbd649e_28, fs_mutation, "/var/log/app").
vsp_want(nd31751746bbd649e_58, fs_mutation, "fast").
vsp_want(nd31751746bbd649e_58, fs_mutation, "slow").
vsp_want_site(n2cab440d5303505d_32, fs_mutation).
vsp_want_site(n6ce3b3e159e9764b_90, fs_mutation).
vsp_want_site(S, F) :- vsp_want(S, F, _).
vsp_want_count(fs_mutation, 20, 18).
vsp_want_count(listen, 3, 3).
vsp_want_count(process, 2, 2).
vsp_want_count(ipc, 1, 1).
vsp_want_count(request, 1, 1).
vsp_want_not_run(n4eee02055dfecceb_18).
vsp_want_caught(n1757fbf66a95b84a_25, n02a978cc9a4fd53e_13).

vsp_missing(S, F, V)   :- vsp_want(S, F, V), not side_effect_value(S, F, V).
vsp_extra(S, F, V)     :- side_effect_value(S, F, V), not vsp_want(S, F, V).
vsp_missing_site(S, F) :- vsp_want_site(S, F), not side_effect_site(S, F).
vsp_extra_site(S, F)   :- side_effect_site(S, F), not vsp_want_site(S, F).
vsp_count_wrong(F)     :- side_effect_count(F, N, V), not vsp_want_count(F, N, V).
vsp_count_missing(F)   :- vsp_want_count(F, N, V), not side_effect_count(F, N, V).
vsp_not_run_wrong(F)   :- may_not_run[code](F), not vsp_want_not_run(F).
vsp_not_run_missing(F) :- vsp_want_not_run(F), not may_not_run[code](F).
vsp_caught_missing(P)  :- vsp_want_caught(P, V), not caught_value[flow](P, V).
vsp_from_host(P)       :- catch_from_host[flow](P).
alarm(vsp_missing).
alarm(vsp_extra).
alarm(vsp_missing_site).
alarm(vsp_extra_site).
alarm(vsp_count_wrong).
alarm(vsp_count_missing).
alarm(vsp_not_run_wrong).
alarm(vsp_not_run_missing).
alarm(vsp_caught_missing).
alarm(vsp_from_host).

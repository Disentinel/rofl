vsp_missing(S, F, V)   :- vsp_want(S, F, V), not side_effect_value(S, F, V).
vsp_extra(S, F, V)     :- side_effect_value(S, F, V), not vsp_want(S, F, V).
vsp_missing_site(S, F) :- vsp_want_site(S, F), not side_effect_site(S, F).
vsp_extra_site(S, F)   :- side_effect_site(S, F), not vsp_want_site(S, F).
vsp_count_wrong(F)     :- side_effect_count(F, N, V), not vsp_want_count(F, N, V).
vsp_count_missing(F)   :- vsp_want_count(F, N, V), not side_effect_count(F, N, V).
vsp_call_missing(C, G) :- vsp_want_call(C, G), not resolves[code](C, G).
vsp_not_run_wrong(F)   :- may_not_run[code](F), not vsp_want_not_run(F).
vsp_not_run_missing(F) :- vsp_want_not_run(F), not may_not_run[code](F).
vsp_caught_missing(P)  :- vsp_want_caught(P, V), not caught_value[flow](P, V).
vsp_from_host(P)       :- catch_from_host[flow](P).
alarm(vsp_missing).
alarm(vsp_extra).
alarm(vsp_missing_site).
alarm(vsp_extra_site).
alarm(vsp_count_wrong).
alarm(vsp_count_missing).
alarm(vsp_call_missing).
alarm(vsp_not_run_wrong).
alarm(vsp_not_run_missing).
alarm(vsp_caught_missing).
alarm(vsp_from_host).

ab_e(n20, n21, 21).
ab_e(n21, n22, 22).
ab_e(n22, n23, 23).
ab_e(n23, n24, 24).
ab_e(n24, n25, 25).
ab_e(n25, n26, 26).
ab_e(n26, n27, 27).
ab_e(n27, n28, 28).
ab_e(n28, n29, 29).
ab_e(n29, n30, 30).
ab_e(n30, n31, 31).
ab_e(n31, n32, 32).
ab_e(n32, n33, 33).
ab_e(n33, n34, 34).

-- examples/checks/agg-join-delta-first-check.rofl — agg-join-delta-first.rofl: the three hits, and nothing else.
jd_wrong(Y, Z) :- jd_want(Y, Z), not hit(Y, Z).
jd_extra(Y, Z) :- hit(Y, Z), not jd_want(Y, Z).
alarm(jd_wrong).
alarm(jd_extra).
jd_want(y1, z1).
jd_want(y2, z2).
jd_want(y3, z3).

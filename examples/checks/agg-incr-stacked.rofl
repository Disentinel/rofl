-- examples/checks/agg-incr-stacked.rofl — agg_incr_stacked: RULES THAT NEGATE OR
-- AGGREGATE WHAT CHANGED, under RETRACTION. A retraction can make a `not` newly
-- true, which no subtraction does, and a count over what a cell concludes gains
-- and loses members: the rules that read what changed (a cell's conclusion,
-- what a lattice holds, the retracted fact itself) are read again whole, their
-- facts and cells taken out and the rules fired again level by level, over what
-- the levels below concluded. The state must be the one of a world without
-- the fact.
--
--   st_sale(1, a, 10)   a's total 15 -> 5: st_big(a) goes, st_calm(a) is NEW, the count of the big goes down
--   st_sale(3, b, 7)    b has no sale left: st_none(b) is NEW (a base fact, negated)
--   st_sale(6, d, -5)   d's total 4 -> 9: st_big(d) is NEW, st_calm(d) GOES (a negation that held no longer does), st_a_quiet(d) is NEW
--   st_e(b, c, 2)       the near pairs through the edge go: st_apart gains them, and its count with it
edb(st_sale). edb(st_e). edb(st_grp).
st_grp(a). st_grp(b). st_grp(c). st_grp(d).
st_sale(1, a, 10).
st_sale(2, a, 5).
st_sale(3, b, 7).
st_sale(4, c, 2).
st_sale(5, d, 9).
st_sale(6, d, -5).
st_e(a, b, 1).
st_e(b, c, 2).
st_e(c, d, 1).
st_total(G, S) :- S is sum(V ; K : st_sale(K, G, V)).
st_big(G) :- st_total(G, S), S > 5.
st_calm(G) :- st_grp(G), not st_big(G).
st_a_count_big(N) :- N is count(G : st_big(G)).
st_lvl(G, N) :- st_total(G, S), N is count(H : st_total(H, T), T < S).
st_none(G) :- st_grp(G), not st_sale(_, G, _).
lattice st_d(A, B, min W).
st_d(A, B, W) :- st_e(A, B, W).
st_d(A, C, W) :- st_d(A, B, W1), st_e(B, C, W2), W is W1 + W2.
st_near(A, B) :- st_d(A, B, W), W < 4.
st_apart(A, B) :- st_grp(A), st_grp(B), not st_near(A, B).
st_a_count_apart(A, N) :- st_grp(A), N is count(B : st_apart(A, B)).
st_a_quiet(G) :- st_grp(G), not st_calm(G).

-- the state after the retractions, row by row
-- expect-row: st_a_count_apart[main](a,3) tick drv support=1

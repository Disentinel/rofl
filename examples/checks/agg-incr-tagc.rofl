-- examples/checks/agg-incr-tagc.rofl — agg_incr_tagc: the COUNTING TAG under
-- RETRACTION (docs/aggregates.md, "Ready for the incremental engine"). A
-- counting tag is invertible: each rule concludes a derivation,
-- `p@count(K..., $firing(Rule, Vars), N)`, a fact whose firing is the member of
-- the tag cell's sum; the cell records `alg=invertible,tag use=subtract`, and
-- the derivations are the firings the `lat p@count` lines print by id. A
-- retraction takes the derivations that cited the fact out with it and the
-- cell SUBTRACTS them: nothing is derived again.
--
--   ic_e(b, c)      the walk through b to c and the edge itself lose a derivation each
--   ic_w(a, b, 2)   a to b counted 2 + 3, and is now 3
--   ic_e(a, c)      a to c lost its direct edge, and its walk through b stays
edb(ic_e). edb(ic_w).
ic_e(a, b).
ic_e(b, c).
ic_e(a, c).
ic_e(c, d).
ic_e(b, d).
ic_w(a, b, 2).
ic_w(a, b, 3).
ic_w(b, c, 1).
tag ic_walks(A, C, counting N).
ic_walks(A, C, N) :- ic_e(A, C).
ic_walks(A, C, N) :- ic_e(A, B), ic_e(B, C).
tag ic_wt(A, B, counting N).
ic_wt(A, B, W) :- ic_w(A, B, W).
tag ic_tot(counting N).
ic_tot(N) :- ic_e(_, _).

-- the state after the retractions, row by row
-- expect-row: ic_e[main](a,b) tick base support=0
-- expect-row: ic_e[main](b,d) tick base support=0
-- expect-row: ic_e[main](c,d) tick base support=0
-- expect-row: ic_tot@count[main]($firing(r1bfa4edc,a,b),1) tick drv support=1
-- expect-row: ic_tot@count[main]($firing(r1bfa4edc,b,d),1) tick drv support=1
-- expect-row: ic_tot@count[main]($firing(r1bfa4edc,c,d),1) tick drv support=1
-- expect-row: ic_tot[main](3) tick drv support=1
-- expect-row: ic_w[main](a,b,3) tick base support=0
-- expect-row: ic_w[main](b,c,1) tick base support=0
-- expect-row: ic_walks@count[main](a,b,$firing(r28dd725a,a,b),1) tick drv support=1

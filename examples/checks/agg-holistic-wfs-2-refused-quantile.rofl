-- expect-refusal: quantile is not evaluated under well_founded semantics
-- examples/checks/agg-holistic-wfs-2-refused-quantile.rofl — quantile inside a well-founded
-- world is refused: its cell would be sealed under an assumption, over
-- positions whose win is unknown.
semantics(well_founded).
edb(wr_move).
wr_move(a, b). wr_move(b, a). wr_move(b, c).
wr_win(X) :- wr_move(X, Y), not wr_win(Y).
wr_d(M) :- M is quantile(50, V ; X : wr_move(X, _), wr_val(X, V)).
wr_val(X, 1) :- wr_win(X).
wr_val(X, 0) :- wr_move(X, _), not wr_win(X).

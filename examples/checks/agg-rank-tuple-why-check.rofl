-- examples/checks/agg-rank-tuple-why-check.rofl — agg_rank_tuple_why, run with
-- `rofl-load --explain`: `why` of a rank over a tuple names the aggregate as
-- written, directions and all, with its subject tuple, what it sealed and its
-- members in the tuple's order, each as its key tuple; `whynot` of a wrong
-- place says which place it is, of a subject none of the tuples names the
-- subject tuple, and of a key that is no key says the hole. A hole is not an
-- empty group, and neither is a subject nobody holds.
edb(explain_request).
edb(explained).
explain_request(why, rt_place(ga, ann, 2)).
explain_request(why, rt_dup(gd, n3, 2)).
explain_request(whynot, rt_place(ga, ann, 3)).
explain_request(whynot, rt_ask(ga, 7, zed, 3)).
explain_request(whynot, rt_ask(ga, f(1), bob, 1)).
explain_request(whynot, rt_bad(gx, 1)).
rtw_said(K, A, T)  :- rtw_want(K, A, T), explained[$explain](K, A, _, L), N is str_segs(L, T), N > 1.
rtw_want(why, rt_place(ga, ann, 2), "rank(7,ann ; desc(?S2),?N2 : rk_score[main](ga,?N2,?S2)) = 2 [aggregate: 5 members, sealed rk_score@").
rtw_want(why, rt_place(ga, ann, 2), "#1 (9,cy) h=1").
rtw_want(why, rt_place(ga, ann, 2), "#2 (7,ann) h=1").
rtw_want(why, rt_place(ga, ann, 2), "#5 (4,dee) h=1").
rtw_want(why, rt_dup(gd, n3, 2), "rank(5 ; ?S2 : rk_dup[main](gd,?_$0,?S2)) = 2 [aggregate: 2 members").
rtw_want(whynot, rt_place(ga, ann, 3), "= 2, not 3 [aggregate]").
rtw_want(whynot, rt_ask(ga, 7, zed, 3), "has no value: 7, zed is not one of its 5 distinct values [aggregate]").
rtw_want(whynot, rt_ask(ga, f(1), bob, 1), "has no value: hole(agg_type_error) [aggregate]").
rtw_want(whynot, rt_bad(gx, 1), "has no value: hole(agg_type_error) [aggregate]").
rtw_never(why, rt_place(ga, ann, 2), "#1 (9,cy,").
rtw_never(whynot, rt_ask(ga, 7, zed, 3), "empty group").
rtw_never(whynot, rt_ask(ga, f(1), bob, 1), "empty group").
rtw_never(whynot, rt_bad(gx, 1), "empty group").
why_text_missing(K, A, T) :- rtw_want(K, A, T), not rtw_said(K, A, T).
why_text_leaked(K, A, T)  :- rtw_never(K, A, T), explained[$explain](K, A, _, L), N is str_segs(L, T), N > 1.
explain_refused(K, A)     :- explained[$explain](K, A, 0, _).
alarm(why_text_missing).
alarm(why_text_leaked).
alarm(explain_refused).

-- examples/checks/demand-neg-decided.rofl — demand_neg_decided: A NEGATION
-- UNFOLDED AT A CALL THAT A MATCH DECIDES is decided, whatever unknown its
-- unfolding met beside the match (f_a_decided_negation_below_a_call_shrugged).
--
-- dz_d leaves Z free, so it is answered on demand and not closed; dz_o reads it
-- negated and leaves Y free, so it is answered on demand too. dz_ro calls
-- dz_o(X, 1), which unfolds `not dz_d(X, 5)`; for X = 0 that unfolding finds
-- dz_d(0, 5) by the first rule, and the second rule meets the call dz_d(X', 5)
-- again (a cut cycle, an unknown). The unknown made dz_o(0, 1) a shrug, and with
-- it dz_nro(0..3), though the match already decided the negation fails.
edb(dz_q). edb(dz_e). edb(dz_s).
dz_q(0).
dz_e(0, 1). dz_e(1, 2). dz_e(2, 3). dz_e(5, 6).
dz_s(0). dz_s(1). dz_s(2). dz_s(3). dz_s(4). dz_s(5). dz_s(6).
dz_u(X, Y) :- dz_q(X).
dz_d(X, Z) :- dz_u(X, X).
dz_d(Y, Z) :- dz_d(X, Z), dz_e(X, Y).
dz_o(X, Y) :- dz_s(X), not dz_d(X, 5).
dz_ro(X)  :- dz_s(X), dz_o(X, 1).
dz_nro(X) :- dz_s(X), not dz_o(X, 1).

dz_wrong(X) :- dz_ro(X), dz_s(X), X < 4.
alarm(dz_wrong).

explain_request(whynot, dz_o(0, 1)).
explain_request(whynot, dz_nro(4)).

-- expect-row: dz_nro[main](0)
-- expect-row: dz_nro[main](1)
-- expect-row: dz_nro[main](2)
-- expect-row: dz_nro[main](3)
-- expect-no-row: shrug[$kernel](dz_o(0,
-- expect-no-row: shrug[$kernel](dz_nro(0)
-- expect-no-row: shrug[$kernel](dz_nro(3)
-- expect-row: explained[$explain](whynot,dz_o(0,1),3,"    failed premise: not dz_d[main](0,5) -- blocked: dz_d[main](0,5) holds") tick base support=0
-- expect-no-row: explained[$explain](whynot,dz_o(0,1),1,"whynot dz_o[main](0,1): no answer

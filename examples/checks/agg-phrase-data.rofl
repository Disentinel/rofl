pv_flag(f1, true). pv_flag(f2, false).
pv_edge(a, b, 1). pv_edge(b, c, 1). pv_edge(a, c, 5).
pv_member(g1, m1). pv_member(g1, m2). pv_member(g2, m3). pv_member(g2, m4).
pv_voted(m1). pv_voted(m2). pv_voted(m3).
pv_need(c1, 2). pv_need(c2, 1). pv_need(c3, 0).
pv_pct(50). pv_pct(100).
pv_start(p, 0).
pv_rank(g1, m1, 3). pv_rank(g1, m1, 1). pv_rank(g1, m2, 5). pv_rank(g2, m3, 3). pv_rank(g2, m4, 5).

-- expect-row: shrug[$kernel](hw_ny(c),inherited,
-- expect-row: shrug[$kernel](hw_nnx(c),inherited,
-- expect-row: unknown[main](hw_win(p))
-- expect-no-row: unknown[main](hw_nx(c))
-- expect-no-row: hw_nx[main](c)
-- expect-no-row: hw_ny[main](c)
-- expect-no-row: unknown[main](hw_nx(e))

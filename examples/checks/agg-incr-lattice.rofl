-- examples/checks/agg-incr-lattice.rofl — agg_incr_lattice: the ORDER LATTICES
-- under RETRACTION (docs/aggregates.md, "Ready for the incremental engine"). A
-- lattice contribution is a firing of a fact, not a member of a record, so its
-- stable id is the firing: `fir FACT id=H RULE@TICK [PREMISES] live|superseded`,
-- H over `rule@tick|premises, sorted`, and the algebra of the relation is its
-- `lat` line. A retraction takes the cone of the fact (the lattice facts that
-- rested on it, through each other) out and fires the rules into it again over
-- what stands, so the state must be the one of a world without the facts. The
-- retractions that are evaluated again come first: each evaluates the world
-- whole, so one that came last would answer for the deltas before it.
--
--   il_0sat(m, n, 3)  a value reached only through its own earlier values (a decrement
--                    that floors at 0) keeps them as its history, superseded and
--                    named by firing, and a retraction under it is evaluated again
--   il_e(b, c, 2)    the cheap path to c is gone: a to c is the direct edge, 5
--   il_cap(s, t, 4)  the widest path to u is the direct edge, 3, and t is gone
--   il_lk(x, p)      p and q held each other up around a cycle, with no seed: gone
--   il_s(a, 0)       the seed of il_hop: d was reached two ways, one a hop longer than the
--                    other, both resting on it, and all of it goes with the seed
edb(il_e). edb(il_cap). edb(il_sd). edb(il_lk). edb(il_0sat). edb(il_s). edb(il_h).
il_e(a, b, 1).
il_e(b, c, 2).
il_e(a, c, 5).
il_e(c, a, 3).
il_e(c, d, 0).
il_e(d, c, 0).
il_cap(s, t, 4).
il_cap(t, u, 7).
il_cap(s, u, 3).
il_sd(x, true).
il_sd(y, false).
il_sd(z, true).
il_lk(x, p).
il_lk(p, q).
il_lk(q, p).
il_lk(y, r).
il_lk(z, y).
il_0sat(m, n, 3).
il_0sat(p, q, 4).
il_s(a, 0).
il_h(a, b, 1).
il_h(a, c, 1).
il_h(b, d, 1).
il_h(a, d, 2).
lattice il_hop(X, min W).
il_hop(X, W) :- il_s(X, W).
il_hop(Y, W) :- il_hop(X, W1), il_h(X, Y, W2), W is W1 + W2.
lattice il_dec(A, C, min D).
il_dec(A, C, D) :- il_0sat(A, C, D).
il_dec(A, C, D) :- il_dec(A, C, D1), X is D1 - 1, D is max(X, 0).
lattice il_dist(A, C, min D).
il_dist(A, C, D) :- il_e(A, C, D).
il_dist(A, C, D) :- il_dist(A, B, D1), il_e(B, C, W), D is D1 + W.
lattice il_wide(A, C, max W).
il_wide(A, C, W) :- il_cap(A, C, W).
il_wide(A, C, W) :- il_wide(A, B, W1), il_cap(B, C, W2), W is min(W1, W2).
lattice il_taint(X, or B).
il_taint(X, B) :- il_sd(X, B).
il_taint(Y, B) :- il_taint(X, B), il_lk(X, Y).
lattice il_all(X, and B).
il_all(X, B) :- il_sd(X, B).
il_all(Y, B) :- il_all(X, B), il_lk(X, Y), B = false.


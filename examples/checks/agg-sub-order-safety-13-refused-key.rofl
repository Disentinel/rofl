-- expect-refusal: is not monotone in that order
-- a value that reaches a key: the cell it is concluded in is chosen by the value, which moves
edb(aosr_e).
aosr_e(a, b, 2, 9).
pareto aosr_key(A, B, min C, min T).
aosr_key(A, B, C, T) :- aosr_e(A, B, C, T).
aosr_key(A, C, C1, T1) :- aosr_key(A, B, C0, T0), aosr_e(B, _, C2, T2), C is C0, C1 is C0 + C2, T1 is T0 + T2.

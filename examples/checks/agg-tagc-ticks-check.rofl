-- examples/checks/agg-tagc-ticks-check.rofl — agg_tagc_ticks, over
-- agg-tag-ticks-data.rofl one tick deep with retain_ticks 0: a counting tag
-- staged @next arrives at the next tick as one derivation of the count it
-- held, added to the tick's own: x counted 1 at tick 0, and 2 at tick 1, the
-- carried 1 and its new edge. `why` of it shows both derivations, the carried
-- one staged at tick 0 by the rule concluding it @next. tk_k's weight 0 is
-- off its carrier at tick 0: the count is a hole there, and what it staged is
-- not known at tick 1.
explain_request(why, tk_n(x, 2)).
tkn_wrong(value)  :- not tk_n(x, 2).
tkn_wrong(two)    :- tk_n(A, S), tk_n(A, T), S != T.
tkn_line(K, L)    :- explained[$explain](K, _, _, L).
tkn_has(K, T)     :- tkn_line(K, L), tkn_text(K, T), N is str_segs(L, T), N > 1.
tkn_text_missing(K, T) :- tkn_text(K, T), not tkn_has(K, T).
tkn_explain_refused(K) :- explained[$explain](K, _, 0, _).
tkn_text(why, "tk_n[main](x,2) [tag counting: the sum of 2 derivations]").
tkn_text(why, "tk_n[main](x,1)  <= tk_n@count @tick 0 [past tick]").
tkn_text(K, T)@next :- tkn_text(K, T).
alarm(tkn_wrong).
alarm(tkn_text_missing).
alarm(tkn_explain_refused).
-- expect-row: tk_n[main](x,2)
-- expect-no-row: tk_k[main](q,
-- expect-row: hole[$kernel]($cell(tk_k@count,1,1,$cons(q,$cons(main,$nil))),support_withdrawn)
-- expect-row: shrug[$kernel]($next(tk_k@count,main,1,

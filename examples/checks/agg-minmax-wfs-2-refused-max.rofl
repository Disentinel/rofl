-- expect-refusal: max is not evaluated under well_founded semantics
-- examples/checks/agg-minmax-wfs-2-refused-max.rofl — max inside a well-founded
-- world is refused: its cell would be sealed under an assumption, over
-- positions whose win is unknown.
semantics(well_founded).
edb(wr_move).
wr_move(a, b). wr_move(b, a). wr_move(b, c).
wr_win(X) :- wr_move(X, Y), not wr_win(Y).
wr_m(M) :- M is max(V : wr_val(_, V)).
wr_val(X, 1) :- wr_win(X).
wr_val(X, 0) :- wr_move(X, _), not wr_win(X).

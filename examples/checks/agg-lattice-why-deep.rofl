-- examples/checks/agg-lattice-why-deep.rofl — agg_lattice_why, run with
-- `rofl-load --explain`: `why` of a lattice value 1200 derivations deep is
-- the whole tree in both engines, down to the source, and not a stack cut
-- short (an `explained` row 0 is the text of an error, which
-- agg-lattice-why-check.rofl's explain_refused names). Each level is a
-- member, its cell and its edge, as at any depth.
edb(explain_request).
edb(explained).
edb(lwd_e).
edb(lwd_src).
lwd_src(n0).
lattice lwd_d(C, min D).
lwd_d(C, 0) :- lwd_src(C).
lwd_d(C, D) :- lwd_d(B, D1), lwd_e(B, C, W), D is D1 + W.
explain_request(why, lwd_d(n1200, 1200)).
lwd_line(T) :- explained[$explain](why, lwd_d(n1200, 1200), _, L), lwd_want(T), N is str_segs(L, T), N > 1.
lwd_want("lwd_d[main](n1200,1200) [lattice min: 1 member]").
lwd_want("lwd_d[main](n600,600) [lattice min: 1 member]").
lwd_want("lwd_d[main](n0,0) [lattice min: 1 member]").
lwd_want("lwd_src[main](n0) [axiom]").
lwd_want("lwd_e[main](n0,n1,1) [axiom]").
why_deep_missing(T) :- lwd_want(T), not lwd_line(T).
alarm(why_deep_missing).
lwd_e(n0, n1, 1).
lwd_e(n1, n2, 1).
lwd_e(n2, n3, 1).

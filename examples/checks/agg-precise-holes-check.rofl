-- expect-row: ph_emax[main](e3,1152921504606846975)
-- expect-row: ph_emed[main](e4,1)

-- A PROJECTION TWO UNKNOWNS COULD ADD rests on both: a1's count moves if
-- either ph_a(a1, y, 1) or ph_a(a1, y, 2) holds, and names both, whatever
-- order they were found in. A GROUP'S ROOTS ARE WHAT MOVES IT, at its cell
-- and at every firing that reads it: a2's min moves with y:1 and not with
-- z:9, so neither the cell nor the conclusion names z's rule; its count
-- moves with either.
edb(ph_a0).
ph_a0(a1, x, 0). ph_a0(a2, x, 5).
ph_a(G, X, V) :- ph_a0(G, X, V).
ph_a(a1, y, 1) :- ph_big(B), Z is B + 1, Z > 0.
ph_a(a1, y, 2) :- ph_big(B), Z is B + 2, Z > 0.
ph_a(a2, y, 1) :- ph_big(B), Z is B + 3, Z > 0.
ph_a(a2, z, 9) :- ph_big(B), Z is B + 4, Z > 0.
ph_acnt(G, N) :- N is count(X : ph_a(G, X, _)).
ph_amin(G, M) :- M is min(V : ph_a(G, _, V)).
-- expect-row: ph_amin[main](a1,0)


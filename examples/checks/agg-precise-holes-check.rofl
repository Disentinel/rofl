-- A FAULT EVERY COMPLETION KEEPS stays the group's own. A known member no
-- fold reads (e1, e2: oops) is agg_type_error whatever a possible adds, and a
-- known total out of range at both ends of what the possibles could add
-- (e3) is agg_overflow: a hole of that fault, never withdrawn, the shrug
-- blaming the fault. A count reads no value, so e1's changes; an overflow a
-- possible could mend (e4: -5 brings it back) is withdrawn.
edb(ph_e0).
ph_e0(e1, a, oops). ph_e0(e2, a, oops).
ph_e0(e3, a, 1152921504606846975). ph_e0(e3, c, 1152921504606846975).
ph_e0(e4, a, 1152921504606846975). ph_e0(e4, c, 1).
ph_e(G, K, V) :- ph_e0(G, K, V).
ph_e(e1, b, 3) :- ph_big(B), Z is B + 1, Z > 0.
ph_e(e3, b, 3) :- ph_big(B), Z is B + 1, Z > 0.
ph_e(e4, b, -5) :- ph_big(B), Z is B + 1, Z > 0.
ph_ecnt(G, N) :- N is count(K : ph_e(G, K, _)).
ph_esum(G, S) :- S is sum(V ; K : ph_e(G, K, V)).
ph_emax(G, M) :- M is max(V : ph_e(G, _, V)).
ph_emed(G, M) :- M is median(V ; K : ph_e(G, K, V)).
ph_fault(Rel, G, Why) :- ph_rel(R, Rel), shrug[$kernel]($cell(R, _, _, $cons(G, $nil)), fault, Why).
edb(ph_fwant).
ph_fwant(ph_esum, e1, agg_type_error). ph_fwant(ph_esum, e2, agg_type_error).
ph_fwant(ph_emax, e1, agg_type_error). ph_fwant(ph_emax, e2, agg_type_error).
ph_fwant(ph_emed, e1, agg_type_error). ph_fwant(ph_emed, e2, agg_type_error).
ph_fwant(ph_esum, e3, agg_overflow).
ph_fault_missing(Rel, G, Why) :- ph_fwant(Rel, G, Why), not ph_fault(Rel, G, Why).
alarm(ph_fault_missing).

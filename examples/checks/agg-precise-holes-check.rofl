-- expect-row: shrug[$kernel]($cell(ra3d480df,1,0,$cons(a2,$nil)),inherited,from($cons($rule(ra42dda61),$nil)))
-- expect-row: shrug[$kernel](ph_amin(a2,$unknown_value),inherited,from($cons($rule(ra42dda61),$nil)))
-- expect-row: shrug[$kernel](ph_acnt(a2,$unknown_value),inherited,from($cons($rule(r786c83b7),$cons($rule(ra42dda61),$nil))))

-- the group a possible could make when its group is not known is none of the groups sealed: a
-- labeled unknown known not to be g1 or g2, with a count of one, so a negation over the groups
-- that count 2 is decided for every group but g2 (docs/aggregates.md, "Labeled unknowns")
edb(ph_hh).
ph_hh(h1). ph_hh(h2). ph_hh(h3).
ph_nwc(G) :- ph_g(G), not ph_wc(G, 2).
ph_nh(H) :- ph_hh(H), not ph_pair(g1, H, 2).

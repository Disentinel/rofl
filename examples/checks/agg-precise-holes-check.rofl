-- examples/checks/agg-precise-holes-check.rofl — agg_precise_holes over
-- agg-precise-data.rofl (docs/aggregates.md, "Precise holes, as built"): what
-- a hole left out holes exactly the groups of a body aggregate or the keys of
-- a counting tag whose value it could change, each on its own cell, never
-- the aggregate whole. A group it cannot change is sealed with its value and
-- read as decided, by a negation too; a group only it could make is a cell
-- of its own with no member known; a possible whose group is not known holes
-- the correlation beside the groups sealed, which stand where it cannot
-- change them.
ph_rel(R, Rel) :- concludes[$kernel](R, Rel).
ph_holed(Rel, G) :- ph_rel(R, Rel), hole[$kernel]($cell(R, _, _, $cons(G, $nil)), support_withdrawn).
ph_holed(Rel, gh(G, H)) :- ph_rel(R, Rel), hole[$kernel]($cell(R, _, _, $cons(G, $cons(H, $nil))), support_withdrawn).
ph_holed(Rel, whole) :- ph_rel(R, Rel), hole[$kernel]($cell(R, _, _, $nil), support_withdrawn).
-- the tag's cells are keyed by the head and its book: the only keys of two
-- whose second is main
ph_holed(ph_t, A) :- ph_tw(A, _), hole[$kernel]($cell(_, _, _, $cons(A, $cons(main, $nil))), support_withdrawn).
edb(ph_want).
ph_want(ph_cnt, g1). ph_want(ph_cnt, g3). ph_want(ph_cnt, g5). ph_want(ph_cnt, g7).
ph_want(ph_sum, g1). ph_want(ph_sum, g2). ph_want(ph_sum, g3). ph_want(ph_sum, g7).
ph_want(ph_min, g3). ph_want(ph_min, g5). ph_want(ph_min, g7).
ph_want(ph_max, g1). ph_want(ph_max, g2). ph_want(ph_max, g3). ph_want(ph_max, g7).
ph_want(ph_med, g3). ph_want(ph_med, g5). ph_want(ph_med, g7).
ph_want(ph_q90, g1). ph_want(ph_q90, g2). ph_want(ph_q90, g3). ph_want(ph_q90, g7).
ph_want(ph_rk4, g5).
ph_want(ph_neg2, g1). ph_want(ph_neg2, g3). ph_want(ph_neg2, g5). ph_want(ph_neg2, g7).
ph_want(ph_neg, g1). ph_want(ph_neg, g3). ph_want(ph_neg, g4). ph_want(ph_neg, g5). ph_want(ph_neg, g7).
ph_want(ph_pair, gh(g1, h2)).
ph_want(ph_wc, g2).
ph_want(ph_cq, g1). ph_want(ph_cq, g3). ph_want(ph_cq, g5). ph_want(ph_cq, g7).
ph_want(ph_sq, g1). ph_want(ph_sq, g2). ph_want(ph_sq, g3).
ph_want(ph_t, b).
ph_want(ph_two, g1). ph_want(ph_two, g3). ph_want(ph_two, g5). ph_want(ph_two, g7).
ph_want(ph_ecnt, e1). ph_want(ph_ecnt, e3). ph_want(ph_ecnt, e4).
ph_want(ph_esum, e4).
ph_want(ph_acnt, a1). ph_want(ph_acnt, a2).
ph_want(ph_amin, a2).
ph_hole_missing(Rel, G) :- ph_want(Rel, G), not ph_holed(Rel, G).
ph_hole_extra(Rel, G) :- ph_holed(Rel, G), ph_rel(_, Rel), not ph_want(Rel, G).
ph_hole_extra(ph_t, A) :- ph_holed(ph_t, A), not ph_want(ph_t, A).
alarm(ph_hole_missing).
alarm(ph_hole_extra).

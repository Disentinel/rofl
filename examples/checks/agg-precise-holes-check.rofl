-- expect-no-row: ph_hole_missing[main](
-- the groups the unknowns cannot change hold, and a negation above them is
-- decided: never undecided for a hole in another group
ph_ncnt(G) :- ph_g(G), not ph_cnt(G, 1).
ph_nsum(G) :- ph_g(G), not ph_sum(G, 8).
ph_nt(A)   :- ph_tw(A, _), not ph_t(A, 2).
ph_nsz(G)  :- ph_g(G), not ph_sum(G, 0).

-- examples/checks/holes-negation-wfs-unknown.rofl — `unknown` BESIDE A HOLE,
-- under well-founded semantics, in both engines (docs/aggregates.md, "Shrugs,
-- as built"). c's one move is not known (oops + 0 is no number), so wu_win(c)
-- may hold; the alternating fixpoint never derives it, and it is no paradox:
-- it is a shrug inherited from the fault, and so is `unknown(wu_win(c))` and
-- wu_decided(c) that reads it under not. k and l are decided.
semantics(well_founded).
edb(wu_e).
edb(wu_pos).
wu_e(c, d, oops). wu_e(k, l, 1).
wu_pos(c). wu_pos(d). wu_pos(k). wu_pos(l).
wu_move(A, B) :- wu_e(A, B, W), V is W + 0, V > 0.
wu_win(X) :- wu_move(X, Y), not wu_win(Y).
wu_decided(X) :- wu_pos(X), not unknown(wu_win(X)).

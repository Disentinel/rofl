tag tb_step(A, B, tropical W).
tb_step(A, B, W) :- tb_e(A, B, W).
tag tb_cost(A, C, tropical T).
tb_cost(A, C, T) :- tb_step(A, C, _).
tb_cost(A, C, T) :- tb_cost(A, B, _), tb_step(B, C, _).

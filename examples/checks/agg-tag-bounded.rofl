tbw_wrong(A, C, T) :- tbw_want(A, C, T), not tb_cost(A, C, T).
tbw_wrong(A, C, T) :- tb_cost(A, C, T), not tbw_want(A, C, T).
tbw_n(N)           :- N is count(A, C : tb_cost(A, C, _)).
tbw_count_wrong(N) :- tbw_n(N), N != 144.
alarm(tbw_wrong).
alarm(tbw_count_wrong).

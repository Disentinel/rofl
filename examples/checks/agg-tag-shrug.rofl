-- examples/checks/agg-tag-shrug.rofl — agg_tag_shrug, run with `rofl load
-- --explain`: an idempotent tag's fault is a shrug, `fault`, its meta the
-- cause, on the cell (b to c, a probability of 2); a cell that rested on it
-- is a shrug inherited from it (a to c, a to d), one row each; a rule reading
-- the tag as a value is a shrug inherited from the same root (likely(a, c)),
-- never a definite no; and what no fault reached is decided (likely(a, b),
-- likely(c, d)). The rows are data: the faulted cells, read off them, are
-- exactly one. `why` of a reader names its root and the root's cause.
edb(tsg_p).
tsg_p(a, b, 500000). tsg_p(b, c, 2000000). tsg_p(c, d, 500000).
tag tsg_pr(A, B, viterbi P).
tsg_pr(A, B, W)   :- tsg_p(A, B, W).
tsg_pr(A, C, T)   :- tsg_pr(A, B, _), tsg_pr(B, C, _).
tsg_likely(A, B)  :- tsg_p(A, B, _), tsg_pr(A, B, P), P >= 200000.
tsg_likely(A, C)  :- tsg_p(A, B, _), tsg_p(B, C, _), tsg_pr(A, C, P), P >= 200000.
tsg_fault(K, C)   :- shrug[$kernel]($lattice(tsg_pr, main, 0, K), fault, C).
tsg_fault_want($cons(b, $cons(c, $nil)), tag_off_carrier).
tsg_fault_wrong(K) :- tsg_fault(K, C), not tsg_fault_want(K, C).
tsg_fault_wrong(K) :- tsg_fault_want(K, C), not tsg_fault(K, C).
tsg_undecided()   :- not tsg_likely(a, b).
tsg_undecided()   :- not tsg_likely(c, d).
edb(explain_request).
edb(explained).
explain_request(why, tsg_likely(a, c)).
tsg_holds(T)      :- explained[$explain](why, _, _, L), tsg_want(T), N is str_segs(L, T), N > 1.
tsg_want("tsg_likely(a, c) is a shrug: inherited").
tsg_want("root $lattice(tsg_pr, main, 0, [b, c]) is a shrug: fault, a builtin or a fold could not compute a value; tag_off_carrier").
tsg_text_missing(T) :- tsg_want(T), not tsg_holds(T).
alarm(tsg_fault_wrong).
alarm(tsg_undecided).
alarm(tsg_text_missing).
-- expect-row: shrug[$kernel]($lattice(tsg_pr,main,0,$cons(b,$cons(c,$nil))),fault,tag_off_carrier)
-- expect-row: shrug[$kernel]($lattice(tsg_pr,main,0,$cons(a,$cons(c,$nil))),inherited,from($cons($lattice(tsg_pr,main,0,$cons(b,$cons(c,$nil))),$nil)))
-- expect-row: shrug[$kernel]($lattice(tsg_pr,main,0,$cons(a,$cons(d,$nil))),inherited,from($cons($lattice(tsg_pr,main,0,$cons(b,$cons(c,$nil))),$nil)))
-- expect-row: shrug[$kernel](tsg_likely(a,c),inherited,from($cons($lattice(tsg_pr,main,0,$cons(b,$cons(c,$nil))),$nil)))
-- expect-no-row: tsg_likely[main](a,c)
-- expect-no-row: shrug[$kernel](tsg_likely(a,b)

-- examples/checks/agg-minmax-why-check.rofl — agg_minmax_why, run with
-- `rofl-load --explain`: `why` of a minimum, a maximum and an `or` names
-- both tied facts and what it sealed; `whynot` of a wrong minimum says what
-- it is; `whynot` over an empty group says the group is empty, and over a
-- group whose value is not a number says it is a hole, not empty.
edb(explain_request).
edb(explained).
explain_request(why, am_min(g1, 3)).
explain_request(whynot, am_min(g1, 4)).
explain_request(whynot, am_min(g3, 1)).
explain_request(why, am_max(g1, 9)).
explain_request(why, am_or(g1, true)).
explain_request(whynot, am_min(gt, 1)).
amy_holds(K, A, T) :- explained[$explain](K, A, _, L), amy_want(K, A, T), N is str_segs(L, T), N > 1.
amy_want(why, am_min(g1, 3), "sealed am_d@").
amy_want(why, am_min(g1, 3), "[aggregate: 2 members").
amy_want(why, am_min(g1, 3), "am_d[main](g1,3,a)").
amy_want(why, am_min(g1, 3), "am_d[main](g1,3,b)").
amy_want(whynot, am_min(g1, 4), "= 3, not 4 [aggregate]").
amy_want(whynot, am_min(g3, 1), "has no value: empty group [aggregate]").
amy_want(why, am_max(g1, 9), "sealed am_d@").
amy_want(why, am_max(g1, 9), "[aggregate: 2 members").
amy_want(why, am_max(g1, 9), "am_d[main](g1,9,a)").
amy_want(why, am_max(g1, 9), "am_d[main](g1,9,b)").
amy_want(why, am_or(g1, true), "sealed am_flag@").
amy_want(why, am_or(g1, true), "[aggregate: 2 members").
amy_want(why, am_or(g1, true), "am_flag[main](g1,true,a)").
amy_want(why, am_or(g1, true), "am_flag[main](g1,true,b)").
amy_want(whynot, am_min(gt, 1), "has no value: hole(agg_type_error) [aggregate]").
why_text_missing(K, A, T) :- amy_want(K, A, T), not amy_holds(K, A, T).
-- the value that is not the minimum is not a member
why_nontie_listed()    :- explained[$explain](why, am_min(g1, 3), _, L), N is str_segs(L, "(5) h="), N > 1.
-- a hole is not an empty group, and its members are not missing facts
why_hole_as_empty(T)   :- amy_never_hole(T), explained[$explain](whynot, am_min(gt, 1), _, L), N is str_segs(L, T), N > 1.
amy_never_hole("empty group").
amy_never_hole("no matching base fact").
explain_refused(K, A)  :- explained[$explain](K, A, 0, _).
alarm(why_text_missing).
alarm(why_nontie_listed).
alarm(why_hole_as_empty).
alarm(explain_refused).

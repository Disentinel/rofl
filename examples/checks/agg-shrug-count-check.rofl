-- examples/checks/agg-shrug-count-check.rofl — agg_count_shrug over
-- agg-shrug-agg-data.rofl: a count over a member a hole left out is a shrug
-- inherited from the fault, not a count of the rest; so is a count whose
-- inner body reads `unknown(A)` of what a hole left out, positively or under
-- not; a count the unknown cannot reach under any completion (its member is
-- excluded by the rest of the inner body) is decided; and a negation of a
-- shrug is a shrug.
sac_n(G, N) :- sa_g(G), N is count(K : sa_x(G, K, _)).
sac_settled(N) :- N is count(X : sa_pos(X), not unknown(sa_w(X))).
sac_open(N) :- N is count(X : sa_pos(X), unknown(sa_w(X))).
sac_known(N) :- N is count(X : sa_pos(X), sa_w(X), X != c).
sac_empty(G) :- sa_g(G), not sac_n(G, 2).

dc_n(X)    :- dc_e(X, _).
dc_n(Y)    :- dc_e(_, Y).
dc_u(X, Y) :- dc_q(X).
dc_h(X)    :- dc_u(X, X).
dc_r(X)    :- dc_h(X).
dc_r(Y)    :- dc_e(X, Y), dc_r(X).
dc_last(X) :- dc_r(700), X = 1.

dc_missed(N) :- dc_n(N), not dc_r(N).
alarm(dc_missed).


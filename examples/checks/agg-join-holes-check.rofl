-- expect-no-row: ajh_count[main](b,
-- the membership's fault names its rule
ajh_in_rule(R)  :- concludes[$kernel](R, ajh_in).
ajh_in_holed()  :- ajh_in_rule(R), hole[$kernel]($rule(R), set_type_error).
ajh_in_silent() :- not ajh_in_holed().
alarm(ajh_in_silent).
-- and so does every read of what is spelled as a value and is none
ajh_bad(ajh_in_inv). ajh_bad(ajh_in_enum). ajh_bad(ajh_sub_left).
ajh_bad(ajh_sub_right). ajh_bad(ajh_sub_neg). ajh_bad(ajh_sub_mix).
ajh_bad_holed(P)  :- ajh_bad(P), concludes[$kernel](R, P), hole[$kernel]($rule(R), set_type_error).
ajh_bad_silent(P) :- ajh_bad(P), not ajh_bad_holed(P).
alarm(ajh_bad_silent).

-- examples/checks/agg-sub-why-check.rofl — agg_sub_why, run with
-- `rofl-load --explain`. `why` of a member of a front names its relation's
-- algebra, its members and its place in the front, and every value given to
-- the cell that it dominates, with the dominance rule; a value it was
-- reached through and that was dominated since says so, and by what.
-- `whynot` of a value given and dominated names the member that dominates it
-- and the rule, written out; of a value no rule gives, the member that would
-- dominate it, or, where none would, that it would join the front and what
-- the rules give at the key; of a key no rule reaches, the exploration.
edb(explain_request).
edb(explained).
explain_request(why, as_route(a, c, 3, 3)).
explain_request(why, as_best(i5, 3, 9)).
explain_request(why, as_sat(p, 0)).
explain_request(why, as_d(a, t, 1)).
explain_request(whynot, as_route(a, c, 7, 7)).
explain_request(whynot, as_route(a, c, 6, 6)).
explain_request(whynot, as_route(a, c, 1, 1)).
explain_request(whynot, as_pick(k2, bronze)).
explain_request(whynot, as_route(z, z, 1, 1)).
explain_request(whynot, asy_f(k, 0)).
explain_request(whynot, asy_c(k, 7)).
explain_request(whynot, asy_u(k, 3)).
-- whynot of a value never given asks what the close would: whether it
-- dominates itself, and each comparison with the front, which may fault or
-- read what a hole left unknown
edb(asy_fi). edb(asy_z).
asy_fi(k, 4). asy_fi(k, 2).
asy_f(K, V) :- asy_fi(K, V).
asy_f(K, X) <= asy_f(K, Y) :- Z is 100 / X, Y < X, Z > 0.
asy_c(K, V) :- asy_fi(K, V).
asy_c(K, X) <= asy_c(K, Y) :- X = 7, Y = 7.
asy_z(1, 2). asy_z(3, 0).
asy_r(X, R) :- asy_z(X, D), R is 6 / D.
asy_u(K, 1) :- asy_fi(K, 4).
asy_u(K, X) <= asy_u(K, Y) :- asy_r(Y, RY), asy_r(X, RX), RY < RX.
asy_holds(K, A, T) :- explained[$explain](K, A, _, L), asy_want(K, A, T), N is str_segs(L, T), N > 1.
asy_want(why, as_route(a, c, 3, 3), "as_route[main](a,c,3,3) [subsumption: 1 member; 2 of 3 in the front of its cell]").
asy_want(why, as_route(a, c, 3, 3), "as_e[main](a,c,3,3) [axiom]").
asy_want(why, as_route(a, c, 3, 3), "dominates as_route[main](a,c,11,3) by r").
asy_want(why, as_route(a, c, 3, 3), "dominates as_route[main](a,c,7,7) by r").
asy_want(why, as_route(a, c, 3, 3), "dominates as_route[main](a,c,9,5) by r").
asy_want(why, as_best(i5, 3, 9), "as_best[main](i5,3,9) [subsumption: 1 member; 4 of 4 in the front of its cell]").
asy_want(why, as_sat(p, 0), "as_sat[main](p,0) [subsumption: 1 member; 1 of 1 in the front of its cell]").
asy_want(why, as_d(a, t, 1), "as_d[main](a,t,1) [subsumption: 2 members; 1 of 1 in the front of its cell]").
asy_want(why, as_d(a, t, 1), "#1 h=1 <= r").
asy_want(why, as_d(a, t, 1), "#2 h=3 <= r").
asy_want(why, as_d(a, t, 1), "as_d[main](a,a2,0) [subsumption: 1 member; 1 of 1 in the front of its cell]").
asy_want(why, as_sat(p, 0), "as_sat[main](p,1) [subsumption: 1 member; an earlier value, dominated since by as_sat[main](p,0)]").
asy_want(whynot, as_route(a, c, 7, 7), "as_route[main](a,c) is a subsumption cell; its front is as_route[main](a,c,2,10), as_route[main](a,c,3,3), as_route[main](a,c,5,1)").
asy_want(whynot, as_route(a, c, 7, 7), "as_route[main](a,c,7,7) was given, and is dominated by as_route[main](a,c,3,3): r").
asy_want(whynot, as_route(a, c, 7, 7), "<= as_route[main](?A,?B,?C2,?T2)@now :- ?C2 <= ?C1, ?T2 <= ?T1, ?C2 < ?C1)").
asy_want(whynot, as_route(a, c, 6, 6), "no rule gives as_route[main](a,c,6,6), and it would be dominated by as_route[main](a,c,3,3)").
asy_want(whynot, as_route(a, c, 1, 1), "as_route[main](a,c,1,1) would join the front, and no rule gives it: 9 values given at the key").
asy_want(whynot, as_route(a, c, 1, 1), "3, 3 <= r").
asy_want(whynot, as_route(a, c, 1, 1), ": as_e[main](a,c,3,3)").
asy_want(whynot, as_pick(k2, bronze), "as_pick[main](k2,bronze) was given, and is dominated by as_pick[main](k2,gold)").
asy_want(whynot, as_route(z, z, 1, 1), "failed premise").
asy_want(whynot, asy_f(k, 0), "no rule gives asy_f[main](k,0); given, its cell would be a hole, arith_zero_divisor: comparing it with itself faults in r").
asy_want(whynot, asy_c(k, 7), "no rule gives asy_c[main](k,7), and it dominates itself by r").
asy_want(whynot, asy_c(k, 7), "its cell would be a conflict, dominance_cycle").
asy_want(whynot, asy_u(k, 3), "no rule gives asy_u[main](k,3); given, its cell would not be known: comparing it with itself in r").
asy_text_missing(K, A, T) :- asy_want(K, A, T), not asy_holds(K, A, T).
alarm(asy_text_missing).
-- a front's why names no value it does not dominate
asy_wrong(K, A) :- explained[$explain](K, A, _, L), asy_never(K, A, T), N is str_segs(L, T), N > 1.
asy_never(why, as_route(a, c, 3, 3), "dominates as_route[main](a,c,6,14)").
asy_never(why, as_route(a, c, 3, 3), "dominates as_route[main](a,c,8,12)").
asy_never(whynot, as_route(z, z, 1, 1), "subsumption cell").
asy_never(whynot, asy_f(k, 0), "would join the front").
asy_never(whynot, asy_c(k, 7), "would join the front").
asy_never(whynot, asy_u(k, 3), "would join the front").
alarm(asy_wrong).
asy_explain_refused(K, A) :- explained[$explain](K, A, 0, _).
alarm(asy_explain_refused).

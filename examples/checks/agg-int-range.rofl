-- expect-row: hole[$kernel]($rule(r41e76bb1),arith_overflow)
-- expect-row: hole[$kernel]($rule(r68247855),arith_overflow)
-- expect-row: hole[$kernel]($rule(r7fad3d7d),arith_overflow)
-- expect-row: hole[$kernel]($rule(ra9262047),arith_overflow)

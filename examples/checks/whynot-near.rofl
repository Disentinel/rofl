-- examples/checks/whynot-near.rofl — whynot_near, run with `rofl load --explain`.
-- A WHYNOT STAYS NEAR ITS TARGET (w_whynot_stays_near_its_target). Forty call
-- sites, none of them `listen`: asked why no site of the family `net` is, the
-- walk starts from what the question names, the family's names, and fails at
-- the one premise that says no call has that callee, not at sixteen calls
-- picked from all forty. The same past a negation, from a text the question
-- names. Asked with nothing bound, it says how many matches it left.
edb(explain_request).
edb(explained).
edb(wn_call).
edb(wn_callee).
edb(wn_family_name).
edb(wn_arg).
edb(wn_text).
edb(wn_clean).
wn_family_name(net, "listen").
wn_family_name(fs, "writeFile").
wn_site(F) :- wn_call(C), wn_callee(C, N), wn_family_name(F, N).
wn_leak(T) :- wn_call(C), wn_arg(C, A), not wn_clean(A), wn_text(A, T).
wn_nowhere(x) :- wn_call(C), wn_callee(C, "spawn").
explain_request(whynot, wn_site(net)).
explain_request(whynot, wn_leak("secret")).
explain_request(whynot, wn_nowhere(x)).
wn_holds(K, A, T) :- explained[$explain](K, A, _, L), wn_want(K, A, T), N is str_segs(L, T), N > 1.
wn_want(whynot, wn_site(net), "failed premise: wn_callee[main](?C#0,\"listen\")").
wn_want(whynot, wn_leak("secret"), "failed premise: wn_text[main](?A#0,\"secret\")").
wn_want(whynot, wn_nowhere(x), "followed 16 of 40 matches of wn_call[main](?C#0)").
wn_text_missing(K, A, T) :- wn_want(K, A, T), not wn_holds(K, A, T).
wn_refused(K, A) :- explained[$explain](K, A, 0, _).
alarm(wn_text_missing).
alarm(wn_refused).

wn_call(c00). wn_callee(c00, "f0"). wn_arg(c00, a00). wn_text(a00, "t0").
wn_call(c01). wn_callee(c01, "f1"). wn_arg(c01, a01). wn_text(a01, "t1").

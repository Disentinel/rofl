-- the chain of agg-datastrat-chain.rofl has its value, c(k) = k, inside a budget
-- the chain's own 60 firings fit and a layer firing its rules whole (1830) does not.
dc_wrong(C, V) :- dc_want(C, V), not val(C, V).
dc_extra(C) :- val(C, _), not dc_want(C, _).
alarm(dc_wrong).
alarm(dc_extra).

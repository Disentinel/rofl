-- examples/checks/agg-empty-why-check.rofl — agg_empty_why, run with
-- `rofl-load --explain`: `why` of a zero says the group is empty and what it
-- sealed, and `whynot` of a minimum over an empty group says the same.
edb(explain_request).
edb(explained).
explain_request(why, ae_votes(c4, 0)).
explain_request(whynot, ae_best(c4, 1)).
aey_holds(K, A, T) :- explained[$explain](K, A, _, L), aey_want(K, A, T), N is str_segs(L, T), N > 1.
aey_want(why, ae_votes(c4, 0), "= 0 [aggregate: empty group, sealed ae_ballot@").
aey_want(whynot, ae_best(c4, 1), "has no value: empty group [aggregate]").
why_empty_missing(K, A, T) :- aey_want(K, A, T), not aey_holds(K, A, T).
explain_refused(K, A)      :- explained[$explain](K, A, 0, _).
alarm(why_empty_missing).
alarm(explain_refused).

-- examples/checks/agg-tag-eval-check.rofl — agg_tag_eval: every idempotent tag
-- of agg-tag-data.rofl holds exactly the value derived by hand, one fact per
-- key, both directions.
--
-- tg_cost, cheapest over the cycle a -> b -> c -> a: from a, b 3, c 3 + 4 = 7
-- (the direct 9 is worse), a again 7 + 1 = 8, d min(7 + 2, 3 + 6) = 9; from
-- b, c 4, a 5, b 8, d 6; from c, a 1, b 4, c 8, d 2; d 0 round its own
-- zero-weight loop; e to f 2 two ways, e to g 1, g to f 1; h to itself 0.
-- tg_short, the same with every proper prefix cheaper than 6: a -> a needs
-- a -> c at 7, so it has no fact; everything else as tg_cost.
-- tg_pr, max of products in millionths: a -> c 0.5 x 0.8 = 0.4 over the
-- direct 0.3, a -> a 0.4 x 0.9 = 0.36, b -> a 0.8 x 0.9 = 0.72, c -> b
-- 0.9 x 0.5 = 0.45, b -> b and c -> c 0.36; x -> z 1 x 1 millionths,
-- 0.000001, rounded down to 0: the fact holds, tagged 0.
-- tg_tr, max of mins: a -> c min(0.5, 0.8) = 0.5 over 0.3; everything
-- through a -> b at most 0.5; b -> a min(0.8, 0.9); x -> z 1.
tge_want(cost, a, a, 8). tge_want(cost, a, b, 3). tge_want(cost, a, c, 7). tge_want(cost, a, d, 9).
tge_want(cost, b, a, 5). tge_want(cost, b, b, 8). tge_want(cost, b, c, 4). tge_want(cost, b, d, 6).
tge_want(cost, c, a, 1). tge_want(cost, c, b, 4). tge_want(cost, c, c, 8). tge_want(cost, c, d, 2).
tge_want(cost, d, d, 0). tge_want(cost, e, f, 2). tge_want(cost, e, g, 1). tge_want(cost, g, f, 1).
tge_want(cost, h, h, 0).
tge_want(short, a, b, 3). tge_want(short, a, c, 7). tge_want(short, a, d, 9).
tge_want(short, b, a, 5). tge_want(short, b, b, 8). tge_want(short, b, c, 4). tge_want(short, b, d, 6).
tge_want(short, c, a, 1). tge_want(short, c, b, 4). tge_want(short, c, c, 8). tge_want(short, c, d, 2).
tge_want(short, d, d, 0). tge_want(short, e, f, 2). tge_want(short, e, g, 1). tge_want(short, g, f, 1).
tge_want(pr, a, a, 360000). tge_want(pr, a, b, 500000). tge_want(pr, a, c, 400000).
tge_want(pr, b, a, 720000). tge_want(pr, b, b, 360000). tge_want(pr, b, c, 800000).
tge_want(pr, c, a, 900000). tge_want(pr, c, b, 450000). tge_want(pr, c, c, 360000).
tge_want(pr, x, y, 1). tge_want(pr, x, z, 0). tge_want(pr, y, z, 1).
tge_want(tr, a, a, 500000). tge_want(tr, a, b, 500000). tge_want(tr, a, c, 500000).
tge_want(tr, b, a, 800000). tge_want(tr, b, b, 500000). tge_want(tr, b, c, 800000).
tge_want(tr, c, a, 900000). tge_want(tr, c, b, 500000). tge_want(tr, c, c, 500000).
tge_want(tr, x, y, 1). tge_want(tr, x, z, 1). tge_want(tr, y, z, 1).
tge_got(cost, A, B, T)  :- tg_cost(A, B, T).
tge_got(short, A, B, T) :- tg_short(A, B, T).
tge_got(pr, A, B, T)    :- tg_pr(A, B, T).
tge_got(tr, A, B, T)    :- tg_tr(A, B, T).
tge_missing(R, A, B, T) :- tge_want(R, A, B, T), not tge_got(R, A, B, T).
tge_extra(R, A, B, T)   :- tge_got(R, A, B, T), not tge_want(R, A, B, T).
tge_two(R, A, B)        :- tge_got(R, A, B, S), tge_got(R, A, B, T), S != T.
-- a tag is a value a rule reads: the cheap pairs, by hand from tg_cost
tge_cheap_want(a, b). tge_cheap_want(b, a). tge_cheap_want(b, c). tge_cheap_want(c, a).
tge_cheap_want(c, b). tge_cheap_want(c, d). tge_cheap_want(d, d). tge_cheap_want(e, f).
tge_cheap_want(e, g). tge_cheap_want(g, f). tge_cheap_want(h, h).
tge_cheap_wrong(A, B) :- tge_cheap_want(A, B), not tg_cheap(A, B).
tge_cheap_wrong(A, B) :- tg_cheap(A, B), not tge_cheap_want(A, B).
alarm(tge_missing).
alarm(tge_extra).
alarm(tge_two).
alarm(tge_cheap_wrong).

-- expect-refusal: not monotone in the value
-- examples/checks/agg-cell-safety-8-refused-twice.rofl — D1 + D1: the other operand depends on the value too, and safety.rofl asks that it not.
edb(acsr_e).
edb(acsr_n).
edb(acsr_s).
acsr_e(a, b, 2).
acsr_e(b, a, 3).
acsr_n(a, b).
acsr_s(a, false).
lattice acsr_twice(A, C, min D).
acsr_twice(A, C, D) :- acsr_e(A, C, D).
acsr_twice(A, C, D) :- acsr_twice(A, B, D1), acsr_e(B, C, _), D is D1 + D1.

-- examples/checks/agg-datastrat-chain.rofl — A CHAIN OF 60 SUMS, each over the one
-- before: c1 = SUM(c0), c2 = SUM(c1, c0), a component as relations (val reads val
-- through its own sum) and a chain as data, 60 layers deep with one correlation in each.
-- A layer fires only the instances that are new to it, so the chain is 60 firings and
-- not 1830 (f_a_stratified_layer_fires_its_rules_whole): the budget of its check is
-- a few times the first and far below the second.
--
--   c0 = 1, c(k) = SUM(c(k-1), c0) = k  (c1 sums the one cell c0 names twice)
edb(seed). edb(sum_head). edb(in_range).
seed(c0, 1).
val(C, V) :- seed(C, V).
val(N, V) :- sum_head(N, I), V is sum(X ; C : in_range(I, C), val(C, X)).
sum_head(c1, r1). in_range(r1, c0). in_range(r1, c0).
sum_head(c2, r2). in_range(r2, c1). in_range(r2, c0).
sum_head(c3, r3). in_range(r3, c2). in_range(r3, c0).
sum_head(c4, r4). in_range(r4, c3). in_range(r4, c0).
sum_head(c5, r5). in_range(r5, c4). in_range(r5, c0).

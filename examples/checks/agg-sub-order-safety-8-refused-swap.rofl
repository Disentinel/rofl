-- expect-refusal: is not monotone in that order
-- a lex head whose first value is computed from the time read: a better tuple has a better cost and a worse time, and would conclude a worse one
edb(aosr_e).
aosr_e(a, b, 2, 9).
lex aosr_swap(A, B, min C, min T).
aosr_swap(A, B, C, T) :- aosr_e(A, B, C, T).
aosr_swap(A, C, C1, T1) :- aosr_swap(A, B, C0, T0), aosr_e(B, C, C2, T2), C1 is T0 + C2, T1 is C0 + T2.

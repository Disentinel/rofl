-- expect-refusal: one algebra
-- examples/checks/agg-cell-safety-13-refused-unify.rofl — a body sum passed on by `=` as the value of a min: still two algebras on one relation.
edb(acsr_e).
edb(acsr_n).
edb(acsr_s).
acsr_e(a, b, 2).
acsr_e(b, a, 3).
acsr_n(a, b).
acsr_s(a, false).
lattice acsr_unify(A, C, min D).
acsr_unify(A, C, D) :- acsr_e(A, C, _), S is sum(W ; B : acsr_e(A, B, W)), D = S.

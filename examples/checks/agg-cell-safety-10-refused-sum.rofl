-- expect-refusal: one algebra
-- examples/checks/agg-cell-safety-10-refused-sum.rofl — a body sum as the value of a min: two algebras on one relation.
edb(acsr_e).
edb(acsr_n).
edb(acsr_s).
acsr_e(a, b, 2).
acsr_e(b, a, 3).
acsr_n(a, b).
acsr_s(a, false).
lattice acsr_sum(A, C, min D).
acsr_sum(A, C, D) :- acsr_e(A, C, _), D is sum(W ; B : acsr_e(A, B, W)).

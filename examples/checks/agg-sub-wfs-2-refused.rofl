-- expect-refusal: subsumption wsr_d is not evaluated under well_founded semantics
-- examples/checks/agg-sub-wfs-2-refused.rofl — a dominance inside a
-- well-founded world is refused: a value would be dropped for one that holds
-- only under an assumption.
semantics(well_founded).
edb(wsr_move).
wsr_move(a, b). wsr_move(b, a). wsr_move(b, c).
wsr_win(X) :- wsr_move(X, Y), not wsr_win(Y).
wsr_d(X, 1) :- wsr_win(X).
wsr_d(X, D1) <= wsr_d(X, D2) :- D2 < D1.

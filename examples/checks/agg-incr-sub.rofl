-- examples/checks/agg-incr-sub.rofl — agg_incr_sub: a SUBSUMPTIVE relation under
-- RETRACTION (docs/aggregates.md, "Ready for the incremental engine"). A
-- Pareto front keeps the values no other dominates, and a value dominated is
-- not held: it is only remembered as given, with the firing that gave it, so
-- what a retraction brings back (the values the fact's route dominated) is
-- decided against every value the key was given. The relation records
-- `alg=idempotent use=rederive`, its firings are named by id, and a retraction
-- takes the whole key out (the front, and every key a value given from the
-- fact was given to) and fires the rules into it again, to the state of a
-- world without the fact.
--
--   is_e(a, c, 3, 3)   the route that stood between two others is gone
--   is_e(b, c, 1, 5)   and the way round through b: a to c is left with two routes
edb(is_e).
is_e(a, b, 1, 5).
is_e(b, c, 1, 5).
is_e(a, c, 5, 1).
is_e(c, a, 1, 1).
is_e(a, c, 3, 3).
is_route(A, B, C, T) :- is_e(A, B, C, T).
is_route(A, C, C1, T1) :- is_route(A, B, C0, T0), is_e(B, C, C2, T2), C1 is C0 + C2, T1 is T0 + T2.
is_route(A, B, C1, T1) <= is_route(A, B, C2, T2) :- C2 <= C1, T2 <= T1, C2 < C1.
is_route(A, B, C1, T1) <= is_route(A, B, C2, T2) :- C2 <= C1, T2 <= T1, T2 < T1.

-- the state after the retractions, row by row
-- expect-row: is_e[main](a,b,1,5) tick base support=0
-- expect-row: is_e[main](a,c,5,1) tick base support=0
-- expect-row: is_e[main](c,a,1,1) tick base support=0
-- expect-row: is_route[main](a,a,6,2) tick drv support=1
-- expect-row: is_route[main](a,b,1,5) tick drv support=1
-- expect-row: is_route[main](a,c,5,1) tick drv support=1
-- expect-row: is_route[main](c,a,1,1) tick drv support=1
-- expect-row: is_route[main](c,b,2,6) tick drv support=1
-- expect-row: is_route[main](c,c,6,2) tick drv support=1

-- expect-refusal: is not monotone in that order
-- a read matching a constant in a value place: the front holds the values it was given, and a constant picks one
edb(aosr_e).
aosr_e(a, b, 2, 9).
pareto aosr_const(A, B, min C, min T).
aosr_const(A, B, C, T) :- aosr_e(A, B, C, T).
aosr_const(A, C, C1, T1) :- aosr_const(A, B, 2, T0), aosr_e(B, C, C2, T2), C1 is 2 + C2, T1 is T0 + T2.

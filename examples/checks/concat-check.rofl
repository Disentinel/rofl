ct_want_text("looped","x").
ct_want_text("looped",cat("x","x")).
ct_want_text("looped",cat(cat("x","x"),"x")).
ct_want_text("looped",cat(cat(cat("x","x"),"x"),"x")).
ct_want_text("method",cat(cat("a","/srv"),"h")).
ct_want_text("mixed",cat(7,"x")).
ct_want_text("nested",dirname(join("/srv","g"))).
ct_want_text("normal",join("/a/../b")).
ct_want_text("plus",cat("/srv","/b")).
ct_want_text("resolved",resolve("/srv","f")).
ct_want_text("template",cat("/srv","/a")).

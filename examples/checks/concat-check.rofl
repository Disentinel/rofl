ct_want_text("atCap",cat(cat(cat("y","x"),"x"),"y")).
ct_want_text("atCap",cat(cat(cat("y","x"),"y"),"x")).
ct_want_text("atCap",cat(cat(cat("y","x"),"y"),"y")).
ct_want_text("atCap",cat(cat(cat("y","y"),"x"),"x")).
ct_want_text("atCap",cat(cat(cat("y","y"),"x"),"y")).
ct_want_text("atCap",cat(cat(cat("y","y"),"y"),"x")).
ct_want_text("atCap",cat(cat(cat("y","y"),"y"),"y")).

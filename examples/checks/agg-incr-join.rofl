-- examples/checks/agg-incr-join.rofl — agg_incr_join: the JOIN LATTICES under
-- RETRACTION (docs/aggregates.md, "Ready for the incremental engine"). A join
-- cell keeps the contributions that were read from a value it has since grown
-- past, as the history its Cover is founded on; which values were read is a
-- matter of the schedule, so no delta promises the history a fresh evaluation
-- holds. The relation records `alg=idempotent,lattice use=rederive` and its
-- contributions (`L@join`) are named by firing; the retraction is evaluated
-- again and must be the state of a world without the fact.
--
--   ij_link(c, a)   the interval no longer comes round the cycle to a
--   ij_e(b, c)      c leaves the component of a and b: a plain rule reads the edge
edb(ij_e). edb(ij_node). edb(ij_val). edb(ij_link).
ij_e(a, b).
ij_e(b, c).
ij_node(a).
ij_node(b).
ij_node(c).
ij_node(d).
ij_val(a, 3).
ij_val(b, 7).
ij_link(a, b).
ij_link(b, c).
ij_link(c, a).
ij_u(X, Y) :- ij_e(X, Y).
ij_u(Y, X) :- ij_e(X, Y).
lattice ij_comp(X, union S).
ij_comp(X, set(X)) :- ij_node(X).
ij_comp(X, S) :- ij_u(X, Y), ij_comp(Y, S).
lattice ij_hull(X, hull I).
ij_hull(X, iv(V, V)) :- ij_val(X, V).
ij_hull(Y, I) :- ij_link(X, Y), ij_hull(X, I).

-- the state after the retractions, row by row
-- expect-row: ij_comp@join[main](a,set(a)) tick drv support=1

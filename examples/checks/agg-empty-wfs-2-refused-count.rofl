-- expect-refusal: count is not evaluated under well_founded semantics
-- examples/checks/agg-empty-wfs-2-refused-count.rofl — count inside a well-founded
-- world is refused: its cell would be sealed under an assumption, over
-- positions whose win is unknown.
semantics(well_founded).
edb(wr_move).
wr_move(a, b). wr_move(b, a). wr_move(b, c).
wr_win(X) :- wr_move(X, Y), not wr_win(Y).
edb(wr_player).
wr_player(p1). wr_player(p2).
wr_owns(p1, c).
wr_n(P, N) :- wr_player(P), N is count(X : wr_owns(P, X), wr_win(X)).

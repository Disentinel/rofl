-- examples/checks/agg-lattice-history-why-check.rofl — agg_lattice_why over
-- agg-lattice-history-data.rofl: `why` of a value reached only through the
-- cell's own earlier values shows the earlier value it was reached from, and
-- says it is one; `whynot` of a cell a fault holed names the hole, early or
-- late alike.
explain_request(why, alx_sat(a, 3)).
explain_request(whynot, alx_h(pa, c, 7)).
explain_request(whynot, alx_h(pb, c, 7)).
alyx_holds(K, A, T) :- explained[$explain](K, A, _, L), alyx_want(K, A, T), N is str_segs(L, T), N > 1.
alyx_want(why, alx_sat(a, 3), "alx_sat[main](a,3) [lattice max: 1 member]").
alyx_want(why, alx_sat(a, 3), "alx_sat[main](b,2) [lattice max: 1 member; an earlier value, improved on since]").
alyx_want(why, alx_sat(a, 3), "alx_sat[main](a,1) [lattice max: 1 member; an earlier value, improved on since]").
alyx_want(why, alx_sat(a, 3), "alx_e5[main](a,b,1) [axiom]").
alyx_want(whynot, alx_h(pa, c, 7), "alx_h[main](pa,c) has no value: hole(arith_type_error) [lattice min]").
alyx_want(whynot, alx_h(pb, c, 7), "alx_h[main](pb,c) has no value: hole(arith_type_error) [lattice min]").
alyx_text_missing(K, A, T) :- alyx_want(K, A, T), not alyx_holds(K, A, T).
alarm(alyx_text_missing).

-- examples/checks/agg-sub-order-demo-check.rofl — agg_sub_order_demo, THE
-- PARETO FRONT OF ITINERARIES, DECLARED (docs/aggregates.md, "Declared
-- orders, as built"). A trip between two airports is dominated by one no
-- dearer and no longer and better in one: `pareto aod_trip(A, B, min P, min H).`
-- stands for the two dominance rules agg_sub_demo writes out, and the
-- recursion over the flights, which include a positive cycle (nyc and bos),
-- keeps at each pair only the trips nothing it found dominates. Beside it
-- the same trips ordered lexicographically, the dearest-last and the
-- quickest-last, each one value a pair. Three oracles hold them: the fronts
-- from London, enumerated here by hand; every front, computed a second way
-- with no declaration at all (every itinerary of at most four flights
-- enumerated by plain rules, and its front taken by stratified negation over
-- them); and the lexicographic bests, taken by min aggregates over the same
-- itineraries.
edb(aod_flight).
aod_flight(lon, nyc, 1200, 6). aod_flight(lon, nyc, 900, 8).
aod_flight(lon, dub, 100, 1). aod_flight(dub, nyc, 600, 7).
aod_flight(lon, rey, 250, 3). aod_flight(rey, nyc, 300, 6).
aod_flight(lon, par, 80, 1).  aod_flight(par, nyc, 700, 8).
aod_flight(par, dub, 90, 2).  aod_flight(rey, dub, 50, 2).
aod_flight(nyc, bos, 100, 1). aod_flight(bos, nyc, 100, 1).
pareto aod_trip(A, B, min P, min H).
aod_trip(A, B, P, H)   :- aod_flight(A, B, P, H).
aod_trip(A, C, P, H)   :- aod_trip(A, B, P0, H0), aod_flight(B, C, P1, H1), P is P0 + P1, H is H0 + H1.
-- BY HAND: London to New York is 1200 for 6 hours direct, 700 for 8 through
-- Dublin, 550 for 9 through Reykjavik; the 900 direct flight (dearer than
-- Dublin's, no faster), Paris (780, 9), Paris and Dublin (770, 10), and
-- Reykjavik and Dublin (900, 12) are dominated. To Boston, the same three
-- and the hop from New York.
aodh_want(lon, nyc, 1200, 6). aodh_want(lon, nyc, 700, 8). aodh_want(lon, nyc, 550, 9).
aodh_want(lon, bos, 1300, 7). aodh_want(lon, bos, 800, 9). aodh_want(lon, bos, 650, 10).
aodh_want(lon, dub, 100, 1). aodh_want(lon, rey, 250, 3). aodh_want(lon, par, 80, 1).
aodh_have(A, B, P, H) :- aod_trip(A, B, P, H), A = lon.
aodh_missing(A, B, P, H) :- aodh_want(A, B, P, H), not aodh_have(A, B, P, H).
aodh_extra(A, B, P, H)   :- aodh_have(A, B, P, H), not aodh_want(A, B, P, H).
alarm(aodh_missing).
-- and no trip is a shrug, which an alarm `not answer` would pass in silence
aod_shrug(T, R) :- shrug[$kernel](T, R, _).
alarm(aod_shrug).
alarm(aodh_extra).
-- THE BRUTE FORCE: every itinerary of one to four flights, and its front
edb(aodb_hops).
aodb_hops(1). aodb_hops(2). aodb_hops(3). aodb_hops(4).
aodb_path(A, B, P, H, 1) :- aod_flight(A, B, P, H).
aodb_path(A, C, P, H, N) :- aodb_path(A, B, P0, H0, M), aod_flight(B, C, P1, H1), N is M + 1, aodb_hops(N),
                            P is P0 + P1, H is H0 + H1.
aodb_beaten(A, B, P, H) :- aodb_path(A, B, P, H, _), aodb_path(A, B, P2, H2, _), P2 <= P, H2 <= H, P2 < P.
aodb_beaten(A, B, P, H) :- aodb_path(A, B, P, H, _), aodb_path(A, B, P2, H2, _), P2 <= P, H2 <= H, H2 < H.
aodb_front(A, B, P, H)  :- aodb_path(A, B, P, H, _), not aodb_beaten(A, B, P, H).
aodb_missing(A, B, P, H) :- aodb_front(A, B, P, H), not aod_trip(A, B, P, H).
aodb_extra(A, B, P, H)   :- aod_trip(A, B, P, H), not aodb_front(A, B, P, H).
alarm(aodb_missing).
alarm(aodb_extra).
-- and the oracle is no empty agreement: it has fronts of three
aodb_three(A, B) :- aodb_front(A, B, P1, _), aodb_front(A, B, P2, _), aodb_front(A, B, P3, _), P1 < P2, P2 < P3.
aodb_thin() :- not aodb_three(lon, nyc).
alarm(aodb_thin).

-- LEXICOGRAPHIC: the dearest-last trip is the cheapest, and of the cheapest
-- the quickest; the quickest-last the other way round
lex aod_lp(A, B, min P, min H).
aod_lp(A, B, P, H)   :- aod_flight(A, B, P, H).
aod_lp(A, C, P, H)   :- aod_lp(A, B, P0, H0), aod_flight(B, C, P1, H1), P is P0 + P1, H is H0 + H1.
lex aod_lh(A, B, min H, min P).
aod_lh(A, B, H, P)   :- aod_flight(A, B, P, H).
aod_lh(A, C, H, P)   :- aod_lh(A, B, H0, P0), aod_flight(B, C, P1, H1), P is P0 + P1, H is H0 + H1.
aodb_minp(A, B, P) :- aodb_path(A, B, _, _, _), P is min(P0 : aodb_path(A, B, P0, _, _)).
aodb_lp(A, B, P, H) :- aodb_minp(A, B, P), H is min(H0 : aodb_path(A, B, P, H0, _)).
aodb_minh(A, B, H) :- aodb_path(A, B, _, _, _), H is min(H0 : aodb_path(A, B, _, H0, _)).
aodb_lh(A, B, H, P) :- aodb_minh(A, B, H), P is min(P0 : aodb_path(A, B, P0, H, _)).
aodb_lp_missing(A, B, P, H) :- aodb_lp(A, B, P, H), not aod_lp(A, B, P, H).
aodb_lp_extra(A, B, P, H)   :- aod_lp(A, B, P, H), not aodb_lp(A, B, P, H).
aodb_lh_missing(A, B, H, P) :- aodb_lh(A, B, H, P), not aod_lh(A, B, H, P).
aodb_lh_extra(A, B, H, P)   :- aod_lh(A, B, H, P), not aodb_lh(A, B, H, P).
alarm(aodb_lp_missing).
alarm(aodb_lp_extra).
alarm(aodb_lh_missing).
alarm(aodb_lh_extra).
-- BY HAND, from London: to New York the cheapest is 550 for 9 hours, the
-- quickest 6 hours for 1200; to Boston 650 for 10, and 7 hours for 1300
aodh_lp(lon, nyc, 550, 9). aodh_lp(lon, bos, 650, 10).
aodh_lh(lon, nyc, 6, 1200). aodh_lh(lon, bos, 7, 1300).
aodh_lp_lost(B, P, H) :- aodh_lp(lon, B, P, H), not aod_lp(lon, B, P, H).
aodh_lh_lost(B, H, P) :- aodh_lh(lon, B, H, P), not aod_lh(lon, B, H, P).
alarm(aodh_lp_lost).
alarm(aodh_lh_lost).

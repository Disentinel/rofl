-- examples/checks/agg-narrow-why-check.rofl — agg_narrow_why, run with
-- `rofl load --explain`. The witness of a narrowed cell is the widening's
-- record and then each narrowing step, the value before, the value it came
-- down to, and the join of what the rules contribute from it that it came
-- down by; the enclosure it closed on is the narrowed one. `why` of the cell,
-- of anything resting on it and `whynot` of the least value all show it. A
-- cell narrowing left alone (an_chain's y4, past the four passes) has the
-- widening's record and no narrowing line of its own; one with nothing to
-- come down to (an_noop) has none either.
edb(explain_request).
edb(explained).
explain_request(why, an_loop(head, iv(0, 7))).
explain_request(why, an_thr(head, iv(0, 3))).
explain_request(why, an_two(y, iv(0, 6))).
explain_request(whynot, an_loop(head, iv(0, 7))).
explain_request(whynot, an_chain(y3, iv(0, 8))).
explain_request(whynot, an_chain(y4, iv(0, 9))).
explain_request(whynot, an_noop(head, iv(0, 5))).
anw_holds(K, A, T) :- explained[$explain](K, A, _, L), anw_want(K, A, T), N is str_segs(L, T), N > 1.
anw_want(why, an_loop(head, iv(0, 7)), "root $lattice(an_loop, main, 0, [head]) is a shrug: widened, a declared widening enclosed the value: the least value lies within it, and is not known; within(iv(0, 7))").
anw_want(why, an_loop(head, iv(0, 7)), "[widened: after 2 improvements each end the join moved went to the next bound its rules write, or to its infinity; the least value lies within iv(0, 7), which is an over-approximation of it]").
anw_want(why, an_loop(head, iv(0, 7)), "iv(0, 2) joined with iv(1, 3) is iv(0, 3), widened to iv(0, inf)").
anw_want(why, an_loop(head, iv(0, 7)), "narrowed iv(0, inf) to iv(0, 7) by iv(0, 7), the join of what its rules contribute from it").
anw_want(why, an_thr(head, iv(0, 3)), "iv(0, 2) joined with iv(1, 3) is iv(0, 3), widened to iv(0, 10)").
anw_want(why, an_thr(head, iv(0, 3)), "narrowed iv(0, 10) to iv(0, 3) by iv(0, 3), the join of what its rules contribute from it").
anw_want(why, an_two(y, iv(0, 6)), "narrowed iv(0, inf) to iv(0, 5) by iv(0, 5), the join of what its rules contribute from it").
anw_want(why, an_two(y, iv(0, 6)), "narrowed iv(0, inf) to iv(0, 6) by iv(0, 6), the join of what its rules contribute from it").
anw_want(whynot, an_loop(head, iv(0, 7)), "an_loop[main](head) has no value: hole(widening_forced) [lattice hull]").
anw_want(whynot, an_loop(head, iv(0, 7)), "narrowed iv(0, inf) to iv(0, 7) by iv(0, 7), the join of what its rules contribute from it").
anw_want(whynot, an_chain(y3, iv(0, 8)), "the least value lies within iv(0, 8), which is an over-approximation of it").
anw_want(whynot, an_chain(y3, iv(0, 8)), "narrowed iv(0, inf) to iv(0, 8) by iv(0, 8), the join of what its rules contribute from it").
anw_want(whynot, an_chain(y4, iv(0, 9)), "the least value lies within iv(0, inf), which is an over-approximation of it").
anw_want(whynot, an_noop(head, iv(0, 5)), "the least value lies within iv(0, inf), which is an over-approximation of it").
anw_missing(K, A, T) :- anw_want(K, A, T), not anw_holds(K, A, T).
-- a cell narrowed once takes one line, and one narrowing never leaves two for the same cell
anw_line(A, I)     :- explained[$explain](whynot, A, I, L), N is str_segs(L, "narrowed iv("), N > 1.
anw_lines(A, N)    :- anw_counted(A), N is count(I : anw_line(A, I)).
edb(anw_counted).
anw_counted(an_loop(head, iv(0, 7))).
anw_counted(an_chain(y3, iv(0, 8))).
anw_counted(an_chain(y4, iv(0, 9))).
anw_counted(an_noop(head, iv(0, 5))).
edb(anw_nlines).
anw_nlines(an_loop(head, iv(0, 7)), 1).
anw_nlines(an_chain(y3, iv(0, 8)), 1).
anw_nlines(an_chain(y4, iv(0, 9)), 0).
anw_nlines(an_noop(head, iv(0, 5)), 0).
anw_wrong_lines(A, N) :- anw_lines(A, N), not anw_nlines(A, N).
anw_refused(K, A)  :- explained[$explain](K, A, 0, _).
alarm(anw_missing).
alarm(anw_wrong_lines).
alarm(anw_refused).

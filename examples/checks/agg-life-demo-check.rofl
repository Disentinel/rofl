edb(lf_nsel).
lf_nsel(0). lf_nsel(1). lf_nsel(2). lf_nsel(3). lf_nsel(4). lf_nsel(5). lf_nsel(6). lf_nsel(7). lf_nsel(8).
lf_live(T, X, Y)@next :- lf_live(T, X, Y).
lf_pop(T, N)@next :- lf_pop(T, N).
lf_hist(T, N, K)@next :- lf_hist(T, N, K).
lf_cellcount(T, X, Y, N)@next :- lf_cellcount(T, X, Y, N).
lf_cone(X, Y, T)@next :- lf_cone(X, Y, T).
lf_nsel(N)@next :- lf_nsel(N).
explain_request(K, A)@next :- explain_request(K, A).

lf_wrong(live_missing, T, X) :- clock(T), lf_live(T, X, Y), not live(X, Y).
lf_wrong(live_extra, T, X)   :- clock(T), live(X, Y), not lf_live(T, X, Y).
lf_wrong(population, T, N)   :- clock(T), lf_pop(T, N), not population(T, N).
lf_wrong(population, T, N)   :- population(T, N), not lf_pop(T, N).
lf_count(T, N, K) :- clock(T), lf_nsel(N), K is count(X, Y : neighbours(X, Y, N)).
lf_wrong(histogram, T, N)    :- lf_hist(T, N, K), lf_count(T, N, J), K != J.
lf_wrong(histogram, T, N)    :- clock(T), lf_hist(T, N, K), not lf_count(T, N, K).
lf_wrong(cell_count, T, X)   :- clock(T), lf_cellcount(T, X, Y, N), not neighbours(X, Y, N).
lf_wrong(cell_count, T, X)   :- clock(T), lf_cellcount(T, X, Y, N), neighbours(X, Y, M), N != M.
lf_wrong(cone_missing, X, Y) :- clock(8), lf_cone(X, Y, T), not cone(X, Y, T).
lf_wrong(cone_extra, X, Y)   :- clock(8), cone(X, Y, T), not lf_cone(X, Y, T).
-- the world ran as far as it is checked
lf_short(ticks) :- not lf_ran().
lf_ran() :- clock(8).
lf_wrong(K, A, B)@next :- lf_wrong(K, A, B).
alarm(R)@next :- alarm(R).
alarm(lf_short).
alarm(lf_proof).
alarm(lf_wrong).

-- the neighbour counts are live: a cell with no live neighbour is a row at 0,
-- and the population never moves, so both of these hold at every tick
lf_zero(T) :- clock(T), neighbours(0, 9, 0).
lf_wrong(zero_missing, T, 0) :- clock(T), not lf_zero(T).

-- THE PROOF ROWS. `why` of the glider's head at the last tick: counted, born,
-- from the tick before, which `why` names as a past tick
explain_request(why, live(4, 4)).
explain_request(why_all, cone(1, 0, 0)).
lf_head(L) :- explained[$explain](why, live(4, 4), _, L).
lf_born(T) :- lf_head(L), lf_born_text(T, S), N is str_segs(L, S), N > 1.
lf_born_text(counted, "neighbours[main](4,4,3)"). lf_born_text(from, "@tick 7 [past tick]").
lf_born_text(cell, "cell[main](4,4)").
lf_born_want(counted). lf_born_want(from). lf_born_want(cell).
lf_proof(why_born) :- lf_born_want(T), not lf_born(T).
lf_cone_line(L) :- explained[$explain](why_all, cone(1, 0, 0), _, L).
lf_chain(T) :- lf_cone_line(L), lf_chain_text(T, S), N is str_segs(L, S), N > 1.
lf_chain_text(head, "cone[main](4,4,8)"). lf_chain_text(first, "cone[main](0,1,1)").
lf_chain_text(target, "target[main](4,4,8)"). lf_chain_text(history, "seen[main](7,3,4)").
lf_chain_want(head). lf_chain_want(first). lf_chain_want(target). lf_chain_want(history).
lf_proof(why_chain) :- lf_chain_want(T), not lf_chain(T).
-- and no cell of the blinker is among its causes
lf_stranger(S) :- lf_cone_line(L), lf_stranger_text(S), N is str_segs(L, S), N > 1.
lf_stranger_text("cone[main](7,"). lf_stranger_text("cone[main](6,"). lf_stranger_text("cone[main](8,").
lf_proof(why_stranger) :- lf_stranger(_).
lf_proof(why_empty) :- not lf_head(_).
lf_proof(shrug) :- shrug[$kernel](_, _, _).

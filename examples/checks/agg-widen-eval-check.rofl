-- expect-no-row: aw_at[main](body,
-- expect-no-row: aw_at[main](exit,
-- expect-no-row: aw_up[main](head,
-- expect-no-row: aw_walk[main](head,
-- expect-no-row: aw_dbl[main](head,
-- expect-no-row: aw_tight[main](head,
-- expect-no-row: aw_fn[main](empty,
-- expect-row: awe_flat[main](head,iv(0,2))
-- expect-row: awe_mix[main](head,iv(-3,1))
-- expect-no-row: hole[$kernel]($lattice(awe_flat,
-- expect-no-row: hole[$kernel]($lattice(awe_mix,

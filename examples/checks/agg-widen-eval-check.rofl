-- expect-row: shrug[$kernel]($lattice(aw_walk,main,0,$cons(head,$nil)),widened,within(iv(ninf,inf)))
-- expect-row: shrug[$kernel]($lattice(aw_dbl,main,0,$cons(head,$nil)),widened,within(iv(1,198)))
-- expect-row: shrug[$kernel]($lattice(aw_tight,main,0,$cons(head,$nil)),widened,within(iv(0,3)))
-- expect-row: aw_fn[main](sub,iv(-19,-8))

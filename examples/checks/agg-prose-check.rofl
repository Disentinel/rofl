-- examples/checks/agg-prose-check.rofl — agg_prose: the proof of w_agg_retire_workarounds and of
-- w_agg_reconcile_docs (facts/agg.rofl). Over agg-prose-census.rofl
-- (generated by scripts/agg_prose.ts; `npm test` fails when it is stale): a
-- block of an owned document that still says ROFL has no aggregation, and does
-- not point at docs/aggregates.md in the same block (or in an `> **Amended`
-- note straight after it), is `prose_stale`. The world is red while any
-- contradiction_site the item owns reads as if the kernel had no aggregation,
-- and an empty census is red too, so a scan that found no documents proves
-- nothing.
has_site(P)   :- prose_site(P).
anything()    :- has_site(_).
reconciled(P, K) :- prose_pointer(P, K).

prose_stale(P, K)    :- prose_claim(P, K), not reconciled(P, K).
prose_vacuous(none)  :- not anything().

alarm(prose_stale).
alarm(prose_vacuous).

-- w_agg_retire_workarounds: per kind of aggregate, the number of sites whose
-- file still holds the text that stood in for one (a `workaround_marker` of
-- facts/agg.rofl matches it) and that the ledger does not keep
-- (`workaround_kept`) must be 0: `retire_stands`. The count is of a group bound
-- from outside, so a kind with none reads 0 and is never absent
-- (`retire_unsaid`). A site no marker describes proves nothing:
-- `retire_unmarked`.
retire_kind(K)          :- retire_site(K, _).
retire_standing(K, N)   :- retire_kind(K), N is count(P : retire_marker(K, P), not retire_kept(K, P)).
retire_stands(K, N)     :- retire_standing(K, N), N > 0.
retire_unsaid(K)        :- retire_kind(K), not retire_standing(K, _).
retire_unmarked(P)      :- retire_site(_, P), not retire_pattern(P).
retire_vacuous(none)    :- not any_retire_site().
any_retire_site()       :- retire_site(_, _).

alarm(retire_stands).
alarm(retire_unsaid).
alarm(retire_unmarked).
alarm(retire_vacuous).

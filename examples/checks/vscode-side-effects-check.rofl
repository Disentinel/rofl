vse_want(ndbdc6130c943fdee_vknpcu964rdk4, fs_mutation, "/opt/app").
vse_want(ndbdc6130c943fdee_vknpcu964rdk4, fs_mutation, ndbdc6130c943fdee_00ujo250s3vsd).

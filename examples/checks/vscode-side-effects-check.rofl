vse_want(n6ce3b3e159e9764b_nuu0h9bo98, fs_mutation, "/tmp/cache").
vse_want(n34efd0fd49e79fa1_r7jcjg1pls5, listen, 8080).
vse_want(n34efd0fd49e79fa1_r7jcjg1pls5, listen, n34efd0fd49e79fa1_3ji3d81e6n).
vse_want(n34efd0fd49e79fa1_qk5id7fv0b1, listen, 8080).
vse_want(n34efd0fd49e79fa1_j8599nf69r7, listen, n34efd0fd49e79fa1_3ji3d81e6n).
vse_want(n6ce3b3e159e9764b_7i05qirimu2, process, "code").
vse_want(n6ce3b3e159e9764b_m0tkjs22tt1, process, "git").
vse_want(n6ce3b3e159e9764b_aig8h69pkt2, ipc, "vscode:hello").
vse_want(n6ce3b3e159e9764b_jpjp892vgr1, request, "https://update.code.visualstudio.com/api/update").
vse_want(ndbdc6130c943fdee_dlqog2mm806, fs_mutation, ndbdc6130c943fdee_ukl8remh2t6).

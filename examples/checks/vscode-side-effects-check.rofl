vse_want(ndbdc6130c943fdee_18bs8n5b6m, fs_mutation, "/opt/app").
vse_want(ndbdc6130c943fdee_18bs8n5b6m, fs_mutation, ndbdc6130c943fdee_dp3492it4h7).
vse_want(ndbdc6130c943fdee_o13jg7f3n72, request, ndbdc6130c943fdee_6f9hm7qemu3).
vse_want(ndbdc6130c943fdee_o13jg7f3n72, request, url("https://update.code.visualstudio.com", "/api/update")).

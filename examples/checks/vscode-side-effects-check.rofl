vse_want(n6ce3b3e159e9764b_mbhpkrske2b34, process, "git").
vse_want(n6ce3b3e159e9764b_2hjc65i58obmd, ipc, "vscode:hello").
vse_want(n6ce3b3e159e9764b_9kn3nahf2h2be, request, "https://update.code.visualstudio.com/api/update").

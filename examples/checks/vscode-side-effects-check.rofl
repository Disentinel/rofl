vse_want_forms(ndbdc6130c943fdee_q3vqqs7f4m6, 5).
vse_want_site(S, F) :- vse_want(S, F, _).
vse_want_count(fs_mutation, 10, 9).
vse_want_count(listen, 3, 3).
vse_want_count(process, 2, 2).
vse_want_count(ipc, 1, 1).
vse_want_count(request, 2, 2).

vse_missing(S, F, V)  :- vse_want(S, F, V), not side_effect_value(S, F, V).
vse_extra(S, F, V)    :- side_effect_value(S, F, V), not vse_want(S, F, V).
vse_missing_site(S, F) :- vse_want_site(S, F), not side_effect_site(S, F).
vse_extra_site(S, F)  :- side_effect_site(S, F), not vse_want_site(S, F).
vse_count_wrong(F)    :- side_effect_count(F, N, V), not vse_want_count(F, N, V).
vse_count_missing(F)  :- vse_want_count(F, N, V), not side_effect_count(F, N, V).
vse_env_missing()     :- not side_effect_env(n34efd0fd49e79fa1_3cddg0nebb5, "VSCODE_PORT").
vse_form_missing(S, F, T) :- vse_want_form(S, F, T), not side_effect_form(S, F, T).
vse_form_site(S)      :- side_effect_form(S, _, _).
vse_forms_wrong(S)    :- vse_form_site(S), N is count(T : side_effect_form(S, _, T)), not vse_want_forms(S, N).
vse_forms_missing(S)  :- vse_want_forms(S, _), not vse_form_site(S).
alarm(vse_missing).
alarm(vse_extra).
alarm(vse_missing_site).
alarm(vse_extra_site).
alarm(vse_count_wrong).
alarm(vse_count_missing).
alarm(vse_env_missing).
alarm(vse_form_missing).
alarm(vse_forms_wrong).
alarm(vse_forms_missing).

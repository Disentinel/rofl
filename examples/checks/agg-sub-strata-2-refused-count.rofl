-- expect-refusal: reads a closed relation
-- a count reads a closed relation, and a subsumptive one closes only after
-- its recursion: a count of its own cells inside that recursion is refused
edb(assr_e).
assr_e(a, 1). assr_e(b, 2).
assr_n(X, V) :- assr_e(X, V).
assr_n(X, N) :- assr_e(X, _), N is count(Y : assr_n(Y, _)).
assr_n(X, V1) <= assr_n(X, V2) :- V2 < V1.

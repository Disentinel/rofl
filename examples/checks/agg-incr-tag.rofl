-- examples/checks/agg-incr-tag.rofl — agg_incr_tag: the IDEMPOTENT SEMIRING TAGS
-- under RETRACTION (docs/aggregates.md, "Ready for the incremental engine"). A
-- tropical, a viterbi and a trust tag are the order lattices of their ⊕ (min,
-- max, max): the cell is the fact, a contribution is a firing, and the relation
-- records its algebra on its `lat` line, `tag:tropical alg=idempotent,lattice,tag
-- use=rederive`. A retraction takes the cone of the fact out and fires the rules
-- into it again, so the state must be the one of a world without the facts.
--
--   it_e(b, c, 4)       the cheapest way to c is the direct edge, 9; d moves with it
--   it_p(a, b, 500000)  the only way from a to b is gone, and so is what went through it
--   it_p(c, a, 900000)  and the way round the cycle
edb(it_e). edb(it_p).
it_e(a, b, 3).
it_e(b, c, 4).
it_e(a, c, 9).
it_e(c, a, 1).
it_e(c, d, 2).
it_e(e, f, 2).
it_p(a, b, 500000).
it_p(b, c, 800000).
it_p(a, c, 300000).
it_p(c, a, 900000).
tag it_cost(A, B, tropical T).
it_cost(A, B, W) :- it_e(A, B, W).
it_cost(A, C, W) :- it_cost(A, B, _), it_e(B, C, W).
tag it_pr(A, B, viterbi P).
it_pr(A, B, W) :- it_p(A, B, W).
it_pr(A, C, W) :- it_pr(A, B, _), it_p(B, C, W).
tag it_tr(A, B, trust T).
it_tr(A, B, W) :- it_p(A, B, W).
it_tr(A, C, W) :- it_tr(A, B, _), it_p(B, C, W).

-- the state after the retractions, row by row
-- expect-row: it_cost[main](a,a,10) tick drv support=1
-- expect-row: it_cost[main](a,b,3) tick drv support=1

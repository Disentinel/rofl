-- examples/parity/rs.rofl — what the Rust model answers for a name of a scene: the literals its `let` may hold, the
-- texts of the strings its binding may hold, and
-- the literals that may reach the effect on a line of the scene's main.rs (examples/parity/check.rofl).
edb(scene_file).
answer(Name, V) :- assign[value](_, P, Init), binds[value](P, Name), named(Name), may_be_lit[flow](Init, V).
answer(Name, T) :- assign[value](_, P, _), binds[value](P, Name), named(Name), may_be_node[flow](P, C),
                   may_be_text[flow](C, T).
-- a probe `probe("name")` of a scene that may be skipped (models/lang/rust/guards.rofl); one that runs has no answer
probe_at(S, Name) :- callee[value](S, N), ref[value](N, "probe"), nth[tree](S, 0, A), literal[value](A, Name), named(Name).
skips(S) :- probe_at(S, _), guarded[code](S).
skips(S) :- probe_at(S, _), in_fn[rust](F, S), may_not_be_reached[code](F).
answer(Name, may_skip) :- probe_at(S, Name), skips(S).
-- a service scene: the routes served, the port, the requests sent (models/lang/rust/web.rofl)
answer("serves", route(M, P, Name)) :- named("serves"), serves[surface](_, M, P, H, route), target[value](H, N), binds[value](N, Name).
answer("listens", Port) :- named("listens"), app_listens[surface](_, Port).
answer("requests", req(M, U)) :- named("requests"), requests[flow](_, M, U).
se_answer(L, V) :- side_effect_value[flow](S, _, V), scene_file(F), at[tree](S, F, L).

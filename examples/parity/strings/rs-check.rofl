general("pushed", cat(cat(cat("a", "b"), "b"), "b"), written_after).
general("pushed", cat(cat(cat(cat("a", "b"), "b"), "b"), "b"), written_after).
general("looped", "", loop_count).
general("looped", "x", loop_count).
general("looped", cat(cat("x", "x"), "x"), loop_count).

-- nope.rofl -- NOPE: whynot for access control, and the metrics no IAM
-- tool reports. One policy model (AWS-shaped), one hierarchy, Deny
-- precedence, assume-role chains with a real cycle.
--
-- Layout of this file:
--   1. the organization      (OUs, accounts)
--   2. the identities        (users, roles, groups, tags)
--   3. the assume-role graph (contains a cycle: deployer <-> ci_runner)
--   4. the policies          (SCP / permission boundary / identity / resource)
--   5. wildcard expansion    (action_in / resource_in, as data)
--   6. the evaluation rules  (allow, then deny, then Deny-overrides)
--   7. the naive counterpart (routes-in-a-graph, for the counting contrast)
--
-- Everything above the "negation below this line" marker is monotone.

-- =========================================================================
-- 1. the organization
-- =========================================================================

ou(root).
ou(prod_ou).
ou(dev_ou).
ou_parent(prod_ou, root).
ou_parent(dev_ou, root).
account(a_prod, prod_ou).
account(a_dev, dev_ou).

ou_ancestor(O, O)   :- ou(O).
ou_ancestor(O, A)   :- ou_parent(O, P), ou_ancestor(P, A).
governs(Acct, Ou)   :- account(Acct, O), ou_ancestor(O, Ou).

-- =========================================================================
-- 2. the identities
-- =========================================================================

user(alice, a_prod).
user(bob, a_prod).
role(data_reader, a_prod).
role(deployer, a_prod).
role(ci_runner, a_prod).
role(admin_legacy, a_prod).
group(developers).
member_of(bob, developers).

identity(X)         :- user(X, _).
identity(X)         :- role(X, _).
in_account(X, A)    :- user(X, A).
in_account(X, A)    :- role(X, A).

-- Principal tags. A role session inherits the tags of the principal that
-- started it (sts:TagSession), so conditions are evaluated against the
-- ORIGIN principal of the chain, not against the role being acted as.
tag(alice,        "aws:PrincipalTag/env", "staging").
tag(bob,          "aws:PrincipalTag/env", "prod").
tag(data_reader,  "aws:PrincipalTag/env", "prod").
tag(deployer,     "aws:PrincipalTag/env", "prod").
tag(ci_runner,    "aws:PrincipalTag/env", "prod").
tag(admin_legacy, "aws:PrincipalTag/env", "prod").

-- =========================================================================
-- 3. the assume-role graph -- and the cycle
-- =========================================================================

assumes(alice, data_reader).
assumes(bob, deployer).
assumes(bob, ci_runner).
assumes(deployer, ci_runner).
assumes(ci_runner, deployer).      -- <== the cycle: deployer <-> ci_runner
assumes(ci_runner, admin_legacy).

-- SIMPLE PATHS, and why the path lives inside the fact.
--
-- `via(P, Q, Chain)` -- the origin principal P can be acting as identity Q,
-- having assumed the roles in Chain. Chain is a cons list, current identity
-- first, origin last. Re-entering a role grants nothing new, so a chain may
-- not repeat an identity: A -> B -> A -> C is not an independent way to
-- reach C beyond A -> C.
--
-- Carrying the chain in the fact is what makes the metric well defined. The
-- role graph is cyclic; the support hypergraph of `via` is NOT, because
-- every derivation extends the chain by one fresh identity. A cycle in the
-- roles therefore cannot inflate the count. See `acts_as_naive` in part 7
-- for the same question asked without the chain.
--
-- `absent(X, Chain)` -- X does not occur in Chain. Positive, not negated:
-- the chain domain is generated by `chain_seen` from the chains already
-- derived, so this is ordinary monotone recursion over terms, and the
-- stratification checker never has to be argued with.

chain_seen(C)               :- via(_, _, C).
absent(X, nil)              :- identity(X).
absent(X, cons(Y, C))       :- chain_seen(cons(Y, C)), absent(X, C), X != Y.

via(P, P, cons(P, nil))     :- identity(P).
via(P, Q, cons(Q, C))       :- via(P, X, C), assumes(X, Q), absent(Q, C).

-- =========================================================================
-- 4. the policies
-- =========================================================================
-- statement(Policy, Sid, Effect, ActionPattern, ResourcePattern)
-- condition(Sid, ConditionKey, Op, Value)      Op in {eq, ne}

-- identity policies
statement(p_data_reader, s_read_prod,  allow, "s3:GetObject", "arn:aws:s3:::prod-bucket/*").
attached(data_reader, p_data_reader).

statement(p_deploy,      s_put_prod,   allow, "s3:PutObject", "arn:aws:s3:::prod-bucket/*").
attached(deployer, p_deploy).

statement(p_dev_write,   s_dev_put,    allow, "s3:PutObject", "arn:aws:s3:::prod-bucket/*").
attached(developers, p_dev_write).

statement(p_admin,       s_admin_all,  allow, "*", "*").
attached(admin_legacy, p_admin).

statement(p_ci,          s_ci_put,     allow, "s3:PutObject", "arn:aws:s3:::prod-bucket/*").
statement(p_ci,          s_ci_ecs,     allow, "ecs:UpdateService", "*").
attached(ci_runner, p_ci).

-- service control policy, at the OU level
scp(prod_ou, p_scp_prod).
statement(p_scp_prod, s_scp_env_guard, deny, "s3:*", "arn:aws:s3:::prod-bucket/*").
condition(s_scp_env_guard, "aws:PrincipalTag/env", ne, "prod").

-- permission boundary on ci_runner: artifacts only
boundary(ci_runner, p_bound_ci).
statement(p_bound_ci, s_bound_artifacts, allow, "s3:PutObject", "arn:aws:s3:::artifacts/*").
statement(p_bound_ci, s_bound_ecs,       allow, "ecs:UpdateService", "*").

-- resource (bucket) policy
bucket_policy("arn:aws:s3:::prod-bucket/*", p_bucket).
statement(p_bucket, s_bucket_bob,       allow, "s3:PutObject",    "arn:aws:s3:::prod-bucket/*").
stmt_principal(s_bucket_bob, bob).
statement(p_bucket, s_bucket_no_delete, deny,  "s3:DeleteObject", "arn:aws:s3:::prod-bucket/*").

level_depth(scp, 1).
level_depth(permission_boundary, 2).
level_depth(identity_policy, 3).
level_depth(resource_policy, 4).

-- =========================================================================
-- 5. the request domain, and wildcard expansion as data
-- =========================================================================
-- A policy parser would emit action_in / resource_in by expanding the
-- wildcards in each statement against the known action and resource sets.
-- Here they are written out: the expansion is data, like everything else.

action("s3:GetObject").
action("s3:PutObject").
action("s3:DeleteObject").
action("ecs:UpdateService").

resource("arn:aws:s3:::prod-bucket/data.csv").
resource("arn:aws:s3:::artifacts/build.tgz").
resource("arn:aws:ecs:::service/api").

action_in("s3:GetObject",      "s3:GetObject").
action_in("s3:GetObject",      "s3:*").
action_in("s3:GetObject",      "*").
action_in("s3:PutObject",      "s3:PutObject").
action_in("s3:PutObject",      "s3:*").
action_in("s3:PutObject",      "*").
action_in("s3:DeleteObject",   "s3:DeleteObject").
action_in("s3:DeleteObject",   "s3:*").
action_in("s3:DeleteObject",   "*").
action_in("ecs:UpdateService", "ecs:UpdateService").
action_in("ecs:UpdateService", "ecs:*").
action_in("ecs:UpdateService", "*").

resource_in("arn:aws:s3:::prod-bucket/data.csv",  "arn:aws:s3:::prod-bucket/data.csv").
resource_in("arn:aws:s3:::prod-bucket/data.csv",  "arn:aws:s3:::prod-bucket/*").
resource_in("arn:aws:s3:::prod-bucket/data.csv",  "*").
resource_in("arn:aws:s3:::artifacts/build.tgz",   "arn:aws:s3:::artifacts/build.tgz").
resource_in("arn:aws:s3:::artifacts/build.tgz",   "arn:aws:s3:::artifacts/*").
resource_in("arn:aws:s3:::artifacts/build.tgz",   "*").
resource_in("arn:aws:ecs:::service/api",          "arn:aws:ecs:::service/api").
resource_in("arn:aws:ecs:::service/api",          "*").

-- =========================================================================
-- 6. evaluation
-- =========================================================================

-- which policies an identity carries: attached to it, or to a group it is in
holder(Q, Q)            :- identity(Q).
holder(Q, G)            :- member_of(Q, G).
policy_of(Q, H, Pol)    :- holder(Q, H), attached(H, Pol).

-- an Allow reachable by identity Q, and who holds it
allow_stmt(Q, A, R, H, Sid) :-
    policy_of(Q, H, Pol), statement(Pol, Sid, allow, AP, RP),
    action_in(A, AP), resource_in(R, RP).
allow_stmt(Q, A, R, Pol, Sid) :-
    bucket_policy(BP, Pol), resource_in(R, BP),
    statement(Pol, Sid, allow, AP, RP), stmt_principal(Sid, Q),
    action_in(A, AP), resource_in(R, RP).

-- what a permission boundary permits at all
boundary_allows(Q, A, R) :-
    boundary(Q, Pol), statement(Pol, Sid, allow, AP, RP),
    action_in(A, AP), resource_in(R, RP).
has_boundary(Q)          :- boundary(Q, _).

-- ============ negation below this line only ============

-- a statement with no Condition block applies to every principal
has_cond(Sid)      :- condition(Sid, _, _, _).
applies(Sid, P)    :- statement(_, Sid, _, _, _), identity(P), not has_cond(Sid).
applies(Sid, P)    :- condition(Sid, K, eq, V), tag(P, K, V).
applies(Sid, P)    :- condition(Sid, K, ne, V), tag(P, K, W), W != V.

-- A GRANT: origin P, acting as Q through Chain, allowed by statement Sid
-- held by H. The route term is what makes two grants distinguishable, and
-- therefore countable.
grant(P, Q, A, R, path(Chain, H, Sid)) :-
    via(P, Q, Chain), allow_stmt(Q, A, R, H, Sid), applies(Sid, P).

-- A DENY, and the level of the hierarchy it came from.
deny_at(P, Q, A, R, scp, Sid) :-
    in_account(Q, Acct), governs(Acct, Ou), scp(Ou, Pol),
    statement(Pol, Sid, deny, AP, RP), action_in(A, AP), resource_in(R, RP),
    applies(Sid, P).
deny_at(P, Q, A, R, identity_policy, Sid) :-
    policy_of(Q, _, Pol), statement(Pol, Sid, deny, AP, RP),
    action_in(A, AP), resource_in(R, RP), applies(Sid, P).
-- (`identity(Q)` is here because a resource policy names no identity in its
-- Deny: it binds the acting identity, which nothing else in this rule does.
-- Without it the rule is not range-restricted and the engine would evaluate
-- it top-down instead of materialising it -- see the hygiene check in
-- demo.ts, which is what caught that while this model was being written.)
deny_at(P, Q, A, R, resource_policy, Sid) :-
    identity(Q), bucket_policy(BP, Pol), resource_in(R, BP),
    statement(Pol, Sid, deny, AP, RP), action_in(A, AP), resource_in(R, RP),
    applies(Sid, P).
-- The permission boundary is not an explicit Deny; it is the ABSENCE of an
-- Allow. Grounded on the grant, because a boundary caps an existing grant
-- and there is nothing to cap where nothing granted.
deny_at(P, Q, A, R, permission_boundary, implicit) :-
    grant(P, Q, A, R, _), has_boundary(Q), not boundary_allows(Q, A, R).

blocked(P, Q, A, R) :- deny_at(P, Q, A, R, _, _).

-- DENY OVERRIDES ALLOW. This is the whole precedence rule, and it is one
-- negated premise: nothing schedules it, nothing prioritises it. boot.rofl
-- computes stratum/2 from the rule dependency graph, the engine runs the
-- allow layer to fixpoint and only then the layer that reads `not blocked`.
route(P, A, R, Route) :- grant(P, Q, A, R, Route), not blocked(P, Q, A, R).

access(P, A, R)       :- route(P, A, R, _).

-- =========================================================================
-- 7. the same question asked without the chain in the fact
-- =========================================================================
-- Routes in a graph, not simple paths. Identical Boolean answer -- walk
-- reachability and simple-path reachability coincide -- and a support
-- hypergraph that is genuinely cyclic, so the counting semiring answers
-- "infinitely many". That is the engine being honest; it is just the wrong
-- metric for privilege sprawl.

acts_as_naive(P, P)   :- identity(P).
acts_as_naive(P, Q)   :- acts_as_naive(P, X), assumes(X, Q).

grant_naive(P, Q, A, R, gr(Q, H, Sid)) :-
    acts_as_naive(P, Q), allow_stmt(Q, A, R, H, Sid), applies(Sid, P).
route_naive(P, A, R, Route) :-
    grant_naive(P, Q, A, R, Route), not blocked(P, Q, A, R).
access_naive(P, A, R) :- route_naive(P, A, R, _).

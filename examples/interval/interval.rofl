-- examples/interval/interval.rofl — interval analysis of loop counters, with
-- widening (thresholds) and narrowing, over seven small loops.
--
-- A loop is four rules, one per program point it moves between:
--
--   entry:  the counter's value on the way in            iv_start(L, iv(0, 0))
--   body:   the head, met with what the guard lets in    ivmeet(I, iv(ninf, 9))
--   back:   the body, plus the step                      ivadd(I, 1)
--   exit:   the head, met with what the guard lets out   ivmeet(I, iv(10, inf))
--
-- The head is the one cell that sits on a cycle, so it is the one declared
-- `widen 2`: its first two improvements are joined as any hull does, and the
-- third goes to the next bound the loop's rules write (a threshold), or to
-- infinity. Where the widening overshoots, a descending pass narrows it back
-- to what the rules contribute from it. Neither is ever a value: every head,
-- and everything read from one, is a `widened` shrug with `within(V)`.
--
--   c_*   i = 0; while (i < 10) i = i + 1                 the bound is a constant
--   f_*   i = 0; while (i < N) i = i + 1                  the bound is a fact, N = 7
--   n_*   i = 0; while (i < 8) { j = 0; while (j < 5) j = j + 1; i = i + 1 }
--                                                         nested: two heads
--   d_*   i = 10; while (i > 0) i = i - 1                 a decrement
--   m_*   i = 0; while (i < 1000000) i = i + 1            a bound a million steps away
--   t_*   i = 0; while (i < 5) i = i + 2                  the head ends past every written bound
--   z_*   i = 0; while (true) i = i + 1                   never leaves the loop
edb(iv_start).
iv_start(c, iv(0, 0)).
iv_start(f, iv(0, 0)).
iv_start(n_i, iv(0, 0)).
iv_start(n_j, iv(0, 0)).
iv_start(d, iv(10, 10)).
iv_start(m, iv(0, 0)).
iv_start(z, iv(0, 0)).
iv_start(t, iv(0, 0)).
edb(iv_bound).
iv_bound(f, 7).

-- i = 0; while (i < 10) i = i + 1
lattice c_at(P, hull I).
lattice c_head(P, hull I) widen 2.
c_head(head, I)  :- iv_start(c, I).
c_at(body, J)    :- c_head(head, I), J is ivmeet(I, iv(ninf, 9)).
c_head(head, J)  :- c_at(body, I), J is ivadd(I, 1).
c_at(exit, J)    :- c_head(head, I), J is ivmeet(I, iv(10, inf)).

-- i = 0; while (i < N) i = i + 1: N is a fact, so no number in the rules
-- names it and no threshold catches it
lattice f_at(P, hull I).
lattice f_head(P, hull I) widen 2.
f_head(head, I)  :- iv_start(f, I).
f_at(body, J)    :- f_head(head, I), iv_bound(f, N), M is N - 1, G = iv(ninf, M), J is ivmeet(I, G).
f_head(head, J)  :- f_at(body, I), J is ivadd(I, 1).
f_at(exit, J)    :- f_head(head, I), iv_bound(f, N), G = iv(N, inf), J is ivmeet(I, G).

-- i = 0; while (i < 8) { j = 0; while (j < 5) j = j + 1; i = i + 1 }
-- the inner loop is entered from the outer body, and the outer steps from
-- the inner exit: the outer head is on a cycle through the inner loop
lattice n_at(P, hull I).
lattice n_oh(P, hull I) widen 2.
lattice n_ih(P, hull I) widen 2.
n_oh(head, I)    :- iv_start(n_i, I).
n_at(obody, J)   :- n_oh(head, I), J is ivmeet(I, iv(ninf, 7)).
n_ih(head, I)    :- n_at(obody, _), iv_start(n_j, I).
n_at(ibody, J)   :- n_ih(head, I), J is ivmeet(I, iv(ninf, 4)).
n_ih(head, J)    :- n_at(ibody, I), J is ivadd(I, 1).
n_at(iexit, J)   :- n_ih(head, I), J is ivmeet(I, iv(5, inf)).
n_oh(head, J)    :- n_at(obody, I), n_at(iexit, _), J is ivadd(I, 1).
n_at(oexit, J)   :- n_oh(head, I), J is ivmeet(I, iv(8, inf)).

-- i = 10; while (i > 0) i = i - 1
lattice d_at(P, hull I).
lattice d_head(P, hull I) widen 2.
d_head(head, I)  :- iv_start(d, I).
d_at(body, J)    :- d_head(head, I), J is ivmeet(I, iv(1, inf)).
d_head(head, J)  :- d_at(body, I), J is ivsub(I, 1).
d_at(exit, J)    :- d_head(head, I), J is ivmeet(I, iv(ninf, 0)).

-- i = 0; while (i < 1000000) i = i + 1
lattice m_at(P, hull I).
lattice m_head(P, hull I) widen 2.
m_head(head, I)  :- iv_start(m, I).
m_at(body, J)    :- m_head(head, I), J is ivmeet(I, iv(ninf, 999999)).
m_head(head, J)  :- m_at(body, I), J is ivadd(I, 1).
m_at(exit, J)    :- m_head(head, I), J is ivmeet(I, iv(1000000, inf)).

-- i = 0; while (true) i = i + 1: there is no guard, so no exit
lattice z_head(P, hull I) widen 2.
z_head(head, I)  :- iv_start(z, I).
z_head(head, J)  :- z_head(head, I), J is ivadd(I, 1).

-- i = 0; while (i < 5) i = i + 2
-- the head ends at 6, one step past the 5 the guard writes: no bound the rules
-- write is at or beyond 6, so the widening goes to infinity and narrowing
-- brings it down
lattice t_at(P, hull I).
lattice t_head(P, hull I) widen 2.
t_head(head, I)  :- iv_start(t, I).
t_at(body, J)    :- t_head(head, I), J is ivmeet(I, iv(ninf, 4)).
t_head(head, J)  :- t_at(body, I), J is ivadd(I, 2).
t_at(exit, J)    :- t_head(head, I), J is ivmeet(I, iv(5, inf)).

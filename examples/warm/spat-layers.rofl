-- spat-layers.rofl — SPAT's layers by how often they change, and what each one
-- supplies (S3h). boot → the programme → the world → the family's book →
-- the members' books → the hypotheses → the facts of one call. A relation of
-- the book reaches main by its own name (bridge.rofl, spat.rofl §14), so the
-- layer names the relation, not a perspective.

-- the members' books: every entry relation of access.rofl §4/§5c and the trail
layer_edb(edits, e_move).     layer_edb(edits, e_skip).     layer_edb(edits, e_add).      layer_edb(edits, e_sick).
layer_edb(edits, e_car_out).  layer_edb(edits, e_report).   layer_edb(edits, e_usual).    layer_edb(edits, e_unusual).
layer_edb(edits, e_avail).    layer_edb(edits, e_carry).    layer_edb(edits, e_note).     layer_edb(edits, e_done).
layer_edb(edits, e_waive).    layer_edb(edits, e_remind).   layer_edb(edits, e_reminded).
layer_edb(edits, edit_at).    layer_edb(edits, edit_via).   layer_edb(edits, for_week).
layer_edb(edits, proposed).   layer_edb(edits, confirmed).  layer_edb(edits, retracted).  layer_edb(edits, retracts).
layer_edb(edits, rolled).

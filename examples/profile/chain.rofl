-- examples/profile/chain.rofl — THE EVALUATION READ BY RULES OF THE SAME WORLD (docs/cli.md, *The profile of an
-- evaluation*). A rule that reads the book `profile` asks for it: after the evaluation the engine writes what each
-- rule and premise cost there, and the rules that read it run in the round after.
--
-- A chain of ten, walked two ways: `reach` is recursion alone and goes news first; `depth` carries `K is J + 1`,
-- which keeps it in written order (written_order(R, builtin)), so each round reads the whole of `depth` again
-- (f_a_builtin_is_a_wall_of_the_delta_first_plan names the quadratic this profile shows).

nxt(1, 2). nxt(2, 3). nxt(3, 4). nxt(4, 5). nxt(5, 6). nxt(6, 7). nxt(7, 8). nxt(8, 9). nxt(9, 10).

reach(X, Y) :- nxt(X, Y).
reach(X, Z) :- reach(X, Y), nxt(Y, Z).

depth(1, 0).
depth(B, K) :- nxt(A, B), depth(A, J), K is J + 1.

-- The questions over the profile, as a rule author asks them.

-- a rule the planner kept in written order, and why
kept_written(R, Why) :- written_order[profile](R, Why).

-- a premise that read far more rows than it let through: a scan where a lookup was wanted
scans(R, K, Read, Out) :- read[profile](R, K, Read), yield[profile](R, K, Out), Read > Out * 3, Out > 0.

-- a premise read whole on every firing of a rule that fires once per round: the quadratic of a recursion kept in
-- written order (here `nxt(A, B)` of `depth`, 9 rows read 10 times)
rescanned(R, K, Rel) :-
  fires[profile](R, F), F > 1,
  premise_lit(R, K, $lit(Rel, _, _, _)), rows[profile](Rel, main, N),
  read[profile](R, K, Read), Read is F * N.

-- a rule fired once per round of its recursion
rounds(R, N) :- fires[profile](R, N), N > 2.

-- the chain is a function of its first argument: one next per node
one_next(Rel) :- rows[profile](Rel, main, N), distinct[profile](Rel, main, 1, N).

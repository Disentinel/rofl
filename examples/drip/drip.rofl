slo[repo](slo_api_latency).
title[repo](slo_checkout_availability, "Checkout availability 99.5%").
title[repo](slo_api_latency,           "API latency p99 < 300ms").

-- =========================================================================
-- 3. [repo] — the recording rules
-- =========================================================================
-- A recording rule is a consumer AND a producer: it owns a query like a
-- panel does, and it writes a new metric back into the store. That is what
-- makes lineage recursive and what makes a broken rule a SILENT amplifier —
-- one missing input takes out everything downstream of its output.
--
-- past_input is a different edge from a query selector, and the difference
-- is load-bearing. A smoothing rule reads its OWN previously written
-- samples: that is a real lineage edge (delete the metric and the rule loses
-- its history) but NOT an availability dependency (the rule still evaluates
-- from the live half of its expression). Collapsing the two would make the
-- rule depend on itself and nothing would ever be derivable.

recording_rule[repo](rr_api_error_ratio).
recording_rule[repo](rr_checkout_conv).
recording_rule[repo](rr_db_saturation).
recording_rule[repo](rr_latency_ewma).
recording_rule[repo](rr_load_index).
recording_rule[repo](rr_capacity_headroom).
recording_rule[repo](rr_legacy_batch).

records[repo](rr_api_error_ratio,  "job:http_errors:ratio5m").
records[repo](rr_checkout_conv,    "job:checkout:conversion5m").
records[repo](rr_db_saturation,    "job:db:saturation").
records[repo](rr_latency_ewma,     "svc:latency:ewma").
records[repo](rr_load_index,       "svc:load:index").
records[repo](rr_capacity_headroom, "svc:capacity:headroom").
records[repo](rr_legacy_batch,     "job:legacy:batch_rate").

-- the labels a rule's output carries (its by() clause plus its labels: block)
rule_label[repo](rr_api_error_ratio,  "job", "api").
rule_label[repo](rr_checkout_conv,    "job", "checkout").
rule_label[repo](rr_db_saturation,    "job", "db").
rule_label[repo](rr_db_saturation,    "pool", "primary").
rule_label[repo](rr_latency_ewma,     "job", "api").
rule_label[repo](rr_load_index,       "job", "api").
rule_label[repo](rr_capacity_headroom, "job", "api").
rule_label[repo](rr_legacy_batch,     "job", "batch").

-- the three lineage-only edges: two rules that read each other's past
-- output, and one that reads its own. The lineage graph is cyclic here and
-- nowhere else.
past_input[repo](rr_latency_ewma,      "svc:latency:ewma").
past_input[repo](rr_load_index,        "svc:capacity:headroom").
past_input[repo](rr_capacity_headroom, "svc:load:index").


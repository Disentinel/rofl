-- =========================================================================
-- 2. [repo] — the alerts and the SLOs
-- =========================================================================
-- These are the consumers that fail SILENTLY. A dark panel is at least
-- visible to whoever opens the dashboard; a dark alert is visible to nobody
-- until the day it was needed.

alert[repo](al_api_5xx).
alert[repo](al_checkout_conv_drop).
alert[repo](al_payment_gw_errors).
alert[repo](al_db_pool_exhaustion).
alert[repo](al_queue_backlog).
alert[repo](al_canary_errors).

severity[repo](al_api_5xx,             page).
severity[repo](al_checkout_conv_drop,  page).
severity[repo](al_payment_gw_errors,   page).
severity[repo](al_db_pool_exhaustion,  page).

-- =========================================================================
-- 7. the vocabulary of the two ledgers, lifted into [main]
-- =========================================================================

consumer(C)             :- panel[repo](C, _).
consumer(C)             :- alert[repo](C).
consumer(C)             :- slo[repo](C).
consumer_kind(C, panel) :- panel[repo](C, _).
consumer_kind(C, alert) :- alert[repo](C).
consumer_kind(C, slo)   :- slo[repo](C).

-- Every metric name this world knows about, from either end. The three arms
-- are DISJOINT on purpose: in the store now, in the store two weeks ago and
-- not now, or named by a query and never in the store at all (the last arm
-- catches a typo, and is why counting over lineage stays exact — a metric
-- with two derivations here would double every path count through it).
metric(M) :- series[store](M).
metric(M) :- was_series[store](M), not series[store](M).
metric(M) :- selector_metric[repo](_, M), not series[store](M), not was_series[store](M).

-- =========================================================================
-- 8. walking a list positively — "all of them", without negation
-- =========================================================================
-- ml_ok(S, N): the first N matchers of selector S all hold.
-- sl_ok(Q, N): the first N selectors of query Q all resolve.
-- Each step multiplies exactly one derivation into the next, so a semiring
-- folded over these relations counts sources and not bookkeeping.

sel_in(Q, S)        :- selector_at[repo](Q, _, S).
matcher_of(S, K, V) :- matcher_at[repo](S, _, K, V).

-- =========================================================================
-- 9. resolution — does this query resolve into series that exist?
-- =========================================================================
-- The recursion that matters: a query resolves only if its metrics resolve,
-- and a recorded metric resolves only if the RULE that writes it resolves,
-- which is a query again. One missing scrape target can therefore darken a
-- panel four links away, and that chain is what whynot walks.
--
-- A recorded metric is answered for by its rule, not by the store: it is in
-- the store only because the rule put it there, so `not recorded_metric`
-- keeps exactly one derivation per metric instead of two. (A recorded metric
-- whose rule broke last week may still be in the store until retention
-- expires; this model calls it gone the moment the rule breaks, which is
-- early rather than wrong. Stated in README.md.)

recorded_metric(M)  :- records[repo](_, M).
metric_ok(M)        :- series[store](M), not recorded_metric(M).
metric_ok(M)        :- records[repo](R, M), rule_ok(R).

label_ok(M, K, V)   :- series_label[store](M, K, V), not recorded_metric(M).
label_ok(M, K, V)   :- records[repo](R, M), rule_ok(R), rule_label[repo](R, K, V).

ml_ok(S, 0)         :- selector_metric[repo](S, _).
ml_ok(S, N)         :- matcher_at[repo](S, N, K, V), selector_metric[repo](S, M),
                       label_ok(M, K, V), N1 is N - 1, ml_ok(S, N1).
matchers_ok(S)      :- matcher_count[repo](S, N), ml_ok(S, N).

selector_ok(S)      :- selector_metric[repo](S, M), metric_ok(M), matchers_ok(S).

sl_ok(Q, 0)         :- query[repo](Q, _).
sl_ok(Q, N)         :- selector_at[repo](Q, N, S), selector_ok(S),
                       N1 is N - 1, sl_ok(Q, N1).
query_ok(Q)         :- selector_count[repo](Q, N), sl_ok(Q, N).

-- A recording rule owns exactly one query (Prometheus allows exactly one
-- expr); test/example-drip.test.ts asserts that, so the existential below is
-- a universal in disguise and stays one.
rule_ok(R)          :- recording_rule[repo](R), query[repo](Q, R), query_ok(Q).

-- A panel plots what it can: one resolving query is enough to draw
-- something. That is the whole difference between DARK and DEGRADED.
consumer_live(C)    :- consumer(C), query[repo](Q, C), query_ok(Q).
consumer_dark(C)    :- consumer(C), not consumer_live(C).

-- =========================================================================
-- 10. two different edges, and collapsing them is the mistake
-- =========================================================================
-- feeds_now(A, B): metric A is read by the query of the rule that writes B.
--   Delete A and B stops being written. This is the AVAILABILITY edge, and
--   the graph over it is acyclic — a cycle here would mean Prometheus itself
--   could not order the rules.
-- feeds_past(A, B): the rule that writes B reads A's already-written
--   samples. Delete A and B keeps being written, but its history is gone.
--   This is a LINEAGE edge only, and the graph over it has a self-loop and
--   a two-cycle.
--
-- The first version of this file had one `feeds` relation for both, and the
-- excise oracle disagreed with the derived blast radius on two metrics out
-- of four — p_capacity_headroom was predicted to go dark when queue_depth
-- was deleted, and it does not. The disagreement was the model's, not the
-- engine's. Two relations, two questions.

query_uses(Q, M)   :- sel_in(Q, S), selector_metric[repo](S, M).
uses(C, M)         :- query[repo](Q, C), query_uses(Q, M).

feeds_now(In, Out)  :- records[repo](R, Out), query[repo](Q, R), query_uses(Q, In).
feeds_past(In, Out) :- records[repo](R, Out), past_input[repo](R, In).
feeds(In, Out)      :- feeds_now(In, Out).
feeds(In, Out)      :- feeds_past(In, Out).

-- === availability: acyclic, so no chain is needed ===
needs_up(Top, Top) :- metric(Top).
needs_up(Top, M)   :- needs_up(Top, X), feeds_now(M, X).
q_needs(Q, M)      :- query_uses(Q, Top), needs_up(Top, M).
needs(C, M)        :- consumer(C), query[repo](Q, C), q_needs(Q, M).

-- === lineage: cyclic, so the path goes inside the fact ===
-- lineage(Top, M, Path): metric M reaches Top along Path, current metric
-- first, Top last, no metric repeated. Re-entering a metric is not another
-- way for data to arrive, so a chain may not repeat one — which is what
-- makes the count of paths finite over the two cycles above, and what
-- examples/nope does with assume-role chains for the same reason.
--
-- Rooted at a METRIC and not at a query on purpose: the root is recoverable
-- from the path, so each path has exactly one derivation. Rooting it at the
-- query would give the same set of paths and multiply every count by the
-- number of queries that happen to share the root.

chain_seen(P)         :- lineage(_, _, P).
absent(M, nil)        :- metric(M).
absent(M, cons(X, P)) :- chain_seen(cons(X, P)), absent(M, P), M != X.

lineage(Top, Top, cons(Top, nil)) :- metric(Top).
lineage(Top, M, cons(M, P))       :- lineage(Top, X, P), feeds(M, X), absent(M, P).

upstream(Top, M)  :- lineage(Top, M, _).
q_depends(Q, M)   :- query_uses(Q, Top), upstream(Top, M).
depends(C, M)     :- consumer(C), query[repo](Q, C), q_depends(Q, M).

-- =========================================================================
-- 11. blast radius — load-bearing against mention
-- =========================================================================
-- The distinction examples/oops draws between a citation that carries an
-- argument and one that names a paper in passing. Here it is not declared,
-- it is computed: a consumer with a second, resolving query that does not
-- itself need M survives losing M. p_payment_gw_errors and p_exec_health
-- both stand on the same metric; one dies and one loses a line.
--
-- Over the AVAILABILITY edge, because that is the question being asked. The
-- lineage edge answers a different one and is used in part 13.

survives_without(C, M) :- needs(C, M), query[repo](Q, C), query_ok(Q),
                          not q_needs(Q, M).
goes_dark(M, C)        :- needs(C, M), consumer_live(C), not survives_without(C, M).
degrades(M, C)         :- needs(C, M), consumer_live(C), survives_without(C, M).

-- the post-mortem half: consumers already dark, and the metric they wanted
already_dark(M, C)     :- needs(C, M), consumer_dark(C), not metric_ok(M).

-- =========================================================================
-- 12. why it is empty — the structural causes, named
-- =========================================================================
-- whynot walks the chain link by link; these relations are the summary that
-- chain adds up to, so a report can group by cause without parsing a tree.

wanted(M)               :- selector_metric[repo](_, M).
absent_metric(M)        :- wanted(M), not metric_ok(M).
never_existed(M)        :- wanted(M), not series[store](M), not was_series[store](M).
broken_matcher(S, K, V) :- matcher_of(S, K, V), selector_metric[repo](S, M),
                           metric_ok(M), not label_ok(M, K, V).
broken_rule(R)          :- recording_rule[repo](R), not rule_ok(R).

dark_missing_metric(C, M)      :- consumer_dark(C), uses(C, M), not metric_ok(M),
                                  not recorded_metric(M).
dark_broken_rule(C, R, M)      :- consumer_dark(C), uses(C, M), records[repo](R, M),
                                  broken_rule(R).
dark_missing_label(C, M, K, V) :- consumer_dark(C), query[repo](Q, C), sel_in(Q, S),
                                  selector_metric[repo](S, M), metric_ok(M),
                                  broken_matcher(S, K, V).

-- the exact label value that went away between the two snapshots
label_disappeared(M, K, V) :- was_label[store](M, K, V), series[store](M),
                              not series_label[store](M, K, V).

-- =========================================================================
-- 13. dead series — the query nobody runs
-- =========================================================================
-- Not "rarely queried" by request statistics: PROVABLY influencing nothing.
-- No panel, no alert, no SLO stands on it, directly or through any rule, by
-- either kind of edge — a metric read only for its history is still read.
-- This is MOOT's dead-rule audit pointed at data instead of rules, and it is
-- the query most likely to pay for itself, because storage is billed.

watched(M)      :- depends(_, M).
dead_series(M)  :- series[store](M), not watched(M).
dead_rule(R)    :- recording_rule[repo](R), records[repo](R, M), not watched(M).

-- =========================================================================
-- 14. rename — a HYPOTHESIS, and it stays one
-- =========================================================================
-- An old metric vanished and a new one appeared with the same shape. That is
-- a guess, not a derivation, and the guarantee that it stays a guess is
-- structural rather than editorial: NOTHING in parts 9 to 13 reads any
-- relation defined here. demo.ts proves that from the kernel's own rule
-- dependency graph — `reach(consumer_dark, renamed_to)` is empty — instead
-- of asking to be believed.

vanished(M)         :- was_series[store](M), not series[store](M).
appeared(M)         :- series[store](M), not was_series[store](M).
label_key(M, K)     :- series_label[store](M, K, _).
was_label_key(M, K) :- was_label[store](M, K, _).

key_missing(Old, New) :- vanished(Old), appeared(New),
                         was_label_key(Old, K), not label_key(New, K).
key_extra(Old, New)   :- vanished(Old), appeared(New),
                         label_key(New, K), not was_label_key(Old, K).
same_type(Old, New)   :- was_type[store](Old, T), metric_type[store](New, T).

shape_match(Old, New) :- vanished(Old), appeared(New), same_type(Old, New),
                         not key_missing(Old, New), not key_extra(Old, New).

same_job(Old, New)    :- was_label[store](Old, "job", J), series_label[store](New, "job", J).
orphan_name(M)        :- appeared(M), not watched(M).

-- Three tiers of evidence for the same guess. Each is a separate derivation
-- of renamed_to, and the Viterbi fold takes the best one: confidence is the
-- strongest evidence available, not the product of the weakest.
rename_hypothesis(Old, New, shape_only)    :- shape_match(Old, New).
rename_hypothesis(Old, New, shape_and_job) :- shape_match(Old, New), same_job(Old, New).
rename_hypothesis(Old, New, shape_job_orphan) :- shape_match(Old, New),
                                                 same_job(Old, New),
                                                 orphan_name(New), watched(Old).
renamed_to(Old, New) :- rename_hypothesis(Old, New, _).

-- =========================================================================
-- 15. the same lineage question, asked without the chain
-- =========================================================================
-- Identical Boolean answer — walk reachability and simple-path reachability
-- coincide — over a support hypergraph that is genuinely cyclic, so the
-- counting semiring answers "infinitely many". The engine is being honest;
-- it is simply the wrong metric for fragility. Same contrast as part 7 of
-- examples/nope.

upstream_naive(Top, Top) :- metric(Top).
upstream_naive(Top, M)   :- upstream_naive(Top, X), feeds(M, X).

-- Acceptance scenario (examples/drip/demo.ts runs all of it):
--   ? consumer_dark(C)                     -> 10 of 31, with a named cause each
--   whynot consumer_live(p_checkout_conv)  -> four links down to the missing scrape
--   whynot consumer_live(p_canary_errors)  -> the metric is fine; the LABEL is gone
--   ? goes_dark(M, C) vs degrades(M, C)    -> sole source against one line of six
--   excise series[store](M)                -> the blast radius as a diff, and it
--                                             equals goes_dark(M, C), metric by metric
--   ? dead_series(M)                       -> metrics nothing stands on
--   ? renamed_to(Old, New)                 -> one hypothesis, and it stays one

severity[repo](al_canary_errors,       ticket).

title[repo](al_api_5xx,            "API 5xx ratio above 2%").
title[repo](al_checkout_conv_drop, "Checkout conversion dropped").
title[repo](al_payment_gw_errors,  "Payment gateway erroring").

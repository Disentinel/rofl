query[repo](q_rr_cap,         rr_capacity_headroom).
query[repo](q_rr_legacy,      rr_legacy_batch).

-- The leaves of each query's PromQL expression, BY POSITION. A dashboard's
-- targets are a JSON array and a selector's matchers are a JSON object read
-- in source order, so an index is what the extractor already has.
--
-- Indexed, not a cons list, and the reason is arithmetic rather than taste.
-- "Every selector resolves" and "every matcher holds" are UNIVERSAL, and
-- negation cannot express them here: recording rules make the consumer graph
-- recursive, so `not broken(Q)` would put a negation inside its own cycle and
-- the kernel would reject the program (README.md, "What fought back"). Both
-- a cons-list walk and an index walk say "all of them" positively; the index
-- walk additionally keeps every step SINGLE-DERIVATION, and a shared list
-- term does not, which is the difference between a fragility count of 1 and
-- a fragility count of 14 for the same one-source panel.

selector_at[repo](q_api_rps,      1, s_api_rps).
selector_count[repo](q_api_rps,      1).
selector_at[repo](q_api_latency,  1, s_api_lat).
selector_count[repo](q_api_latency,  1).
selector_at[repo](q_api_ratio,    1, s_api_ratio).
selector_count[repo](q_api_ratio,    1).
selector_at[repo](q_ck_orders,    1, s_ck_orders).
selector_count[repo](q_ck_orders,    1).
selector_at[repo](q_ck_funnel,    1, s_ck_funnel).
selector_count[repo](q_ck_funnel,    1).

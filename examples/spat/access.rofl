-- access.rofl — WHO MAY READ, WHO MAY EDIT, WHAT AN EDIT DOES. The rules of
-- the multi-user store; store.ts is the loader and the writer and decides
-- nothing. Every verdict the CLI turns into an exit code is a relation here,
-- and `spat why` can be asked for any of them.
--
-- THE BOOK IS THE FILE. `ledgers/<user>.rofl` loads into `[p_<user>]`,
-- `me.rofl` into `[p_me]`, `world.rofl` and `users.rofl` into `[main]`; the
-- loader asserts `authority(Book, User)` for every book it finds and
-- `caller(U)`, `tenant(T)` for the call — `caller` named directly by
-- SPAT_AS, or resolved from a Telegram sender id (`from_id(N)`, SPAT_FROM_ID)
-- through users.rofl. Nothing in a book can say which book it is in: the
-- loader refuses a line tagged with another book.
--
-- FOUR LAYERS, and each answers one question:
--   accounts      who exists here, in which role
--   may_read      which books a call may open — asked BEFORE they are opened
--   may_edit      which constraint a user may change with an edit
--   acts          which entries of the books are in force this week
--
-- Every rule range-restricted in written order; premise order is the
-- cheapest relation first, as everywhere in spat.rofl.

-- =========================================================================
-- 1. ACCOUNTS AND ROLES
-- =========================================================================
-- An adult or a helper of the household has a book; a child does not. A
-- Telegram user of this tenant has whatever role users.rofl gives them, and
-- the operator lives only there. `me` is the tool itself — the scheduled
-- `tomorrow`, the `ics` feed — and needs no line anywhere.

-- for: a household member's role comes from the world file, never retyped
role(U, adult)   :- person(U, adult).
role(U, helper)  :- person(U, helper).
-- for: users.rofl adds roles (operator) and admits people the world does not
--      list, but only rows of THIS tenant count
role(U, R)       :- tg_user(U, _, T, R), tenant(T).
role(me, me).
account(U)       :- role(U, _).

-- for: whoever the call names and no account knows is a stranger, and the
--      loader turns that into code 5 before any book is opened
stranger(U)      :- caller(U), not account(U).
-- for: a Telegram SENDER is whoever users.rofl lists under that id, in that
--      tenant — the chat is only where the answer goes; an id nobody listed
--      is a stranger («я вас не знаю»), decided here and refused by the
--      loader before a file of any tenant is opened
sender(U, T)     :- from_id(N), tg_user(U, N, T, _).
known_id(N)      :- tg_user(_, N, _, _).
stranger(N)      :- from_id(N), not known_id(N).

-- for: a book exists when a file with an account's name exists; a file for
--      nobody is not a book and is never opened
ledger(L, U)     :- authority(L, U), account(U).

-- =========================================================================
-- 2. READING
-- =========================================================================
-- for: an adult of the family reads every book of the family and the tool's
may_read(U, L)   :- role(U, adult), ledger(L, _).
-- for: a helper reads only their own book and the tool's — not the parents'
may_read(U, L)   :- role(U, helper), ledger(L, U).
may_read(U, L)   :- role(U, helper), ledger(L, me).
-- for: the tool reads everything of the tenant; it writes only me.rofl
may_read(me, L)  :- ledger(L, _).
-- for: the operator reads everything
may_read(U, L)   :- role(U, operator), ledger(L, _).

-- =========================================================================
-- 3. EDITING
-- =========================================================================
-- `constraint(Id, Owner, Scope)` already says whose a thing is; the right to
-- edit is read off that field and off the role, and off nothing else.

-- for: an adult may renegotiate any household constraint round the table —
--      robin moves the school run even though it is alex's
may_edit(U, C)   :- role(U, adult), household(C).
-- for: your own constraint is yours whatever its scope (the nanny's hours)
may_edit(U, C)   :- constraint(C, U, _), account(U).
-- for: `sick <person>` and `add ... <who>` touch a person: an adult may
--      speak for anyone in the house, a helper only for themselves
may_edit(U, P)   :- role(U, adult), person(P, adult).
may_edit(U, P)   :- role(U, adult), person(P, child).
may_edit(U, U)   :- role(U, helper).
-- for: `car out` touches the car, and the car is the household's
may_edit(U, Cr)  :- role(U, adult), car(Cr).
-- for: a helper's HOURS are the household's arrangement — «няня сегодня с
--      17:30» is the parents' sentence as much as the nanny's — so an adult may
--      change the constraint of a helper's window for a day (`avail`, §5); the
--      helper's own line is theirs already by the rule above. Measured on
--      2eafa2f: c_nanny was editable by nanny alone, and the parents, whose
--      nanny it is, got code 4. A neighbour's window stays nobody's to edit.
may_edit(U, C)   :- role(U, adult), present_window(C, P, _, _, _), person(P, helper).
-- for: an external constraint is REPORTED, never edited, by any member
may_report(U, C) :- account(U), external(C).

-- =========================================================================
-- 4. THE ENTRIES OF A BOOK
-- =========================================================================
-- One edit is one id E and a handful of facts in ONE book:
--   e_move(E, Block, Day|all, Time)          e_skip(E, Block, Day|all)
--   e_add(E, What, Day, From, To, Who, Where) e_sick(E, Person, Day|all)
--   e_car_out(E, Day, From, To)               e_report(E, Constraint, Day, Time)
--   e_usual(E, What, Days, From, To, Who, Where)   every week — one line of the typical week
--   e_unusual(E, Block, Days)                      every week — the block is off on those days
--   e_avail(E, Who, Day, From, To)            this day the person is there From–To, and only then
--   e_carry(E, Child, Day, At, Who)           the child's leg that begins about At is Who's to drive
--   e_note(E, Day, Who|all, "text")           a line under the day, or under a person; no rule reads it
--   e_done(E, Req, Day)                       a condition of a need is done (spat.rofl §15); e_waive(E, Req) — skipped
--   e_remind(E, Req, At)                      remind at one moment (minutes, the loader's scale); e_reminded(E, Req, At) — sent, p_me only
--   edit_at(E, Iso)  edit_via(E, telegram|cli)  for_week(E, Week)
--   proposed(E)      confirmed(E, Iso, Via)      retracted(E, Iso, Via)
-- Nothing is ever deleted: a retraction is one more fact in the same book,
-- and every fact carries its moment and its channel.

-- for: which book an entry sits in. The facts ABOUT an entry — its week, a
--      confirm, a retraction — are joined on L through `entry`, so a fact
--      about E in ANOTHER book (a stray confirm, a forged retraction) is
--      inert; the op literal itself binds L and needs no second join.
entry(E, L)      :- e_move[L](E, _, _, _).
entry(E, L)      :- e_skip[L](E, _, _).
entry(E, L)      :- e_add[L](E, _, _, _, _, _, _).
entry(E, L)      :- e_sick[L](E, _, _).
entry(E, L)      :- e_car_out[L](E, _, _, _).
entry(E, L)      :- e_report[L](E, _, _, _).
entry(E, L)      :- e_usual[L](E, _, _, _, _, _, _).
entry(E, L)      :- e_unusual[L](E, _, _).
entry(E, L)      :- e_avail[L](E, _, _, _, _).
entry(E, L)      :- e_carry[L](E, _, _, _, _).
entry(E, L)      :- e_note[L](E, _, _, _).
entry(E, L)      :- e_done[L](E, _, _).
entry(E, L)      :- e_waive[L](E, _).
entry(E, L)      :- e_remind[L](E, _, _).
entry(E, L)      :- e_reminded[L](E, _, _).
edit_by(E, U)    :- entry(E, L), ledger(L, U).
edit_week(E, W)  :- entry(E, L), for_week[L](E, W).
is_report(E)     :- e_report[L](E, _, _, _).
is_note(E)       :- e_note[L](E, _, _, _).
-- for: a mark on a need's condition — done, skipped, remind me, reminded —
--      constrains nothing either (§5c)
is_note(E)       :- e_done[L](E, _, _).
is_note(E)       :- e_waive[L](E, _).
is_note(E)       :- e_remind[L](E, _, _).
is_note(E)       :- e_reminded[L](E, _, _).
retracted_edit(E) :- entry(E, L), retracted[L](E, _, _).
-- for: «убери greek пн» on a block ANOTHER member added — the schedule as the
--      human sees it includes what a book put there. The entry's book is not
--      the caller's to write, so the caller writes `retracts(E, Iso, Via)` into
--      THEIR book, and it counts by the right that lets them edit the entry
--      (its constraint is the author's, household or external): a row without
--      that right is an audit line and never acts
retracted_edit(E) :- retracts[L](E, _, _), ledger(L, U), may_edit(U, E).
retract_without_right[audit](E, L) :- retracts[L](E, _, _), ledger(L, U), not may_edit(U, E).
confirmed_edit(E) :- entry(E, L), confirmed[L](E, _, _).
proposed_edit(E)  :- entry(E, L), proposed[L](E).
-- for: a confirm or a retract written into a book other than the edit's own
--      is visible, so a hand-edited file does not fail silently
stray[audit](E, L) :- confirmed[L](E, _, _), not entry(E, L).
stray[audit](E, L) :- retracted[L](E, _, _), not entry(E, L).
stray[audit](E, L) :- proposed[L](E), not entry(E, L).
stray[audit](E, L) :- for_week[L](E, _), not entry(E, L).

-- for: an edit IS a constraint, owned by its author: `why` names the person,
--      `relax` can waive it, the unowned-lint holds for edits too. A helper's
--      arrangement is external to the household exactly as `c_nanny` is. A
--      report and a note constrain nothing and are not constraints.
constraint(E, U, household) :- edit_by(E, U), role(U, adult), not is_report(E), not is_note(E).
constraint(E, U, external)  :- edit_by(E, U), role(U, helper), not is_report(E), not is_note(E).

-- WHAT AN EDIT TOUCHES: the constraint of the block, the person, the car.
-- for: a block may carry two constraints (`c_school` and `c_school_fri`) and
--      touching it touches both, so a Friday-only external end still refuses
touches(E, C)    :- e_move[L](E, Ev, _, _), usual(C, Ev, _, _, _, _, _).
touches(E, C)    :- e_move[L](E, Ev, _, _), usual_on(C, Ev, _, _, _).
touches(E, C)    :- e_skip[L](E, Ev, _), usual(C, Ev, _, _, _, _, _).
touches(E, C)    :- e_skip[L](E, Ev, _), usual_on(C, Ev, _, _, _).
-- for: a block for a GUEST of a need — a participant with no account, the
--      band's Ivan (spat.rofl §15 `guest`) — touches the need, whose
--      constraint is its author's (household): an adult may schedule the
--      guest for the need; the guest's own hours are `avail` below
touches(E, P)    :- e_add[L](E, _, _, _, _, P, _), not guest(P).
touches(E, N)    :- e_add[L](E, _, _, _, _, P, _), guest(P), need_for(N, P).
touches(E, P)    :- e_sick[L](E, P, _).
touches(E, Cr)   :- e_car_out[L](E, _, _, _), car(Cr).
-- for: a person's hours for a day touch the constraint of their window — the
--      helper's own, editable by them and (above) by an adult of the house
touches(E, C)    :- e_avail[L](E, P, _, _, _), present_window(C, P, _, _, _).
-- for: a guest's window («могу/не могу» sent by the owner) touches the need
--      the guest is in, as the block above does
touches(E, N)    :- e_avail[L](E, P, _, _, _), guest(P), need_for(N, P).
-- for: done / skipped / remind on a condition touch the condition — the
--      household's, or the responsible person's own (§3, `constraint(C, U, _)`)
touches(E, R)    :- e_done[L](E, R, _).
touches(E, R)    :- e_waive[L](E, R).
touches(E, R)    :- e_remind[L](E, R, _).
-- for: handing a child's leg to somebody touches the child: an adult may, a
--      helper may not (`may_edit(U, P)` above). A note touches nothing.
touches(E, Ch)   :- e_carry[L](E, Ch, _, _, _).
-- for: a recurring line touches what its one-off twin touches: the person,
--      or the block's constraints (a recurring block of another edit included)
touches(E, P)    :- e_usual[L](E, _, _, _, _, P, _).
touches(E, C)    :- e_unusual[L](E, Ev, _), usual(C, Ev, _, _, _, _, _).
touches(E, C)    :- e_unusual[L](E, Ev, _), usual_on(C, Ev, _, _, _).

-- for: THE REFUSAL. An entry touching something its author may not edit, or
--      a report on something that is not external. Code 4 at the door; and
--      if such a line ever reaches a file, it never acts. `no_right` is the
--      fact in main that `acts` reads; the audit row is its projection, so
--      main never reads the audit book.
no_right(E)      :- touches(E, X), edit_by(E, U), not may_edit(U, X).
no_right(E)      :- e_report[L](E, C, _, _), ledger(L, U), not may_report(U, C).
edit_without_right[audit](E) :- no_right(E).

-- for: a proposed edit waits for its author's confirm; only then it acts
pending(E)       :- proposed_edit(E), not confirmed_edit(E).
-- for: WHAT IS IN FORCE — written, not retracted, within its right, and not
--      waiting. Everything the schedule derives from a book goes through this.
acts(E)          :- edit_by(E, _), not retracted_edit(E), not no_right(E), not pending(E).

-- =========================================================================
-- 5. WHAT THE ENTRIES DO TO THE WEEK
-- =========================================================================
-- Into the four layers spat.rofl already has: moved/7, skipped/4, added/8,
-- absent_on/4. The edit id is the constraint id, the edit's week is the
-- week, so an old week stays answerable under --week-of with its own edits.

-- for: move a block to a time on one day, or on every day it applies
moved(E, Ev, W, D, D, T, T2) :- e_move[L](E, Ev, D, T), acts(E),
                                edit_week(E, W), day(D, _),
                                usual(_, Ev, _, _, _, F0, T0), T2 is T + T0 - F0.
moved(E, Ev, W, D, D, T, T2) :- e_move[L](E, Ev, all, T), acts(E),
                                edit_week(E, W), usual(_, Ev, _, _, Spec, F0, T0),
                                applies_on(Spec, D), T2 is T + T0 - F0.
-- for: skip a block on one day, or on every day it applies
skipped(E, Ev, W, D) :- e_skip[L](E, Ev, D), acts(E), edit_week(E, W), day(D, _).
skipped(E, Ev, W, D) :- e_skip[L](E, Ev, all), acts(E), edit_week(E, W),
                        usual(_, Ev, _, _, Spec, _, _), applies_on(Spec, D).
-- for: a one-off block, owned by its author
added(E, What, Who, Where, W, D, F, T) :- e_add[L](E, What, D, F, T, Who, Where),
                                          acts(E), edit_week(E, W).
-- for: SICK — the host writes one line and the consequences are derived:
--      every block of the person that day is off, every block that has them
--      in it (`with`) is off, and the person is away, so they cover nobody
sick_day(E, P, D) :- e_sick[L](E, P, D), acts(E), day(D, _).
sick_day(E, P, D) :- e_sick[L](E, P, all), acts(E), day(D, _).
skipped(E, Ev, W, D)   :- sick_day(E, P, D), edit_week(E, W),
                          usual(_, Ev, P, _, Spec, _, _), applies_on(Spec, D).
skipped(E, Ev, W, D)   :- sick_day(E, P, D), edit_week(E, W), with(Ev, P),
                          usual(_, Ev, _, _, Spec, _, _), applies_on(Spec, D).
absent_on(E, P, W, D)  :- sick_day(E, P, D), edit_week(E, W).
-- for: CAR OUT — the car is nowhere from F to T, so every journey that would
--      take it in that window has no car standing where it starts; walking
--      is then the only mode and `too_slow` says whether it still fits.
--      At T the car is home again.
car_away(D, F, T) :- e_car_out[L](E, D, F, T), acts(E), edit_week(E, W), current(W).
car_taken(Cr, D, T0, T) :- car_away(D, F, X), car_here(Cr, D, _, T0),
                           car_leg(Cr, D, _, _, T, _), T0 <= T, F <= T, T < X.
car_here(Cr, D, Home, X) :- car_away(D, _, X), car(Cr), base(Home).
-- for: a REPORT changes nothing in the world; it is first-hand and waits for
--      the operator to carry it into world.rofl
reported(C, D, T, U) :- e_report[L](E, C, D, T), ledger(L, U), not retracted_edit(E).
-- for: EVERY WEEK — a recurring line is one more line of the typical week,
--      `usual/7` in shape, owned by its author, and off every week once
--      retracted. Its standing is the same three questions `acts` asks —
--      within the right, not retracted, not waiting — asked here WITHOUT going
--      through `no_right`: `touches` reads `usual` (to name a block's
--      constraints), so `usual :- acts` would close a cycle through the
--      negation in `acts` and the program would be refused. Measured
--      2026-09-15: the rounds evaluator stalls with 22 relations unsettled.
acts_recurring(E) :- e_usual[L](E, _, _, _, _, P, _), edit_by(E, U), may_edit(U, P),
                     not retracted_edit(E), not pending(E).
usual(E, What, Who, Where, Spec, F, T) :- e_usual[L](E, What, Spec, F, T, Who, Where), acts_recurring(E).
-- for: a recurring skip is the block off on those days of whichever week is in force
skipped(E, Ev, W, D) :- e_unusual[L](E, Ev, Spec), acts(E), current(W),
                        usual(_, Ev, _, _, Sp, _, _), applies_on(Sp, D), applies_on(Spec, D).

-- =========================================================================
-- 5a. DATED EXCEPTIONS — the secretary's lines (S3c, 2026-09-16)
-- =========================================================================
-- «Няня сегодня с 17:30», «Кита забираю я в среду в 14:00», «не забыть торт»
-- are not the world (they do not recur) and not a rule of the family (they
-- are not a kind of anything): they are edits of one week, like `sick` and
-- `car out`, and act through the same `acts` as every other entry.

-- for: AVAIL — the person's window for THAT day, instead of the world's
--      (spat.rofl §4 `window`). The edit is the constraint, so `whynot` names
--      the person who said it; the world's line on the same day does not act.
present_on(E, P, D, F, T) :- e_avail[L](E, P, D, F, T), acts(E), edit_week(E, W), current(W), day(D, _).

-- for: CARRY — a run of the child's day is Who's. The run stays a run (its
--      ways, its `no_way`, its backup count are the world's questions); what
--      the line changes is WHO the grid prints, and a run taken this way is
--      not the solver's to hand out. THE TIME IS THE ONE THE PERSON SEES —
--      measured on the stand 2026-09-16: the grid said «13:45–14:05 ВЕЗЁТ …»
--      for a school that ends 13:25, and `carry … 13:45` matched nothing. So a
--      carry names a run when its time is within a quarter of an hour of the
--      run's own moment, of the block boundary the run leaves from, or of the
--      window of any way the grid could print (`attempt` departure–return).
carry(E, Ch, D, At, Who) :- e_carry[L](E, Ch, D, At, Who), acts(E), edit_week(E, W), current(W), day(D, _).
near(At, X) :- carry(_, _, _, At, _), run(_, _, _, _, _, _, X), Lo is At - 15, X >= Lo, Hi is At + 15, X <= Hi.
near(At, X) :- carry(_, _, _, At, _), span(_, _, _, _, _, _, X), Lo is At - 15, X >= Lo, Hi is At + 15, X <= Hi.
carry_run(T, E, Who) :- carry(E, Ch, D, At, Who), run(T, Ch, _, _, D, _, X), near(At, X).
carry_run(T, E, Who) :- carry(E, Ch, D, At, Who), run(T, Ch, From, _, D, _, _), base(B), From != B,
                        span(_, _, Ch, From, D, _, Lv), near(At, Lv).
carry_run(T, E, Who) :- carry(E, Ch, D, At, Who), run(T, Ch, _, _, D, _, _),
                        attempt(T, _, _, D, Dep, Ret), Lo is Dep - 15, At >= Lo, Hi is Ret + 15, At <= Hi.
-- for: a person who said they would is a way: a run somebody took is not
--      «некому везти», whatever the roads the world knows (`run_stuck` reads
--      `run_ok`, spat.rofl §6); the grid prints them at the run's moment
run_ok(T) :- carry_run(T, _, _).
-- for: WHAT A CARRY WARNS OF, never refuses: the carrier is inside a block of
--      their own at that moment (a block that already has the child in it is
--      the same errand, not a clash); or no run of the child's day is near At,
--      so the line changes nothing. The clash is a defect of the day, by name,
--      so an edit that brings one is a «ломает» line like any other.
carry_during(E, Who, D, At, Ev) :- carry(E, Ch, D, At, Who), span(_, Ev, Who, _, D, F, T),
                                   F <= At, At < T, not with(Ev, Ch).
defect(D, carrier_busy, E)      :- carry_during(E, _, D, _, _).
carry_leg(E)                    :- carry_run(_, E, _).
carry_idle(E, Ch, D, At)        :- carry(E, Ch, D, At, _), not carry_leg(E).

-- for: NOTE — a line under a day, or under one person of it, printed by
--      show/tomorrow and read by no rule of the schedule
note_on(E, D, Who, Text) :- e_note[L](E, D, Who, Text), acts(E), edit_week(E, W), current(W), day(D, _).

-- =========================================================================
-- 5c. A NEED'S CONDITIONS — done, skipped, remind me, reminded (S3f)
-- =========================================================================
-- The need itself is the family's book (spat.rofl §15); what happened to a
-- condition is a dated line of a person's book, through `acts` like every
-- entry. `done` is per week (`for_week`) so a weekly need is booked every
-- week; a one-off need reads any `done`. Only the tool's own book says a
-- reminder was SENT — `e_reminded` in p_me, written by the scheduled send.
done_in(R, W)    :- e_done[L](E, R, _), acts(E), edit_week(E, W).
done_ever(R)     :- e_done[L](E, R, _), acts(E).
waived_in(R, W)  :- e_waive[L](E, R), acts(E), edit_week(E, W).
waived_ever(R)   :- e_waive[L](E, R), acts(E).
remind_at(R, T)  :- e_remind[L](E, R, T), acts(E).
sent(R, T)       :- e_reminded[L](E, R, T), acts(E), ledger(L, me).

-- =========================================================================
-- 5b. WHICH WEEK A DATE IS IN
-- =========================================================================
-- `tomorrow` and `show` are asked about a DATE, and a date is in one week:
-- the one whose `week_starts(W, Monday)` is that date's Monday. The loader
-- asserts `date_monday(today|tomorrow, "YYYY-MM-DD")` from SPAT_TZ; which
-- week that is, and whether it exists, is decided here. A day of another
-- week under the heading «завтра» is a wrong answer, so a date whose week
-- the world does not know is refused, and a date in a week other than the
-- one in force is answered under ITS week.

-- for: the week a date falls in
week_of(Which, W) :- date_monday(Which, M), week_starts(W, M).
-- for: a date the world has no week for — «неделя не заведена»
week_known(M)     :- week_starts(_, M).
no_week(Which, M) :- date_monday(Which, M), not week_known(M).
-- for: the week in force is not today's — a warning on every answer, since
--      an edit is recorded for the week in force and the operator rolls
stale_week(C, W)  :- current(C), week_of(today, W), W != C.

-- =========================================================================
-- 6. DOES THE EDIT BREAK THE DAY — asked in a TRIAL world
-- =========================================================================
-- The writer loads the world with the candidate marked `trial(E)`, and with
-- `before(D, R, K)` for every defect the same world had WITHOUT the candidate.
-- An edit breaks a day it touches when that day has a defect it did not
-- have before. Code 3: written as proposed, waiting for confirm.

-- for: the days an entry can change. `day(D, _)` is the guard against a
--      day the world does not know: a hand-typed `funday` touches nothing.
touches_day(E, D) :- e_move[L](E, _, D, _), day(D, _).
touches_day(E, D) :- e_move[L](E, Ev, all, _), usual(_, Ev, _, _, Spec, _, _), applies_on(Spec, D).
touches_day(E, D) :- e_skip[L](E, _, D), day(D, _).
touches_day(E, D) :- e_skip[L](E, Ev, all), usual(_, Ev, _, _, Spec, _, _), applies_on(Spec, D).
touches_day(E, D) :- e_add[L](E, _, D, _, _, _, _), day(D, _).
touches_day(E, D) :- sick_day(E, _, D).
touches_day(E, D) :- e_car_out[L](E, D, _, _), day(D, _).
touches_day(E, D) :- e_usual[L](E, _, Spec, _, _, _, _), applies_on(Spec, D).
touches_day(E, D) :- e_unusual[L](E, Ev, Spec), usual(_, Ev, _, _, Sp, _, _), applies_on(Sp, D), applies_on(Spec, D).
touches_day(E, D) :- e_avail[L](E, _, D, _, _), day(D, _).
touches_day(E, D) :- e_carry[L](E, _, D, _, _), day(D, _).

-- for: the defects of a day, by name and by WHERE — the slot, the block,
--      the run — so a day that already had one red block is not a licence
--      to add a second: only a defect the day did not have before counts
defect(D, uncovered, S)        :- uncovered(_, D, S).
defect(D, no_time, E2)         :- negative_slack(_, D, _, E2).
defect(D, double_booked, E1)   :- overbooked(_, D, E1, _).
defect(D, missed_window, Ev)   :- too_late(_, Ev, D, _, _).
defect(D, missed_window, Ev)   :- too_early(_, Ev, D, _, _).
defect(D, no_way, T)           :- run_stuck(T), run(T, _, _, _, D, _, _).
defect(D, cannot_get_there, F) :- too_slow(_, D, F, _).
defect(D, no_way_on_foot, F)   :- walk_impossible(_, D, F, _).
defect(D, on_foot_unknown, F)  :- walk_unknown(_, D, F, _).
-- for: a defect of the household's own kind (spat.rofl §12): a family rule
--      concludes `defect[hh](Kind, Block, Day)` and an edit that brings one
--      to a day breaks it by that name
defect(D, Kind, B)             :- defect[hh](Kind, B, D).

breaks_on(E, D, R) :- trial(E), touches_day(E, D), defect(D, R, K), not before(D, R, K).
breaks(E, R)       :- breaks_on(E, _, R).
needs_confirm(E)   :- breaks(E, _).

-- =========================================================================
-- 7. DECLARED INPUTS
-- =========================================================================
-- The book relations and the loader's facts, declared so a tenant with empty
-- books loads clean and `undefined_premise[audit]` stays quiet.
edb(tg_user).    edb(tenant).    edb(caller).    edb(from_id).  edb(trial).    edb(before).
edb(date_monday).
edb(e_move).     edb(e_skip).    edb(e_add).     edb(e_sick).   edb(e_car_out).
edb(e_report).   edb(edit_at).   edb(edit_via).  edb(for_week).
edb(e_usual).    edb(e_unusual).
edb(e_avail).    edb(e_carry).   edb(e_note).
edb(e_done).     edb(e_waive).   edb(e_remind).  edb(e_reminded).
edb(proposed).   edb(confirmed). edb(retracted). edb(rolled).   edb(week_starts).
edb(retracts).

-- for: the rules above read books by a VARIABLE name — `e_move[L]` — which
--      the flow audit sees as a crossing from a book it cannot name.
--      `collects(main)` is the declaration that main gathers from the books
--      on purpose; without it every load carries a leak[audit] row.
collects(main).

-- books.rofl — WHAT store.ts ASSERTS when it opens store.example as robin,
-- written down so both engines can be held to access.rofl over the same
-- books (facts/checks.rofl, world `spat_store`). Not read by the tool.
tenant(example).
caller(robin).
from_id(100002).     -- robin called by her sender id; `sender(robin, example)` is the rule's answer
-- she called on Sunday 06.09 evening: today's Monday is w0831's, tomorrow's is w0907's
date_monday(today, "2026-08-31").
date_monday(tomorrow, "2026-09-07").
authority(p_alex, alex).
authority(p_me, me).
authority(p_nanny, nanny).
authority(p_robin, robin).
authority(p_uncle, uncle).
-- the program is signed `rules` (volumes.rofl reads the trail); and where
-- each book was read from — the rules from the repository, the household's
-- books from its volume — for `misplaced[audit]` to hold against
authority(main, rules).
book_source(rules, repo).
book_source(world, store).
book_source(users, store).
book_source(p_alex, store).
book_source(p_me, store).
book_source(p_nanny, store).
book_source(p_robin, store).
book_source(p_uncle, store).

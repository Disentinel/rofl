-- examples/rofl-release/frame.rofl — the release question, asked in the
-- language it is about. NOT synthetic: every claim here is decidable from
-- this tree, and evidence.rofl says by which command.
--
-- The tree carried a production-readiness decision pack and a synthetic
-- fixture for six days while the release question was answered in prose.

inquiry(rofl_1_0, decide).

-- NO LONGER BLOCKING, 2026-09-11, by the decision authority: two names of
-- sixteen -- `strataPlan` and `assertClauses` -- are not what a base version
-- owes a user. THE FRAME IS WHAT CHANGED AND NOT THE JOURNAL: both
-- observations still stand, the claim still reads CONTESTED, and what the
-- authority settled is whether a contested surface stops a release. That is a
-- framing decision and framing is the authority's; the evidence is not.
--
-- The pack has no other lever for this. `accepted_gap_by` reaches an OPEN
-- obligation only, and `go_blocked` has no acceptance path at all -- a
-- contested blocking claim prevents GO, conservatively and on purpose
-- (rules/inquiry/obligations.rofl). So an authority who judges a blocking
-- claim not to be a blocker says so HERE, in the framing, where it is one line
-- and visible, rather than by retiring the evidence against it.
-- NOT AN OBLIGATION OF THIS RELEASE AT ALL, which is where the last edit
-- stopped one step short. Moving it out of `blocking` left it a REQUIREMENT,
-- and a contested requirement bars a conditional go just as surely -- so the
-- authority's judgement that two names of sixteen are not owed had been
-- half-applied. If they are not owed, literal completeness is not something
-- this release requires. THE CLAIM AND BOTH ITS MEASUREMENTS STAY, unsettled
-- and on the record: what changed is that nothing here demands it.
claim(port_surface_complete).
observable(port_surface_complete).

-- BLOCKING: one language, two engines, or it is two languages.
claim(two_engines_agree).
blocking(rofl_1_0, two_engines_agree).
observable(two_engines_agree).

-- The half of `port_surface_complete` that IS done, stated on its own so the
-- journal can carry both answers without either hiding the other.
claim(port_explains).
requires(rofl_1_0, port_explains).
observable(port_explains).

claim(every_duty_has_a_guard).
requires(rofl_1_0, every_duty_has_a_guard).
observable(every_duty_has_a_guard).

claim(every_feature_has_a_world).
requires(rofl_1_0, every_feature_has_a_world).
observable(every_feature_has_a_world).

-- SPLIT, 2026-09-11. The one claim was CONTESTED because both polarities were
-- true of different things, and a claim two measurements can both be right
-- about is a claim asking to be two. The host kernel takes nothing; the port
-- takes crates by construction and that is what a Rust library IS; and what
-- was actually hiding under the disagreement is the PACKAGE, which declares a
-- dependency the kernel never imports and declares no entry point at all.
claim(js_kernel_takes_nothing).
requires(rofl_1_0, js_kernel_takes_nothing).
observable(js_kernel_takes_nothing).

-- MOVED TO THE PUBLICATION DECISION, where it belongs: an engine with no
-- `exports` field does real work every day in this tree.
claim(package_declares_what_it_ships).
requires(rofl_public, package_declares_what_it_ships).
observable(package_declares_what_it_ships).

-- THE ENGINE'S OWN LOAD AXIS, and it is not inapplicable: an engine that
-- cannot hold a realistic corpus has failed at the only thing it does.
claim(holds_a_realistic_corpus).
requires(rofl_1_0, holds_a_realistic_corpus).
observable(holds_a_realistic_corpus).

-- NOR IS MONITORING. A library's form of it is what a caller can read back
-- about a run without instrumenting the engine themselves.
claim(a_run_reports_on_itself).
requires(rofl_1_0, a_run_reports_on_itself).
observable(a_run_reports_on_itself).

-- CUSTOMER ACCEPTANCE IS SIGN-OFF BY WHOEVER ASKED FOR THE THING, and I read
-- it as ADOPTION -- which cannot be a precondition of the decision that would
-- enable it. The asker is the author, and what he accepted it for is running
-- this repository: the axis is answered by USE and not by a user count.
claim(the_asker_runs_the_project_on_it).
requires(rofl_1_0, the_asker_runs_the_project_on_it).
observable(the_asker_runs_the_project_on_it).

-- ======================================================== THE OTHER DECISION
-- Publication is not readiness. Everything between a working engine and a
-- stranger running a world of their own is packaging, licence and prose --
-- none of it inference -- so it gets its own inquiry and its own pack.
inquiry(rofl_public, decide).

-- BLOCKING, and it is the whole dependency between the two decisions: there is
-- no honest way to publish an engine that is not ready.
claim(engine_is_ready).
blocking(rofl_public, engine_is_ready).
observable(engine_is_ready).

claim(installable_and_importable).
blocking(rofl_public, installable_and_importable).
observable(installable_and_importable).

claim(licence_text_ships).
requires(rofl_public, licence_text_ships).
observable(licence_text_ships).

claim(a_newcomer_can_run_a_world_from_the_readme).
requires(rofl_public, a_newcomer_can_run_a_world_from_the_readme).
observable(a_newcomer_can_run_a_world_from_the_readme).

claim(the_version_means_something).
requires(rofl_public, the_version_means_something).
observable(the_version_means_something).

claim(a_defect_has_somewhere_to_go).
requires(rofl_public, a_defect_has_somewhere_to_go).
observable(a_defect_has_somewhere_to_go).

-- ADOPTION LIVES HERE AND IS NOBODY'S OBLIGATION, because it is the CONSEQUENCE
-- of publishing and not a condition on it. It stays a claim so the journal can
-- keep saying `nobody yet`, which is true and is not a gate.
claim(used_by_somebody_other_than_its_author).
observable(used_by_somebody_other_than_its_author).

claim(release_contract_is_current).
requires(rofl_1_0, release_contract_is_current).

-- No evidence either way, and that is the point: `unknown` is not `false`.
claim(docs_derived_from_ledger).
requires(rofl_1_0, docs_derived_from_ledger).

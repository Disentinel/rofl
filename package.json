{
  "name": "rofl",
  "version": "1.0.0",
  "description": "ROFL \u2014 Relation-Oriented Fixpoint Language: a Datalog-family engine with perspectives, explicit time, kernel-emitted provenance and budgets-as-semantics",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": {
      "types": "./dist/src/api.d.ts",
      "default": "./dist/src/api.js"
    },
    "./port": {
      "types": "./dist/runtime/port.d.ts",
      "default": "./dist/runtime/port.js"
    },
    "./boot.rofl": "./boot.rofl",
    "./package.json": "./package.json",
    "./inquiry/*": "./rules/inquiry/*",
    "./policies/*": "./rules/policies/*",
    "./decisions/*": "./rules/decisions/*"
  },
  "types": "./dist/src/api.d.ts",
  "files": [
    "dist/",
    "src/",
    "runtime/port.ts",
    "rules/inquiry/",
    "rules/policies/",
    "rules/decisions/",
    "boot.rofl",
    "policy.rofl",
    "safety.rofl",
    "LICENSE",
    "README.md",
    "LIMITS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Disentinel/rofl.git"
  },
  "homepage": "https://github.com/Disentinel/rofl",
  "bugs": {
    "url": "https://github.com/Disentinel/rofl/issues"
  },
  "scripts": {
    "ablate": "node --experimental-strip-types scanners/ablate.ts",
    "blast": "node --experimental-strip-types scanners/depends.ts --blast",
    "bless": "node --experimental-strip-types scripts/goldens.ts --bless",
    "booklocality": "node --experimental-strip-types scanners/book_locality.ts",
    "boundary": "node --experimental-strip-types scanners/store_boundary.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:dense": "node --experimental-strip-types scripts/build_kernel_dense.ts",
    "build:skill": "node --experimental-strip-types scripts/build_skill.ts",
    "cleanliness": "node --experimental-strip-types scanners/cleanliness_report.ts",
    "dagcheck": "node --experimental-strip-types scanners/bootstrap_dag.ts",
    "depends": "node --experimental-strip-types scanners/depends.ts",
    "docs": "node --experimental-strip-types scripts/render_docs.ts",
    "evalcost": "node --experimental-strip-types scanners/eval_cost.ts",
    "features": "node --experimental-strip-types scanners/features.ts",
    "findings": "node --experimental-strip-types runtime/report.ts facts/findings.rofl",
    "flagcheck": "node --experimental-strip-types scripts/flag_census.ts",
    "floorcensus": "node --experimental-strip-types scanners/floor_census.ts",
    "keycoupling": "node --experimental-strip-types scanners/key_coupling.ts",
    "laddercheck": "node --experimental-strip-types scanners/policy_ladder.ts",
    "layering": "node --experimental-strip-types scanners/layering_report.ts",
    "loop": "ROFL_TESTS=loop NODE_OPTIONS=--expose-gc node --experimental-strip-types --test --test-concurrency=$(node -p \"require('os').availableParallelism()\") --test-reporter=spec $(node --experimental-strip-types scanners/side_files.ts engine)",
    "measurecheck": "node --experimental-strip-types scripts/measurement_check.ts",
    "necessity": "node --experimental-strip-types scanners/necessity.ts",
    "noparser": "node --experimental-strip-types scripts/parser_optional.ts",
    "nullary": "node --experimental-strip-types scanners/nullary_report.ts",
    "pair": "node --experimental-strip-types runtime/pair.ts",
    "parsecost": "node --experimental-strip-types scanners/parse_cost.ts",
    "perminv": "node --experimental-strip-types scanners/permission_inventory.ts",
    "portcorpus": "node --experimental-strip-types scripts/port_corpus.ts",
    "prepack": "npm run build",
    "repl": "node --experimental-strip-types src/repl.ts",
    "report": "node --experimental-strip-types runtime/report.ts",
    "roundbytes": "node --experimental-strip-types scanners/round_bytes.ts",
    "rofllint": "node --experimental-strip-types scanners/rofl_lint.ts && node --experimental-strip-types scanners/rofl_lint_report.ts",
    "ruleshape": "node --experimental-strip-types scanners/rule_shape.ts && node --experimental-strip-types scanners/rule_shape_report.ts",
    "scan": "node --experimental-strip-types scanners/cli.ts",
    "speccheck": "node --experimental-strip-types scanners/spec.ts",
    "splitcheck": "node --experimental-strip-types scanners/engine_split.ts",
    "storetrace": "node --experimental-strip-types scanners/store_trace.ts && node --experimental-strip-types scanners/store_trace.ts --noreuse",
    "test": "node --experimental-strip-types scripts/goldens.ts",
    "test:bun": "bun run scripts/goldens.ts",
    "test:engine": "NODE_OPTIONS=--expose-gc node --experimental-strip-types --test --test-concurrency=$(node -p \"require('os').availableParallelism()\") --test-reporter=spec $(node --experimental-strip-types scanners/side_files.ts engine)",
    "test:hosts": "node --experimental-strip-types scripts/goldens.ts --hosts",
    "test:library": "NODE_OPTIONS=--expose-gc node --experimental-strip-types --test --test-concurrency=$(node -p \"require('os').availableParallelism()\") --test-reporter=spec $(node --experimental-strip-types scanners/side_files.ts library)",
    "test:mutants": "NODE_OPTIONS=--expose-gc node --experimental-strip-types --test --test-concurrency=$(node -p \"require('os').availableParallelism()\") --test-reporter=spec $(node --experimental-strip-types scanners/mutant_files.ts)",
    "textcheck": "node --experimental-strip-types scripts/text_check.ts",
    "whyfloor": "node --experimental-strip-types runtime/report.ts facts/floor-census.rofl rules/floor-census.rofl",
    "whyjoin": "node --experimental-strip-types runtime/report.ts facts/eval-cost.rofl rules/eval-cost.rofl",
    "whyperm": "node --experimental-strip-types runtime/report.ts facts/permission-inventory.rofl rules/permission-model.rofl",
    "whyslow": "node --experimental-strip-types runtime/report.ts facts/parse-cost.rofl rules/parse-cost.rofl"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/plugin-transform-async-to-generator": "^8.0.1",
    "@babel/plugin-transform-regenerator": "^8.0.2",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "main": "./dist/src/api.js"
}

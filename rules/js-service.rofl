-- js-service.rofl — THE SERVICE GRAPH: a request reaches a handler (w_service_graph).
--
-- One join, into `calls` itself, so whatever reads the call graph sees an edge
-- that crosses a process like any other:
--   calls[code](Caller, H)   the function around a request, or the top of its
--                            file, may call the handler H of a route the
--                            request's method and address match (rules/url.rofl)
-- and its frontier both ways:
--   request_unserved(C, U)   a request no route answers (a middleware is not one)
--   request_unknown[flow](C) a client call whose address nothing traces (js-fetch)
--   route_unreached(H)       a handler no request reaches
--
-- Needs rules/url.rofl, rules/js-fetch.rofl, rules/js-express.rofl and the JS
-- model with rules/js-concat.rofl and rules/js-surface.rofl.
imports(main, flow).
imports(main, surface).
imports(code, main).
imports(surface, main).

url_request(U) :- requests[flow](_, _, U).
url_pattern(P) :- serves[surface](_, _, P, _, _).
url_str(V) :- url_term(V), str_value[flow](V).
url_str(V) :- url_term(V), sx_ex_str[surface](V).
url_str("/").
url_str("*").

-- a method fits its own, and `any` fits every one; a GET route answers HEAD
svc_fits(M, M)   :- http_verb_name(_, M).
svc_fits(any, M) :- http_verb_name(_, M).
svc_fits(M, any) :- http_verb_name(_, M).
svc_fits(any, any).
svc_fits(head, get).

svc_call(C, U, H, R) :- requests[flow](C, M, U), url_match(P, U), serves[surface](_, N, P, H, R), svc_fits(M, N).
calls[code](Caller, H) :- svc_call(C, _, H, _), nearest_fn[code](Caller, C).
calls[code](R, H)      :- svc_call(C, _, H, _), top_call[code](C, R).

svc_served(C, U) :- svc_call(C, U, _, route).
request_unserved(C, U) :- requests[flow](C, _, U), not svc_served(C, U).
sx_svc_hit[surface](H) :- svc_call(_, _, H, _).
svc_route(H) :- serves[surface](_, _, _, H, route).
route_unreached(H) :- svc_route(H), not sx_svc_hit[surface](H).

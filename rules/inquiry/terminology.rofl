-- rules/inquiry/terminology.rofl — controlled terminology (roadmap §13).
-- Reversible normalization: mentions map to canonical terms; the original
-- facts are never rewritten, so retracting a mapping restores the world.
--
-- EDB:
--   alias_of(Alias, Canonical)        -- same meaning, different name
--   maps_to(Term, Canonical)          -- direct normalization decision
--   broader_than(A, B) / narrower_than(A, B) / overlaps_with(A, B)
--                                     -- related but NOT mergeable: no rule
--                                     -- below touches them, by design
--   semantic_candidate(A, B, Score)   -- embedding scanner output: a HINT,
--                                     -- never an equivalence (roadmap §20)
--
-- The canonical term must itself be declared `claim(C)` in the frame;
-- aliases need not be.

maps_to(A, C)      :- alias_of(A, C).

-- a chain of mappings ends at a term that maps nowhere; a cycle or a fork is
-- a decision gone wrong, named rather than counted twice
maps_reach(T, C)   :- maps_to(T, C).
maps_reach(T, D)   :- maps_reach(T, C), maps_to(C, D).
canonical(T, C)    :- maps_reach(T, C), not maps_to(C, _).
canonical(C, C)    :- claim(C), not maps_to(C, _).
mapping_cycle[audit](T)   :- maps_reach(T, T).
mapping_fork[audit](T)    :- maps_to(T, A), maps_to(T, B), A != B.

-- normalized obligations: frames may require/block on aliases;
-- everything downstream sees only canonical targets.
requires_on(I, C)  :- requires(I, T), canonical(T, C).
blocks_on(I, C)    :- blocking(I, T), canonical(T, C).

-- an embedding hint produces a reviewable proposal, nothing more.
mapping_proposal(A, B) :- semantic_candidate(A, B, _),
                          A != B,
                          not maps_to(A, _).
alarm(mapping_cycle).
alarm(mapping_fork).

-- js-model.rofl — THE COVERAGE MATRIX: node kind x layer (x shape), and
-- every cell carries a verdict. The one claim this file tests: adding a layer
-- is ONE FACT, and the audit enumerates every cell it needs with no rule edit.
-- Declared as [audit]: a coverage gap is a statement about the model, not
-- about the domain.

-- Three buckets partition the matrix, and a waiver moves a cell between them
-- rather than out of sight: the first version let `ignored` count as covered,
-- and declaring the whole matrix ignored drove the audit to zero.
modelled[audit](Lang, K, L)    :- handled(Lang, K, L, _).
waived[audit](Lang, K, L)      :- ignored(Lang, K, L, _).

unaccounted[audit](Lang, K, L) :- node_kind(Lang, K), layer(L),
                                  not modelled[audit](Lang, K, L),
                                  not waived[audit](Lang, K, L).

double_claimed[audit](Lang, K, L) :- modelled[audit](Lang, K, L),
                                     waived[audit](Lang, K, L).

-- A CLAIM NAMING A CELL THAT DOES NOT EXIST evaporates silently (`handled(js,
-- variable_declarator, …)` for an undeclared kind moved no count). The check
-- was written by hand once per ledger and the fourth ledger reopened it, so
-- the ledger name is an ARGUMENT: `claim(What, …)` is one relation, the
-- vocabulary check is one rule per arity, and `claim_kind` closes the hole the
-- normalisation opens — a misspelt ledger name. Adoption and projection go
-- both ways: the authored facts stay bare, and a claim in the new spelling
-- still ticks.
edb(claim).

edb(claim_kind).
claim_kind(handled).
claim_kind(ignored).
claim_kind(unknown_because).

claim(handled,         Lang, K, L, R) :- handled(Lang, K, L, R).
claim(ignored,         Lang, K, L, R) :- ignored(Lang, K, L, R).
claim(unknown_because, Lang, K, L, R) :- unknown_because(Lang, K, L, R).

handled(Lang, K, L, R)         :- claim(handled, Lang, K, L, R).
ignored(Lang, K, L, R)         :- claim(ignored, Lang, K, L, R).
unknown_because(Lang, K, L, R) :- claim(unknown_because, Lang, K, L, R).

-- `not cell` rather than `not node_kind` and `not layer` apart: the cell is
-- their conjunction.
orphan[audit](What, Lang, K, L) :- claim(What, Lang, K, L, _),
                                   not cell[audit](Lang, K, L).

unknown_ledger[audit](What) :- claim(What, _, _, _, _), not claim_kind(What).

orphan_claim[audit](Lang, K, L)  :- orphan[audit](handled, Lang, K, L).
orphan_claim[audit](Lang, K, L)  :- orphan[audit](ignored, Lang, K, L).

cell[audit](Lang, K, L)        :- node_kind(Lang, K), layer(L).

-- =========================================================================
-- THE LAYER LIST IS THE OWNER'S, as a row. `layer(L)` is one fact and opens
-- 59 cells, so the size of the programme is set by this list and by nothing
-- else. A promise cannot refuse; `layer_unauthorised` can. Five layers, each
-- added by his word, the fifth with the ownership of its cells in one commit.
edb(layer_authorised).
layer_authorised(callgraph).
layer_authorised(dataflow).
layer_authorised(modules).
layer_authorised(controlflow).
layer_authorised(effect).

layer_unauthorised[audit](L) :- layer(L), not layer_authorised(L).

-- Convergence between languages needs EVIDENCE on both sides: `checked` is a
-- cell run against an oracle. The first version compared rule atoms and
-- reported eight agreements between rules that existed nowhere.
edb(checked).

verified[audit](Lang, K, L, Rule)  :- handled(Lang, K, L, Rule),
                                      checked(Lang, K, L, Rule, _, _).

converges[audit](L, Rule, A, B)    :- verified[audit](A, _, L, Rule),
                                      verified[audit](B, _, L, Rule), A != B.

unverified[audit](Lang, K, L, Rule) :- handled(Lang, K, L, Rule),
                                       not checked(Lang, K, L, Rule, _, _).

-- =========================================================================
-- THE DEFAULT VERDICT. Every cell carries one and `not_modelled` is the one it
-- is born with — a positive row `why` can answer, where the absence of an
-- `unaccounted` row could only be approached with `whynot`. The first two arms
-- deliberately carry no `cell` premise: a claim over no cell yields a verdict
-- with no cell under it and the partition stops summing — a second, independent
-- detector for what `orphan_claim` reports.
verdict[audit](Lang, K, L, modelled)     :- handled(Lang, K, L, _).
verdict[audit](Lang, K, L, waived)       :- ignored(Lang, K, L, _).
verdict[audit](Lang, K, L, not_modelled) :- cell[audit](Lang, K, L),
                                            not handled(Lang, K, L, _),
                                            not ignored(Lang, K, L, _).

-- THE TYPE OF THE UNKNOWN turns a count into a queue. `runtime_dependent` and
-- `no_source_target` (a synthesised constructor with no node to point at) are
-- the subject's; `not_yet`, `budget_exhausted`, `out_of_scope` are ours. A
-- not_modelled cell nobody explained is `not_yet`. `bad_reason` is a word in no
-- taxonomy — it also falls out of both counts, so the test asserts the sum.
-- `stale_reason` is an excuse that outlived its cause, and demands the cell
-- EXIST so an unknown kind is not laundered into "fixed".
edb(unknown_type).
unknown_type(runtime_dependent, irreducible).
unknown_type(no_source_target,  irreducible).
unknown_type(not_yet,           ours).
unknown_type(budget_exhausted,  ours).
unknown_type(out_of_scope,      ours).

edb(unknown_because).

reason[audit](Lang, K, L, R)       :- verdict[audit](Lang, K, L, not_modelled),
                                      unknown_because(Lang, K, L, R).
reason[audit](Lang, K, L, not_yet) :- verdict[audit](Lang, K, L, not_modelled),
                                      not unknown_because(Lang, K, L, _).

irreducible_unknown[audit](Lang, K, L) :- reason[audit](Lang, K, L, R),
                                          unknown_type(R, irreducible).
our_unknown[audit](Lang, K, L)         :- reason[audit](Lang, K, L, R),
                                          unknown_type(R, ours).

bad_reason[audit](Lang, K, L, R)   :- unknown_because(Lang, K, L, R),
                                      not unknown_type(R, _).

stale_reason[audit](Lang, K, L, R) :- unknown_because(Lang, K, L, R),
                                      cell[audit](Lang, K, L),
                                      not verdict[audit](Lang, K, L, not_modelled).

orphan_reason[audit](Lang, K, L) :- orphan[audit](unknown_because, Lang, K, L).

-- =========================================================================
-- THE THIRD AXIS — SHAPE. `member_expression` is one kind and six jobs, and
-- six of eleven missed edges sat inside one ticked cell, where a table keyed
-- by kind is silent by construction. An axis is a COLUMN here, so adding one
-- is a rule edit; what is a fact is which values it takes (`shape_of`), which
-- layers it applies to (`axis_applies`) and that it exists (`axis`).
-- Applicability is declared, not assumed — a callee shape says nothing about
-- a module graph — and `unearned_axis` says when a declaration was wrong.
-- `shape_in` gives each layer its own value vocabulary, so a specifier shape
-- mints no phantom call-graph cell.
edb(axis).
edb(axis_applies).
edb(shape_of).
edb(shape_in).

-- A kind with no declared shape is ATOMIC and keeps one cell. `none` is earned
-- two ways — the axis absent from the layer, or present with a kind that does
-- not split — as two rules, so the second stays removable.
shape_kind[audit](Lang, K, Lay) :- shape_of(Lang, K, S), shape_in(S, Lay).

cell[audit](Lang, K, none, Lay)  :- node_kind(Lang, K), layer(Lay),
                                    not axis_applies(shape, Lay).
cell[audit](Lang, K, none, Lay)  :- node_kind(Lang, K), layer(Lay),
                                    axis_applies(shape, Lay),
                                    not shape_kind[audit](Lang, K, Lay).
cell[audit](Lang, K, Shape, Lay) :- shape_of(Lang, K, Shape), shape_in(Shape, Lay),
                                    axis_applies(shape, Lay).

-- the refinement partitions the coarse matrix, checked both ways (`lost_cell`,
-- `invented_cell`), and a cell is never both refined and unrefined
coarse_of[audit](Lang, K, Lay)     :- cell[audit](Lang, K, _, Lay).
lost_cell[audit](Lang, K, Lay)     :- cell[audit](Lang, K, Lay),
                                      not coarse_of[audit](Lang, K, Lay).
invented_cell[audit](Lang, K, Lay) :- coarse_of[audit](Lang, K, Lay),
                                      not cell[audit](Lang, K, Lay).

refined_cell[audit](Lang, K, Lay) :- cell[audit](Lang, K, S, Lay), S != none.
double_cell[audit](Lang, K, Lay)  :- cell[audit](Lang, K, none, Lay),
                                     refined_cell[audit](Lang, K, Lay).

orphan_shape[audit](Lang, K, S) :- shape_of(Lang, K, S), not node_kind(Lang, K).
orphan_axis[audit](A, Lay)      :- axis_applies(A, Lay), not axis(A).
orphan_axis[audit](A, Lay)      :- axis_applies(A, Lay), not layer(Lay).

-- =========================================================================
-- THE CLAIM LEDGER AT SHAPE GRANULARITY. A kind-level claim answers only for an
-- UNREFINED cell: `handled(js, member_expression, callgraph, …)` ticks nothing
-- once the cell is split and is reported by `coarser_claim` rather than
-- deleted or honoured. The rest is the coarse machinery at one more argument;
-- the check is generic over the LEDGER and not the arity, so a fourth axis
-- needs `claim/7` and one more copy.
shaped_handled[audit](Lang, K, S, Lay, R)    :- handled(Lang, K, S, Lay, R).
shaped_handled[audit](Lang, K, none, Lay, R) :- handled(Lang, K, Lay, R),
                                                cell[audit](Lang, K, none, Lay).
shaped_ignored[audit](Lang, K, S, Lay, R)    :- ignored(Lang, K, S, Lay, R).
shaped_ignored[audit](Lang, K, none, Lay, R) :- ignored(Lang, K, Lay, R),
                                                cell[audit](Lang, K, none, Lay).
shaped_because[audit](Lang, K, S, Lay, R)    :- unknown_because(Lang, K, S, Lay, R).
shaped_because[audit](Lang, K, none, Lay, R) :- unknown_because(Lang, K, Lay, R),
                                                cell[audit](Lang, K, none, Lay).

coarser_claim[audit](Lang, K, Lay, R) :- handled(Lang, K, Lay, R),
                                         shape_kind[audit](Lang, K, Lay),
                                         axis_applies(shape, Lay).
coarser_claim[audit](Lang, K, Lay, R) :- ignored(Lang, K, Lay, R),
                                         shape_kind[audit](Lang, K, Lay),
                                         axis_applies(shape, Lay).

verdict[audit](Lang, K, S, Lay, modelled)     :- shaped_handled[audit](Lang, K, S, Lay, _).
verdict[audit](Lang, K, S, Lay, waived)       :- shaped_ignored[audit](Lang, K, S, Lay, _).
verdict[audit](Lang, K, S, Lay, not_modelled) :- cell[audit](Lang, K, S, Lay),
                                                 not shaped_handled[audit](Lang, K, S, Lay, _),
                                                 not shaped_ignored[audit](Lang, K, S, Lay, _).

double_claimed[audit](Lang, K, S, Lay) :- verdict[audit](Lang, K, S, Lay, modelled),
                                          verdict[audit](Lang, K, S, Lay, waived).

claim(handled,         Lang, K, S, Lay, R) :- handled(Lang, K, S, Lay, R).
claim(ignored,         Lang, K, S, Lay, R) :- ignored(Lang, K, S, Lay, R).
claim(unknown_because, Lang, K, S, Lay, R) :- unknown_because(Lang, K, S, Lay, R).

handled(Lang, K, S, Lay, R)         :- claim(handled, Lang, K, S, Lay, R).
ignored(Lang, K, S, Lay, R)         :- claim(ignored, Lang, K, S, Lay, R).
unknown_because(Lang, K, S, Lay, R) :- claim(unknown_because, Lang, K, S, Lay, R).

orphan[audit](What, Lang, K, S, Lay) :- claim(What, Lang, K, S, Lay, _),
                                        not cell[audit](Lang, K, S, Lay).

unknown_ledger[audit](What) :- claim(What, _, _, _, _, _), not claim_kind(What).

orphan_claim[audit](Lang, K, S, Lay)  :- orphan[audit](handled, Lang, K, S, Lay).
orphan_claim[audit](Lang, K, S, Lay)  :- orphan[audit](ignored, Lang, K, S, Lay).
orphan_reason[audit](Lang, K, S, Lay) :- orphan[audit](unknown_because, Lang, K, S, Lay).

reason[audit](Lang, K, S, Lay, R)       :- verdict[audit](Lang, K, S, Lay, not_modelled),
                                           shaped_because[audit](Lang, K, S, Lay, R).
reason[audit](Lang, K, S, Lay, not_yet) :- verdict[audit](Lang, K, S, Lay, not_modelled),
                                           not shaped_because[audit](Lang, K, S, Lay, _).

bad_reason[audit](Lang, K, S, Lay, R) :- unknown_because(Lang, K, S, Lay, R),
                                         not unknown_type(R, _).
irreducible_unknown[audit](Lang, K, S, Lay) :- reason[audit](Lang, K, S, Lay, R),
                                               unknown_type(R, irreducible).
our_unknown[audit](Lang, K, S, Lay)         :- reason[audit](Lang, K, S, Lay, R),
                                               unknown_type(R, ours).

-- =========================================================================
-- AN AXIS EARNS A LAYER when it makes the model say something different about
-- two shapes of the SAME kind there — a different verdict or reason.
-- Otherwise it multiplied the table and answered nothing.
refined_verdict[audit](Lang, K, Lay, V) :- verdict[audit](Lang, K, S, Lay, V), S != none.
refined_reason[audit](Lang, K, Lay, R)  :- reason[audit](Lang, K, S, Lay, R), S != none.

axis_earns[audit](A, Lay)    :- axis(A),
                                refined_verdict[audit](Lang, K, Lay, V),
                                refined_verdict[audit](Lang, K, Lay, W), V != W.
axis_earns[audit](A, Lay)    :- axis(A),
                                refined_reason[audit](Lang, K, Lay, R1),
                                refined_reason[audit](Lang, K, Lay, R2), R1 != R2.
unearned_axis[audit](A, Lay) :- axis_applies(A, Lay), not axis_earns[audit](A, Lay).

-- [code] reads the kind and shape tables in [main]; [audit] reads the
-- scanner's book.
imports(code, main).

-- =========================================================================
-- THE FRAME ITSELF. A kind nobody declared is outside the matrix, not a hole
-- in it — measured: thirty of fifty-one kinds in one probe were undeclared
-- while every audit sat at zero. `vocabulary_gap` grows with the corpus, and
-- a kind it names is declared or excluded with a reason: `not_a_construct`
-- (the scanner's own roots and trivia) or `frame_deferred` with an owner.
-- Both exclusion lists are guarded against a misspelling. `ast_node` is edb
-- here because this file loads in worlds with no corpus at all.
edb(ast_node).
edb(lang_of_corpus).
lang_of_corpus(js).

edb(not_a_construct).

edb(frame_deferred).

vocabulary_gap[audit](Lang, K) :- ast_node[code](_, K, _, _),
                                  lang_of_corpus(Lang), not node_kind(Lang, K),
                                  not not_a_construct(K), not frame_deferred(K, _).

not_a_construct_unseen[audit](K) :- not_a_construct(K), not ast_node[code](_, K, _, _).
frame_deferred_unseen[audit](K)  :- frame_deferred(K, _), not ast_node[code](_, K, _, _).
double_excluded[audit](K)        :- not_a_construct(K), frame_deferred(K, _).
declared_and_excluded[audit](K)  :- node_kind(_, K), not_a_construct(K).
declared_and_deferred[audit](K)  :- node_kind(_, K), frame_deferred(K, _).

edb(kind_absent_ok).

-- `kind_unexercised`: a declared kind no node in the corpus has — allowed, but
-- the reason must be written (`kind_absent_ok`), which is what exposed
-- `ts_string_keyword` as a spelling the scanner cannot produce. Guarded by
-- `scanned`, a proposition: the first draft used `lang_of_corpus(Lang)`, a
-- constant that guarded nothing. A `kind_absent_ok` row belongs in the pack
-- that declares its kind.
corpus_scanned[audit]() :- ast_node[code](_, _, _, _).
scanned[audit](Lang)    :- lang_of_corpus(Lang), corpus_scanned[audit]().

kind_unexercised[audit](Lang, K) :- node_kind(Lang, K), scanned[audit](Lang),
                                    not ast_node[code](_, K, _, _),
                                    not kind_absent_ok(K, _).
kind_absent_stale[audit](K) :- kind_absent_ok(K, _), ast_node[code](_, K, _, _).
kind_absent_undeclared[audit](K) :- kind_absent_ok(K, _), not node_kind(_, K).

imports(audit, code).

-- rules/rule-shape.rofl — WHAT A BODY ASKS THE STORE FOR. Two questions over
-- the facts of scanners/rule_shape.ts: can this book stay on disk
-- (negations), and does this body pay a cross product (positive premises).
-- The scanner emits positions and counts; the criterion is here.
--
-- A negation asserts an absence, and docs/medium-and-large.md concluded a
-- book may move only when nothing is negated under it. Right for a REMOTE
-- book, too strong for a COLD LOCAL one: `planBody` admits a negative premise
-- only when every variable of it is bound or existential to the literal, so a
-- negation is a question about a KEY. `not p(a, b)` asks about one fact,
-- `not p(a, Z)` about a prefix, and neither needs `p` resident. Only
-- `not p(Z)`, "is p empty", needs the whole relation — that is `neg_unkeyed`,
-- and counting it is the point of this file.

-- =========================================================================
-- THE SHAPE. A POINT query when every argument is ground, a PREFIX query when
-- some are, a SCAN when none.
neg_point(S)      :- neg_nbound(S, N), neg_arity(S, N).
neg_keyed(S)      :- neg_bound(S, _).
neg_unkeyed(S)    :- neg_site(S, _, _, _, _), not neg_keyed(S).
neg_prefix(S)     :- neg_keyed(S), not neg_point(S).

-- A byte-ordered store answers a LEFT-CONTIGUOUS prefix as a range scan and
-- anything else as a filter; the store here indexes by an arbitrary binding
-- mask, so this decides only whether LMDB could hold a cold book without an
-- extra index. Reported, not required.
neg_contiguous(S) :- neg_left_run(S, K), neg_nbound(S, K), neg_keyed(S).
neg_scattered(S)  :- neg_keyed(S), not neg_contiguous(S).

-- =========================================================================
-- THE BLOCKERS. A negation whose book is a VARIABLE ranges over every book,
-- so none can be absent while it runs; counted apart from the scan because
-- the repair differs: a scan wants the rule rewritten, a book variable wants
-- the rule to name its book.
neg_book_free(S)  :- neg_persp_var(S).

pins_everything(S) :- neg_unkeyed(S).
pins_everything(S) :- neg_book_free(S).

cold_ok_shape(S)  :- neg_site(S, _, _, _, _), not pins_everything(S).

-- =========================================================================
-- DERIVED VERSUS BASE. `not p(a, b)` asks whether the fact is DERIVABLE, so
-- a keyed lookup settles it only when `p` in that book is base — scanned,
-- asserted, never concluded. That is the owner's shape: 690 of 700 services
-- belong to other teams, their facts are a scanner's output, he reads them
-- and they do not read him.
concl_into(Rel, B)      :- concl(_, Rel, B, _, _).
neg_rel(Rel, B)         :- neg_site(_, _, Rel, B, _).
neg_rel_base(Rel, B)    :- neg_rel(Rel, B), not concl_into(Rel, B).
neg_rel_derived(Rel, B) :- neg_rel(Rel, B), concl_into(Rel, B).

-- negated in one book and concluded into it from another FILE: the middle a
-- residency policy would have to reason about rather than answer statically
neg_rel_written_by(Rel, B, File) :- neg_rel(Rel, B), concl(_, Rel, B, _, File).

-- =========================================================================
-- THE VERDICT per site: keyed shape, named book, base relation. Everything
-- else is named by which of the three it fails.
cold_safe(S)      :- neg_site(S, _, Rel, B, _), cold_ok_shape(S), neg_rel_base(Rel, B).
needs_rules(S)    :- neg_site(S, _, Rel, B, _), cold_ok_shape(S), neg_rel_derived(Rel, B).

-- =========================================================================
-- THE SAME, BY GROUP. The join is here and not in the renderer: `Rofl.query`
-- takes one literal and a conjunction comes back ok with zero rows. `kernel`
-- is the program the evaluator runs on itself, `examples` are demonstrations
-- of reasoning and derived on purpose, `rules/` is the analysis pack.
g_point(G, S)    :- neg_site(S, _, _, _, G), neg_point(S).
g_prefix(G, S)   :- neg_site(S, _, _, _, G), neg_prefix(S).
g_scan(G, S)     :- neg_site(S, _, _, _, G), neg_unkeyed(S).
g_bookvar(G, S)  :- neg_site(S, _, _, _, G), neg_book_free(S).
g_base(G, S)     :- neg_site(S, _, _, _, G), cold_safe(S).
g_derived(G, S)  :- neg_site(S, _, _, _, G), needs_rules(S).
g_site(G, S)     :- neg_site(S, _, _, _, G).

-- =========================================================================
-- WHEN "DERIVED" IS NOT A BLOCKER. A book whose own rules derive its own
-- relations from its own facts can be evaluated once and left cold; what
-- breaks that is a rule writing into the book while READING somewhere else.
-- `[$kernel]` is not somewhere else: it is present wherever the kernel is
-- and can never be cold. The book names arrive from the scanner as STRINGS,
-- so the exemption is `"$kernel"` and not the atom — written the wrong way
-- once, `!=` between an atom and a string is true and the rule silently
-- became more permissive.
rule_leaves(R, B)       :- concl(R, _, B, _, _), reads(R, _, B2), B2 != B, B2 != "$kernel".
rule_self_contained(R, B) :- concl(R, _, B, _, _), not rule_leaves(R, B).

-- cacheable cold when EVERY concluding rule stays inside the book, so the
-- negative is the one derived
rel_has_leaver(Rel, B)  :- neg_rel(Rel, B), concl(R, Rel, B, _, _), rule_leaves(R, B).
neg_rel_cacheable(Rel, B) :- neg_rel_derived(Rel, B), not rel_has_leaver(Rel, B).
neg_rel_hot(Rel, B)     :- neg_rel_derived(Rel, B), rel_has_leaver(Rel, B).

-- the three-way verdict per relation, which is what a residency policy reads
cold_lookup(Rel, B)     :- neg_rel_base(Rel, B).
cold_cached(Rel, B)     :- neg_rel_cacheable(Rel, B).
must_be_hot(Rel, B)     :- neg_rel_hot(Rel, B).

neg_rel_g(Rel, B, G) :- neg_site(_, _, Rel, B, G).
g_lookup(G, Rel, B)  :- neg_rel_g(Rel, B, G), cold_lookup(Rel, B).
g_cached(G, Rel, B)  :- neg_rel_g(Rel, B, G), cold_cached(Rel, B).
g_hot(G, Rel, B)     :- neg_rel_g(Rel, B, G), must_be_hot(Rel, B).

-- =========================================================================
-- THE JOIN SIDE. A cross product is a property of the WRITTEN order and the
-- engine will not rescue it: `planBody` moves only negations, because a
-- positive premise's position is a choice the author already has (examples/yak
-- fragment 09 means two different things depending on it). The signature: a
-- positive premise, not the first, naming a variable and sharing none with
-- anything bound before it.
cross_product(S)   :- pos_site(S, _, _, _, _), pos_nvars(S, N), N > 0,
                      not pos_first(S), not pos_shares(S).

-- a premise naming no variable is a lookup, never a product; counted apart
pos_ground(S)      :- pos_nvars(S, 0).
pos_joined(S)      :- pos_shares(S).

-- the rule, not the site, is what a reader repairs
rule_cross(R)      :- pos_site(S, R, _, _, _), cross_product(S).
rule_cross_at(R, Rel) :- pos_site(S, R, Rel, _, _), cross_product(S).
g_cross(G, S)      :- pos_site(S, _, _, _, G), cross_product(S).
g_pos(G, S)        :- pos_site(S, _, _, _, G).

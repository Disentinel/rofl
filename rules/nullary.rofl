-- rules/nullary.rofl — WHICH RULES ARE PROPOSITIONS WEARING A SUBJECT?
-- Derived entirely from the public reflection: `conclusion_lit` and
-- `premise_lit` are reserved but readable, the reified shape is
-- `$lit(Rel, Persp, Args, Tense)` with `Args` a `$cons`/`$nil` list and a
-- variable as `$var("Name")`, and K is 1-based. Not from `premise_var` or
-- `slot_arity`: those are seeded by the host into the kernel's private store
-- for safety.rofl and are EMPTY in an ordinary store, so a model over them
-- returns a clean-looking zero.
--
-- A nullary relation is a PROPOSITION: exactly one 0-tuple, so the extension
-- is empty or the singleton. A rule concluding a proposition must dress it in
-- an argument; this file finds the dresses.

-- =========================================================================
-- WALKING AN ARGUMENT LIST — range-restricted at every step; the tail is
-- bound by the match that produced it.
head_args(R, Args)  :- conclusion_lit(R, 1, $lit(_, _, Args, _)).
body_args(R, K, Args) :- premise_lit(R, K, $lit(_, _, Args, _)).

head_cell(R, L)     :- head_args(R, L).
head_cell(R, T)     :- head_cell(R, $cons(_, T)).
head_var(R, V)      :- head_cell(R, $cons($var(V), _)).

body_cell(R, K, L)  :- body_args(R, K, L).
body_cell(R, K, T)  :- body_cell(R, K, $cons(_, T)).
body_var(R, K, V)   :- body_cell(R, K, $cons($var(V), _)).

-- THE PERSPECTIVE IS A SLOT TOO: a variable standing in it is bound by the
-- premise and joins premises exactly as an argument does
-- (`mechanism_seen[audit](M) :- env_ran(E), resolve_via[E](_, M, _).`).
persp_var(R, K, V)  :- premise_lit(R, K, $lit(_, $var(V), _, _)).
body_var(R, K, V)   :- persp_var(R, K, V).
head_var(R, V)      :- conclusion_lit(R, 1, $lit(_, $var(V), _, _)).

-- A NEGATED PREMISE BINDS NOTHING AND CONNECTS EVERYTHING. Binding is
-- positive only (`body_var`), which is what binding means; `mentions` is
-- both, because sharing a variable with a negated premise is still sharing —
-- two positive premises joined THROUGH a `not` are not a cross product.
neg_args(R, K, Args) :- premise_lit(R, K, $not($lit(_, _, Args, _))).
neg_cell(R, K, L)    :- neg_args(R, K, L).
neg_cell(R, K, T)    :- neg_cell(R, K, $cons(_, T)).
neg_var(R, K, V)     :- neg_cell(R, K, $cons($var(V), _)).
neg_var(R, K, V)     :- premise_lit(R, K, $not($lit(_, $var(V), _, _))).

-- A BUILTIN JOINS AND NEVER CARRIES. A comparison binds nothing, so it can
-- never be a sole binder or be `disconnected` itself; it can only put two
-- premises in touch. Hence two relations with different consumers:
--   mentions   positive and negated premises — what the rule is ABOUT, and
--              what `multi_premise` counts
--   joins      those plus builtin operands — what makes two premises touch
-- Counting builtins as premises made a one-premise rule with two builtins
-- look joinable, and the nesting limit (the walk sees the `$cons` spine only,
-- never the variable inside `str_pre(...)`) then compounds into a missed
-- join. As joins only, a missed mention can at most over-report a
-- disconnection.
bi_args(R, K, Args)  :- premise_lit(R, K, $builtin(_, Args)).
bi_cell(R, K, L)     :- bi_args(R, K, L).
bi_cell(R, K, T)     :- bi_cell(R, K, $cons(_, T)).
bi_var(R, K, V)      :- bi_cell(R, K, $cons($var(V), _)).

mentions(R, K, V)    :- body_var(R, K, V).
mentions(R, K, V)    :- neg_var(R, K, V).

joins(R, K, V)       :- mentions(R, K, V).
joins(R, K, V)       :- bi_var(R, K, V).

-- =========================================================================
-- SHAPE 1: A CONSTANT SUBJECT. The head has no variables, has at least one
-- argument (`$cons(_, _)`: a head already nullary is the destination, not a
-- candidate), and the argument carries no information.
--
-- A variable nested inside a head term is invisible to a walk over the
-- `$cons` spine, and there is no generic term destructor. So the functor is
-- NAMED, as safety.rofl names `$lit`, `$not` and `$builtin`: `$fact` is the
-- kernel's own reified fact (`forged[audit]($fact(R, P, A))` read as a
-- constant head before this). A USER functor in a head is still invisible
-- and cannot be derived; the scanner counts that blind spot textually and
-- prints it beside the verdict.
head_var(R, V)      :- head_cell(R, $cons($fact($var(V), _, _), _)).
head_var(R, V)      :- head_cell(R, $cons($fact(_, $var(V), _), _)).
head_var(R, V)      :- head_cell(R, $cons($fact(_, _, $var(V)), _)).

const_head(R)       :- head_args(R, $cons(_, _)), not head_var(R, _).
varying_head(Rel)   :- concludes(R, Rel), head_var(R, _).

-- The argument carries information when the relation takes MORE THAN ONE
-- shape: any rule with a variable head, or two constant heads that differ
-- (`slow_because(fixpoint, barren_rules)` beside `slow_because(fixpoint,
-- late_filter)` — a proposition has ONE row).
multi_shape(Rel)    :- concludes(P, Rel), head_args(P, A),
                       concludes(Q, Rel), head_args(Q, B), A != B.

-- and a consumer that binds the argument is reading it: `saves_nothing(
-- reuse_plan)` carries `reuse_plan` out through `pure_overhead(P)`. A dummy
-- argument is one nothing ever binds.
read_as_var(Rel)    :- premise_lit(R, K, $lit(Rel, _, _, _)), body_var(R, K, _).
read_as_var(Rel)    :- premise_lit(R, K, $not($lit(Rel, _, _, _))), neg_var(R, K, _).

dressed_constant[audit](Rel) :- const_head(R), concludes(R, Rel),
                                not varying_head(Rel), not multi_shape(Rel),
                                not read_as_var(Rel).

-- =========================================================================
-- SHAPE 2: A PASSENGER SUBJECT. The head carries a variable the body binds
-- only so there is something to name: `p(W) :- takeable(W), unblocks(_).` —
-- `takeable(W)` is W's only binder and shares nothing with the rest. This is
-- the cross product rules/rule-shape.rofl reports, seen from the head: a disconnected
-- sole binder is a head that wanted to be nullary.
occurs_in(R, V, K)  :- body_var(R, K, V).
elsewhere(R, V, K)  :- occurs_in(R, V, J), occurs_in(R, V, K), J != K.
sole_binder(R, V, K) :- head_var(R, V), occurs_in(R, V, K), not elsewhere(R, V, K).

shares(R, K, J)     :- joins(R, K, V), joins(R, J, V), K != J.
connected(R, K)     :- shares(R, K, _).
disconnected(R, K)  :- body_var(R, K, _), not connected(R, K).

-- a one-premise body is always `disconnected` and is not a passenger: it has
-- nothing to stand apart from (28 rows of noise on the first run, every
-- recursive walk in this file among them)
multi_premise(R)       :- mentions(R, K, _), mentions(R, J, _), K != J.

-- and a body every premise of which feeds the head is a product on purpose:
-- `cell[audit](Lang, K, L) :- node_kind(Lang, K), layer(L).` is the JS
-- matrix. A passenger needs a POSITIVE premise that puts nothing into the
-- head — an existential guard like `unblocks(_)`. Positive only: a negated
-- premise can never feed the head, so counting it would make `p(X) :- q(X),
-- not r(_).` a passenger rule.
feeds_head(R, K)       :- body_var(R, K, V), head_var(R, V).
guard_premise(R, K)    :- body_args(R, K, _), not feeds_head(R, K).
has_guard(R)           :- guard_premise(R, _).

passenger[audit](R, V) :- sole_binder(R, V, K), disconnected(R, K),
                          multi_premise(R), has_guard(R).

-- =========================================================================
-- THE VERDICT. One passenger is not a nullary head: a head with two variables
-- of which one is a passenger is a head with one variable. Drop the head only
-- when EVERY variable in it is droppable — which is also the cheapest guard
-- against the nesting limit below: a false passenger has to be the rule's
-- only head variable to reach the verdict.
head_has_stayer(R)  :- head_var(R, V), not passenger[audit](R, V).
all_passengers(R)   :- passenger[audit](R, _), not head_has_stayer(R).

wants_nullary[audit](Rel) :- dressed_constant[audit](Rel).
wants_nullary[audit](Rel) :- all_passengers(R), concludes(R, Rel).

-- WHAT THIS CANNOT SEE:
--   * a head variable bound by a premise that is connected only incidentally
--     (`p(X) :- q(X, Y), r(Y).`): whether anything downstream reads X is a
--     fact about the callers;
--   * whether the proposition should exist at all, or the rule be inlined
--     into its one caller — the row is where somebody decides;
--   * a variable inside an arithmetic operand: `P is T * 100 / A` reifies its
--     right operand as a compound and the walk sees the spine only, so `T`
--     never appears. The string destructors could be named the way `$fact`
--     is; an operator functor cannot (`*(A, B)` is refused by the parser), and
--     a hole closed for seven cases and open for arithmetic would read as
--     closed. The cost is bounded to a false `passenger` row;
--   * a variable inside a user functor in a head, counted by the scanner
--     rather than derived.

-- untyped.rofl — A VARIABLE NOTHING IN ITS RULE TYPES, as a query over the
-- reflection (`rofl-render --facts`) and the sentence vocabulary.
--
-- A letter is not the smell; a letter that pretends to be a type is. `F` reads
-- as a function to whoever wrote it, and the rule says so only when a guard
-- names F (`ast_node(F, K, _, _)`, `fn_node(F)`) or a signature types the
-- position F stands in. A variable with neither is typed in the author's head
-- and nowhere else, and the renderer shows it as the bare letter it is.
--
-- `signed(Rel, Arity, I, Noun)` is computed by scripts/untyped.ts from the signatures
-- and phrases; `noun_guard` comes from facts/js-phrases.rofl.

edb(signed). edb(signed_rel). edb(nargs). edb(arity). edb(noun_guard). edb(head). edb(lit). edb(argv).

-- one letter, or a letter and a digit (K1)
letter(R, V) :- argv(R, _, _, V), L is str_len(V), L = 1.
letter(R, V) :- argv(R, _, _, V), L is str_len(V), L = 2, C is str_char(V, 1), C >= 48, C <= 57.

-- typed by a guard: the subject of a kind guard or of a relation a noun is bound to
guarded(R, V) :- lit(R, K, ast_node, pos), argv(R, K, 0, V).
guarded(R, V) :- noun_guard(Rel, _), lit(R, K, Rel, pos), argv(R, K, 0, V).

-- typed by a signature: the position says what stands in it, `node` counting as the weakest word
signed_here(R, V, N) :- lit(R, K, Rel, _), nargs(R, K, A), argv(R, K, I, V), signed(Rel, A, I, N).
signed_here(R, V, N) :- head(R, Rel), nargs(R, 0, A), argv(R, 0, I, V), signed(Rel, A, I, N).
signed_strongly(R, V) :- signed_here(R, V, N), N != "node".
signed_weakly(R, V)   :- signed_here(R, V, _), not signed_strongly(R, V).

untyped(R, V)      :- letter(R, V), not guarded(R, V), not signed_here(R, V, _).
only_a_node(R, V)  :- letter(R, V), not guarded(R, V), signed_weakly(R, V).
untyped_long(R, V) :- argv(R, _, _, V), not letter(R, V), not guarded(R, V), not signed_here(R, V, _).

-- by the relation the rule concludes
untyped_in(Rel, R, V) :- untyped(R, V), head(R, Rel).

-- the two kinds of finding: some relation the rule reads or concludes has no signature (a debt of
-- the vocabulary), or every one has and the variable is still untyped (the rule's own)
guard_rel(ast_node).
guard_rel(Rel)   :- noun_guard(Rel, _).
unsigned_in(R)   :- head(R, Rel), nargs(R, 0, A), not signed_rel(Rel, A).
unsigned_in(R)   :- lit(R, K, Rel, _), nargs(R, K, A), not signed_rel(Rel, A), not guard_rel(Rel).
unsigned_arity(Rel, A) :- arity(Rel, A), signed_rel(Rel, _), not signed_rel(Rel, A).
untyped_own(Rel, R, V)  :- untyped_in(Rel, R, V), not unsigned_in(R).
untyped_debt(Rel, R, V) :- untyped_in(Rel, R, V), unsigned_in(R).

-- one letter, many types: the nouns a letter is signed as across the model
letter_means(V, N) :- letter(R, V), signed_here(R, V, N).

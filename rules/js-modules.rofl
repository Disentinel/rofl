-- js-modules.rofl — THE FILE IMPORT, at the module-graph layer.
--
-- Three relations and never one `imports` edge: DEPENDS is potential (if B
-- changes, A might break), FLOWS is actual (a value travels), EVALUATES means
-- the module body runs. A type-only import is a DEPENDS with nothing flowing,
-- and erasure has TWO markers, neither implying the other:
--   import type { e } from './d'   declaration "type", specifier "value"
--   import { type c } from './d'   declaration "value", specifier "type"
-- so a rule reading one marker is wrong about one form.
--
-- Resolution is a path walk over the disk, which no AST can see: the host
-- emits the specifier cut into segments and the file tree as facts, blind.
-- Which directory to start in, when to walk up and what counts as arriving is
-- a join, and it is here.

-- from outside the AST (facts/js-modules.rofl): str_seg(S, K, Seg) cut on "/",
-- str_segs(S, N), str_char0(S, C), str_scheme(S, Scheme) before the first
-- ":"; fs_file, fs_dir, fs_parent, fs_file_in(Dir, Name, Path),
-- fs_dir_in(Dir, Name, Child), fs_dir_of(File, Dir); node_builtin_bare(Bare,
-- Canonical); shape_verdict(Shape, Reason); unknown_because.
edb(str_seg).           -- str_seg[code](S, K, Segment)   S cut on "/", 0-based
edb(str_segs).
edb(str_char0).
edb(str_scheme).        -- str_scheme[code](S, Scheme)    text before the first ":"
edb(fs_file).
edb(fs_dir).
edb(fs_parent).
edb(fs_file_in).
edb(fs_dir_in).
edb(fs_dir_of).
edb(node_builtin_bare). -- node_builtin_bare(Bare, Canonical)  "fs" -> "node:fs"
edb(shape_verdict).
edb(unknown_because).

-- =========================================================================
-- 1. THE PLACES A MODULE SPECIFIER OCCURS — four kinds. A re-export is a site
-- because it has a `source`, not because of its kind: `export { a as b }` and
-- `export { a as b } from './d'` are one kind. `import_site` keeps its meaning
-- (section 4 binds LOCAL names and a re-export introduces none); `module_site`
-- is the union every later rule reads.
import_site[code](I, static_import)  :- ast_node[code](I, import_declaration, _, _).
import_site[code](I, dynamic_import) :- ast_node[code](I, import_expression, _, _).

reexport_site[code](E, reexport_named) :- ast_node[code](E, export_named_declaration, _, _),
                                          ast_child[code](E, source, 0, _).
reexport_site[code](E, reexport_all)   :- ast_node[code](E, export_all_declaration, _, _),
                                          ast_child[code](E, source, 0, _).

module_site[code](N, K) :- import_site[code](N, K).
module_site[code](N, K) :- reexport_site[code](N, K).

site_kind[code](I, import_declaration) :- ast_node[code](I, import_declaration, _, _).
site_kind[code](I, import_expression)  :- ast_node[code](I, import_expression, _, _).
site_kind[code](E, export_named_declaration) :- reexport_site[code](E, reexport_named).
site_kind[code](E, export_all_declaration)   :- reexport_site[code](E, reexport_all).

site_file[code](I, F) :- module_site[code](I, _), ast_node[code](I, _, F, _).

site_line[code](I, L) :- module_site[code](I, _), ast_node[code](I, _, _, L).

site_source_node[code](I, Src) :- module_site[code](I, _), ast_child[code](I, source, 0, Src).

site_source[code](I, S) :- site_source_node[code](I, Src),
                           ast_node[code](Src, string_literal, _, _),
                           ast_value[code](Src, S).

site_source_literal[code](I) :- site_source[code](I, _).

-- the one irreducible cell: `import(pathVar)` names a module that does not
-- exist until the expression is evaluated
site_source_computed[code](I) :- site_source_node[code](I, _),
                                 not site_source_literal[code](I).

-- =========================================================================
-- 2. SOURCE SHAPE — total over literal sources, disjoint, keyed on the STRING.
-- `./x` and `../x`: the first character discriminates. `#foo` is a package
-- subpath (needs package.json `imports`, not read here). `node:` is a builtin
-- by scheme, whatever follows; the bare form is a lookup keyed on the whole
-- specifier, so `fs/promises` falls to `bare` and the oracle reports it rather
-- than a rule guessing. `bare` is the complement: the classification has no hole.
explicit_shape[code](S, relative) :- str_char0[code](S, ".").

explicit_shape[code](S, subpath)  :- str_char0[code](S, "#").

explicit_shape[code](S, node_builtin) :- str_scheme[code](S, "node").
explicit_shape[code](S, node_builtin) :- node_builtin_bare(S, _).

has_explicit_shape[code](S) :- explicit_shape[code](S, _).

src_shape[code](S, Sh)   :- explicit_shape[code](S, Sh).
src_shape[code](S, bare) :- str_char0[code](S, _), not has_explicit_shape[code](S).

site_shape[code](I, Sh)  :- site_source[code](I, S), src_shape[code](S, Sh).
has_shape[code](I)       :- site_shape[code](I, _).

-- =========================================================================
-- 3. RESOLUTION — a walk over the directory tree one segment at a time,
-- STARTING in the importing file's own directory, which is the whole content of
-- `relative`. `..` stops at the scanned root. Arrival: the LAST segment names a
-- file where the walk reached — without `str_segs(S, N)` `./sub/c.ts` would
-- also claim a file called `sub`. A builtin resolves to its canonical `node:`
-- name by table, because a rule cannot prefix a string. `dangling_import` is a
-- broken import, not a missing rule.
walk[code](I, 0, D) :- site_shape[code](I, relative),
                       site_file[code](I, F), fs_dir_of[code](F, D).

walk[code](I, K1, D) :- walk[code](I, K, D), site_source[code](I, S),
                        str_seg[code](S, K, "."), K1 is K + 1.

walk[code](I, K1, P) :- walk[code](I, K, D), site_source[code](I, S),
                        str_seg[code](S, K, ".."), fs_parent[code](D, P), K1 is K + 1.

walk[code](I, K1, C) :- walk[code](I, K, D), site_source[code](I, S),
                        str_seg[code](S, K, Seg), Seg != ".", Seg != "..",
                        fs_dir_in[code](D, Seg, C), K1 is K + 1.

resolved_import[code](I, T) :- walk[code](I, K, D), site_source[code](I, S),
                               str_seg[code](S, K, Seg), fs_file_in[code](D, Seg, T),
                               N is K + 1, str_segs[code](S, N).

builtin_canonical[code](S, S) :- str_scheme[code](S, "node").
builtin_canonical[code](S, C) :- node_builtin_bare(S, C).

resolved_builtin[code](I, C) :- site_shape[code](I, node_builtin),
                                site_source[code](I, S), builtin_canonical[code](S, C).

resolved_site[code](I) :- resolved_import[code](I, _).
resolved_site[code](I) :- resolved_builtin[code](I, _).

dangling_import[code](I, S) :- site_shape[code](I, relative), site_source[code](I, S),
                               not resolved_site[code](I).

-- =========================================================================
-- 4. IMPORT BINDINGS — the four specifier kinds. `imported` may be a
-- StringLiteral (`import { "a-b" as c }`): two lines are cheaper than a
-- verdict. A default binds `"default"`, a namespace `"*"`.
import_specifier_node[code](Sp) :- ast_node[code](Sp, import_specifier, _, _).
import_specifier_node[code](Sp) :- ast_node[code](Sp, import_default_specifier, _, _).
import_specifier_node[code](Sp) :- ast_node[code](Sp, import_namespace_specifier, _, _).

import_spec[code](I, Sp) :- import_site[code](I, static_import),
                            ast_child[code](I, specifiers, _, Sp).

spec_local[code](Sp, L) :- import_specifier_node[code](Sp),
                           ast_child[code](Sp, local, 0, N), ast_name[code](N, L).

spec_imported[code](Sp, M) :- ast_node[code](Sp, import_specifier, _, _),
                              ast_child[code](Sp, imported, 0, N), ast_name[code](N, M).

spec_imported[code](Sp, M) :- ast_node[code](Sp, import_specifier, _, _),
                              ast_child[code](Sp, imported, 0, N), ast_value[code](N, M).

spec_imported[code](Sp, "default") :- ast_node[code](Sp, import_default_specifier, _, _).
spec_imported[code](Sp, "*")       :- ast_node[code](Sp, import_namespace_specifier, _, _).

binding[code](I, Sp, Local, Imported) :- import_spec[code](I, Sp),
                                         spec_local[code](Sp, Local),
                                         spec_imported[code](Sp, Imported).

has_specifier[code](I) :- import_spec[code](I, _).

-- =========================================================================
-- 4b. EXPORT BINDINGS mirror section 4 and read OPPOSITE children: an export
-- binds an EXTERNAL name to a name in THIS module, and the two can differ. An
-- ExportNamespaceSpecifier carries `exported` and NO `local`, and
-- `export * as ns from` is an ExportNamedDeclaration. Nothing here reads
-- `source`: the naming question and the edge question are separate. Erasure
-- has the same two markers as an import; a namespace specifier carries none
-- and is a value binding, correctly.
export_site[code](E) :- ast_node[code](E, export_named_declaration, _, _).
export_spec[code](E, Sp) :- export_site[code](E), ast_child[code](E, specifiers, _, Sp).

export_specifier_node[code](Sp) :- ast_node[code](Sp, export_specifier, _, _).
export_specifier_node[code](Sp) :- ast_node[code](Sp, export_namespace_specifier, _, _).

spec_external[code](Sp, X) :- export_specifier_node[code](Sp),
                              ast_child[code](Sp, exported, 0, N), ast_name[code](N, X).
spec_external[code](Sp, X) :- export_specifier_node[code](Sp),
                              ast_child[code](Sp, exported, 0, N), ast_value[code](N, X).

spec_internal[code](Sp, L)   :- ast_node[code](Sp, export_specifier, _, _),
                                ast_child[code](Sp, local, 0, N), ast_name[code](N, L).
spec_internal[code](Sp, "*") :- ast_node[code](Sp, export_namespace_specifier, _, _).

export_binding[code](E, Sp, External, Internal) :- export_spec[code](E, Sp),
                                                   spec_external[code](Sp, External),
                                                   spec_internal[code](Sp, Internal).

export_renamed[code](Sp, External, Internal) :- export_binding[code](_, Sp, External, Internal),
                                                External != Internal.

export_decl_type_only[code](E)  :- ast_attr[code](E, export_kind, "type").
export_spec_type_only[code](Sp) :- ast_attr[code](Sp, export_kind, "type").

export_value_binding[code](E, Sp) :- export_binding[code](E, Sp, _, _),
                                     not export_decl_type_only[code](E),
                                     not export_spec_type_only[code](Sp).

-- the gates: every specifier yields exactly one external and one internal name
-- — none is an unread child, two is a name that is not a function of the node
export_bound[audit](Sp) :- export_binding[code](_, Sp, _, _).
export_binding_missing[audit](Sp)  :- export_spec[code](_, Sp), not export_bound[audit](Sp).
export_binding_conflict[audit](Sp, A, B) :- export_binding[code](_, Sp, A, _),
                                            export_binding[code](_, Sp, B, _), A != B.

export_internal_conflict[audit](Sp, A, B) :- export_binding[code](_, Sp, _, A),
                                             export_binding[code](_, Sp, _, B), A != B.

-- =========================================================================
-- 4c. THE DEFAULT EXPORT — no specifier node to hang a name on. Eight spellings
-- split four and four on whether an internal name exists at all: `export
-- default 42` offers `default` and nothing is named. The external name is the
-- string `"default"`, the same section 4 writes for an ImportDefaultSpecifier,
-- so both ends meet on one spelling. `export default q`: the declaration IS
-- the name (an identifier has `name` and no `id`), hence the second arm.
-- `export default interface I {}` is erased and carries `export_kind`
-- "value"; its kind is outside the vocabulary and `vocabulary_gap[audit]`
-- says so the day it arrives.
export_default_site[code](E) :- ast_node[code](E, export_default_declaration, _, _).

default_external[code](E, "default") :- export_default_site[code](E).

default_declaration[code](E, D) :- export_default_site[code](E),
                                   ast_child[code](E, declaration, 0, D).

default_internal[code](E, N) :- default_declaration[code](E, D),
                                ast_child[code](D, id, 0, I), ast_name[code](I, N).

default_internal[code](E, N) :- default_declaration[code](E, D),
                                ast_node[code](D, identifier, _, _), ast_name[code](D, N).

has_default_internal[code](E) :- default_internal[code](E, _).
default_anonymous[code](E)    :- default_declaration[code](E, _),
                                 not has_default_internal[code](E).

default_export_file[code](F, E) :- ast_node[code](E, export_default_declaration, F, _).

-- totality, one internal name, one default per module (two in one File is
-- what a collision between scanned modules would look like from here)
default_accounted[audit](E)   :- default_internal[code](E, _).
default_accounted[audit](E)   :- default_anonymous[code](E).
default_unaccounted[audit](E) :- export_default_site[code](E), not default_accounted[audit](E).

default_internal_conflict[audit](E, A, B) :- default_internal[code](E, A),
                                             default_internal[code](E, B), A != B.

default_conflict[audit](F, A, B) :- default_export_file[code](F, A),
                                    default_export_file[code](F, B), A != B.

-- =========================================================================
-- 5. DEPENDS, FLOWS, EVALUATES. DEPENDS: the file is named. FLOWS: a binding
-- that survives erasure (both negations load-bearing, one per marker) or a
-- dynamic import carrying the module object. EVALUATES: the body RUNS —
-- `import './side'` executes a file and `import type {}` executes nothing,
-- and both read as "depends, nothing flows".
decl_type_only[code](I) :- ast_attr[code](I, import_kind, "type").

spec_type_only[code](Sp) :- ast_attr[code](Sp, import_kind, "type").

value_binding[code](I, Sp) :- binding[code](I, Sp, _, _),
                              not decl_type_only[code](I),
                              not spec_type_only[code](Sp).

has_value_binding[code](I) :- value_binding[code](I, _).

no_specifiers[code](I) :- import_site[code](I, static_import), not has_specifier[code](I).

depends[code](F, T) :- resolved_import[code](I, T), site_file[code](I, F).

flows[code](F, T) :- has_value_binding[code](I),
                     resolved_import[code](I, T), site_file[code](I, F).
flows[code](F, T) :- import_site[code](I, dynamic_import),
                     resolved_import[code](I, T), site_file[code](I, F).

evaluates[code](F, T) :- flows[code](F, T).
evaluates[code](F, T) :- no_specifiers[code](I), not decl_type_only[code](I),
                         resolved_import[code](I, T), site_file[code](I, F).

-- =========================================================================
-- 5b. THE RE-EXPORT EDGE, through a different set of markers: the export-all
-- forms carry theirs on the DECLARATION with no specifier; the named forms
-- carry it in both places, neither implying the other. `export {} from
-- './side'` is the side-effect import's twin — measured on node: the file runs
-- and nothing flows.
reexport_spec[code](E, Sp) :- reexport_site[code](E, reexport_named),
                              ast_child[code](E, specifiers, _, Sp).

reexport_value_spec[code](E, Sp) :- reexport_spec[code](E, Sp),
                                    not export_decl_type_only[code](E),
                                    not export_spec_type_only[code](Sp).

reexport_value[code](E) :- reexport_value_spec[code](E, _).
reexport_value[code](E) :- reexport_site[code](E, reexport_all),
                           not export_decl_type_only[code](E).

has_reexport_spec[code](E)      :- reexport_spec[code](E, _).
no_reexport_specifiers[code](E) :- reexport_site[code](E, reexport_named),
                                   not has_reexport_spec[code](E).

flows[code](F, T) :- reexport_value[code](E),
                     resolved_import[code](E, T), site_file[code](E, F).

evaluates[code](F, T) :- no_reexport_specifiers[code](E), not export_decl_type_only[code](E),
                         resolved_import[code](E, T), site_file[code](E, F).

-- the join: the resolver says which FILE, the specifier which name in it.
-- What `export * from` offers is the other file's export list —
-- `exports_name` in rules/js-dataflow.rofl, not a module-graph question.
-- `"*"` rides the internal column unchanged: the module `export * as ns
-- from './m'` offers IS m.
reexport_offers[code](F, External, T, Internal) :-
    reexport_value_spec[code](E, Sp),
    spec_external[code](Sp, External), spec_internal[code](Sp, Internal),
    resolved_import[code](E, T), site_file[code](E, F).

-- =========================================================================
-- 5c. WHICH MODULE AN INTERNAL NAME LIVES IN. `export { helper as reHelper }
-- from './c'`: `helper` is c's name, not this file's. The guard `export_local`
-- carries in js-dataflow is not transplantable — `export * as ns;` without a
-- source is a SyntaxError, so excluding sourced declarations from
-- `export_site` would empty the namespace-specifier cell in every program. So
-- the row is kept and the silence closed: under a declaration with no
-- `source` the name lives here, under a re-export in the file resolved to, and
-- an unresolved re-export is placed by SHAPE, a positive relation.
local_export_site[code](E) :- export_site[code](E), not reexport_site[code](E, reexport_named).

export_internal_in[code](Sp, F) :- export_spec[code](E, Sp), local_export_site[code](E),
                                   ast_node[code](E, _, F, _).
export_internal_in[code](Sp, T) :- reexport_spec[code](E, Sp), resolved_import[code](E, T).

export_internal_unplaced[code](Sp, Sh) :- reexport_spec[code](E, Sp),
                                          unresolved_import[code](E, Sh).

export_internal_elsewhere[code](F, X, T) :- export_binding[code](E, Sp, X, _),
                                            ast_node[code](E, _, F, _),
                                            export_internal_in[code](Sp, T), T != F.

has_internal_home[audit](Sp)        :- export_internal_in[code](Sp, _).
has_internal_home[audit](Sp)        :- export_internal_unplaced[code](Sp, _).
export_internal_homeless[audit](Sp) :- export_binding[code](_, Sp, _, _),
                                       not has_internal_home[audit](Sp).

-- =========================================================================
-- 6. THE FRONTIER, AS A POSITIVE RELATION: every site is resolved or
-- unresolved-with-a-shape, and `unaccounted_site` says so.
unresolved_import[code](I, Sh)       :- site_shape[code](I, Sh), not resolved_site[code](I).
unresolved_import[code](I, computed) :- site_source_computed[code](I).

accounted[audit](I) :- resolved_site[code](I).
accounted[audit](I) :- unresolved_import[code](I, _).

unaccounted_site[audit](I) :- module_site[code](I, _), not accounted[audit](I).

-- =========================================================================
-- 7. THE AUDIT — the model checked against itself; the test plants a defect
-- for every row. `resolve_gap`: a shape whose verdict is `resolves` that did
-- not, and is not a broken path — a builtin missing from the table.
-- `site_without_kind`: the bookkeeping below is keyed on `site_kind`, so a
-- site outside it leaves without moving a row, which the re-export forms did.
-- Reasons are keyed on (kind, shape): per kind, one excuse satisfied every
-- shape and `stale_reason` reported false rows.
resolve_gap[audit](I, Sh) :- unresolved_import[code](I, Sh), shape_verdict(Sh, resolves),
                             not dangling_import[code](I, _).

has_site_kind[audit](I)     :- site_kind[code](I, _).
site_without_kind[audit](I) :- module_site[code](I, _), not has_site_kind[audit](I).

shape_conflict[audit](I, A, B) :- site_shape[code](I, A), site_shape[code](I, B), A != B.

shape_missing[audit](I) :- site_source_literal[code](I), not has_shape[code](I).

has_verdict[audit](Sh) :- shape_verdict(Sh, _).
shape_without_verdict[audit](Sh) :- site_shape[code](_, Sh), not has_verdict[audit](Sh).
shape_without_verdict[audit](computed) :- site_source_computed[code](_),
                                          not has_verdict[audit](computed).

reason_missing[audit](K, Sh, R) :- unresolved_import[code](I, Sh), site_kind[code](I, K),
                                   shape_verdict(Sh, R), R != resolves,
                                   not unknown_because(js, K, Sh, modules, R).

reason_unexercised[audit](K, R) :- unknown_because(js, K, Sh, modules, R),
                                   not reason_earned[audit](K, R).
reason_earned[audit](K, R) :- unresolved_import[code](I, Sh), site_kind[code](I, K),
                              shape_verdict(Sh, R).

-- =========================================================================
-- 8. THE MODULE'S OWN METADATA. `import.meta` points a module at itself;
-- `meta_form` in rules/js-structure.rofl tells it from `new.target`, which
-- shares the kind. `import.meta.resolve(spec)` is a specifier in a fifth place
-- and NOT modelled: wiring it into `module_site` changes the relation the test
-- compares site for site against node's own resolver.
module_meta[code](F, M) :- meta_form[code](M, import_meta), ast_node[code](M, _, F, _).

self_referential_module[code](F) :- module_meta[code](F, _).

not_module_meta[audit](M) :- meta_form[code](M, new_target).

-- =========================================================================
-- 9. IMPORT ATTRIBUTES — `with { type: "json" }` says what the module IS,
-- not where. Hung off the `attributes` field, which import and export
-- declarations both have. `type` is the only key ECMAScript defines; an
-- unknown key is a `module_attr` row nothing reads. A module imported as data
-- is NOT evaluated as code — `effect_of_module` assumes an imported module
-- runs, and for these it does not. Two frontiers: an attribute whose parent is
-- not a site, and one whose key or value the join could not read.
import_attr[code](A, Key, Value) :- ast_node[code](A, import_attribute, _, _),
                                    ast_child[code](A, key, 0, K), ast_name[code](K, Key),
                                    ast_child[code](A, value, 0, V), ast_value[code](V, Value).

import_attr_of[code](D, A) :- ast_child[code](D, attributes, _, A).
module_attr[code](D, Key, Value) :- import_attr_of[code](D, A), import_attr[code](A, Key, Value).

module_type[code](D, T) :- module_attr[code](D, "type", T).

module_is_data[code](D, T) :- module_type[code](D, T), T != "javascript".

import_attr_unsited[audit](A) :- ast_node[code](A, import_attribute, _, _),
                                 not import_attr_of[code](_, A).

import_attr_unread[audit](A) :- ast_node[code](A, import_attribute, _, _),
                                not import_attr[code](A, _, _).

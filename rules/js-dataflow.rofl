-- js-dataflow.rofl — THE VALUE LAYER: what an expression may evaluate to.
--
-- Two carriers and no third. `may_be_lit(E, Text)`: E may evaluate to this
-- literal, as written. `may_be_node(E, N)`: E may evaluate to the object,
-- function or class AT node N, by identity. No `unknown`: the absence of a row
-- already says "nothing here says so". Both are MAY-sets — rows mean "either
-- of these", a value the rules cannot see leaves no row, so a reader may add
-- an edge on a row and may never conclude an absence. Every value comes from
-- the parsed program, so the domain is finite and the fixpoint terminates.
--
-- Loads after rules/js-structure.rofl (`ast_name`, `key_name`, `ast_within`).
-- This layer and the call graph are ONE fixpoint: rules here read
-- `resolves[code]` and rules/js-callgraph.rofl reads `may_be_node`; the
-- recursion is positive. Loaded alone, this half is silent rather than wrong.

-- =========================================================================
-- 1. NAMES
--
-- `ident_in` carries the file so a rule can lead with (Name, File), which the
-- store indexes; leading with `ast_node(E, identifier, …)` enumerated every
-- identifier in the corpus — 39 % of a fixpoint.
function ident_in(N, to Name, to File).
ident_in[code](N, Name, File) :- ast_node[code](N, identifier, File), ast_name[code](N, Name).
ident[code](N, Name)        :- ident_in[code](N, Name, _).

-- =========================================================================
-- 2. WHAT A VALUE IS
--
-- A literal is its own value. A bigint's term is its decimal string, so `1n`
-- and `"1"` collide here, as `1e21` and its spelling already do. A regexp is
-- NOT a literal: it has identity and methods, so it is a node value below.
edb(literal_kind).
literal_kind(string_literal).
literal_kind(numeric_literal).
literal_kind(boolean_literal).
literal_kind(big_int_literal).

may_be_lit[flow](E, V) :- literal_kind(K), ast_node[code](E, K, _), ast_value[code](E, V).

-- `undefined` is a value too, the atom `undefined` (the string "undefined" is
-- another): the global of that name, `void`, a `let` or `var` with no
-- initialiser wherever it is read, a parameter a call leaves out and a call of
-- a function that may end without a value (rules/js-surface.rofl), a get that
-- may find no entry (section 7c). Where an object lacks a property is not
-- here: the layer does not know what an object lacks.
may_be_lit[flow](E, undefined) :- free_global[code](E, "undefined", _).
may_be_lit[flow](E, undefined) :- unary[value](E, "void", _).
undef_binder[code](D) :- bare_binder[code](D, _, _), ast_child[code](V, declarations, _, D), not iterates[value](_, V, _), not enumerates[value](_, V, _).
may_be_lit[flow](E, undefined) :- undef_binder[code](D), sees_binder[code](E, D), not target[value](D, E).

-- A template with no interpolation is a string — `cooked`, which is what it
-- evaluates to, not `raw`. No arm for an interpolated one: the kernel builds no
-- strings and a partial answer is wrong where silence is right (w_concat_value).
interpolated[code](T)  :- ast_child[code](T, expressions, _, _).
may_be_lit[flow](T, V) :- template[value](T), literal[value](T, V).

-- An object, array, function, class or regexp expression is its own node.
-- `may_be_node(E, E)` names the SITE: a literal in a loop makes a new object
-- each time round.
edb(node_value_kind).
node_value_kind(object_expression).
node_value_kind(array_expression).
node_value_kind(function_expression).
node_value_kind(arrow_function_expression).
node_value_kind(class_declaration).
node_value_kind(class_expression).
node_value_kind(reg_exp_literal).

may_be_node[flow](E, E) :- node_value_kind(K), ast_node[code](E, K, _).

-- =========================================================================
-- 3. A NAME IS WHAT ITS BINDER'S INITIALISER IS, WHERE THE BINDER IS IN SCOPE
--
-- `binder` is a declarator whose id is a plain name. Destructuring forms bind
-- names too (`binds_name`) but evaluate to a MEMBER of the init, so they are
-- not `binder` rows; `scoped_binder` is the union every scope rule ranges over.
-- A declarator is a place a `var`, `let`, `const` or `using` declares.
edb(var_decl_kind).
var_decl_kind(var). var_decl_kind(let). var_decl_kind(const). var_decl_kind(using). var_decl_kind(await_using).
var_decl[code](D) :- var_decl_kind(K), decl[value](D, K).
declarator_id[code](D, I) :- var_decl[code](D), assign[value](D, I, _).
declarator_id[code](D, I) :- var_decl[code](D), target[value](D, I).

function binder(D, to Name, to Init, to File).
binder[code](D, Name, Init, File) :- var_decl[code](D), assign[value](D, I, Init), binds[value](I, Name),
                                     at[tree](D, File, _).

scoped_binder[code](D, File) :- binder[code](D, _, _, File).

-- A declarator with a plain name and NO initialiser (`let r;`, `var r;`, the
-- head of a for-of) binds the name and says nothing about a value. It is a
-- scope fact all the same: an assignment is scoped through it (section 4), and
-- it hides an outer binder of the name in its region.
bare_binder[code](D, Name, File) :- var_decl[code](D), target[value](D, I), binds[value](I, Name),
                                    at[tree](D, File, _).
scoped_binder[code](D, File)    :- bare_binder[code](D, _, File).

-- A binder's region: the nearest block for `let`/`const`, the nearest function
-- for `var` (function-scoped, hoisted), none at the top of a file. A name is
-- resolved where it is READ: from the identifier outward through the scopes
-- around it, nearest first, to the first that declares the name (section 3a).
-- What it sees there is every binder of the name whose region that scope is,
-- less those it reads before their line (the TDZ below); a name no scope
-- declares sees the binders at the top of its file.
binder_region[code](D, R)    :- lexical_binder[code](D), nearest_s[code](R, D).
binder_region[code](D, R)    :- scoped_binder[code](D, _), not lexical_binder[code](D),
                                nearest_v[flow](R, D).
binder_at_top[code](D)       :- scoped_binder[code](D, _), not binder_region[code](D, _).
sees_binder[code](E, D)      :- name_scope[code](E, Name, File, S), binder_region[code](D, S),
                                binds_name[code](D, Name, File), not tdz_at[code](E, D).
sees_binder[code](E, D)      :- binder_at_top[code](D), binds_name[code](D, Name, File),
                                top_read[code](E, Name, File).

-- Scope kinds are only those a declarator can be nearest to AND a fixture
-- reaches. `catch_clause`/`switch_case` never are (grammar); a for-of/for-in
-- head is a `bare_binder` whose region is the loop; `switch_statement`/
-- `static_block` hold no declaration in this corpus. Leaving one out widens a
-- region: the safe direction for what a binder SEES, the unsafe one for what it
-- HIDES, which is why the loop heads are here.
-- the roles' scopes; the program's is the top of the file, which top_read and decl_at_top answer
scope_node[code](R) :- mark[value](R, scope), not program[tree](R, _).
scope_node[code](R) :- fn_node[code](R).

lexical_binder[code](D) :- decl[value](D, let).
lexical_binder[code](D) :- decl[value](D, const).

-- Nearest scope, over declarators only. `ast_within(R, D)` first, with D
-- bound, walks ancestors; `scope_node(R)` first built the (binder × scope)
-- product, −11.5 % of a world.
up_s[code](D, P)       :- scoped_binder[code](D, _), parent[tree](P, D).
up_s[code](D, P2)      :- up_s[code](D, P), not scope_node[code](P), parent[tree](P2, P).
nearest_s[code](R, D)  :- up_s[code](D, R), scope_node[code](R).
encloses_s[code](R, D) :- scoped_binder[code](D, _), inside[tree](R, D), scope_node[code](R).
closer_s[code](R, D)   :- encloses_s[code](R, D), nearest_s[code](S, D), R != S.

-- Shadowing is a question about a NAME; this is the projection that carries one.
binds_name[code](D, Name, File) :- binder[code](D, Name, _, File).
binds_name[code](D, Name, File) :- bare_binder[code](D, Name, File).
binds_name[code](D, Name, File) :- destr_prop[code](D, _, _, Name, File).
binds_name[code](D, Name, File) :- destructures_at[code](D, Name, _, File).
binds_name[code](D, Name, File) :- rest_binds[code](D, _, Name, File).

-- 3a. THE LOOKUP. A scope declares a name by a binder whose region it is, or
-- by a parameter of the function it is. An identifier's name is found in the
-- nearest scope around it that declares the name: its ancestors are walked
-- up the tree (`ast_within` with the identifier bound is the parent chain, no
-- rows), each asked whether it declares the name, and of the scopes that do,
-- an outer one is passed over. Matching by name joined every reader of a name
-- to every binder of it in the file, `e` a few thousand times over
-- (f_all_of_vscode_answers_in_pieces_once_names_are_looked_up_in_their_file).
-- A name nothing in its file declares in a scope is not looked up: it is at the top.
scope_declares[code](S, Name, File) :- binder_region[code](D, S), binds_name[code](D, Name, File).
scope_declares[code](F, Name, File) :- param_bound[flow](F, Name), at[tree](F, File, _).
scope_declares[code](F, "arguments", File) :- fn_node[code](F), ast_node[code](F, K, File),
                                              K != arrow_function_expression.
scope_declares[code](S, Name, File) :- named_decl[code](D, Name, File), decl_region[code](D, S).
scope_declares[code](B, Name, File) :- catch_names[code](B, Name, File).
scope_declares[code](B, Name, File) :- ast_node[code](B, tsenum_body, File), ast_child[code](B, members, _, M),
                                       key[value](M, Name).
scope_declares[code](X, Name, File) :- own_name[code](X, Name, File, itself).

-- A function or class declaration declares its name in the scope around it,
-- as a binder does; a function or class expression inside itself. A
-- declaration with no scope around it is at the top of its file.
edb(named_kind).
named_kind(function_declaration, around).
named_kind(class_declaration, around).
named_kind(tsenum_declaration, around).
named_kind(tsmodule_declaration, around).
named_kind(tsdeclare_function, around).
named_kind(function_expression, itself).
named_kind(class_expression, itself).
own_name[code](X, Name, File, W) :- named_kind(K, W), ast_node[code](X, K, File),
                                    target[value](X, I), binds[value](I, Name).
named_decl[code](D, Name, File)  :- own_name[code](D, Name, File, around).
up_d[code](D, P)         :- named_decl[code](D, _, _), parent[tree](P, D).
up_d[code](D, P2)        :- up_d[code](D, P), not scope_node[code](P), parent[tree](P2, P).
decl_region[code](D, R)  :- up_d[code](D, R), scope_node[code](R).
decl_at_top[code](D)     :- named_decl[code](D, _, _), not decl_region[code](D, _).
catch_names[code](H, Name, File) :- decl[value](P, catch), binds[value](P, Name), parent[tree](H, P),
                                    at[tree](H, File, _).

-- which declaration a read of its name sees, found by the same lookup
sees_decl[code](E, D) :- named_decl[code](D, Name, File), decl_region[code](D, S),
                         name_scope[code](E, Name, File, S).
sees_decl[code](E, D) :- decl_at_top[code](D), named_decl[code](D, Name, File),
                         top_read[code](E, Name, File).
scoped_name[code](Name, File) :- scope_declares[code](_, Name, File).

name_cand[code](E, Name, File, S)  :- ident_in[code](E, Name, File), scoped_name[code](Name, File),
                                      inside[tree](S, E), scope_declares[code](S, Name, File).
name_outer[code](E, S)             :- name_cand[code](E, Name, File, S), name_cand[code](E, Name, File, S2),
                                      inside[tree](S, S2).
function name_scope(E, to Name, to File, to S).
name_scope[code](E, Name, File, S) :- name_cand[code](E, Name, File, S), not name_outer[code](E, S).

-- 3b. WHERE A NAME IS NOT A REFERENCE. Every property name, key, label and
-- type name is an `identifier` node too; these are the positions where an
-- identifier names something other than a binding. Everywhere else it is a
-- reference, `typeof Promise` and `arr.map(String)` included.
edb(not_a_reference).   -- not_a_reference(Kind, Field)
not_a_reference(labeled_statement, label).
not_a_reference(break_statement, label).
not_a_reference(continue_statement, label).
not_a_reference(import_specifier, imported).
not_a_reference(export_specifier, exported).
not_a_reference(export_namespace_specifier, exported).
not_a_reference(meta_property, meta).
not_a_reference(meta_property, property).
not_a_reference(tstype_reference, type_name).
not_a_reference(tsqualified_name, left).
not_a_reference(tsqualified_name, right).
not_a_reference(tsexpression_with_type_arguments, expression).
not_a_reference(tsclass_implements, expression).
not_a_reference(tsinterface_heritage, expression).
not_a_reference(tstype_query, expr_name).
not_a_reference(tsinterface_declaration, id).
not_a_reference(tstype_alias_declaration, id).
not_a_reference(tsenum_member, id).
not_a_reference(tstype_predicate, parameter_name).
not_a_reference(tsimport_type, qualifier).
-- the parameters of a signature with no body name types, not bindings
not_a_reference(tsdeclare_function, params).
not_a_reference(tsdeclare_method, params).
not_a_reference(tsfunction_type, params).
not_a_reference(tsconstructor_type, params).
not_a_reference(tsmethod_signature, params).
not_a_reference(tscall_signature_declaration, params).
not_a_reference(tsconstruct_signature_declaration, params).

not_a_ref[code](E) :- not_a_reference(K, Field), ast_node[code](P, K, _), ast_child[code](P, Field, _, E).
-- a key written as a name: `o.p`, `{ p: v }`, `p() {}`, a class field
not_a_ref[code](E) :- ast_child[code](P, property, 0, E), ast_attr[code](P, computed, false).
not_a_ref[code](E) :- ast_child[code](P, key, 0, E), ast_attr[code](P, computed, false).

-- 3c. WHAT IS DECLARED AT THE TOP OF A FILE. A name no scope around its
-- reading declares is the file's own top-level binding or import, else global.
function top_read(E, to Name, to File).
top_read[code](E, Name, File)  :- ident_in[code](E, Name, File), not not_a_ref[code](E),
                                  not name_cand[code](E, _, _, _).
top_declares[code](Name, File) :- binder_at_top[code](D), binds_name[code](D, Name, File).
top_declares[code](Name, File) :- decl_at_top[code](D), named_decl[code](D, Name, File).
top_declares[code](Name, File) :- imports_name[code](Name, _, _, File).
top_declares[code](Name, File) :- imports_ns[code](Name, _, File).
top_declares[code](Name, File) :- imports_default[code](Name, _, File).

free_global[code](E, Name, File) :- top_read[code](E, Name, File), not top_declares[code](Name, File).

-- A WELL-KNOWN SYMBOL is a key of its own kind: `[Symbol.iterator]` and a
-- method called `iterator` are two members. The thirteen are the language's.
edb(well_known_symbol).
well_known_symbol("asyncIterator", symbol_async_iterator).
well_known_symbol("hasInstance", symbol_has_instance).
well_known_symbol("isConcatSpreadable", symbol_is_concat_spreadable).
well_known_symbol("iterator", symbol_iterator).
well_known_symbol("match", symbol_match).
well_known_symbol("matchAll", symbol_match_all).
well_known_symbol("replace", symbol_replace).
well_known_symbol("search", symbol_search).
well_known_symbol("species", symbol_species).
well_known_symbol("split", symbol_split).
well_known_symbol("toPrimitive", symbol_to_primitive).
well_known_symbol("toStringTag", symbol_to_string_tag).
well_known_symbol("unscopables", symbol_unscopables).
symbol_ref[code](E, Key) :- prop_name[code](E, O, N), free_global[code](O, "Symbol", _), well_known_symbol(N, Key).

-- The TDZ, the one place the LINE matters: a read of a `let`/`const` name
-- above its declaration in the same region throws, so the model says nothing
-- there. A closure between the use and the region is deferred and keeps its
-- value: `const via = () => later; const later = f;` is legal.
tdz_cand[code](E, D)     :- lexical_binder[code](D), binder_region[code](D, R),
                            binds_name[code](D, Name, File), ident_in[code](E, Name, File),
                            inside[tree](R, E),
                            at[tree](D, _, LD), at[tree](E, _, LE),
                            LE < LD.
tdz_deferred[code](E, D) :- tdz_cand[code](E, D), binder_region[code](D, R),
                            nearest_v[flow](G, E), inside[tree](R, G).
tdz_at[code](E, D)       :- tdz_cand[code](E, D), not tdz_deferred[code](E, D).

may_be_lit[flow](E, V)  :- may_be_lit[flow](Init, V), binder[code](D, Name, Init, File),
                           ident_in[code](E, Name, File), sees_binder[code](E, D).
may_be_node[flow](E, N) :- may_be_node[flow](Init, N), binder[code](D, Name, Init, File),
                           ident_in[code](E, Name, File), sees_binder[code](E, D).

-- =========================================================================
-- 4. ASSIGNMENT, FLOW-INSENSITIVELY: `x = "a"` makes the BINDING `x` names
-- may-be "a" wherever that binding is read. This layer has no before and
-- after, but it has scope: an assignment reaches the readers of the binding its
-- target names, found with the machinery section 3 states for a declarator.
--
-- Only an operator whose result IS the right-hand side counts: `=` and the
-- three logical ones (`x ||= v` is x or v, a superset of v). `x += v` is a sum
-- and used to be read as v.
edb(assign_value_op).
assign_value_op("=").
assign_value_op("||=").
assign_value_op("&&=").
assign_value_op("??=").

assigned[code](A, L, Name, Src, File) :- ast_node[code](A, assignment_expression, File),
                                         ast_attr[code](A, operator, Op), assign_value_op(Op),
                                         ast_child[code](A, left, 0, L), ast_name[code](L, Name),
                                         ast_child[code](A, right, 0, Src).

-- THE TARGET, decided three ways. (a) a declarator in scope at the target:
-- closures, `var` hoisting and top-of-file binders are all `sees_binder`.
-- (b) a parameter of the function that owns the target. (c) a read of a
-- `let`/`const` above its declaration: it throws, nothing is assigned.
assign_binder[code](A, D) :- assigned[code](A, L, Name, _, File), binds_name[code](D, Name, File),
                             sees_binder[code](L, D).
assign_param[flow](A, F)  :- assigned[code](A, L, Name, _, _), param_use[flow](F, Name, L).
assign_dead[code](A)      :- assigned[code](A, L, _, _, _), tdz_at[code](L, _).

assign_decided[flow](A)   :- assign_binder[code](A, _).
assign_decided[flow](A)   :- assign_param[flow](A, _).
assign_decided[flow](A)   :- assign_dead[code](A).

may_be_lit[flow](E, V)  :- assign_binder[code](A, D), assigned[code](A, _, Name, Src, File),
                           may_be_lit[flow](Src, V),
                           ident_in[code](E, Name, File), sees_binder[code](E, D).
may_be_node[flow](E, N) :- assign_binder[code](A, D), assigned[code](A, _, Name, Src, File),
                           may_be_node[flow](Src, N),
                           ident_in[code](E, Name, File), sees_binder[code](E, D).
may_be_lit[flow](U, V)  :- assign_param[flow](A, F), assigned[code](A, _, Name, Src, _),
                           may_be_lit[flow](Src, V), param_use[flow](F, Name, U).
may_be_node[flow](U, N) :- assign_param[flow](A, F), assigned[code](A, _, Name, Src, _),
                           may_be_node[flow](Src, N), param_use[flow](F, Name, U).

-- A TARGET NO DECLARATOR OR PARAMETER OWNS — a function or class name, a
-- catch parameter, an import, an implicit global — is still a name found by
-- the same lookup: it reaches the reads that find the scope it finds, or, at
-- the top of the file, the reads at the top. `assign_unscoped` is the queue.
assign_unscoped[flow](A)  :- assigned[code](A, _, _, _, _), not assign_decided[flow](A).
assign_reaches_unscoped[flow](E, Src) :- assign_unscoped[flow](A), assigned[code](A, L, Name, Src, File),
                                         name_scope[code](L, Name, File, S), name_scope[code](E, Name, File, S).
assign_reaches_unscoped[flow](E, Src) :- assign_unscoped[flow](A), assigned[code](A, L, Name, Src, File),
                                         top_read[code](L, Name, File), top_read[code](E, Name, File).

may_be_lit[flow](E, V)  :- assign_reaches_unscoped[flow](E, Src), may_be_lit[flow](Src, V).
may_be_node[flow](E, N) :- assign_reaches_unscoped[flow](E, Src), may_be_node[flow](Src, N).

-- A parenthesis, a TS cast and a non-null assertion change nothing about the
-- value; the call graph lists them as shapes and this layer does not.
edb(value_transparent).
value_transparent(parenthesized_expression).
value_transparent(tsas_expression).
value_transparent(tsnon_null_expression).

may_be_lit[flow](E, V)  :- value_transparent(K), ast_node[code](E, K, _),
                           ast_child[code](E, expression, 0, X), may_be_lit[flow](X, V).
may_be_node[flow](E, N) :- value_transparent(K), ast_node[code](E, K, _),
                           ast_child[code](E, expression, 0, X), may_be_node[flow](X, N).

-- =========================================================================
-- 5. WHICH PROTOTYPE A VALUE HAS — from the KIND of a receiver written in
-- place, and through the value layer for one reached by a binder. A template
-- literal is in neither value table, so only the kind arm reaches it.
-- `builtin_prototype` names the prototypes whose methods live in a library
-- this model has not got; `object` and `function` are deliberately absent
-- (`member_value` and the language answer those).
edb(kind_prototype).
kind_prototype(array_expression,          array).
kind_prototype(string_literal,            string).
kind_prototype(template_literal,          string).
kind_prototype(numeric_literal,           number).
kind_prototype(boolean_literal,           boolean).
kind_prototype(object_expression,         object).
kind_prototype(function_expression,       function).
kind_prototype(arrow_function_expression, function).
kind_prototype(reg_exp_literal,           regexp).
kind_prototype(big_int_literal,           bigint).

function kind_proto(E, to P).
kind_proto[flow](E, P)   :- kind_prototype(K, P), ast_node[code](E, K, _).
prototype_of[flow](E, P) :- kind_proto[flow](E, P).
prototype_of[flow](E, P) :- may_be_node[flow](E, N), kind_proto[flow](N, P).

edb(builtin_prototype).
builtin_prototype(array).
builtin_prototype(string).
builtin_prototype(number).
builtin_prototype(boolean).
builtin_prototype(regexp).
builtin_prototype(bigint).
builtin_prototype(promise).
builtin_prototype(map).
builtin_prototype(set).
builtin_prototype(weakmap).
builtin_prototype(weakset).

-- A promise has no node to be: it is made by calling an async function, by
-- `new Promise`, by a static of `Promise`, and by `then`, `catch` or `finally`
-- on a promise, and a name bound to one is one.
edb(lib_member).
prototype_of[flow](C, promise) :- resolves[code](C, F), async_body[code](F).
prototype_of[flow](X, promise) :- construct[value](X), callee[value](X, G),
                                  free_global[code](G, "Promise", _).
prototype_of[flow](C, promise) :- callee[value](C, N), object_of[code](N, G),
                                  free_global[code](G, "Promise", _).
prototype_of[flow](C, promise) :- callee[value](C, N), object_of[code](N, O),
                                  prototype_of[flow](O, promise), selects[flow](N, Key),
                                  lib_member(promise, Key, _).
prototype_of[flow](E, promise) :- binder[code](D, _, Init, _), prototype_of[flow](Init, promise),
                                  sees_binder[code](E, D).

-- =========================================================================
-- 6. DESTRUCTURING — a name bound from a PATTERN. `{ pulled: taken }` binds
-- `taken` to member `pulled` of the init; shorthand and rename are one case
-- (key for the member, value for the local). An array pattern binds by
-- POSITION over the raw array, so `[, second]` keeps index 1. No `may_be_lit`
-- arm for array patterns: nothing exercises it and an arm nothing exercises
-- cannot go red.
-- A property binds the name its `value` is, or the `left` of an assignment pattern
-- when it has a default (`{ PORT = 1343 }`, `{ port: p = 82 }`); `prop_default` is
-- that default, which applies when the member is absent and so only adds a value.
prop_local[code](Prop, Local)   :- ast_child[code](Prop, value, 0, L), ast_name[code](L, Local).
prop_local[code](Prop, Local)   :- ast_child[code](Prop, value, 0, A),
                                   ast_node[code](A, assignment_pattern, _),
                                   ast_child[code](A, left, 0, L), ast_name[code](L, Local).
prop_default[code](Prop, Init)  :- ast_child[code](Prop, value, 0, A),
                                   ast_node[code](A, assignment_pattern, _),
                                   ast_child[code](A, right, 0, Init).

-- What a declarator's pattern takes apart: its initialiser, or at the head of
-- a for-of each element the loop walks (section 14).
decl_value[flow](D, X) :- ast_child[code](D, init, 0, X).

destr_prop[code](D, Prop, K, Local, File) :- declarator_id[code](D, P), at[tree](D, File, _),
                                             ast_node[code](P, object_pattern, _),
                                             ast_child[code](P, properties, _, Prop),
                                             ast_child[code](Prop, key, 0, K),
                                             prop_local[code](Prop, Local).
destructures[code](D, Local, Key, File) :- destr_prop[code](D, Prop, _, Local, File), key_name[code](Prop, Key).
scoped_binder[code](D, File) :- destr_prop[code](D, _, _, _, File).

may_be_node[flow](E, N) :- destructures[code](D, Local, Key, File),
                           decl_value[flow](D, Init), may_be_node[flow](Init, Obj),
                           member_value[flow](Obj, Key, V), may_be_node[flow](V, N),
                           ident_in[code](E, Local, File), sees_binder[code](E, D).
may_be_lit[flow](E, L)  :- destructures[code](D, Local, Key, File),
                           decl_value[flow](D, Init), may_be_node[flow](Init, Obj),
                           member_value[flow](Obj, Key, V), may_be_lit[flow](V, L),
                           ident_in[code](E, Local, File), sees_binder[code](E, D).

destr_default[code](D, Local, Init, File) :- destr_prop[code](D, Prop, _, Local, File),
                                             prop_default[code](Prop, Init).
may_be_lit[flow](E, L)  :- destr_default[code](D, Local, Init, File), may_be_lit[flow](Init, L),
                           ident_in[code](E, Local, File), sees_binder[code](E, D).
may_be_node[flow](E, N) :- destr_default[code](D, Local, Init, File), may_be_node[flow](Init, N),
                           ident_in[code](E, Local, File), sees_binder[code](E, D).

destructures_at[code](D, Local, Index, File) :- declarator_id[code](D, P), at[tree](D, File, _),
                                                ast_node[code](P, array_pattern, _),
                                                ast_child[code](P, elements, Index, L),
                                                ast_name[code](L, Local).
scoped_binder[code](D, File) :- destructures_at[code](D, _, _, File).

array_elem[flow](A, I, E) :- array[value](A), nth[tree](A, I, E), parent[tree](A, E).
array_elem[flow](A, I, S) :- spread_elems[value](A, I, X), parent[tree](S, X).
elem_at[flow](X, I, E)    :- may_be_node[flow](X, A), array_elem[flow](A, I, E).

may_be_node[flow](E, N) :- destructures_at[code](D, Local, Index, File),
                           decl_value[flow](D, Init), may_be_node[flow](Init, A), array_elem[flow](A, Index, V),
                           may_be_node[flow](V, N),
                           ident_in[code](E, Local, File), sees_binder[code](E, D).

-- A defaulted parameter has an index (the `left` of its `assignment_pattern`)
-- and a default that reaches the body.
param_of[flow](F, I, Name) :- fn_node[code](F), ast_child[code](F, params, I, P),
                              ast_node[code](P, assignment_pattern, _),
                              ast_child[code](P, left, 0, L), ast_name[code](L, Name).

param_default[flow](F, Name, Init) :- fn_node[code](F), ast_child[code](F, params, _, P),
                                      ast_node[code](P, assignment_pattern, _),
                                      ast_child[code](P, left, 0, L), ast_name[code](L, Name),
                                      ast_child[code](P, right, 0, Init).

may_be_node[flow](U, N) :- param_default[flow](F, Name, Init), may_be_node[flow](Init, N),
                           param_use[flow](F, Name, U).
may_be_lit[flow](U, L)  :- param_default[flow](F, Name, Init), may_be_lit[flow](Init, L),
                           param_use[flow](F, Name, U).

-- A parameter that is an object pattern, `({ port, host }) =>`, alone or with a
-- default for the whole object (`({ port } = {}) =>`), binds each name to a member
-- of the argument at its index. `param_of` does not carry these names (the argument
-- is not the name's value), so `param_bound` is the union every scope rule reads.
param_pattern[code](F, I, P) :- fn_node[code](F), param[value](F, I, P), parent[tree](F, P),
                                ast_node[code](P, object_pattern, _).
param_pattern[code](F, I, P) :- fn_node[code](F), ast_child[code](F, params, I, A),
                                ast_node[code](A, assignment_pattern, _),
                                ast_child[code](A, left, 0, P), ast_node[code](P, object_pattern, _).
param_prop[code](F, I, Key, Local, Prop) :- param_pattern[code](F, I, P),
                                            ast_child[code](P, properties, _, Prop),
                                            key_name[code](Prop, Key),
                                            prop_local[code](Prop, Local).
param_bound[flow](F, Name) :- param_of[flow](F, _, Name).
param_bound[flow](F, Name) :- param_pattern[code](F, _, P), ast_child[code](P, properties, _, Prop),
                              prop_local[code](Prop, Name).

may_be_lit[flow](U, L)  :- param_prop[code](F, I, Key, Local, _), sx_arg_node[surface](F, I, O),
                           member_value[flow](O, Key, V), may_be_lit[flow](V, L),
                           param_use[flow](F, Local, U).
may_be_node[flow](U, N) :- param_prop[code](F, I, Key, Local, _), sx_arg_node[surface](F, I, O),
                           member_value[flow](O, Key, V), may_be_node[flow](V, N),
                           param_use[flow](F, Local, U).
may_be_lit[flow](U, L)  :- param_prop[code](F, _, _, Local, Prop), prop_default[code](Prop, Init),
                           may_be_lit[flow](Init, L), param_use[flow](F, Local, U).
may_be_node[flow](U, N) :- param_prop[code](F, _, _, Local, Prop), prop_default[code](Prop, Init),
                           may_be_node[flow](Init, N), param_use[flow](F, Local, U).

-- An object rest binds a FRESH object with no node of its own, so the
-- `rest_element` node stands for it. It holds every key EXCEPT the ones the
-- pattern took — the exclusion is the whole content. It is `member_plain` (no
-- `static` anywhere), as a module namespace is.
pattern_takes[code](P, Key) :- ast_node[code](P, object_pattern, _),
                               ast_child[code](P, properties, _, Prop),
                               key_name[code](Prop, Key).

rest_in_pattern[code](D, R, File) :- declarator_id[code](D, P), at[tree](D, File, _),
                                     ast_node[code](P, object_pattern, _),
                                     ast_child[code](P, properties, _, R),
                                     ast_node[code](R, rest_element, _).
rest_binds[code](D, R, Local, File) :- rest_in_pattern[code](D, R, File),
                                       ast_child[code](R, argument, 0, L), ast_name[code](L, Local).
scoped_binder[code](D, File) :- rest_binds[code](D, _, _, File).

member_value[flow](R, Key, V) :- rest_in_pattern[code](D, R, _), declarator_id[code](D, P),
                                 decl_value[flow](D, Init), may_be_node[flow](Init, Obj),
                                 member_value[flow](Obj, Key, V),
                                 not pattern_takes[code](P, Key).
member_plain[flow](R, Key, V) :- rest_in_pattern[code](_, R, _), member_value[flow](R, Key, V).

may_be_node[flow](E, R) :- rest_binds[code](D, R, Local, File),
                           ident_in[code](E, Local, File), sees_binder[code](E, D).

-- Spread copies the source's keys. `{ ...o, k: v }` keeps both `k`s — the safe
-- direction; narrowing needs an order this layer has not got.
spread_of[code](O, A) :- obj_lit[code](O), spread_props[value](O, _, A).
member_value[flow](O, Key, V) :- spread_of[code](O, A), may_be_node[flow](A, Src), member_value[flow](Src, Key, V).

valued[flow](E) :- may_be_lit[flow](E, _).
valued[flow](E) :- may_be_node[flow](E, _).

-- =========================================================================
-- 7. ACROSS A CALL
edb(call_like_v).
call_like_v(call_expression).
call_like_v(optional_call_expression).
call_like_v(new_expression).

-- ONE function relation for every book: `fn_node[code]` from rules/js-callgraph.rofl
-- (`fn_kind` is its set). The value layer's own copy, `fn_node_v[flow]` over
-- `fn_kind_v`, was the same six kinds defined twice, and js-controlflow read both.

-- Nearest enclosing function over ANY node, walked DOWN from the function in
-- two linear rules. The argmin-as-negation-over-a-quadratic form was 35 % of a
-- fixpoint and no reorder fixes a shape. rules/js-callgraph.rofl keeps
-- `nearest_fn` over sites only; a mutant anchors on that copy.
nearest_v[flow](F, X)  :- fn_node[code](F), parent[tree](F, X).
nearest_v[flow](F, X)  :- nearest_v[flow](F, P), not fn_node[code](P),
                          parent[tree](P, X).

-- A CALL UNDER AN ENTRY GUARD IS NOT PART OF THE PROGRAM A LIBRARY IS. Code under
-- `if (!module.parent)` or `if (require.main === module)` runs when the file is
-- the one node was started on, and the other arm of the same test (`else`, or
-- `if (module.parent)`) when it was required. The values such a site hands a
-- callee (a test port, a CLI default) are not what the program passes, so the
-- site gives `arg_at` nothing: the callee is still resolved, the arguments are
-- not read. `dead_site` is syntax alone, as it must be: `arg_at` is under the
-- fixpoint and a call-graph reading of "only called from the guard" would negate
-- what `arg_at` feeds. A function whose every mention is under a guard (`main`)
-- is dead by name in its file, so its own calls are dead too; a mention anywhere
-- else (`module.exports = main`, a call from a live site) makes it live.
-- Reading the file as the library is the default VIEW: a world that asks about
-- one file as the script node runs says `runs_as_script("path/of/it.js")`, and
-- nothing in that file is dead; `reads_the_file_as(script)` says it of every file.
-- An exported function is reached from outside, so it is never dead by name.
edb(reads_the_file_as).
edb(runs_as_script).
read_as_script() :- reads_the_file_as(script).
entry_test[code](T) :- unary[value](T, "!", M), module_member[code](M, "parent").
entry_test[code](T) :- main_is_module[code](T, "===").
entry_test[code](T) :- main_is_module[code](T, "==").
imported_test[code](T) :- module_member[code](T, "parent").
imported_test[code](T) :- main_is_module[code](T, "!==").
imported_test[code](T) :- main_is_module[code](T, "!=").

module_member[code](M, Key) :- ast_node[code](M, member_expression, File), prop_name[code](M, O, Key),
                               free_global[code](O, "module", File).
main_is_module[code](T, Op) :- ast_node[code](T, binary_expression, File), binary[value](T, Op, L, R),
                               require_main[code](L), free_global[code](R, "module", File).
main_is_module[code](T, Op) :- ast_node[code](T, binary_expression, File), binary[value](T, Op, L, R),
                               require_main[code](R), free_global[code](L, "module", File).
require_main[code](M) :- ast_node[code](M, member_expression, File), prop_name[code](M, O, "main"),
                         free_global[code](O, "require", File).

dead_arm[code](A) :- entry_test[code](T), ast_child[code](S, test, 0, T), ast_child[code](S, consequent, 0, A),
                     at[tree](S, File, _), not read_as_script(), not runs_as_script(File).
dead_arm[code](A) :- imported_test[code](T), ast_child[code](S, test, 0, T), ast_child[code](S, alternate, 0, A),
                     at[tree](S, File, _), not read_as_script(), not runs_as_script(File).
dead_arm[code](A) :- entry_test[code](T), logical[value](S, "&&", T, A),
                     at[tree](S, File, _), not read_as_script(), not runs_as_script(File).
dead_arm[code](A) :- imported_test[code](T), logical[value](S, "||", T, A),
                     at[tree](S, File, _), not read_as_script(), not runs_as_script(File).

dead_in[code](A, C) :- dead_arm[code](A), inside[tree](A, C).
dead_site[code](C)  :- dead_in[code](_, C), call_like_v(K), ast_node[code](C, K, _).

mention[code](F, E)     :- sees_decl[code](E, F), ast_node[code](F, function_declaration, _),
                           target[value](F, I), E != I.
mention[code](F, E)     :- sees_binder[code](E, D), binder[code](D, _, F, _), fn_node[code](F),
                           assign[value](D, I, F), E != I.
live_mention[code](F)   :- mention[code](F, E), not dead_in[code](_, E).
live_mention[code](F)   :- fn_node[code](F), target[value](F, I), has[value](_, I).
live_mention[code](F)   :- fn_node[code](F), default_declaration[code](_, F).
dead_fn[code](F)        :- mention[code](F, _), not live_mention[code](F).
dead_site[code](C)      :- dead_fn[code](F), inside[tree](F, C), call_like_v(K), ast_node[code](C, K, _).

-- Argument into parameter by INDEX. A spread destroys the correspondence for
-- everything after it, and a may-set may be silent but not wrong, so `arg_at`
-- stops at the first spread; a spread of an array this layer can see (a
-- literal, or a rest parameter) contributes element K at position J + K.
spread_arg[code](C, I)   :- spread_args[value](C, I, _).
after_spread[code](C, I) :- spread_arg[code](C, J), argument_at[code](C, I, _), J < I.

arg_at[flow](C, I, A)      :- argument_at[code](C, I, A), not dead_site[code](C),
                              not spread_args[value](C, I, _),
                              not after_spread[code](C, I).

arg_at[flow](C, I, E)      :- spread_args[value](C, J, A), not after_spread[code](C, J), not dead_site[code](C),
                              elem_at[flow](A, K, E), I is J + K.
param_of[flow](F, I, Name) :- fn_node[code](F), param[value](F, I, P), parent[tree](F, P),
                              ast_name[code](P, Name).
param_of[flow](F, I, Name) :- fn_node[code](F), ast_child[code](F, params, I, P),
                              ast_node[code](P, tsparameter_property, _),
                              ast_child[code](P, parameter, 0, X), ast_name[code](X, Name).

-- A rest parameter is an array of the arguments from its index on: element K
-- of `...args` at J is the argument at J + K of every call of the function,
-- so `inner(...args)` hands them on through the spread rule above. The caller
-- knows its arguments and publishes them (sx_rest_elem, rules/js-surface.rofl).
param_rest[code](F, J, R, Name) :- fn_node[code](F), rest_params[value](F, J, L), parent[tree](R, L),
                                   parent[tree](F, R), ast_name[code](L, Name).
param_bound[flow](F, Name)  :- param_rest[code](F, _, _, Name).
may_be_node[flow](U, R)     :- param_rest[code](F, _, R, Name), param_use[flow](F, Name, U).

-- Where a parameter is read: every identifier whose lookup stops at the
-- function (section 3a). A declarator whose region is the function itself
-- (`function f(x) { var x }`) is the same binding, read there too.
param_use[flow](F, Name, U) :- name_scope[code](U, Name, _, F), param_bound[flow](F, Name).

-- The caller publishes what it hands the callee (rules/js-surface.rofl), the callee reads it.
may_be_lit[flow](U, V)  :- sx_arg_lit[surface](F, I, V), param_of[flow](F, I, Name), param_use[flow](F, Name, U).
may_be_node[flow](U, N) :- sx_arg_node[surface](F, I, N), param_of[flow](F, I, Name), param_use[flow](F, Name, U).

-- A call may be whatever the function it resolves to returns: its return summary, and where a return is the
-- function's own parameter, THIS call's argument (`sx_ret_param`, rules/js-surface.rofl).
returns[flow](F, E) :- exits[value](R, return), returns[value](R, E), nearest_v[flow](F, R).
returns[flow](F, E) :- fn_node[code](F), returns[value](F, E).

may_be_lit[flow](C, V)  :- resolves[code](C, F), sx_ret_lit[surface](F, V).
may_be_node[flow](C, N) :- resolves[code](C, F), sx_ret_node[surface](F, N).
may_be_lit[flow](C, V)  :- resolves[code](C, F), sx_ret_param[surface](F, I), arg_at[flow](C, I, A), may_be_lit[flow](A, V).
may_be_node[flow](C, N) :- resolves[code](C, F), sx_ret_param[surface](F, I), arg_at[flow](C, I, A), may_be_node[flow](A, N).

-- =========================================================================
-- 7b. LIBRARY CALLS THAT MOVE A VALUE, by the contract of the library member
-- the callee IS, found through the value layer (`const assign = Object.assign`,
-- `const assign = require('object-assign')`) and never by the method's name.
--
-- A conversion keeps its argument's value as written: `parseInt("8080", 10)` and
-- `Number("8080")` are the literal "8080", which is what a reader asking which
-- port reaches a call wants and not the number V8 holds; the digits are the same.
-- A string that is no number is also kept, where V8 has NaN: a may-set that is
-- wrong only for a value the program does not use as a number.
edb(keeps_argument).
keeps_argument("parseInt").
keeps_argument("parseFloat").
keeps_argument("Number").
edb(keeps_argument_static).
keeps_argument_static("Number", "parseInt").
keeps_argument_static("Number", "parseFloat").

converts[flow](C) :- keeps_argument(Name), free_global[code](G, Name, _),
                     callee[value](C, G), ast_node[code](C, call_expression, _).
converts[flow](C) :- keeps_argument_static(Owner, Key), es_static_call[code](C, Owner, Key, _),
                     ast_node[code](C, call_expression, _).
may_be_lit[flow](C, V) :- converts[flow](C), arg_at[flow](C, 0, A), may_be_lit[flow](A, V).

-- `Object.assign(target, ...sources)` copies the sources' members onto the target
-- and evaluates to the target itself. Its function value is the member read
-- `Object.assign` (a free global `Object`), or the module `object-assign`.
edb(merges_into_first).
merges_into_first("Object", "assign").
edb(merges_into_first_module).
merges_into_first_module("object-assign").

merge_member[flow](M)   :- merges_into_first(Owner, Key), es_static[code](M, Owner, Key, _).
may_be_node[flow](M, M) :- merge_member[flow](M).
merge_fn[flow](M)       :- merge_member[flow](M).
merge_fn[flow](Spec) :- merges_into_first_module(Spec), external_value[flow](Spec, Spec).

merge_call[flow](C) :- merge_fn[flow](X), may_be_node[flow](G, X), callee[value](C, G),
                       ast_node[code](C, call_expression, _).

may_be_node[flow](C, O) :- merge_call[flow](C), arg_at[flow](C, 0, T), may_be_node[flow](T, O).
sx_mwrite[surface](O, Key, V) :- merge_call[flow](C), arg_at[flow](C, 0, T), may_be_node[flow](T, O),
                                 arg_at[flow](C, I, S), I > 0, may_be_node[flow](S, Src),
                                 member_value[flow](Src, Key, V).

-- =========================================================================
-- 7c. KEYED COLLECTIONS. A collection keeps a value under a key: `m.set(k, v)`
-- puts v under k on the collection m may be, `m.get(k)` is what was put under k
-- there, and for-of over it (`for (const [k, v] of m)`) and its `forEach((v, k)
-- => ...)` see every key and value a get would. Which collections and which methods is a
-- table keyed by the RECEIVER's type, `keyed_store(Type, Put, Get)`, never by the
-- method's name: `other.set(k, v)` on a plain object moves nothing. The collection
-- is the site that made it: `new Map()` (`keyed_obj`), and an express app
-- (rules/js-express.rofl). A key is matched by its value, however it got there
-- (`const K = 'port'; m.get(K)`); a key with no known value matches nothing, and
-- the call is named in `keyed_key_unknown[audit]`: we do not know which. A read
-- sees every put but those the order below rules out. `m.keys()`, `m.values()` and
-- `m.entries()` are not read.
edb(keyed_store).
keyed_store(map, "set", "get").
keyed_store(weakmap, "set", "get").

keyed_obj[flow](X, P) :- es_instance[flow](X, Name, _), lib_global_prototype(Name, P), keyed_store(P, _, _).

keyed_on[flow](C, X, P, Key) :- keyed_obj[flow](X, P), may_be_node[flow](O, X), object_of[code](N, O),
                                callee[value](C, N), ast_node[code](C, call_expression, _),
                                selects[flow](N, Key).
sx_kput[surface](X, K, V) :- keyed_on[flow](C, X, P, Put), keyed_store(P, Put, _), arg_at[flow](C, 0, A),
                             may_be_lit[flow](A, K), arg_at[flow](C, 1, V).
keyed_put[flow](X, K, V) :- sx_kput[surface](X, K, V).
keyed_get[flow](C, X, K) :- keyed_on[flow](C, X, P, Get), keyed_store(P, _, Get), arg_at[flow](C, 0, A),
                            may_be_lit[flow](A, K), not argument_at[code](C, 1, _).
may_be_lit[flow](C, undefined) :- keyed_on[flow](C, _, P, Get), keyed_store(P, _, Get).
-- code outside the model runs at a site nothing resolves, unless it is a
-- method of a collection that calls nothing back (all but `forEach`)
keyed_quiet[code](Q) :- keyed_on[flow](Q, _, _, Meth), Meth != "forEach".
runs_unknown[code](Q) :- site[code](Q), not resolved_site[code](Q), not keyed_quiet[code](Q).

keyed_key_at[flow](C, A)    :- keyed_on[flow](C, _, P, Put), keyed_store(P, Put, _), arg_at[flow](C, 0, A).
keyed_key_at[flow](C, A)    :- keyed_on[flow](C, _, P, Get), keyed_store(P, _, Get), arg_at[flow](C, 0, A).
keyed_key_known[flow](C)    :- keyed_key_at[flow](C, A), may_be_lit[flow](A, _).
keyed_key_unknown[audit](C) :- keyed_key_at[flow](C, _), not keyed_key_known[flow](C).

-- WHAT IS IN IT AT THE READ. A collection has a HOLDER whose reads and writes
-- can be put in order: a `const` that binds a new one (one collection per run
-- of the declaration's statement list), or a field of a class written once,
-- `this.m = new Map()` in the constructor or `m = new Map()` as a
-- field (one per instance; in a method `this.m` is the instance's for the whole
-- run). A read, a get, a `forEach` or a for-of over it, in a statement of an
-- ORDERED LIST (the declaration's list; for a field, the body of any method of
-- the class), outside any function written there, has an order with each put:
--   - in the list that MAKES the collection (the declaration's, the
--     constructor's body), a put that runs only in later statements has not
--     run yet: one written in a later statement, also inside a function written
--     there (it does not exist before it), and one in a function that only
--     later statements call, by its name or as `this.#f()` or a TypeScript
--     `private` method, however deep the calls go. A hoisted function
--     declaration is ordered by its calls only.
--   - a put in an earlier statement of the same list has run, unless a put of
--     the same key, a delete of it or a clear, in a statement of its own between
--     them, took it out. The same key is one literal for certain (the flow
--     gives one value and nothing outside it reaches the key), one `const`, or
--     one parameter nothing assigns. On a field, outside the constructor, a
--     call between them that may run the method again puts the value back.
-- Every other put may have run before the read or not (a public method, a
-- callback, an await, another file, a loop around the declaration): it is
-- kept, as `keyed_read_unordered`, and a proof says so.
keyed_new[code](X, P) :- es_global_construct[code](X, Name, _), lib_global_prototype(Name, P),
                         keyed_store(P, _, _).

keyed_const[code](D, P, B, F) :- keyed_new[code](X, P), ast_child[code](D, init, 0, X),
                                 ast_child[code](V, declarations, _, D), ast_attr[code](V, kind, "const"),
                                 ast_child[code](B, F, _, V), stmt_seq_field(F).
keyed_holder[code](D, P)  :- keyed_const[code](D, P, _, _).
keyed_born[code](D, B, F) :- keyed_const[code](D, _, B, F).
keyed_ref[code](O, D)     :- keyed_const[code](D, _, _, _), sees_binder[code](O, D).

keyed_ctor[code](CB, Body) :- ctor_method[code](M), parent[tree](CB, M), body[value](M, Body).
keyed_this_member[code](L, T, Fld) :- prop_name[code](L, T, Fld), this[value](T).
keyed_field[code](A, P, CB, Fld) :- keyed_new[code](X, P), ast_child[code](A, right, 0, X),
                                    ast_node[code](A, assignment_expression, _), ast_child[code](A, left, 0, L),
                                    keyed_this_member[code](L, _, Fld), ast_child[code](S, expression, 0, A),
                                    ast_child[code](Body, body, _, S), keyed_ctor[code](CB, Body).
keyed_field[code](Q, P, CB, Fld) :- keyed_new[code](X, P), ast_child[code](Q, value, 0, X),
                                    ast_node[code](Q, class_property, _), ast_attr[code](Q, static, false),
                                    ast_attr[code](Q, computed, false),
                                    ast_child[code](Q, key, 0, K), ast_node[code](K, identifier, _),
                                    ast_name[code](K, Fld), ast_child[code](CB, body, _, Q).
-- written again on any object: no holder. In any file, unless TypeScript keeps
-- the field to its class (`private`, `readonly`): then in its own file only.
keyed_field_closed[code](H) :- keyed_field[code](H, _, CB, Fld), ast_child[code](CB, body, _, Q),
                               ast_node[code](Q, class_property, _), ast_child[code](Q, key, 0, K),
                               ast_name[code](K, Fld), ast_attr[code](Q, accessibility, "private").
keyed_field_closed[code](H) :- keyed_field[code](H, _, CB, Fld), ast_child[code](CB, body, _, Q),
                               ast_node[code](Q, class_property, _), ast_child[code](Q, key, 0, K),
                               ast_name[code](K, Fld), ast_attr[code](Q, readonly, true).
keyed_field_set[code](H, A, File) :- keyed_field[code](H, _, _, Fld), ast_name[code](Pn, Fld),
                                     ast_child[code](L, property, 0, Pn), ast_child[code](A, left, 0, L),
                                     ast_node[code](A, assignment_expression, File), A != H.
keyed_field_reset[code](H) :- keyed_field_set[code](H, _, _), not keyed_field_closed[code](H).
keyed_field_reset[code](H) :- keyed_field_set[code](H, _, File), at[tree](H, File, _).
keyed_field_ok[code](H, CB, Fld) :- keyed_field[code](H, _, CB, Fld), not keyed_field_reset[code](H).
keyed_holder[code](H, P)  :- keyed_field[code](H, P, _, _), keyed_field_ok[code](H, _, _).
keyed_born[code](H, Body, body) :- keyed_field_ok[code](H, CB, _), keyed_ctor[code](CB, Body).

keyed_method[code](H, M) :- keyed_field_ok[code](H, CB, _), parent[tree](CB, M), fn_node[code](M),
                            not static[value](M).
keyed_list[code](H, B, F)       :- keyed_born[code](H, B, F).
keyed_list[code](H, Body, body) :- keyed_method[code](H, M), body[value](M, Body).
-- `this` in a method is the instance only where no nearer function binds it
keyed_ref[code](L, H) :- keyed_method[code](H, M), this_host[flow](M, T), keyed_this_member[code](L, T, Fld),
                         keyed_field_ok[code](H, _, Fld).

-- every call on a holder in a statement of an ordered list
keyed_seen[code](C, H, Meth, S, B, F, I) :- keyed_ref[code](O, H), prop_name[code](N, O, Meth), callee[value](C, N),
                                            ast_node[code](C, call_expression, _), inside[tree](S, C),
                                            ast_child[code](B, F, I, S), keyed_list[code](H, B, F).
keyed_fn_between[code](S, C) :- keyed_seen[code](C, _, _, S, _, _, _), inside[tree](G, C),
                                fn_node[code](G), inside[tree](S, G).
keyed_fn_between[code](S, C) :- keyed_seen[code](C, _, _, S, _, _, _), fn_node[code](S).
keyed_call[code](C, H, Meth, B, F, I) :- keyed_seen[code](C, H, Meth, S, B, F, I), not keyed_fn_between[code](S, C).

keyed_hoisted[code](S) :- keyed_seen[code](_, _, _, S, _, _, _), fn_node[code](S).
keyed_hoisted[code](S) :- keyed_seen[code](_, _, _, S, _, _, _), ast_child[code](S, declaration, 0, G), fn_node[code](G).
keyed_later[code](C, H, Meth, B, F, I) :- keyed_seen[code](C, H, Meth, S, B, F, I), keyed_born[code](H, B, F),
                                          not keyed_hoisted[code](S).

-- a statement that is nothing but the call: it runs whenever the list gets past it
keyed_step[code](C, H, Meth, B, F, I) :- keyed_seen[code](C, H, Meth, S, B, F, I), ast_node[code](S, expression_statement, _),
                                         ast_child[code](S, expression, 0, C).

-- THE SAME KEY: two calls name one key when each key is one literal for
-- certain, or both read one binding that holds one value for a run (one
-- `const`, one parameter nothing assigns). A key is a literal for certain when
-- the flow gives it that one value and nothing outside the flow reaches it:
-- back through its sources (a binding's initialiser and assignments, a
-- parameter's arguments where every call of its function is known, the parts
-- of `+` and of a template, what a call's functions in this file return) every
-- leaf is a literal (`keyed_open` otherwise). A function of another file is
-- open: its returns are not published as closed (no `may_be_open` surface).
edb(keyed_shut_kind).
keyed_shut_kind(string_literal).
keyed_shut_kind(numeric_literal).
keyed_shut_kind(identifier).
keyed_shut_kind(binary_expression).
keyed_shut_kind(template_literal).
keyed_shut_kind(call_expression).
keyed_key_arg[code](C, A)  :- keyed_seen[code](C, _, _, _, _, _, _), ast_child[code](C, arguments, 0, A).
keyed_key_arg[code](D, A)  :- keyed_drop[code](D, _), ast_child[code](D, arguments, 0, A).
keyed_want[code](A) :- keyed_remover[code](R, _, _, _), keyed_key_arg[code](R, A).
keyed_want[code](A) :- keyed_remover[code](_, C, K, _), keyed_read_site[code](C, H, B, F, _),
                       keyed_put_site[code](P, H, _, B, F, J), J < K, keyed_key_arg[code](P, A).
keyed_want[code](S) :- keyed_want[code](E), keyed_src[code](E, S).
keyed_param[code](U, G, Pos) :- keyed_want[code](U), ast_node[code](U, identifier, _), param_use[flow](G, Name, U),
                                param_of[flow](G, Pos, Name).
keyed_bound[code](E) :- keyed_want[code](E), sees_binder[code](E, D), binder[code](D, _, _, _).
keyed_bound[code](U) :- keyed_param[code](U, _, _).
keyed_src[code](E, I) :- keyed_want[code](E), ast_node[code](E, identifier, _), sees_binder[code](E, D),
                         binder[code](D, _, I, _).
keyed_src[code](E, S) :- keyed_want[code](E), ast_node[code](E, identifier, _), sees_binder[code](E, D),
                         assign_binder[code](A, D), assigned[code](A, _, _, S, _).
keyed_src[code](U, S) :- keyed_param[code](U, G, _), param_use[flow](G, Name, U), assign_param[flow](A, G),
                         assigned[code](A, _, Name, S, _).
keyed_arg[code](U, Q, Pos, A) :- keyed_param[code](U, G, Pos), keyed_called[code](G, Q), argument_at[code](Q, Pos, A),
                                  not spread_args[value](Q, Pos, _).
keyed_src[code](U, A) :- keyed_arg[code](U, _, _, A).
keyed_src[code](E, X) :- keyed_want[code](E), ast_node[code](E, binary_expression, _), binary[value](E, "+", X, _).
keyed_src[code](E, X) :- keyed_want[code](E), ast_node[code](E, binary_expression, _), binary[value](E, "+", _, X).
keyed_src[code](E, X) :- keyed_want[code](E), template[value](E), nth[tree](E, _, X).

-- a call is what the functions it calls return: open where one of them is not
-- followed (`keyed_ret_known`), has an open return (`keyed_ret_open`), returns
-- a parameter the call leaves out or hands an open argument, or is async or a
-- generator (the call is a promise or an iterator). Followed are the functions
-- that return one value; one another file calls left its file, and its own
-- volume publishes what it found.
keyed_rets_many[code](F) :- fn_node[code](F), sx_ret_lit[surface](F, V), sx_ret_lit[surface](F, W), V != W.
keyed_ret_need[code](F)  :- fn_node[code](F), sx_ret_lit[surface](F, _), not keyed_rets_many[code](F).
keyed_want[code](R) :- keyed_ret_need[code](F), ret_plain[flow](F, R).
keyed_ret_known[code](F) :- keyed_ret_need[code](F).
keyed_ret_open[code](F)  :- keyed_ret_need[code](F), ret_plain[flow](F, R), keyed_open[code](R).
keyed_ret_open[code](F)  :- keyed_ret_need[code](F), async[value](F).
keyed_ret_open[code](F)  :- keyed_ret_need[code](F), generator[value](F).
sx_ret_known[surface](F) :- sx_esc[surface](F), keyed_ret_known[code](F).
sx_ret_open[surface](F)  :- sx_esc[surface](F), keyed_ret_open[code](F).
keyed_ret_known[code](F) :- sx_ret_known[surface](F).
keyed_ret_open[code](F)  :- sx_ret_open[surface](F).
keyed_open[code](C) :- keyed_want[code](C), ast_node[code](C, call_expression, _), not resolved_site[code](C).
keyed_open[code](C) :- keyed_want[code](C), ast_node[code](C, call_expression, _), resolves[code](C, F),
                       not keyed_ret_known[code](F).
keyed_open[code](C) :- keyed_want[code](C), ast_node[code](C, call_expression, _), resolves[code](C, F),
                       keyed_ret_open[code](F).
keyed_open[code](C) :- keyed_want[code](C), callee_of[code](C, N), external_value[flow](N, _).
keyed_open[code](C) :- keyed_want[code](C), resolves[code](C, F), sx_ret_param[surface](F, I),
                       not argument_at[code](C, I, _).

keyed_src[code](C, A) :- keyed_want[code](C), resolves[code](C, F), sx_ret_param[surface](F, I),
                         ast_child[code](C, arguments, I, A).
keyed_fn_need[code](G) :- keyed_param[code](_, G, _).
keyed_open[code](E) :- keyed_want[code](E), ast_node[code](E, K, _), not keyed_shut_kind(K).
keyed_open[code](E) :- keyed_want[code](E), ast_node[code](E, binary_expression, _), not ast_attr[code](E, operator, "+").
keyed_open[code](E) :- keyed_want[code](E), ast_node[code](E, identifier, _), not keyed_bound[code](E).
keyed_open[code](U) :- keyed_param[code](U, G, _), keyed_escapes[code](G).
keyed_open[code](E) :- keyed_want[code](E), sees_binder[code](E, D), sees_binder[code](L, D),
                       ast_child[code](U, argument, 0, L), ast_node[code](U, update_expression, _).
keyed_open[code](E) :- keyed_want[code](E), sees_binder[code](E, D), sees_binder[code](L, D), ast_child[code](A, left, 0, L),
                       ast_node[code](A, assignment_expression, _), ast_attr[code](A, operator, Op), not assign_value_op(Op).
keyed_open[code](E) :- keyed_src[code](E, S), keyed_open[code](S).
-- a source that reaches itself builds its value in a loop
keyed_upstream[code](E, S) :- keyed_src[code](E, S).
keyed_upstream[code](E, T) :- keyed_upstream[code](E, S), keyed_src[code](S, T).
keyed_open[code](E) :- keyed_upstream[code](E, E).
keyed_lits[code](A) :- keyed_want[code](A), may_be_lit[flow](A, L), may_be_lit[flow](A, M), L != M.
keyed_key[code](C, Key) :- keyed_key_arg[code](C, A), keyed_want[code](A), may_be_lit[flow](A, Key),
                           not keyed_lits[code](A), not keyed_open[code](A).
keyed_const_name[code](C, Dk) :- keyed_key_arg[code](C, A), ast_node[code](A, identifier, _), sees_binder[code](A, Dk),
                                 ast_child[code](V, declarations, _, Dk), ast_attr[code](V, kind, "const").
keyed_param_name[code](C, G, Name) :- keyed_key_arg[code](C, A), ast_node[code](A, identifier, _), ast_name[code](A, Name),
                                      name_scope[code](A, Name, _, G), param[value](G, _, Pa), parent[tree](G, Pa),
                                      ast_node[code](Pa, identifier, _), ast_name[code](Pa, Name).
keyed_param_set[code](G, Name) :- keyed_param_name[code](_, G, Name), assigned[code](_, L, Name, _, _),
                                  name_scope[code](L, Name, _, G).
keyed_param_set[code](G, Name) :- keyed_param_name[code](_, G, Name), ast_name[code](L, Name),
                                  name_scope[code](L, Name, _, G), ast_child[code](U, argument, 0, L),
                                  ast_node[code](U, update_expression, _).
keyed_same_name[code](P, R) :- keyed_const_name[code](P, Dk), keyed_const_name[code](R, Dk).
keyed_same_name[code](P, R) :- keyed_param_name[code](P, G, Name), keyed_param_name[code](R, G, Name),
                               not keyed_param_set[code](G, Name).

-- the reads and the puts
keyed_read_site[code](C, H, B, F, I) :- keyed_call[code](C, H, Get, B, F, I), keyed_holder[code](H, P),
                                        keyed_store(P, _, Get).
keyed_read_site[code](C, H, B, F, I) :- keyed_call[code](C, H, "forEach", B, F, I).
keyed_read_site[code](S, H, B, F, I) :- keyed_ref[code](R, H), iterates[value](S, _, R),
                                        ast_child[code](B, F, I, S),
                                        keyed_list[code](H, B, F).
keyed_put_of[code](C, H, V)  :- keyed_seen[code](C, H, Put, _, _, _, _), keyed_holder[code](H, P),
                                keyed_store(P, Put, _), ast_child[code](C, arguments, 1, V).
keyed_put_site[code](C, H, V, B, F, J)  :- keyed_call[code](C, H, _, B, F, J), keyed_put_of[code](C, H, V).
keyed_put_later[code](C, H, V, B, F, J) :- keyed_later[code](C, H, _, B, F, J), keyed_put_of[code](C, H, V).

-- WHERE A PUT RUNS, in the list that makes the collection: in the statement
-- it sits in, or, inside a function only ever called, wherever those calls run
keyed_hop[code](X, H) :- keyed_put_of[code](X, H, _).
keyed_hop[code](Q, H) :- keyed_hop_fn[code](G, H), keyed_called[code](G, Q).
-- a function the collection's own list or class holds; the function around
-- the list is no hop, its callers make a new collection
keyed_hop_fn[code](G, H) :- keyed_hop[code](X, H), nearest_v[flow](G, X), keyed_born[code](H, B, F),
                            ast_child[code](B, F, _, S), inside[tree](S, G).
keyed_hop_fn[code](G, H) :- keyed_hop[code](X, H), nearest_v[flow](G, X), keyed_born[code](H, B, F),
                            ast_child[code](B, F, _, G).
keyed_hop_fn[code](G, H) :- keyed_hop[code](X, H), nearest_v[flow](G, X), keyed_method[code](H, M),
                            not ast_attr[code](M, kind, "constructor"), inside[tree](M, G).
keyed_hop_fn[code](M, H) :- keyed_hop[code](X, H), nearest_v[flow](M, X), keyed_method[code](H, M),
                            not ast_attr[code](M, kind, "constructor").
keyed_fn_need[code](G) :- keyed_hop_fn[code](G, _).
keyed_named_fn[code](G, E) :- keyed_fn_need[code](G), ast_node[code](G, function_declaration, _),
                              not ast_child[code](_, declaration, 0, G), sees_decl[code](E, G),
                              not target[value](G, E).
keyed_named_fn[code](G, E) :- keyed_fn_need[code](G), ast_child[code](D, init, 0, G),
                              ast_child[code](V, declarations, _, D), ast_attr[code](V, kind, "const"),
                              not ast_child[code](_, declaration, 0, V), sees_binder[code](E, D),
                              not assign[value](D, E, G).
keyed_named_fn[code](G, N) :- keyed_fn_need[code](G), private_binds[code](N, G), private_method[code](G).
keyed_named_fn[code](G, N) :- keyed_fn_need[code](G), ast_attr[code](G, accessibility, "private"),
                              ast_child[code](G, key, 0, K), ast_name[code](K, Name), ast_child[code](CB, body, _, G),
                              ast_name[code](Pn, Name), ast_child[code](N, property, 0, Pn), inside[tree](CB, N),
                              ast_node[code](N, member_expression, _).
-- tsc lets two ways past `private`: `x['f']` and a cast to any. The model
-- keeps to `private` and says where a member of that name is reached so: by
-- a string anywhere, by a name outside the class in its file
keyed_private_name[code](G, CB, Name) :- keyed_hop_fn[code](G, _), ast_attr[code](G, accessibility, "private"),
                                        ast_child[code](G, key, 0, K), ast_name[code](K, Name), ast_child[code](CB, body, _, G).
keyed_private_reached[audit](N, G) :- keyed_private_name[code](G, CB, Name), ast_value[code](Lit, Name),
                                      ast_node[code](Lit, string_literal, _), ast_child[code](N, property, 0, Lit),
                                      ast_attr[code](N, computed, true).
keyed_private_reached[audit](N, G) :- keyed_private_name[code](G, CB, Name), ast_name[code](Pn, Name),
                                      ast_child[code](N, property, 0, Pn), ast_node[code](N, member_expression, File),
                                      at[tree](G, File, _), not inside[tree](CB, N).
keyed_has_name[code](G) :- keyed_named_fn[code](G, _).
keyed_called[code](G, Q) :- keyed_named_fn[code](G, E), callee[value](Q, E), ast_node[code](Q, call_expression, _).
keyed_by_this[code](E)   :- keyed_named_fn[code](G, E), class_method_of[flow](_, G),
                            object_of[code](E, T), this[value](T).
keyed_by_this[code](E)   :- keyed_named_fn[code](_, E), ast_node[code](E, identifier, _).
keyed_escapes[code](G) :- keyed_fn_need[code](G), not keyed_has_name[code](G).
keyed_escapes[code](G) :- keyed_named_fn[code](G, E), not keyed_callee[code](E).
keyed_escapes[code](G) :- keyed_named_fn[code](G, E), not keyed_by_this[code](E).
keyed_callee[code](E)  :- keyed_called[code](_, Q), callee[value](Q, E).

keyed_in_fn[code](X, S) :- keyed_hop[code](X, H), keyed_born[code](H, B, F), inside[tree](S, X),
                           ast_child[code](B, F, _, S), nearest_v[flow](G, X), inside[tree](S, G).
keyed_in_fn[code](X, S) :- keyed_hop[code](X, H), keyed_born[code](H, B, F), inside[tree](S, X),
                           ast_child[code](B, F, _, S), nearest_v[flow](S, X).
keyed_direct[code](X, H, J) :- keyed_hop[code](X, H), keyed_born[code](H, B, F), inside[tree](S, X),
                               ast_child[code](B, F, J, S), not keyed_in_fn[code](X, S).
keyed_is_direct[code](X, H) :- keyed_direct[code](X, H, _).
keyed_runs[code](X, H, J)   :- keyed_direct[code](X, H, J).
keyed_runs[code](X, H, J)   :- keyed_hop[code](X, H), not keyed_is_direct[code](X, H), nearest_v[flow](G, X),
                               not keyed_escapes[code](G), keyed_called[code](G, Q), keyed_runs[code](Q, H, J).
keyed_elsewhere[code](X, H) :- keyed_hop[code](X, H), not keyed_is_direct[code](X, H), nearest_v[flow](G, X),
                               keyed_escapes[code](G).
keyed_elsewhere[code](X, H) :- keyed_hop[code](X, H), not keyed_is_direct[code](X, H), nearest_v[flow](G, X),
                               keyed_called[code](G, Q), keyed_elsewhere[code](Q, H).
keyed_elsewhere[code](X, H) :- keyed_hop[code](X, H), not keyed_is_direct[code](X, H), nearest_v[flow](G, X),
                               not keyed_hop_fn[code](G, H).
keyed_elsewhere[code](X, H) :- keyed_hop[code](X, H), not keyed_is_direct[code](X, H), not nearest_v[flow](_, X).

-- AFTER: in the list that makes it, every run of the put is later
keyed_born_read[code](C, H, I) :- keyed_read_site[code](C, H, B, F, I), keyed_born[code](H, B, F).
keyed_runs_by[code](P, C)      :- keyed_born_read[code](C, H, I), keyed_put_of[code](P, H, _), keyed_runs[code](P, H, J), J <= I.
keyed_put_after[code](V, C) :- keyed_born_read[code](C, H, I), keyed_put_later[code](_, H, V, B, F, J),
                               keyed_born[code](H, B, F), I < J.
keyed_put_after[code](V, C) :- keyed_born_read[code](C, H, I), keyed_put_of[code](P, H, V), keyed_runs[code](P, H, J),
                               I < J, not keyed_runs_by[code](P, C), not keyed_elsewhere[code](P, H).

-- BEFORE: in an earlier statement of the same list, or called from one
keyed_put_before[code](V, C) :- keyed_read_site[code](C, H, B, F, I), keyed_put_site[code](_, H, V, B, F, J), J < I.
keyed_put_before[code](V, C) :- keyed_born_read[code](C, H, I), keyed_put_of[code](P, H, V), keyed_runs[code](P, H, J), J < I.

-- TAKEN OUT between the put and the read. On a field outside the constructor
-- the method may run again between them and put the value back (`keyed_noisy`):
-- a call there runs what it resolves to and all that calls; code outside the
-- model (a call nothing resolves, or one that reaches such a call,
-- `runs_outside`) reaches the method only through what it was handed or what
-- left the file: the instance, a function that runs the method, an entry.
keyed_remover[code](R, C, K, Meth) :- keyed_read_site[code](C, H, B, F, I), keyed_step[code](R, H, Meth, B, F, K),
                                      K < I, keyed_holder[code](H, P), keyed_remove(P, Meth).
keyed_remover[code](R, C, K, Meth) :- keyed_read_site[code](C, H, B, F, I), keyed_step[code](R, H, Meth, B, F, K),
                                      K < I, keyed_holder[code](H, P), keyed_store(P, Meth, _).
edb(keyed_remove).
keyed_remove(map, "delete").
keyed_remove(map, "clear").
keyed_remove(weakmap, "delete").
keyed_shared[code](C, H) :- keyed_read_site[code](C, H, B, F, _), keyed_field_ok[code](H, _, _), not keyed_born[code](H, B, F).
keyed_get_call[code](C) :- keyed_shared[code](C, H), keyed_call[code](C, H, Get, _, _, _), keyed_holder[code](H, P),
                           keyed_store(P, _, Get).
keyed_again[code](C, K, M) :- keyed_shared[code](C, H), keyed_remover[code](_, C, K, _), keyed_read_site[code](C, H, B, _, _),
                              ast_child[code](M, body, 0, B).
-- what runs between: the method's own code in the statements between, and in
-- the read's statement up to the read; a walk runs its body between entries
keyed_between[code](C, K, Q) :- keyed_again[code](C, K, M), keyed_read_site[code](C, _, B, F, I), nearest_v[flow](M, Q),
                                inside[tree](S, Q), ast_child[code](B, F, L, S), K < L, L <= I, Q != C,
                                not inside[tree](Q, C).
keyed_between[code](C, K, Q) :- keyed_again[code](C, K, _), keyed_read_site[code](C, _, B, F, I), ast_child[code](B, F, L, Q),
                                K < L, L < I.
keyed_between[code](C, K, Q) :- keyed_again[code](C, K, _), not keyed_get_call[code](C), inside[tree](C, Q).
keyed_target[code](M) :- keyed_again[code](_, _, M).
keyed_runs_m[code](M, M) :- keyed_target[code](M).
-- what a call may run, asked backwards from the functions in question along
-- the call graph (`eff_reaches` is reach inside its cycles only); another
-- file's function brings its answer with it (`sx_keyed_runs`, `sx_runs_out`)
keyed_runs_m[code](F, M) :- eff_calls[code](F, G), keyed_runs_m[code](G, M).
keyed_runs_out[code](F) :- runs_outside[code](F).
keyed_runs_out[code](F) :- eff_calls[code](F, G), keyed_runs_out[code](G).
keyed_crosses[code](F) :- eff_calls[code](F, G), at[tree](F, File, _), not at[tree](G, File, _).
keyed_crosses[code](F) :- eff_calls[code](F, G), keyed_crosses[code](G).
keyed_hand_need[code](G) :- keyed_runs_m[code](G, _).
keyed_hand_need[code](G) :- keyed_once_need[code](G).
keyed_hand_need[code](I) :- keyed_once_need[code](G), class_method_of[flow](CD, G), inst_of[flow](I, CD).
keyed_hand_need[code](I) :- keyed_runs_m[code](G, _), class_method_of[flow](CD, G), inst_of[flow](I, CD).
keyed_handed[code](V) :- keyed_hand_need[code](V), sx_esc[surface](V).
keyed_handed[code](V) :- keyed_hand_need[code](V), may_be_node[flow](A, V), arg_at[flow](Q, _, A), runs_unknown[code](Q).
keyed_handed[code](V) :- keyed_hand_need[code](V), may_be_node[flow](O, V), object_of[code](N, O),
                         callee_of[code](Q, N), runs_unknown[code](Q).
keyed_open_to[code](M) :- keyed_runs_m[code](G, M), keyed_handed[code](G).
keyed_open_to[code](M) :- keyed_runs_m[code](G, M), entry_point[code](G), not class_method_of[flow](_, G).
keyed_open_to[code](M) :- keyed_runs_m[code](G, M), class_method_of[flow](CD, G), not ast_attr[code](G, accessibility, "private"),
                          inst_of[flow](I, CD), keyed_handed[code](I).
keyed_noisy[code](C, K) :- keyed_between[code](C, K, Q), keyed_again[code](C, K, M), resolves[code](Q, M).
keyed_noisy[code](C, K) :- keyed_between[code](C, K, Q), keyed_again[code](C, K, M), resolves[code](Q, G),
                           keyed_runs_m[code](G, M).
-- An `await` or a `yield` hands the turn to whatever is queued; only another
-- run of the method puts its own put back. At an `await` that run must have
-- started while this one waits (`keyed_overlap`): a call of the method nobody
-- waited for (`await m()`) and another call after it, or such a call run more
-- than once, or a caller whose own runs overlap, or a call nobody knows. Runs
-- one after another, each awaited, do not overlap. A generator's runs live
-- until they are exhausted, which the model does not follow, so at a `yield`
-- any second run counts (`keyed_many`).
keyed_noisy[code](C, K) :- keyed_between[code](C, K, Q), awaits[value](Q, _),
                           keyed_again[code](C, K, M), keyed_overlap[code](M).
keyed_noisy[code](C, K) :- keyed_between[code](C, K, Q), ast_node[code](Q, yield_expression, _),
                           keyed_again[code](C, K, M), keyed_many[code](M).
keyed_once_need[code](M) :- keyed_between[code](C, K, Q), awaits[value](Q, _), keyed_again[code](C, K, M).
keyed_once_need[code](M) :- keyed_between[code](C, K, Q), ast_node[code](Q, yield_expression, _), keyed_again[code](C, K, M).
keyed_once_need[code](F) :- keyed_caller[code](_, _, F).
keyed_caller[code](G, Q, F) :- keyed_called_at[code](G, Q), nearest_fn[code](F, Q).
keyed_called_at[code](G, Q) :- keyed_once_need[code](G), resolves[code](Q, G).
keyed_looped[code](Q) :- keyed_called_at[code](_, Q), inside[tree](Lp, Q), eff_loop[code](Lp),
                         nearest_fn[code](F, Q), inside[tree](F, Lp).
keyed_looped[code](Q) :- keyed_called_at[code](_, Q), not in_fn[code](Q), inside[tree](Lp, Q),
                         eff_loop[code](Lp).
keyed_many[code](G) :- keyed_called_at[code](G, Q1), keyed_called_at[code](G, Q2), Q1 != Q2.
keyed_many[code](G) :- keyed_called_at[code](G, Q), keyed_looped[code](Q).
keyed_many[code](G) :- keyed_caller[code](G, _, F), keyed_many[code](F).
keyed_many[code](G) :- keyed_overlap[code](G).
keyed_unknown_call[code](G) :- keyed_once_need[code](G), keyed_handed[code](G).
keyed_unknown_call[code](G) :- keyed_once_need[code](G), entry_point[code](G), not class_method_of[flow](_, G).
keyed_unknown_call[code](G) :- keyed_once_need[code](G), class_method_of[flow](CD, G),
                               not ast_attr[code](G, accessibility, "private"), inst_of[flow](I, CD), keyed_handed[code](I).
keyed_awaited[code](Q) :- keyed_called_at[code](_, Q), awaits[value](_, Q).
keyed_left[code](G, Q) :- keyed_called_at[code](G, Q), not keyed_awaited[code](Q).
keyed_overlap[code](G) :- keyed_unknown_call[code](G).
keyed_overlap[code](G) :- keyed_left[code](G, Q1), keyed_called_at[code](G, Q2), Q1 != Q2.
keyed_overlap[code](G) :- keyed_left[code](G, Q), keyed_looped[code](Q).
keyed_overlap[code](G) :- keyed_left[code](G, Q), keyed_caller[code](G, Q, F), keyed_many[code](F).
keyed_overlap[code](G) :- keyed_caller[code](G, _, F), keyed_overlap[code](F).
keyed_overlap[code](G) :- keyed_once_need[code](G), eff_reaches[code](G, G).
keyed_noisy[code](C, K) :- keyed_between[code](C, K, Q), runs_unknown[code](Q),
                           keyed_again[code](C, K, M), keyed_open_to[code](M).
keyed_noisy[code](C, K) :- keyed_between[code](C, K, Q), resolves[code](Q, G), keyed_runs_out[code](G),
                           keyed_again[code](C, K, M), keyed_open_to[code](M).
keyed_out[code](V, C, P, R, K, Meth) :- keyed_put_before[code](V, C), keyed_read_site[code](C, H, B, F, I),
                                        keyed_put_site[code](P, H, V, B, F, J), keyed_remover[code](R, C, K, Meth), J < K.
keyed_taken_out[code](V, C, R) :- keyed_out[code](V, C, _, R, K, "clear"), not keyed_noisy[code](C, K).
keyed_taken_out[code](V, C, R) :- keyed_out[code](V, C, P, R, K, _), keyed_key[code](P, Key), keyed_key[code](R, Key),
                                  not keyed_noisy[code](C, K).
keyed_taken_out[code](V, C, R) :- keyed_out[code](V, C, P, R, K, _), keyed_same_name[code](P, R), keyed_same_name[code](P, C),
                                  not keyed_noisy[code](C, K).

-- TAKEN OUT BY A CALL between the put and the read: a statement that is a call
-- of one function that removes the key (or clears) whenever it runs takes the
-- put out; a call that may run a removal of a key that may be the same, or an
-- await or a yield where one exists, leaves the put in an order not known.
keyed_dsure_at[code](G, H, D, K) :- keyed_body_stmt[code](G, K, D), keyed_drop[code](D, H).
keyed_dsure_at[code](G, H, D, K) :- keyed_body_stmt[code](G, K, Q), keyed_one_target[code](Q, G2), keyed_dsure[code](G2, H, D).
keyed_dsure[code](G, H, D) :- keyed_dsure_at[code](G, H, D, K), not keyed_early[code](G, K).
keyed_vspan[code](V, C, P, S, M) :- keyed_read_site[code](C, H, B, F, I), keyed_put_site[code](P, H, V, B, F, J), J < I,
                                    ast_child[code](B, F, L, S), J < L, L < I, nearest_v[flow](M, B).
keyed_vspan[code](V, C, P, S, top) :- keyed_read_site[code](C, H, B, F, I), keyed_put_site[code](P, H, V, B, F, J), J < I,
                                      ast_child[code](B, F, L, S), J < L, L < I, not in_fn[code](B).
keyed_vbetween[code](V, C, P, Q) :- keyed_vspan[code](V, C, P, S, M), nearest_v[flow](M, Q), inside[tree](S, Q).
keyed_vbetween[code](V, C, P, Q) :- keyed_vspan[code](V, C, P, S, top), inside[tree](S, Q), not in_fn[code](Q).
keyed_vdiffers[code](D, P) :- keyed_vdrop_cand[code](D, P), keyed_key[code](D, K1), keyed_key[code](P, K2), K1 != K2.
keyed_vdrop_cand[code](D, P) :- keyed_vbetween[code](_, C, P, _), keyed_read_site[code](C, H, _, _, _), keyed_drop[code](D, H).
keyed_vdrop_at[code](V, C, Q, D) :- keyed_vbetween[code](V, C, P, Q), keyed_vdrop_cand[code](D, P), not keyed_vdiffers[code](D, P).
keyed_vdrop_may[code](V, C) :- keyed_vdrop_at[code](V, C, Q, D), resolves[code](Q, G), nearest_v[flow](G2, D), keyed_drop_runs[code](G, G2),
                               not keyed_vsure_out[code](V, C, Q).
keyed_vdrop_may[code](V, C) :- keyed_vdrop_at[code](V, C, Q, _), awaits[value](Q, _).
keyed_vdrop_may[code](V, C) :- keyed_vdrop_at[code](V, C, Q, _), ast_node[code](Q, yield_expression, _).
keyed_vsure_out[code](V, C, Q) :- keyed_vbetween[code](V, C, P, Q), ast_child[code](S, expression, 0, Q), ast_node[code](S, expression_statement, _),
                                  keyed_read_site[code](C, H, B, F, _), ast_child[code](B, F, _, S), keyed_one_target[code](Q, G),
                                  keyed_dsure[code](G, H, D), keyed_dsure_key[code](D, P).
keyed_dsure_key[code](D, P) :- keyed_on[flow](D, _, _, "clear"), keyed_vdrop_cand[code](D, P).
keyed_dsure_key[code](D, P) :- keyed_vdrop_cand[code](D, P), keyed_key[code](D, K), keyed_key[code](P, K).
keyed_taken_out[code](V, C, Q) :- keyed_vsure_out[code](V, C, Q), not keyed_noisy_at[code](C, Q).
keyed_noisy_at[code](C, Q) :- keyed_vsure_out[code](_, C, Q), keyed_read_site[code](C, H, B, F, _), ast_child[code](B, F, L, S),
                              inside[tree](S, Q), keyed_noisy[code](C, L).

-- PRESENT AT A GET: a put of the same key for certain, in a statement of its
-- own earlier in the list, ran; nothing between them may have taken it out (a
-- delete or a clear of the collection by any name whose key may be the same,
-- `keyed_drop`): none written in the statements between, none in a function a
-- call between may run, none run by code outside the model that was handed the
-- collection or such a function, none queued behind an `await`, and on a field
-- no other run of the method (`keyed_noisy` over the same span). Elsewhere a
-- get may find no entry and read `undefined`.
keyed_fill_cand[code](C, P, J) :- keyed_read_site[code](C, H, B, F, I), keyed_call[code](C, H, Get, _, _, _),
                                  keyed_holder[code](H, Pk), keyed_store(Pk, Put, Get),
                                  keyed_step[code](P, H, Put, B, F, J), J < I.
keyed_want[code](A) :- keyed_drop[code](D, _), keyed_key_arg[code](D, A).
keyed_want[code](A) :- keyed_put_of[code](P, _, _), keyed_key_arg[code](P, A).
keyed_want[code](A) :- keyed_read_site[code](C, _, _, _, _), keyed_key_arg[code](C, A).
keyed_fill[code](C, J) :- keyed_fill_cand[code](C, P, J), keyed_key[code](P, K), keyed_key[code](C, K).
-- or a statement that is nothing but a call of one function that puts it for
-- certain whenever it runs (`keyed_sure`): the put, or such a call, is a
-- statement of its body with no `return` in a statement before it, and nothing
-- the function runs removes from the collection. A method is called on `this`.
keyed_stmt_need[code](G) :- keyed_fn_need[code](G).
keyed_stmt_need[code](G) :- keyed_drop_runs[code](G, _).
keyed_body_stmt[code](G, K, X) :- keyed_stmt_need[code](G), body[value](G, Gb), ast_child[code](Gb, body, K, S),
                                  ast_node[code](S, expression_statement, _), ast_child[code](S, expression, 0, X).
keyed_early[code](G, K) :- keyed_body_stmt[code](G, K, _), nearest_v[flow](G, R), exits[value](R, return),
                           body[value](G, Gb), ast_child[code](Gb, body, L, S), L < K, inside[tree](S, R).
keyed_early[code](G, K) :- keyed_body_stmt[code](G, K, _), body[value](G, Gb), ast_child[code](Gb, body, L, R),
                           L < K, exits[value](R, return).
keyed_two_targets[code](Q) :- resolves[code](Q, A), resolves[code](Q, B), A != B.
-- a call of a function of another file reaches the collection only where it left
-- its file, and there `keyed_lost` holds whatever the call does
keyed_local_call[code](Q, G) :- resolves[code](Q, G), not keyed_two_targets[code](Q), at[tree](Q, F, _), at[tree](G, F, _).
keyed_this_call[code](Q) :- callee_of[code](Q, N), object_of[code](N, T), this[value](T).
keyed_one_target[code](Q, G) :- keyed_local_call[code](Q, G), not class_method_of[flow](_, G),
                                not async[value](G), not generator[value](G).
keyed_one_target[code](Q, G) :- keyed_local_call[code](Q, G), class_method_of[flow](_, G),
                                keyed_this_call[code](Q), not async[value](G), not generator[value](G).
keyed_one_target[code](Q, G) :- keyed_local_call[code](Q, G), private_method[code](G),
                                keyed_this_call[code](Q), not async[value](G), not generator[value](G).
keyed_sure_at[code](G, H, P, K) :- keyed_body_stmt[code](G, K, P), keyed_put_of[code](P, H, _).
keyed_sure_at[code](G, H, P, K) :- keyed_body_stmt[code](G, K, Q), keyed_one_target[code](Q, G2), keyed_sure[code](G2, H, P).
keyed_g_drops[code](G, H) :- keyed_hop_fn[code](G, H), keyed_drop[code](D, H), nearest_v[flow](G, D).
keyed_g_drops[code](G, H) :- keyed_hop_fn[code](G, H), keyed_drop[code](D, H), nearest_v[flow](G2, D), keyed_drop_runs[code](G, G2).
keyed_drop_runs[code](G, G) :- keyed_drop[code](D, _), nearest_v[flow](G, D).
keyed_drop_runs[code](F, G) :- eff_calls[code](F, H), keyed_drop_runs[code](H, G).
keyed_sure[code](G, H, P) :- keyed_sure_at[code](G, H, P, K), not keyed_early[code](G, K), not keyed_g_drops[code](G, H).
keyed_fill_call[code](C, P, J) :- keyed_read_site[code](C, H, B, F, I), keyed_call[code](C, H, _, _, _, _),
                                  ast_child[code](B, F, J, S), J < I, ast_node[code](S, expression_statement, _),
                                  ast_child[code](S, expression, 0, Q), keyed_one_target[code](Q, G), keyed_sure[code](G, H, P).
keyed_fill[code](C, J) :- keyed_fill_call[code](C, P, J), keyed_key[code](P, K), keyed_key[code](C, K).
-- on a field, a method reads what the constructor put for certain: every
-- instance ran it first. Unless a removal of the key may run anywhere else
-- (methods run in any order), the method may run in the constructor before the
-- put, or the collection left the model.
keyed_ctor_put[code](C, P, J) :- keyed_shared[code](C, H), keyed_call[code](C, H, Get, _, _, _), keyed_holder[code](H, Pk),
                                 keyed_store(Pk, Put, Get), keyed_born[code](H, Body, body), keyed_step[code](P, H, Put, Body, body, J).
keyed_ctor_put[code](C, P, J) :- keyed_shared[code](C, H), keyed_call[code](C, H, _, _, _, _), keyed_born[code](H, Body, body),
                                 ast_child[code](Body, body, J, S), ast_node[code](S, expression_statement, _),
                                 ast_child[code](S, expression, 0, Q), keyed_one_target[code](Q, G), keyed_sure[code](G, H, P).
keyed_fill_ctor[code](C, J) :- keyed_ctor_put[code](C, P, J), keyed_key[code](P, K), keyed_key[code](C, K).
keyed_pair[code](C, D) :- keyed_fill_ctor[code](C, _), keyed_read_site[code](C, H, _, _, _), keyed_drop[code](D, H).
keyed_before_put[code](C, J, Q) :- keyed_fill_ctor[code](C, J), keyed_read_site[code](C, H, _, _, _), keyed_born[code](H, Body, body),
                                   body[value](Ct, Body), ast_child[code](Body, body, L, S), L < J,
                                   nearest_v[flow](Ct, Q), inside[tree](S, Q).
keyed_lost_ctor[code](C, J) :- keyed_fill_ctor[code](C, J), keyed_pair[code](C, D), not keyed_differs[code](D, C),
                               not keyed_drop_early[code](C, J, D), not keyed_healed[code](C, D).
keyed_drop_early[code](C, J, D) :- keyed_before_put[code](C, J, D).
keyed_target[code](M) :- keyed_fill_ctor[code](C, _), keyed_read_site[code](C, _, B, _, _), ast_child[code](M, body, 0, B).
keyed_lost_ctor[code](C, J) :- keyed_before_put[code](C, J, Q), keyed_read_site[code](C, _, B, _, _), ast_child[code](M, body, 0, B),
                               resolves[code](Q, G), keyed_runs_m[code](G, M).
keyed_lost_ctor[code](C, J) :- keyed_before_put[code](C, J, Q), keyed_read_site[code](C, _, B, _, _), ast_child[code](M, body, 0, B),
                               runs_unknown[code](Q), keyed_open_to[code](M).
keyed_lost_ctor[code](C, J) :- keyed_fill_ctor[code](C, J), keyed_read_site[code](C, H, _, _, _), keyed_made[code](H, X),
                               keyed_handed[code](X).
keyed_present[code](C) :- keyed_fill_ctor[code](C, J), not keyed_lost_ctor[code](C, J).
keyed_filled[code](H)  :- keyed_holder[code](H, _).
keyed_made[code](H, X) :- keyed_filled[code](H), ast_child[code](H, init, 0, X).
keyed_made[code](H, X) :- keyed_filled[code](H), ast_child[code](H, right, 0, X).
keyed_made[code](H, X) :- keyed_filled[code](H), ast_child[code](H, value, 0, X).
-- a removal in another file is not followed: where the collection left its
-- file, a call between that reaches another file may remove anything
keyed_drop[code](D, H) :- keyed_made[code](H, X), keyed_on[flow](D, X, P, Meth), keyed_remove(P, Meth),
                          at[tree](H, File, _), at[tree](D, File, _).
keyed_pair[code](C, D) :- keyed_fill[code](C, _), keyed_read_site[code](C, H, _, _, _), keyed_drop[code](D, H).
keyed_differs[code](D, C) :- keyed_pair[code](C, D), keyed_key[code](D, K1), keyed_key[code](C, K2), K1 != K2.
keyed_drop_may[code](C, J, D) :- keyed_fill[code](C, J), keyed_pair[code](C, D), not keyed_differs[code](D, C),
                                 not keyed_healed[code](C, D).
keyed_drop_fn[code](G) :- keyed_pair[code](C, D), not keyed_differs[code](D, C), nearest_v[flow](G, D).
-- a removal its own function undoes: a later statement of that function puts
-- the read's key back for certain, and nothing from the removal's statement to
-- that put may run the read (the read itself, a call that reaches its
-- function, code outside the model handed it, an await or a yield). Whenever
-- the function returns, the entry is there.
keyed_heal_at[code](C, D, G, L, K) :- keyed_pair[code](C, D), nearest_v[flow](G, D), body[value](G, Gb),
                                      ast_child[code](Gb, body, L, S), inside[tree](S, D), keyed_read_site[code](C, H, _, _, _),
                                      keyed_sure_at[code](G, H, P, K), L < K, not keyed_early[code](G, K),
                                      keyed_key[code](P, Kk), keyed_key[code](C, Kk).
keyed_heal_fn[code](C, F) :- keyed_heal_at[code](C, _, _, _, _), nearest_v[flow](F, C).
keyed_target[code](F) :- keyed_heal_fn[code](_, F).
keyed_heal_span[code](C, D, Q) :- keyed_heal_at[code](C, D, G, L, K), nearest_v[flow](G, Q), body[value](G, Gb),
                                  ast_child[code](Gb, body, J, S), L <= J, J <= K, inside[tree](S, Q).
keyed_heal_broken[code](C, D) :- keyed_heal_span[code](C, D, C).
keyed_heal_broken[code](C, D) :- keyed_heal_span[code](C, D, Q), resolves[code](Q, G), keyed_heal_fn[code](C, F),
                                 keyed_runs_m[code](G, F).
keyed_heal_broken[code](C, D) :- keyed_heal_span[code](C, D, Q), runs_unknown[code](Q), keyed_heal_fn[code](C, F),
                                 keyed_open_to[code](F).
keyed_heal_broken[code](C, D) :- keyed_heal_span[code](C, D, Q), awaits[value](Q, _).
keyed_heal_broken[code](C, D) :- keyed_heal_span[code](C, D, Q), ast_node[code](Q, yield_expression, _).
keyed_healed[code](C, D) :- keyed_heal_at[code](C, D, _, _, _), not keyed_heal_broken[code](C, D).
keyed_target[code](G)  :- keyed_drop_fn[code](G).
keyed_hand_need[code](X) :- keyed_made[code](_, X).
-- the span's own code: the statements after the put up to the read, outside
-- any function written there
keyed_pspan[code](C, J, S, M) :- keyed_fill[code](C, J), keyed_read_site[code](C, _, B, F, I), ast_child[code](B, F, L, S),
                                 J < L, L <= I, nearest_v[flow](M, B).
keyed_pspan_top[code](C, J, S) :- keyed_fill[code](C, J), keyed_read_site[code](C, _, B, F, I), ast_child[code](B, F, L, S),
                                  J < L, L <= I, not in_fn[code](B).
keyed_pbetween[code](C, J, Q) :- keyed_pspan[code](C, J, S, M), nearest_v[flow](M, Q), inside[tree](S, Q),
                                 Q != C, not inside[tree](Q, C).
keyed_pbetween[code](C, J, Q) :- keyed_pspan_top[code](C, J, S), inside[tree](S, Q), not in_fn[code](Q),
                                 Q != C, not inside[tree](Q, C).
keyed_lost[code](C, J) :- keyed_drop_may[code](C, J, D), keyed_read_site[code](C, _, B, F, I), inside[tree](S, D),
                          ast_child[code](B, F, L, S), J < L, L <= I.
keyed_lost[code](C, J) :- keyed_drop_may[code](C, J, D), nearest_v[flow](G, D), keyed_pbetween[code](C, J, Q),
                          resolves[code](Q, G).
keyed_lost[code](C, J) :- keyed_drop_may[code](C, J, D), nearest_v[flow](G, D), keyed_pbetween[code](C, J, Q),
                          resolves[code](Q, F), keyed_drop_runs[code](F, G).
keyed_lost[code](C, J) :- keyed_drop_may[code](C, J, D), nearest_v[flow](G, D), keyed_pbetween[code](C, J, Q),
                          awaits[value](Q, _).
keyed_lost[code](C, J) :- keyed_drop_may[code](C, J, D), nearest_v[flow](G, D), keyed_pbetween[code](C, J, Q),
                          ast_node[code](Q, yield_expression, _).
keyed_outside_at[code](C, J) :- keyed_pbetween[code](C, J, Q), runs_unknown[code](Q).
keyed_outside_at[code](C, J) :- keyed_pbetween[code](C, J, Q), resolves[code](Q, G), keyed_runs_out[code](G).
keyed_lost[code](C, J) :- keyed_outside_at[code](C, J), keyed_read_site[code](C, H, _, _, _), keyed_made[code](H, X),
                          keyed_handed[code](X).
keyed_leaves[code](C, J) :- keyed_pbetween[code](C, J, Q), resolves[code](Q, G), at[tree](C, File, _),
                            not at[tree](G, File, _).
keyed_leaves[code](C, J) :- keyed_pbetween[code](C, J, Q), resolves[code](Q, G), at[tree](C, File, _),
                            at[tree](G, File, _), keyed_crosses[code](G).
keyed_lost[code](C, J) :- keyed_leaves[code](C, J), keyed_read_site[code](C, H, _, _, _), keyed_made[code](H, X),
                          sx_esc[surface](X).
keyed_lost[code](C, J) :- keyed_outside_at[code](C, J), keyed_drop_may[code](C, J, D), nearest_v[flow](G, D),
                          keyed_open_to[code](G).
keyed_again[code](C, J, M) :- keyed_fill[code](C, J), keyed_shared[code](C, H), keyed_read_site[code](C, H, B, _, _),
                              ast_child[code](M, body, 0, B).
keyed_lost[code](C, J) :- keyed_fill[code](C, J), keyed_noisy[code](C, J).
keyed_present[code](C) :- keyed_fill[code](C, J), not keyed_lost[code](C, J).

-- THE FLOW READS A COLLECTION WHOLE: a get, a walk, a forEach see every put of
-- a key of the value they read. The order above judges the flow (which calls
-- reach what, which keys are one), so what it rules out cannot feed the flow
-- back; it is a view over it, `read_holds_lit` / `read_holds_node` below.
keyed_read[flow](C, V)  :- keyed_get[flow](C, X, K), keyed_put[flow](X, K, V).
may_be_node[flow](C, N) :- may_be_node[flow](V, N), keyed_read[flow](C, V).
may_be_lit[flow](C, L)  :- may_be_lit[flow](V, L), keyed_read[flow](C, V).

-- the walks: position 0 of the head's pattern is a key, position 1 a value;
-- forEach's callback takes (value, key)
keyed_walk[flow](S, D, X) :- iterates[value](S, H, R),
                             ast_child[code](H, declarations, 0, D),
                             may_be_node[flow](R, X), keyed_obj[flow](X, _).
keyed_walk_at[flow](E, D, Pos) :- keyed_walk[flow](_, D, _), destructures_at[code](D, Local, Pos, File),
                                  ident_in[code](E, Local, File), sees_binder[code](E, D).
may_be_node[flow](E, N) :- keyed_walk[flow](_, D, X), keyed_put[flow](X, _, V), may_be_node[flow](V, N),
                           keyed_walk_at[flow](E, D, 1).
may_be_lit[flow](E, L)  :- keyed_walk[flow](_, D, X), keyed_put[flow](X, _, V), may_be_lit[flow](V, L),
                           keyed_walk_at[flow](E, D, 1).
may_be_lit[flow](E, K)  :- keyed_walk[flow](_, D, X), keyed_put[flow](X, K, _), keyed_walk_at[flow](E, D, 0).

sx_keach[surface](C, F, X) :- keyed_on[flow](C, X, _, "forEach"), arg_at[flow](C, 0, A), may_be_node[flow](A, F),
                              fn_value[flow](F).
keyed_each_at[flow](U, C, X, Pos) :- sx_keach[surface](C, F, X), param_of[flow](F, Pos, Name), param_use[flow](F, Name, U).
may_be_node[flow](U, N) :- keyed_each_at[flow](U, _, X, 0), keyed_put[flow](X, _, V), may_be_node[flow](V, N).
may_be_lit[flow](U, L)  :- keyed_each_at[flow](U, _, X, 0), keyed_put[flow](X, _, V), may_be_lit[flow](V, L).
may_be_lit[flow](U, K)  :- keyed_each_at[flow](U, _, X, 1), keyed_put[flow](X, K, _).

-- WHAT A READ HOLDS AT ITS MOMENT: the flow's value, but at a read of a
-- collection only the puts the order leaves it.
keyed_read_ordered[flow](C, V)   :- keyed_read[flow](C, V), keyed_put_before[code](V, C), not keyed_vdrop_may[code](V, C),
                                    not keyed_taken_out[code](V, C, _).
keyed_read_unordered[flow](C, V) :- keyed_read[flow](C, V), keyed_put_before[code](V, C), not keyed_taken_out[code](V, C, _),
                                    keyed_vdrop_may[code](V, C).
keyed_read_unordered[flow](C, V) :- keyed_read[flow](C, V), not keyed_put_before[code](V, C), not keyed_put_after[code](V, C).
keyed_holds[flow](C, V) :- keyed_read_ordered[flow](C, V).
keyed_holds[flow](C, V) :- keyed_read_unordered[flow](C, V).
keyed_holds[flow](E, V) :- keyed_walk_at[flow](E, D, 1), keyed_walk[flow](S, D, X), keyed_put[flow](X, _, V),
                           not keyed_put_after[code](V, S), not keyed_taken_out[code](V, S, _).
keyed_holds[flow](U, V) :- keyed_each_at[flow](U, C, X, 0), keyed_put[flow](X, _, V),
                           not keyed_put_after[code](V, C), not keyed_taken_out[code](V, C, _).
keyed_holds_key[flow](E, K) :- keyed_walk_at[flow](E, D, 0), keyed_walk[flow](S, D, X), keyed_put[flow](X, K, V),
                               not keyed_put_after[code](V, S), not keyed_taken_out[code](V, S, _).
keyed_holds_key[flow](U, K) :- keyed_each_at[flow](U, C, X, 1), keyed_put[flow](X, K, V),
                               not keyed_put_after[code](V, C), not keyed_taken_out[code](V, C, _).
keyed_viewed[flow](C) :- keyed_read[flow](C, _).
keyed_viewed[flow](E) :- keyed_walk_at[flow](E, _, _).
keyed_viewed[flow](U) :- keyed_each_at[flow](U, _, _, _).
read_holds_node[flow](E, N) :- may_be_node[flow](E, N), not keyed_viewed[flow](E).
read_holds_node[flow](E, N) :- keyed_holds[flow](E, V), may_be_node[flow](V, N).
read_holds_lit[flow](E, L)  :- may_be_lit[flow](E, L), not keyed_viewed[flow](E), not member_viewed[flow](E).
read_holds_lit[flow](N, L)  :- member_viewed[flow](N), may_be_lit[flow](N, L), L != undefined.
read_holds_lit[flow](N, undefined) :- member_may_lack[flow](N).
read_holds_lit[flow](N, undefined) :- member_unset[flow](N, O, Key), member_value[flow](O, Key, V), may_be_lit[flow](V, undefined).
read_holds_lit[flow](E, L)  :- keyed_holds[flow](E, V), may_be_lit[flow](V, L).
read_holds_lit[flow](E, K)  :- keyed_holds_key[flow](E, K).
read_holds_lit[flow](C, undefined) :- keyed_read[flow](C, _), not keyed_present[code](C).

-- =========================================================================
-- 8. READING A PROPERTY OFF A VALUE
--
-- An object literal and a class are identical to the question "can it answer
-- `.k`". `member_value` names the node a member HOLDS and judges nothing about
-- it; what that node may be is `may_be_lit`/`may_be_node`, one step later.
obj_lit[code](O)  :- object[value](O), not decl[value](O, enum).
-- the members of an object literal: a property holds a value, a method is itself a function
obj_prop[code](O, P, V) :- obj_lit[code](O), has[value](O, P), value[value](P, V).
obj_method[code](O, M)  :- obj_lit[code](O), has[value](O, M), fn_node[code](M).
obj_like[flow](O) :- obj_lit[code](O).
obj_like[flow](O) :- class[value](O).
class_like[flow](O) :- class[value](O).

-- An INSTANCE is not its class. The class node is the class object (`C`, and
-- `this` in a static member); its body node stands for every instance (`new
-- C()`, and `this` in an instance member), which answers the prototype half
-- and whatever is written onto an instance.
inst_of[flow](I, CD)          :- class_like[flow](CD), ast_child[code](CD, body, 0, I).
member_value[flow](I, Key, V) :- inst_of[flow](I, CD), class_member_proto[flow](CD, Key, V).
member_plain[flow](I, Key, V) :- inst_of[flow](I, _), member_value[flow](I, Key, V).

member_value[flow](O, Key, V) :- obj_method[code](O, M), key_name[code](M, Key), V = M.
member_value[flow](O, Key, V) :- obj_prop[code](O, P, V), key_name[code](P, Key).
member_value[flow](CD, Key, M) :- class_method[code](CD, M), key_name[code](M, Key).

-- A member written is a member read, flow-insensitively — `assigns` one step
-- over. `plain_assign` is load-bearing: `+=` evaluates to a sum. The object may be
-- another file's: the write is published for it (rules/js-surface.rofl) and read back.
sx_mwrite[surface](O, Key, V) :- may_be_node[flow](Obj, O), object_of[code](L, Obj),
                                 selects[flow](L, Key),
                                 ast_child[code](A, left, 0, L), plain_assign[flow](A), not store_sym[flow](A),
                                 ast_child[code](A, right, 0, V).
member_value[flow](O, Key, V) :- sx_mwrite[surface](O, Key, V).

-- Inheritance walks `super_of`, and `not own_key` makes it a LOOKUP rather
-- than a union: a subclass declaring `hold` answers with its own. `own_key`
-- reads the class body only, so the negation is stratified; it leads with
-- `key_name` because that relation is derived and a leading kind scan re-ran
-- every round. The negation is written last: until 2026-09-05 the evaluator
-- read it with `Key` unbound as "no own key at all"; the kernel now defers a
-- negation until its variables are bound, and the order is kept for the reader.
own_key[flow](CD, Key)         :- key_name[code](M, Key), class_method[code](CD, M).
member_value[flow](CD, Key, V) :- super_of[flow](CD, SD),
                                  member_value[flow](SD, Key, V),
                                  not own_key[flow](CD, Key).

-- The key an expression selects. Static and computed collapse here:
-- `may_be_lit` closes the distance for `o[k]`.
member_node_v[flow](N)      :- object_of[code](N, _).
selects[flow](N, Key)       :- prop_name[code](N, _, Key).
computed_key[code](N, P)    :- member_expr[value](N, _, P).
selects[flow](N, Key)       :- may_be_lit[flow](P, Key), computed_key[code](N, P).
selects[flow](N, Key)       :- symbol_ref[code](P, Key), computed_key[code](N, P).

-- WHAT AN OBJECT LACKS: an object literal with no spread and no computed key
-- shows every key it is made with. Read at a key it was not made with and
-- `Object.prototype` lacks, through whatever reaches it (a `const`, an alias, a
-- parameter, a return), it may be `undefined`. A literal of another file is
-- not followed: its keys reach this file only through the flow, and a negation
-- over them would close a cycle with the flow that carries the object here.
-- A class field with no initialiser is published with its class, so an
-- instance of a class of any file reads it `undefined`. A write of the key onto
-- the object (`member_value`) may run before the read or after it: writes onto
-- an object are not ordered, so such a read is `member_unset_written`.
obj_open_own[code](O) :- hidden_call_pos[code](S, accessor_call), ast_child[code](O, properties, _, S).
obj_open_own[code](O) :- ast_node[code](O, object_expression, _), ast_child[code](O, properties, _, P),
                         ast_attr[code](P, computed, true).
obj_own_key[code](O, Key) :- key_name[code](P, Key), has[value](O, P), obj_lit[code](O).
member_unset[flow](N, O, Key) :- member_at[flow](N, _, O, Key), at[tree](N, F, _), ast_node[code](O, object_expression, F),
                                 not ast_child[code](_, left, 0, N), not obj_open_own[code](O), not obj_own_key[code](O, Key),
                                 not lib_member(object, Key, _), Key != "__proto__".
field_unset_decl[code](CB, Key) :- ast_node[code](Q, class_property, _), not ast_child[code](Q, value, 0, _),
                                   ast_attr[code](Q, static, false), key_name[code](Q, Key),
                                   ast_child[code](CB, body, _, Q).
class_unset_field[flow](CD, Key) :- field_unset_decl[code](CB, Key), ast_child[code](CD, body, 0, CB).
member_unset[flow](N, I, Key) :- class_unset_field[flow](CD, Key), inst_of[flow](I, CD), member_at[flow](N, _, I, Key),
                                 not ast_child[code](_, left, 0, N).
may_be_lit[flow](N, undefined) :- member_unset[flow](N, _, _).
member_unset_written[flow](N) :- member_unset[flow](N, O, Key), member_value[flow](O, Key, _).

-- WHEN A WRITE ONTO AN OBJECT HAS RUN (a view, like a Map's order): a key the
-- object is not made with is there for certain where a write of it ran before
-- the read and no `delete` of it may run on that object anywhere.
--   On a field, the constructor writes `this.k = v` in a statement of its own
--   body with no `return` before it; every instance ran it, so a read is after
--   it unless the read is constructor code before it, or the constructor runs
--   the read's function before it (a call that reaches it, `super()` among
--   them), or hands the instance or a function made there to code outside the
--   model before it (`member_ctor_open`).
--   On a `const` object literal, `o.k = v` is a statement of the list that
--   binds it, before the read's statement, and the read is in the same function
--   (a nested function may run anywhere, a declaration even before it).
member_assign[code](S, T, Key, A) :- ast_node[code](S, expression_statement, _), ast_child[code](S, expression, 0, A),
                                    assign[value](A, L, R), gives[value](A, R), prop_name[code](L, T, Key).
member_dropped[flow](O, Key) :- unary[value](U, "delete", N), member_at[flow](N, _, O, Key).
member_ctor_set[code](Body, Key, J) :- field_unset_decl[code](CB, Key), keyed_ctor[code](CB, Body), ast_child[code](Body, body, J, S),
                                      member_assign[code](S, T, Key, _), this[value](T).
member_ctor_early[code](Body, J) :- member_ctor_set[code](Body, _, J), body[value](Ct, Body), nearest_v[flow](Ct, R),
                                   exits[value](R, return), ast_child[code](Body, body, L, S), L < J, inside[tree](S, R).
member_ctor_before[code](Body, J, X) :- member_ctor_set[code](Body, _, J), ast_child[code](Body, body, L, S), L <= J,
                                        inside[tree](S, X).
member_ctor_this[code](Body, J) :- member_ctor_before[code](Body, J, T), this[value](T),
                                   not object_of[code](_, T).
member_ctor_this[code](Body, J) :- member_ctor_before[code](Body, J, T), this[value](T),
                                   nearest_v[flow](G, T), not body[value](G, Body).
member_ctor_this[code](Body, J) :- member_ctor_before[code](Body, J, S), super[value](S).
member_ctor_open[code](Body, J) :- member_ctor_this[code](Body, J), member_ctor_before[code](Body, J, Q), runs_unknown[code](Q).
-- what the class publishes: the field is set at J for certain, and which
-- functions run before J (`super()` among them, and through it the parent's
-- `this.m()`, which reaches the class's override).
member_field_sure[flow](CD, Key, J) :- member_ctor_set[code](Body, Key, J), not member_ctor_early[code](Body, J),
                                       not member_ctor_open[code](Body, J), keyed_ctor[code](CB, Body), ast_child[code](CD, body, 0, CB).
member_field_runs[flow](CD, Key, J, G) :- member_field_sure[flow](CD, Key, J), ast_child[code](CD, body, 0, CB), keyed_ctor[code](CB, Body),
                                          member_ctor_before[code](Body, J, Q), resolves[code](Q, G).
member_ctor_inside[flow](CD, Key, J, N) :- member_field_sure[flow](CD, Key, J), ast_child[code](CD, body, 0, CB), keyed_ctor[code](CB, Body),
                                           member_ctor_before[code](Body, J, N).
-- the reader: after the write unless it is constructor code before it, or a
-- function that runs before it reaches the read's function
member_ctor_read[flow](N, I, Key, CD, J) :- member_unset[flow](N, I, Key), inst_of[flow](I, CD), member_field_sure[flow](CD, Key, J).
member_read_fn[flow](N, F) :- member_ctor_read[flow](N, _, _, _, _), nearest_v[flow](F, N).
keyed_target[code](F) :- member_read_fn[flow](_, F).
member_ctor_late[flow](N, CD, J) :- member_ctor_read[flow](N, _, Key, CD, J), member_ctor_inside[flow](CD, Key, J, N).
member_ctor_late[flow](N, CD, J) :- member_ctor_read[flow](N, _, Key, CD, J), member_field_runs[flow](CD, Key, J, G),
                                    member_read_fn[flow](N, F), keyed_runs_m[code](G, F).
member_set_sure[flow](N, I, Key) :- member_ctor_read[flow](N, I, Key, CD, J), not member_ctor_late[flow](N, CD, J),
                                    not member_dropped[flow](I, Key).
member_const_set[code](O, Key, B, F, J) :- binder[code](D, _, O, _), ast_node[code](O, object_expression, _),
                                          ast_child[code](V, declarations, _, D), ast_attr[code](V, kind, "const"),
                                          ast_child[code](B, F, L, V), ast_child[code](B, F, J, S), L < J,
                                          member_assign[code](S, T, Key, _), sees_binder[code](T, D).
member_const_read[flow](N, O, Key, W) :- member_unset[flow](N, O, Key), member_const_set[code](O, Key, B, F, J),
                                         ast_child[code](B, F, I, S), J < I, inside[tree](S, N), ast_child[code](B, F, J, W).
member_set_sure[flow](N, O, Key) :- member_const_read[flow](N, O, Key, W), nearest_v[flow](G, W), nearest_v[flow](G, N),
                                    not member_dropped[flow](O, Key).
member_set_sure[flow](N, O, Key) :- member_const_read[flow](N, O, Key, W), not in_fn[code](W), not in_fn[code](N),
                                    not member_dropped[flow](O, Key).
member_viewed[flow](N) :- member_unset[flow](N, _, _).
member_may_lack[flow](N) :- member_unset[flow](N, O, Key), not member_set_sure[flow](N, O, Key).

-- The receiver decides which half of a class it sees: `Vat.poured()` and
-- `new Vat().tapped()` are both TypeErrors and both resolved until the `static`
-- attribute — emitted for every method, read by nothing — was read. The class
-- object answers the static half and what is written onto it; an object
-- literal, a module namespace and an instance answer `member_plain`.
class_member_static[flow](CD, Key, M) :- member_value[flow](CD, Key, M), static[value](M).
class_member_proto[flow](CD, Key, M)  :- member_value[flow](CD, Key, M), class_method[code](_, M),
                                         not static[value](M).
member_plain[flow](O, Key, V) :- obj_lit[code](O),
                                 member_value[flow](O, Key, V).
member_plain[flow](P, Key, V) :- module_object[flow](P, _),
                                 member_value[flow](P, Key, V).
class_member_static[flow](CD, Key, V) :- class_like[flow](CD), sx_mwrite[surface](CD, Key, V).

member_obj[flow](N, O, Obj)      :- may_be_node[flow](O, Obj), object_of[code](N, O), member_node_v[flow](N).
member_at[flow](N, O, Obj, Key)  :- member_obj[flow](N, O, Obj), selects[flow](N, Key).
may_be_node[flow](N, V2) :- member_at[flow](N, _, Obj, Key), class_member_static[flow](Obj, Key, V), may_be_node[flow](V, V2).
may_be_node[flow](N, V2) :- member_at[flow](N, _, Obj, Key), member_plain[flow](Obj, Key, V), may_be_node[flow](V, V2).
may_be_lit[flow](N, L)   :- member_at[flow](N, _, Obj, Key), class_member_static[flow](Obj, Key, V), may_be_lit[flow](V, L).
may_be_lit[flow](N, L)   :- member_at[flow](N, _, Obj, Key), member_plain[flow](Obj, Key, V), may_be_lit[flow](V, L).

-- A method is a value; a declared function is reached by its name, looked up
-- as any name is.
may_be_node[flow](M, M) :- obj_method[code](_, M).
may_be_node[flow](M, M) :- class_method_of[flow](_, M).
may_be_node[flow](M, M) :- ast_node[code](M, function_declaration, _).

may_be_node[flow](E, F) :- sees_decl[code](E, F), ast_node[code](F, function_declaration, _).

may_be_node[flow](P, N) :- may_be_node[flow](X, N), ast_child[code](P, value, 0, X), ast_node[code](P, object_property, _).
may_be_lit[flow](P, V)  :- may_be_lit[flow](X, V), ast_child[code](P, value, 0, X), ast_node[code](P, object_property, _).

-- =========================================================================
-- 9. `this` — bound by the nearest enclosing function that is NOT an arrow (an
-- ordinary nested function rebinds it), by a field initialiser (the instance)
-- and by a static block (the class); a private method binds it too. `this_over`
-- binds T first: a handful of nodes, then their ancestors.
edb(this_binds_kind).
this_binds_kind(function_declaration).
this_binds_kind(function_expression).
this_binds_kind(object_method).
this_binds_kind(class_method).
this_binds_kind(class_private_method).

this_binder[flow](F)    :- this_binds_kind(K), ast_node[code](F, K, _).
this_over[flow](F, T)   :- this[value](T),
                           inside[tree](F, T), this_binder[flow](F).
this_nearer[flow](F, T) :- this_over[flow](F, T), this_over[flow](G, T),
                           inside[tree](F, G), F != G.
this_host[flow](F, T)   :- this_over[flow](F, T), not this_nearer[flow](F, T).

class_slot[code](CD, M)       :- class[value](CD), has[value](CD, M), parent[tree](B, M), parent[tree](CD, B).
class_method[code](CD, M)    :- class_slot[code](CD, M), fn_node[code](M), not private[value](M).
class_method_of[flow](CD, M) :- class_method[code](CD, M).
may_be_node[flow](T, I)  :- class_method_of[flow](CD, M), not static[value](M),
                            inst_of[flow](I, CD), this_host[flow](M, T).
-- an instance of a subclass runs the parent's methods and constructor with
-- itself as `this`, so `this.m()` there reaches the subclass's override; a
-- subclass of another file's class tells that file (`sx_sub_inst`)
sub_inst[flow](SD, I) :- super_of[flow](CD, SD), inst_of[flow](I, CD).
sub_inst[flow](SD, I) :- super_of[flow](MD, SD), sub_inst[flow](MD, I).
may_be_node[flow](T, I)  :- class_method_of[flow](SD, M), not static[value](M), this_host[flow](M, T),
                            sub_inst[flow](SD, I).
may_be_node[flow](T, CD) :- class_method_of[flow](CD, M), static[value](M),
                            this_host[flow](M, T).

-- =========================================================================
-- 10. ES2022 CLASS SYNTAX
--
-- A field is a member holding its initialiser. The `static` flag sits on the
-- PROPERTY node, not on the value, so fields need their own receiver arms and
-- an inherited field needs `inherited_field` (a method carries its own flag
-- through `super_of`). An auto-accessor is a field on this layer's question. A
-- field with no initialiser is no row: the layer has no `undefined`.
field_of[flow](CD, Key, P, V)  :- key_name[code](P, Key), class_slot[code](CD, P), value[value](P, V).
member_value[flow](CD, Key, V) :- field_of[flow](CD, Key, _, V).
own_key[flow](CD, Key)         :- field_of[flow](CD, Key, _, _).
class_member_static[flow](CD, Key, V) :- field_of[flow](CD, Key, P, V),
                                         ast_attr[code](P, static, true).
class_member_proto[flow](CD, Key, V)  :- field_of[flow](CD, Key, P, V),
                                         ast_attr[code](P, static, false).

-- Walks FIELDS and not members: written over `class_member_proto` it inherited
-- methods a second way and silently disarmed the mutant guarding the method arm.
field_at[flow](CD, Key, V, S)         :- field_of[flow](CD, Key, P, V), ast_attr[code](P, static, S).
inherited_field[flow](CD, Key, V, S)  :- super_of[flow](CD, SD), field_at[flow](SD, Key, V, S),
                                         not own_key[flow](CD, Key).
field_at[flow](CD, Key, V, S)         :- inherited_field[flow](CD, Key, V, S).
class_member_proto[flow](CD, Key, V)  :- inherited_field[flow](CD, Key, V, false).
class_member_static[flow](CD, Key, V) :- inherited_field[flow](CD, Key, V, true).

-- A private name is LEXICAL, not a lookup: bound by the declaring class body,
-- never inherited, computed or reached from outside, so these rules never ask
-- the receiver and are exact. It is a separate namespace — `rim` and `#rim` are
-- two members of one class, `{ '#edge': … }` is a legal string key — so
-- `key_name` gets no arm for `private_name` and `selects` stays empty on a
-- private read. `private_inner` is the shadowing test for nested classes.
private_member[code](CD, Name, M) :- obj_like[flow](CD), has[value](CD, M), private[value](M), key[value](M, Name).

private_ref[code](N, Name)        :- member[value](N, _, Name), private[value](N).

private_inner[code](N, CD) :- private_ref[code](N, Name), private_member[code](CD, Name, _),
                              inside[tree](CD, N),
                              private_member[code](CD2, Name, _),
                              inside[tree](CD, CD2), inside[tree](CD2, N).
private_binds[code](N, M)  :- private_ref[code](N, Name), private_member[code](CD, Name, M),
                              inside[tree](CD, N), not private_inner[code](N, CD).

private_method[code](M)  :- fn_node[code](M), private[value](M).
may_be_node[flow](M, M)  :- private_method[code](M).
may_be_node[flow](N, M)  :- private_binds[code](N, M), private_method[code](M).
may_be_node[flow](N, V2) :- private_binds[code](N, M), value[value](M, V), may_be_node[flow](V, V2).
may_be_lit[flow](N, L)   :- private_binds[code](N, M), value[value](M, V), may_be_lit[flow](V, L).

class_method_of[flow](CD, M) :- class_slot[code](CD, M), private_method[code](M).

this_binds_kind(class_property).
this_binds_kind(class_private_property).
this_binds_kind(static_block).

class_field_this[flow](CD, P) :- field_of[flow](CD, _, P, _).
class_field_this[flow](CD, P) :- private_member[code](CD, _, P), not fn_node[code](P).
may_be_node[flow](T, I)       :- class_field_this[flow](CD, P), not static[value](P),
                                 inst_of[flow](I, CD), this_host[flow](P, T).
may_be_node[flow](T, I)       :- class_field_this[flow](SD, P), not static[value](P), this_host[flow](P, T),
                                 sub_inst[flow](SD, I).
may_be_node[flow](T, CD)      :- class_field_this[flow](CD, P), static[value](P),
                                 this_host[flow](P, T).

-- a static member is inherited by the subclass's constructor, a field as a method is
class_member_static[flow](CD, Key, V) :- super_of[flow](CD, SD), class_member_static[flow](SD, Key, V),
                                         not own_key[flow](CD, Key).

static_block_of[flow](CD, SB) :- static_block[value](CD, SB).
may_be_node[flow](T, CD)      :- static_block_of[flow](CD, SB), this_host[flow](SB, T).

-- =========================================================================
-- 11. THE MODULE BOUNDARY, AS VALUE FACTS: an imported name may be what the
-- other module exports under it. Which file a site names is the modules
-- layer's `module_target` (rules/js-modules.rofl), keyed by the SITE: one
-- specifier names different files from different directories.
imports_name[code](Local, Name, D, File) :-
    binding[code](D, Sp, Local, Name), import_ident_key[code](Sp, Name), Name != "default", Name != "*",
    at[tree](D, File, _).

-- one row per file, from `program`; `ast_node(_, _, File)` would enumerate
-- the corpus to learn three strings
corpus_file[code](File) :- program[tree](_, File).



-- an export of the module itself, not one inside a TypeScript namespace
module_export[code](E, File) :- ast_node[code](P, program, File), ast_child[code](P, body, _, E),
                                ast_node[code](E, export_named_declaration, _).

exports_name[code](F, Name, File) :- fn_node[code](F), target[value](F, I), binds[value](I, Name),
                                     has[value](P, I), program[tree](P, File).

exports_name[code](D, Name, File) :- class_or_namespace[code](D), own_name[code](D, Name, File, around),
                                     target[value](D, I), has[value](P, I), program[tree](P, File).
class_or_namespace[code](D) :- ast_node[code](D, class_declaration, _).
class_or_namespace[code](D) :- ts_namespace[code](D).

-- `export * from` re-exports every NAME (not the default), recursively. The
-- kind guard is not redundant with `module_site`, which holds of imports too.
exports_name[code](F, Name, File) :- reexport_site[code](E, reexport_all), at[tree](E, File, _),
                                     module_target[code](E, Target),
                                     sx_export_node[surface](Target, Name, F).

-- `export { a as b } from './m'` offers m's `a`, or m's default when `a` is `default`.
exports_name[code](F, Ext, File) :- reexport_offers[code](File, Ext, T, Int),
                                    sx_export_node[surface](T, Int, F).
exports_name[code](F, Ext, File) :- reexport_offers[code](File, Ext, T, "default"),
                                    sx_default[surface](T, F).

-- `export { a as b }`: the `local` child is an identifier of this file and
-- resolves through `may_be_node`; under a declaration WITH a `source` it names
-- a binding of the OTHER module and has no value here, and a type-only one is
-- a member of the types: the roles give `value` to the local export of a value alone.
export_local[code](L, Ext, File) :- export_spec[code](E, Sp), value[value](Sp, L), key[value](Sp, Ext),
                                    at[tree](E, File, _).

exports_name[code](F, Ext, File) :- export_local[code](L, Ext, File),
                                    may_be_node[flow](L, F).

-- `export * as ns from` exports the other module's OBJECT — its `program` node —
-- so `ns.f()` is an ordinary member lookup.

export_ns_name[code](Name, E, File) :-
    module_ref[value](Src, _), value[value](X, Src), key[value](X, Name), not literal[value](X, _),
    parent[tree](E, Src), at[tree](E, File, _).

exports_name[code](P, Name, File) :- export_ns_name[code](Name, E, File),
                                     module_target[code](E, Target),
                                     sx_module[surface](Target, P).

may_be_node[flow](E, F) :- imports_name[code](Local, Name, D, File),
                           module_target[code](D, Target),
                           sx_export_node[surface](Target, Name, F),
                           top_read[code](E, Local, File).

-- `export const X = init`: the name offers what the initialiser may be, a node through `exports_name` and a
-- literal through `exports_value`, which also carries `export { x }` and the re-exports, so a constant written
-- in one file reaches a use in another (vscode's channel names and ports, w_next_version_cutoff).
export_var[code](Init, Name, File) :- binder[code](D, Name, Init, File), assign[value](D, I, _),
                                      has[value](P, I), program[tree](P, File).
exports_name[code](F, Name, File) :- export_var[code](Init, Name, File), may_be_node[flow](Init, F).

exports_value[code](Init, Name, File) :- export_var[code](Init, Name, File).
exports_value[code](L, Ext, File) :- export_local[code](L, Ext, File).
exports_value[code](X, Name, File) :- reexport_site[code](E, reexport_all), at[tree](E, File, _),
                                      module_target[code](E, Target), sx_export_val[surface](Target, Name, X).
exports_value[code](X, Ext, File) :- reexport_offers[code](File, Ext, T, Int), sx_export_val[surface](T, Int, X).

may_be_lit[flow](E, V) :- imports_name[code](Local, Name, D, File), module_target[code](D, Target),
                          sx_export_lit[surface](Target, Name, V),
                          top_read[code](E, Local, File).
member_value[flow](P, Name, X) :- module_object[flow](P, Target), exports_value[code](X, Name, Target).

-- A namespace import binds the module object. A default import binds the one
-- unnamed export, whose syntactic name is NOT the importer's name.
imports_ns[code](Local, D, File) :-
    spec_imported[code](Sp, "*"), target[value](Sp, L), binds[type](L, Local),
    parent[tree](D, Sp), at[tree](D, File, _).

module_object[flow](P, File) :- program[tree](P, File).

may_be_node[flow](E, P) :- imports_ns[code](Local, D, File), module_target[code](D, Target),
                           sx_module[surface](Target, P), top_read[code](E, Local, File).
member_value[flow](P, Name, F) :- module_object[flow](P, Target),
                                  exports_name[code](F, Name, Target).

imports_default[code](Local, D, File) :-
    binding[code](D, Sp, Local, "default"), at[tree](D, File, _).

exports_default[code](F, File) :- default_declaration[code](E, F), at[tree](E, File, _),
                                  fn_node[code](F).

may_be_node[flow](E, F) :- imports_default[code](Local, D, File),
                           module_target[code](D, Target),
                           sx_default[surface](Target, F),
                           top_read[code](E, Local, File).

-- CommonJS. `require(S)` is what the target's `module.exports` may be: first
-- the module's own object — its `program` node, as for a namespace — then
-- whatever `module.exports = X` puts there. Both stay in the may-set, so
-- `module.exports = f; module.exports.g = h` answers `.g`, and `exports.a = f`
-- is an ordinary member write (section 8) on the first.
cjs_module_exports[code](M, File) :- free_global[code](O, "module", File), prop_name[code](M, O, "exports"),
                                     ast_node[code](M, member_expression, _).



cjs_exports[flow](File, P) :- module_object[flow](P, File).
cjs_exports[flow](File, V) :- cjs_module_exports[code](L, File), ast_child[code](A, left, 0, L),
                              plain_assign[flow](A), ast_child[code](A, right, 0, R), may_be_node[flow](R, V).

may_be_node[flow](M, V) :- cjs_module_exports[code](M, File), cjs_exports[flow](File, V).
may_be_node[flow](E, P) :- free_global[code](E, "exports", File), module_object[flow](P, File).
may_be_node[flow](C, V) :- require_site[code](C), module_target[code](C, T), sx_cjs[surface](T, V).

-- The frontier: a module this corpus does not contain, one row per module.
import_outside_corpus[audit](Src, File) :- site_source[code](N, Src), site_file[code](N, File),
                                           not module_target[code](N, _).

-- `this` in an object literal's own method is that object.
may_be_node[flow](T, O) :- obj_method[code](O, M), this_host[flow](M, T).

-- =========================================================================
-- 11b. EXTERNAL VALUES: a value with no source in the corpus is still an
-- object. `express()`, anything an npm package or a builtin module hands back,
-- has no node here to be the identity `may_be_node` names — and without an
-- identity there is no member write to read back, no `.set`/`.get` on the
-- SAME object, no receiver two functions can share. So the model gives such a
-- value an identity of its own, and says where it came from.
--
-- `external_value(N, Spec)`: N is a value that came out of module Spec, which
-- the corpus does not contain; N is also what `may_be_node` points at.
--   the module itself   N is the specifier text. One module, one object — the
--                       require cache — whoever asks and from whichever file.
--   a call or `new`     N is the call SITE, as a literal in a loop is its own
--   of an external      object each time round.
--   a member read of    N is the access site. Two reads of `app.locals` are
--   an external         two values: a member write through one is not read
--                       back through the other, which loses a row and never
--                       invents one.
--   an import binding   `import { Router } from 'm'` is the specifier node;
--   or a pattern        `const { Router } = require('m')` the pattern property.
--   a callback's        a function handed to an external call is called by
--   parameter           code the corpus cannot see, with values it cannot see.
--
-- FOUNDED ON A STRUCTURAL SIGNAL, NOT ON THE CALL GRAPH. A site is external
-- when its specifier is bare or a builtin and `module_target` is empty, which
-- is a fact about the file system and the string. `unresolved_call` would be
-- the obvious source and cannot be: it is `not resolved_site`, `resolved_site`
-- is `resolves`, and `resolves` reads `may_be_node` — an external value would
-- be defined by its own absence, a negation cycle the program is refused for.
-- Everything below is positive recursion through `may_be_node`.
--
-- A MAY-SET, like its neighbours: what the module hands back may be a string
-- or a function, and a row says "an object may be here". It claims no member.
edb(external_shape).
external_shape(bare).
external_shape(node_builtin).

external_site[code](I, Spec) :- require_site[code](I), site_source[code](I, Spec),
                                site_shape[code](I, Sh), external_shape(Sh),
                                not module_target[code](I, _).
external_site[code](I, Spec) :- import_site[code](I, _), site_source[code](I, Spec),
                                site_shape[code](I, Sh), external_shape(Sh),
                                not module_target[code](I, _), not type_only_site[code](I).

external_module[code](Spec)  :- external_site[code](_, Spec).

external_value[flow](Spec, Spec) :- external_module[code](Spec).

-- `require('m')` and `import('m')` evaluate to the module; so do the names a
-- default or namespace import binds.
may_be_node[flow](I, Spec) :- external_site[code](I, Spec), require_site[code](I).
may_be_node[flow](I, Spec) :- module_ref[value](I, Spec), external_site[code](I, Spec).
may_be_node[flow](E, Spec) :- imports_default[code](Local, D, File), external_site[code](D, Spec),
                              top_read[code](E, Local, File).
may_be_node[flow](E, Spec) :- imports_ns[code](Local, D, File), external_site[code](D, Spec),
                              top_read[code](E, Local, File).

external_import[code](Sp, Local, Spec, File) :-
    external_site[code](D, Spec), value_binding[code](D, Sp), spec_local[code](Sp, Local),
    spec_imported[code](Sp, K), K != "default", K != "*", at[tree](D, File, _).
external_value[flow](Sp, Spec) :- external_import[code](Sp, _, Spec, _).
may_be_node[flow](E, Sp)       :- external_import[code](Sp, Local, _, File),
                                  top_read[code](E, Local, File).

-- Calling, constructing or reading a member off an external value gives
-- another one. A callee that is also a corpus function keeps both rows. The
-- external value leads each body: it is the small relation, and the site is
-- found from it rather than the other way round. The call and the member hop
-- each find their site ONCE, in `ext_call` and `ext_member`, and both heads
-- read it. Written as one body per head the pair re-scanned every member node
-- twice a round; the helper costs a round a hop (rounds +2 %) and, since the
-- engine fires a rule from its news (w_cmp_delta_first), nothing re-fires on it:
-- the model's probes fell 1.2 % sealed / 0.8 % default, the heads' time 7-12 %.
-- Under the engine that fired in written order they ROSE 2.5 %.
ext_call[flow](C, Spec)       :- external_value[flow](X, Spec), may_be_node[flow](F, X),
                                 callee[value](C, F),
                                 ast_node[code](C, K, _), call_like_v(K).
external_value[flow](C, Spec) :- ext_call[flow](C, Spec).
may_be_node[flow](C, C)       :- ext_call[flow](C, _).
ext_member[flow](M, Spec)     :- external_value[flow](X, Spec), may_be_node[flow](O, X),
                                 object_of[code](M, O), member_node_v[flow](M).
external_value[flow](M, Spec) :- ext_member[flow](M, Spec).
may_be_node[flow](M, M)       :- ext_member[flow](M, _).

-- The corpus writes members onto an external value (`app.handler = f`) and
-- reads them back like any plain object's.
member_plain[flow](X, Key, V) :- external_value[flow](X, _), member_value[flow](X, Key, V).

-- A pattern off an external value: each name is a member of it, the rest is
-- another object of the same origin.
external_destructured[code](D, Prop, Local, File) :-
    destr_prop[code](D, Prop, _, Local, File), key_name[code](Prop, _).
external_value[flow](Prop, Spec) :- external_destructured[code](D, Prop, _, _),
                                    decl_value[flow](D, Init), may_be_node[flow](Init, X),
                                    external_value[flow](X, Spec).
may_be_node[flow](E, Prop)       :- external_destructured[code](D, Prop, Local, File),
                                    decl_value[flow](D, Init), may_be_node[flow](Init, X),
                                    external_value[flow](X, _),
                                    ident_in[code](E, Local, File), sees_binder[code](E, D).
external_value[flow](R, Spec)    :- rest_in_pattern[code](D, R, _),
                                    decl_value[flow](D, Init), may_be_node[flow](Init, X),
                                    external_value[flow](X, Spec).

-- WHICH PACKAGE an external value came from: a bare specifier's first segment,
-- its first two for a scoped one (`@scope/pkg/sub` is `@scope/pkg`), and a
-- builtin by node's canonical name; the origin says which. A relative import
-- of a file the slice left out is no package: it is `dangling_import`
-- (rules/js-modules.rofl), it gives no value, and nothing read off it is
-- external. `external_value(N, Spec)` joins this on Spec.
external_package[code](Spec, Pkg, npm) :- external_site[code](I, Spec), site_shape[code](I, bare),
                                          str_char0[code](Spec, C), C != "@", str_seg[code](Spec, 0, Pkg).
external_package[code](Spec, Pkg, npm) :- external_site[code](I, Spec), site_shape[code](I, bare),
                                          str_char0[code](Spec, "@"), str_seg[code](Spec, 0, A),
                                          str_seg[code](Spec, 1, B), LA is str_len(A), LB is str_len(B), N is LA + LB + 1,
                                          Pkg is str_sub(Spec, 0, N).
external_package[code](Spec, C, node_builtin) :- external_site[code](I, Spec), site_shape[code](I, node_builtin),
                                                 builtin_canonical[code](Spec, C).

-- A LIBRARY CONTRACT, declared as a row of the package rather than read off a
-- method's name: `runs_coroutine(Pkg, Key, I)` runs the generator function at
-- argument I as a coroutine, so a `yield p` in it is p's value, as an `await`
-- is, and the call is what the generator returns; `returns_argument(Pkg, Key,
-- I)` is the argument I itself. Key `call` is the package called as it is,
-- another a member of it, read off it or imported by name. A package used on
-- one site only (a company's runner) gets its rows there, in the world that
-- loads it.
edb(runs_coroutine).
runs_coroutine("co", call, 0).
edb(returns_argument).

contract_key(Pkg, Key) :- runs_coroutine(Pkg, Key, _).
contract_key(Pkg, Key) :- returns_argument(Pkg, Key, _).
sx_contract_pkg[surface](Spec, Pkg) :- external_package[code](Spec, Pkg, _), contract_key(Pkg, _).

contract_fn[flow](Spec, Pkg, call) :- sx_contract_pkg[surface](Spec, Pkg), contract_key(Pkg, call),
                                      external_value[flow](Spec, Spec).
contract_fn[flow](M, Pkg, Key)     :- sx_contract_pkg[surface](Spec, Pkg), external_value[flow](Spec, Spec),
                                      may_be_node[flow](O, Spec), object_of[code](M, O),
                                      member_node_v[flow](M), selects[flow](M, Key), contract_key(Pkg, Key).
contract_fn[flow](Sp, Pkg, Key)    :- external_import[code](Sp, _, Spec, _), sx_contract_pkg[surface](Spec, Pkg),
                                      import_ident_key[code](Sp, Key), contract_key(Pkg, Key).
contract_call[flow](C, Pkg, Key)   :- contract_fn[flow](X, Pkg, Key), may_be_node[flow](G, X),
                                      callee[value](C, G), ast_node[code](C, call_expression, _).

coroutine_of[flow](C, F) :- contract_call[flow](C, Pkg, Key), runs_coroutine(Pkg, Key, I),
                            arg_at[flow](C, I, A), may_be_node[flow](A, F), gen_fn[flow](F).
sx_coroutine[surface](F) :- coroutine_of[flow](_, F).
coroutine_yield[flow](Y, A) :- sx_coroutine[surface](F), nearest_v[flow](F, Y),
                               yields[value](Y, A).
may_be_node[flow](Y, N) :- coroutine_yield[flow](Y, A), may_be_node[flow](A, N).
may_be_lit[flow](Y, V)  :- coroutine_yield[flow](Y, A), may_be_lit[flow](A, V).
may_be_node[flow](C, N) :- coroutine_of[flow](C, F), sx_gen_ret[surface](F, N).
may_be_lit[flow](C, V)  :- coroutine_of[flow](C, F), sx_gen_rlit[surface](F, V).

may_be_node[flow](C, N) :- contract_call[flow](C, Pkg, Key), returns_argument(Pkg, Key, I),
                           arg_at[flow](C, I, A), may_be_node[flow](A, N).
may_be_lit[flow](C, V)  :- contract_call[flow](C, Pkg, Key), returns_argument(Pkg, Key, I),
                           arg_at[flow](C, I, A), may_be_lit[flow](A, V).

-- A function handed to an external call as an argument is called back with
-- values the corpus does not build: each plain parameter is an external value
-- of the callee's origin, read wherever the parameter is.
callback_param[flow](P, F, Spec) :- sx_cb[surface](F, Spec), param[value](F, _, P), parent[tree](F, P),
                                    ast_node[code](P, identifier, _).
external_value[flow](P, Spec) :- callback_param[flow](P, _, Spec).
may_be_node[flow](U, P)       :- callback_param[flow](P, F, _), ast_name[code](P, Name),
                                 param_use[flow](F, Name, U).

-- A TypeScript namespace is an object made at run time (not a `declare`d one):
-- reached by its name, holding what its body exports.
ts_namespace[code](NS) :- decl[value](NS, namespace), not ambient[value](NS).
may_be_node[flow](E, NS) :- sees_decl[code](E, NS), ts_namespace[code](NS).
ns_export[code](NS, E) :- ts_namespace[code](NS), ast_child[code](NS, body, 0, B), ast_child[code](B, body, _, E),
                          ast_node[code](E, export_named_declaration, _).
member_value[flow](NS, Name, D)    :- ts_namespace[code](NS), namespace[value](NS, B), has[value](B, I),
                                      target[value](D, I), own_name[code](D, Name, _, around),
                                      not ast_node[code](D, tsdeclare_function, _).
member_value[flow](NS, Name, Init) :- ts_namespace[code](NS), namespace[value](NS, B), has[value](B, I),
                                      assign[value](D, I, _), binder[code](D, Name, Init, _).
member_value[flow](NS, Name, In)   :- ts_namespace[code](NS), ast_child[code](NS, body, 0, In),
                                      own_name[code](In, Name, _, around).

-- =========================================================================
-- 12. CONSTRUCTION
--
-- A class declaration is reached by its name, looked up as any name is.
may_be_node[flow](E, CD) :- sees_decl[code](E, CD), ast_node[code](CD, class_declaration, _).

-- `new X()` is an instance of whichever class its callee may be, by value:
-- `new ns.Foo()` and an imported class are reached as a call's callee is.
may_be_node[flow](E, I) :- construct[value](E),
                           callee[value](E, CE), may_be_node[flow](CE, CD), inst_of[flow](I, CD).

-- `super` denotes the class its `extends` expression may be.
super_of[flow](CD, SD) :- class_like[flow](CD), ast_child[code](CD, super_class, 0, SC),
                          may_be_node[flow](SC, SD), inst_of[flow](_, SD).

-- A class with no constructor answers with its nearest ancestor's. Measured on
-- V8: `super()` inside C reports `C -> A`, skipping the synthesised B frame.
-- The `new` rule in js-callgraph deliberately does NOT use this walk: there V8
-- creates the synthesised frame and makes it the caller.
own_ctor[flow](CD, M)  :- class_method_of[flow](CD, M), ctor_method[code](M).
has_own_ctor[flow](CD) :- own_ctor[flow](CD, _).

ctor_of[flow](CD, M)   :- own_ctor[flow](CD, M).
ctor_of[flow](CD, M)   :- super_of[flow](CD, SD), not has_own_ctor[flow](CD),
                          ctor_of[flow](SD, M).

may_be_node[flow](S, SD) :- super[value](S),
                            inside[tree](M, S), class_method_of[flow](CD, M),
                            super_of[flow](CD, SD).

-- =========================================================================
-- 13. EXPRESSION FORMS. A sequence is its LAST element: the maximum index of
-- its expressions, over base data, so it stratifies below the flow. A
-- conditional and a logical operator (`||`, `&&`, `??`) are both operands.
-- `await` is transparent: `await v` is `v`, `await f()` is f's returns; a
-- promise constructed and awaited later reaches the Promise class, which no
-- corpus here declares. A plain assignment is its right-hand side; `+=` is a sum.
may_be_node[flow](E, N) :- ast_node[code](E, sequence_expression, _),
                           I is max(J : ast_child[code](E, expressions, J, _)),
                           ast_child[code](E, expressions, I, X), may_be_node[flow](X, N).
may_be_lit[flow](E, V)  :- ast_node[code](E, sequence_expression, _),
                           I is max(J : ast_child[code](E, expressions, J, _)),
                           ast_child[code](E, expressions, I, X), may_be_lit[flow](X, V).

may_be_node[flow](E, N) :- may_be_node[flow](X, N), ast_child[code](E, consequent, 0, X), ast_node[code](E, conditional_expression, _).
may_be_node[flow](E, N) :- may_be_node[flow](X, N), ast_child[code](E, alternate, 0, X), ast_node[code](E, conditional_expression, _).

may_be_lit[flow](E, V)  :- may_be_lit[flow](X, V), ast_child[code](E, consequent, 0, X), ast_node[code](E, conditional_expression, _).
may_be_lit[flow](E, V)  :- may_be_lit[flow](X, V), ast_child[code](E, alternate, 0, X), ast_node[code](E, conditional_expression, _).

may_be_node[flow](E, N) :- may_be_node[flow](X, N), awaits[value](E, X).
may_be_lit[flow](E, V)  :- may_be_lit[flow](X, V), awaits[value](E, X).

-- =========================================================================
-- 14. GENERATORS. Calling a generator function makes a generator OBJECT, the
-- call site's own value (`gen_of`), as `new` makes an instance; what the
-- function yields is what `for-of` walks, and the value a `yield` RECEIVES is
-- what the consumer hands `.next(v)`, through `yield*` too. The delegating
-- expression itself is the inner generator's return.
yields[flow](F, E) :- yields[value](Y, E), nearest_v[flow](F, Y).
yields[flow](F, E) :- delegates[value](Y, E), nearest_v[flow](F, Y).

gen_fn[flow](F)          :- fn_node[code](F), generator[value](F).
gen_of[flow](C, F)       :- resolves[code](C, F), gen_fn[flow](F).
may_be_node[flow](C, C)  :- gen_of[flow](C, _).

next_send[flow](G, V) :- selects[flow](N, "next"), callee_of[code](C, N),
                         object_of[code](N, O), may_be_node[flow](O, GC), gen_of[flow](GC, G),
                         ast_child[code](C, arguments, 0, V).

delegates[flow](Outer, Inner) :- delegates[value](Y, A), nearest_v[flow](Outer, Y), resolves[code](A, Inner).
next_send[flow](Inner, V) :- next_send[flow](Outer, V), delegates[flow](Outer, Inner).

may_be_node[flow](Y, X) :- next_send[flow](G, V), nearest_v[flow](G, Y),
                           ast_node[code](Y, yield_expression, _),
                           ast_attr[code](Y, delegate, false),
                           may_be_node[flow](V, X).

may_be_node[flow](Y, X) :- delegates[value](Y, A), resolves[code](A, Inner),
                           ret_node_any[flow](Inner, X).

-- FOR-OF: the head is a declarator like any other, whose value is each
-- element walked. An array is a VALUE (through `may_be_node`); a generator is
-- a CALL, read at the site, because its returns are not what for-of walks.
iter_elem[flow](X, E) :- elem_at[flow](X, _, E).
iter_elem[flow](X, E) :- may_be_node[flow](X, GC), gen_of[flow](GC, F), yields[flow](F, E).

decl_value[flow](D, E) :- iterates[value](S, V, X),
                          ast_child[code](V, declarations, 0, D),
                          iter_elem[flow](X, E).

may_be_node[flow](U, N) :- bare_binder[code](D, Name, File), decl_value[flow](D, E), may_be_node[flow](E, N),
                           ident_in[code](U, Name, File), sees_binder[code](U, D).
may_be_lit[flow](U, V)  :- bare_binder[code](D, Name, File), decl_value[flow](D, E), may_be_lit[flow](E, V),
                           ident_in[code](U, Name, File), sees_binder[code](U, D).

may_be_node[flow](E, N) :- may_be_node[flow](X, N), ast_child[code](E, left, 0, X), ast_node[code](E, logical_expression, _).
may_be_node[flow](E, N) :- may_be_node[flow](X, N), ast_child[code](E, right, 0, X), ast_node[code](E, logical_expression, _).
may_be_lit[flow](E, V)  :- may_be_lit[flow](X, V), ast_child[code](E, left, 0, X), ast_node[code](E, logical_expression, _).
may_be_lit[flow](E, V)  :- may_be_lit[flow](X, V), ast_child[code](E, right, 0, X), ast_node[code](E, logical_expression, _).

plain_assign[flow](E) :- assign[value](E, _, R), gives[value](E, R).


may_be_node[flow](E, N) :- may_be_node[flow](X, N), ast_child[code](E, right, 0, X), plain_assign[flow](E).
may_be_lit[flow](E, V)  :- may_be_lit[flow](X, V), ast_child[code](E, right, 0, X), plain_assign[flow](E).

-- The crossings this layer performs: the scanner's tree, the unperspectived
-- kind tables, and the kernel's `edb` reflection.
imports(flow, code).
imports(flow, main).
imports(flow, $kernel).
imports(flow, surface).
imports(code, surface).
imports(surface, flow).
imports(surface, code).

-- =========================================================================
-- 15. THE EXCEPTION PATH. A catch parameter may be what the guarded BLOCK
-- throws — the block, not the handler or the finalizer. A throw in a nested
-- try is offered to the outer handler too (safe direction). A catch with no
-- lexical throw is three things: sourced through a call edge (`caught_value`
-- names it), sourced by the HOST — nothing the model sees can throw, which is
-- `w_env_api_surface`'s question — or a dead handler with no call at all, the
-- one row that is an audit.
catch_of[flow](T, H)     :- tries[value](T, B), executes_if[value](H, B, thrown).
catch_param[flow](H, P)  :- decl[value](P, catch), parent[tree](H, P).
try_block[flow](T, B)    :- ast_node[code](T, try_statement, _),
                            ast_child[code](T, block, 0, B).
-- a throw in a function the try only defines is not thrown by the try
thrown_in[flow](T, V)    :- throws[value](Th, V),
                            inside[tree](B, Th), try_block[flow](T, B),
                            nearest_v[flow](G, Th), nearest_v[flow](G, T).
thrown_in[flow](T, V)    :- throws[value](Th, V),
                            inside[tree](B, Th), try_block[flow](T, B),
                            not throw_in_fn[flow](Th).
throw_in_fn[flow](Th)    :- exits[value](Th, throw), nearest_v[flow](_, Th).

caught_value[flow](P, V) :- catch_of[flow](T, H), catch_param[flow](H, P),
                            thrown_in[flow](T, V).
may_be_node[flow](P, V)  :- caught_value[flow](P, V).

call_in_try[flow](T)     :- try_block[flow](T, B), inside[tree](B, C),
                            call_site[code](C, _).
catch_from_call[flow](P) :- catch_of[flow](T, H), catch_param[flow](H, P),
                            not thrown_in[flow](T, _), call_in_try[flow](T).
catch_from_host[flow](P) :- catch_from_call[flow](P), not caught_value[flow](P, _).

catch_unsourced[audit](P) :- catch_of[flow](T, H), catch_param[flow](H, P),
                             not thrown_in[flow](T, _), not call_in_try[flow](T).

-- =========================================================================
-- 16. A DECORATOR REPLACES ITS TARGET. The class name evaluates to what the
-- decorator RETURNED, added beside the class rather than replacing it
-- (`@decoOnce` returns its argument). A decorated method is a member holding
-- the replacement, its `static` flag read off the METHOD. No `own_key` arm: the
-- draft had one and the program became unstratifiable — `own_key` must not
-- depend on `member_value`. No `member_value` arm: deleting it moved rows and
-- no edge, every consumer reads the receiver halves directly. No arm for a
-- decorated field or auto-accessor: those decorators return a transformer or a
-- `{get, set, init}` triple, not the member's value. The `class_method`
-- literal is redundant today (a private key never reaches `key_name`) and kept
-- so the rule does not depend silently on another relation's blindness.
decorated_by[flow](Owner, N) :- decorates[code](Owner, D), may_be_node[flow](D, N).

may_be_node[flow](E, N) :- decorated_by[flow](CD, N), sees_decl[code](E, CD).
may_be_node[flow](CD, N) :- decorated_by[flow](CD, N), ast_node[code](CD, class_expression, _).

decorated_member[flow](CD, Key, M, N) :- decorated_by[flow](M, N),
                                         class_method[code](CD, M), key_name[code](M, Key).
class_member_static[flow](CD, Key, N) :- decorated_member[flow](CD, Key, M, N), static[value](M).
class_member_proto[flow](CD, Key, N)  :- decorated_member[flow](CD, Key, M, N), not static[value](M).

-- net-http.rofl — A URL, A PATH, A ROUTE (the net library, 8 of 8).
--
-- Needs net-addr, net-proto and net-hops. Knows no language and no server:
--   http_send(F, X, M, U)        the node X sends the request F, method M (or
--                                `any`), to the address U
--   http_serves(X, Port, M, P, H, R)  X answers M on the route pattern P at
--                                Port with the handler H, a `route` or a
--                                `middleware` that runs before one
--   url_str(V)                   V, a leaf of some U or P, is a string
-- and what an L7 hop reads and rewrites (the hop itself is net-hops'):
--   hop_when(R, path, S)         the rule R takes paths under the prefix S
--   hop_path(R, S)               R puts S in place of the prefix it matched
--   hop_host(R, N)               R sends the host N upstream (else its target)
-- What it answers:
--   http_leg(F, X, N, Port, Tls, V)  the first leg of F: to the name N at Port,
--                                `tls` or `plain`, with the path V
--   http_no_origin(F)            F's address names no host: a relative URL, or
--                                one whose start nothing traces
--   http_reach(F, H, R)          F, walked through every hop, reaches H
--   http_unserved(F, X)          F reaches X and no route of X answers it
--
-- U and P are TEXTS (rules/js-concat.rofl's terms): a string, or cat(A, B),
-- join(A, B), url(Base, Rel), url(A), join(A) over texts; any other leaf is a
-- value nothing knows, one DYNAMIC piece. The kernel builds no strings, so a
-- text is cut into segments piece by piece, and the segments are compared.
-- A pattern segment `:name` matches one segment, `*` any number. Empty
-- segments do not count: a doubled or trailing slash and a prefix glued to a
-- route (`/api` + `/users`) read as the path they make.
url_request(U) :- http_send(_, _, _, U).
url_pattern(P) :- http_serves(_, _, _, P, _, _).
url_str("/").
url_str("*").

-- =========================================================================
-- 1. THE TERMS, top down, each compound taken apart once.
url_top(U) :- url_request(U).
url_top(P) :- url_pattern(P).
url_term(T) :- url_top(T).
url_part(cat(A, B), A, B, cat)   :- url_term(cat(A, B)).
url_part(join(A, B), A, B, join) :- url_term(join(A, B)).
url_part(url(A, B), A, B, url)   :- url_term(url(A, B)).
url_one(join(A), A) :- url_term(join(A)).
url_one(url(A), A)  :- url_term(url(A)).
url_term(A) :- url_part(_, A, _, _).
url_term(B) :- url_part(_, _, B, _).
url_term(A) :- url_one(_, A).

url_compound(T) :- url_part(T, _, _, _).
url_compound(T) :- url_one(T, _).
url_leaf_str(V) :- url_term(V), url_str(V).
url_dyn(T) :- url_term(T), not url_compound(T), not url_str(T).

-- =========================================================================
-- 2. THE PIECES, bottom up. `url_span(T, N, E)`: T holds N slashes before its
-- end; E is `yes` when a `?` or `#` ended it, and then nothing after it counts.
-- `url_atom(T, K, X)`: segment K of T holds the piece X, lit(V) or dyn.
url_q(V, V, no)  :- url_leaf_str(V), N is str_segs(V, "?"), N = 1.
url_q(V, Q, yes) :- url_leaf_str(V), N is str_segs(V, "?"), N > 1, Q is str_pre(V, "?").
url_path(V, Q, E)   :- url_q(V, Q, E), N is str_segs(Q, "#"), N = 1.
url_path(V, P, yes) :- url_q(V, Q, _), N is str_segs(Q, "#"), N > 1, P is str_pre(Q, "#").

url_span(V, M, E) :- url_path(V, P, E), N is str_segs(P, "/"), M is N - 1.
url_cut(V, P, 0) :- url_path(V, P, _).
url_cut(V, P, K) :- url_cut(V, P, J), url_span(V, M, _), J < M, K is J + 1.
url_atom(V, K, lit(S)) :- url_cut(V, P, K), S is str_seg(P, "/", K).

url_span(T, 0, no) :- url_dyn(T).
url_atom(T, 0, dyn) :- url_dyn(T).

-- A sequence: B goes on where A stops, unless A ended. `join` puts a slash
-- between; a one-argument `join` and `url` are their argument.
url_seq(T, A, B, 0) :- url_part(T, A, B, cat).
url_seq(T, A, B, 1) :- url_part(T, A, B, join).
url_span(T, N, yes) :- url_seq(T, A, _, _), url_span(A, N, yes).
url_span(T, N, E)   :- url_seq(T, A, B, G), url_span(A, NA, no), url_span(B, NB, E), N is NA + G + NB.
url_atom(T, K, X)   :- url_seq(T, A, _, _), url_atom(A, K, X).
url_atom(T, K, X)   :- url_seq(T, A, B, G), url_span(A, NA, no), url_atom(B, J, X), K is NA + G + J.

-- `new URL(rel, base)`: a rel with a scheme or a leading slash replaces the
-- base's path; any other is read under it.
url_same(T, A) :- url_one(T, A).
url_same(T, R) :- url_part(T, _, R, url), url_rooted(R).
url_seq(T, B, R, 1) :- url_part(T, B, R, url), not url_rooted(R).
url_span(T, N, E) :- url_same(T, A), url_span(A, N, E).
url_atom(T, K, X) :- url_same(T, A), url_atom(A, K, X).

-- Read off the first string of R, so that the cut above never waits on itself.
url_first(V, V) :- url_leaf_str(V).
url_first(T, V) :- url_part(T, A, _, K), K != url, url_first(A, V).
url_first(T, V) :- url_one(T, A), url_first(A, V).
url_rooted(R) :- url_first(R, V), L is str_len(V), L > 0, C is str_char(V, 0), C = "/".
url_rooted(R) :- url_first(R, V), N is str_segs(V, "://"), N > 1.

-- =========================================================================
-- 3. THE SEGMENTS of a request or a pattern.
url_text_at(U, K, V) :- url_top(U), url_atom(U, K, lit(V)), V != "".
url_dyn_at(U, K)     :- url_top(U), url_atom(U, K, dyn).
url_two_at(U, K)     :- url_text_at(U, K, V), url_text_at(U, K, W), V != W.
url_has_text(U, K)   :- url_text_at(U, K, _).

url_seg(U, K, lit(V)) :- url_text_at(U, K, V), not url_dyn_at(U, K), not url_two_at(U, K).
url_seg(U, K, open)   :- url_dyn_at(U, K).
url_seg(U, K, open)   :- url_two_at(U, K).
url_seg(U, K, empty)  :- url_top(U), url_atom(U, K, _), not url_dyn_at(U, K), not url_has_text(U, K).
url_segs(U, N) :- url_top(U), url_span(U, M, _), N is M + 1.

-- `scheme:` `` `net_host` and then the path.
url_scheme(U) :- url_atom(U, 0, lit(V)), url_atom(U, 1, lit("")), url_span(U, N, _), N >= 2,
                 L is str_len(V), L > 1, I is L - 1, C is str_char(V, I), C = ":".
url_host(U, H) :- url_top(U), url_scheme(U), url_seg(U, 2, lit(H)).
url_from(U, 3) :- url_top(U), url_scheme(U).
url_from(U, 0) :- url_top(U), not url_scheme(U), not url_open(U).
url_open(U)    :- url_top(U), url_seg(U, 0, open).


-- =========================================================================
-- 4. THE ORIGIN: scheme, host and port of an absolute address.
http_scheme(U, S) :- url_scheme(U), url_atom(U, 0, lit(V)), L is str_len(V), K is L - 1, S is str_sub(V, 0, K).
http_hostport(U, HP) :- http_scheme(U, _), url_seg(U, 2, lit(HP)).
http_origin(U, S, HP, D) :- http_hostport(U, HP), http_scheme(U, S), N is str_segs(HP, ":"), N = 1, scheme(S, _, _, D).
http_port_text(U, T) :- http_hostport(U, HP), N is str_segs(HP, ":"), N = 2, T is str_seg(HP, ":", 1).
num_text(T) :- http_port_text(_, T).
http_origin(U, S, H, P) :- http_hostport(U, HP), http_scheme(U, S), http_port_text(U, T), net_num(T, 10, P),
                           H is str_seg(HP, ":", 0).

http_leg(F, X, N, P, T, v(e, U, 0)) :- http_send(F, X, _, U), http_origin(U, S, N, P), scheme(S, _, T, _).
http_sent(F) :- http_leg(F, _, _, _, _, _).
http_no_origin(F) :- http_send(F, _, _, _), not http_sent(F).
net_name(N) :- http_leg(_, _, N, _, _, _).
net_name(N) :- hop_host(_, N).

-- =========================================================================
-- 5. THE PATH as its segments that are not empty, counted from 0.
http_at(U, 3, 0) :- url_request(U), url_from(U, 3).
http_at(P, 0, 0) :- url_pattern(P), url_from(P, 0).
http_at(U, J, K) :- http_at(U, I, H), url_seg(U, I, S), S != empty, J is I + 1, K is H + 1.
http_at(U, J, K) :- http_at(U, I, K), url_seg(U, I, empty), J is I + 1.
http_seg(U, K, S) :- http_at(U, I, K), url_seg(U, I, S), S != empty.
http_len(U, K) :- http_at(U, I, K), url_segs(U, I).

http_pseg(P, K, param)  :- url_pattern(P), http_seg(P, K, lit(V)), C is str_char(V, 0), C = ":".
http_pseg(P, K, star)   :- url_pattern(P), http_seg(P, K, lit("*")).
http_pseg(P, K, lit(V)) :- url_pattern(P), http_seg(P, K, lit(V)), C is str_char(V, 0), C != ":", V != "*".
http_pseg(P, K, open)   :- url_pattern(P), http_seg(P, K, open).

-- A prefix or a path a hop writes, as the list s(Segment, Rest) ending in e,
-- and the prefix each rule takes (e when it names none)
hop_prefix(R, L, N) :- hop_when(R, path, S), http_lits(S, L, N).
hop_prefix(R, e, 0) :- hop_rule(R), not http_pathed(R).
http_pathed(R) :- hop_when(R, path, _).
http_lit_text(S) :- hop_when(_, path, S).
http_lit_text(S) :- hop_path(_, S).
http_cut(S, N, e, 0) :- http_lit_text(S), N is str_segs(S, "/").
http_cut(S, K, s(X, L), M) :- http_cut(S, J, L, N), J > 0, K is J - 1, X is str_seg(S, "/", K), X != "", M is N + 1.
http_cut(S, K, L, N) :- http_cut(S, J, L, N), J > 0, K is J - 1, X is str_seg(S, "/", K), X = "".
http_lits(S, L, N) :- http_cut(S, 0, L, N).

-- =========================================================================
-- 6. A VIEW of a path: v(L, U, I), the segments of the list L, then those of
-- U from I. A hop that strips a prefix and puts another makes a new view,
-- and every view a hop may make is made ahead of the walk, so the walk only
-- picks among them.
http_cur(V) :- http_view(V, _).
http_cur(C) :- http_head(_, _, C).
http_cur_at(L, U, I) :- http_cur(v(L, U, I)).
http_head(v(s(X, L), U, I), lit(X), v(L, U, I)) :- http_cur_at(s(X, L), U, I).
http_head(v(e, U, I), S, v(e, U, J)) :- http_cur_at(e, U, I), http_seg(U, I, S), J is I + 1.
http_end(v(e, U, I)) :- http_cur_at(e, U, I), http_len(U, I).

-- a prefix the view starts with, and what is left after it; an open segment
-- may be any literal
http_prefix(L) :- hop_prefix(_, L, _).
http_strip_at(V, L, L, V) :- http_view(V, _), http_prefix(L).
http_strip_at(V, L, R, C2) :- http_strip_at(V, L, s(X, R), C), http_head(C, S, C2), http_lit_fits(S, X).
http_lit_fits(lit(X), X) :- http_prefix_seg(X).
http_lit_fits(open, X) :- http_prefix_seg(X).
http_prefix_seg(X) :- http_cut(_, _, s(X, _), _).
http_strip(V, L, C) :- http_strip_at(V, L, e, C).

http_join(e, B, B) :- http_join_ask(e, B).
http_join(s(X, A), B, s(X, C)) :- http_join_ask(s(X, A), B), http_join(A, B, C).
http_join_ask(A, B) :- http_join_ask(s(_, A), B).

edb(http_view_depth).
http_view_depth(8).
http_view(V, 0) :- http_leg(_, _, _, _, _, V).
http_redo(R, V, NL, v(L, U, I), D) :- hop_path(R, S), http_lits(S, NL, _), hop_prefix(R, P, _), http_strip(V, P, v(L, U, I)),
                                      http_view(V, D).
http_join_ask(NL, L) :- http_redo(_, _, NL, v(L, _, _), _).
http_view(v(L2, U, I), E) :- http_redo(_, _, NL, v(L, U, I), D), http_join(NL, L, L2), http_view_depth(M), D < M,
                             E is D + 1.
-- the view a rule sends upstream
hop_view(R, V, v(L2, U, I)) :- http_redo(R, V, NL, v(L, U, I), _), http_join(NL, L, L2).

-- =========================================================================
-- 7. THE ROUTE a view arrives at, matched left to right.
edb(http_method_name).
http_method_name(get).  http_method_name(post).  http_method_name(put).  http_method_name(delete).
http_method_name(patch).  http_method_name(head).  http_method_name(options).
http_fits(M, M) :- http_method_name(M).
http_fits(any, M) :- http_method_name(M).
http_fits(M, any) :- http_method_name(M).
http_fits(any, any).
http_fits(head, get).

http_sfits(lit(V), lit(V)) :- http_pseg(_, _, lit(V)).
http_sfits(S, param) :- http_cur(C), http_head(C, S, _).
http_sfits(open, lit(V)) :- http_pseg(_, _, lit(V)).
http_sfits(S, open) :- http_cur(C), http_head(C, S, _).

http_try(V, P) :- net_arrives(F, X, Port, _, V), http_send(F, _, M, _), http_serves(X, Port, N, P, _, _), http_fits(M, N).
http_at_route(V, P, 0, V) :- http_try(V, P).
http_at_route(V, P, K, C2) :- http_at_route(V, P, J, C), http_head(C, S, C2), http_pseg(P, J, Q), http_sfits(S, Q),
                              K is J + 1.
http_at_route(V, P, K, C) :- http_at_route(V, P, J, C), http_pseg(P, J, star), K is J + 1.
http_at_route(V, P, J, C2) :- http_at_route(V, P, J, C), http_pseg(P, J, star), http_head(C, _, C2).
http_match(V, P) :- http_at_route(V, P, J, C), http_len(P, J), http_end(C).

http_reach(F, H, R) :- net_arrives(F, X, Port, _, V), http_send(F, _, M, _), http_serves(X, Port, N, P, H, R),
                       http_fits(M, N), http_match(V, P).
http_routed(F) :- http_reach(F, _, route).
http_unserved(F, X) :- net_arrives(F, X, _, _, _), not http_routed(F).

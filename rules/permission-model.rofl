-- rules/permission-model.rofl — THE PERMISSION FAMILY, DERIVED.
--
-- Reads facts/permission-inventory.rofl (generated by
-- scanners/permission_inventory.ts).
--   npm run perminv     rebuild the facts
--   npm run whyperm     this derivation over them
--
-- The prose half is docs/books-and-permission.md and the gate that keeps the
-- two the same SET is test/permission-doc.test.ts, which asserts these facts
-- from a fresh parse of boot.rofl rather than from the generated file.
--
-- NOTHING BELOW IS A LIST OF RELATION NAMES except one anchor, and the anchor
-- is named with its reason. Every membership, every role and every negative is
-- a rule body, so the next reader argues with the rule instead of with a
-- paragraph.

edb(boot_rule).
edb(boot_body).
edb(boot_edb).
edb(corpus_fact).
edb(corpus_rule).
edb(corpus_read).
edb(host_call).
edb(world_rows).
edb(corpus_files).
edb(corpus_unparsed).
edb(worlds_built).
edb(doc_lists).

-- ================================================== 1. what boot.rofl OWNS
-- A relation is boot.rofl's own if boot.rofl concludes it or declares it host
-- data. Everything else boot.rofl names it merely READS — the kernel's
-- reflection (`asserted_by`, `premise_lit`, `reads_from`) and the co-written
-- declaration tables (`edb`, `mode`, `reserved`) belong to the kernel and to
-- the program, not to this file.
boot_owned(Rel)   :- boot_rule(_, Rel, _, _).
boot_owned(Rel)   :- boot_edb(Rel).

boot_reads(Rel)   :- boot_body(_, Rel, _, _).
foreign(Rel)      :- boot_reads(Rel), not boot_owned(Rel).

-- =================================================== 2. THE FAMILY, derived
-- ONE ANCHOR, and it is the definition rather than a pick: `perspective(P)`
-- is the sentence that says a book EXISTS, so the permission family is
-- whatever hangs off it. Three closure rules, each with a reason:
--
--   a. a boot.rofl relation that READS a family relation is in the family
--      (`crossing` reads `sees`);
--   b. a boot.rofl relation that a family relation reads is in the family
--      (`perspective` reads `authority`);
--   c. two boot.rofl relations that read the SAME evidence are in the same
--      machinery (`forged` and `unattributed` both read `asserted_by` and
--      `in_perspective`; that shared premise is what makes the authorship
--      pair part of this story rather than a separate one).
--
-- The `boot_owned` guard on all three is what stops the closure escaping
-- through the kernel's reflection into every relation in the store.
feeds(Q, Rel)     :- boot_rule(R, Rel, _, _), boot_body(R, Q, _, _).
co_read(A, B)     :- boot_rule(R1, A, _, _), boot_body(R1, E, _, _),
                     boot_rule(R2, B, _, _), boot_body(R2, E, _, _), A != B.

family(perspective).
family(Rel)       :- boot_owned(Rel), feeds(Q, Rel), family(Q).
family(Rel)       :- boot_owned(Rel), feeds(Rel, Q), family(Q).
family(Rel)       :- boot_owned(Rel), co_read(Rel, Q), family(Q).

-- THE CONTROL, and it is what makes the closure a claim rather than a net.
-- boot.rofl also holds four STRUCTURAL audits and their helper — malformed,
-- breach, unmoded, undefined_premise, rule_known. They are boot.rofl's own,
-- they sit in the same file, and they are NOT in the family: they read the
-- shape of a program's rules and never a book or a principal. If the closure
-- ever swallows them the criterion has gone slack and this relation says so.
outside(Rel)      :- boot_owned(Rel), not family(Rel).

-- AND WHAT THE FAMILY READS BUT DOES NOT OWN. `authority` is the root of the
-- whole model and boot.rofl neither concludes it nor declares it host data:
-- it is RESERVED kernel vocabulary (`V.authority`), written by `registerPersp`
-- on a book's first use and co-written by a program's preamble. The rest is
-- the kernel's reflection — the EVIDENCE the audits judge. Both belong in the
-- inventory, so the document has to carry them and the gate has to see them.
evidence(Rel)     :- boot_rule(R, F, _, _), family(F), boot_body(R, Rel, _, _), foreign(Rel).

inventory(Rel)    :- family(Rel).
inventory(Rel)    :- evidence(Rel).

-- ================================================ 3. WHO MAY WRITE EACH ONE
-- Four writers, and the whole permission story is which of them applies.
--
--   declaration  the PROGRAM writes it by hand; boot.rofl declares it `edb`
--                so that `undefined_premise[audit]` does not read the empty
--                table as a misspelling
--   derived      boot.rofl concludes it in this tick — nobody writes it
--   carried      boot.rofl re-states it at the tick boundary, so a
--                declaration outlives the tick that made it
--   kernel       src/ writes the rows itself
declaration(Rel)  :- family(Rel), boot_edb(Rel).
derived(Rel)      :- family(Rel), boot_rule(_, Rel, _, now).
carried(Rel)      :- family(Rel), boot_rule(_, Rel, _, next).
kernel_written(Rel) :- inventory(Rel), host_call(_, Rel, store_add).

-- A relation with no rule and no `edb` line is written by the kernel and by
-- nothing else — `authority` is the only one, and that is the reason a named
-- author has standing NOWHERE until an anonymous load grants it.
kernel_only(Rel)  :- inventory(Rel), not derived(Rel), not declaration(Rel).

-- ===================================================== 4. WHERE IT LANDS
-- The head book, after `resolveBook`. An `[audit]` row is a REPORT: something
-- a reader is meant to look at. Everything else lands in [main], the default,
-- which is exactly the third job of [main] that is still unseparated for
-- these relations because none of them is in KERNEL_BOOK.
lands_in(Rel, B)  :- boot_rule(_, Rel, B, _).

-- EVERY BOOK THE RELATION IS SPELLED IN inside boot.rofl, head or body. A
-- declaration boot.rofl only ever READS (`demands_authorship`) has no head to
-- take a book from, and the corpus match below needs one for it too.
book_of(Rel, B)   :- lands_in(Rel, B).
book_of(Rel, B)   :- boot_body(_, Rel, B, _).
audit_row(Rel)    :- family(Rel), lands_in(Rel, audit).
plain_row(Rel)    :- family(Rel), lands_in(Rel, main), not audit_row(Rel).

-- WHICH BOOK AN AUDIT READS, which is the sentence its `imports` line has to
-- cover. An audit that reads [$kernel] needs `imports(audit, $kernel)`; one
-- that reads [main] needs `imports(audit, main)`; boot.rofl writes both and
-- says which rules each covers.
audit_reads(Rel, B) :- audit_row(Rel), boot_rule(R, Rel, _, _), boot_body(R, _, B, _).

-- ================================================== 5. WHO READS EACH ONE
read_in_boot(Rel) :- inventory(Rel), boot_body(_, Rel, _, _).
-- THE BOOK MUST MATCH. A demo may conclude `crossing[recon]` or
-- `exported[main](S, P, N)` and mean something entirely its own; counting
-- those as reads of the permission relation is the over-answer this model
-- would otherwise make, and `name_collision` reports them by name instead.
read_in_corpus(Rel) :- inventory(Rel), corpus_read(_, Rel, B), book_of(Rel, B).
name_collision(Prog, Rel, B) :- inventory(Rel), corpus_rule(Prog, Rel, B), not book_of(Rel, B).
read_in_host(Rel) :- inventory(Rel), host_call(_, Rel, query).
read_in_host(Rel) :- inventory(Rel), host_call(_, Rel, holds).
read_in_host(Rel) :- inventory(Rel), host_call(_, Rel, why).
read_in_host(Rel) :- inventory(Rel), host_call(_, Rel, whynot).

read_somewhere(Rel) :- read_in_boot(Rel).
read_somewhere(Rel) :- read_in_corpus(Rel).
read_somewhere(Rel) :- read_in_host(Rel).

-- THE FIRST NEGATIVE A GREP CANNOT PRODUCE: a relation the whole repository
-- derives and nothing anywhere consumes.
nothing_reads(Rel) :- inventory(Rel), not read_somewhere(Rel).

-- THE SHARPER ONE, because every relation here has SOME reader: a relation no
-- RULE anywhere consumes. It is a terminus — something a person looks at,
-- never a premise another conclusion rests on. That is the right state for an
-- audit row and a smell anywhere else, so the two are separated below.
consumed_by_a_rule(Rel) :- read_in_boot(Rel).
consumed_by_a_rule(Rel) :- read_in_corpus(Rel).
terminal(Rel)     :- inventory(Rel), not consumed_by_a_rule(Rel).
terminal_non_audit(Rel) :- terminal(Rel), not audit_row(Rel).

-- ================================================= 6. WHO WRITES EACH ONE
written_in_corpus(Rel) :- inventory(Rel), corpus_fact(_, Rel, B, _), book_of(Rel, B).
written_in_host(Rel)   :- inventory(Rel), host_call(_, Rel, assert).
written_in_host(Rel)   :- inventory(Rel), host_call(_, Rel, load).

declared_somewhere(Rel) :- written_in_corpus(Rel).
declared_somewhere(Rel) :- written_in_host(Rel).

-- THE SECOND NEGATIVE: a declaration the language offers and no .rofl program
-- in this repository has ever written. An opt-in gate nobody switched on is
-- invisible to every survey that only asks which audits are QUIET.
never_declared(Rel)  :- declaration(Rel), not written_in_corpus(Rel).
declared_only_in_a_test(Rel) :- declaration(Rel), not written_in_corpus(Rel),
                                written_in_host(Rel).

-- ============================================== 7. WHAT A WORLD ACTUALLY HAS
populated(Rel)     :- world_rows(_, Rel, _).
unpopulated(Rel)   :- inventory(Rel), not populated(Rel).

-- AN EMPTY AUDIT IS THE REQUIRED RESULT, NOT A DEFECT, and folding the two
-- together is how a green gate and a dead relation come to look alike.
-- `leak[audit]` empty in all 26 worlds is boot.rofl's own required-results
-- list being satisfied; `demands_authorship` empty is an offer nobody took.
quiet_audit(Rel)   :- audit_row(Rel), unpopulated(Rel).
dead(Rel)          :- unpopulated(Rel), not audit_row(Rel), not declaration(Rel).
untaken_offer(Rel) :- unpopulated(Rel), declaration(Rel).

-- ============================================== 8. THE GATE'S TWO QUESTIONS
-- `doc_lists(Rel)` is scanned from the document's inventory tables. Both
-- directions are asked, because a document that has gone stale usually fails
-- one way (a relation was added) and a document that has drifted fails the
-- other (a name was renamed and the old row stayed).
doc_missing(Rel)  :- inventory(Rel), not doc_lists(Rel).
doc_extra(Rel)    :- doc_lists(Rel), not inventory(Rel).

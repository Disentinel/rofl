-- js-host.rofl — THE RUNTIME LAYER: what a program reaches for that is in
-- neither the program nor the language. rules/js-env.rofl asks whether SYNTAX
-- parses; rules/js-env-api.rofl whether a PROTOTYPE METHOD exists; neither can
-- see `console.log`, `fs.readFileSync` or `fetch`, which come from the HOST.
--
-- TWO DOORS, ONE PRODUCT. A MODULE arrives through a boundary the model owns:
-- rules/js-modules.rofl classifies, canonicalises and resolves `node:fs`, and
-- the value layer follows it wherever it goes. A GLOBAL arrives from nowhere: the only
-- thing that makes `console` a global is that NOTHING IN THE PROGRAM BINDS
-- IT, a negation over the file. The doors are `host_module_ns` with
-- `builtin_member`, and `host_global_ref[code]`; they meet at
-- `host_call_effect[audit]`, the row the effect layer joins against.

-- the audits read the scanner's book; `ast_parse_error` is `edb` because
-- corpus-free worlds load this pack with no AST at all
imports(audit, code).

edb(ast_parse_error).

-- =========================================================================
-- 1. THE GLOBAL DOOR — a free global (rules/js-globals.rofl) the host carries.
-- The host stays in the row: `console` under node and under browser are two rows.
host_global_ref[code](E, H, Name) :- free_global[code](E, Name, _), host_global(H, Name).

-- `document` is a reference under `browser` and there is no `node` row for it.
host_global_only_in[code](E, H, Name) :- host_global_ref[code](E, H, Name),
                                         host(G), G != H,
                                         not host_global(G, Name).

-- =========================================================================
-- 2. THE MODULE DOOR — a VALUE that is a node builtin, or a member of one.
-- The value layer (rules/js-dataflow.rofl, external values) carries the module
-- through `require`, imports, aliases and patterns; a door matched by the
-- local name would open for a parameter that happens to be called `fs` and
-- stay shut for `const fs = require('fs')`.
builtin_ns[flow](S, Spec) :- external_value[flow](S, S), builtin_canonical[code](S, Spec).

builtin_ns_at[flow](O, Spec) :- builtin_ns[flow](Y, Spec), may_be_node[flow](O, Y).
builtin_ns_at[flow](O, Sub)  :- builtin_member[flow](X, Spec, Key), host_member_module(node, Spec, Key, Sub),
                                may_be_node[flow](O, X).

builtin_member[flow](M, Spec, Key) :- builtin_ns_at[flow](O, Spec),
                                      ast_child[code](M, object, 0, O), member_node_v[flow](M),
                                      selects[flow](M, Key).
builtin_member[flow](Sp, Spec, Key) :- external_import[code](Sp, _, S, _), builtin_canonical[code](S, Spec),
                                       ast_child[code](Sp, imported, 0, I), ast_name[code](I, Key).
builtin_member[flow](P, Spec, Key) :- builtin_ns[flow](Y, Spec), may_be_node[flow](Init, Y),
                                      decl_value[flow](D, Init),
                                      destr_prop[code](D, P, K, _, _), key_name[code](K, Key).

-- An import naming something the generated surface lacks: a typo, a member
-- newer than @types/node, or one the declarations do not carry. The module
-- door's twin of `stdlib_unattributed[audit]`.
host_import_unknown[audit](File, Spec, Key) :- external_import[code](Sp, _, _, File),
                                               builtin_member[flow](Sp, Spec, Key),
                                               not host_module_member(node, Spec, Key).

-- =========================================================================
-- 3. THE SITES — four shapes, because a rule covering three would report a
-- program as pure:
--    console.log(x)         3a. a member call on a global
--    fetch(u)               3b. a plain call of a global
--    fs.readFileSync(p)     3c. a call of a member of a module, however it
--    readFileSync(p)            was reached: dotted, imported, destructured, aliased
-- `selects[flow]` answers the key for the dotted and the computed form alike.
host_member_call[code](C, H, Name, Key) :- callee_of[code](C, N),
                                           ast_child[code](N, object, 0, O),
                                           host_global_ref[code](O, H, Name),
                                           selects[flow](N, Key).

host_global_call[code](C, H, Name) :- callee_of[code](C, N), host_global_ref[code](N, H, Name).

host_module_call[code](C, Spec, Key) :- builtin_member[flow](X, Spec, Key), may_be_node[flow](G, X),
                                        callee_of[code](C, G).

-- The union, with the receiver in the origin column: the canonical specifier
-- for a module, the global's own name for a member call, and the atom `itself`
-- for a plain call of a global, so the two shapes stay distinguishable.
host_site[code](C, node, Spec, Key) :- host_module_call[code](C, Spec, Key).
host_site[code](C, H, Name, Key)    :- host_member_call[code](C, H, Name, Key).
host_site[code](C, H, Name, itself) :- host_global_call[code](C, H, Name).
host_site_at[code](H, File, Line, Origin, Key) :- host_site[code](C, H, Origin, Key),
                                                  at[tree](C, File, _), at[tree](C, _, Line).

-- =========================================================================
-- 4. THE EFFECT ROW the effect layer joins against, at a call site, with the
-- PROVENANCE as third argument: an effect by module default and one by member
-- name are not equally strong. A member's own row wins over its module's
-- default; the negation is what makes it a default rather than a second
-- opinion (`path.resolve` would otherwise be both total and io).
member_effect[code](Spec, Key, E) :- host_member_effect(node, Spec, Key, E).
member_effect[code](Spec, Key, E) :- host_module_member(node, Spec, Key),
                                     host_module_effect(node, Spec, E),
                                     not host_member_effect(node, Spec, Key, _).

host_call_effect[audit](C, E, by_member) :- host_module_call[code](C, Spec, Key),
                                            host_member_effect(node, Spec, Key, E).
host_call_effect[audit](C, E, by_module) :- host_module_call[code](C, Spec, Key),
                                            host_module_effect(node, Spec, E),
                                            not host_member_effect(node, Spec, Key, _).
host_call_effect[audit](C, E, by_global) :- host_global_call[code](C, H, Name),
                                            host_global_effect(H, Name, E).
host_call_effect[audit](C, E, by_global) :- host_member_call[code](C, H, Name, _),
                                            host_global_effect(H, Name, E).

-- at a coordinate, and the set of effects the corpus exercises
host_effect_at[audit](E, File, Line, Why) :- host_call_effect[audit](C, E, Why),
                                             at[tree](C, File, _), at[tree](C, _, Line).
host_effect_used[audit](E) :- host_call_effect[audit](_, E, _).

-- The FRONTIER, expected non-zero: a site here is one the effect layer sees
-- as silent, which it must not mistake for `total`.
host_call_uneffected[audit](C, Origin, Key) :- host_site[code](C, _, Origin, Key),
                                             not host_call_effect[audit](C, _, _).

-- =========================================================================
-- 5. THE RUNTIME AXIS — a composition in the ES scale's shape: a runtime
-- version is a subkind of a family, `runtime_includes` orders them, and the
-- walk is `reaches` over different atoms. Reflexive on purpose: a version
-- provides its own surface.
runtime_reaches[audit](R, R) :- runtime_version(R, _, _).
runtime_reaches[audit](R, P) :- runtime_includes(R, Q), runtime_reaches[audit](Q, P).

-- `provides_api` is DERIVED from a semver point (`@since v18.9.0`) with one
-- comparison; the arithmetic lives in these three rules only. The encoding
-- is the surface pack's, maj*1000000 + min*1000 + patch, and a runtime
-- declares a MAJOR: `node18` is v18.0.0 and does NOT have `os.machine`.
runtime_vnum[code](R, VN) :- runtime_version(R, _, V), VN is V * 1000000.

-- The family is bound once and used in both premises; hard-coding `node`
-- compared the browser against node's surface and reported 718 absences.
arrived_by[code](R, Spec, Key) :- runtime_vnum[code](R, VN), runtime_version(R, F, _),
                                  host_member_since(F, Spec, Key, _, Sv), Sv <= VN.

-- What a version adds of its own. `arrived_by` is a threshold, hence monotone
-- along the chain; subtracting every predecessor keeps working the day a
-- version includes two.
inherited[code](R, Spec, Key)    :- runtime_includes(R, P), arrived_by[code](P, Spec, Key).
provides_api[code](R, Spec, Key) :- arrived_by[code](R, Spec, Key),
                                    not inherited[code](R, Spec, Key).

-- test/js-host.test.ts asserts `has_api` equals `arrived_by` set for set:
-- the walk and the comparison must agree.
has_api[audit](R, Spec, Key) :- runtime_reaches[audit](R, P), provides_api[code](P, Spec, Key).

-- The counterexample to monotone inclusion, empty by construction: with ONE
-- @types/node snapshot a removed member simply stops being in the file. A
-- second snapshot populates it with no other change.
runtime_drops[audit](A, B, Spec, Key) :- runtime_includes(A, B),
                                         has_api[audit](B, Spec, Key),
                                         not has_api[audit](A, Spec, Key).

-- -------------------------------------------------------------------------
-- THE BRIDGE between the axes, one rule: `provides_release(node18, es2022)`
-- and `reaches[audit]` from rules/js-env.rofl carries it the rest of the way.
-- No `release`, `includes` or `environment` row is minted here.
runtime_reaches_release[audit](R, Rel) :- runtime_reaches[audit](R, P),
                                          provides_release(P, Rel0),
                                          reaches[audit](Rel0, Rel).

-- `runtime_has_release` is a GUARD: a runtime with no bridge row reaches no
-- release, and without the premise every stdlib call reports unsupported
-- against it. `runtime_lib_unsupported` is `lib_unsupported[audit]` asked of
-- a runtime over the same `lib_call[code]`.
runtime_has_release(R) :- runtime_reaches_release[audit](R, _).
runtime_no_release[audit](R) :- runtime_version(R, _, _), not runtime_has_release(R).
runtime_lib_unsupported[audit](R, C, P, Key) :- lib_call[code](C, P, Key, Rel),
                                                runtime_has_release(R),
                                                not runtime_reaches_release[audit](R, Rel).

-- -------------------------------------------------------------------------
-- THE VERSION QUESTION AT A SITE: this call, this member, this line.
host_member_absent[audit](R, Spec, Key) :- runtime_version(R, F, _),
                                           host_member_since(F, Spec, Key, _, _),
                                           not has_api[audit](R, Spec, Key).
host_call_absent[audit](R, C, Spec, Key) :- host_module_call[code](C, Spec, Key),
                                            host_member_absent[audit](R, Spec, Key).
host_call_absent_at[audit](R, File, Line, Spec, Key) :- host_call_absent[audit](R, C, Spec, Key),
                                                        at[tree](C, File, _), at[tree](C, _, Line).

-- The set difference between two runtimes, WITHIN ONE FAMILY (a browser did
-- not LOSE `fs`), and with no ordering premise, as `lost[audit]` in js-env.
host_lost[audit](From, To, C, Spec, Key) :- host_call_absent[audit](To, C, Spec, Key),
                                            runtime_version(To, F, _),
                                            runtime_version(From, F, _), From != To,
                                            not host_call_absent[audit](From, C, Spec, Key).

-- -------------------------------------------------------------------------
-- THE DEPRECATION — the visible half of a removal and the only half this
-- source records; a deprecation note naming its replacement is one join from
-- a remedy.
host_call_deprecated[audit](C, Spec, Key) :- host_module_call[code](C, Spec, Key),
                                             host_member_deprecated(node, Spec, Key).
host_call_remedy[audit](C, Spec, Key, Use) :- host_call_deprecated[audit](C, Spec, Key),
                                              host_member_replaced_by(node, Spec, Key, Use).

-- =========================================================================
-- 6. THE GATES. Each is a statement this layer makes about itself, and
-- test/js-host.test.ts plants a defect for every one.
--
-- an effect atom nobody declared: a misspelt `ioo` would propagate as real
host_effect_undeclared[audit](E) :- host_module_effect(_, _, E), not host_effect_atom(E).
host_effect_undeclared[audit](E) :- host_member_effect(_, _, _, E), not host_effect_atom(E).
host_effect_undeclared[audit](E) :- host_global_effect(_, _, E), not host_effect_atom(E).

-- the authored effect table accountable to the generated surface
host_effect_orphan[audit](Spec, Key) :- host_member_effect(node, Spec, Key, _),
                                        not host_module_member(node, Spec, Key).
host_effect_orphan[audit](Spec, global) :- host_module_effect(node, Spec, _),
                                           not host_module(node, Spec).
host_global_effect_orphan[audit](H, Name) :- host_global_effect(H, Name, _),
                                             not host_global(H, Name).

-- The residue, over hosts that CLAIM attribution; `host_no_effects` is a
-- declared absence rather than a permanently red gate.
effects_claimed(H) :- host(H), not host_no_effects(H, _).
host_module_uneffected[audit](Spec) :- host_module(node, Spec),
                                       not host_module_effect(node, Spec, _).
host_global_uneffected[audit](H, Name) :- host_global(H, Name), effects_claimed(H),
                                          not host_global_effect(H, Name, _).

-- a runtime with no version answers NO to every version question and looks
-- new rather than broken; `runtime_undated` is the waiver for `browser`
runtime_unversioned[audit](R) :- runtime_version(R, _, 0), not runtime_undated(R, _).

-- two runtimes agreeing on every member are one runtime; no ordering premise,
-- for the reason `env_pair_indistinct` records
runtime_separates[audit](A, B) :- host_member_absent[audit](B, Spec, Key),
                                  not host_member_absent[audit](A, Spec, Key).
runtime_pair_indistinct[audit](A, B) :- runtime_version(A, F, _), runtime_version(B, F, _),
                                        A != B,
                                        not runtime_separates[audit](A, B),
                                        not runtime_separates[audit](B, A).

-- an inclusion ACROSS families claims one runtime is a later edition of
-- another; the order is not total across families
runtime_family_undeclared[audit](R, F) :- runtime_version(R, F, _), not runtime(F).
runtime_cross_family[audit](A, B) :- runtime_includes(A, B),
                                     runtime_version(A, FA, _), runtime_version(B, FB, _),
                                     FA != FB.

-- `host/1` is generated, `runtime/1` authored; they must name the same families
host_family_mismatch[audit](H) :- host(H), not runtime(H).
host_family_mismatch[audit](F) :- runtime(F), not host(F).

-- =========================================================================
-- 7. THE ENVIRONMENT a program reads: `process.env.NAME`, `process.env[k]`,
-- `const { NAME } = process.env`, through any alias of `process.env`. A key the
-- value layer cannot name is said, with its place, rather than dropped.
env_member[flow](M) :- host_global_ref[code](P, node, "process"), ast_child[code](M, object, 0, P),
                       member_node_v[flow](M), selects[flow](M, "env").
sx_env[surface](M)  :- env_member[flow](M).
env_object[flow](M) :- sx_env[surface](M).
env_object[flow](E) :- may_be_node[flow](E, M), sx_env[surface](M).
env_object[flow](E) :- sees_binder[code](E, D), binder[code](D, _, Init, _), env_object[flow](Init).

env_key[flow](M) :- env_object[flow](O), ast_child[code](M, object, 0, O), member_node_v[flow](M).
env_written[flow](M) :- env_key[flow](M), ast_child[code](A, left, 0, M), ast_node[code](A, assignment_expression, _).

env_read[flow](M, Name) :- env_key[flow](M), selects[flow](M, Name), not env_written[flow](M).
env_write[flow](M, Name) :- env_written[flow](M), selects[flow](M, Name).
env_read[flow](P, Name) :- decl_value[flow](D, Init), sx_env[surface](Init),
                           destr_prop[code](D, P, K, _, _), key_name[code](K, Name).
env_read_unnamed[flow](M)  :- env_key[flow](M), not env_named[flow](M), not env_written[flow](M).
env_write_unnamed[flow](M) :- env_written[flow](M), not env_named[flow](M).
env_named[flow](M) :- env_key[flow](M), selects[flow](M, _).

env_read_at[flow](Name, File, Line) :- env_read[flow](M, Name), at[tree](M, File, _), at[tree](M, _, Line).
env_read_unnamed_at[flow](File, Line) :- env_read_unnamed[flow](M), at[tree](M, File, _), at[tree](M, _, Line).
env_write_unnamed_at[flow](File, Line) :- env_write_unnamed[flow](M), at[tree](M, File, _), at[tree](M, _, Line).

-- url.rofl — A URL AS SEGMENTS, AND A ROUTE PATTERN THAT MATCHES IT (w_url_pack).
--
-- Knows nothing about JavaScript. Its input is three tables a host fills:
--   url_request(U)   U may be the address a request is sent to
--   url_pattern(P)   P is a route pattern a server answers
--   url_str(V)       V, a leaf of one of them, is a string
-- U and P are TEXTS, the terms of rules/js-concat.rofl: a string, or
-- cat(A, B), join(A, B), url(Base, Rel), url(A), join(A) over texts; any other
-- leaf (`ref(_)`, `node(_)`, a number, a dirname) is a value nothing knows, one
-- DYNAMIC piece. The kernel builds no strings, so a text is never glued: it is
-- cut into segments, piece by piece, and the segments are compared.
--
-- What it answers:
--   url_seg(U, K, S)    segment K of U: lit(V), open (some piece is dynamic, or
--                       two literal pieces meet in it), or empty
--   url_from(U, K)      the path starts at segment K (after scheme and host)
--   url_host(U, H)      the host and port, when written
--   url_open(U)         U starts with a dynamic piece: its prefix is unknown
--   url_opaque(U)       nothing after the unknown prefix: U says no path at all
--   url_match(P, U)     U may be a path P answers
--
-- A pattern segment `:name` is a parameter and matches one segment; `*` matches
-- any number of segments, none included. A dynamic piece between slashes is
-- taken for one whole segment. Empty segments are skipped on both sides, so a
-- doubled or trailing slash and a prefix glued to a route (`/api` + `/users`)
-- read as the path they make. Query and fragment are cut at `?` and `#`.

-- =========================================================================
-- 1. THE TERMS, top down, each compound taken apart once.
url_top(U) :- url_request(U).
url_top(P) :- url_pattern(P).
url_term(T) :- url_top(T).
url_part(cat(A, B), A, B, cat)   :- url_term(cat(A, B)).
url_part(join(A, B), A, B, join) :- url_term(join(A, B)).
url_part(url(A, B), A, B, url)   :- url_term(url(A, B)).
url_one(join(A), A) :- url_term(join(A)).
url_one(url(A), A)  :- url_term(url(A)).
url_term(A) :- url_part(_, A, _, _).
url_term(B) :- url_part(_, _, B, _).
url_term(A) :- url_one(_, A).

url_compound(T) :- url_part(T, _, _, _).
url_compound(T) :- url_one(T, _).
url_leaf_str(V) :- url_term(V), url_str(V).
url_dyn(T) :- url_term(T), not url_compound(T), not url_str(T).

-- =========================================================================
-- 2. THE PIECES, bottom up. `url_span(T, N, E)`: T holds N slashes before its
-- end; E is `yes` when a `?` or `#` ended it, and then nothing after it counts.
-- `url_atom(T, K, X)`: segment K of T holds the piece X, lit(V) or dyn.
url_q(V, V, no)  :- url_leaf_str(V), N is str_segs(V, "?"), N = 1.
url_q(V, Q, yes) :- url_leaf_str(V), N is str_segs(V, "?"), N > 1, Q is str_pre(V, "?").
url_path(V, Q, E)   :- url_q(V, Q, E), N is str_segs(Q, "#"), N = 1.
url_path(V, P, yes) :- url_q(V, Q, _), N is str_segs(Q, "#"), N > 1, P is str_pre(Q, "#").

url_span(V, M, E) :- url_path(V, P, E), N is str_segs(P, "/"), M is N - 1.
url_cut(V, P, 0) :- url_path(V, P, _).
url_cut(V, P, K) :- url_cut(V, P, J), url_span(V, M, _), J < M, K is J + 1.
url_atom(V, K, lit(S)) :- url_cut(V, P, K), S is str_seg(P, "/", K).

url_span(T, 0, no) :- url_dyn(T).
url_atom(T, 0, dyn) :- url_dyn(T).

-- A sequence: B goes on where A stops, unless A ended. `join` puts a slash
-- between; a one-argument `join` and `url` are their argument.
url_seq(T, A, B, 0) :- url_part(T, A, B, cat).
url_seq(T, A, B, 1) :- url_part(T, A, B, join).
url_span(T, N, yes) :- url_seq(T, A, _, _), url_span(A, N, yes).
url_span(T, N, E)   :- url_seq(T, A, B, G), url_span(A, NA, no), url_span(B, NB, E), N is NA + G + NB.
url_atom(T, K, X)   :- url_seq(T, A, _, _), url_atom(A, K, X).
url_atom(T, K, X)   :- url_seq(T, A, B, G), url_span(A, NA, no), url_atom(B, J, X), K is NA + G + J.

-- `new URL(rel, base)`: a rel with a scheme or a leading slash replaces the
-- base's path; any other is read under it.
url_same(T, A) :- url_one(T, A).
url_same(T, R) :- url_part(T, _, R, url), url_rooted(R).
url_seq(T, B, R, 1) :- url_part(T, B, R, url), not url_rooted(R).
url_span(T, N, E) :- url_same(T, A), url_span(A, N, E).
url_atom(T, K, X) :- url_same(T, A), url_atom(A, K, X).

-- Read off the first string of R, so that the cut above never waits on itself.
url_first(V, V) :- url_leaf_str(V).
url_first(T, V) :- url_part(T, A, _, K), K != url, url_first(A, V).
url_first(T, V) :- url_one(T, A), url_first(A, V).
url_rooted(R) :- url_first(R, V), L is str_len(V), L > 0, C is str_char(V, 0), C = "/".
url_rooted(R) :- url_first(R, V), N is str_segs(V, "://"), N > 1.

-- =========================================================================
-- 3. THE SEGMENTS of a request or a pattern.
url_top(U) :- url_request(U).
url_top(P) :- url_pattern(P).
url_text_at(U, K, V) :- url_top(U), url_atom(U, K, lit(V)), V != "".
url_dyn_at(U, K)     :- url_top(U), url_atom(U, K, dyn).
url_two_at(U, K)     :- url_text_at(U, K, V), url_text_at(U, K, W), V != W.
url_has_text(U, K)   :- url_text_at(U, K, _).

url_seg(U, K, lit(V)) :- url_text_at(U, K, V), not url_dyn_at(U, K), not url_two_at(U, K).
url_seg(U, K, open)   :- url_dyn_at(U, K).
url_seg(U, K, open)   :- url_two_at(U, K).
url_seg(U, K, empty)  :- url_top(U), url_atom(U, K, _), not url_dyn_at(U, K), not url_has_text(U, K).
url_segs(U, N) :- url_top(U), url_span(U, M, _), N is M + 1.

-- `scheme:` `` `host` and then the path.
url_scheme(U) :- url_atom(U, 0, lit(V)), url_atom(U, 1, lit("")), url_span(U, N, _), N >= 2,
                 L is str_len(V), L > 1, I is L - 1, C is str_char(V, I), C = ":".
url_host(U, H) :- url_top(U), url_scheme(U), url_seg(U, 2, lit(H)).
url_from(U, 3) :- url_top(U), url_scheme(U).
url_from(U, 0) :- url_top(U), not url_scheme(U), not url_open(U).
url_open(U)    :- url_top(U), url_seg(U, 0, open).
url_opaque(U)  :- url_open(U), not url_said(U).
url_said(U)    :- url_open(U), url_seg(U, K, S), K > 0, S != empty.

-- =========================================================================
-- 4. THE MATCH. A pattern segment is a literal, a parameter, a star, open or
-- empty; a request's open segment may be any literal, as a may-set must say.
url_pseg(P, K, param)  :- url_pattern(P), url_seg(P, K, lit(V)), C is str_char(V, 0), C = ":".
url_pseg(P, K, star)   :- url_pattern(P), url_seg(P, K, lit("*")).
url_pseg(P, K, lit(V)) :- url_pattern(P), url_seg(P, K, lit(V)), C is str_char(V, 0), C != ":", V != "*".
url_pseg(P, K, open)   :- url_pattern(P), url_seg(P, K, open).
url_pseg(P, K, empty)  :- url_pattern(P), url_seg(P, K, empty).

-- the first segment that is not empty, or `end` when the path is only slashes
url_start(U, I) :- url_from(U, I).
url_start(U, 1) :- url_open(U).
url_skip(U, I) :- url_start(U, I).
url_skip(U, I) :- url_skip(U, H), url_seg(U, H, empty), I is H + 1.
url_lead(U, I, S)   :- url_skip(U, I), url_seg(U, I, S), S != empty.
url_lead(U, I, end) :- url_skip(U, I), url_segs(U, I).

url_rkind(S) :- url_request(U), url_seg(U, _, S), S != empty.
url_rkind(end).
url_pkind(Q) :- url_pseg(_, _, Q).
url_pkind(end).
url_fits(lit(V), lit(V)) :- url_rkind(lit(V)), url_pkind(lit(V)).
url_fits(S, param)       :- url_rkind(S), S != end, url_pkind(param).
url_fits(open, lit(V))   :- url_rkind(open), url_pkind(lit(V)).
url_fits(S, open)        :- url_rkind(S), S != end, url_pkind(open).
url_fits(S, star)        :- url_rkind(S), url_pkind(star).
url_fits(end, end).

-- THE DECISION for a request whose prefix is unknown (`${base}/users`, base
-- untraced): `suffix` matches its known tail against the end of every pattern,
-- the safe direction for a may-set; without the row such a request matches
-- nothing. A request that says no path at all is `url_opaque` and matches
-- nothing either way.
edb(url_open_prefix).
url_open_prefix(suffix).

-- A pair starts where the two leads fit, so a request meets only the patterns
-- its first segment may be.
url_plead(P, J, Q) :- url_pattern(P), url_lead(P, J, S), url_pkind_of(P, J, S, Q).
url_pkind_of(P, J, end, end) :- url_lead(P, J, end).
url_pkind_of(P, J, S, Q) :- url_lead(P, J, S), S != end, url_pseg(P, J, Q).
url_at(U, P, I, J) :- url_request(U), url_from(U, _), url_lead(U, I, S), url_fits(S, Q), url_plead(P, J, Q).
url_at(U, P, I, J) :- url_request(U), url_open(U), url_lead(U, I, S), S != end, url_fits(S, Q), url_pseg(P, J, Q),
                      url_open_prefix(suffix).
url_at(U, P, I, J) :- url_at(U, P, H, J), url_seg(U, H, empty), I is H + 1.
url_at(U, P, I, J) :- url_at(U, P, I, H), url_pseg(P, H, empty), J is H + 1.
url_at(U, P, I, J) :- url_at(U, P, H, G), url_seg(U, H, S), url_pseg(P, G, Q), url_fits(S, Q),
                      I is H + 1, J is G + 1.
url_at(U, P, I, J) :- url_at(U, P, I, H), url_pseg(P, H, star), J is H + 1.
url_at(U, P, I, J) :- url_at(U, P, H, J), url_pseg(P, J, star), url_seg(U, H, S), S != empty, I is H + 1.
url_match(P, U) :- url_at(U, P, I, J), url_segs(U, I), url_segs(P, J).

-- js-callgraph.rofl — ONE construct, the FUNCTION CALL, at the call-graph
-- layer. Written over the scanner's four relations plus js-structure's
-- ast_within / ast_name / ast_value, and nothing else: the scanner judged
-- nothing and every classification below is this file's.
--
-- THE FINISH LINE IS NOT "the rule fires". It is that every callee SHAPE in
-- the corpus either has a rule or has a typed verdict saying why not. A model
-- that resolves `f(x)` and says nothing about `o.m()` reports a SMALLER call
-- graph that looks correct, and that silent under-report is the failure this
-- file is built against. So the classification is a TOTAL function — every
-- call site gets exactly one shape, including the shapes nothing resolves —
-- and `unresolved_call` is a POSITIVE relation, countable and queryable,
-- rather than the absence of a row.
--
-- Depends on rules/js-model.rofl for the `unknown_type` taxonomy (which
-- reasons are irreducible and which are ours). Load both.

-- ===========================================================================
-- 1. CALL SITES

edb(call_kind).
call_kind(call_expression).
call_kind(optional_call_expression).

call_site[code](C, File)      :- ast_node[code](C, K, File, _), call_kind(K).
call_site_kind[code](C, K)    :- ast_node[code](C, K, _, _), call_kind(K).
call_line[code](C, Line)      :- call_site[code](C, _), ast_node[code](C, _, _, Line).

callee_of[code](C, N)         :- call_site[code](C, _), ast_child[code](C, callee, 0, N).
callee_kind[code](C, K)       :- callee_of[code](C, N), ast_node[code](N, K, _, _).

-- NOT EVERY CONTROL TRANSFER IS A CALL EXPRESSION. `new C()` runs C's
-- constructor and is not a call site under any reading of the grammar, so a
-- model built only on CallExpression misses that edge with nothing to point
-- at. Declaring it a TRANSFER SITE does not resolve it — it makes the miss
-- attributable, which is the difference between a gap and a silence.
edb(transfer_kind).
transfer_kind(new_expression).
transfer_site[code](X, K) :- ast_node[code](X, K, _, _), transfer_kind(K).

-- what an enclosing function can be asked about: a call site or a transfer site
site[code](X) :- call_site[code](X, _).
site[code](X) :- transfer_site[code](X, _).

-- arguments, WITH THEIR POSITION. The index is not decoration: without it
-- `f(a, b)` and `f(b, a)` are the same fact set, so which function is passed
-- in the callback slot becomes unanswerable.
call_arg[code](C, I, A)       :- call_site[code](C, _), ast_child[code](C, arguments, I, A).

-- ===========================================================================
-- 2. CALLEE SHAPE — a TOTAL classification, which IS the frontier
--
-- Two mapping tables and a catch-all, rather than a chain of negations: a
-- rule that says "everything else" by negating its own head is unstratifiable,
-- and the table makes the closed set of shapes readable in one place.

edb(callee_shape).
callee_shape(identifier,                s_identifier).
callee_shape(arrow_function_expression, s_iife).
callee_shape(function_expression,       s_iife).
callee_shape(super,                     s_super).
-- NOT `ts_non_null_expression`: atomise() inserts a break only between a
-- lower-case and an upper-case letter, so the acronym `TSN` survives whole.
-- The first version of this table guessed the split, matched nothing, and the
-- site landed in s_unclassified — which is exactly what the catch-all is for.
callee_shape(tsnon_null_expression,     s_non_null).
callee_shape(call_expression,           s_call_result).
callee_shape(optional_call_expression,  s_call_result).
callee_shape(new_expression,            s_new_result).
callee_shape(import,                    s_dynamic_import).
callee_shape(sequence_expression,       s_sequence).
callee_shape(parenthesized_expression,  s_parenthesized).
callee_shape(tsas_expression,           s_ts_as).
callee_shape(conditional_expression,    s_conditional).

-- member callees need two more bits: `computed`, and the object's kind.
edb(member_kind).
member_kind(member_expression).
member_kind(optional_member_expression).

member_like[code](C, N)     :- callee_of[code](C, N), ast_node[code](N, K, _, _), member_kind(K).
optional_member[code](C)    :- callee_of[code](C, N), ast_node[code](N, optional_member_expression, _, _).
computed_member[code](C, N) :- member_like[code](C, N), ast_attr[code](N, computed, true).
static_member[code](C, N)   :- member_like[code](C, N), ast_attr[code](N, computed, false).

callee_obj[code](C, O)      :- member_like[code](C, N), ast_child[code](N, object, 0, O).
callee_obj_kind[code](C, K) :- callee_obj[code](C, O), ast_node[code](O, K, _, _).
callee_prop[code](C, P)     :- member_like[code](C, N), ast_child[code](N, property, 0, P).

edb(obj_kind_class).
obj_kind_class(identifier,                 o_ident).
obj_kind_class(member_expression,          o_member).
obj_kind_class(optional_member_expression, o_member).
obj_kind_class(call_expression,            o_call).
obj_kind_class(optional_call_expression,   o_call).
obj_kind_class(this_expression,            o_this).
obj_kind_class(super,                      o_super).
obj_kind_class(array_expression,           o_array).
obj_kind_class(new_expression,             o_new).
obj_kind_class(object_expression,          o_object_literal).
obj_kind_class(string_literal,             o_literal).
obj_kind_class(numeric_literal,            o_literal).

-- EIGHT KINDS THAT USED TO SHARE THE CATCH-ALL, split because they do not
-- share a VERDICT. Measured on a probe corpus with one site per kind, all in
-- one run: `conditional`, `sequence`, the two TypeScript wrappers and the
-- parenthesis already RESOLVED and needed nothing but a name; `logical` and
-- `assignment` needed one value rule each, now in rules/js-dataflow.rofl;
-- `await` belongs to the control-form item and `template` answers through the
-- String prototype, which is the standard library and a different programme.
-- One bucket carrying four different answers reports the same `not_yet` for a
-- form that works and a form nobody has started, which is the defect
-- `s_parenthesized` already paid for one layer down.
obj_kind_class(conditional_expression,     o_conditional).
obj_kind_class(sequence_expression,        o_sequence).
obj_kind_class(logical_expression,         o_logical).
obj_kind_class(assignment_expression,      o_assignment).
obj_kind_class(await_expression,           o_await).
obj_kind_class(template_literal,           o_template).
obj_kind_class(tsas_expression,            o_cast).
obj_kind_class(tsnon_null_expression,      o_non_null).

obj_kind_known(K)           :- obj_kind_class(K, _).
obj_class[code](C, Cl)      :- callee_obj_kind[code](C, K), obj_kind_class(K, Cl).
obj_class[code](C, o_other) :- callee_obj_kind[code](C, K), not obj_kind_known(K).

edb(member_shape).
member_shape(o_ident,          s_member_on_ident).
member_shape(o_member,         s_member_on_member).
member_shape(o_call,           s_member_on_call).
member_shape(o_this,           s_member_on_this).
member_shape(o_super,          s_member_on_super).
member_shape(o_array,          s_member_on_array).
member_shape(o_new,            s_member_on_new).
member_shape(o_object_literal, s_member_on_object_literal).
member_shape(o_literal,        s_member_on_literal).
member_shape(o_conditional,    s_member_on_conditional).
member_shape(o_sequence,       s_member_on_sequence).
member_shape(o_logical,        s_member_on_logical).
member_shape(o_assignment,     s_member_on_assignment).
member_shape(o_await,          s_member_on_await).
member_shape(o_template,       s_member_on_template).
member_shape(o_cast,           s_member_on_cast).
member_shape(o_non_null,       s_member_on_non_null).
member_shape(o_other,          s_member_on_other).

-- A COMPUTED callee is the one place the taxonomy's `runtime_dependent` is
-- honest: `o[k]()` with a non-literal k names a method that does not exist
-- until the program runs. `a.b.c()` does NOT qualify and must never borrow
-- that reason.
edb(static_key_kind).
static_key_kind(string_literal).
static_key_kind(numeric_literal).

computed_key_static[code](C) :- computed_member[code](C, _), callee_prop[code](C, P),
                                ast_node[code](P, K, _, _), static_key_kind(K).

-- A THIRD CASE, and it is the interesting one: `o[`fixed`]()`. The key is
-- fixed at parse time, so calling it `runtime_dependent` would be a lie — and
-- it is not derivable either, because the scanner's contract carries only
-- SCALAR own properties and `TemplateElement.value` is `{raw, cooked}`, an
-- object. The text of the template is simply not in the fact vocabulary. That
-- is `not_yet` with a named cause in the layer below, which is a different
-- verdict from both of its neighbours, and collapsing it into either would
-- misreport where the work is.
computed_key_template[code](C) :- computed_member[code](C, _), callee_prop[code](C, P),
                                  ast_node[code](P, template_literal, _, _).

shape_known[code](C, S) :- callee_kind[code](C, K), callee_shape(K, S).
shape_known[code](C, s_computed_literal_key) :- computed_member[code](C, _),
                                                computed_key_static[code](C).
shape_known[code](C, s_computed_template_key) :- computed_key_template[code](C).
shape_known[code](C, s_computed_dynamic_key) :- computed_member[code](C, _),
                                                not computed_key_static[code](C),
                                                not computed_key_template[code](C).
shape_known[code](C, s_optional_member)      :- static_member[code](C, _),
                                                optional_member[code](C).
shape_known[code](C, S) :- static_member[code](C, _), not optional_member[code](C),
                           obj_class[code](C, Cl), member_shape(Cl, S).

-- THE CATCH-ALL, and the reason shape_known exists as a separate relation:
-- `shape` may negate `has_shape` because `has_shape` does not depend on
-- `shape`. A grammar form nobody anticipated lands here rather than vanishing.
has_shape[code](C)             :- shape_known[code](C, _).
shape[code](C, S)              :- shape_known[code](C, S).
shape[code](C, s_unclassified) :- call_site[code](C, _), not has_shape[code](C).

-- ...AND THE SAME NEWS ONE LEVEL DOWN. `s_member_on_other` is the object-kind
-- catcher, waived in facts/js-shapes.rofl as empty by design, and that waiver
-- is only honest while it IS empty. A member callee whose object is a form
-- `obj_kind_class` does not name — a function expression, a boolean literal, a
-- regular expression, a class expression — lands here, and the row says so with
-- the kind named so the split can continue rather than the bucket growing.
catch_all_occupied[audit](K) :- shape[code](C, s_member_on_other),
                                callee_obj_kind[code](C, K).

-- and the two ways totality can fail, each a positive row
shaped[code](C)         :- shape[code](C, _).
unshaped[audit](C)      :- call_site[code](C, _), not shaped[code](C).
multi_shape[audit](C, A, B) :- shape[code](C, A), shape[code](C, B), A != B.

-- ===========================================================================
-- 3. THE ENCLOSING FUNCTION — nearest, which is where negation earns its keep

edb(fn_kind).
fn_kind(function_declaration).
fn_kind(function_expression).
fn_kind(arrow_function_expression).
fn_kind(object_method).
fn_kind(class_method).
fn_kind(class_private_method).

fn_node[code](F)     :- ast_node[code](F, K, _, _), fn_kind(K).
fn_file[code](F, File) :- fn_node[code](F), ast_node[code](F, _, File, _).

-- A function's name is whatever binds it. Several rules, because JS has
-- several ways, and a relation may hold more than one name for one node.
fn_name[code](F, N) :- ast_node[code](F, function_declaration, _, _),
                       ast_child[code](F, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- ast_node[code](F, function_expression, _, _),
                       ast_child[code](F, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- ast_node[code](F, object_method, _, _),
                       ast_child[code](F, key, 0, K), ast_name[code](K, N).
-- ...except a CONSTRUCTOR, which does not answer to the word `constructor` at
-- run time: V8 reports the frame as `new Box`, and the rule below gives it the
-- CLASS's name. Without this exclusion the constructor edge is derived twice —
-- once correctly and once as `-> constructor`, an edge no execution produces.
-- Measured the moment the constructor edge landed: over-approximation 0 to 2.
ctor_method[code](F)   :- ast_node[code](F, class_method, _, _),
                          ast_attr[code](F, kind, "constructor").
fn_name[code](F, N) :- ast_node[code](F, class_method, _, _), not ctor_method[code](F),
                       ast_child[code](F, key, 0, K), ast_name[code](K, N).
fn_name[code](F, N) :- fn_node[code](F), ast_node[code](D, variable_declarator, _, _),
                       ast_child[code](D, init, 0, F),
                       ast_child[code](D, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- fn_node[code](F), ast_node[code](P, object_property, _, _),
                       ast_child[code](P, value, 0, F),
                       ast_child[code](P, key, 0, K), ast_name[code](K, N).
-- a constructor answers to the CLASS's name at runtime, which is what a stack
-- frame says and therefore what an execution oracle can be compared against
fn_name[code](F, N) :- ast_node[code](F, class_method, _, _),
                       ast_attr[code](F, kind, "constructor"),
                       ast_child[code](CD, body, 0, B), ast_child[code](B, body, _, F),
                       ast_child[code](CD, id, 0, I), ast_name[code](I, N).

encloses[code](F, C)   :- fn_node[code](F), site[code](C), ast_within[code](F, C).
-- F is not the nearest if some OTHER enclosing G sits inside it. `F != G`
-- is carried explicitly so the rule does not silently depend on ast_within
-- being irreflexive.
closer[code](F, C)     :- encloses[code](F, C), encloses[code](G, C),
                          ast_within[code](F, G), F != G.
nearest_fn[code](F, C) :- encloses[code](F, C), not closer[code](F, C).

enclosed[code](C)      :- encloses[code](_, C).
top_call[code](C, R)   :- call_site[code](C, File), ast_file[code](R, File),
                          not enclosed[code](C).
top_site[code](X, R)   :- site[code](X), ast_node[code](X, _, File, _),
                          ast_file[code](R, File), not enclosed[code](X).

-- ===========================================================================
-- 4. RESOLUTION
--
-- Scope-blind ON PURPOSE and this is a declared over-approximation: a name
-- bound anywhere in the file answers a call anywhere in the file. Shadowing
-- and block scope are the scope layer's job, not this one's.

-- TIER 1: identifier callee naming a function bound in the SAME file.


-- TIER 1b: an IIFE resolves to its own callee. Exact, with no name involved.

-- TIER 2: `ns.method()` where ns is a local object literal.

obj_member_fn[code](O, Key, M) :- ast_node[code](O, object_expression, _, _),
                                  ast_child[code](O, properties, _, M),
                                  ast_node[code](M, object_method, _, _),
                                  ast_child[code](M, key, 0, K), ast_name[code](K, Key).
obj_member_fn[code](O, Key, F) :- ast_node[code](O, object_expression, _, _),
                                  ast_child[code](O, properties, _, P),
                                  ast_node[code](P, object_property, _, _),
                                  ast_child[code](P, key, 0, K), ast_name[code](K, Key),
                                  ast_child[code](P, value, 0, F), fn_node[code](F).


-- TIER 3: an identifier callee naming a PARAMETER, resolved through the value
-- the caller passed at that index. This is the hole that lives INSIDE a shape
-- the model claims to handle, and no shape census can show it: the axis is
-- syntactic and `f(n)` where `f` is a parameter is spelled exactly like `f(n)`
-- where `f` is a declaration. The execution oracle found it — `apply2 -> leaf`
-- and `apply2 -> mid` were two of eleven under-reported edges — and the frontier
-- attributed them to `s_identifier`, which is why they were worth closing first.
--
-- IT IS A CYCLE, and that is the whole reason this needed measuring before it
-- was written: `param_bind` reads `resolves` to know which function a call site
-- goes to, and `resolves` reads `param_bind` to answer a parameter callee. The
-- kernel takes it — the recursion is positive, the negations it stands on
-- (`not closer`, `not has_shape`) sit outside the cycle, and the fixpoint
-- settles. A kill set — `not rebound` inside the cycle — is refused under
-- stratified semantics and admitted under `semantics(well_founded)` at about
-- five times the cost; neither is needed here, because binding a parameter to
-- every function that reaches it is the sound direction for a call graph.
--
-- CONTEXT-INSENSITIVE, declared: a function called twice with two different
-- callbacks binds its parameter to BOTH, at every site. That is an
-- over-approximation of the same family as tier 1's scope blindness, and it is
-- visible rather than averaged away — `ambiguous_call[audit]` reports a site
-- resolving two ways, and the oracle comparison counts an edge the runtime
-- never ran. A context-sensitive version is a different analysis, not a fix.


-- TIER 4: WHAT OBJECT DOES THIS EXPRESSION DENOTE?
--
-- The shape census lists `o.m()`, `a.b.c()`, `this.m()`, `f().g()`, `o[k]()`,
-- `new C().m()` as six different shapes, and tier 2 answered exactly one of
-- them. Writing five more resolution rules would have been the obvious move and
-- it is the wrong one: THEY ARE NOT SIX QUESTIONS. Every one of them is
--
--     resolve the OBJECT half, then look the KEY up in it
--
-- and they differ only in how the object half is spelled. So the rule is one
-- rule, and the shapes become ENTRY POINTS into a single relation that answers
-- `what does this expression denote`. That is also why this closes shapes the
-- corpus does not contain — `new C().m()` has no site here and needs no rule of
-- its own once `new C()` denotes the class.
--
-- WHAT AN OBJECT IS, for this layer: a node that can answer `.k`. Two kinds do,
-- and they are not alike in the language but are identical in this question.



-- THE KEY, and the computed/static distinction collapses HERE rather than in
-- the shape table: `o.pick` and `o["pick"]` select the same member and differ
-- only in where the text is. `o[k]` with a variable k has no key at all and
-- therefore never reaches this relation — which is the same refusal the shape
-- axis records as `runtime_dependent`, arriving as an absence instead of a
-- special case.
-- ...and the computed branch now asks the DATAFLOW layer what the key may be,
-- which makes the literal case and the const case ONE rule. `o["pick"]()` and
-- `const k = "pick"; o[k]()` differ only in how far the value travelled, and
-- `may_be_lit` is what closes that distance. Requires rules/js-dataflow.rofl.

-- ENTRY 1 — an identifier bound to an object literal. This is tier 2's premise,
-- lifted out of the resolution rule so the other four can share it.

-- ENTRY 2 — an identifier bound to `new C()`. `const b = new Box(1); b.both()`
-- was a miss the oracle caught, and it is NOT the constructor edge: this rule
-- says what `b` IS, and says nothing about `new Box(1)` being a call.

-- ENTRIES 3 AND 4 WENT HOME 2026-09-04. `this` inside a class method, and the
-- recursion through a member of something that already denotes, were both
-- DATAFLOW facts written here because here is where they were first needed —
-- the same way `param_bind` was. rules/js-dataflow.rofl answers both now
-- (`may_be_node` entries 6 and 8), and entry 5 below projects them, so the
-- deletion cost nothing: `useDeep -> dig` and `both -> get` are still derived,
-- through one relation instead of two copies of it.

-- ENTRY 5 — WHATEVER THE DATAFLOW LAYER CAN VALUE, which after the move above
-- is most of it: an object literal reached through a name, a member of one at
-- any depth, `this` in a class method, and a call's return value. This one rule
-- is what makes the deletion above free.

-- THE ONE RESOLUTION RULE the entries feed. Note what is NOT here: the
-- shape. A rule keyed by shape would have to be repeated per shape and would
-- silently stop covering a shape nobody thought of; keyed by the QUESTION, it
-- covers every spelling the entries can reach, including ones this corpus has
-- no site for.

-- THE CONSTRUCTOR EDGE. `new Box(1)` is the one edge the execution oracle saw
-- from the beginning and no callee shape could ever carry, because it is not a
-- CallExpression: the shape axis classifies what stands in the callee position,
-- and here there is no callee position at all. It took a value question to
-- answer — which class does this expression construct — and that is why the
-- queue had it after the dataflow items rather than beside its neighbours.
class_ctor[code](CD, M) :- class_method_of[flow](CD, M),
                           ast_attr[code](M, kind, "constructor").

resolves[code](X, M) :- transfer_site[code](X, new_expression),
                        may_be_node[flow](X, CD), class_ctor[code](CD, M).

-- `super()` — the CALL, not `super.m()`. The callee node is `super`, whose
-- value is the parent class, and what it reaches is that class's constructor:
-- its own if it has one, otherwise the nearest ancestor's, because a class with
-- no constructor synthesises one that forwards. `ctor_of[flow]` does that walk
-- and rules/js-dataflow.rofl records the measurement that says it is the right
-- one — V8 reports `C -> A` for a `super()` that passes through a
-- constructor-less B, skipping the synthesised frame entirely.
--
-- THE `new` RULE ABOVE DELIBERATELY DOES NOT USE THE WALK. The same measurement
-- shows `new Cask()` behaving the OTHER way: V8 creates a frame named after the
-- class and makes it the CALLER, so a model that resolved the site to the
-- ancestor's constructor would name the wrong caller and disagree with every
-- execution. That is a separate question with no node to point at.
resolves[code](C, M) :- callee_of[code](C, N), ast_node[code](N, super, _, _),
                        may_be_node[flow](N, SD), ctor_of[flow](SD, M).

-- THE GENERAL CALLEE RULE. Everything above resolves a callee by recognising
-- its SPELLING — an identifier, a member, an IIFE. This one asks the value
-- question instead: whatever the callee expression may BE, if it is a function,
-- the site calls it. That covers the five syntactic wrappers in one line —
-- `(f)()`, `f as T ()`, `f!()`, `(a, f)()`, `c ? f : g ()` — because the
-- dataflow layer already sees through a parenthesis, a cast, an assertion, a
-- sequence and a conditional, and it will cover the next wrapper somebody adds
-- to the grammar without a rule here at all.
resolves[code](C, F) :- callee_of[code](C, N), may_be_node[flow](N, F), fn_node[code](F).

-- A site resolving two ways is an over-approximation that must be VISIBLE,
-- not averaged away.
ambiguous_call[audit](C, F, G) :- resolves[code](C, F), resolves[code](C, G), F != G.

-- ===========================================================================
-- 5. THE EDGE

calls[code](Caller, Callee) :- resolves[code](C, Callee), nearest_fn[code](Caller, C).
calls[code](R, Callee)      :- resolves[code](C, Callee), top_call[code](C, R).

-- by name, because a stack frame carries a name and not a node id
calls_named[code](A, B)   :- calls[code](X, Y), fn_name[code](X, A), fn_name[code](Y, B).
calls_named[code](top, B) :- calls[code](R, Y), ast_file[code](R, _), fn_name[code](Y, B).

-- the same edge, carrying the file it was derived in. An oracle can only be
-- compared against the files it actually ran, and mixing in a scanned-but-
-- never-executed fixture would count its edges as over-approximation.
calls_in[code](File, A, B)   :- calls[code](X, Y), ast_node[code](X, _, File, _),
                                fn_name[code](X, A), fn_name[code](Y, B).
calls_in[code](File, top, B) :- calls[code](R, Y), ast_file[code](R, File),
                                fn_name[code](Y, B).

-- HIGHER-ORDER, recorded and NOT folded into `calls`: passing a function is
-- not calling it. The index is the content — argument 0 and argument 1 are
-- different facts about the program.
-- REGROUNDED 2026-09-04. This used to stand on `fn_binding`, the call graph's
-- own name-to-function table, which went when the resolution tiers did. The
-- relation itself is worth keeping — it is what makes ARGUMENT ORDER visible as
-- a fact rather than as a comment — and it now stands on the value layer, so it
-- covers a function reached any way the dataflow layer can reach one.
passes_function[code](C, I, F, Name) :- arg_at[flow](C, I, A), ast_name[code](A, Name),
                                        may_be_node[flow](A, F), fn_node[code](F).

-- ===========================================================================
-- 6. THE FRONTIER, AS A POSITIVE RELATION

resolved_site[code](C)      :- resolves[code](C, _).
-- ...and the same restricted to CALL sites. `resolves` covers transfer sites
-- since the constructor edge landed, so `resolved_site` no longer partitions
-- the call sites on its own — the totality identity needs the narrower half.
resolved_call[code](C)      :- resolved_site[code](C), call_site[code](C, _).
unresolved_call[code](C, S) :- shape[code](C, S), not resolved_site[code](C).
unresolved_shape[audit](S)  :- unresolved_call[code](_, S).

-- The verdict ledger for SHAPES. It is separate from js-model's
-- `unknown_because`, which is keyed by node KIND, because a kind's verdict
-- cannot express partial coverage: `member_expression` has a rule (tier 2)
-- and still misses seven of its eight shapes, and the kind-level matrix reads
-- that cell as `modelled`. The shape ledger is where the residue is counted.
--   shape_because(Lang, Shape, Layer, Reason)
edb(shape_because).

-- WHERE THE FRONTIER SITS. An unresolved site or an unmodelled transfer,
-- attributed to the caller unit that contains it. A missing edge whose caller
-- has no row here is a SILENT under-report: the model lost a call and has
-- nothing to point at as the reason.
frontier_at[code](F, S) :- nearest_fn[code](F, C), unresolved_call[code](C, S).
frontier_at[code](R, S) :- top_call[code](C, R), unresolved_call[code](C, S).
-- ...and a transfer site that RESOLVES is no longer frontier. Until the
-- constructor edge existed every transfer site was residue by construction, so
-- the negation had nothing to do and was left out; with a rule that can resolve
-- one, leaving it out would keep an excuse alive beside the answer.
frontier_at[code](F, K) :- nearest_fn[code](F, X), transfer_site[code](X, K),
                           not resolved_site[code](X).
frontier_at[code](R, K) :- top_site[code](X, R), transfer_site[code](X, K),
                           not resolved_site[code](X).

frontier_named[code](Name, Item) :- frontier_at[code](F, Item), fn_name[code](F, Name).
frontier_named[code](top, Item)  :- frontier_at[code](R, Item), ast_file[code](R, _).

-- the same frontier, located by FILE AND LINE rather than by caller. A stack
-- frame carries the line of the call site, so this is what turns "the caller
-- has some unresolved site somewhere" — which every function does, since every
-- one of them calls the imported `trace` — into "the exact site the runtime
-- transferred from is on the list".
frontier_line[code](File, Line, S) :- unresolved_call[code](C, S), ast_node[code](C, _, File, Line).
frontier_line[code](File, Line, K) :- transfer_site[code](X, K), not resolved_site[code](X),
                                      ast_node[code](X, _, File, Line).

-- the CLOSED vocabulary of shapes, read off the classification tables rather
-- than listed again: the denominator is the grammar, so a shape the corpus
-- never produces still exists and still wants an answer.
shape_vocab[audit](S) :- callee_shape(_, S).
shape_vocab[audit](S) :- member_shape(_, S).
shape_vocab[audit](s_computed_literal_key).
shape_vocab[audit](s_computed_dynamic_key).
shape_vocab[audit](s_computed_template_key).
shape_vocab[audit](s_optional_member).
shape_vocab[audit](s_unclassified).

shape_seen[audit](S)     :- shape[code](_, S).
resolved_shape[audit](S) :- resolves[code](C, _), shape[code](C, S).

-- three verdicts that partition the vocabulary, and the middle one is the
-- one a coverage list cannot say: a shape SOME of whose sites resolve.
shape_verdict[audit](S, absent)         :- shape_vocab[audit](S), not shape_seen[audit](S).
shape_verdict[audit](S, fully_resolved) :- shape_seen[audit](S), not unresolved_shape[audit](S).
shape_verdict[audit](S, has_residue)    :- unresolved_shape[audit](S).

shape_reason[audit](S, R)     :- unresolved_shape[audit](S), shape_because(js, S, callgraph, R).
shape_unexplained[audit](S)   :- unresolved_shape[audit](S), not shape_because(js, S, callgraph, _).
shape_bad_reason[audit](S, R) :- shape_because(js, S, callgraph, R), not unknown_type(R, _).
shape_orphan[audit](S)        :- shape_because(js, S, callgraph, _), not shape_vocab[audit](S).
-- an excuse that outlived its cause: the shape occurs and every one of its
-- sites now resolves, and the reason stayed behind.
shape_stale[audit](S)         :- shape_because(js, S, callgraph, _), shape_seen[audit](S),
                                 not unresolved_shape[audit](S).
-- a verdict the corpus does not exercise. Expected, not an error.
shape_unexercised[audit](S)   :- shape_because(js, S, callgraph, _), not shape_seen[audit](S).
shape_irreducible[audit](S)   :- shape_reason[audit](S, R), unknown_type(R, irreducible).

-- COVERAGE THAT EXISTS AND WAS NEVER RECORDED. Added 2026-09-04 after finding
-- `s_member_on_call` fully resolving while its cell read `not_modelled` — the
-- rules did the work and nobody ticked the box. `shape_stale` catches the
-- opposite direction (a reason with no residue left) and there was nothing
-- watching this one, so the matrix could under-report coverage indefinitely
-- while every gate stayed green.
--
-- ANY resolved site is enough, not `fully resolved`: a shape whose sites
-- partly resolve is a PARTIAL cell, and a partial cell is `handled` with a
-- residue reason beside it — the pattern `s_non_null` already follows.
unrecorded_coverage[audit](K, S) :- resolved_shape[audit](S), shape_of(js, K, S),
                                    verdict[audit](js, K, S, callgraph, not_modelled).
shape_ours[audit](S)          :- shape_reason[audit](S, R), unknown_type(R, ours).

-- WHAT MODELLING THIS CELL DRAGGED IN. The kinds the call-graph layer must
-- now have an opinion about are DERIVED from what the rules actually touch —
-- the kind of every call node, of every callee, and of every callee's object.
-- A kind here that no `node_kind` declares is a cell the matrix does not yet
-- know exists, which is the same silence the whole audit forbids.
fn_binder[code](D, F) :- ast_node[code](D, variable_declarator, _, _),
                         ast_child[code](D, init, 0, F), fn_node[code](F).
fn_binder[code](P, F) :- ast_node[code](P, object_property, _, _),
                         ast_child[code](P, value, 0, F), fn_node[code](F).
fn_binder[code](O, M) :- obj_member_fn[code](O, _, M).

callgraph_kind[audit](K)  :- call_site_kind[code](_, K).
callgraph_kind[audit](K)  :- callee_kind[code](_, K).
callgraph_kind[audit](K)  :- callee_obj_kind[code](_, K).
callgraph_kind[audit](K)  :- callee_prop[code](_, P), ast_node[code](P, K, _, _).
callgraph_kind[audit](K)  :- fn_node[code](F), ast_node[code](F, K, _, _).
callgraph_kind[audit](K)  :- fn_binder[code](B, _), ast_node[code](B, K, _, _).
kind_undeclared[audit](K) :- callgraph_kind[audit](K), not node_kind(js, K).

-- THE CALL GRAPH READS THE VALUE LAYER, which is the whole shape of this model
-- since resolution collapsed into one rule: `resolves` asks what the callee
-- expression may BE. Declared here rather than in rules/js-dataflow.rofl,
-- because the crossing belongs to the reader.
imports(code, flow).
-- ...and the audits over both. `imports(audit, code)` is in rules/js-model.rofl;
-- this is its twin for the ledger the value questions live in.
imports(audit, flow).

-- js-callgraph.rofl — ONE construct, the FUNCTION CALL, at the call-graph
-- layer. Over the scanner's four relations plus js-structure's `ast_within`,
-- `ast_name`, `ast_value` and `key_name`; resolution itself asks the value
-- layer (`may_be_node`, rules/js-dataflow.rofl) what the callee expression
-- denotes.
--
-- The finish line is not "the rule fires": every callee SHAPE either has a
-- rule or a typed verdict saying why not. Classification is TOTAL — every call
-- site gets exactly one shape — and `unresolved_call` is a POSITIVE relation,
-- countable, rather than the absence of a row. Loads with rules/js-model.rofl
-- for the `unknown_type` taxonomy.

-- =========================================================================
-- 1. CALL SITES
edb(call_kind).
call_kind(call_expression).
call_kind(optional_call_expression).

function call_site(C, to File).
function callee_of(C, to N).
call_site[code](C, File)      :- call_kind(K), ast_node[code](C, K, File).
call_site_kind[code](C, K)    :- call_kind(K), ast_node[code](C, K, _).
call_line[code](C, Line)      :- call_site[code](C, _), ast_line[code](C, Line).

callee_of[code](C, N)         :- call_site[code](C, _), ast_child[code](C, callee, 0, N).
callee_kind[code](C, K)       :- callee_of[code](C, N), ast_node[code](N, K, _).

-- Calls the grammar gives no CallExpression: `new C()`, `` tag`x` ``, the
-- iterator protocol of `for-of`, and a decorator. Naming them TRANSFER SITES
-- does not resolve them; it makes a miss attributable instead of silent.
edb(transfer_kind).
transfer_kind(new_expression).
transfer_kind(tagged_template_expression).
transfer_kind(for_of_statement).
transfer_kind(decorator).
transfer_site[code](X, K) :- transfer_kind(K), ast_node[code](X, K, _).

site[code](X) :- call_site[code](X, _).
site[code](X) :- transfer_site[code](X, _).

-- The index is content: without it `f(a, b)` and `f(b, a)` are one fact set.
call_arg[code](C, I, A)       :- call_site[code](C, _), ast_child[code](C, arguments, I, A).

-- =========================================================================
-- 2. CALLEE SHAPE — a TOTAL classification, which IS the frontier
--
-- Tables plus one catch-all rather than a chain of negations: a rule that says
-- "everything else" by negating its own head is unstratifiable.
-- `tsnon_null_expression`, not `ts_non_null_expression`: atomise() breaks only
-- between a lower-case and an upper-case letter, so `TSN` survives whole.
edb(callee_shape).
callee_shape(identifier,                s_identifier).
callee_shape(arrow_function_expression, s_iife).
callee_shape(function_expression,       s_iife).
callee_shape(super,                     s_super).
callee_shape(tsnon_null_expression,     s_non_null).
callee_shape(call_expression,           s_call_result).
callee_shape(optional_call_expression,  s_call_result).
callee_shape(new_expression,            s_new_result).
callee_shape(import,                    s_dynamic_import).
callee_shape(sequence_expression,       s_sequence).
callee_shape(parenthesized_expression,  s_parenthesized).
callee_shape(tsas_expression,           s_ts_as).
callee_shape(conditional_expression,    s_conditional).
callee_shape(yield_expression,          s_yield_result).

edb(member_kind).
member_kind(member_expression).
member_kind(optional_member_expression).

member_like[code](C, N)     :- callee_of[code](C, N), ast_node[code](N, K, _), member_kind(K).
optional_member[code](C)    :- callee_of[code](C, N), ast_node[code](N, optional_member_expression, _).
computed_member[code](C, N) :- member_like[code](C, N), ast_attr[code](N, computed, true).
static_member[code](C, N)   :- member_like[code](C, N), ast_attr[code](N, computed, false).

callee_obj[code](C, O)      :- member_like[code](C, N), ast_child[code](N, object, 0, O).
callee_obj_kind[code](C, K) :- callee_obj[code](C, O), ast_node[code](O, K, _).
callee_prop[code](C, P)     :- member_like[code](C, N), ast_child[code](N, property, 0, P).

-- A member callee needs two more bits: `computed`, and the object's kind.
-- Receivers are classed by VERDICT, not by type: a member on a string, number,
-- bigint or regexp is answered by the standard library, so all four are
-- `o_literal`. `import.meta` is `o_meta` and not `o_literal` because its
-- members are the HOST's — `interface ImportMeta` in lib.es5.d.ts is empty —
-- so the era axis cannot date them and `o_literal` would promise an answer
-- that cannot arrive.
edb(obj_kind_class).
obj_kind_class(identifier,                 o_ident).
obj_kind_class(member_expression,          o_member).
obj_kind_class(optional_member_expression, o_member).
obj_kind_class(call_expression,            o_call).
obj_kind_class(optional_call_expression,   o_call).
obj_kind_class(this_expression,            o_this).
obj_kind_class(super,                      o_super).
obj_kind_class(array_expression,           o_array).
obj_kind_class(new_expression,             o_new).
obj_kind_class(object_expression,          o_object_literal).
obj_kind_class(string_literal,             o_literal).
obj_kind_class(numeric_literal,            o_literal).
obj_kind_class(big_int_literal,            o_literal).
obj_kind_class(reg_exp_literal,            o_literal).

obj_kind_class(conditional_expression,     o_conditional).
obj_kind_class(sequence_expression,        o_sequence).
obj_kind_class(logical_expression,         o_logical).
obj_kind_class(assignment_expression,      o_assignment).
obj_kind_class(await_expression,           o_await).
obj_kind_class(template_literal,           o_template).
obj_kind_class(tsas_expression,            o_cast).
obj_kind_class(tsnon_null_expression,      o_non_null).
obj_kind_class(meta_property,              o_meta).

obj_kind_known(K)           :- obj_kind_class(K, _).
obj_class[code](C, Cl)      :- callee_obj_kind[code](C, K), obj_kind_class(K, Cl).
obj_class[code](C, o_other) :- callee_obj_kind[code](C, K), not obj_kind_known(K).

edb(member_shape).
member_shape(o_ident,          s_member_on_ident).
member_shape(o_member,         s_member_on_member).
member_shape(o_call,           s_member_on_call).
member_shape(o_this,           s_member_on_this).
member_shape(o_super,          s_member_on_super).
member_shape(o_array,          s_member_on_array).
member_shape(o_new,            s_member_on_new).
member_shape(o_object_literal, s_member_on_object_literal).
member_shape(o_literal,        s_member_on_literal).
member_shape(o_conditional,    s_member_on_conditional).
member_shape(o_sequence,       s_member_on_sequence).
member_shape(o_logical,        s_member_on_logical).
member_shape(o_assignment,     s_member_on_assignment).
member_shape(o_await,          s_member_on_await).
member_shape(o_template,       s_member_on_template).
member_shape(o_cast,           s_member_on_cast).
member_shape(o_non_null,       s_member_on_non_null).
member_shape(o_meta,           s_member_on_meta).
member_shape(o_other,          s_member_on_other).

-- `o[k]()` with a non-literal k is the one honest `runtime_dependent`.
-- `o[`fixed`]()` is a third case: fixed at parse time but not derivable,
-- because the scanner carries scalar own properties only and a template's
-- `value` is `{raw, cooked}`. So `not_yet` with a named cause, not either
-- neighbour.
edb(static_key_kind).
static_key_kind(string_literal).
static_key_kind(numeric_literal).

computed_key_static[code](C) :- computed_member[code](C, _), callee_prop[code](C, P),
                                ast_node[code](P, K, _), static_key_kind(K).

computed_key_template[code](C) :- computed_member[code](C, _), callee_prop[code](C, P),
                                  ast_node[code](P, template_literal, _).

shape_known[code](C, S) :- callee_kind[code](C, K), callee_shape(K, S).
shape_known[code](C, s_computed_literal_key) :- computed_member[code](C, _),
                                                computed_key_static[code](C).
shape_known[code](C, s_computed_template_key) :- computed_key_template[code](C).
shape_known[code](C, s_computed_dynamic_key) :- computed_member[code](C, _),
                                                not computed_key_static[code](C),
                                                not computed_key_template[code](C).
shape_known[code](C, s_optional_member)      :- static_member[code](C, _),
                                                optional_member[code](C).
shape_known[code](C, S) :- static_member[code](C, _), not optional_member[code](C),
                           obj_class[code](C, Cl), member_shape(Cl, S).

-- `shape` may negate `has_shape` because `has_shape` does not depend on `shape`.
-- A grammar form nobody anticipated lands in `s_unclassified` rather than
-- vanishing; the two audits below name what sits in each catch-all.
has_shape[code](C)             :- shape_known[code](C, _).
shape[code](C, S)              :- shape_known[code](C, S).
shape[code](C, s_unclassified) :- call_site[code](C, _), not has_shape[code](C).

catch_all_occupied[audit](K) :- shape[code](C, s_member_on_other),
                                callee_obj_kind[code](C, K).

unnamed_callee[audit](K) :- shape[code](C, s_unclassified), callee_kind[code](C, K).

shaped[code](C)         :- shape[code](C, _).
unshaped[audit](C)      :- call_site[code](C, _), not shaped[code](C).
multi_shape[audit](C, A, B) :- shape[code](C, A), shape[code](C, B), A != B.

-- =========================================================================
-- 3. THE ENCLOSING FUNCTION
edb(fn_kind).
fn_kind(function_declaration).
fn_kind(function_expression).
fn_kind(arrow_function_expression).
fn_kind(object_method).
fn_kind(class_method).
fn_kind(class_private_method).

fn_node[code](F)     :- fn_kind(K), ast_node[code](F, K, _).
fn_file[code](F, File) :- fn_node[code](F), ast_node[code](F, _, File).

-- A function's name is whatever binds it — several arms, and a node may hold
-- more than one name. `key_name` rather than `ast_name` on a key, so a computed
-- well-known symbol is a name too. A constructor answers to the CLASS's name:
-- V8 reports the frame as `new Box`, and without `not ctor_method` the edge
-- was derived twice, once as `-> constructor`, which no execution produces.
-- The declarator arm leads with the declarator: written `fn_node(F)` first it
-- laid every function beside every declarator (271 982 accumulator rows on
-- sixteen eslint files). A PRIVATE method gets no name: V8 says `#rim`, the
-- store holds `rim`, and the kernel has no operation that builds a string.
fn_name[code](F, N) :- ast_node[code](F, function_declaration, _),
                       ast_child[code](F, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- ast_node[code](F, function_expression, _),
                       ast_child[code](F, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- ast_node[code](F, object_method, _),
                       ast_child[code](F, key, 0, K), key_name[code](K, N).
ctor_method[code](F)   :- ast_node[code](F, class_method, _),
                          ast_attr[code](F, kind, "constructor").
fn_name[code](F, N) :- ast_node[code](F, class_method, _), not ctor_method[code](F),
                       ast_child[code](F, key, 0, K), key_name[code](K, N).
fn_name[code](F, N) :- ast_node[code](D, variable_declarator, _),
                       ast_child[code](D, init, 0, F), fn_node[code](F),
                       ast_child[code](D, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- key_name[code](K, N), ast_child[code](P, key, 0, K),
                       ast_node[code](P, object_property, _),
                       ast_child[code](P, value, 0, F), fn_node[code](F).
fn_name[code](F, N) :- ast_node[code](F, class_method, _),
                       ast_attr[code](F, kind, "constructor"),
                       ast_child[code](B, body, _, F), ast_child[code](CD, body, 0, B),
                       ast_child[code](CD, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- class_field_kind(K), ast_node[code](P, K, _),
                       ast_child[code](P, value, 0, F), fn_node[code](F),
                       ast_child[code](P, key, 0, KN), key_name[code](KN, N).

-- A class expression with no `id` takes its binding's name — the language's own
-- inference: `const A = class {}` has `A.name === "A"`, but
-- `const W = class Hoist {}` has `"Hoist"`. The arm carries the negation so
-- the two constructor arms never both fire.
class_has_id[code](CD) :- ast_node[code](CD, class_expression, _),
                          ast_child[code](CD, id, 0, _).
anon_class[code](CD)   :- ast_node[code](CD, class_expression, _),
                          not class_has_id[code](CD).
fn_name[code](F, N) :- ast_node[code](F, class_method, _),
                       ast_attr[code](F, kind, "constructor"),
                       ast_child[code](B, body, _, F), ast_child[code](CD, body, 0, B),
                       anon_class[code](CD),
                       ast_child[code](D, init, 0, CD),
                       ast_node[code](D, variable_declarator, _),
                       ast_child[code](D, id, 0, I), ast_name[code](I, N).

-- A decorator is INSIDE the thing it decorates and does not run there:
-- `@decoFactory('m') marked() {}` puts the call in `marked`'s subtree and
-- evaluates it at class definition. Two arms because the decorator node is
-- itself a site and `ast_within` is irreflexive. `nearest_fn` is `nearest_v`,
-- which is already the nearest function of every node, with the functions that
-- hold the site in their own decorator stepped over (`dec_up`): the pairwise
-- `F != G` nearest-of-all it replaces joined every encloser with every other.
-- `top_call` reads `site` and not `call_site`: a transfer site at module top
-- level reaches `calls` only through here. (`top_site` was its twin, written
-- for transfer sites while `top_call` still read `call_site`; the 2026-09-08
-- repair made them one rule and 2026-09-11 made them one name.)
decorates[code](Owner, D)     :- ast_child[code](Owner, decorators, _, D),
                                 ast_node[code](D, decorator, _).
in_own_decorator[code](F, C)  :- decorates[code](F, D), ast_within[code](D, C).
in_own_decorator[code](F, D)  :- decorates[code](F, D).
dec_up[code](C, G)     :- in_own_decorator[code](G, C), site[code](C), nearest_v[flow](G, C).
dec_up[code](C, H)     :- dec_up[code](C, G), nearest_v[flow](H, G), in_own_decorator[code](H, C).
nearest_fn[code](F, C) :- site[code](C), nearest_v[flow](F, C), not in_own_decorator[code](F, C).
nearest_fn[code](F, C) :- dec_up[code](C, G), nearest_v[flow](F, G), not in_own_decorator[code](F, C).

enclosed[code](C)      :- nearest_fn[code](_, C).
top_call[code](C, R)   :- site[code](C), ast_node[code](C, _, File),
                          ast_file[code](R, File), not enclosed[code](C).

-- =========================================================================
-- 4. RESOLUTION — scope-blind on purpose: a name bound anywhere in the file
-- answers a call anywhere in the file. Shadowing is the scope layer's job.
--
-- Every member shape is the same question — resolve the OBJECT half, look the
-- KEY up in it — so there is one resolution rule (the last in this section)
-- over `may_be_node`, and the shapes are entry points into the value layer.
-- Both `obj_member_fn` arms lead with `key_name` for correctness AND cost:
-- `ns[haspSpelling]()` must not resolve under the variable's spelling, and
-- `key_name`'s 105 rows bind K so every later literal is an indexed lookup.
obj_member_fn[code](O, Key, M) :- key_name[code](K, Key),
                                  ast_child[code](M, key, 0, K),
                                  ast_node[code](M, object_method, _),
                                  ast_child[code](O, properties, _, M),
                                  ast_node[code](O, object_expression, _).
obj_member_fn[code](O, Key, F) :- key_name[code](K, Key),
                                  ast_child[code](P, key, 0, K),
                                  ast_node[code](P, object_property, _),
                                  ast_child[code](P, value, 0, F), fn_node[code](F),
                                  ast_child[code](O, properties, _, P),
                                  ast_node[code](O, object_expression, _).

-- The constructor edge is not a CallExpression at all; it needed the value
-- question "which class does this expression construct". `super()` walks
-- `ctor_of` (a class with no constructor forwards to its ancestor's — V8 skips
-- the synthesised frame); `new` deliberately does NOT, because V8 names the
-- frame after the class and makes it the caller.
class_ctor[code](CD, M) :- class_method_of[flow](CD, M),
                           ast_attr[code](M, kind, "constructor").

resolves[code](X, M) :- transfer_site[code](X, new_expression),
                        may_be_node[flow](X, I), inst_of[flow](I, CD), class_ctor[code](CD, M).

resolves[code](C, M) :- ast_node[code](N, super, _), callee_of[code](C, N),
                        may_be_node[flow](N, SD), ctor_of[flow](SD, M).

-- A tag is a callee in every sense but the grammar's (the field is `tag`, not
-- `callee`); a decorator's `expression` is either the function or a factory
-- call, and `may_be_node` carries what a call returns, so one arm covers both.
resolves[code](X, F) :- transfer_site[code](X, tagged_template_expression),
                        ast_child[code](X, tag, 0, T),
                        may_be_node[flow](T, F), fn_value[flow](F).

resolves[code](X, F) :- transfer_site[code](X, decorator),
                        ast_child[code](X, expression, 0, E),
                        may_be_node[flow](E, F), fn_value[flow](F).

-- `for (x of E)` calls `E[Symbol.iterator]()` and then `next()`. Only the first
-- hop is a `resolves`: `ambiguous_call[audit]` reads two answers at one site
-- as an over-approximation, and a for-of really makes two calls, so the second
-- goes straight to `calls`. `member_value` names the node a member HOLDS — for
-- `{ next: bump }` the identifier — hence the second `may_be_node` hop.
for_of_iterates[code](X, M) :- transfer_site[code](X, for_of_statement),
                               ast_child[code](X, right, 0, R),
                               may_be_node[flow](R, Obj),
                               member_value[flow](Obj, symbol_iterator, M), fn_value[flow](M).
resolves[code](X, M) :- for_of_iterates[code](X, M).

calls[code](Caller, Next) :- for_of_iterates[code](X, M), nearest_fn[code](Caller, X),
                             ret_node_any[flow](M, IterObj),
                             member_value[flow](IterObj, "next", V),
                             may_be_node[flow](V, Next), fn_value[flow](Next).

-- THE GENERAL RULE: whatever the callee expression may BE, if it is a function
-- the site calls it. Covers `(f)()`, `f as T ()`, `f!()`, `(a, f)()`,
-- `c ? f : g ()` and the next wrapper somebody adds, with no rule here.
resolves[code](C, F) :- may_be_node[flow](N, F), fn_value[flow](F), callee_of[code](C, N).

ambiguous_call[audit](C, F, G) :- resolves[code](C, F), resolves[code](C, G), F != G.

-- =========================================================================
-- 5. THE EDGE — by node, by name (a stack frame carries a name), and by file
-- (an oracle can only be compared against the files it ran).
-- `passes_function` is recorded and NOT folded into `calls`: passing a
-- function is not calling it.
calls[code](Caller, Callee) :- resolves[code](C, Callee), nearest_fn[code](Caller, C).
calls[code](R, Callee)      :- resolves[code](C, Callee), top_call[code](C, R).

calls_named[code](A, B)   :- calls[code](X, Y), fn_name[code](X, A), fn_label[flow](Y, B).
calls_named[code](top, B) :- calls[code](R, Y), ast_file[code](R, _), fn_label[flow](Y, B).

calls_in[code](File, A, B)   :- calls[code](X, Y), ast_node[code](X, _, File),
                                fn_name[code](X, A), fn_label[flow](Y, B).
calls_in[code](File, top, B) :- calls[code](R, Y), ast_file[code](R, File),
                                fn_label[flow](Y, B).

passes_function[code](C, I, F, Name) :- arg_at[flow](C, I, A), may_be_node[flow](A, F), fn_value[flow](F),
                                        ast_name[code](A, Name).
-- an element of another file's array spread into the call is named by its own file
passes_function[code](C, I, F, Name) :- arg_at[flow](C, I, A), may_be_node[flow](A, F), fn_value[flow](F),
                                        sx_name[surface](A, Name).

-- A function handed over and CALLED, by facts/js-host.rofl's `host_calls_back`.
-- Not a `resolves` edge: rules/js-dataflow.rofl binds a resolved call's
-- arguments to the callee's parameters and its return to the call's value, and
-- a callback gets neither (`map` passes elements and returns an array).
callback_site[code](C, P, Key)        :- builtin_prototype(P), prototype_of[flow](O, P), ast_child[code](N, object, 0, O),
                                         callee_of[code](C, N), selects[flow](N, Key).
callback_site[code](C, Origin, Key)   :- host_site[code](C, _, Origin, Key).
calls_back[code](C, F, When) :- callback_site[code](C, O, Key), host_calls_back(O, Key, I, When),
                                arg_at[flow](C, I, A), may_be_node[flow](A, F), fn_value[flow](F).
calls_back[code](C, F, When) :- callback_site[code](C, O, Key), host_calls_back(O, Key, last, When),
                                arg_at[flow](C, I, A), J is I + 1, not arg_at[flow](C, J, _),
                                may_be_node[flow](A, F), fn_value[flow](F).

-- a row for a prototype member the library does not have is a misspelling
callback_key_unknown[audit](P, Key) :- host_calls_back(P, Key, _, _), builtin_prototype(P),
                                       not lib_member(P, Key, _).

-- =========================================================================
-- 6. THE FRONTIER, AS A POSITIVE RELATION
--
-- `stdlib_member` resolves nothing: it moves "the receiver is a builtin
-- prototype, so the method is not a node in this program" from prose into a
-- row `w_env_api_surface` reads. `shape_because(Lang, Shape, Layer, Reason)`
-- is the verdict ledger for SHAPES, separate from js-model's kind-level
-- `unknown_because`, because a kind cannot express partial coverage.
resolved_site[code](C)      :- resolves[code](C, _).
resolved_call[code](C)      :- resolved_site[code](C), call_site[code](C, _).
unresolved_call[code](C, S) :- shape[code](C, S), not resolved_site[code](C).
unresolved_shape[audit](S)  :- unresolved_call[code](_, S).

stdlib_member[audit](C, P, Key) :- unresolved_call[code](C, _), callee_of[code](C, N),
                                   ast_child[code](N, object, 0, O),
                                   prototype_of[flow](O, P), builtin_prototype(P),
                                   selects[flow](N, Key).

edb(shape_because).

-- An unresolved site attributed to the unit that contains it; a missing edge
-- whose caller has no row here is a SILENT under-report. A transfer site that
-- resolves is no longer frontier. `frontier_line` is what a stack frame can be
-- matched against.
frontier_at[code](F, S) :- nearest_fn[code](F, C), unresolved_call[code](C, S).
frontier_at[code](R, S) :- top_call[code](C, R), unresolved_call[code](C, S).
frontier_at[code](F, K) :- nearest_fn[code](F, X), transfer_site[code](X, K),
                           not resolved_site[code](X).
frontier_at[code](R, K) :- top_call[code](X, R), transfer_site[code](X, K),
                           not resolved_site[code](X).

frontier_named[code](Name, Item) :- frontier_at[code](F, Item), fn_name[code](F, Name).
frontier_named[code](top, Item)  :- frontier_at[code](R, Item), ast_file[code](R, _).

frontier_line[code](File, Line, S) :- unresolved_call[code](C, S), ast_node[code](C, _, File), ast_line[code](C, Line).
frontier_line[code](File, Line, K) :- transfer_site[code](X, K), not resolved_site[code](X),
                                      ast_node[code](X, _, File), ast_line[code](X, Line).

-- The closed vocabulary of shapes, read off the tables: the denominator is the
-- grammar, so a shape the corpus never produces still wants an answer.
-- `shape_stale` is an excuse that outlived its cause; `unrecorded_coverage` is
-- the opposite direction — rules doing the work while the cell says
-- `not_modelled`, which every other gate stays green through.
shape_vocab[audit](S) :- callee_shape(_, S).
shape_vocab[audit](S) :- member_shape(_, S).
shape_vocab[audit](s_computed_literal_key).
shape_vocab[audit](s_computed_dynamic_key).
shape_vocab[audit](s_computed_template_key).
shape_vocab[audit](s_optional_member).
shape_vocab[audit](s_unclassified).

shape_seen[audit](S)     :- shape[code](_, S).
resolved_shape[audit](S) :- resolves[code](C, _), shape[code](C, S).

shape_verdict[audit](S, absent)         :- shape_vocab[audit](S), not shape_seen[audit](S).
shape_verdict[audit](S, fully_resolved) :- shape_seen[audit](S), not unresolved_shape[audit](S).
shape_verdict[audit](S, has_residue)    :- unresolved_shape[audit](S).

shape_reason[audit](S, R)     :- unresolved_shape[audit](S), shape_because(js, S, callgraph, R).
shape_unexplained[audit](S)   :- unresolved_shape[audit](S), not shape_because(js, S, callgraph, _).
shape_bad_reason[audit](S, R) :- shape_because(js, S, callgraph, R), not unknown_type(R, _).
shape_orphan[audit](S)        :- shape_because(js, S, callgraph, _), not shape_vocab[audit](S).
shape_stale[audit](S)         :- shape_because(js, S, callgraph, _), shape_seen[audit](S),
                                 not unresolved_shape[audit](S).
shape_unexercised[audit](S)   :- shape_because(js, S, callgraph, _), not shape_seen[audit](S).
shape_irreducible[audit](S)   :- shape_reason[audit](S, R), unknown_type(R, irreducible).

unrecorded_coverage[audit](K, S) :- resolved_shape[audit](S), shape_of(js, K, S),
                                    verdict[audit](js, K, S, callgraph, not_modelled).
shape_ours[audit](S)          :- shape_reason[audit](S, R), unknown_type(R, ours).

-- What modelling this layer dragged in: every kind its rules touch must be a
-- declared `node_kind`, or the matrix has a cell it does not know exists.
fn_binder[code](D, F) :- ast_node[code](D, variable_declarator, _),
                         ast_child[code](D, init, 0, F), fn_node[code](F).
fn_binder[code](P, F) :- ast_node[code](P, object_property, _),
                         ast_child[code](P, value, 0, F), fn_node[code](F).
fn_binder[code](O, M) :- obj_member_fn[code](O, _, M).

callgraph_kind[audit](K)  :- call_site_kind[code](_, K).
callgraph_kind[audit](K)  :- callee_kind[code](_, K).
callgraph_kind[audit](K)  :- callee_obj_kind[code](_, K).
callgraph_kind[audit](K)  :- callee_prop[code](_, P), ast_node[code](P, K, _).
callgraph_kind[audit](K)  :- fn_node[code](F), ast_node[code](F, K, _).
callgraph_kind[audit](K)  :- fn_binder[code](B, _), ast_node[code](B, K, _).
kind_undeclared[audit](K) :- callgraph_kind[audit](K), not node_kind(js, K).

-- =========================================================================
-- 7. A CALL THE LANGUAGE PERFORMS, WITH NO CALLER
--
-- `calls` says a caller is a lexical region: the nearest function or the
-- module root. `await` breaks that. Measured on V8 11.3 and 13.6 with
-- `Promise.prototype.then` monkey-patched: `await <native promise>` and
-- `await 5` call it ZERO times (the spec's Await uses PerformPromiseThen, an
-- internal operation); only a user thenable's own `then` is called, and it is
-- called on a stack of depth ONE — no caller frame at all. The execution
-- oracle drops caller-less edges before comparing, so it can neither confirm
-- nor refute this section.
--
-- So `performed_call` is one column short of `calls` on purpose and never
-- reaches `calls_named`/`calls_in`. The two `may_be_node` hops are the same
-- last step the iterator protocol takes: `member_value` names the identifier.
await_arg[code](A, X) :- ast_node[code](A, await_expression, _),
                         ast_child[code](A, argument, 0, X).

awaited_then[code](A, F) :- await_arg[code](A, X), may_be_node[flow](X, O),
                            member_value[flow](O, "then", V),
                            may_be_node[flow](V, F), fn_value[flow](F).

performed_call[code](A, F) :- awaited_then[code](A, F).
callerless_call[audit](Name) :- performed_call[code](_, F), fn_label[flow](F, Name).

-- Three-way split of every await: value known and no `then` (the language
-- performs NO call — a positive statement, and the one arm here that can be
-- WRONG rather than silent, since `may_be_node` is a may-set); value unknown
-- (the frontier, deliberately not wired into `frontier_at`, which is keyed by
-- a caller this call has not got).
await_value_known[code](A)    :- await_arg[code](A, X), may_be_node[flow](X, _).
await_no_call[code](A)        :- await_value_known[code](A), not awaited_then[code](A, _).
await_value_unknown[audit](A) :- await_arg[code](A, _), not await_value_known[code](A).

-- The gate: a performed call must never become an ordinary edge. It cannot use
-- `nearest_fn`, because it demands `site(C)` and an await is not a site
-- — written that way it was permanently silent.
awaiting_fn[code](Fn, A) :- performed_call[code](A, _), ast_within[code](Fn, A),
                            fn_node[code](Fn).
performed_as_edge[audit](Fn, F) :- performed_call[code](A, F),
                                   awaiting_fn[code](Fn, A),
                                   calls[code](Fn, F).

-- =========================================================================
-- 8. A CALL OF A MEMBER THE RECEIVER HAS NOT GOT — `plain.sett(k)` on
-- `const plain = { set() {} }` throws a TypeError. Said only where the
-- receiver is seen WHOLE: the expression is closed (`whole_expr`: every value
-- it may be is a node named here) and every such value is an object whose
-- members are all written in the corpus or carried by the library surface,
-- and nothing writes it out of sight (`sx_open`). Two answers, never one:
-- `missing_member_call[audit]` where no value has the key and nothing is open,
-- `member_unknown[audit]` where no value seen has it and something is open. A
-- call some value answers is neither. The corpus is the program: an importer
-- outside it is not counted.
edb(whole_kind).
whole_kind(object_expression).
whole_kind(array_expression).
whole_kind(function_expression).
whole_kind(arrow_function_expression).
whole_kind(class_expression).

whole_expr[flow](E) :- whole_kind(K), ast_node[code](E, K, _).
whole_expr[flow](E) :- es_instance[flow](E, _, _).
whole_expr[flow](E) :- ast_node[code](E, new_expression, _), ast_child[code](E, callee, 0, CE), whole_expr[flow](CE).
whole_expr[flow](E) :- value_transparent(K), ast_node[code](E, K, _), ast_child[code](E, expression, 0, X),
                       whole_expr[flow](X).
whole_expr[flow](E) :- sees_binder[code](E, D), binder[code](D, _, Init, _), whole_expr[flow](Init),
                       not many_binders[flow](E), not reassigned[flow](D), not assign_reaches_unscoped[flow](E, _).
whole_expr[flow](E) :- sees_decl[code](E, F), whole_decl[flow](F),
                       not many_binders[flow](E), not assign_reaches_unscoped[flow](E, _).
whole_decl[flow](F)   :- ast_node[code](F, function_declaration, _).
whole_decl[flow](F)   :- ast_node[code](F, class_declaration, _).
many_binders[flow](E)   :- sees_binder[code](E, A), sees_binder[code](E, B), A != B.
many_binders[flow](E)   :- sees_decl[code](E, A), sees_decl[code](E, B), A != B.
many_binders[flow](E)   :- sees_binder[code](E, _), sees_decl[code](E, _).
reassigned[flow](D)     :- assign_binder[code](_, D).

-- The objects whose members can be known, and the classes whose prototype they read.
receivable[flow](O) :- ast_node[code](O, object_expression, _).
receivable[flow](O) :- ast_node[code](O, array_expression, _).
receivable[flow](I) :- inst_of[flow](I, _).
receivable[flow](X) :- es_instance[flow](X, Name, _), lib_global_prototype(Name, _).
surveyed[flow](O)   :- receivable[flow](O).
surveyed[flow](CD)  :- class_like[flow](CD).
-- the three, mirrored for a node that left its file
sx_receivable[surface](O) :- sx_esc[surface](O), receivable[flow](O).
receivable[flow](O)       :- sx_receivable[surface](O).
sx_surveyed[surface](O)   :- sx_esc[surface](O), surveyed[flow](O).
surveyed[flow](O)         :- sx_surveyed[surface](O).

-- A place that hands its value nowhere the model cannot follow: a member read
-- off it, a binding, a name it is assigned to, a test, a closed function's
-- argument. Any other place (returned, in an array, an argument of a call the
-- model does not resolve to a closed function) lets it out of sight.
edb(holds_in_place).
holds_in_place(member_expression, object).
holds_in_place(member_expression, property).
holds_in_place(optional_member_expression, object).
holds_in_place(optional_member_expression, property).
holds_in_place(variable_declarator, id).
holds_in_place(variable_declarator, init).
holds_in_place(class_declaration, id).
holds_in_place(class_expression, id).
holds_in_place(function_declaration, id).
holds_in_place(function_expression, id).
holds_in_place(function_declaration, params).
holds_in_place(function_expression, params).
holds_in_place(arrow_function_expression, params).
holds_in_place(class_method, params).
holds_in_place(object_method, params).
holds_in_place(assignment_expression, left).
holds_in_place(call_expression, callee).
holds_in_place(new_expression, callee).
holds_in_place(expression_statement, expression).
holds_in_place(program, body).
holds_in_place(block_statement, body).
holds_in_place(class_body, body).
holds_in_place(class_declaration, super_class).
holds_in_place(class_expression, super_class).
holds_in_place(binary_expression, left).
holds_in_place(binary_expression, right).
holds_in_place(unary_expression, argument).
holds_in_place(if_statement, test).
holds_in_place(conditional_expression, test).
holds_in_place(while_statement, test).
holds_in_place(template_literal, expressions).
holds_in_place(export_named_declaration, declaration).
holds_in_place(export_specifier, local).
holds_in_place(object_property, value).

-- asked only of a place that may hold a surveyed object of its own file
placed[flow](A) :- may_be_node[flow](A, O), surveyed[flow](O), ast_child[code](_, _, _, A).
held[flow](A) :- placed[flow](A), ast_child[code](P, F, _, A), ast_node[code](P, PK, _), holds_in_place(PK, F).
held[flow](A) :- placed[flow](A), assigned[code](_, _, _, A, _).
held[flow](A) :- placed[flow](A), ast_child[code](C, arguments, _, A), ast_child[code](C, callee, 0, CE),
                 whole_expr[flow](CE).
held[flow](V) :- placed[flow](V), stored_in[flow](V, _).
-- a member of an object literal holds the value as long as the literal is not open
literal_part[flow](O, P) :- ast_node[code](O, object_expression, _), ast_child[code](O, properties, _, P).
held[flow](P) :- placed[flow](P), literal_part[flow](_, P).
stored_in[flow](V, H) :- ast_child[code](A, right, 0, V), ast_node[code](A, assignment_expression, _),
                         ast_child[code](A, left, 0, L), member_node_v[flow](L), ast_child[code](L, object, 0, HE),
                         whole_expr[flow](HE), may_be_node[flow](HE, H).

-- A member written: by a known key it is had, by an unknown one the object is open.
edb(writes_in_place).
writes_in_place(assignment_expression, left).
writes_in_place(update_expression, argument).
writes_in_place(array_pattern, elements).
writes_in_place(assignment_pattern, left).
writes_in_place(rest_element, argument).
writes_in_place(for_in_statement, left).
writes_in_place(for_of_statement, left).
member_written[flow](N) :- member_node_v[flow](N), ast_child[code](P, F, _, N), ast_node[code](P, PK, _),
                           writes_in_place(PK, F).
member_written[flow](N) :- member_node_v[flow](N), ast_child[code](Prop, value, 0, N),
                           ast_child[code](Pat, properties, _, Prop), ast_node[code](Pat, object_pattern, _).
sx_mkey[surface](O, Key) :- member_written[flow](N), member_at[flow](N, _, O, Key).

sx_open[surface](O)  :- placed[flow](A), may_be_node[flow](A, O), surveyed[flow](O), not held[flow](A).
sx_open[surface](O)  :- member_written[flow](N), member_obj[flow](N, _, O), not selects[flow](N, _).
sx_open[surface](O)  :- may_be_node[flow](P, O), literal_part[flow](L, P), sx_open[surface](L).
sx_open[surface](O)  :- stored_in[flow](V, H), sx_open[surface](H), may_be_node[flow](V, O).
-- an object literal with a spread, a computed key or a `__proto__`
sx_open[surface](O)  :- literal_part[flow](O, P), ast_node[code](P, spread_element, _).
sx_open[surface](O)  :- literal_part[flow](O, P), ast_child[code](P, key, 0, K), not key_name[code](K, _).
sx_open[surface](O)  :- literal_part[flow](O, P), ast_child[code](P, key, 0, K), key_name[code](K, "__proto__").
-- a member function whose `this` the model does not follow may write onto it
this_unfollowed[flow](F) :- this_host[flow](F, _), not ast_node[code](F, class_method, _).
sx_this_unfollowed[surface](F) :- sx_esc[surface](F), this_unfollowed[flow](F).
this_unfollowed[flow](F)       :- sx_this_unfollowed[surface](F).
sx_open[surface](O)  :- receivable[flow](O), member_value[flow](O, _, V), may_be_node[flow](V, F),
                        this_unfollowed[flow](F).
-- a class whose prototype may change: read as `C.prototype`, decorated, a base not
-- seen or open, a constructor returning a value
sx_open[surface](CD) :- member_at[flow](_, _, CD, "prototype").
sx_open[surface](CD) :- class_like[flow](CD), ast_child[code](CD, decorators, _, _).
sx_open[surface](CD) :- class_like[flow](CD), ast_child[code](CD, body, 0, B), ast_child[code](B, body, _, M),
                        ast_child[code](M, decorators, _, _).
sx_open[surface](CD) :- class_like[flow](CD), type_open[flow](CD).
sx_open[surface](CD) :- super_of[flow](CD, SD), sx_open[surface](SD).
sx_open[surface](CD) :- class_method_of[flow](CD, M), ast_attr[code](M, kind, "constructor"), returns[flow](M, _).
sx_open[surface](I)  :- inst_of[flow](I, CD), sx_open[surface](CD).

-- a value has the key: written in the corpus, or on Object.prototype, or on its library prototype
member_call[flow](C, R, Key) :- ast_node[code](C, call_expression, _), ast_child[code](C, callee, 0, N),
                                ast_node[code](N, member_expression, _), ast_attr[code](N, computed, false),
                                selects[flow](N, Key), ast_child[code](N, object, 0, R).
call_on[flow](C, O, Key) :- member_call[flow](C, R, Key), may_be_node[flow](R, O).
call_finds[flow](C) :- call_on[flow](C, O, Key), member_value[flow](O, Key, _).
call_finds[flow](C) :- call_on[flow](C, O, Key), sx_mkey[surface](O, Key).
call_finds[flow](C) :- call_on[flow](C, O, Key), receivable[flow](O), lib_member(object, Key, _).
call_finds[flow](C) :- call_on[flow](C, O, Key), kind_proto[flow](O, P), lib_member(P, Key, _).
call_finds[flow](C) :- call_on[flow](C, O, Key), es_instance[flow](O, Name, _), lib_global_prototype(Name, P),
                       lib_member(P, Key, _).
call_open[flow](C)    :- member_call[flow](C, R, _), not whole_expr[flow](R), not whole_global[flow](R).
call_open[flow](C)    :- member_call[flow](C, R, _), whole_expr[flow](R), not may_be_node[flow](R, _).
call_open[flow](C)    :- member_call[flow](C, R, _), may_be_lit[flow](R, _).
call_open[flow](C)    :- call_on[flow](C, O, _), not receivable[flow](O).
call_open[flow](C)    :- call_on[flow](C, O, _), sx_open[surface](O).

-- An ES global (`Math`, `JSON`, `Object`) has no node: its members are its statics, what
-- every function or object inherits, and what the corpus writes onto it by name. It is
-- open where it is rebound, written under a key the model cannot read, or handed on, and
-- where the host adds statics TypeScript does not declare (`host_extends_global`).
edb(host_extends_global).
host_extends_global("Error").

whole_global[flow](R) :- es_global[code](R, Name, _, Form), Form != plain_value,
                         not host_extends_global(Name), not assign_reaches_unscoped[flow](R, _),
                         not sx_global_open[surface](Name).
sx_global_key[surface](Name, Key) :- member_written[flow](N), ast_child[code](N, object, 0, G),
                                     es_global[code](G, Name, _, _), selects[flow](N, Key).
sx_global_open[surface](Name) :- member_written[flow](N), ast_child[code](N, object, 0, G),
                                 es_global[code](G, Name, _, _), not selects[flow](N, _).
sx_global_open[surface](Name) :- es_global[code](G, Name, _, _), ast_child[code](P, F, _, G),
                                 ast_node[code](P, PK, _), not holds_in_place(PK, F).
call_finds[flow](C) :- ast_child[code](C, callee, 0, N), es_static[code](N, _, _, _).
call_finds[flow](C) :- member_call[flow](C, R, Key), es_global[code](R, Name, _, _), sx_global_key[surface](Name, Key).
call_finds[flow](C) :- member_call[flow](C, R, Key), es_global[code](R, _, _, constructor_binding),
                       lib_member(function, Key, _).
call_finds[flow](C) :- member_call[flow](C, R, Key), es_global[code](R, _, _, _), lib_member(object, Key, _).

missing_member_call[audit](C, R, Key) :- member_call[flow](C, R, Key), not call_finds[flow](C), not call_open[flow](C).
member_unknown[audit](C) :- member_call[flow](C, _, _), not call_finds[flow](C), call_open[flow](C).

-- =========================================================================
-- 9. WHAT A RECEIVER IS DECLARED TO BE — a sort of its own, never mixed with
-- what may reach it (the owner, 2026-10-24). `declared[flow](E, T)`: the
-- program says E is of the named type T, an interface or a class of the
-- corpus or a library prototype (`p: IFoo`, `this.foo` of `private foo: IFoo`,
-- `const x: IFoo`). A type annotation is a claim the code makes, not a value
-- the model saw: `any` and a cast can make it false. Its answers are
-- `member_declared[audit](C, T)` (the type has the member) and
-- `missing_declared_member[audit](C, T, Key)` (every type the receiver is
-- declared as is known whole and none has it); `member_undeclared[audit](C)`
-- is a call neither the values nor the declarations answer.
type_decl[code](T, Name, File) :- ast_node[code](T, tsinterface_declaration, File), ast_child[code](T, id, 0, I),
                                  ast_name[code](I, Name).
type_decl[code](T, Name, File) :- ast_node[code](T, class_declaration, File), ast_child[code](T, id, 0, I),
                                  ast_name[code](I, Name).
-- a name in type position: a type reference, and an interface's `extends`
type_name_at[code](A, Name, File) :- ast_node[code](A, tstype_annotation, File), ast_child[code](A, type_annotation, 0, X),
                                     ast_node[code](X, tstype_reference, _), ast_child[code](X, type_name, 0, N),
                                     ast_node[code](N, identifier, _), ast_name[code](N, Name).
type_name_at[code](H, Name, File) :- ast_node[code](H, tsinterface_heritage, File), ast_child[code](H, expression, 0, N),
                                     ast_node[code](N, identifier, _), ast_name[code](N, Name).
sx_export_type[surface](File, Name, T) :- ast_node[code](E, export_named_declaration, File),
                                          ast_child[code](E, declaration, 0, T), type_decl[code](T, Name, File).
sx_export_type[surface](File, Ext, T)  :- export_local[code](L, Ext, File), ast_name[code](L, Local),
                                          type_decl[code](T, Local, File).
names_type[flow](A, T) :- type_name_at[code](A, Name, File), type_decl[code](T, Name, File).
names_type[flow](A, T) :- type_name_at[code](A, Name, File), imports_name[code](Name, Orig, D, File),
                          module_target[code](D, Target), sx_export_type[surface](Target, Orig, T).
-- a library type by its prototype (`m: Map<K, V>`), where the corpus declares no such name
names_lib[flow](A, P)  :- type_name_at[code](A, Name, File), lib_global_prototype(Name, P),
                          not type_decl[code](_, Name, File), not imports_name[code](Name, _, _, File).
type_named[flow](A)    :- names_type[flow](A, _).
type_named[flow](A)    :- names_lib[flow](A, _).

-- what a type has, and where it cannot be known whole
type_member[flow](T, Key) :- ast_node[code](T, tsinterface_declaration, _), ast_child[code](T, body, 0, B),
                             ast_child[code](B, body, _, S), ast_child[code](S, key, 0, K), ast_name[code](K, Key).
type_member[flow](T, Key) :- class_like[flow](T), ast_child[code](T, body, 0, B),
                             ast_child[code](B, body, _, S), ast_attr[code](S, static, false),
                             ast_child[code](S, key, 0, K), ast_name[code](K, Key).
type_member[flow](T, Key) :- class_method_of[flow](T, M), ast_attr[code](M, kind, "constructor"),
                             ast_child[code](M, params, _, P), param_property[code](P, Key, _).
-- `private foo: IFoo` and `private foo: IFoo = d`: the name and its annotation
param_property[code](P, Key, X) :- ast_node[code](P, tsparameter_property, _), ast_child[code](P, parameter, 0, X),
                                   ast_name[code](X, Key).
param_property[code](P, Key, X) :- ast_node[code](P, tsparameter_property, _), ast_child[code](P, parameter, 0, D),
                                   ast_child[code](D, left, 0, X), ast_name[code](X, Key).
type_base[flow](T, B)     :- ast_child[code](T, extends, _, H), names_type[flow](H, B).
type_base[flow](T, B)     :- super_of[flow](T, B).
type_member[flow](T, Key) :- type_base[flow](T, B), type_member[flow](B, Key).
type_open[flow](T)        :- ast_node[code](T, tsinterface_declaration, _), ast_child[code](T, body, 0, B),
                             ast_child[code](B, body, _, S), ast_node[code](S, tsindex_signature, _).
type_open[flow](T)        :- ast_child[code](T, extends, _, H), not names_type[flow](H, _).
type_open[flow](T)        :- class_like[flow](T), ast_child[code](T, super_class, 0, _), not super_of[flow](T, _).
type_open[flow](T)        :- type_base[flow](T, B), type_open[flow](B).
-- a type a member is declared as: an interface's property or a class's field or parameter property
member_type_at[flow](T, Key, A) :- ast_node[code](T, tsinterface_declaration, _), ast_child[code](T, body, 0, B),
                                   ast_child[code](B, body, _, S), ast_node[code](S, tsproperty_signature, _),
                                   ast_child[code](S, key, 0, K), ast_name[code](K, Key),
                                   ast_child[code](S, type_annotation, 0, A).
member_type_at[flow](T, Key, A) :- class_like[flow](T), ast_child[code](T, body, 0, B), ast_child[code](B, body, _, S),
                                   ast_node[code](S, class_property, _), ast_attr[code](S, static, false),
                                   ast_child[code](S, key, 0, K), ast_name[code](K, Key),
                                   ast_child[code](S, type_annotation, 0, A).
member_type_at[flow](T, Key, A) :- class_method_of[flow](T, M), ast_attr[code](M, kind, "constructor"),
                                   ast_child[code](M, params, _, P), param_property[code](P, Key, X),
                                   ast_child[code](X, type_annotation, 0, A).
member_type[flow](T, Key, T2) :- member_type_at[flow](T, Key, A), names_type[flow](A, T2).
member_type[flow](T, Key, T2) :- type_base[flow](T, B), member_type[flow](B, Key, T2).
member_lib[flow](T, Key, P)   :- member_type_at[flow](T, Key, A), names_lib[flow](A, P).
member_lib[flow](T, Key, P)   :- type_base[flow](T, B), member_lib[flow](B, Key, P).
-- the four, mirrored for a type another file names
sx_type_member[surface](T, Key)        :- sx_export_type[surface](_, _, T), type_member[flow](T, Key).
type_member[flow](T, Key)              :- sx_type_member[surface](T, Key).
sx_type_open[surface](T)               :- sx_export_type[surface](_, _, T), type_open[flow](T).
type_open[flow](T)                     :- sx_type_open[surface](T).
sx_member_type[surface](T, Key, T2)    :- sx_export_type[surface](_, _, T), member_type[flow](T, Key, T2).
member_type[flow](T, Key, T2)          :- sx_member_type[surface](T, Key, T2).
sx_member_lib[surface](T, Key, P)      :- sx_export_type[surface](_, _, T), member_lib[flow](T, Key, P).
member_lib[flow](T, Key, P)            :- sx_member_lib[surface](T, Key, P).

-- the receivers: an annotated parameter, binder or field, `this` in an instance method, and a
-- member read off a declared receiver
declared[flow](U, T)   :- param_of[flow](F, I, Name), ast_child[code](F, params, I, P), param_annotation[code](P, A),
                          names_type[flow](A, T), param_use[flow](F, Name, U).
declared_lib[flow](U, L) :- param_of[flow](F, I, Name), ast_child[code](F, params, I, P), param_annotation[code](P, A),
                          names_lib[flow](A, L), param_use[flow](F, Name, U).
param_annotation[code](P, A) :- ast_child[code](P, type_annotation, 0, A).
param_annotation[code](P, A) :- param_property[code](P, _, X), ast_child[code](X, type_annotation, 0, A).
param_annotation[code](P, A) :- ast_node[code](P, assignment_pattern, _), ast_child[code](P, left, 0, X),
                                ast_child[code](X, type_annotation, 0, A).
declared[flow](E, T)   :- ast_node[code](D, variable_declarator, _), ast_child[code](D, id, 0, I),
                          ast_child[code](I, type_annotation, 0, A), names_type[flow](A, T), sees_binder[code](E, D).
declared_lib[flow](E, L) :- ast_node[code](D, variable_declarator, _), ast_child[code](D, id, 0, I),
                          ast_child[code](I, type_annotation, 0, A), names_lib[flow](A, L), sees_binder[code](E, D).
declared[flow](T, CD)  :- class_method_of[flow](CD, M), ast_attr[code](M, static, false), this_host[flow](M, T).
declared[flow](N, T2)  :- member_node_v[flow](N), ast_child[code](N, object, 0, O), declared[flow](O, T),
                          selects[flow](N, Key), member_type[flow](T, Key, T2).
declared_lib[flow](N, L) :- member_node_v[flow](N), ast_child[code](N, object, 0, O), declared[flow](O, T),
                          selects[flow](N, Key), member_lib[flow](T, Key, L).

declared_call[flow](C, T, Key) :- member_call[flow](C, R, Key), declared[flow](R, T).
member_declared[audit](C, T)   :- declared_call[flow](C, T, Key), type_member[flow](T, Key).
member_declared[audit](C, T)   :- declared_call[flow](C, T, Key), lib_member(object, Key, _).
member_declared[audit](C, P)   :- member_call[flow](C, R, Key), declared_lib[flow](R, P), lib_member(P, Key, _).
member_declared[audit](C, P)   :- member_call[flow](C, R, Key), declared_lib[flow](R, P), lib_member(object, Key, _).
declared_has[flow](C)          :- member_declared[audit](C, _).
declared_open[flow](C)         :- declared_call[flow](C, T, _), type_open[flow](T).
-- TypeScript narrows a declared type where the code tests it (`x instanceof Sub`, `'k' in x`,
-- a guard `isSub(x)` in a test): a receiver of that name or key anywhere in the file is not
-- held to its declaration
narrows_at[code](O) :- ast_node[code](X, binary_expression, _), ast_attr[code](X, operator, "instanceof"),
                       ast_child[code](X, left, 0, O).
narrows_at[code](O) :- ast_node[code](X, binary_expression, _), ast_attr[code](X, operator, "in"),
                       ast_child[code](X, right, 0, O).
narrows_at[code](O) :- ast_child[code](P, test, 0, G), ast_child[code](G, arguments, _, O).
narrows_at[code](O) :- ast_node[code](P, unary_expression, _), ast_child[code](P, argument, 0, G),
                       ast_child[code](G, arguments, _, O).
narrows_at[code](O) :- ast_node[code](P, logical_expression, _), ast_child[code](P, left, 0, G),
                       ast_child[code](G, arguments, _, O).
narrows_at[code](O) :- ast_node[code](P, logical_expression, _), ast_child[code](P, right, 0, G),
                       ast_child[code](G, arguments, _, O).
narrowed_name[code](File, Name) :- narrows_at[code](O), ast_node[code](O, identifier, File), ast_name[code](O, Name).
narrowed_key[flow](File, Key)   :- narrows_at[code](O), member_node_v[flow](O), ast_node[code](O, _, File),
                                   selects[flow](O, Key).
declared_open[flow](C) :- declared_call[flow](C, _, _), member_call[flow](C, R, _), ast_node[code](R, identifier, File),
                          ast_name[code](R, Name), narrowed_name[code](File, Name).
declared_open[flow](C) :- declared_call[flow](C, _, _), member_call[flow](C, R, _), member_node_v[flow](R),
                          ast_node[code](R, _, File), selects[flow](R, Key), narrowed_key[flow](File, Key).
declared_any[flow](C)          :- declared_call[flow](C, _, _).
declared_any[flow](C)          :- member_call[flow](C, R, _), declared_lib[flow](R, _).
missing_declared_member[audit](C, T, Key) :- declared_call[flow](C, T, Key), not declared_has[flow](C),
                                             not declared_open[flow](C).
missing_declared_member[audit](C, P, Key) :- member_call[flow](C, R, Key), declared_lib[flow](R, P),
                                             not declared_has[flow](C).
member_undeclared[audit](C) :- member_unknown[audit](C), not declared_any[flow](C).

-- The call graph reads the value layer; declared by the reader.
imports(code, flow).
imports(audit, flow).
imports(code, surface).

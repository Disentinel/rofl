-- js-callgraph.rofl — ONE construct, the FUNCTION CALL, at the call-graph
-- layer. Over the scanner's four relations plus js-structure's `ast_within`,
-- `ast_name`, `ast_value` and `key_name`; resolution itself asks the value
-- layer (`may_be_node`, rules/js-dataflow.rofl) what the callee expression
-- denotes.
--
-- The finish line is not "the rule fires": every callee SHAPE either has a
-- rule or a typed verdict saying why not. Classification is TOTAL — every call
-- site gets exactly one shape — and `unresolved_call` is a POSITIVE relation,
-- countable, rather than the absence of a row. Loads with rules/js-model.rofl
-- for the `unknown_type` taxonomy.

-- =========================================================================
-- 1. CALL SITES
edb(call_kind).
call_kind(call_expression).
call_kind(optional_call_expression).

call_site[code](C, File)      :- ast_node[code](C, K, File, _), call_kind(K).
call_site_kind[code](C, K)    :- ast_node[code](C, K, _, _), call_kind(K).
call_line[code](C, Line)      :- call_site[code](C, _), ast_node[code](C, _, _, Line).

callee_of[code](C, N)         :- call_site[code](C, _), ast_child[code](C, callee, 0, N).
callee_kind[code](C, K)       :- callee_of[code](C, N), ast_node[code](N, K, _, _).

-- Calls the grammar gives no CallExpression: `new C()`, `` tag`x` ``, the
-- iterator protocol of `for-of`, and a decorator. Naming them TRANSFER SITES
-- does not resolve them; it makes a miss attributable instead of silent.
edb(transfer_kind).
transfer_kind(new_expression).
transfer_kind(tagged_template_expression).
transfer_kind(for_of_statement).
transfer_kind(decorator).
transfer_site[code](X, K) :- ast_node[code](X, K, _, _), transfer_kind(K).

site[code](X) :- call_site[code](X, _).
site[code](X) :- transfer_site[code](X, _).

-- The index is content: without it `f(a, b)` and `f(b, a)` are one fact set.
call_arg[code](C, I, A)       :- call_site[code](C, _), ast_child[code](C, arguments, I, A).

-- =========================================================================
-- 2. CALLEE SHAPE — a TOTAL classification, which IS the frontier
--
-- Tables plus one catch-all rather than a chain of negations: a rule that says
-- "everything else" by negating its own head is unstratifiable.
-- `tsnon_null_expression`, not `ts_non_null_expression`: atomise() breaks only
-- between a lower-case and an upper-case letter, so `TSN` survives whole.
edb(callee_shape).
callee_shape(identifier,                s_identifier).
callee_shape(arrow_function_expression, s_iife).
callee_shape(function_expression,       s_iife).
callee_shape(super,                     s_super).
callee_shape(tsnon_null_expression,     s_non_null).
callee_shape(call_expression,           s_call_result).
callee_shape(optional_call_expression,  s_call_result).
callee_shape(new_expression,            s_new_result).
callee_shape(import,                    s_dynamic_import).
callee_shape(sequence_expression,       s_sequence).
callee_shape(parenthesized_expression,  s_parenthesized).
callee_shape(tsas_expression,           s_ts_as).
callee_shape(conditional_expression,    s_conditional).
callee_shape(yield_expression,          s_yield_result).

edb(member_kind).
member_kind(member_expression).
member_kind(optional_member_expression).

member_like[code](C, N)     :- callee_of[code](C, N), ast_node[code](N, K, _, _), member_kind(K).
optional_member[code](C)    :- callee_of[code](C, N), ast_node[code](N, optional_member_expression, _, _).
computed_member[code](C, N) :- member_like[code](C, N), ast_attr[code](N, computed, true).
static_member[code](C, N)   :- member_like[code](C, N), ast_attr[code](N, computed, false).

callee_obj[code](C, O)      :- member_like[code](C, N), ast_child[code](N, object, 0, O).
callee_obj_kind[code](C, K) :- callee_obj[code](C, O), ast_node[code](O, K, _, _).
callee_prop[code](C, P)     :- member_like[code](C, N), ast_child[code](N, property, 0, P).

-- A member callee needs two more bits: `computed`, and the object's kind.
-- Receivers are classed by VERDICT, not by type: a member on a string, number,
-- bigint or regexp is answered by the standard library, so all four are
-- `o_literal`. `import.meta` is `o_meta` and not `o_literal` because its
-- members are the HOST's — `interface ImportMeta` in lib.es5.d.ts is empty —
-- so the era axis cannot date them and `o_literal` would promise an answer
-- that cannot arrive.
edb(obj_kind_class).
obj_kind_class(identifier,                 o_ident).
obj_kind_class(member_expression,          o_member).
obj_kind_class(optional_member_expression, o_member).
obj_kind_class(call_expression,            o_call).
obj_kind_class(optional_call_expression,   o_call).
obj_kind_class(this_expression,            o_this).
obj_kind_class(super,                      o_super).
obj_kind_class(array_expression,           o_array).
obj_kind_class(new_expression,             o_new).
obj_kind_class(object_expression,          o_object_literal).
obj_kind_class(string_literal,             o_literal).
obj_kind_class(numeric_literal,            o_literal).
obj_kind_class(big_int_literal,            o_literal).
obj_kind_class(reg_exp_literal,            o_literal).

obj_kind_class(conditional_expression,     o_conditional).
obj_kind_class(sequence_expression,        o_sequence).
obj_kind_class(logical_expression,         o_logical).
obj_kind_class(assignment_expression,      o_assignment).
obj_kind_class(await_expression,           o_await).
obj_kind_class(template_literal,           o_template).
obj_kind_class(tsas_expression,            o_cast).
obj_kind_class(tsnon_null_expression,      o_non_null).
obj_kind_class(meta_property,              o_meta).

obj_kind_known(K)           :- obj_kind_class(K, _).
obj_class[code](C, Cl)      :- callee_obj_kind[code](C, K), obj_kind_class(K, Cl).
obj_class[code](C, o_other) :- callee_obj_kind[code](C, K), not obj_kind_known(K).

edb(member_shape).
member_shape(o_ident,          s_member_on_ident).
member_shape(o_member,         s_member_on_member).
member_shape(o_call,           s_member_on_call).
member_shape(o_this,           s_member_on_this).
member_shape(o_super,          s_member_on_super).
member_shape(o_array,          s_member_on_array).
member_shape(o_new,            s_member_on_new).
member_shape(o_object_literal, s_member_on_object_literal).
member_shape(o_literal,        s_member_on_literal).
member_shape(o_conditional,    s_member_on_conditional).
member_shape(o_sequence,       s_member_on_sequence).
member_shape(o_logical,        s_member_on_logical).
member_shape(o_assignment,     s_member_on_assignment).
member_shape(o_await,          s_member_on_await).
member_shape(o_template,       s_member_on_template).
member_shape(o_cast,           s_member_on_cast).
member_shape(o_non_null,       s_member_on_non_null).
member_shape(o_meta,           s_member_on_meta).
member_shape(o_other,          s_member_on_other).

-- `o[k]()` with a non-literal k is the one honest `runtime_dependent`.
-- `o[`fixed`]()` is a third case: fixed at parse time but not derivable,
-- because the scanner carries scalar own properties only and a template's
-- `value` is `{raw, cooked}`. So `not_yet` with a named cause, not either
-- neighbour.
edb(static_key_kind).
static_key_kind(string_literal).
static_key_kind(numeric_literal).

computed_key_static[code](C) :- computed_member[code](C, _), callee_prop[code](C, P),
                                ast_node[code](P, K, _, _), static_key_kind(K).

computed_key_template[code](C) :- computed_member[code](C, _), callee_prop[code](C, P),
                                  ast_node[code](P, template_literal, _, _).

shape_known[code](C, S) :- callee_kind[code](C, K), callee_shape(K, S).
shape_known[code](C, s_computed_literal_key) :- computed_member[code](C, _),
                                                computed_key_static[code](C).
shape_known[code](C, s_computed_template_key) :- computed_key_template[code](C).
shape_known[code](C, s_computed_dynamic_key) :- computed_member[code](C, _),
                                                not computed_key_static[code](C),
                                                not computed_key_template[code](C).
shape_known[code](C, s_optional_member)      :- static_member[code](C, _),
                                                optional_member[code](C).
shape_known[code](C, S) :- static_member[code](C, _), not optional_member[code](C),
                           obj_class[code](C, Cl), member_shape(Cl, S).

-- `shape` may negate `has_shape` because `has_shape` does not depend on `shape`.
-- A grammar form nobody anticipated lands in `s_unclassified` rather than
-- vanishing; the two audits below name what sits in each catch-all.
has_shape[code](C)             :- shape_known[code](C, _).
shape[code](C, S)              :- shape_known[code](C, S).
shape[code](C, s_unclassified) :- call_site[code](C, _), not has_shape[code](C).

catch_all_occupied[audit](K) :- shape[code](C, s_member_on_other),
                                callee_obj_kind[code](C, K).

unnamed_callee[audit](K) :- shape[code](C, s_unclassified), callee_kind[code](C, K).

shaped[code](C)         :- shape[code](C, _).
unshaped[audit](C)      :- call_site[code](C, _), not shaped[code](C).
multi_shape[audit](C, A, B) :- shape[code](C, A), shape[code](C, B), A != B.

-- =========================================================================
-- 3. THE ENCLOSING FUNCTION
edb(fn_kind).
fn_kind(function_declaration).
fn_kind(function_expression).
fn_kind(arrow_function_expression).
fn_kind(object_method).
fn_kind(class_method).
fn_kind(class_private_method).

fn_node[code](F)     :- ast_node[code](F, K, _, _), fn_kind(K).
fn_file[code](F, File) :- fn_node[code](F), ast_node[code](F, _, File, _).

-- A function's name is whatever binds it — several arms, and a node may hold
-- more than one name. `key_name` rather than `ast_name` on a key, so a computed
-- well-known symbol is a name too. A constructor answers to the CLASS's name:
-- V8 reports the frame as `new Box`, and without `not ctor_method` the edge
-- was derived twice, once as `-> constructor`, which no execution produces.
-- The declarator arm leads with the declarator: written `fn_node(F)` first it
-- laid every function beside every declarator (271 982 accumulator rows on
-- sixteen eslint files). A PRIVATE method gets no name: V8 says `#rim`, the
-- store holds `rim`, and the kernel has no operation that builds a string.
fn_name[code](F, N) :- ast_node[code](F, function_declaration, _, _),
                       ast_child[code](F, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- ast_node[code](F, function_expression, _, _),
                       ast_child[code](F, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- ast_node[code](F, object_method, _, _),
                       ast_child[code](F, key, 0, K), key_name[code](K, N).
ctor_method[code](F)   :- ast_node[code](F, class_method, _, _),
                          ast_attr[code](F, kind, "constructor").
fn_name[code](F, N) :- ast_node[code](F, class_method, _, _), not ctor_method[code](F),
                       ast_child[code](F, key, 0, K), key_name[code](K, N).
fn_name[code](F, N) :- ast_node[code](D, variable_declarator, _, _),
                       ast_child[code](D, init, 0, F), fn_node[code](F),
                       ast_child[code](D, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- key_name[code](K, N), ast_child[code](P, key, 0, K),
                       ast_node[code](P, object_property, _, _),
                       ast_child[code](P, value, 0, F), fn_node[code](F).
fn_name[code](F, N) :- ast_node[code](F, class_method, _, _),
                       ast_attr[code](F, kind, "constructor"),
                       ast_child[code](CD, body, 0, B), ast_child[code](B, body, _, F),
                       ast_child[code](CD, id, 0, I), ast_name[code](I, N).
fn_name[code](F, N) :- fn_node[code](F), class_field_kind(K), ast_node[code](P, K, _, _),
                       ast_child[code](P, value, 0, F),
                       ast_child[code](P, key, 0, KN), key_name[code](KN, N).

-- A class expression with no `id` takes its binding's name — the language's own
-- inference: `const A = class {}` has `A.name === "A"`, but
-- `const W = class Hoist {}` has `"Hoist"`. The arm carries the negation so
-- the two constructor arms never both fire.
class_has_id[code](CD) :- ast_node[code](CD, class_expression, _, _),
                          ast_child[code](CD, id, 0, _).
anon_class[code](CD)   :- ast_node[code](CD, class_expression, _, _),
                          not class_has_id[code](CD).
fn_name[code](F, N) :- ast_node[code](F, class_method, _, _),
                       ast_attr[code](F, kind, "constructor"),
                       ast_child[code](CD, body, 0, B), ast_child[code](B, body, _, F),
                       anon_class[code](CD),
                       ast_node[code](D, variable_declarator, _, _),
                       ast_child[code](D, init, 0, CD),
                       ast_child[code](D, id, 0, I), ast_name[code](I, N).

-- A decorator is INSIDE the thing it decorates and does not run there:
-- `@decoFactory('m') marked() {}` puts the call in `marked`'s subtree and
-- evaluates it at class definition. Two arms because the decorator node is
-- itself a site and `ast_within` is irreflexive. `F != G` in `closer` is
-- carried so the rule does not silently depend on that irreflexivity.
-- `top_call` reads `site` and not `call_site`: a transfer site at module top
-- level reaches `calls` only through here. (`top_site` was its twin, written
-- for transfer sites while `top_call` still read `call_site`; the 2026-09-08
-- repair made them one rule and 2026-09-11 made them one name.)
decorates[code](Owner, D)     :- ast_child[code](Owner, decorators, _, D),
                                 ast_node[code](D, decorator, _, _).
in_own_decorator[code](F, C)  :- decorates[code](F, D), ast_within[code](D, C).
in_own_decorator[code](F, D)  :- decorates[code](F, D).
encloses[code](F, C)   :- fn_node[code](F), ast_within[code](F, C), site[code](C),
                          not in_own_decorator[code](F, C).
closer[code](F, C)     :- encloses[code](F, C), encloses[code](G, C),
                          ast_within[code](F, G), F != G.
nearest_fn[code](F, C) :- encloses[code](F, C), not closer[code](F, C).

enclosed[code](C)      :- encloses[code](_, C).
top_call[code](C, R)   :- site[code](C), ast_node[code](C, _, File, _),
                          ast_file[code](R, File), not enclosed[code](C).

-- =========================================================================
-- 4. RESOLUTION — scope-blind on purpose: a name bound anywhere in the file
-- answers a call anywhere in the file. Shadowing is the scope layer's job.
--
-- Every member shape is the same question — resolve the OBJECT half, look the
-- KEY up in it — so there is one resolution rule (the last in this section)
-- over `may_be_node`, and the shapes are entry points into the value layer.
-- Both `obj_member_fn` arms lead with `key_name` for correctness AND cost:
-- `ns[haspSpelling]()` must not resolve under the variable's spelling, and
-- `key_name`'s 105 rows bind K so every later literal is an indexed lookup.
obj_member_fn[code](O, Key, M) :- key_name[code](K, Key),
                                  ast_child[code](M, key, 0, K),
                                  ast_node[code](M, object_method, _, _),
                                  ast_child[code](O, properties, _, M),
                                  ast_node[code](O, object_expression, _, _).
obj_member_fn[code](O, Key, F) :- key_name[code](K, Key),
                                  ast_child[code](P, key, 0, K),
                                  ast_node[code](P, object_property, _, _),
                                  ast_child[code](P, value, 0, F), fn_node[code](F),
                                  ast_child[code](O, properties, _, P),
                                  ast_node[code](O, object_expression, _, _).

-- The constructor edge is not a CallExpression at all; it needed the value
-- question "which class does this expression construct". `super()` walks
-- `ctor_of` (a class with no constructor forwards to its ancestor's — V8 skips
-- the synthesised frame); `new` deliberately does NOT, because V8 names the
-- frame after the class and makes it the caller.
class_ctor[code](CD, M) :- class_method_of[flow](CD, M),
                           ast_attr[code](M, kind, "constructor").

resolves[code](X, M) :- transfer_site[code](X, new_expression),
                        may_be_node[flow](X, CD), class_ctor[code](CD, M).

resolves[code](C, M) :- callee_of[code](C, N), ast_node[code](N, super, _, _),
                        may_be_node[flow](N, SD), ctor_of[flow](SD, M).

-- A tag is a callee in every sense but the grammar's (the field is `tag`, not
-- `callee`); a decorator's `expression` is either the function or a factory
-- call, and `may_be_node` carries what a call returns, so one arm covers both.
resolves[code](X, F) :- transfer_site[code](X, tagged_template_expression),
                        ast_child[code](X, tag, 0, T),
                        may_be_node[flow](T, F), fn_node[code](F).

resolves[code](X, F) :- transfer_site[code](X, decorator),
                        ast_child[code](X, expression, 0, E),
                        may_be_node[flow](E, F), fn_node[code](F).

-- `for (x of E)` calls `E[Symbol.iterator]()` and then `next()`. Only the first
-- hop is a `resolves`: `ambiguous_call[audit]` reads two answers at one site
-- as an over-approximation, and a for-of really makes two calls, so the second
-- goes straight to `calls`. `member_value` names the node a member HOLDS — for
-- `{ next: bump }` the identifier — hence the second `may_be_node` hop.
for_of_iterates[code](X, M) :- transfer_site[code](X, for_of_statement),
                               ast_child[code](X, right, 0, R),
                               may_be_node[flow](R, Obj),
                               member_value[flow](Obj, "iterator", M), fn_node[code](M).
resolves[code](X, M) :- for_of_iterates[code](X, M).

calls[code](Caller, Next) :- for_of_iterates[code](X, M), nearest_fn[code](Caller, X),
                             returns[flow](M, E), may_be_node[flow](E, IterObj),
                             member_value[flow](IterObj, "next", V),
                             may_be_node[flow](V, Next), fn_node[code](Next).

-- THE GENERAL RULE: whatever the callee expression may BE, if it is a function
-- the site calls it. Covers `(f)()`, `f as T ()`, `f!()`, `(a, f)()`,
-- `c ? f : g ()` and the next wrapper somebody adds, with no rule here.
resolves[code](C, F) :- callee_of[code](C, N), may_be_node[flow](N, F), fn_node[code](F).

ambiguous_call[audit](C, F, G) :- resolves[code](C, F), resolves[code](C, G), F != G.

-- =========================================================================
-- 5. THE EDGE — by node, by name (a stack frame carries a name), and by file
-- (an oracle can only be compared against the files it ran).
-- `passes_function` is recorded and NOT folded into `calls`: passing a
-- function is not calling it.
calls[code](Caller, Callee) :- resolves[code](C, Callee), nearest_fn[code](Caller, C).
calls[code](R, Callee)      :- resolves[code](C, Callee), top_call[code](C, R).

calls_named[code](A, B)   :- calls[code](X, Y), fn_name[code](X, A), fn_name[code](Y, B).
calls_named[code](top, B) :- calls[code](R, Y), ast_file[code](R, _), fn_name[code](Y, B).

calls_in[code](File, A, B)   :- calls[code](X, Y), ast_node[code](X, _, File, _),
                                fn_name[code](X, A), fn_name[code](Y, B).
calls_in[code](File, top, B) :- calls[code](R, Y), ast_file[code](R, File),
                                fn_name[code](Y, B).

passes_function[code](C, I, F, Name) :- arg_at[flow](C, I, A), ast_name[code](A, Name),
                                        may_be_node[flow](A, F), fn_node[code](F).

-- =========================================================================
-- 6. THE FRONTIER, AS A POSITIVE RELATION
--
-- `stdlib_member` resolves nothing: it moves "the receiver is a builtin
-- prototype, so the method is not a node in this program" from prose into a
-- row `w_env_api_surface` reads. `shape_because(Lang, Shape, Layer, Reason)`
-- is the verdict ledger for SHAPES, separate from js-model's kind-level
-- `unknown_because`, because a kind cannot express partial coverage.
resolved_site[code](C)      :- resolves[code](C, _).
resolved_call[code](C)      :- resolved_site[code](C), call_site[code](C, _).
unresolved_call[code](C, S) :- shape[code](C, S), not resolved_site[code](C).
unresolved_shape[audit](S)  :- unresolved_call[code](_, S).

stdlib_member[audit](C, P, Key) :- unresolved_call[code](C, _), callee_of[code](C, N),
                                   ast_child[code](N, object, 0, O),
                                   prototype_of[flow](O, P), builtin_prototype(P),
                                   selects[flow](N, Key).

edb(shape_because).

-- An unresolved site attributed to the unit that contains it; a missing edge
-- whose caller has no row here is a SILENT under-report. A transfer site that
-- resolves is no longer frontier. `frontier_line` is what a stack frame can be
-- matched against.
frontier_at[code](F, S) :- nearest_fn[code](F, C), unresolved_call[code](C, S).
frontier_at[code](R, S) :- top_call[code](C, R), unresolved_call[code](C, S).
frontier_at[code](F, K) :- nearest_fn[code](F, X), transfer_site[code](X, K),
                           not resolved_site[code](X).
frontier_at[code](R, K) :- top_call[code](X, R), transfer_site[code](X, K),
                           not resolved_site[code](X).

frontier_named[code](Name, Item) :- frontier_at[code](F, Item), fn_name[code](F, Name).
frontier_named[code](top, Item)  :- frontier_at[code](R, Item), ast_file[code](R, _).

frontier_line[code](File, Line, S) :- unresolved_call[code](C, S), ast_node[code](C, _, File, Line).
frontier_line[code](File, Line, K) :- transfer_site[code](X, K), not resolved_site[code](X),
                                      ast_node[code](X, _, File, Line).

-- The closed vocabulary of shapes, read off the tables: the denominator is the
-- grammar, so a shape the corpus never produces still wants an answer.
-- `shape_stale` is an excuse that outlived its cause; `unrecorded_coverage` is
-- the opposite direction — rules doing the work while the cell says
-- `not_modelled`, which every other gate stays green through.
shape_vocab[audit](S) :- callee_shape(_, S).
shape_vocab[audit](S) :- member_shape(_, S).
shape_vocab[audit](s_computed_literal_key).
shape_vocab[audit](s_computed_dynamic_key).
shape_vocab[audit](s_computed_template_key).
shape_vocab[audit](s_optional_member).
shape_vocab[audit](s_unclassified).

shape_seen[audit](S)     :- shape[code](_, S).
resolved_shape[audit](S) :- resolves[code](C, _), shape[code](C, S).

shape_verdict[audit](S, absent)         :- shape_vocab[audit](S), not shape_seen[audit](S).
shape_verdict[audit](S, fully_resolved) :- shape_seen[audit](S), not unresolved_shape[audit](S).
shape_verdict[audit](S, has_residue)    :- unresolved_shape[audit](S).

shape_reason[audit](S, R)     :- unresolved_shape[audit](S), shape_because(js, S, callgraph, R).
shape_unexplained[audit](S)   :- unresolved_shape[audit](S), not shape_because(js, S, callgraph, _).
shape_bad_reason[audit](S, R) :- shape_because(js, S, callgraph, R), not unknown_type(R, _).
shape_orphan[audit](S)        :- shape_because(js, S, callgraph, _), not shape_vocab[audit](S).
shape_stale[audit](S)         :- shape_because(js, S, callgraph, _), shape_seen[audit](S),
                                 not unresolved_shape[audit](S).
shape_unexercised[audit](S)   :- shape_because(js, S, callgraph, _), not shape_seen[audit](S).
shape_irreducible[audit](S)   :- shape_reason[audit](S, R), unknown_type(R, irreducible).

unrecorded_coverage[audit](K, S) :- resolved_shape[audit](S), shape_of(js, K, S),
                                    verdict[audit](js, K, S, callgraph, not_modelled).
shape_ours[audit](S)          :- shape_reason[audit](S, R), unknown_type(R, ours).

-- What modelling this layer dragged in: every kind its rules touch must be a
-- declared `node_kind`, or the matrix has a cell it does not know exists.
fn_binder[code](D, F) :- ast_node[code](D, variable_declarator, _, _),
                         ast_child[code](D, init, 0, F), fn_node[code](F).
fn_binder[code](P, F) :- ast_node[code](P, object_property, _, _),
                         ast_child[code](P, value, 0, F), fn_node[code](F).
fn_binder[code](O, M) :- obj_member_fn[code](O, _, M).

callgraph_kind[audit](K)  :- call_site_kind[code](_, K).
callgraph_kind[audit](K)  :- callee_kind[code](_, K).
callgraph_kind[audit](K)  :- callee_obj_kind[code](_, K).
callgraph_kind[audit](K)  :- callee_prop[code](_, P), ast_node[code](P, K, _, _).
callgraph_kind[audit](K)  :- fn_node[code](F), ast_node[code](F, K, _, _).
callgraph_kind[audit](K)  :- fn_binder[code](B, _), ast_node[code](B, K, _, _).
kind_undeclared[audit](K) :- callgraph_kind[audit](K), not node_kind(js, K).

-- =========================================================================
-- 7. A CALL THE LANGUAGE PERFORMS, WITH NO CALLER
--
-- `calls` says a caller is a lexical region: the nearest function or the
-- module root. `await` breaks that. Measured on V8 11.3 and 13.6 with
-- `Promise.prototype.then` monkey-patched: `await <native promise>` and
-- `await 5` call it ZERO times (the spec's Await uses PerformPromiseThen, an
-- internal operation); only a user thenable's own `then` is called, and it is
-- called on a stack of depth ONE — no caller frame at all. The execution
-- oracle drops caller-less edges before comparing, so it can neither confirm
-- nor refute this section.
--
-- So `performed_call` is one column short of `calls` on purpose and never
-- reaches `calls_named`/`calls_in`. The two `may_be_node` hops are the same
-- last step the iterator protocol takes: `member_value` names the identifier.
await_arg[code](A, X) :- ast_node[code](A, await_expression, _, _),
                         ast_child[code](A, argument, 0, X).

awaited_then[code](A, F) :- await_arg[code](A, X), may_be_node[flow](X, O),
                            member_value[flow](O, "then", V),
                            may_be_node[flow](V, F), fn_node[code](F).

performed_call[code](A, F) :- awaited_then[code](A, F).
callerless_call[audit](Name) :- performed_call[code](_, F), fn_name[code](F, Name).

-- Three-way split of every await: value known and no `then` (the language
-- performs NO call — a positive statement, and the one arm here that can be
-- WRONG rather than silent, since `may_be_node` is a may-set); value unknown
-- (the frontier, deliberately not wired into `frontier_at`, which is keyed by
-- a caller this call has not got).
await_value_known[code](A)    :- await_arg[code](A, X), may_be_node[flow](X, _).
await_no_call[code](A)        :- await_value_known[code](A), not awaited_then[code](A, _).
await_value_unknown[audit](A) :- await_arg[code](A, _), not await_value_known[code](A).

-- The gate: a performed call must never become an ordinary edge. It cannot use
-- `nearest_fn`, because `encloses` demands `site(C)` and an await is not a site
-- — written that way it was permanently silent.
awaiting_fn[code](Fn, A) :- performed_call[code](A, _), fn_node[code](Fn),
                            ast_within[code](Fn, A).
performed_as_edge[audit](Fn, F) :- performed_call[code](A, F),
                                   awaiting_fn[code](Fn, A),
                                   calls[code](Fn, F).

-- The call graph reads the value layer; declared by the reader.
imports(code, flow).
imports(audit, flow).

-- rules/parse-cost.rofl — WHY PARSING ROFL IN ROFL IS SLOW, as a derivation.
--
-- The facts are facts/parse-cost.rofl, regenerated by scanners/parse_cost.ts.
-- Nothing is concluded there and nothing is measured here: this file is the
-- reasoning, and `why` walks it back to the run that produced each number.
--
-- Read the answer with
--   npm run report -- facts/parse-cost.rofl rules/parse-cost.rofl
-- or ask the kernel directly:
--   why('slow_because[main](parse, reuse_plan)')

edb(cache).
edb(sweep).
edb(primitive).
edb(call_site).
edb(in_phase).
edb(declines).

-- ---------------------------------------------------------------------------
-- FIRST BRANCH: an optimisation that optimises nothing.
--
-- The cache decides which relations may be served from the previous
-- evaluation instead of re-derived. Whether it EARNED its time is not a
-- matter of opinion: run the same clause twice and count.

saves_no_firing(yes) :- cache(on, firings, N), cache(off, firings, N).
same_store(yes)      :- cache(on, facts, M), cache(off, facts, M).
saves_nothing(reuse_plan) :- saves_no_firing(yes), same_store(yes).

cache_costs(D)   :- cache(on, ms, A), cache(off, ms, B), D is A - B.
work_costs(B)    :- cache(off, ms, B).
overhead_exceeds_work(reuse_plan) :- cache_costs(D), work_costs(B), D > B.

-- A phase that changes no answer and costs more than the answer is not an
-- optimisation with a bad case. It is overhead, on this program, always.
pure_overhead(P) :- saves_nothing(P), overhead_exceeds_work(P).
slow_because(parse, P) :- pure_overhead(P).

-- ---------------------------------------------------------------------------
-- SECOND BRANCH: the part that is left after the cache is off.
--
-- Two questions, and the answer is only interesting because they differ. Do
-- the FIRINGS grow faster than the input? And does ONE FIRING get dearer?

bigger(A, B)      :- sweep(A, _, _, _), sweep(B, _, _, _), A < B.
firings_at(A, F)  :- sweep(A, _, F, _).
ms_at(A, M)       :- sweep(A, M, _, _).
facts_at(A, S)    :- sweep(A, _, _, S).

-- I EXPECTED FIRINGS TO BE LINEAR IN THE INPUT AND WROTE THAT RULE FIRST. The
-- model refused to derive it, which is the model working: over all ten pairs
-- of the sweep, firings per byte RISE. Stated by cross-multiplication, because
-- a rule may not divide its way to a fraction: FB/B > FA/A is FB*A > FA*B.
firings_outpace_input(A, B) :- bigger(A, B), firings_at(A, FA), firings_at(B, FB),
                               L is FB * A, Rr is FA * B, L > Rr.

-- and ONE FIRING gets dearer as well: ms per firing rises from A to B.
per_firing_rises(A, B) :- bigger(A, B), ms_at(A, MA), ms_at(B, MB),
                          firings_at(A, FA), firings_at(B, FB),
                          L is MB * FA, Rr is MA * FB, L > Rr.
store_grows(A, B)      :- bigger(A, B), facts_at(A, SA), facts_at(B, SB), SB > SA.
cost_tracks_store(fixpoint) :- per_firing_rises(A, B), store_grows(A, B).

-- SO THE TIME IS A PRODUCT OF TWO GROWING THINGS, and that is the whole of the
-- superlinearity: more firings per byte, and each firing dearer than the last.
-- The second factor is the one that does not belong there -- a firing should
-- cost what its own premises cost, not what the store happens to hold.
both_factors_grow(fixpoint) :- firings_outpace_input(A, B), cost_tracks_store(fixpoint).
scans_what_it_reads(fixpoint) :- both_factors_grow(fixpoint), cost_tracks_store(fixpoint).
slow_because(parse, fixpoint) :- scans_what_it_reads(fixpoint).

-- ---------------------------------------------------------------------------
-- THE PRIMITIVE UNDERNEATH BOTH BRANCHES.
--
-- Both phases reach the store the same way. One of its two primitives is flat
-- in the size of the relation and the other is not, and every millisecond
-- above is on the wrong side of that line.

flat(Op)          :- primitive(Op, 1000, A), primitive(Op, 40000, B), L is A * 4, B < L.
grows_with_size(Op) :- primitive(Op, 1000, A), primitive(Op, 40000, B), L is A * 4, B >= L.

reaches_store(Phase, Op) :- call_site(Site, Op), in_phase(Site, Phase).
pays_per_fact(Phase) :- reaches_store(Phase, Op), grows_with_size(Op).
root_cause(Op) :- grows_with_size(Op), reaches_store(_, Op).

-- WHY THE SCAN HAPPENS AT ALL: the index is not missing, it is DECLINED. A
-- premise with no bound argument has nothing to probe an index with, and the
-- leading premise of every chart rule is exactly that.
unindexable(Site) :- declines(Site, no_bound_argument).
scan_is_forced(Phase) :- unindexable(Site), in_phase(Site, Phase), call_site(Site, Op),
                         grows_with_size(Op).

-- ---------------------------------------------------------------------------
-- THE ANSWER, and it is two answers with different remedies.
--
-- One is a phase that can be switched off today and costs nothing to lose.
-- The other is the shape of the grammar meeting the shape of the store, and
-- costs an index that can be probed with nothing bound.
fixable_now(P)  :- slow_because(parse, P), pure_overhead(P).
structural(P)   :- slow_because(parse, P), scan_is_forced(P).

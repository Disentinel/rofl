-- floor-census.rofl — WHAT A FLOOR MAY SEAL, derived rather than listed.
--
-- Reads facts/floor-census.rofl (generated by scanners/floor_census.ts).
--   npm run floorcensus     rebuild the facts
--   npm run whyfloor        this derivation over them
--
-- The question: a tower of floors carries, in one store, the reflection of
-- every floor below it. `examples/ring1` is the case — 59% of the image is
-- rows ABOUT the grammar rather than rows the grammar runs on, and
-- `parseFile` forks that store once per clause. Which of them may a finished
-- floor stop publishing?
--
-- Three separate answers are needed and folding them together is the mistake
-- this file exists to avoid:
--
--   1. is the row EXECUTABLE — does the evaluator read it to run the program
--   2. is it LOAD-BEARING anyway — does something else break without it
--   3. who READS it — and does that reader go silent or loud when it is gone
--
-- Nothing here is a list of relation names. Every judgement below is derived
-- from `in_bucket`, `ablation` and `refl_reader`, which the scanner measured.

edb(program).
edb(store_facts).
edb(store_bytes).
edb(bucket_facts).
edb(bucket_bytes).
edb(rel_facts).
edb(rel_bytes).
edb(in_bucket).
edb(ablation).
edb(refl_reader).
edb(corpus_files).
edb(corpus_unparsed).

-- ------------------------------------------------------------------ 1. shape
-- The two halves of "about" scale with different things and must not be
-- averaged: one grows with the PROGRAM, the other with the DATA.
about_bucket(about_rule).
about_bucket(about_fact).
about(P, N)      :- bucket_facts(P, about_rule, N).
about(P, N)      :- bucket_facts(P, about_fact, N).
about_total(P, N) :- bucket_facts(P, about_rule, A), bucket_facts(P, about_fact, B),
                     N is A + B.

-- A floor is TOP-HEAVY when what is said about its rules outweighs what it
-- says about the world. That is the shape the tower has and the corpus
-- programs do not.
top_heavy(P) :- bucket_facts(P, about_rule, A), bucket_facts(P, world, W), W < A.

-- --------------------------------------------------------- 2. load-bearing
-- MEASURED, not declared. `ablation(W, Rel, N, Verdict)` dropped the rows and
-- asked the world again, cold. `identical` is the only verdict that licenses
-- anything; `not_live` means the arm removed nothing and says NOTHING about
-- the relation, which is the distinction a set of mutants exists to keep.
measured(Rel)      :- ablation(_, Rel, _, identical).
measured(Rel)      :- ablation(_, Rel, _, diverged).
measured(Rel)      :- ablation(_, Rel, _, refused).
unmeasured(Rel)    :- ablation(_, Rel, _, not_live).
load_bearing(Rel)  :- ablation(_, Rel, _, diverged).
load_bearing(Rel)  :- ablation(_, Rel, _, refused).
droppable(Rel)     :- ablation(_, Rel, _, identical).

-- ------------------------------------------------------------- 3. the readers
-- A reader is a rule body in some .rofl file of this tree. The kernel's own
-- two programs are `policy.rofl` and `safety.rofl`; they run in stores of
-- their own but are SEEDED FROM THE PROGRAM'S STORE (src/engine.ts:628, :982),
-- so a row they read is a row the program must still be carrying.
kernel_program("policy.rofl").
kernel_program("safety.rofl").
kernel_reader(Rel) :- refl_reader(F, Rel, _, _), kernel_program(F).

-- An audit is a rule writing the [audit] ledger. boot.rofl's are the ones
-- that go quiet when the evidence is withheld.
audit_reader(Rel, Head) :- refl_reader("boot.rofl", Rel, Head, _).

-- A reader outside both: a program of this repository reading reflection for
-- its own purposes.
program_reader(Rel, F) :- refl_reader(F, Rel, _, _), not kernel_program(F),
                          not boot(F).
boot("boot.rofl").

-- ------------------------------------------------------ what a floor may seal
-- SEALABLE: measured droppable, and not read by either kernel program. Both
-- halves are required and neither implies the other -- `premise_pos` is
-- droppable on the ring 1 grammar and is copied into policy.rofl's store for
-- every program, so a floor that sealed it would break the next program that
-- needed the reuse plan.
sealable(Rel) :- droppable(Rel), not kernel_reader(Rel).

-- AND THE ONE THE ABLATION CANNOT SEE, named rather than quietly included.
-- A provenance row is DERIVED: removing it and re-evaluating puts it straight
-- back, so `ablation` reports `not_live` for it in every world and always
-- will. That is a property of the relation and not a gap in the instrument,
-- which is why it gets its own clause instead of a wider verdict — the
-- question for a derived row is not "does anything break without it" but
-- "does anything READ it", and the reader census answers that directly.
rederived(Rel) :- in_bucket(Rel, provenance).
sealable(Rel)  :- rederived(Rel), not kernel_reader(Rel).

-- AND WHAT IT COSTS, stated as the rule that stops seeing its subject. This
-- is the sentence the declaration exists to make visible: without it these
-- audits return EMPTY, which reads exactly like a clean bill.
blinded(Head, Rel) :- sealable(Rel), audit_reader(Rel, Head).

-- A sealable row that no audit and no program reads at all: nothing loses
-- anything, which is a different and weaker claim than the one above.
unread(Rel) :- sealable(Rel), not audit_reader(Rel, _), not program_reader(Rel, _).

-- --------------------------------------------------------------- the saving
-- Measured against the unsealed twin of the same grammar rather than against
-- an estimate: `ring1_unsealed` is `ring1_image` with the declaration struck.
saved_facts(N) :- store_facts(ring1_unsealed, A), store_facts(ring1_image, B),
                  N is A - B.
saved_bytes(N) :- store_bytes(ring1_unsealed, A), store_bytes(ring1_image, B),
                  N is A - B.

-- ------------------------------------------------------------- what to report
report(sealable, Rel)         :- sealable(Rel).
report(load_bearing, Rel)     :- load_bearing(Rel).
report(unmeasured, Rel)       :- unmeasured(Rel).
report(blinded_audit, Head)   :- blinded(Head, _).
report(top_heavy, P)          :- top_heavy(P).

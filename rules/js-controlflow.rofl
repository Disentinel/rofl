-- js-controlflow.rofl — THE CONTROL-FLOW LAYER: not WHICH function a site
-- reaches but WHETHER the site runs at all. It writes into [code]; everything
-- here is a fact about a position in the tree.
--
-- The whole layer is a MAY-set in one direction: `guarded` means "may not
-- run", never "never runs". A set too WIDE is a hedge; a set too NARROW is a
-- claim, and the narrow direction is the dangerous one throughout.

-- =========================================================================
-- 1. A POSITION THAT ONLY RUNS SOMETIMES — one row per (parent, arm), and
-- the vocabulary is closed: `guard_unmodelled[audit]` reports a kind that
-- branches and is not here. `&&`, `||`, `??` all short-circuit, so the kind
-- suffices. `do_while_statement` is NOT here: its body runs before the test. A `for`'s
-- `update` runs zero times when the test fails at once. A default value (the
-- `right` of an `assignment_pattern`) runs only when the argument is absent;
-- the `left` is a name and not conditional. Of a `try` only the HANDLER is a
-- guard: the block and the finalizer always run.
edb(guard_kind).
guard_kind(if_statement,               consequent).
guard_kind(if_statement,               alternate).
guard_kind(conditional_expression,     consequent).
guard_kind(conditional_expression,     alternate).
guard_kind(logical_expression,         right).
guard_kind(for_of_statement,           body).
guard_kind(for_statement,              body).
guard_kind(for_statement,              update).
guard_kind(for_in_statement,           body).
guard_kind(while_statement,            body).
guard_kind(assignment_pattern,         right).
guard_kind(switch_case,                consequent).
guard_kind(try_statement,              handler).

-- ANY index: `switch_case`'s `consequent` is an array, one arm per statement.
guard_arm[code](P, A) :- guard_kind(K, Field), ast_node[code](P, K, _, _),
                         ast_child[code](P, Field, _, A).

-- A non-static field initialiser runs once per construction and never if the
-- class is never constructed; a static one runs with the definition. Derived
-- from `transfer_mechanism(K, per_construction)`, not a second list.
field_init[code](P, V) :- transfer_mechanism(K, per_construction),
                          ast_node[code](P, K, _, _), ast_attr[code](P, static, false),
                          ast_child[code](P, value, 0, V).
guard_arm[code](P, V)  :- field_init[code](P, V).

guarded[code](A) :- guard_arm[code](_, A).
guarded[code](N) :- guard_arm[code](_, A), ast_within[code](A, N).

-- =========================================================================
-- 2. STATEMENT ORDER. After a return/throw/break/continue the rest of the list
-- never runs; `guarded` weakens that NEVER into a MAY on purpose — one
-- vocabulary, one reader. Statement lists sit under `body` and under
-- `switch_case`'s `consequent`; the field is carried so an abrupt in one field
-- cannot reach a statement in another.
edb(abrupt_kind).
abrupt_kind(return_statement).
abrupt_kind(throw_statement).
abrupt_kind(break_statement).
abrupt_kind(continue_statement).

edb(stmt_seq_field).
stmt_seq_field(body).
stmt_seq_field(consequent).

-- `abrupt_at` is a handful of rows and binds B and F: the second literal probes.
after_abrupt[code](S) :- abrupt_at[code](B, F, I), ast_child[code](B, F, J, S), I < J.

-- A SUSPENSION (`await`, `yield`) is a point after which the rest may not run —
-- control comes back only if the promise settles — so it lands in `guarded` as
-- a MAY and is deliberately not an `abrupt_at` arm. Confined to the suspending
-- function: without `nearest_v` an `await` inside a function would guard
-- everything after that function's declaration at module level.
suspend_at[code](B, F, I) :- transfer_mechanism(K, suspend), ast_node[code](X, K, _, _),
                             nearest_v[flow](G, X), ast_within[code](G, S),
                             ast_within[code](S, X),
                             stmt_seq_field(F), ast_child[code](B, F, I, S).
after_suspend[code](S) :- suspend_at[code](B, F, I), ast_child[code](B, F, J, S), I < J.

-- a sequence field the scanner never emits: the typo hole, as `guard_arm_unseen`
stmt_seq_unseen[audit](F) :- stmt_seq_field(F), not ast_child[code](_, F, 0, _).

-- A LABEL is a boundary an ordinary break cannot cross: `break outer` kills the
-- statements between the reference and its target, and the walk stops at the
-- label. The label is read, not the keyword, so an unlabelled break derives
-- nothing here. The target is unique by grammar (a nested duplicate label is a
-- SyntaxError) and a label is not in scope inside a nested function, so no
-- function-boundary literal is needed. `if (c) break outer;` puts a guard
-- between reference and target and the walking arms then say NEVER where the
-- honest word is MAY (f_after_abrupt_says_never_and_the_walking_arms_say_may);
-- harmless, because both consumers read through `guarded`.
label_name[code](LS, N)   :- ast_node[code](LS, labeled_statement, _, _),
                             ast_child[code](LS, label, 0, I), ast_attr[code](I, name, N).
label_ref[code](X, N)     :- abrupt_kind(K), ast_node[code](X, K, _, _),
                             ast_child[code](X, label, 0, I), ast_attr[code](I, name, N).
label_target[code](X, LS) :- label_ref[code](X, N), label_name[code](LS, N),
                             ast_within[code](LS, X).

abrupt_at[code](B, F, I)  :- label_target[code](X, LS), ast_within[code](LS, S),
                             ast_within[code](S, X), stmt_seq_field(F),
                             ast_child[code](B, F, I, S).

-- =========================================================================
-- COMPLETION — not a ninth mechanism but the CLOSURE: does this statement
-- complete normally? A sound under-approximation: a statement it does not name
-- may still complete abruptly (a `guarded` set too small); it must never name
-- one that CAN complete normally, so each arm is the language's rule for its
-- kind. A block completes abruptly if ANY statement in it does — not the last:
-- an abrupt statement is the last that runs. An `if` only if BOTH arms exist
-- and both do. A labelled statement only if its body does AND nothing breaks
-- out of it. Seeded from `completes_abruptly` and walked UP one edge; the other
-- way the first literal is every block in the corpus.
edb(completion_kind).
completion_kind(block_statement).
completion_kind(if_statement).
completion_kind(labeled_statement).

completes_abruptly[code](S) :- abrupt_kind(K), ast_node[code](S, K, _, _).

completes_abruptly[code](B) :- completes_abruptly[code](S), ast_child[code](B, body, _, S),
                               ast_node[code](B, block_statement, _, _).

completes_abruptly[code](S) :- completes_abruptly[code](C), ast_child[code](S, consequent, 0, C),
                               ast_node[code](S, if_statement, _, _),
                               ast_child[code](S, alternate, 0, A), completes_abruptly[code](A).

label_escaped[code](LS)      :- label_target[code](_, LS).
completes_abruptly[code](LS) :- completes_abruptly[code](S), ast_child[code](LS, body, 0, S),
                                ast_node[code](LS, labeled_statement, _, _),
                                not label_escaped[code](LS).

-- the consumer: it replaces the old four-kind arm rather than sitting beside
-- it, since the base case IS that arm
abrupt_at[code](B, F, I) :- completes_abruptly[code](S), stmt_seq_field(F),
                            ast_child[code](B, F, I, S).

-- a kind this closure claims and never decides — misspelled, deleted or
-- unexercised all read as "the closure is smaller than it says"
completion_decided[code](K)    :- completes_abruptly[code](S), ast_node[code](S, K, _, _).
completion_unreached[audit](K) :- completion_kind(K), ast_node[code](_, K, _, _),
                                  not completion_decided[code](K).

-- Seven kinds can hold a `return` and still complete normally, declared rather
-- than left to fall through the block arm: a loop body may run zero times (its
-- condition); `do_while_statement` and `switch` need the completion REASON — a
-- `continue` or `break` completes the loop or switch normally — which this
-- relation does not carry; a `try`'s handler may swallow the transfer and
-- `finally` may override it.
edb(completion_deferred).
completion_deferred(while_statement,    a_condition_this_layer_cannot_decide).
completion_deferred(for_statement,      a_condition_this_layer_cannot_decide).
completion_deferred(for_in_statement,   a_condition_this_layer_cannot_decide).
completion_deferred(for_of_statement,   a_condition_this_layer_cannot_decide).
completion_deferred(do_while_statement, a_completion_reason_this_relation_does_not_carry).
completion_deferred(switch_statement,   a_completion_reason_this_relation_does_not_carry).
completion_deferred(try_statement,      a_handler_that_may_swallow_the_transfer).

completion_known(K) :- completion_kind(K).
completion_known(K) :- completion_deferred(K, _).
completion_known(K) :- abrupt_kind(K).

-- The gate: a statement kind holding an abrupt completion inside its own
-- region, in a statement list, in neither table — silently read as "completes
-- normally". The function boundary is the precision clause:
-- `const f = () => { return 1 }` is a declaration holding a return. Seeded from
-- the candidate and the boundary asked of it; the other order crossed every
-- function with every abrupt completion, 8.8 s to 21.7 s for one rule.
completion_outer[code](P, S)      :- completes_abruptly[code](S), ast_within[code](P, S),
                                     ast_node[code](P, K, _, _), not completion_known(K),
                                     not fn_node_v[flow](P),
                                     stmt_seq_field(F), ast_child[code](_, F, _, P).
completion_fn_between[code](P, S) :- completion_outer[code](P, S), ast_within[code](P, G),
                                     fn_node_v[flow](G), ast_within[code](G, S).
completion_unaccounted[audit](K)  :- completion_outer[code](P, S), ast_node[code](P, K, _, _),
                                     not completion_fn_between[code](P, S).

-- =========================================================================
-- 3. A CALL IS AN EXIT. Decidable from syntax alone: no `return` anywhere in
-- the body and a `throw` at its top level. The error direction is safe: a
-- function that always throws but has a return somewhere is simply not named.
-- The return statement leads: leading with `fn_node(F)` enumerated every
-- return against every function — 94 % of the layer's read cost, measured on
-- two corpora with two instruments.
has_return[code](F)    :- ast_node[code](R, return_statement, _, _),
                          ast_within[code](F, R), fn_node[code](F).
top_throw[code](F)     :- fn_node[code](F), ast_child[code](F, body, 0, B),
                          ast_child[code](B, body, _, S),
                          ast_node[code](S, throw_statement, _, _).
always_throws[code](F) :- top_throw[code](F), not has_return[code](F).

throwing_call[code](C) :- call_site[code](C, _), resolves[code](C, F),
                          always_throws[code](F).

-- AN ACCESSOR IS A CALL WEARING A READ'S SYNTAX: `o.p` on a getter transfers
-- control; what the getter returns is a different question, not answered here.
-- `accessor_of` binds Obj and Key first, then `selects(N, Key)` before
-- `member_node_v(N)`, or every accessor is laid beside every member read. A
-- private accessor needs no receiver literal: `private_binds` decided both
-- halves. A getter that always throws makes the READ an exit. The call graph
-- has to say so too: `resolves`, and the read must be a `site` or the edge has
-- no caller — declaring `member_expression` a transfer kind would make every
-- property read in the corpus a site.
edb(accessor_kind).
accessor_kind("get").
accessor_kind("set").

accessor_of[flow](Obj, Key, M) :- member_value[flow](Obj, Key, M),
                                  accessor_kind(K), ast_attr[code](M, kind, K).
accessor_read[code](N, M) :- accessor_of[flow](Obj, Key, M),
                             selects[flow](N, Key), member_node_v[flow](N),
                             ast_child[code](N, object, 0, O),
                             may_be_node[flow](O, Obj).
accessor_read[code](N, M) :- private_binds[code](N, M),
                             accessor_kind(K), ast_attr[code](M, kind, K).

throwing_call[code](N) :- accessor_read[code](N, M), always_throws[code](M).

resolves[code](N, M) :- accessor_read[code](N, M).
site[code](N) :- accessor_read[code](N, _).

-- =========================================================================
-- 4. A DESTRUCTURING FORM HIDES A CALL. Measured on V8's own stack:
-- `{ notch } = dial` runs `get notch`; a rest runs every getter the pattern
-- did not take; an object spread runs every getter (it overrides a key and
-- still READS it, so no exclusion); an array pattern, an array spread and a
-- spread argument run `[Symbol.iterator]` and `next`; a plain array or object
-- runs no user code. THE RECEIVER DECIDES, not the syntax — which is what
-- `accessor_of` and `member_value(Obj, "iterator", M)` already decide. Only
-- the declarator form: a pattern in a parameter reads the argument, a
-- call-site question, so it is silent here rather than wrong.
pattern_source[code](P, Init) :- ast_node[code](D, variable_declarator, _, _),
                                 ast_child[code](D, id, 0, P),
                                 ast_child[code](D, init, 0, Init).

pattern_accessor[code](P, M) :- ast_node[code](P, object_pattern, _, _),
                                pattern_source[code](P, Init), may_be_node[flow](Init, Obj),
                                pattern_takes[code](P, Key), accessor_of[flow](Obj, Key, M).
pattern_accessor[code](R, M) :- rest_in_pattern[code](D, R, _),
                                ast_child[code](D, id, 0, P),
                                ast_child[code](D, init, 0, Init), may_be_node[flow](Init, Obj),
                                accessor_of[flow](Obj, Key, M), not pattern_takes[code](P, Key).
pattern_accessor[code](S, M) :- ast_node[code](O, object_expression, _, _),
                                ast_child[code](O, properties, _, S),
                                ast_node[code](S, spread_element, _, _),
                                ast_child[code](S, argument, 0, A), may_be_node[flow](A, Obj),
                                accessor_of[flow](Obj, Key, M).

-- `spread_element` is one kind doing two things: in `properties` it copies
-- keys, in `elements`/`arguments` it exhausts an iterator — keyed by FIELD.
edb(spread_iterable_field).
spread_iterable_field(elements).
spread_iterable_field(arguments).
spread_iterated[code](S) :- ast_node[code](S, spread_element, _, _),
                            spread_iterable_field(F), ast_child[code](_, F, _, S).

pattern_iterates[code](P, M) :- ast_node[code](P, array_pattern, _, _),
                                pattern_source[code](P, Init), may_be_node[flow](Init, Obj),
                                member_value[flow](Obj, "iterator", M), fn_node[code](M).
pattern_iterates[code](S, M) :- spread_iterated[code](S),
                                ast_child[code](S, argument, 0, A), may_be_node[flow](A, Obj),
                                member_value[flow](Obj, "iterator", M), fn_node[code](M).

-- The two sides reach the call graph differently. An iterable position has one
-- `[Symbol.iterator]` per receiver, so two answers are two candidate receivers
-- -> `resolves`. An object position runs one getter PER KEY, so a rest over two
-- getters is two true calls at one node -> `calls` directly, or
-- `ambiguous_call[audit]` would read a correct model as an over-approximation.
-- `site` on both sides: `nearest_fn` ranges over sites, and a `resolves` row at
-- a non-site draws no edge (six missing edges, measured). `pattern_next` is a
-- relation so the effect layer can name the callee it drops
-- (`w_effect_reads_only_what_resolves`).
site[code](N)          :- pattern_accessor[code](N, _).
calls[code](Caller, M) :- pattern_accessor[code](N, M), nearest_fn[code](Caller, N).
calls[code](R, M)      :- pattern_accessor[code](N, M), top_call[code](N, R).

site[code](N)          :- pattern_iterates[code](N, _).
resolves[code](N, M)   :- pattern_iterates[code](N, M).
pattern_next[code](X, Next) :- pattern_iterates[code](X, M),
                               returns[flow](M, E), may_be_node[flow](E, IterObj),
                               member_value[flow](IterObj, "next", V),
                               may_be_node[flow](V, Next), fn_node[code](Next).
calls[code](Caller, Next) :- pattern_next[code](X, Next), nearest_fn[code](Caller, X).

-- =========================================================================
-- 5. THE SOURCE DECIDES, SO COUNT THE SOURCES. Every position that runs a
-- protocol, by mechanism, and five answers that partition them: the rule
-- fired (user code); traced to something owning no such member, so the
-- language's own iterator or prototype runs — a positive statement that rests
-- on the transfer rules being right; a primitive; untraced — the frontier,
-- named rather than seeded, since seeding would put every plain array on it;
-- unsourced — a parameter pattern, which `pattern_source` does not cover.
-- `hidden_call_unaccounted` is the identity. `hidden_call_off_table` checks
-- the hand-written mechanism column against `transfer_mechanism`; it is blind
-- to `spread_element`, which carries both mechanisms — mutant d9 reads the
-- edges instead.
hidden_call_pos[code](N, accessor_call) :- ast_node[code](N, object_pattern, _, _).
hidden_call_pos[code](R, accessor_call) :- ast_node[code](R, rest_element, _, _),
                                           ast_node[code](P, object_pattern, _, _),
                                           ast_child[code](P, properties, _, R).
hidden_call_pos[code](S, accessor_call) :- ast_node[code](O, object_expression, _, _),
                                           ast_child[code](O, properties, _, S),
                                           ast_node[code](S, spread_element, _, _).
hidden_call_pos[code](N, iterator_call) :- ast_node[code](N, array_pattern, _, _).
hidden_call_pos[code](S, iterator_call) :- spread_iterated[code](S).
hidden_call_pos[code](X, iterator_call) :- ast_node[code](X, for_of_statement, _, _).

hidden_call_src[code](P, Init) :- ast_node[code](P, object_pattern, _, _),
                                  pattern_source[code](P, Init).
hidden_call_src[code](P, Init) :- ast_node[code](P, array_pattern, _, _),
                                  pattern_source[code](P, Init).
hidden_call_src[code](R, Init) :- rest_in_pattern[code](D, R, _),
                                  ast_child[code](D, init, 0, Init).
hidden_call_src[code](S, A)    :- ast_node[code](S, spread_element, _, _),
                                  hidden_call_pos[code](S, _),
                                  ast_child[code](S, argument, 0, A).
hidden_call_src[code](X, R)    :- ast_node[code](X, for_of_statement, _, _),
                                  ast_child[code](X, right, 0, R).

hidden_call_user[flow](N, M) :- pattern_accessor[code](N, M).
hidden_call_user[flow](N, M) :- pattern_iterates[code](N, M).
hidden_call_user[flow](X, M) :- for_of_iterates[code](X, M).
hidden_call_fires[code](N)   :- hidden_call_user[flow](N, _).

hidden_call_builtin[flow](N, O) :- hidden_call_src[code](N, Src),
                                   may_be_node[flow](Src, O),
                                   not hidden_call_fires[code](N).
hidden_call_primitive[flow](N, V) :- hidden_call_src[code](N, Src),
                                     may_be_lit[flow](Src, V),
                                     not hidden_call_traced[code](N).
hidden_call_traced[code](N)       :- hidden_call_src[code](N, Src), may_be_node[flow](Src, _).
hidden_call_untraced[flow](N, Src) :- hidden_call_src[code](N, Src),
                                      not may_be_lit[flow](Src, _),
                                      not may_be_node[flow](Src, _).
hidden_call_sourced[code](N)       :- hidden_call_src[code](N, _).
hidden_call_unsourced[flow](N, K)  :- hidden_call_pos[code](N, _),
                                      not hidden_call_sourced[code](N),
                                      ast_node[code](N, K, _, _).

hidden_call_accounted[audit](N)   :- hidden_call_fires[code](N).
hidden_call_accounted[audit](N)   :- hidden_call_builtin[flow](N, _).
hidden_call_accounted[audit](N)   :- hidden_call_primitive[flow](N, _).
hidden_call_accounted[audit](N)   :- hidden_call_untraced[flow](N, _).
hidden_call_accounted[audit](N)   :- hidden_call_unsourced[flow](N, _).
hidden_call_unaccounted[audit](N) :- hidden_call_pos[code](N, _),
                                     not hidden_call_accounted[audit](N).

hidden_call_off_table[audit](K, M) :- hidden_call_pos[code](N, M),
                                      ast_node[code](N, K, _, _),
                                      not transfer_mechanism(K, M).

-- =========================================================================
-- 6. WHAT PROPAGATES. A try catches what runs in ITS OWN function:
-- `try { const f = () => g() } catch {}` has `g()` inside the block textually
-- and it runs later, elsewhere. A throw in a HANDLER is not caught by its own
-- clause: `block`, not the whole try.
try_of[code](TS, F)        :- ast_node[code](TS, try_statement, _, _), nearest_v[flow](F, TS).
in_try_block[code](TS, N)  :- ast_node[code](TS, try_statement, _, _),
                              ast_child[code](TS, block, 0, B), ast_within[code](B, N).

-- A try discharges through its `handler`; a finalizer alone catches nothing —
-- `finalizer`'s absence from this table is the statement. Repaired 2026-09-11
-- with `leaky` in alpha.mjs as the site
-- (f_a_try_with_no_handler_catches_nothing_and_caught_here_says_it_does).
edb(catches_via).
catches_via(try_statement, handler).
try_catches[code](TS)      :- catches_via(K, Field), ast_node[code](TS, K, _, _),
                              ast_child[code](TS, Field, 0, _).
caught_here[code](N)       :- in_try_block[code](TS, N), try_of[code](TS, F),
                              nearest_v[flow](F, N), try_catches[code](TS).

throws_outright[code](F) :- ast_node[code](T, throw_statement, _, _),
                            nearest_v[flow](F, T), not caught_here[code](T).

-- `may_throw` is a handful of rows and binds G, so `resolves` is probed by
-- callee. The value travels with the throw: `thrown_by`, `caught_value`.
may_throw[code](F) :- throws_outright[code](F).
may_throw[code](F) :- may_throw[code](G), resolves[code](C, G), nearest_v[flow](F, C),
                      not caught_here[code](C).

thrown_by[flow](F, V) :- ast_node[code](T, throw_statement, _, _), nearest_v[flow](F, T),
                         not caught_here[code](T), ast_child[code](T, argument, 0, V).
thrown_by[flow](F, V) :- thrown_by[flow](G, V), resolves[code](C, G),
                         nearest_v[flow](F, C), not caught_here[code](C).
caught_value[flow](P, V) :- catch_of[flow](T, H), catch_param[flow](H, P),
                            try_block[flow](T, B), ast_within[code](B, C),
                            resolves[code](C, G), thrown_by[flow](G, V).

-- A throwing call is an abrupt transfer for every list out to the `try` that
-- catches it — code after the try runs precisely because the handler caught —
-- and out to the FUNCTION boundary: without `ast_within(G, S)` the walk
-- reached the module's own list and everything after `class Lit` was
-- unreachable (`after_abrupt` 3 -> 37).
try_stops[code](C, T) :- throwing_call[code](C), ast_node[code](T, try_statement, _, _),
                         ast_within[code](T, C).
try_stops[code](C, S) :- try_stops[code](C, T), ast_within[code](S, T).

abrupt_at[code](B, F, I) :- throwing_call[code](C), nearest_v[flow](G, C),
                            ast_within[code](G, S), ast_within[code](S, C),
                            stmt_seq_field(F), ast_child[code](B, F, I, S),
                            not try_stops[code](C, S).

-- After an abrupt transfer the rest NEVER runs; `guarded` says MAY, on purpose.
-- A suspension is a may and belongs here more exactly.
guarded[code](S) :- after_abrupt[code](S).
guarded[code](N) :- after_abrupt[code](S), ast_within[code](S, N).
guarded[code](S) :- after_suspend[code](S).
guarded[code](N) :- after_suspend[code](S), ast_within[code](S, N).

-- A function every one of whose sites is guarded may never be entered.
-- `may_not_run` is LOCAL, one level; the transitive question is reachability.
guarded_call[code](C)      :- call_site[code](C, _), guarded[code](C).
reached_unguarded[code](F) :- resolves[code](C, F), not guarded[code](C).
may_not_run[code](F)       :- resolves[code](_, F), not reached_unguarded[code](F).

-- =========================================================================
-- 7. TRANSITIVE REACHABILITY needs an ENTRY POINT: without one the question is
-- unstratified (`live`/`dead` through negation; the kernel refused it). A
-- module's export surface is its entry surface — a fact about the language.
-- Containment, not paths: `export function`, `export const g = () =>` and
-- `export default function` are three shapes. `not in_fn` keeps a closure
-- inside an exported function out and a method of an exported class in.
-- `export { f as g }` contains no function, so the second arm joins
-- `export_local`, which already excludes re-exports and type-only exports.
-- `export_all_declaration` introduces no local entry.
edb(export_kind).
export_kind(export_named_declaration).
export_kind(export_default_declaration).

fn_node[code](F) :- fn_name[code](F, _).
in_fn[code](N)   :- nearest_v[flow](_, N).

exported_fn[code](F) :- export_kind(K), ast_node[code](E, K, _, _),
                        ast_within[code](E, F), fn_node[code](F), not in_fn[code](F).

exported_fn[code](F) :- export_local[code](L, _, _), may_be_node[flow](L, F),
                        fn_node[code](F), not in_fn[code](F).

entry_point[code](F) :- exported_fn[code](F).

-- ...and a top-level call runs on import, with no enclosing function.
reachable[code](F) :- entry_point[code](F).
reachable[code](F) :- resolves[code](C, F), not guarded[code](C), not in_fn[code](C).
reachable[code](F) :- reachable[code](G), nearest_v[flow](G, C), resolves[code](C, F),
                      not guarded[code](C).

may_not_be_reached[code](F) :- resolves[code](_, F), not reachable[code](F).

-- the typo hole again: a misspelling shrinks the entry surface and reports
-- live functions as maybe-dead, the dangerous direction
export_kind_unseen[audit](K) :- export_kind(K), not ast_node[code](_, K, _, _).

-- A file with functions and no entry point reports every function dead — an
-- artefact of the seed, named. `has_entry` is [code]: a denominator, not a gate.
has_entry[code](File)       :- entry_point[code](F), ast_node[code](F, _, File, _).
no_entry_point[audit](File) :- fn_node[code](F), ast_node[code](F, _, File, _),
                               not has_entry[code](File).

-- =========================================================================
-- 8. THE GATES. Every kind that transfers control carries a MECHANISM, and
-- mechanisms are not one bucket: `skip_arm`; `short_circuit` (`a?.b()` guards
-- the site itself, not a child); `suspend`; `abrupt`; `accessor_call`;
-- `loop_at_least_once` (`do_while_statement`, waived: its body always runs);
-- `label_boundary` (a label RECEIVES a transfer); `definition_time_call` (a
-- decorator runs once, at definition); `per_construction` (a field
-- initialiser); `iterator_call`. `spread_element` and `for_of_statement` carry
-- two — one row per (kind, mechanism).
edb(transfer_mechanism).
transfer_mechanism(if_statement,               skip_arm).
transfer_mechanism(conditional_expression,     skip_arm).
transfer_mechanism(logical_expression,         skip_arm).
transfer_mechanism(for_of_statement,           skip_arm).
transfer_mechanism(optional_call_expression,   short_circuit).
transfer_mechanism(optional_member_expression, short_circuit).
transfer_mechanism(member_expression,          accessor_call).
transfer_mechanism(await_expression,           suspend).
transfer_mechanism(yield_expression,           suspend).
transfer_mechanism(return_statement,           abrupt).
transfer_mechanism(throw_statement,            abrupt).
transfer_mechanism(break_statement,            abrupt).
transfer_mechanism(continue_statement,         abrupt).
transfer_mechanism(while_statement,            skip_arm).
transfer_mechanism(for_statement,              skip_arm).
transfer_mechanism(for_in_statement,           skip_arm).
transfer_mechanism(switch_statement,           skip_arm).
transfer_mechanism(switch_case,                skip_arm).
transfer_mechanism(try_statement,              skip_arm).
transfer_mechanism(catch_clause,               skip_arm).
transfer_mechanism(do_while_statement,         loop_at_least_once).
transfer_mechanism(assignment_pattern,         skip_arm).
transfer_mechanism(labeled_statement,          label_boundary).
transfer_mechanism(decorator,                  definition_time_call).
transfer_mechanism(class_property,             per_construction).
transfer_mechanism(class_private_property,     per_construction).
transfer_mechanism(object_pattern,             accessor_call).
transfer_mechanism(rest_element,               accessor_call).
transfer_mechanism(spread_element,             accessor_call).
transfer_mechanism(array_pattern,              iterator_call).
transfer_mechanism(spread_element,             iterator_call).
transfer_mechanism(for_of_statement,           iterator_call).

-- Three states, not two: modelled, waived with a reason, or open with an owner.
-- `mechanism_open` is empty since 2026-09-06 and kept: the next mechanism that
-- is neither needs somewhere honest to sit, and an audit red on an honest tree
-- gets switched off.
edb(mechanism_modelled).
mechanism_modelled(skip_arm).
mechanism_modelled(short_circuit).
mechanism_modelled(accessor_call).
mechanism_modelled(abrupt).
mechanism_modelled(suspend).
mechanism_modelled(label_boundary).
mechanism_modelled(definition_time_call).
mechanism_modelled(per_construction).
mechanism_modelled(iterator_call).
edb(mechanism_waived).
mechanism_waived(loop_at_least_once, a_body_that_always_runs_guards_nothing).

edb(mechanism_open).

mechanism_known(M) :- mechanism_modelled(M).
mechanism_known(M) :- mechanism_waived(M, _).
mechanism_known(M) :- mechanism_open(M, _).

mechanism_unanswered[audit](M) :- transfer_mechanism(_, M), not mechanism_known(M).

-- A kind carrying a modelled mechanism that no rule reaches. Derived from
-- `transfer_mechanism` where a mechanism has one door (suspend, label, field,
-- iterator), so claiming the mechanism without the rule reddens
-- `guard_unmodelled`. Named by hand where the door is another relation:
-- `catch_clause` is a try's arm, `switch_statement` selects a case,
-- `member_expression` and `decorator` transfer INTO a callee, and the three
-- object-key kinds go through `pattern_accessor` — one per kind rather than
-- derived, or the derived line would cover `member_expression` and silence
-- its mutant.
guard_named[code](K)       :- guard_kind(K, _).
guard_named[code](K)       :- short_circuit_kind(K).
guard_named[code](K)       :- abrupt_kind(K).
guard_named[code](K)       :- transfer_mechanism(K, suspend).
guard_named[code](K)       :- transfer_mechanism(K, label_boundary).
guard_named[code](K)       :- transfer_mechanism(K, per_construction).
guard_named[code](catch_clause).
guard_named[code](switch_statement).
guard_named[code](member_expression).
guard_named[code](decorator).
guard_named[code](object_pattern).
guard_named[code](rest_element).
guard_named[code](spread_element).
guard_named[code](K)       :- transfer_mechanism(K, iterator_call).
guard_unmodelled[audit](K) :- transfer_mechanism(K, M), mechanism_modelled(M),
                              ast_node[code](_, K, _, _), not guard_named[code](K).

-- SHORT-CIRCUIT: `a?.b()` stops the whole chain, so the site and everything
-- further along it is conditional.
edb(short_circuit_kind).
short_circuit_kind(optional_call_expression).
short_circuit_kind(optional_member_expression).

guarded[code](N) :- short_circuit_kind(K), ast_node[code](N, K, _, _).
guarded[code](N) :- short_circuit_kind(K), ast_node[code](P, K, _, _),
                    ast_within[code](P, N).

-- an arm declared for a field the scanner never emits under that kind: a typo
-- makes the guarded set quietly smaller
guard_arm_seen[code](K, Field) :- guard_kind(K, Field), ast_node[code](P, K, _, _),
                                  ast_child[code](P, Field, 0, _).
guard_arm_unseen[audit](K, F)  :- guard_kind(K, F), ast_node[code](_, K, _, _),
                                  not guard_arm_seen[code](K, F).

-- a guarded site at a coordinate, for the report and the runtime comparison
guarded_at[code](File, Line) :- guarded_call[code](C), ast_node[code](C, _, File, Line).

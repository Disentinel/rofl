-- rules/depends.rofl — WHAT BREAKS IF I DELETE THIS FILE? The facts are
-- scanners/depends.ts; the reasoning is here so every row has a `why`.
--
-- THE DIRECTION IS THE THING TO GET RIGHT. `edge(A, B, _)` means A NEEDS B,
-- so the blast radius of deleting B is every A that reaches B — the closure
-- taken UPSTREAM. Downstream is a different question, answered apart.
--
-- Two models were wrong before this one. The full closure over 677 artifacts
-- and 3208 edges died at 88 472 rows against the engine's wall: nobody asks
-- "what is the closure", they ask "what breaks if I delete THIS", so the walk
-- is seeded from `target[dep](X)`, one fact from the caller, and is linear in
-- the reachable set. Then the seeded walk answered 322 and 411 for three
-- unrelated files, because `doc_ref` and `ledger_ref` run both ways through
-- prose and make the graph one component. A deletion breaks CODE or makes
-- PROSE wrong, and those are different verdicts.

edb(target).

-- `generates` is deliberately NOT a code edge: a generator does not break
-- when its output is deleted, it recreates it. With it in the closure
-- test/rule-shape.test.ts appeared in the blast radius of the pack it was
-- written to re-derive from source. The edge was real and its direction was
-- wrong.
code_edge[dep](A, B) :- edge[dep](A, B, ts_import).
code_edge[dep](A, B) :- edge[dep](A, B, reads_path).
code_edge[dep](A, B) :- edge[dep](A, B, npm_script).
code_edge[dep](A, B) :- edge[dep](A, B, ci_step).

regenerates[dep](G, P) :- edge[dep](G, P, generates).

-- =========================================================================
-- 1. WHAT BREAKS: backward closure over code edges — the build, the gates,
-- the generators. The number a refactor is judged by.
blast[dep](D, T) :- target[dep](T), code_edge[dep](D, T).
blast[dep](D, T) :- blast[dep](M, T), code_edge[dep](D, M).

-- 2. WHAT GOES STALE: one hop, not a closure. Prose is not transitive, and
-- treating it so is what produced the hairball.
stale_prose[dep](D, T) :- target[dep](T), edge[dep](D, T, doc_ref).
stale_prose[dep](D, T) :- target[dep](T), edge[dep](D, T, ledger_ref).

-- 3. WHAT IS LEFT BEHIND: forward over code edges, reached only through the
-- target, so dead weight rather than a broken build.
downstream[dep](X, T) :- target[dep](T), code_edge[dep](T, X).
downstream[dep](X, T) :- downstream[dep](M, T), code_edge[dep](M, X).

-- =========================================================================
-- WHAT NOTHING NEEDS — not "safe to delete": an entry point is an orphan by
-- construction, and so is a document nobody cites.
depended_on[dep](B) :- edge[dep](_, B, _).
orphan[dep](X) :- artifact[dep](X, _), not depended_on[dep](X).

-- WHAT ONLY PROSE NEEDS, the category that matters for a cleanup: deleting it
-- breaks no code, only makes some prose wrong, a text edit and not a
-- refactor. `generates` counts here: a generator is a writer, and it does
-- mean somebody owns the file.
code_needs[dep](B) :- edge[dep](_, B, ts_import).
code_needs[dep](B) :- edge[dep](_, B, reads_path).
code_needs[dep](B) :- edge[dep](_, B, npm_script).
code_needs[dep](B) :- edge[dep](_, B, ci_step).
code_needs[dep](B) :- edge[dep](_, B, generates).

only_prose[dep](X) :- depended_on[dep](X), not code_needs[dep](X).

-- =========================================================================
-- WHAT THE REFEREE RUNS. A gate CI does not run runs when somebody remembers
-- (scripts/witness_check.ts exited non-zero on a stale witness since the day
-- it was written and nothing ran it). The glob is seeded into the CLOSURE, not the
-- verdict, so a helper a test imports is reached too; whether the referee
-- runs the suite at all is a proposition, and `ci_suite_runs` is the nullary
-- head `wants_nullary[audit]` in rules/nullary.rofl named off the reflection.
ci_runs[dep](X) :- edge[dep](W, X, ci_step), artifact[dep](W, yml).
ci_runs[dep](X) :- ci_runs[dep](Y), edge[dep](Y, X, _).
ci_suite_runs[dep]() :- edge[dep](W, "npm:test", ci_step), artifact[dep](W, yml).
ci_runs[dep](T) :- test_file[dep](T), ci_suite_runs[dep]().

script[dep](S) :- artifact[dep](S, script).
unrun_gate[dep](S) :- script[dep](S), not ci_runs[dep](S).

-- =========================================================================
-- GENERATED PACKS. A pack with a generator and no regeneration gate is the
-- defect the ledger records twice; here it is derivable.
generated[dep](P) :- edge[dep](_, P, generates).
regenerated_by_test[dep](P) :- edge[dep](T, P, reads_path), test_file[dep](T).

-- `npm test` runs `test/*.test.ts`, a glob no scanner expands, so a test
-- file is identified by where it lives — the one place this model
-- substitutes a convention for a measurement. The directory is NOT the glob:
-- test/cleanliness.check.ts is deliberately held out of CI. And the
-- destructor must produce into a variable: `str_pre(T, "/") = "test"` is a
-- relational literal over a relation nothing populates, and `test_file` was
-- silently empty (the same defect as in rules/cleanliness.rofl).
test_file[dep](T) :- artifact[dep](T, ts), D is str_pre(T, "/"), D = "test",
                     N is str_segs(T, ".test.ts"), N = 2.

-- a generated pack no test reads back is one nothing can find stale.
-- No counts pinned here: the pack grows with the tree
-- (`f_a_pin_that_moves_with_the_corpus_is_measuring_the_corpus`);
-- test/depends.test.ts asserts identities and named sets.
ungated_pack[audit](P) :- generated[dep](P), not regenerated_by_test[dep](P).

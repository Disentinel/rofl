-- books/chess/book.rofl — the book of two seeds, `chess exists` and `vadim
-- asks`, the first book grown under skill 2.1: the asker is an entity, his
-- question is a fact, his task is what the crawl is for, and every text
-- that answers has its own volume.

authority(wiki_en, ontocrawler_2).   -- en.wikipedia 'Chess'
authority(wiki_ru, ontocrawler_2).   -- ru.wikipedia 'Шахматы'
authority(fide, ontocrawler_2).      -- FIDE Laws of Chess, edition 2023

-- @who ontocrawler_2
seed(chess).

-- ======================================================================
-- round 0 — the second seed. The asker's question, verbatim, as a fact.
-- Everything else about the asker comes from asking him.
-- ======================================================================
-- @who vadim
question_ext(q_chess, vadim, 0).
premise(q_chess, chess).
edge[vadim](a1, describes, vadim, "Давай попробуем третий домен какой нибудь равноудалённый от первых двух уже по новому флоу").
evidence(a1, src_holder_session, "vadim, 2026-09-21, the message that opened this book"). landed(a1, 0). depth(a1, 1). classified(a1, confirmed).
-- The task, the decision and what the answer turns into are the ASKER'S to
-- say, not the crawler's to read off a message. Interview pending; until
-- it lands, requires(?, q_chess), depends_on(?, answer), values(vadim, ?)
-- stay open and escalate to him. (A draft that inferred them was written
-- here on 2026-09-21 and withdrawn the same hour: skill 2.1 says put the
-- archetypes to the person.)

-- @who ontocrawler_2
-- the asker's kindless questions, from the session and from his graph
edge[book](a5, recorded_in, vadim, src_holder_session).
evidence(a5, src_holder_session, "this session, 2026-09-18 to 2026-09-21"). landed(a5, 1). depth(a5, 1). classified(a5, confirmed).
edge[book](a6, recorded_in, vadim, src_enox).
evidence(a6, src_enox, "enox.dev/personal/vadim_r, the graph the crawler read in the first two books"). landed(a6, 1). depth(a6, 1). classified(a6, confirmed).
edge[book](a7, is_a, vadim, owner).
evidence(a7, src_holder_session, "docs/the-target.md 'set by the owner'; Disentinel/rofl and Disentinel/grafema; every steering fact in three books is his"). landed(a7, 1). depth(a7, 1). classified(a7, confirmed).
asked(recorded_in, vadim, out, src_holder_session, 1). asked(is_a, vadim, out, src_holder_session, 1). asked(describes, vadim, out, src_holder_session, 1).

-- ======================================================================
-- round 1 — the seed's kindless questions, batched, one put to three
-- books; each book answers in its own volume. Whatever else a book said
-- while being asked is written too.
-- ======================================================================
put(1, src_wikipedia, "what is chess, in one sentence; what kind of thing; where is it recorded; what is it made of?").
put(1, src_fide, "same put, to the Laws' preface and Article 1").

edge[wiki_en](n1, describes, chess, "Chess is a board game for two players, played on a square board consisting of 64 squares arranged in an 8×8 grid.").
evidence(n1, src_wikipedia, "en.wikipedia.org/wiki/Chess, lead, fetched 2026-09-21"). landed(n1, 1). depth(n1, 1). classified(n1, confirmed).
edge[wiki_en](n2, is_a, chess, board_game).
evidence(n2, src_wikipedia, "en lead"). landed(n2, 1). depth(n2, 1). classified(n2, confirmed).
edge[wiki_ru](r1, describes, chess, "Шахматы — детерминированная игра с совершенной информацией, в которой два игрока поочерёдно перемещают фигуры на поле 8х8 клеток с целью поставить мат королю противника.").
evidence(r1, src_wikipedia, "ru.wikipedia.org/wiki/Шахматы, first paragraph, fetched 2026-09-21"). landed(r1, 1). depth(r1, 1). classified(r1, confirmed).
edge[wiki_ru](r2, is_a, chess, deterministic_perfect_information_game).
evidence(r2, src_wikipedia, "ru lead"). landed(r2, 1). depth(r2, 1). classified(r2, confirmed).
edge[wiki_ru](r3, is_a, chess, sport).
evidence(r3, src_wikipedia, "ru 'интеллектуальный вид спорта'; section 'Шахматы как вид спорта'"). landed(r3, 1). depth(r3, 1). classified(r3, confirmed).
edge[wiki_ru](r4, is_a, chess, art).
evidence(r4, src_wikipedia, "ru section 'Шахматы как искусство'"). landed(r4, 1). depth(r4, 1). classified(r4, confirmed).
context(r2, "en says 'board game', ru says 'deterministic game with perfect information' and then sport and art: the English article classifies by the object, the Russian by the theory and by the institutions around it; ru explicitly does not call it a science").
edge[fide](f1, describes, chess, "The game of chess is played between two opponents who move their pieces on a square board").
evidence(f1, src_fide, "FIDE Laws of Chess, Article 1.1, effective 2023-01-01"). landed(f1, 1). depth(f1, 1). classified(f1, confirmed).
not_found(is_a, chess, out, src_fide, 1).   -- the Laws say how it is played and what wins; they never say what kind of thing it is
context(f1, "the Laws' preface: they 'cannot address all possible situations' and assume arbiters of 'necessary competence, sound judgement and absolute objectivity' - the rulebook names its own incompleteness and its holder in one paragraph").

edge[book](n3, recorded_in, chess, src_wikipedia).
evidence(n3, src_wikipedia, "en and ru articles; en sections Rules / Notation / Gameplay / Problems and studies / Online / Computer chess / Organized competition / History / Literature"). landed(n3, 1). depth(n3, 2). classified(n3, confirmed).
edge[book](n4, recorded_in, chess, src_fide).
evidence(n4, src_fide, "handbook.fide.com, Laws of Chess E.01, edition 2023"). evidence(n4, src_wikipedia, "en: 'FIDE publishes the official rules in its Handbook'; ru: ФИДЕ, 1924"). landed(n4, 1). depth(n4, 2). classified(n4, confirmed).
edge[book](n5, recorded_in, chess, src_notation_and_databases).
evidence(n5, src_wikipedia, "en 'Notation': algebraic notation, PGN files, databases; FIDE rating lists"). landed(n5, 1). depth(n5, 1). classified(n5, confirmed).
context(n5, "a source that is not a text about chess but a record OF chess: every game ever notated. The primary artifact in the skill's trust order, and it is not an encyclopedia").
edge[book](n6, recorded_in, chess, src_london_protocol_1922).
evidence(n6, src_wikipedia, "ru: Лондонский протокол 1922"). landed(n6, 1). depth(n6, 1). classified(n6, serendipitous).

-- what the books said while being asked something else: the pieces (en),
-- each with its sentence; the predecessors (en); the objective (fide 1.4)
edge[wiki_en](n7, decomposes_into, chess, king).
evidence(n7, src_wikipedia, "en 'Rules'"). landed(n7, 1). depth(n7, 1). classified(n7, confirmed).
edge[wiki_en](n8, describes, king, "moves one square in any direction").
evidence(n8, src_wikipedia, "en 'Rules'"). landed(n8, 1). depth(n8, 1). classified(n8, confirmed).
edge[wiki_en](n9, decomposes_into, chess, rook).
evidence(n9, src_wikipedia, "en"). landed(n9, 1). depth(n9, 1). classified(n9, confirmed).
edge[wiki_en](n10, describes, rook, "can move any number of squares along a rank or file").
evidence(n10, src_wikipedia, "en"). landed(n10, 1). depth(n10, 1). classified(n10, confirmed).
edge[wiki_en](n11, decomposes_into, chess, bishop).
evidence(n11, src_wikipedia, "en"). landed(n11, 1). depth(n11, 1). classified(n11, confirmed).
edge[wiki_en](n12, describes, bishop, "can move any number of squares diagonally").
evidence(n12, src_wikipedia, "en"). landed(n12, 1). depth(n12, 1). classified(n12, confirmed).
edge[wiki_en](n13, decomposes_into, chess, queen).
evidence(n13, src_wikipedia, "en"). landed(n13, 1). depth(n13, 1). classified(n13, confirmed).
edge[wiki_en](n14, describes, queen, "combines the power of a rook and bishop and can move any number of squares along a rank, file, or diagonal").
evidence(n14, src_wikipedia, "en"). landed(n14, 1). depth(n14, 1). classified(n14, confirmed).
edge[wiki_en](n15, decomposes_into, chess, knight).
evidence(n15, src_wikipedia, "en"). landed(n15, 1). depth(n15, 1). classified(n15, confirmed).
edge[wiki_en](n16, describes, knight, "moves to any of the closest squares that are not on the same rank, file, or diagonal").
evidence(n16, src_wikipedia, "en"). landed(n16, 1). depth(n16, 1). classified(n16, confirmed).
edge[wiki_en](n17, decomposes_into, chess, pawn).
evidence(n17, src_wikipedia, "en"). landed(n17, 1). depth(n17, 1). classified(n17, confirmed).
edge[wiki_en](n18, describes, pawn, "can move forward to the unoccupied square immediately in front of it on the same file").
evidence(n18, src_wikipedia, "en"). landed(n18, 1). depth(n18, 1). classified(n18, confirmed).
edge[wiki_en](n19, supersedes, chess, chaturanga).
evidence(n19, src_wikipedia, "en 'History': chaturanga, 7th-century India, as the recorded origin; janggi, xiangqi, shogi as related"). landed(n19, 1). depth(n19, 1). classified(n19, confirmed).
edge[fide](f2, invariant_over, chess, inv_checkmate_ends_the_game).
evidence(f2, src_fide, "art. 1.4, 1.4.1: the objective is to place the opponent's king under attack with no legal move; achieving this is checkmate and wins; exposing one's own king is forbidden"). landed(f2, 1). depth(f2, 1). classified(f2, confirmed).
edge[fide](f3, invariant_over, chess, inv_white_moves_first).
evidence(f3, src_fide, "art. 1.2"). landed(f3, 1). depth(f3, 1). classified(f3, confirmed).
edge[fide](f4, held_by, inv_checkmate_ends_the_game, fide_arbiters).
evidence(f4, src_fide, "preface: the Laws assume arbiters of competence, judgement and objectivity; a FIDE-rated game 'shall be played according to the FIDE Laws of Chess'"). landed(f4, 1). depth(f4, 1). classified(f4, confirmed).
edge[fide](f5, held_by, chess, fide).
evidence(f5, src_fide, "the Laws are FIDE's; 'a requirement for FIDE rating'"). evidence(f5, src_wikipedia, "en: FIDE publishes the official rules; ru: ФИДЕ 1924"). landed(f5, 1). depth(f5, 2). classified(f5, confirmed).
edge[book](f6, held_by, src_fide, fide).
evidence(f6, src_fide, "the handbook is FIDE's own"). landed(f6, 1). depth(f6, 1). classified(f6, confirmed).

asked(is_a, chess, out, src_wikipedia, 1). asked(describes, chess, out, src_wikipedia, 1). asked(recorded_in, chess, out, src_wikipedia, 1).
asked(is_a, chess, out, src_fide, 1). asked(describes, chess, out, src_fide, 1). asked(recorded_in, chess, out, src_fide, 1).

-- ======================================================================
-- round 2 — the asker's interview. Six questions derived from the table,
-- put to him on 2026-09-21; six answers, verbatim, in his volume. The
-- crawler's reading of each answer is a context row, never an edge.
-- ======================================================================
-- @who vadim
put(2, src_holder_session, "requires(?, q_chess): what task does this crawl serve? depends_on(?, answer): what decision waits on it? transforms(task, io(answer, ?)): what will the answer become? values(vadim, ?): what is failure, what is success? is_a(vadim, ?): who is asking? premise: is chess the domain?").

edge[vadim](a8, describes, task_test_method_on_self, "Проверить метод на себе ещё раз. Допустим я хочу изучить влияние шахмат на мыслительные способности, в том числе у детей.").
evidence(a8, src_holder_session, "answer 1"). landed(a8, 2). depth(a8, 1). classified(a8, confirmed).
edge[vadim](a9, requires, task_test_method_on_self, q_chess).
evidence(a9, src_holder_session, "answer 1"). landed(a9, 2). depth(a9, 1). classified(a9, confirmed).
question_ext(q_chess_cognition, vadim, 2).
premise(q_chess_cognition, influence_of_chess_on_thinking).
needs_ext(q_chess_cognition, depends_on, chess, in).
needs_ext(q_chess_cognition, transforms, chess_instruction, out).
context(a9, "answer 1 carries a second question inside the first: 'влияние шахмат на мыслительные способности, в том числе у детей'. It presupposes that such an influence exists; the book records the presupposition as a premise to RESOLVE, not as a fact, and asks the sources whether the entity exists before asking what it is").

edge[vadim](a10, describes, decision_skill_defects, "Жду новых недостатков скилла.").
evidence(a10, src_holder_session, "answer 2"). landed(a10, 2). depth(a10, 1). classified(a10, confirmed).
edge[vadim](a11, depends_on, decision_skill_defects, q_chess).
evidence(a11, src_holder_session, "answer 2"). landed(a11, 2). depth(a11, 1). classified(a11, confirmed).
edge[vadim](a12, describes, decision_chess_club_for_children, "Касательно самих шахмат - решу стоит ли детей на кружок вести.").
evidence(a12, src_holder_session, "answer 2"). landed(a12, 2). depth(a12, 1). classified(a12, confirmed).
edge[vadim](a13, depends_on, decision_chess_club_for_children, q_chess_cognition).
evidence(a13, src_holder_session, "answer 2"). landed(a13, 2). depth(a13, 1). classified(a13, confirmed).

edge[vadim](a14, transforms, task_test_method_on_self, io(book_of_chess, knowledge_crystal_of_chess)).
evidence(a14, src_holder_session, "answer 3: 'Кристалл знания чтобы об него спрашивать всякое и искать всякое структурно интересное про шахматы'"). landed(a14, 2). depth(a14, 1). classified(a14, unexpected).
context(a14, "'кристалл' here is the BOOK of chess as a thing to query, not the vocabulary pack books/crystals/ calls a crystal. One word, two things, and the two are the asker's and the executor's: an alias seam inside the project's own vocabulary, recorded here rather than resolved").

edge[vadim](a15, describes, vadim, "Мне сложно на это ответить. Провал прогона - ничего не вызовет мой интерес.").
evidence(a15, src_holder_session, "answer 4"). landed(a15, 2). depth(a15, 1). classified(a15, confirmed).
edge[vadim](a16, values, vadim, findings_that_provoke_interest).
evidence(a16, src_holder_session, "answer 4, read in the negative: failure is a run that provokes no interest"). landed(a16, 2). depth(a16, 1). classified(a16, confirmed).
context(a16, "the value is stated as its absence, and success is not stated at all: not_found below. It coincides with the skill's own ranking of classifications - unexpected above confirmed - so the book's priority and the asker's value point the same way, which is not something to assume and is the first time it has been checked").
not_found(values, vadim, out, src_holder_session, 2).   -- no positive criterion of success given; 'сложно ответить'

edge[vadim](a17, is_a, vadim, skill_owner).
evidence(a17, src_holder_session, "answer 5"). landed(a17, 2). depth(a17, 1). classified(a17, confirmed).
edge[vadim](a18, is_a, vadim, parent).
evidence(a18, src_holder_session, "answer 5"). landed(a18, 2). depth(a18, 1). classified(a18, confirmed).
edge[vadim](a19, is_a, vadim, researcher_of_ai_methods).
evidence(a19, src_holder_session, "answer 5"). landed(a19, 2). depth(a19, 1). classified(a19, confirmed).
context(a17, "three askers in one person, and the three decisions of answer 2 sort by them: the defect list is the skill owner's, the club is the parent's, the method is the researcher's. The per-asker projection the protocol provides for now has three askers to project by, all with one name").

edge[vadim](a20, describes, chess, "Ну допустим подходит, раз уж я на вопросы ответил, почему нет.").
evidence(a20, src_holder_session, "answer 6: the premise of q_chess confirmed, conditionally"). landed(a20, 2). depth(a20, 1). classified(a20, confirmed).
asked(requires, q_chess, in, src_holder_session, 2). asked(depends_on, q_chess, in, src_holder_session, 2).
asked(values, vadim, out, src_holder_session, 2). asked(is_a, vadim, out, src_holder_session, 2).

-- ======================================================================
-- round 3 — the asker's question: crawl(depends_on, ?, chess) and
-- transforms(chess_instruction, ?), put as "does chess instruction change
-- children's thinking, and by how much?" to the literature the premise
-- lives in. Europe PMC is the index; PubMed refused (cookies), OpenAlex
-- rate-limited, the EEF report 403, Elsevier a redirect. Each answering
-- text gets a volume; the one RCT is read through a citation, depth 1.
-- ======================================================================
authority(sala_gobet, ontocrawler_2).   -- Sala & Gobet, 2016-2023: the meta-analyses
authority(ioe, ontocrawler_2).          -- Institute of Education RCT, 2016 (Jerrim et al.), via citation
-- @who ontocrawler_2
put(3, src_europepmc, "chess instruction, children, cognitive or academic outcomes, meta-analysis or randomised trial").
put(3, src_wikipedia, "what does the Psychology section say about chess and intelligence, and about instruction effects on children?").
edge[book](n20, recorded_in, influence_of_chess_on_thinking, src_sala_gobet).
evidence(n20, src_europepmc, "Sala, Foley, Gobet 2017 Front Psychol 10.3389/fpsyg.2017.00238; Sala & Gobet 2017 Curr Dir Psychol Sci 10.1177/0963721417712760; Gobet & Sala 2023 Perspect Psychol Sci 10.1177/17456916221091830"). landed(n20, 3). depth(n20, 1). classified(n20, confirmed).
edge[book](n21, recorded_in, influence_of_chess_on_thinking, src_ioe_rct).
evidence(n21, src_sala_gobet, "the 2016 Institute of Education trial as cited in Sala, Foley, Gobet 2017; not fetched directly (EEF 403, Europe PMC does not index it)"). landed(n21, 3). depth(n21, 1). classified(n21, confirmed).
edge[book](n22, recorded_in, influence_of_chess_on_thinking, src_wikipedia).
evidence(n22, src_wikipedia, "en 'Psychology' (section 44 via the API; the page fetch truncated before it)"). landed(n22, 3). depth(n22, 1). classified(n22, confirmed).
edge[book](n23, held_by, src_sala_gobet, sala_and_gobet).
evidence(n23, src_europepmc, "authors of all three"). landed(n23, 3). depth(n23, 1). classified(n23, confirmed).

-- the meta-analysts' book
edge[sala_gobet](g1, describes, influence_of_chess_on_thinking, "24 studies, 40 effect sizes: mathematics d = 0.38, cognitive ability d = 0.34, literacy d = 0.25; 25-30 h, a lesson per week during the school year, is probably the minimum threshold to obtain meaningful benefits").
evidence(g1, src_sala_gobet, "Sala & Gobet 2016 Educ Res Rev, as reported in Sala, Foley, Gobet 2017"). landed(g1, 3). depth(g1, 1). classified(g1, confirmed).
edge[sala_gobet](g2, describes, influence_of_chess_on_thinking, "almost none of the reviewed studies compared chess-treated groups with active control groups to rule out possible placebo effects").
evidence(g2, src_sala_gobet, "Sala, Foley, Gobet 2017"). landed(g2, 3). depth(g2, 1). classified(g2, unexpected).
edge[sala_gobet](g3, describes, influence_of_chess_on_thinking, "far transfer of learning rarely occurs").
evidence(g3, src_sala_gobet, "Sala & Gobet 2017, Curr Dir Psychol Sci"). landed(g3, 3). depth(g3, 1). classified(g3, confirmed).
edge[sala_gobet](g4, describes, influence_of_chess_on_thinking, "The overall effect of far transfer is null, and there is little to no true variability between the types of cognitive training").
evidence(g4, src_sala_gobet, "Gobet & Sala 2023, Perspect Psychol Sci"). landed(g4, 3). depth(g4, 1). classified(g4, confirmed).
edge[sala_gobet](g5, transforms, chess_instruction, io(pupil, pupil_with_short_term_gains)).
evidence(g5, src_sala_gobet, "2016 meta-analysis: d 0.25-0.38 on post-tests, placebo uncontrolled"). landed(g5, 3). depth(g5, 1). classified(g5, confirmed).
edge[sala_gobet](g6, depends_on, short_term_math_and_cognitive_scores, chess_instruction).
evidence(g6, src_sala_gobet, "2016 meta-analysis"). landed(g6, 3). depth(g6, 1). classified(g6, confirmed).
context(g6, "the dependence the 2016 meta-analysis reports is short-term and uncontrolled; the same authors' 2017 and 2023 papers say far transfer rarely occurs and is null overall. One book, two dates, the later retracts the reading of the earlier: with a bus factor of two, perspective collapses into time here too").
edge[sala_gobet](g7, invariant_over, chess_instruction, inv_25_30_hours_minimum).
evidence(g7, src_sala_gobet, "2016: '25-30 h ... probably the minimum threshold'"). landed(g7, 3). depth(g7, 1). classified(g7, confirmed).
edge[sala_gobet](g8, held_by, inv_25_30_hours_minimum, sala_and_gobet).
evidence(g8, src_sala_gobet, "same"). landed(g8, 3). depth(g8, 1). classified(g8, confirmed).

-- the trial's book, through a citation
edge[ioe](j1, describes, influence_of_chess_on_thinking, "1,965 Year 5 pupils receiving chess instruction versus 1,900 controls; after one year the two groups did not differ in any of the outcome measures").
evidence(j1, src_sala_gobet, "Sala, Foley, Gobet 2017 reporting the 2016 IoE trial; two weaknesses they name: post-test a year after instruction ended, ceiling effect"). landed(j1, 3). depth(j1, 1). classified(j1, unexpected).
not_found(depends_on, chess_instruction, in, src_ioe_rct, 3).   -- the trial found no outcome that depended on the instruction
context(j1, "the only randomised evidence in reach, and it says no; the meta-analysts who cite it keep their 2016 effect and their 2017 verdict on the same page. Two claims in the asker's decision's path disagree on the same triple: g6 against this not_found. That is the nuance the asker's decision turns on").

-- the encyclopedia's book
edge[wiki_en](n24, describes, influence_of_chess_on_thinking, "Although one meta-analysis and most children studies find a positive correlation between general cognitive ability and chess skill, adult studies show mixed results.").
evidence(n24, src_wikipedia, "en 'Psychology', citing Burgoyne et al. 2016, Gobet & Campitelli 2007, Campitelli & Gobet 2011"). landed(n24, 3). depth(n24, 1). classified(n24, confirmed).
not_found(depends_on, chess, in, src_wikipedia, 3).   -- a correlation between ability and skill is not a dependence of ability on chess; the section says nothing about instruction
context(n24, "the encyclopedia's sentence is the one a parent will read first, and it answers a different question: whether able children play well, not whether playing makes children able").

asked(depends_on, chess, in, src_wikipedia, 3). asked(depends_on, chess, in, src_sala_gobet, 3). asked(depends_on, chess, in, src_ioe_rct, 3).
asked(transforms, chess_instruction, out, src_sala_gobet, 3).

-- ======================================================================
-- round 4 — the saturation question, asked by the asker: is there
-- anything after 2017 that could turn the verdict, and what does the
-- Russian programme claim. Two more puts; both answered by absence.
-- ======================================================================
-- @who ontocrawler_2
put(4, src_europepmc, "chess in the title, children or pupils or school, 2018-2026: any randomised trial, meta-analysis or systematic review of chess training and cognitive or academic outcomes?").
put(4, src_wikipedia, "ru 'Шахматы в школе': what is the programme, where, and what effects does it cite?").
not_found(depends_on, chess_instruction, in, src_europepmc, 4).   -- 25 hits with chess in the title, 2018-2026: brain imaging (Hao 2026), a preschool preprint (Özdemir 2026), cross-sectional 5-6-year-olds in Russia (Yakushina, Chichinina, Dolgikh 2025, Front Psychol), correlation studies (Stegariu 2022), parents' perspectives (Nanu 2023); no randomised trial, no meta-analysis, no systematic review
context(g4, "the post-2017 literature in reach adds observational and cross-sectional work only; nothing controlled after the 2016 trial. The verdict's ORDER - uncontrolled yes, controlled no, far transfer null - is unchanged by eight more years of publication").
edge[book](n25, recorded_in, chess_instruction, src_ru_school_programme).
evidence(n25, src_wikipedia, "ru 'Шахматы в школе': 1994 electives; 1996 Kalmykia mandatory by decree; 2004 Minobr order 2211; 2008 Pskov grades 1-2; 2015 Moscow, 2016 100 Moscow schools, 46 in Kaluga; Azerbaijan, Armenia, Hungary, Spain, Mexico, Poland, Turkey"). landed(n25, 4). depth(n25, 1). classified(n25, confirmed).
edge[wiki_ru](r5, describes, influence_of_chess_on_thinking, "школьники, изучающие эту игру, стабильно демонстрируют улучшение успеваемости и интеллектуальных показателей").
evidence(r5, src_wikipedia, "ru 'Шахматы в школе', no citation attached to the sentence"). landed(r5, 4). depth(r5, 0). classified(r5, unexpected).
context(r5, "a programme's own claim about its effect, in the article about the programme, with no study behind it: depth 0 by the book's own rule. The sentence a Russian parent meets first is the least evidenced sentence in the book, and it is the one the meta-analysts' 2016 numbers would seem to support and their 2017 verdict would not").
asked(depends_on, chess, in, src_europepmc, 4). asked(describes, influence_of_chess_on_thinking, out, src_wikipedia, 4).

-- ======================================================================
-- round 5 — doubt. The polarities the edges of round 3 carry toward the
-- claim, the caveat one edge places on another, and who holds the
-- encyclopedia; nothing new from outside. The decision is then rendered.
-- ======================================================================
-- @who ontocrawler_2
supports(g1, influence_of_chess_on_thinking).
supports(g6, influence_of_chess_on_thinking).
supports(r5, influence_of_chess_on_thinking).
refutes(j1, influence_of_chess_on_thinking).
refutes(g3, influence_of_chess_on_thinking).
refutes(g4, influence_of_chess_on_thinking).
qualifies(g2, g1).
qualifies(g2, g6).
edge[book](n26, held_by, src_wikipedia, wikipedia_editors).
evidence(n26, src_wikipedia, "open editorial communities, ru and en"). landed(n26, 5). depth(n26, 1). classified(n26, confirmed).
edge[book](n27, held_by, src_ru_school_programme, ru_ministry_and_federation).
evidence(n27, src_wikipedia, "ru 'Шахматы в школе': Minobr order 2211 of 2004, the Coordination Council, the federation's programme"). landed(n27, 5). depth(n27, 1). classified(n27, confirmed).

-- ======================================================================
-- round 6 — discharging `concentration`: a book the meta-analysts do not
-- hold. Europe PMC, chess in the title, all years: one quasi-experiment by
-- another holder (Aarhus), positive; and the meta-analysts' own study with
-- the active control their caveat asked for, null.
-- ======================================================================
authority(aarhus, ontocrawler_2).     -- Rosholm, Mikkelsen, Gumede 2017, TrygFonden's Centre, Aarhus
authority(jerrim, ontocrawler_2).     -- Jerrim, Macmillan, Micklewright, Sawtell, Wiggins 2018, J Human Resources
-- @who ontocrawler_2
put(6, src_europepmc, "chess in the title, academic or mathematics or cognitive skills, children: any study on instruction effects by authors other than Sala and Gobet?").
put(6, src_europepmc, "any comment, reply or rebuttal to the far-transfer-null claim?").
not_found(depends_on, chess_instruction, in, src_europepmc, 6).   -- no rebuttal of the far-transfer verdict names chess; the working-memory literature disagrees only partially and about itself
edge[book](n28, recorded_in, influence_of_chess_on_thinking, src_rosholm_plos).
evidence(n28, src_europepmc, "Rosholm, Mikkelsen, Gumede 2017 PLoS One 10.1371/journal.pone.0177257"). landed(n28, 6). depth(n28, 1). classified(n28, confirmed).
edge[book](n29, held_by, src_rosholm_plos, aarhus_trygfonden).
evidence(n29, src_europepmc, "TrygFonden's Centre for Child Research, Aarhus; IZA Bonn"). landed(n29, 6). depth(n29, 1). classified(n29, confirmed).
edge[aarhus](m1, describes, influence_of_chess_on_thinking, "We analyse the effect of substituting a weekly mathematics lesson in primary school grades 1-3 with a lesson in mathematics based on chess instruction ... positive effects, indicating that knowledge acquired through chess play can be transferred to the domain of mathematics; larger impacts for unhappy children and children who are bored in school").
evidence(m1, src_rosholm_plos, "abstract, Denmark, quasi-experimental substitution of curriculum"). landed(m1, 6). depth(m1, 1). classified(m1, confirmed).
supports(m1, influence_of_chess_on_thinking).
context(m1, "a second holder on the supporting side, and a design the meta-analysts' 2017 verdict does not rate: substitution, not randomisation; the effect is on mathematics taught THROUGH chess, which is nearer to near transfer than to far").
edge[sala_gobet](g9, describes, influence_of_chess_on_thinking, "233 third and fourth graders, 25 hours of chess instruction versus an active control group (checkers) and a passive control: no statistically significant difference in mathematical problem-solving or metacognitive abilities; a second experiment with Go as the active control: differences not statistically significant. The effects (if any) of chess instruction, when rigorously tested, are modest").
evidence(g9, src_sala_gobet, "Sala & Gobet 2017 Learning & Behavior 10.3758/s13420-017-0280-3"). landed(g9, 6). depth(g9, 1). classified(g9, unexpected).
refutes(g9, influence_of_chess_on_thinking).
answers_caveat(g9, g1).
answers_caveat(g9, g6).
not_found(depends_on, chess_instruction, in, src_sala_gobet_active_control, 6).
context(g9, "the design the caveat on g1 asked for, run by the authors of the caveat, at the 25-hour threshold they themselves set, against the placebo they said nobody had controlled: null. The caveat is answered and the answer is against the edge it qualified").

-- ======================================================================
-- round 7 — discharging `single_source` on the trial: the trial's own
-- paper, read directly (Journal of Human Resources via uwpress and RePEc;
-- the EEF report and UCL Discovery still 403).
-- ======================================================================
put(7, src_jerrim_jhr, "what did the trial find, in its own words?").
edge[book](n30, recorded_in, influence_of_chess_on_thinking, src_jerrim_jhr).
evidence(n30, src_jerrim_jhr, "Jerrim, Macmillan, Micklewright, Sawtell, Wiggins 2018, J Human Resources 53(4) 993-1021, 10.3368/jhr.53.4.0516.7952R; ideas.repec.org/a/uwp/jhriss/v53y2018i4p993-1021.html"). landed(n30, 7). depth(n30, 2). classified(n30, confirmed).
edge[book](n31, held_by, src_jerrim_jhr, ucl_institute_of_education).
evidence(n31, src_jerrim_jhr, "the authors' affiliation; the 2016 IoE trial Sala, Foley, Gobet cite"). landed(n31, 7). depth(n31, 1). classified(n31, confirmed).
edge[jerrim](k1, describes, influence_of_chess_on_thinking, "A number of studies suggest that teaching children how to play chess may have an impact on their educational attainment. Yet the strength of this evidence is undermined by limitations with research design. ... a randomized controlled trial (RCT) involving more than 4,000 children in England. In contrast to much of the existing literature, we find no evidence of an effect of chess instruction on children's mathematics, reading, or science test scores.").
evidence(k1, src_jerrim_jhr, "abstract, verbatim"). landed(k1, 7). depth(k1, 1). classified(k1, confirmed).
refutes(k1, influence_of_chess_on_thinking).
evidence(j1, src_jerrim_jhr, "the trial's own abstract: 'more than 4,000 children', 'no evidence of an effect ... on mathematics, reading, or science' - the citation in Sala, Foley, Gobet stands").
context(j1, "second source landed in round 7: the trial read directly, by its own authors, a holder the meta-analysts do not hold").
-- polarities the earlier edges had not declared
neutral(g2, influence_of_chess_on_thinking).      -- a caveat, not a side
neutral(n24, influence_of_chess_on_thinking).     -- a correlation between ability and skill, not a claim about instruction
supports(g5, influence_of_chess_on_thinking).

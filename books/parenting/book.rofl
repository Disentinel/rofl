put(3, src_sep, "what grounds a parent's rights and duties over a child? (SEP 'Foundations', read as requires(?, parenting))").
put(3, src_wikipedia, "what does the statute say воспитание is FOR? (ФЗ-273 purpose clause)").
put(4, src_wikipedia, "what kinds, styles, practices and stages does the article divide parenting into?").
put(5, src_crc, "who does the Convention make responsible for a child's upbringing, and who assists?").
put(5, src_who_unicef_guidance, "who provides nurturing care?").
not_found(requires, parenting, in, src_sep, 3).        -- no biological or evolutionary ground among the five accounts
not_found(requires, parenting, in, src_wikipedia, 3).  -- none in either article either
not_found(decomposes_into, parenting, out, src_wikipedia, 4). -- no decomposition by the CHILD's aim, on either axis
not_found(decomposes_into, parenting, out, src_sep, 4).


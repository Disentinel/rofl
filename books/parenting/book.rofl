-- books/parenting/book.rofl — the book of one seed, `parenting exists`
-- (воспитание детей), grown by ontocrawler-2 with the crystals a software
-- product left behind. The crystal's own promise is under test here: its
-- lines are candidates, and a domain that is not a product is what promotes
-- or retires them.
--
-- The sandbox reaches github and npm and nothing else: no encyclopedia, no
-- journal, no library, no ministry. The sources of this seed are named as
-- entities the moment they are known and marked unreachable when they are,
-- the one reachable source is the holder's own knowledge graph.

-- @who ontocrawler_2
seed(parenting).

-- ======================================================================
-- round 1 — the three kindless questions of the seed, batched. Sources:
-- the holder's knowledge graph (reachable, asked, empty on this topic) and
-- the crawler's own recall of where parenting leaves traces, written as
-- POINTERS at depth 0 - not content - and every one of them unreachable
-- from this sandbox. The book's honest state after this round is a seed
-- whose every source is named and none can be opened.
-- ======================================================================

guessed(src_enox, source).
guessed(src_agent_memory, source).
edge[book](p01, recorded_in, parenting, src_enox).
evidence(p01, src_enox, "recall 'воспитание детей, родительство' and semantic_search 'parenting, raising children' over enox.dev/personal/vadim_r: top similarity 0.55, every hit a CS paper or concept; nothing about children"). landed(p01, 1). depth(p01, 1). classified(p01, gap).
context(p01, "the one reachable source holds nothing on the seed: a trace expected (the holder is a parent) and not found").

-- pointers from recall: where the literature says parenting is recorded.
-- Depth 0 each; evidence names the recall as the source so the gate stays
-- silent and the reader is told exactly how little this is worth.
guessed(src_baumrind, source).          guessed(src_attachment_theory, source).
guessed(src_who_unicef_guidance, source). guessed(src_family_law, source).
guessed(src_popular_manuals, source).   guessed(src_holder_experience, source).
edge[book](p02, recorded_in, parenting, src_baumrind).
evidence(p02, src_agent_memory, "Baumrind 1967/1971, the authoritative/authoritarian/permissive typology; Maccoby & Martin 1983 add neglectful"). landed(p02, 1). depth(p02, 0). classified(p02, confirmed).
edge[book](p03, recorded_in, parenting, src_attachment_theory).
evidence(p03, src_agent_memory, "Bowlby 1969 Attachment and Loss; Ainsworth 1978 Strange Situation"). landed(p03, 1). depth(p03, 0). classified(p03, confirmed).
edge[book](p04, recorded_in, parenting, src_who_unicef_guidance).
evidence(p04, src_agent_memory, "WHO/UNICEF Nurturing Care Framework 2018; UN Convention on the Rights of the Child 1989"). landed(p04, 1). depth(p04, 0). classified(p04, confirmed).
edge[book](p05, recorded_in, parenting, src_family_law).
evidence(p05, src_agent_memory, "Семейный кодекс РФ гл. 12 'Права и обязанности родителей'; every jurisdiction has one"). landed(p05, 1). depth(p05, 0). classified(p05, confirmed).
edge[book](p06, recorded_in, parenting, src_popular_manuals).
evidence(p06, src_agent_memory, "Spock 1946; Гиппенрейтер 'Общаться с ребёнком. Как?' 1994; Петрановская 'Тайная опора' 2015; Faber & Mazlish 1980"). landed(p06, 1). depth(p06, 0). classified(p06, confirmed).
edge[book](p07, recorded_in, parenting, src_holder_experience).
evidence(p07, src_agent_memory, "the holder's own practice as a parent: a source the protocol reaches only as an oracle"). landed(p07, 1). depth(p07, 0). classified(p07, confirmed).

unreachable(src_baumrind, 1).           -- doi.org, PubMed, archive.org: 403 at the proxy
unreachable(src_attachment_theory, 1).
unreachable(src_who_unicef_guidance, 1). -- who.int, unicef.org: 403
unreachable(src_family_law, 1).
unreachable(src_popular_manuals, 1).    -- gutenberg.org, archive.org: 403
unreachable(src_holder_experience, 1).  -- an oracle, not a source

asked(recorded_in, parenting, out, src_enox, 1).
asked(recorded_in, parenting, out, src_agent_memory, 1).
asked(is_a, parenting, out, src_enox, 1).
asked(describes, parenting, out, src_enox, 1).
-- is_a and describes were NOT put to src_agent_memory: a kind and a
-- sentence from recall would be content, not a pointer, and the crawler is
-- not a source. They wait for a reachable text.

-- round 2 — the environment's network policy changed; the sources named in
-- round 1 answer at the proxy now (probed 2026-09-21: wikipedia, arxiv,
-- pubmed, who.int, archive.org, plato.stanford.edu, doi.org all 200).
-- @who ontocrawler_2
reachable(src_baumrind, 2). reachable(src_attachment_theory, 2). reachable(src_who_unicef_guidance, 2).
reachable(src_family_law, 2). reachable(src_popular_manuals, 2).
guessed(src_wikipedia, source). guessed(src_sep, source).

-- the three kindless questions of the seed, put to the primary texts:
-- ru.wikipedia (Воспитание), en.wikipedia (Parenting), the Stanford
-- Encyclopedia of Philosophy (Parenthood and Procreation).
edge[book](p08, describes, parenting, "Воспита́ние — процесс обучения, защиты и заботы о детях с целью их здорового развития во взрослой жизни").
evidence(p08, src_wikipedia, "ru.wikipedia.org/wiki/Воспитание, first paragraph, fetched 2026-09-21"). landed(p08, 2). depth(p08, 1). classified(p08, confirmed).
edge[book](p09, describes, parenting, "Parenting or child rearing promotes and supports the physical, cognitive, social, emotional, and educational development from infancy to adulthood.").
evidence(p09, src_wikipedia, "en.wikipedia.org/wiki/Parenting, lead sentence, fetched 2026-09-21"). landed(p09, 2). depth(p09, 1). classified(p09, confirmed).
edge[book](p10, describes, parenting, "A parent is someone with weighty rights and responsibilities regarding a given child.").
evidence(p10, src_sep, "plato.stanford.edu/entries/parenthood/, preamble, fetched 2026-09-21"). landed(p10, 2). depth(p10, 1). classified(p10, confirmed).

edge[book](p11, is_a, parenting, process).
evidence(p11, src_wikipedia, "ru: 'процесс обучения, защиты и заботы о детях'"). landed(p11, 2). depth(p11, 1). classified(p11, confirmed).
edge[book](p12, is_a, parenting, child_rearing).
evidence(p12, src_wikipedia, "en: 'Parenting or child rearing promotes and supports ... development'"). landed(p12, 2). depth(p12, 1). classified(p12, confirmed).
edge[book](p13, is_a, parenting, normative_status).
evidence(p13, src_sep, "'someone with weighty rights and responsibilities regarding a given child' - parenthood as a status that grounds rights and duties, not an activity"). landed(p13, 2). depth(p13, 1). classified(p13, unexpected).
context(p13, "the seed straddles three things the three sources keep apart: воспитание (a process done to a child), parenting (an activity of an adult), parenthood (a status with rights and duties). One atom, three kinds, and the atom's name is the Russian one. Entity resolution across languages is open: which of the three the holder means is an escalation, not a merge.").

edge[book](p14, recorded_in, parenting, src_wikipedia).
evidence(p14, src_wikipedia, "ru and en articles; en sections Styles / Practices / Across the lifespan / Rights and responsibilities / Effects; ru sections history in Europe / kinds / Russian education system / Russian law"). landed(p14, 2). depth(p14, 2). classified(p14, confirmed).
edge[book](p15, recorded_in, parenting, src_sep).
evidence(p15, src_sep, "SEP entry 'Parenthood and Procreation': Foundations; morality of procreation; Becoming Parents; Being Parents"). landed(p15, 2). depth(p15, 1). classified(p15, confirmed).
-- the pointers of round 1 gain a second source and leave depth 0
evidence(p02, src_wikipedia, "en: Diana Baumrind proposed three styles (authoritative, authoritarian, permissive), later four (uninvolved); Alfie Kohn 2005, Peter Gray, Jay Belsky, Annette Lareau, Daniel Schechter also named").
evidence(p04, src_wikipedia, "en: WHO cited; Universal Declaration of Human Rights art. 25.2 on motherhood and childhood").
evidence(p05, src_wikipedia, "ru: section 'Воспитание в системе образования в России' and Законодательство РФ as a school of definition").
guessed(src_pedagogy_classics, source).
edge[book](p16, recorded_in, parenting, src_pedagogy_classics).
evidence(p16, src_wikipedia, "ru: Джон Локк, Жан-Жак Руссо, Джон Уотсон, Б. Ф. Скиннер, Альберт Бандура; 'Наставление отца к сыну' (XV в.)"). landed(p16, 2). depth(p16, 1). classified(p16, confirmed).
context(p16, "ru's history of the CONCEPT runs Locke -> Rousseau -> behaviorism -> Bandura; en's does not exist as a section. Two encyclopedias, two different things worth recording about the same word.").

asked(is_a, parenting, out, src_wikipedia, 2). asked(describes, parenting, out, src_wikipedia, 2). asked(recorded_in, parenting, out, src_wikipedia, 2).
asked(is_a, parenting, out, src_sep, 2). asked(describes, parenting, out, src_sep, 2). asked(recorded_in, parenting, out, src_sep, 2).
-- for the next, class-dependent rounds, SEP names the accounts of what
-- GROUNDS parenthood (genetic: Hall 1999; labor: Rothman 1989, Feldman
-- 1992; voluntarist: Hill 1991, Shultz 1990, Van Zyl 2002; causal: Nelson
-- 1991, Archard 2010; child-centred: Montague 2000, Gheaus 2021) - that is
-- requires(?, parenting) waiting for the seed to be kinded, which it now is.

-- ======================================================================
-- round 3 — crawl(requires, ?, parenting): why does it exist. SEP's
-- "Foundations" is exactly this question asked by philosophers: what
-- grounds a parent's rights and duties. Five accounts, each an answer,
-- none collapsed. The Russian law's purpose clause is a sixth, from a
-- legislator rather than a philosopher.
-- ======================================================================
-- @who ontocrawler_2
guessed(ground_genetic, purpose). guessed(ground_labor, purpose). guessed(ground_voluntarist, purpose).
guessed(ground_causal, purpose). guessed(ground_child_centred, purpose). guessed(ground_statutory_ru, purpose).
edge[book](p17, requires, ground_genetic, parenting).
evidence(p17, src_sep, "Genetic accounts: parenthood in direct genetic derivation; Hall 1999 via Lockean self-ownership"). landed(p17, 3). depth(p17, 1). classified(p17, confirmed).
edge[book](p18, requires, ground_labor, parenting).
evidence(p18, src_sep, "Labor-based accounts: gestational work and caregiving; Rothman 1989, Feldman 1992"). landed(p18, 3). depth(p18, 1). classified(p18, confirmed).
edge[book](p19, requires, ground_voluntarist, parenting).
evidence(p19, src_sep, "Intentional/voluntarist accounts: the deliberate choice to parent; Hill 1991, Shultz 1990, Van Zyl 2002"). landed(p19, 3). depth(p19, 1). classified(p19, confirmed).
edge[book](p20, requires, ground_causal, parenting).
evidence(p20, src_sep, "Causal accounts: parenthood derives from causing a child's existence; Nelson 1991, Archard 2010"). landed(p20, 3). depth(p20, 1). classified(p20, confirmed).
edge[book](p21, requires, ground_child_centred, parenting).
evidence(p21, src_sep, "Child-centered accounts: competent adults could parent any child if it serves the child's interests; Montague 2000, Gheaus 2021"). landed(p21, 3). depth(p21, 1). classified(p21, unexpected).
context(p21, "the one account on which the seed does not require a PARENT at all, only a competent adult and the child's interest; it turns held_by(parenting, ?) from a fact about biology into a question about who is competent").
edge[book](p22, requires, ground_statutory_ru, parenting).
evidence(p22, src_wikipedia, "ФЗ-273 от 29.12.2012 'Об образовании в РФ': воспитание есть 'деятельность, направленная на развитие личности, создание условий для самоопределения и социализации обучающихся на основе социокультурных, духовно-нравственных ценностей'"). landed(p22, 3). depth(p22, 1). classified(p22, confirmed).
context(p22, "the legislator's why names the STATE's schools as the subject ('обучающихся'), not parents: воспитание in Russian law is something education does, which is why the ru article's is_a is a process and not a role").
asked(requires, parenting, in, src_sep, 3). asked(requires, parenting, in, src_wikipedia, 3).

-- ======================================================================
-- round 4 — crawl(decomposes_into, parenting, out): what it is made of.
-- ru decomposes by AIM (eleven kinds), en by STYLE (Baumrind) and by
-- PRACTICE (eight); the two encyclopedias cut the same thing along
-- different axes, and both cuts are kept.
-- ======================================================================
guessed(kind_by_aim, subsystem). guessed(styles_baumrind, subsystem). guessed(practices, subsystem). guessed(life_stages, subsystem).
edge[book](p23, decomposes_into, parenting, kind_by_aim).
evidence(p23, src_wikipedia, "ru 'Виды воспитания человека': умственное, трудовое, физическое, нравственное, духовно-нравственное, эстетическое, правовое, патриотическое, половое и полоролевое, экономическое, экологическое; by institution: семейное, религиозное, социальное, дизсоциальное, коррекционное"). landed(p23, 4). depth(p23, 1). classified(p23, confirmed).
edge[book](p24, decomposes_into, parenting, styles_baumrind).
evidence(p24, src_wikipedia, "en 'Styles': Baumrind's authoritative / authoritarian / permissive, later uninvolved (Maccoby & Martin); intrusive, unconditional (Kohn 2005), trustful (Gray), material"). landed(p24, 4). depth(p24, 1). classified(p24, confirmed).
edge[book](p25, decomposes_into, parenting, practices).
evidence(p25, src_wikipedia, "en 'Practices': reading aloud, storytelling, face-to-face interaction, consejos, teasing, nonverbal communication, LOPI (learning by observing and pitching in), ethnic-racial socialization"). landed(p25, 4). depth(p25, 1). classified(p25, confirmed).
edge[book](p26, decomposes_into, parenting, life_stages).
evidence(p26, src_wikipedia, "en 'Across the lifespan': pre-pregnancy, pregnancy and prenatal, newborns and infants, toddlers, child, adolescents, adults"). landed(p26, 4). depth(p26, 1). classified(p26, confirmed).
context(p23, "ru's axis is the AIM of the adult (what quality is being raised); en's axes are the adult's STYLE and PRACTICE and the child's STAGE. No source decomposes by the child's aim. A decomposition that has no place for what the child wants is a topological fact, recorded, not judged").
asked(decomposes_into, parenting, out, src_wikipedia, 4). asked(decomposes_into, parenting, out, src_sep, 4).

-- ======================================================================
-- round 5 — crawl(held_by, parenting, out): who pays when it breaks. The
-- Convention on the Rights of the Child answers in the register of law,
-- WHO in the register of health systems, ФЗ-273 in the register of
-- schools. Every holder is a ROLE, and the crystal's `values` archetype
-- was spawned for persons: the class is widened here, in the book, as a
-- candidate line for the next crystal.
-- ======================================================================
guessed(src_crc, source).
guessed(parents, role). guessed(legal_guardians, role). guessed(extended_family_or_community, role).
guessed(states_parties, role). guessed(caregivers_and_health_workers, role). guessed(schools_ru, role).
guessed(best_interests_of_the_child, value).
provisional(values, role, 5).

edge[book](p27, recorded_in, parenting, src_crc).
evidence(p27, src_crc, "Convention on the Rights of the Child, GA resolution 44/25, 20 November 1989; unicef.org/child-rights-convention/convention-text (ohchr.org refused the proxy with 403)"). landed(p27, 5). depth(p27, 1). classified(p27, confirmed).
edge[book](p28, held_by, parenting, parents).
evidence(p28, src_crc, "art. 18(1) 'both parents have common responsibilities for the upbringing and development of the child'; art. 27(2) 'the parent(s) ... have the primary responsibility to secure ... the conditions of living necessary for the child's development'"). landed(p28, 5). depth(p28, 2). classified(p28, confirmed).
evidence(p28, src_wikipedia, "en 'Rights and responsibilities': 'Parental responsibilities or obligations include the provision of a home, food and security for children'").
edge[book](p29, held_by, parenting, legal_guardians).
evidence(p29, src_crc, "art. 5 'legal guardians or other persons legally responsible for the child'; art. 27(2) 'or others responsible for the child'"). landed(p29, 5). depth(p29, 1). classified(p29, confirmed).
edge[book](p30, held_by, parenting, extended_family_or_community).
evidence(p30, src_crc, "art. 5 'the members of the extended family or community as provided for by local custom'"). landed(p30, 5). depth(p30, 1). classified(p30, serendipitous).
context(p30, "a holder the two encyclopedias never name: custom, as a source of responsibility recognised by treaty").
edge[book](p31, held_by, parenting, states_parties).
evidence(p31, src_crc, "art. 18(2) States Parties 'shall render appropriate assistance to parents and legal guardians in the performance of their child-rearing responsibilities and shall ensure the development of institutions, facilities and services for the care of children'"). landed(p31, 5). depth(p31, 1). classified(p31, confirmed).
context(p31, "the state holds the ASSISTANCE, not the upbringing: a layer boundary in the skill's sense - permitted ignorance of how a family raises, forced knowledge of whether it can").
edge[book](p32, held_by, parenting, caregivers_and_health_workers).
evidence(p32, src_who_unicef_guidance, "who.int nurturing care: 'caregivers, health workers, and the health sector alongside other sectors and actors' share responsibility; Nurturing Care Framework 2018"). landed(p32, 5). depth(p32, 1). classified(p32, confirmed).
edge[book](p33, held_by, parenting, schools_ru).
evidence(p33, src_wikipedia, "ФЗ-273: воспитание as an activity of the education system over 'обучающихся'"). landed(p33, 5). depth(p33, 1). classified(p33, unexpected).
context(p33, "in the Russian statute the holder of воспитание is the school; in the Convention the holder of upbringing is the parent and the state assists. Same seed, two holders that do not coexist in one text - the seam round 2 found between the three kinds, now on the held_by side").
edge[book](p34, values, parents, best_interests_of_the_child).
evidence(p34, src_crc, "art. 18(1) 'The best interests of the child will be their basic concern'; art. 3(1) 'the best interests of the child shall be a primary consideration' for every institution, court and legislature"). landed(p34, 5). depth(p34, 1). classified(p34, confirmed).
edge[book](p35, values, states_parties, best_interests_of_the_child).
evidence(p35, src_crc, "art. 3(1)"). landed(p35, 5). depth(p35, 1). classified(p35, confirmed).
asked(held_by, parenting, out, src_crc, 5). asked(held_by, parenting, out, src_who_unicef_guidance, 5). asked(held_by, parenting, out, src_wikipedia, 5). asked(held_by, parenting, out, src_sep, 5).

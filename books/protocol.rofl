-- books/protocol.rofl — THE question protocol, as rules over facts.
--
-- This file supersedes the sketch it was translated from (question-protocol
-- .md, 2026-09-18): the sketch is retired, not kept beside this, because two
-- texts of one protocol drift the way a README and a manifest do. Two things
-- the kernel forced on the translation: there is no aggregation, so every
-- `count{}` is a witness of distinct rows; and a rule cannot quantify over
-- relation NAMES, so every edge is reified as edge[Volume](Id, R, X, Y) and
-- R(X, ?) is `edge_any(_, R, X, _)`. Everything the sketch did not have -
-- roles, put, not_found, reachable, volumes per holder, intents, the owner's
-- questions as audits - entered by a round that needed it and is dated where
-- it stands. The discipline is skills/ontocrawler-2/SKILL.md; the vocabulary
-- is books/crystals/; a book is books/<name>/.
--
-- Volumes are perspectives: [book] is the seed's volume (the crawler writes
-- there), [canon] is the curated canon its author wrote, and a holder gets a
-- volume the day a holder-signed fact lands. `edge_any` is the one rule that
-- gathers them, and `collects(main)` is its licence.

authority(main, ontocrawler_2).
authority(book, ontocrawler_2).
authority(canon, vadim).
authority(vadim, vadim).        -- the holder's own book: what he says in session, verbatim
authority(main, vadim).
collects(main).

-- ------------------------------------------------------ sensors (edb only)
edb(seed).              -- seed(X)                       X exists
edb(archetype).         -- archetype(R)                  the relation vocabulary
edb(q_shape).           -- q_shape(R, out|in)            R(X, ?) or R(?, X)
edb(crystal).           -- crystal(Name)
edb(expects).           -- expects(Crystal, Class, R)   the domain's learned signature
edb(origin).            -- origin(R, Session, Finding)  where an archetype came from
edb(learned_on).        -- learned_on(Crystal, Class, N, Seed)
edb(retired_by).        -- retired_by(Crystal, Class, R, Session)
edb(asker).             -- asker(A)
edb(guessed).           -- guessed(X, C)                FORBIDDEN: a class with no edge behind it; guessed_forbidden[audit]
edb(put).               -- put(Round, Source, "question")  the question as it was actually asked of the source
edb(not_found).         -- not_found(R, X, D, Source, Round)  looked there, that round, found nothing: a fact about the search
edb(kindless).          -- kindless(R)                   asked of every entity before its kind is known
edb(pair_valued).       -- pair_valued(R)                R(X, io(In, Out)): two slots, one edge
edb(quote_valued).      -- quote_valued(R)               R(X, "..."): the answer is a quote, not an entity
edb(edge).              -- edge[V](Id, R, X, Y)          one confirmed edge, in volume V
edb(evidence).          -- evidence(Id, Source, Locator)
edb(landed).            -- landed(Id, Round)
edb(depth).             -- depth(Id, N)                  0 asserted, 1 one source, 2+ corroborated
edb(classified).        -- classified(Id, confirmed|unexpected|serendipitous)
edb(asked).             -- asked(R, X, Dir, Source, Round)  the question was put to Source
edb(deferred).          -- deferred(X)                   peripheral, never deleted
edb(retired).           -- retired(C, R)                 loop 2: R fills < 30% of C
edb(signature_at).      -- signature_at(C, R, Sample, Pct, Round)  loop 2: R fills > 70% of C
edb(saturated_at).      -- saturated_at(C, Round)        the licence to say no
edb(provisional).       -- provisional(R, C, Round)     loop 2 spawned R for class C; promote or drop by fill rate
edb(ttl).               -- ttl(R, Rounds)
edb(source_changed).    -- source_changed(Source, Round)
edb(report_every).      -- report_every(N)
edb(priority_override). -- priority_override(C, up|down, Round)
edb(killed).            -- killed(Branch, Reason, Round)
edb(revived).           -- revived(Branch, Reason, Round)
edb(tick_closed).       -- tick_closed(K)
edb(reported).          -- reported(K)
edb(question_ext).      -- question_ext(Q, Asker, Round)   a human's question
edb(premise).           -- premise(Q, E)                 Q presupposes E exists
edb(needs_ext).         -- needs_ext(Q, R, X, Dir)       Q is answered by R(X, ?)
edb(alias).             -- alias(Asker, E, E2)
edb(unreachable).       -- unreachable(Source, Round)   asked, and the source could not be reached
edb(reachable).         -- reachable(Source, Round)     reached again after an unreachable row

-- ------------------------------------------------------------ the gather
edge_any(Id, R, X, Y)     :- edge[V](Id, R, X, Y).
in_volume(Id, V)          :- edge[V](Id, _, _, _).

-- ------------------------------------------------------------- entities
entity(X)                 :- seed(X).
entity(A)                 :- question_ext(_, A, _).          -- the second seed: whoever asks
entity(X)                 :- edge_any(_, _, X, _).
entity(Y)                 :- edge_any(_, R, _, Y), not pair_valued(R), not quote_valued(R).
entity(I)                 :- consumes(_, I).
entity(O)                 :- produces(_, O).
consumes(X, I)            :- edge_any(_, R, X, io(I, _)), pair_valued(R).
produces(X, O)            :- edge_any(_, R, X, io(_, O)), pair_valued(R).
transforms(X, I, O)       :- edge_any(_, R, X, io(I, O)), pair_valued(R).

-- Two classings, both with an edge behind them. The ROLE is the part an
-- entity plays in the graph, derived from the relation that introduced it:
-- a thing something is recorded in is a source, whatever else it is. The
-- KIND is what a source says it is (is_a). Loop 2 counts fill rates by
-- either; roles reach n >= 3 first. A class written by hand is forbidden.
role(X, seed)             :- seed(X).
role(S, source)           :- edge_any(_, recorded_in, _, S).
role(K, kind)             :- edge_any(_, is_a, _, K).
role(P, part)             :- edge_any(_, decomposes_into, _, P).
role(P, purpose)          :- edge_any(_, requires, P, _).
role(D, dependant)        :- edge_any(_, depends_on, D, _).
role(H, holder)           :- edge_any(_, held_by, _, H).
role(V, value)            :- edge_any(_, values, _, V).
role(A, alias)            :- edge_any(_, equivalent_to, _, A).
role(S, successor)        :- edge_any(_, supersedes, S, _).
role(C, capability)       :- edge_any(_, offers, _, C).
role(M, method)           :- edge_any(_, method, _, M).
role(I, invariant)        :- edge_any(_, invariant_over, _, I).
role(I, material)         :- consumes(_, I).
role(O, product)          :- produces(_, O).
role(A, asker)            :- question_ext(_, A, _).
kinded(X)                 :- edge_any(_, is_a, X, _).
class(X, C)               :- role(X, C).
class(X, C)               :- edge_any(_, is_a, X, C).

appears(X, 0)             :- seed(X).
appears(A, K)             :- question_ext(_, A, K).
appears(X, K)             :- edge_any(Id, _, X, _), landed(Id, K).
appears(Y, K)             :- edge_any(Id, _, _, Y), landed(Id, K).
appears(I, K)             :- edge_any(Id, R, _, io(I, _)), pair_valued(R), landed(Id, K).
appears(O, K)             :- edge_any(Id, R, _, io(_, O)), pair_valued(R), landed(Id, K).
appears_later(X, K)       :- appears(X, K), appears(X, K2), K2 < K.
entered(X, K)             :- appears(X, K), not appears_later(X, K).

-- ------------------------------------------- questions: derived, not written
provisional_any(R)        :- provisional(R, _, _).
narrowed(C)               :- expects(_, C, _).
asks(C, R)                :- class(_, C), archetype(R), not retired(C, R), not provisional_any(R), not narrowed(C).
asks(C, R)                :- expects(_, C, R), not retired(C, R).
asks(C, R)                :- provisional(R, C, _), not retired(C, R).
needs(gen(E, R), R, E, D) :- entity(E), kindless(R), q_shape(R, D).
needs(gen(E, R), R, E, D) :- entity(E), class(E, C), asks(C, R), q_shape(R, D), not kindless(R).
needs(Q, R, X, D)         :- needs_ext(Q, R, X, D).
question(gen(E, R), crawler, T) :- needs(gen(E, R), R, E, _), entered(E, T).
question(Q, A, T)         :- question_ext(Q, A, T).

-- ------------------------------------------------ 1. resolve or rewrite
resolved(Q, E)            :- premise(Q, E), entity(E).
resolved(Q, E)            :- premise(Q, E), question(Q, A, _), alias(A, E, E2), entity(E2).
unresolved(Q, E)          :- premise(Q, E), not resolved(Q, E).
believes(A, E)            :- unresolved(Q, E), question(Q, A, _).

-- ------------------------------------------------ 2. derive or obligate
any_tick()                :- tick_closed(_).
round(K)                  :- tick_closed(K), K1 is K + 1, not tick_closed(K1).
round(0)                  :- seed(_), not any_tick().

stale(Id)                 :- edge_any(Id, R, _, _), landed(Id, T), ttl(R, D), round(N), A is N - T, A > D.
stale(Id)                 :- landed(Id, T), evidence(Id, S, _), source_changed(S, T2), T2 > T.

filled(R, X, out)         :- edge_any(Id, R, X, _), not stale(Id).
filled(R, X, in)          :- edge_any(Id, R, _, X), not stale(Id).
satisfied(Q, R, X, D)     :- needs(Q, R, X, D), filled(R, X, D).
obligation(Q, R, X, D)    :- needs(Q, R, X, D), not satisfied(Q, R, X, D).

-- sources unfold first: what has been asked of which source
source_of(X, S)           :- edge_any(_, recorded_in, X, S).
sourced(X)                :- source_of(X, _).
reachable_after(S, T)     :- unreachable(S, T), reachable(S, T2), T2 > T.
unreachable_now(S)        :- unreachable(S, T), not reachable_after(S, T).
unasked(R, X, D, S)       :- obligation(_, R, X, D), source_of(X, S), not asked(R, X, D, S, _),
                             not unreachable_now(S).
sources_exhausted(R, X, D):- obligation(_, R, X, D), sourced(X), not unasked(R, X, D, _).
sources_exhausted(R, X, D):- obligation(_, R, X, D), not sourced(X), asked(recorded_in, X, out, _, _).

-- ------------------------------------------------ 3. answer state
saturated(C)              :- saturated_at(C, _).
open_q(Q)                 :- obligation(Q, _, _, _).
hit(Q)                    :- question(Q, _, _), not open_q(Q), not unresolved(Q, _).
answer_no(Q)              :- obligation(Q, R, X, D), class(X, C), saturated(C), sources_exhausted(R, X, D).
answer_unknown(Q)         :- obligation(Q, R, X, D), class(X, C), not saturated(C), sources_exhausted(R, X, D).
answer_unknown(Q)         :- unresolved(Q, _).
answer_partial(Q)         :- obligation(Q, _, _, _), not answer_no(Q), not answer_unknown(Q).
answer(Q, yes)            :- hit(Q).
answer(Q, no)             :- answer_no(Q).
answer(Q, unknown)        :- answer_unknown(Q).
answer(Q, partial)        :- answer_partial(Q).
held(X)                   :- edge_any(_, held_by, X, _).
holder_for(Q, H)          :- answer_unknown(Q), obligation(Q, _, X, _), edge_any(_, held_by, X, H).

-- ------------------------------------------------ 4. crawl, by priority
-- A round is one class-dependent question, or ANY number of kindless ones:
-- a kind, a source and a quote each cost one look at a manifest, and a
-- gate that opens one entity per round starves every question behind it.
-- THE ROUND IS THE QUESTION, NOT A FILTER ON WRITES: whatever a source
-- answers while being asked one thing is written, under whichever R it
-- fits. Dropping an answer because it came to the wrong question is how
-- round 3 of parenting lost depends_on to requires.
batchable(R)              :- kindless(R).
revived_after(B, T)       :- killed(B, _, T), revived(B, _, T2), T2 > T.
dead(B)                   :- killed(B, _, T), not revived_after(B, T).
under(Y, B)               :- edge_any(_, decomposes_into, B, Y).
under(Y, B)               :- under(Y, Z), edge_any(_, decomposes_into, B, Z).
suppressed(X)             :- dead(X).
suppressed(X)             :- under(X, B), dead(B).
suppressed(X)             :- deferred(X).

crawl(R, X, D)            :- obligation(_, R, X, D), kindless(R), not suppressed(X),
                             not sources_exhausted(R, X, D).
crawl(R, X, D)            :- obligation(_, R, X, D), not kindless(R), sourced(X), kinded(X),
                             not suppressed(X), not sources_exhausted(R, X, D).

escalate(R, X, D, H)      :- obligation(_, R, X, D), sources_exhausted(R, X, D), edge_any(_, held_by, X, H).
escalate(R, X, D, nobody) :- obligation(_, R, X, D), sources_exhausted(R, X, D), not held(X).

-- value: the shrink criterion. held_by -> values, then along the structure.
-- AND THE ASKER'S QUESTIONS ARE THE VALUE FUNCTION: what a person asked
-- about is value-traced by that fact alone (skill 2.1, two seeds).
value_traced(X)           :- premise(Q, X), question_ext(Q, _, _).
value_traced(X)           :- needs_ext(Q, _, X, _), question_ext(Q, _, _).
values(H, V)              :- edge_any(_, values, H, V).
value_traced(X)           :- edge_any(_, held_by, X, H), values(H, _).
value_traced(X)           :- under(X, B), value_traced(B).
value_traced(X)           :- edge_any(_, depends_on, Y, X), value_traced(Y).
value_traced(X)           :- edge_any(_, requires, Y, X), value_traced(Y).

shared(R, X, D)           :- obligation(Q1, R, X, D), obligation(Q2, R, X, D), Q1 != Q2.
boosted(X)                :- class(X, C), priority_override(C, up, _).
damped(X)                 :- class(X, C), priority_override(C, down, _).
hi(R, X, D)               :- crawl(R, X, D), seed(X).
hi(R, X, D)               :- crawl(R, X, D), value_traced(X), not damped(X).
hi(R, X, D)               :- crawl(R, X, D), shared(R, X, D), not damped(X).
hi(R, X, D)               :- crawl(R, X, D), boosted(X).
lo(R, X, D)               :- crawl(R, X, D), not hi(R, X, D).

-- ------------------------------------------------ 7. rounds and reports
report_due(K)             :- round(K), report_every(N), M is K mod N, M = 0, K > 0, not reported(K).
recent(K)                 :- round(K).
recent(K)                 :- round(N), tick_closed(K), M is N - 3, K > M.
in_window(T)              :- round(K), report_every(N), tick_closed(T), M is K - N, T > M.
new_fact(K, Id)           :- landed(Id, K), in_window(K).
unexpected_now(K, Id)     :- classified(Id, unexpected), landed(Id, K), in_window(K).

branch(B)                 :- edge_any(_, decomposes_into, _, B).
under_or_self(X, X)       :- entity(X).
under_or_self(X, B)       :- under(X, B).
crawled_recently(B)       :- branch(B), asked(_, X, _, _, K), recent(K), under_or_self(X, B).
landed_recently(B)        :- branch(B), landed(Id, K), recent(K), edge_any(Id, _, _, Y), under_or_self(Y, B).
landed_recently(B)        :- branch(B), landed(Id, K), recent(K), edge_any(Id, _, X, _), under_or_self(X, B).
low_yield(B)              :- crawled_recently(B), not landed_recently(B), not dead(B).
ask_kill(B)               :- report_due(_), low_yield(B).

open_entity(X, C)         :- obligation(_, _, X, _), class(X, C).
two_open(C, X1, X2)       :- open_entity(X1, C), open_entity(X2, C), X1 < X2.
many_open(C)              :- two_open(C, _, X2), open_entity(X3, C), X2 < X3.
overridden(C)             :- priority_override(C, _, _).
ask_priority(C)           :- report_due(_), many_open(C), not overridden(C).

-- ------------------------------------------------ intents: suspected, then corroborated
-- A source that names as holder the one who holds the source (a ministry's
-- statute naming the school, a treaty naming the state). Conway's law over
-- the holders. ONE coincidence is a suspicion and an obligation to ask a
-- second source; it becomes a fact only when the holder edge stands on two
-- sources, one of which the holder does not hold.
held_source(S, H)         :- edge_any(_, held_by, S, H).
suspected_self_serving(Id, S, H) :- evidence(Id, S, _), edge_any(Id, held_by, X, H), X != S, held_source(S, H).
independent_evidence(Id)  :- evidence(Id, S2, _), edge_any(Id, held_by, _, H), not held_source(S2, H).
corroborate(Id)           :- suspected_self_serving(Id, _, _), not independent_evidence(Id).
-- the strong form: the source stands alone on the claim AND a source the
-- holder does not hold names a different holder for the same subject.
rival_holder(Id, H2)      :- suspected_self_serving(Id, S, H), edge_any(Id, held_by, X, H),
                             edge_any(J, held_by, X, H2), H2 != H, evidence(J, S2, _), not held_source(S2, H).
self_serving(Id, S, H)    :- suspected_self_serving(Id, S, H), not independent_evidence(Id), rival_holder(Id, _).

-- ------------------------------------------------ doubt: derived, discharged, accepted
-- A doubt is a shape in the provenance of an edge a DECISION rests on, and
-- each shape names what would discharge it. The claim's own grade is the
-- inquiry kernel's four rules (rules/inquiry/epistemic.rofl), restated over
-- the book's edges: supports/refutes are polarities an edge carries toward
-- a claim. A doubt nobody discharged is accepted by name, in the asker's
-- volume, or the decision stays conditional.
edb(supports).          -- supports(Id, Claim)
edb(refutes).           -- refutes(Id, Claim)
edb(qualifies).         -- qualifies(Id2, Id)             the source of Id gave Id2 as a caveat about it
edb(bent).              -- bent(Round, Source)            the executor bent the question to get an answer
edb(accepted_doubt).    -- accepted_doubt(Id, Kind, Who, Round)
edb(discharges).        -- discharges(Kind, "what settles it")

discharges(depth_zero,     "any source at all").
discharges(single_source,  "a second source not held by the same holder").
discharges(self_serving,   "a book the holder does not hold, saying the same").
discharges(concentration,  "a rebuttal, or a replication by another holder").
discharges(self_qualified, "the design the caveat asks for").
discharges(rival,          "a third book, put the same question").
discharges(bent_put,       "an answer to the question as written").
discharges(stale,          "the same question, asked again").

claim(C)                  :- supports(_, C).
claim(C)                  :- refutes(_, C).
supported(C)              :- supports(Id, C), not stale(Id).
refuted(C)                :- refutes(Id, C), not stale(Id).
contested(C)              :- supported(C), refuted(C).
unknown_claim(C)          :- claim(C), not supported(C), not refuted(C).

decision(Dec)             :- edge_any(_, depends_on, Dec, Q), question(Q, _, _).
rests_on(Dec, Id)         :- decision(Dec), edge_any(_, depends_on, Dec, Q), needs(Q, R, X, out), edge_any(Id, R, X, _).
rests_on(Dec, Id)         :- decision(Dec), edge_any(_, depends_on, Dec, Q), needs(Q, R, X, in), edge_any(Id, R, _, X).
rests_on(Dec, Id)         :- decision(Dec), edge_any(_, depends_on, Dec, Q), premise(Q, E), edge_any(Id, _, E, _).
rests_on(Dec, Id)         :- decision(Dec), edge_any(_, depends_on, Dec, Q), premise(Q, E), supports(Id, E).
rests_on(Dec, Id)         :- decision(Dec), edge_any(_, depends_on, Dec, Q), premise(Q, E), refutes(Id, E).

source_holder(Id, H)      :- evidence(Id, S, _), held_source(S, H).
second_source(Id)         :- evidence(Id, S1, _), evidence(Id, S2, _), S1 != S2.
claim_of(Id, C)           :- supports(Id, C).
claim_of(Id, C)           :- refutes(Id, C).
holder_on(C, H)           :- claim_of(Id, C), source_holder(Id, H), depth(Id, D), D > 0.
second_holder(C)          :- holder_on(C, H1), holder_on(C, H2), H1 != H2.
rival_value(Id)           :- edge_any(Id, R, X, Y), edge_any(J, R, X, Y2), Y != Y2, in_volume(Id, V1), in_volume(J, V2), V1 != V2,
                             not quote_valued(R).   -- two sentences are not two values
rival_value(Id)           :- edge_any(Id, R, X, _), q_shape(R, out), not_found(R, X, out, S, _), not evidence(Id, S, _).
rival_value(Id)           :- edge_any(Id, R, _, X), q_shape(R, in), not_found(R, X, in, S, _), not evidence(Id, S, _).

doubt(Id, depth_zero)     :- rests_on(_, Id), depth(Id, 0).
doubt(Id, single_source)  :- rests_on(_, Id), depth(Id, 1), not second_source(Id).
doubt(Id, self_serving)   :- rests_on(_, Id), suspected_self_serving(Id, _, _).
doubt(Id, self_qualified) :- rests_on(_, Id), qualifies(_, Id).
doubt(Id, rival)          :- rests_on(_, Id), rival_value(Id).
doubt(Id, bent_put)       :- rests_on(_, Id), landed(Id, K), evidence(Id, S, _), bent(K, S).
doubt(Id, stale)          :- rests_on(_, Id), stale(Id).
doubt(Id, concentration)  :- rests_on(_, Id), claim_of(Id, C), not second_holder(C).

standing(Id, K)           :- doubt(Id, K), not accepted_doubt(Id, K, _, _).
conditional(Dec)          :- rests_on(Dec, Id), standing(Id, _).
clear(Dec)                :- decision(Dec), not conditional(Dec).
idle_acceptance[audit](Id, K) :- accepted_doubt(Id, K, _, _), not doubt(Id, K).
alarm(idle_acceptance).

-- ------------------------------------------------ loop 2: schema as data
signature(C, R)           :- signature_at(C, R, _, _, _).
incomplete(E, R)          :- class(E, C), signature(C, R), q_shape(R, D), not filled(R, E, D).

-- ------------------------------------------------ invariants of the protocol
no_state[audit](Q)               :- question(Q, _, _), not answer(Q, _).
guessed_forbidden[audit](X, C)   :- guessed(X, C).
edge_without_evidence[audit](Id) :- edge_any(Id, _, _, _), not evidence(Id, _, _).
edge_without_round[audit](Id)    :- edge_any(Id, _, _, _), not landed(Id, _).
edge_without_depth[audit](Id)    :- edge_any(Id, _, _, _), not depth(Id, _).
retired_but_filled[audit](C, R)  :- retired(C, R), class(X, C), filled(R, X, _).
archetype_without_origin[audit](R) :- archetype(R), not origin(R, _, _).
-- THE OWNER'S QUESTIONS, AS AUDITS. Each was asked once by a person and
-- could not be generated by the table; written as a rule it is asked of
-- every book on every evaluation.
seed_without_sentence[audit](X)  :- seed(X), not has_sentence(X).           -- "what IS it?"
has_sentence(X)                  :- edge_any(_, describes, X, _).
holder_without_invariant[audit](H) :- role(H, holder), not keeps(H, _).      -- "aspects, not nuances"
keeps(H, I)                      :- edge_any(_, held_by, I, H), role(I, invariant).
alarm(no_state).
alarm(guessed_forbidden).
alarm(edge_without_evidence).
alarm(edge_without_round).
alarm(edge_without_depth).
alarm(retired_but_filled).
alarm(archetype_without_origin).
alarm(seed_without_sentence).
alarm(holder_without_invariant).

-- books/crystals/base.rofl — the vocabulary every crawl starts from.
--
-- The six questions of the skill's table (ontocrawler-2 SKILL.md, "a question
-- is a relation with one open slot"). Domain-free by construction: a crystal
-- for a domain adds to this, never edits it. Every archetype carries its
-- origin; archetype_without_origin[audit] in protocol.rofl refuses one that
-- does not.

crystal(base).

archetype(decomposes_into).   q_shape(decomposes_into, out).   -- what is X made of?
archetype(requires).          q_shape(requires, in).           -- why does X exist?
archetype(depends_on).        q_shape(depends_on, in).         -- what breaks if X is removed?
archetype(held_by).           q_shape(held_by, out).           -- who pays when X breaks?
archetype(equivalent_to).     q_shape(equivalent_to, out).     -- who calls X something else?
archetype(recorded_in).       q_shape(recorded_in, out).       -- where does X leave a trace?
kindless(recorded_in).                                         -- sources unfold first
archetype(invariant_over).    q_shape(invariant_over, out).    -- who objects if X changes: what must stay true about X

origin(decomposes_into, "skill:ontocrawler-2", table_of_questions).
origin(requires,        "skill:ontocrawler-2", table_of_questions).
origin(depends_on,      "skill:ontocrawler-2", table_of_questions).
origin(held_by,         "skill:ontocrawler-2", table_of_questions).
origin(equivalent_to,   "skill:ontocrawler-2", table_of_questions).
origin(recorded_in,     "skill:ontocrawler-2", table_of_questions).
origin(invariant_over,  "skill:ontocrawler-2", table_of_questions).
-- invariant_over was in the table from the start and was dropped in round 0
-- of the first book as 'not a separate question'. Restored 2026-09-21 after
-- eleven rounds of a second book produced holders with empty invariant sets:
-- a role is the set of invariants one holder keeps true, and every holder
-- in both books kept none. The nuances of a perspective live here.

-- A KIND IS A NAME, NOT A THING. The atoms is_a answers with (process,
-- graph_database, normative_status) are entities so that two of them can be
-- asserted equivalent; asking where a name leaves a trace is asking nothing.
-- Observed on two books, 2026-09-21; declared here so the queue stops
-- filling with it.
expects(base, kind, describes).
expects(base, kind, equivalent_to).
learned_on(base, kind, 2, "grafema,parenting").

{
  "name": "rofl",
  "displayName": "ROFL",
  "description": "ROFL: a notebook of checked invariants over your code — ask, explain (why / whynot), what-if",
  "version": "0.1.0",
  "private": true,
  "preview": true,
  "publisher": "GrafemaLabs",
  "license": "MIT",
  "categories": ["Notebooks", "Linters"],
  "keywords": ["rofl", "datalog", "notebook", "invariants", "static analysis", "javascript", "typescript", "why", "explain"],
  "repository": { "type": "git", "url": "https://github.com/Disentinel/rofl", "directory": "vscode" },
  "type": "module",
  "main": "./extension.ts",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "A notebook reads the code files its front matter names, anywhere on disk, and its Translate command runs Claude on its text." },
    "virtualWorkspaces": false
  },
  "engines": {
    "vscode": "^1.132.0"
  },
  "contributes": {
    "notebooks": [
      {
        "type": "rofl-notebook",
        "displayName": "ROFL notebook",
        "selector": [{ "filenamePattern": "*.rofl.md" }]
      }
    ],
    "languages": [
      { "id": "rofl", "aliases": ["ROFL"], "configuration": "./language-configuration.json" },
      { "id": "datalog", "aliases": ["Datalog"], "configuration": "./language-configuration.json" },
      { "id": "natural", "aliases": ["Natural language"] }
    ],
    "grammars": [
      { "language": "rofl", "scopeName": "source.rofl", "path": "./rofl.tmLanguage.json" },
      { "language": "datalog", "scopeName": "source.datalog", "path": "./datalog.tmLanguage.json" }
    ],
    "configurationDefaults": {
      "[rofl]": { "editor.wordWrap": "on" },
      "[datalog]": { "editor.wordWrap": "on" },
      "[natural]": { "editor.wordWrap": "on" }
    },
    "commands": [
      { "command": "rofl-notebook.translate", "title": "Translate natural cells", "category": "ROFL" },
      { "command": "rofl-notebook.translateCell", "title": "Translate", "category": "ROFL", "icon": "$(sparkle)" },
      { "command": "rofl-notebook.refine", "title": "Refine in plain language", "category": "ROFL", "icon": "$(comment-discussion)" },
      { "command": "rofl-notebook.revert", "title": "Revert to the natural cell", "category": "ROFL", "icon": "$(discard)" },
      { "command": "rofl-notebook.restart", "title": "Restart kernel", "category": "ROFL", "icon": "$(debug-restart)" }
    ],
    "menus": {
      "notebook/toolbar": [
        { "command": "rofl-notebook.translate", "when": "notebookType == rofl-notebook" },
        { "command": "rofl-notebook.restart", "when": "notebookType == rofl-notebook" }
      ],
      "notebook/cell/title": [
        { "command": "rofl-notebook.translateCell", "group": "inline", "when": "notebookType == rofl-notebook && notebookCellResource in rofl-notebook.naturals" },
        { "command": "rofl-notebook.refine", "group": "inline", "when": "notebookType == rofl-notebook && (notebookCellResource in rofl-notebook.naturals || notebookCellResource in rofl-notebook.translations)" },
        { "command": "rofl-notebook.revert", "group": "inline", "when": "notebookType == rofl-notebook && notebookCellResource in rofl-notebook.translations" }
      ]
    }
  },
  "devDependencies": {
    "@types/vscode": "1.90",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0"
  }
}
